class TurokWindComponent extends ActorComponent
    native
    editinlinenew
    collapsecategories
    hidecategories(Object);

var @NULL mLocation;
var() float mAmplitude;
var() float mFrequency;
var() float mInnerRadius;
var() float mOuterRadius;
var() bool mFalloff;

defaultproperties
{
    mAmplitude=0.0300000
    mFrequency=0.5000000
    mInnerRadius=10000.0000000
    mOuterRadius=20000.0000000
    mFalloff=true
}