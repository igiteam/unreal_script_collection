class GearAnim_BlendByWeaponClass extends GearAnim_BlendList
	native(TGAnim);

/** Internal cached pointer to TGPawn Owner */
var const	transient	TGPawn		MyTGPawn;
/** Internal cached pointer to owner's weapon */
var const	transient	TGWeapon		MyTGWeapon;

/** List Weapon Classes. Matches size of Children array - 1 */
var() editfixedsize Array<Class<TGWeapon> >	WeaponClassList<AllowAbstract>;

