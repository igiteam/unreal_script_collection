/**
 * Holds all of the common columns that are shared across game types
 */
class GearLeaderboardArcadeAllTime extends GearLeaderboardBase;

`include(GearLeaderboardConstants.uci)

/**
 * This event is called post read complete so that the stats object has a chance
 * synthesize new stats from returned data, e.g. ratios, averages, etc.
 */
event OnReadComplete()
{
}

/**
 * Updates the view ids being written to based off of the chapter
 *
 * @param ChapterId the id of the chapter to look up
 */
function UpdateViewIdFromChapter(int ChapterId)
{
	ViewId = class'GearLeaderboardSettingsArcade'.static.GetViewIdFromChapter(ChapterId);
	`Log("Using Arcade view id of "$ViewId);
}

defaultproperties
{
	ViewId=`STATS_VIEW_ARCADESTART

	SortColumnId=`STATS_COLUMN_HIGHSCORE

	ColumnIds=(`STATS_COLUMN_KILLS,`STATS_COLUMN_REVIVES,`STATS_COLUMN_TAKEDOWNS,`STATS_COLUMN_HIGHSCORE,`STATS_COLUMN_HIGHESTMULTIPLIER,`STATS_COLUMN_ARCADE_HIGHESTONEKILLSCORE,`STATS_COLUMN_DIFFICULTY,`STATS_COLUMN_ARCADE_CREATURE1KILLS,`STATS_COLUMN_ARCADE_CREATURE2KILLS,`STATS_COLUMN_ARCADE_CREATURE3KILLS,`STATS_COLUMN_ARCADE_CREATURE4KILLS,`STATS_COLUMN_ARCADE_CREATURE5KILLS,`STATS_COLUMN_ARCADE_CREATURE6KILLS,`STATS_COLUMN_ARCADE_CREATURE7KILLS,`STATS_COLUMN_ARCADE_CREATURE8KILLS,`STATS_COLUMN_ARCADE_CREATURE9KILLS,`STATS_COLUMN_ARCADE_CREATURE10KILLS,`STATS_COLUMN_ARCADE_CREATURE11KILLS,`STATS_COLUMN_ARCADE_CREATURE12KILLS,`STATS_COLUMN_ARCADE_CREATURE13KILLS,`STATS_COLUMN_ARCADE_CREATURE14KILLS,`STATS_COLUMN_ARCADE_CREATURE15KILLS,`STATS_COLUMN_ARCADE_CREATURE16KILLS,`STATS_COLUMN_ARCADE_CREATURE17KILLS,`STATS_COLUMN_ARCADE_CREATURE18KILLS,`STATS_COLUMN_ARCADE_CREATURE19KILLS,`STATS_COLUMN_ARCADE_CREATURE20KILLS,`STATS_COLUMN_ARCADE_CREATURE21KILLS,`STATS_COLUMN_ARCADE_CREATURE22KILLS,`STATS_COLUMN_ARCADE_CREATURE23KILLS,`STATS_COLUMN_ARCADE_CREATURE24KILLS,`STATS_COLUMN_ARCADE_CREATURE25KILLS,`STATS_COLUMN_ARCADE_CREATURE26KILLS,`STATS_COLUMN_ARCADE_CREATURE27KILLS,`STATS_COLUMN_ARCADE_CREATURE28KILLS,`STATS_COLUMN_ARCADE_CREATURE29KILLS,`STATS_COLUMN_ARCADE_CREATURE30KILLS,`STATS_COLUMN_ARCADE_CREATURE31KILLS,`STATS_COLUMN_ARCADE_CREATURE32KILLS,`STATS_COLUMN_ARCADE_CREATURE33KILLS,`STATS_COLUMN_ARCADE_CREATURE34KILLS,`STATS_COLUMN_ARCADE_CREATURE35KILLS,`STATS_COLUMN_ARCADE_CREATURE36KILLS,`STATS_COLUMN_ARCADE_CREATURE37KILLS,`STATS_COLUMN_ARCADE_CREATURE38KILLS,`STATS_COLUMN_ARCADE_CREATURE39KILLS,`STATS_COLUMN_ARCADE_CREATURE40KILLS)

