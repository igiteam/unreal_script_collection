	ColumnMappings(1)=(Id=`STATS_COLUMN_HIGHESTMULTIPLIER,Name="HighestMultiplier")
	ColumnMappings(2)=(Id=`STATS_COLUMN_ARCADE_HIGHESTONEKILLSCORE,Name="HighestOneKillScore")
	ColumnMappings(3)=(Id=`STATS_COLUMN_KILLS,Name="Kills") 
