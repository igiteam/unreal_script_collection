{
	if (bNetDirty)
		HODBeamManager,GameStatus, RoundCount, bIsCoop, RoundTime, MatchDuration,
		bAllowFriendlyFire, RoundEndTime, ReplicatedWeather,
		PlaylistId, PlaylistManagerVer, WingmanClassIndexes, bInCoopSplit, bGapSquadSplit,
