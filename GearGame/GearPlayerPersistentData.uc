/**
 * This class holds the data that is written to the backend network service and
 * does not involve player profile data. It's used to hold data that can be read
 * by other clients and/or web sites
 */
class GearPlayerPersistentData extends OnlinePlayerStorage;

`include(GearPlayerPersistentDataConstants.uci)

/** Whether or not the persistent data has changed enough that it should be saved */
var bool bShouldBeSaved;


/**
 *  GetValue
 *	@param PersistentDataID The ID of the data to be retrieved
 *	@return The value of the data with the given ID, or 0
 */
function int GetValue(int PersistentDataID)
{
	local int Data;

	if (GetProfileSettingValueInt(PersistentDataID,Data))
	{
		return Data;
	}
	AddSettingInt(PersistentDataID);
	return 0;
}

/**
 *  SetValue
 *	@param PersistentDataID The ID of the data to be set
 *	@return The value to be set
 */
function SetValue(int PersistentDataID, int NewValue)
{
	local int OldValue;
	//Get the value to ensure that the value will exist before the attempt to set it
	OldValue = GetValue(PersistentDataID);
	//Only save if there is a change.
	if (NewValue != OldValue)
	{
		SetProfileSettingValueInt(PersistentDataID,NewValue);
		bShouldBeSaved = TRUE;
	}
}

/** Clears all the flags that handle marking things for needing viewed */
final function WipeNeedsViewedFlags()
{
	local int NumFlags;
	local int Idx;

	NumFlags = `NeedsViewed_0 / 32 + 1;
	for (Idx = 0; Idx < NumFlags; Idx++)
	{
		SetValue(`NeedsViewed_0 + Idx, 0);
	}
}

