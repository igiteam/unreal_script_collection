class OLComputerScreen extends GFxMoviePlayer;

defaultproperties
{
	bLogUnhandedWidgetInitializations=true
	bAllowFocus=true
	bAllowInput=true
	TimingMode=TM_Real;
	bIgnoreMouseInput=false
	bPauseGameWhileActive=false
	bCaptureInput=true
	bAutoPlay=true
	bCaptureMouseInput=true
	bOnlyOwnerFocusable=true
	bShowHardwareMouseCursor=true
	
	Priority=1
}
