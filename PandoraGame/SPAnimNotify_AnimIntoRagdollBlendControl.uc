class SPAnimNotify_AnimIntoRagdollBlendControl extends AnimNotify
    native
    editinlinenew
    collapsecategories;

var(blend) float StartTampingBoneSpringTime;
var(blend) float FinishTampingBoneSpringTime;
var(blend) float holdPercentage;

defaultproperties
{
    StartTampingBoneSpringTime=0.3000000
    FinishTampingBoneSpringTime=0.8000000
    holdPercentage=1.0000000
}