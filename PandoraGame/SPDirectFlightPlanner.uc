class SPDirectFlightPlanner extends PrimitiveComponent
    native;

const SPMaxCachedFlightPaths = 55;

enum SPDAStarNodeListType
{
    SPDAStarNode_None,              // 0
    SPDAStarNode_Close,             // 1
    SPDAStarNode_Open,              // 2
    SPDAStarNode_MAX                // 3
};

enum SPDAStarNodePosFlags
{
    SPDAStarNodePosFlags_blocked,   // 0
    SPDAStarNodePosFlags_open,      // 1
    SPDAStarNodePosFlags_MAX        // 2
};

enum eSPDFPathTypes
{
    eSPDFPathUnknown,               // 0
    eSPDFPathAir,                   // 1
    eSPDFPathX,                     // 2
    eSPDFPathTypes_MAX              // 3
};

enum eSPDim
{
    eX,                             // 0
    eY,                             // 1
    eZ,                             // 2
    eSPDim_MAX                      // 3
};

struct native SPDAStarNode
{
    var float fdummy1;
    var float fdummy2;
    var int Dummy1_1Int32;
    var int Dummy2_1Int32;
    var int Dummy3_1Int32;
    var int Dummy4_1Int32;

    structdefaultproperties
    {
        fdummy1=0.0000000
        fdummy2=0.0000000
        Dummy1_1Int32=0
        Dummy2_1Int32=0
        Dummy3_1Int32=0
        Dummy4_1Int32=0
    }
};

struct native SPFAStarDummy
{
    var transient int fuUnreal;

    structdefaultproperties
    {
        fuUnreal=0
    }
};

struct native SPFAStarNode
{
    var transient float m_costFromStart;
    var transient float m_totalCost;
    var transient byte m_next[2];
    var transient byte m_prev[2];
    var transient byte m_parent[2];
    var transient bool m_isOpen;
    var transient bool m_isClosed;

    structdefaultproperties
    {
        m_costFromStart=0.0000000
        m_totalCost=0.0000000
        m_next[0]=0
        m_next[1]=0
        m_prev[0]=0
        m_prev[1]=0
        m_parent[0]=0
        m_parent[1]=0
        m_isOpen=false
        m_isClosed=false
    }
};

struct native SPFAStarOpenList
{
    var transient byte m_start[2];
    var transient byte m_padding[2];

    structdefaultproperties
    {
        m_start[0]=255
        m_start[1]=0
        m_padding[0]=255
        m_padding[1]=0
    }
};

struct native SPFEntityInfo
{
    var float m_speed;
    var float m_minTurnRadius;
    var float m_OneDivMinTurnRadius;
    var float m_maxCurvature;
    var Box m_pawnBounds;

    structdefaultproperties
    {
        m_speed=0.0000000
        m_minTurnRadius=0.0000000
        m_OneDivMinTurnRadius=0.0000000
        m_maxCurvature=0.0000000
        m_pawnBounds=(Min=(X=0.0000000,Y=0.0000000,Z=0.0000000),Max=(X=0.0000000,Y=0.0000000,Z=0.0000000),IsValid=0)
    }
};

struct native SPFAStarNodeInfo
{
    var transient int m_X;
    var transient int m_Y;
    var transient int m_Z;
    var transient int m_D;
    var transient int m_index;
    var transient Vector m_worldPos;
    var transient Vector m_worldDir;

    structdefaultproperties
    {
        m_X=0
        m_Y=0
        m_Z=0
        m_D=0
        m_index=0
        m_worldPos=(X=0.0000000,Y=0.0000000,Z=0.0000000)
        m_worldDir=(X=0.0000000,Y=0.0000000,Z=0.0000000)
    }
};

struct native PositionalFlags
{
    var int m_size[3];
    var array<byte> m_bits;

    structdefaultproperties
    {
        m_size[0]=0
        m_size[1]=0
        m_size[2]=0
        m_bits=none
    }
};

struct native SPFAStarGrid
{
    var transient int m_size[3];
    var transient Vector m_origin;
    var transient array<SPFAStarNode> m_node;
    var transient PositionalFlags m_positionalFlags;
    var transient int m_numBoundingCells[3];
    var transient Vector m_cellSize;
    var transient SPFAStarOpenList m_openList;
    var transient int m_stepSize[3];

    structdefaultproperties
    {
        m_size[0]=0
        m_size[1]=0
        m_size[2]=0
        m_origin=(X=0.0000000,Y=0.0000000,Z=0.0000000)
        m_node=none
        m_positionalFlags=(m_size=0,m_size[1]=0,m_size[2]=0,m_bits=none)
        m_numBoundingCells[0]=0
        m_numBoundingCells[1]=0
        m_numBoundingCells[2]=0
        m_cellSize=(X=0.0000000,Y=0.0000000,Z=0.0000000)
        m_openList=(m_start=255,m_start[1]=0,m_padding=255,m_padding[1]=0)
        m_stepSize[0]=0
        m_stepSize[1]=0
        m_stepSize[2]=0
    }
};

struct native SPFPathFinderInfo
{
    var transient Vector m_origin;
    var transient Vector m_originDirection;
    var transient Vector m_goal;
    var transient Vector m_goalDirection;
    var transient bool m_simplifyPath;
    var transient bool m_bDontStorePath;

    structdefaultproperties
    {
        m_origin=(X=0.0000000,Y=0.0000000,Z=0.0000000)
        m_originDirection=(X=0.0000000,Y=0.0000000,Z=0.0000000)
        m_goal=(X=0.0000000,Y=0.0000000,Z=0.0000000)
        m_goalDirection=(X=0.0000000,Y=0.0000000,Z=0.0000000)
        m_simplifyPath=false
        m_bDontStorePath=false
    }
};

struct native SPDirectFlightPath
{
    var transient Vector m_origin;
    var transient Vector m_originDirection;
    var transient Vector m_goal;
    var transient Vector m_goalDirection;
    var transient float m_time;
    var transient bool m_pathStored;
    var transient bool m_valid;
    var transient SPMultiSplineCurve m_path;

    structdefaultproperties
    {
        m_origin=(X=0.0000000,Y=0.0000000,Z=0.0000000)
        m_originDirection=(X=0.0000000,Y=0.0000000,Z=0.0000000)
        m_goal=(X=0.0000000,Y=0.0000000,Z=0.0000000)
        m_goalDirection=(X=0.0000000,Y=0.0000000,Z=0.0000000)
        m_time=0.0000000
        m_pathStored=false
        m_valid=false
        m_path=(m_curve=none,m_length=0.0000000)
    }
};

