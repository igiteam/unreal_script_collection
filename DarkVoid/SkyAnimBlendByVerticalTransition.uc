class SkyAnimBlendByVerticalTransition extends SkyAnimBlendBase
    native;

enum EAnimBlendByVerticalTransition
{
    BlendByVerticalTransition_None, // 0
    BlendByVerticalTransition_GroundToWallConvex,// 1
    BlendByVerticalTransition_GroundToWallConcave,// 2
    BlendByVerticalTransition_WallToGroundConvex,// 3
    BlendByVerticalTransition_WallToGroundConcave,// 4
    BlendByVerticalTransition_MAX   // 5
};
