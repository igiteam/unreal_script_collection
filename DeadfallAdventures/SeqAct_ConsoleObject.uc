class SeqAct_ConsoleObject extends SequenceAction
    forcescriptorder(true)
    hidecategories(Object);

var AdvConsoleObject_base ConsoleObject;

event Activated()
{
    // End:0x8B
    if(InputLinks[0].bHasImpulse)
    {
        PublishLinkedVariableValues();
        // End:0x63
        if(ConsoleObject.ButtonHitIndex == -1)
        {
            ActivateOutputLink(12);            
        }
        else
        {
            ActivateOutputLink(ConsoleObject.ButtonHitIndex);
        }
    }
    //return;    
}

