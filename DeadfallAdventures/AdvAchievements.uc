struct AchiLocKit
{
    var const localized string Name_PC;
    var const localized string Name_XBOX;
    var const localized string Name_PS3;
    var const localized string UnlockCriteria;
    var const localized string UnlockedDesc;

    structdefaultproperties
    {
        Name_PC=""
        Name_XBOX=""
        Name_PS3=""
        UnlockCriteria=""
        UnlockedDesc=""
    }
};

struct native StatIDToAchievement
{
    var int StatId;
    var AdvAchievements.EPKGameAchievements AchievID;

    structdefaultproperties
    {
        StatId=0
        AchievID=EPKGameAchievements.EADVA_Invalid
    }
};

var array<AchiLocKit> AchievementsLocKit;
var private array<AdvAchievements.EPKGameAchievements> GoldenCardsToAchievementMap;
var private array<AdvAchievements.EPKGameAchievements> SilverCardsToAchievementMap;
var private array<StatIDToAchievement> GlobalStatToAchievementMap;
var private array<byte> TrueMappingAchievementIDToXBoxAchievementID;

static function byte TranslateGlobalStatsToAchievement(int InStatID)
{
    local int I;

    I = 0;
    J0x0B:

    // End:0x8C [Loop If]
    if(I < default.GlobalStatToAchievementMap.Length)
    {
        // End:0x7E
        if(default.GlobalStatToAchievementMap[I].StatId == InStatID)
        {
            return default.GlobalStatToAchievementMap[I].AchievID;
        }
        I++;
        // [Loop Continue]
        goto J0x0B;
    }
    return 0;
    //return ReturnValue;    
}

static function byte TranslateAchievementIDToTruePlatformAchievementID(byte AchievID)
{
    // End:0x3D
    if(Class'Engine.WorldInfo'.static.IsConsoleBuild(1))
    {
        return default.TrueMappingAchievementIDToXBoxAchievementID[int(AchievID)];        
    }
    else
    {
        // End:0x6E
        if(Class'Engine.WorldInfo'.static.IsConsoleBuild(2))
        {
            return AchievID;            
        }
        else
        {
            return AchievID;
        }
    }
    //return ReturnValue;    
}

defaultproperties
{
    GlobalStatToAchievementMap[0]=(StatId=148,AchievID=EPKGameAchievements.EADVA_KILL_50_ENEMIES_USING_TRAPS)
