var string GameClass;
var int MaxPing;
var float MinMatchQuality;

event InitFilters()
{
    SetStringProperty(1073741826, GameClass);
    //return;    
}

function bool IsResultValid(OnlineGameSearchResult theResult)
{
    local int playersNum, MaxPlayers, retID;
    local string sGame;

    playersNum = theResult.GameSettings.NumPublicConnections - theResult.GameSettings.NumOpenPublicConnections;
    MaxPlayers = theResult.GameSettings.NumPublicConnections;
    // End:0xC2
    if(playersNum >= MaxPlayers)
    {
        return false;
    }
    sGame = theResult.GameSettings.GetPropertyAsString(1073741826);
    // End:0x168
    if((theResult.GameSettings.GetStringSettingValue(0, retID) && retID == 2) || sGame == "")
    {
        return false;
    }
    return true;
    //return ReturnValue;    
}

defaultproperties
{
    MaxPing=500
    GameSettingsClass=Class'AdvGameSettingsCommon'
    FilterQuery=(OrClauses=/* Array type was not detected. */)
    LocalizedSettings=/* Array type was not detected. */
    Properties=/* Array type was not detected. */
    LocalizedSettingsMappings=/* Array type was not detected. */
    PropertyMappings=/* Array type was not detected. */
}