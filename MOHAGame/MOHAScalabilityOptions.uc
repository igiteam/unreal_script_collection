class MOHAScalabilityOptions extends Object
    native
    config(Settings);

var config bool bAllowBloom;
var config bool bAllowDepthOfField;
var config bool bAllowDynamicLights;
var config bool bAllowDynamicShadows;
var config bool bAllowLightEnvironmentShadows;
var config bool bAllowMotionBlur;
var config bool bMinspecCull;
var config bool bGroupShadows;
var config bool bPostFX;
var config bool bSimplePostFX;
var config bool bForceFallbackShader;
var config bool bTickLODAnims;
var config int MaxNumberOfDynamicDecals;
var config int MaxNumberOfStaticDecals;
var config int ParticleLODBias;
var config int SkeletalMeshLODBias;
var config int StaticMeshLODBias;
var config int MaxParticlesAllowed;
var config float ParticleCullExemptDistance;
var config float ScreenPercentage;
var config float CullDistanceBiasBase;
