class TdStatsManager extends Object
    config(Achievements);

var private transient array<int> StatsArray;
var transient float CachedWalkingStateTime;
var transient float CachedStartWallrunTime;
var transient float CachedStartBagPickupTime;
var() config int MaxMomentumTimeLimit;
var() config int SPAirMeleeKillsLimit;
var() config int SPDisarmLimit;
var() config int SPMeleeLimit;
var() config int SP180TauntLimit;
var() config int SPLandOnHeadLimit;
var() config int NumberOfBagsToFindForFirstAchievement;

function ResetStatCount(SeqAct_TdRegisterStat.EAchievementStatsID Id, TdProfileSettings P)
{
    // End:0x1B
    if(StatsArray.Length < Id)
    {
        StatsArray.Length = 41;
    }
    StatsArray[Id] = 0;
    //return;    
}

function ResetStats(TdProfileSettings P, bool bLevelStats, bool bGameStats, bool bGlobalStats)
{
    // End:0xA6
    if(bLevelStats)
    {
        StatsArray[4] = 0;
        StatsArray[8] = 0;
        StatsArray[0] = 0;
        P.SetProfileSettingValueInt(P.903, StatsArray[4]);
        P.SetProfileSettingValueInt(P.902, StatsArray[8]);
        P.SetProfileSettingValueInt(P.904, StatsArray[0]);
    }
    // End:0xE4
    if(bGameStats)
    {
        StatsArray[5] = 0;
        P.SetProfileSettingValueInt(P.905, StatsArray[5]);
    }
    //return;    
}

function SaveStatsToProfile(TdProfileSettings P, bool bLevelStats, bool bGameStats, bool bGlobalStats)
{
    // End:0x89
    if(bLevelStats)
    {
        P.SetProfileSettingValueInt(P.903, StatsArray[4]);
        P.SetProfileSettingValueInt(P.902, StatsArray[8]);
        P.SetProfileSettingValueInt(P.904, StatsArray[0]);
    }
    // End:0xBD
    if(bGameStats)
    {
        P.SetProfileSettingValueInt(P.905, StatsArray[5]);
    }
    // End:0x146
    if(bGlobalStats)
    {
        P.SetProfileSettingValueInt(P.906, StatsArray[3]);
        P.SetProfileSettingValueInt(P.907, StatsArray[1]);
        P.SetProfileSettingValueInt(P.908, StatsArray[2]);
    }
    //return;    
}

function LoadStatsFromProfile(TdProfileSettings P, bool bLevelStats, bool bGameStats, bool bGlobalStats)
{
    local int Value;

    // End:0xAA
    if(bLevelStats)
    {
        P.GetProfileSettingValueInt(P.903, Value);
        StatsArray[4] = Value;
        P.GetProfileSettingValueInt(P.902, Value);
        StatsArray[8] = Value;
        P.GetProfileSettingValueInt(P.904, Value);
        StatsArray[0] = Value;
    }
    // End:0xE9
    if(bGameStats)
    {
        P.GetProfileSettingValueInt(P.905, Value);
        StatsArray[5] = Value;
    }
    // End:0x193
    if(bGlobalStats)
    {
        P.GetProfileSettingValueInt(P.906, Value);
        StatsArray[3] = Value;
        P.GetProfileSettingValueInt(P.907, Value);
        StatsArray[1] = Value;
        P.GetProfileSettingValueInt(P.908, Value);
        StatsArray[2] = Value;
    }
    //return;    
}

