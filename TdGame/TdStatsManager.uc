function int GetStatCount(SeqAct_TdRegisterStat.EAchievementStatsID Id, TdProfileSettings P)
{
    // End:0x21
    if((Id < 0) || Id >= 41)
    {
        return 0;
    }
    // End:0x37
    if(StatsArray.Length < 41)
    {
        StatsArray.Length = 41;
    }
    // End:0x85
    if((Id >= 11) && Id <= 40)
    {
        return ((P.IsHiddenBagFound(Id - 11)) ? 1 : 0);
    }
    // End:0x93
    else
    {
        return StatsArray[Id];
    }
    //return ReturnValue;    
}

function bool RegisterFoundBag(int BagIndex, TdProfileSettings P)
{
    local int Mask, Value;
    local bool UnlockAchievement;

    // End:0x197
    if((BagIndex >= 0) && BagIndex < P.30)
    {
        Mask = 1 << BagIndex;
        P.GetProfileSettingValueInt(P.1020, Value);
        Value = Value | Mask;
        UnlockAchievement = P.SetProfileSettingValueInt(P.1020, Value);
        switch(Percent_IntInt(BagIndex, 3))
        {
            // End:0xF8
            case 0:
                return (UnlockAchievement && P.IsHiddenBagFound(BagIndex + 1)) && P.IsHiddenBagFound(BagIndex + 2);
            // End:0x145
            case 1:
                return (UnlockAchievement && P.IsHiddenBagFound(BagIndex + 1)) && P.IsHiddenBagFound(BagIndex - 1);
            // End:0x194
            case 2:
                return (UnlockAchievement && P.IsHiddenBagFound(BagIndex - 1)) && P.IsHiddenBagFound(BagIndex - 2);
            // End:0xFFFF
            default:
            }
            return false;
            //return ReturnValue;            
}

