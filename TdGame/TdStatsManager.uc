            if(StatsArray[Id] >= SPMeleeLimit)
            {
                return true;
            }
            // End:0x20A
            break;
        // End:0x17E
        case 6:
            CachedWalkingStateTime = Time;
            // End:0x20A
            break;
        // End:0x1C5
        case 7:
            // End:0x1C2
            if(CachedWalkingStateTime > 0.0)
            {
                delta_time = Time - CachedWalkingStateTime;
                CachedWalkingStateTime = -1.0;
                // End:0x1C2
                if(delta_time > float(MaxMomentumTimeLimit))
                {
                    return true;
                }
            }
            // End:0x20A
            break;
        // End:0x1E6
        case 10:
