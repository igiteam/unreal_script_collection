class SeqAct_TdTriggerBoss extends SequenceAction
    hidecategories(Object);

var() int BossFightIndex;

event Activated()
{
    local TdSPStoryGame Game;
    local TdPlayerController PC;
    local TdPlayerPawn P;

    Game = TdSPStoryGame(GetWorldInfo().Game);
    // End:0x260
    if(Game != none)
    {
        Game.ActiveBossFight = BossFightIndex;
        // End:0x25C
        foreach Game.LocalPlayerControllers(class'TdPlayerController', PC)
        {
            // End:0x25B
            if((PC.myPawn != none) && !PC.IsDead())
            {
                P = PC.myPawn;
                switch(BossFightIndex)
                {
                    // End:0xAF
                    case 1:                        
                        return;
                        // End:0x258
                        break;
                    // End:0xBA
                    case 2:                        
                        return;
                        // End:0x258
                        break;
                    // End:0xBF
                    case 3:
                    // End:0x255
                    case 4:
                        P.Mesh1p.AnimSets[4] = TdAnimSet(DynamicLoadObject("AS_BF_SP07_PursuitFemale.AS_BF_SP07_PursuitFemale_Character1p", class'TdAnimSet'));
                        P.Mesh3p.AnimSets[4] = TdAnimSet(DynamicLoadObject("AS_BF_SP07_PursuitFemale.AS_BF_SP07_PursuitFemale_Faith", class'TdAnimSet'));
                        P.Mesh1p.UpdateAnimations();
                        P.Mesh3p.UpdateAnimations();
                        P.Moves[18] = new (P) class'TdMove_Disarm_Celeste';
                        P.Moves[18].PawnOwner = P;
                        P.Moves[79] = new (P) class'TdMove_HeadButtedByCeleste';
                        P.Moves[79].PawnOwner = P;
                        // End:0x258
                        break;
                    // End:0xFFFF
                    default:
                        J0x25B:
                        // End:0x25B
                        break;
                    }
            }            
        }        
        J0x260:
    }
    // End:0x260
    else
    {
    }
    //return;    
}

defaultproperties
{
    ObjName="Trigger Boss Fight"
    ObjCategory="Takedown"
}