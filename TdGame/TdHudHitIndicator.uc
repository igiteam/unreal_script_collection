    DamageData[MinIndex].FadeTime = FadeTime;
    DamageData[MinIndex].MatConstant.SetScalarParameterValue(PositionalParamName, FlashPosition);
    DamageData[MinIndex].MatConstant.SetScalarParameterValue(FadeParamName, 1.0);
    //return;    
}

