class TdProj_FlashbangGrenade extends TdProj_Grenade
    hidecategories(Navigation);

var float LookAwayDamageScale;
var(WeaponEffects) float DynamicLightFlashDuration;
var transient float DynamicLightFlashTimer;
var(WeaponEffects) Color DynamicLightFlashColor;
var(WeaponEffects) float DynamicLightFlashBrightness;
var(WeaponEffects) export editinline PointLightComponent DynamicLightFlashLight;

simulated function bool HurtRadius(float BaseDamage, float InDamageRadius, class<DamageType> DamageType, float Momentum, Vector HurtOrigin, optional Actor IgnoredActor, optional Controller InstigatedByController, optional bool bDoFullDamage)
{
    local TdPawn Victim;
    local Vector ViewLoc;
    local Rotator ViewRot;
    local bool bCausedDamage;

    InstigatedByController = ((Instigator != none) ? Instigator.Controller : none);    
    // End:0x2E
    if(bHurtEntry)
    {
        return false;
    }
    bHurtEntry = true;
    bCausedDamage = false;
    // End:0x1B5
    foreach CollidingActors(class'TdPawn', Victim, InDamageRadius, HurtOrigin)
    {
        // End:0x1B4
        if(Victim != IgnoredActor)
        {
            Victim.GetActorEyesViewPoint(ViewLoc, ViewRot);
            // End:0x10D
            if(Victim.Controller.CanSeeByPoints(ViewLoc, HurtOrigin, ViewRot))
            {
                Victim.TakeRadiusDamage(InstigatedByController, BaseDamage, InDamageRadius, DamageType, Momentum, HurtOrigin, bDoFullDamage, self);
                bCausedDamage = bCausedDamage || Victim.bProjTarget;
                // End:0x1B4
                continue;
            }
            // End:0x19F
            if(Victim.Controller.LineOfSightTo(self))
            {
                Victim.TakeRadiusDamage(InstigatedByController, LookAwayDamageScale * BaseDamage, InDamageRadius, DamageType, Momentum, HurtOrigin, false, self);
                bCausedDamage = bCausedDamage || Victim.bProjTarget;
                // End:0x19C
                if(DynamicLightFlashLight != none)
                {
                    TriggerDynamicLightFlash();
                }
                // End:0x1B4
                continue;
            }
            // End:0x1B4
            if(DynamicLightFlashLight != none)
            {
                TriggerDynamicLightFlash();
            }
        }        
    }    
    bHurtEntry = false;
    return bCausedDamage;
    //return ReturnValue;    
}

function TriggerDynamicLightFlash()
{
    // End:0x5D
    if(!DynamicLightFlashLight.bEnabled)
    {
        DynamicLightFlashLight.SetLightProperties(DynamicLightFlashBrightness, DynamicLightFlashColor);
        self.AttachComponent(DynamicLightFlashLight);
        DynamicLightFlashLight.SetEnabled(true);
        DynamicLightFlashTimer = DynamicLightFlashDuration;
    }
    //return;    
}

event Tick(float DeltaTime)
{
    local float Brightness;

    // End:0x79
    if((DynamicLightFlashLight != none) && DynamicLightFlashLight.bEnabled)
    {
        Brightness = (DynamicLightFlashBrightness * DynamicLightFlashTimer) / DynamicLightFlashDuration;
        DynamicLightFlashLight.SetLightProperties(Brightness, DynamicLightFlashColor);
        DynamicLightFlashTimer -= DeltaTime;
        // End:0x79
        if(DynamicLightFlashTimer <= 0.0)
        {
            DisableDynamicLightFlash();
        }
    }
    //return;    
}

simulated function DisableDynamicLightFlash()
{
    DynamicLightFlashLight.SetEnabled(false);
    //return;    
}

