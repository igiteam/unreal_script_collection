state TestStandingTurning_AnimationAngles
{
    function BeginState(name PreviousStateName)
    {
        AIController.myPawn.AllowStandingTurning(false);
        AIController.StopFiring();
        AIController.bAllowFocusRotation = false;
        AIController.bAllowFocus = false;
        //return;        
    }

    function EndState(name NextStateName)
    {
        AIController.myPawn.AllowStandingTurning(true);
        AIController.bAllowFocusRotation = true;
        AIController.bAllowFocus = true;
        //return;        
    }

Begin:
    ActiveTestNr = 0;
    TestAngle = 0;
    PutAiInPositionForStartTest();
    PutPlayerInDefaultPosition();
    AIController.myPawn.TimedScreenMessage("Test:Standing turning native angles", LongPauseTime);
    Sleep(LongPauseTime);
    J0x72:
    // End:0x288 [Loop If]
    if(ActiveTestNr < 7)
    {
        PutAiInPositionForStartTest();
        switch(ActiveTestNr)
        {
            // End:0x9E
            case 0:
                TestAngle = 0;
                // End:0x109
                break;
            // End:0xB0
            case 1:
                TestAngle = -45;
                // End:0x109
                break;
            // End:0xC3
            case 2:
                TestAngle = -90;
                // End:0x109
                break;
            // End:0xD6
            case 3:
                TestAngle = -135;
                // End:0x109
                break;
            // End:0xE6
            case 4:
                TestAngle = 135;
                // End:0x109
                break;
            // End:0xF6
            case 5:
                TestAngle = 90;
                // End:0x109
                break;
            // End:0x106
            case 6:
                TestAngle = 45;
                // End:0x109
                break;
            // End:0xFFFF
            default:
                PutAiInPositionForStartTest();
                AIController.bAllowFocusRotation = false;
                AIController.bAllowFocus = false;
                SetAiRotation(TestAngle);
                AIController.myPawn.LegRotation = int((float(TestAngle) * 65536.0) / float(360));
                AIController.myPawn.TimedScreenMessage("Testing angle:" @ string(TestAngle), PauseTime);
                Sleep(PauseTime);
                // End:0x205
                if(AIController.myPawn.CanDoMove(45))
                {
                    AIController.myPawn.SetMove(45);
                }
                // End:0x248
                else
                {
                    AIController.myPawn.TimedScreenMessage("Can't do move MOVE_BotTurnStanding");
                }
                // End:0x276 [Loop If]
                if(AIController.myPawn.IsInMove(45))
                {
                    Sleep(0.030);
                    // [Loop Continue]
                    goto J0x248;
                }
                Sleep(PauseTime);
                ++ ActiveTestNr;
End:

                // [Loop Continue]
                goto J0x72;
            }
            PutAiInPositionForStartTest();
            AIController.myPawn.TimedScreenMessage("Test Over", LongPauseTime);
            // End:0x2D7
            if(bRunAllTests)
            {
                GotoState('TestStandingTurning_AllAngles');
            }
            stop;                                                            
}

state TestStandingTurning_AllAngles
{
    function BeginState(name PreviousStateName)
    {
        AIController.myPawn.AllowStandingTurning(false);
        AIController.StopFiring();
        AIController.bAllowFocusRotation = false;
        AIController.bAllowFocus = false;
        //return;        
    }

    function EndState(name NextStateName)
    {
        AIController.myPawn.AllowStandingTurning(true);
        AIController.bAllowFocusRotation = true;
        AIController.bAllowFocus = true;
        //return;        
    }

Begin:
    ActiveTestNr = 0;
    TestAngle = 0;
    PutAiInPositionForStartTest();
    PutPlayerInDefaultPosition();
    AIController.myPawn.TimedScreenMessage("Test:Standing turning native angles", LongPauseTime);
    Sleep(LongPauseTime);
    J0x72:
    // End:0x230 [Loop If]
    if(TestAngle < 360)
    {
        PutAiInPositionForStartTest();
        TestAngle = ActiveTestNr * AngleStep;
        AIController.bAllowFocusRotation = false;
        AIController.bAllowFocus = false;
        SetAiRotation(TestAngle);
        FocusAngle = -90 + (45 * Percent_IntInt(ActiveTestNr, 5));
        AIController.myPawn.LegRotation = int((float(TestAngle) * 65536.0) / float(360));
        AIController.myPawn.TimedScreenMessage("Testing angle:" @ string(TestAngle), PauseTime);
        Sleep(PauseTime);
        // End:0x1AD
        if(AIController.myPawn.CanDoMove(45))
        {
            AIController.myPawn.SetMove(45);
        }
        // End:0x1F0
        else
        {
            AIController.myPawn.TimedScreenMessage("Can't do move MOVE_BotTurnStanding");
        }
        // End:0x21E [Loop If]
        if(AIController.myPawn.IsInMove(45))
        {
            Sleep(0.030);
            // [Loop Continue]
            goto J0x1F0;
        }
        Sleep(PauseTime);
        ++ ActiveTestNr;
End:

        // [Loop Continue]
        goto J0x72;
    }
    PutAiInPositionForStartTest();
    AIController.myPawn.TimedScreenMessage("Test Over", LongPauseTime);
    // End:0x27F
    if(bRunAllTests)
    {
        GotoState('TestStandingTurning_AllAnglesLegOffset');
    }
    stop;                    
}

