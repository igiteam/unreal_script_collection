    TestAngle = 0;
    PutAiInPositionForStartTest();
    PutPlayerInDefaultPosition();
    AIController.myPawn.TimedScreenMessage("Test:Standing turning all angles", LongPauseTime);
    Sleep(LongPauseTime);
    J0x6F:
    // End:0x253 [Loop If]
    if(TestAngle < 360)
    {
        PutAiInPositionForStartTest();
        TestAngle = ActiveTestNr * AngleStep;
        AIController.bAllowFocusRotation = false;
        AIController.bAllowFocus = false;
        SetAiRotation(TestAngle);
        AIController.myPawn.LegRotation = int((float((TestAngle + 90) + (45 * Percent_IntInt(ActiveTestNr, 5))) * 65536.0) / float(360));
        AIController.myPawn.TimedScreenMessage((("Testing angle:" @ string(TestAngle)) @ "Leg angle") @ string((TestAngle - 90) + (45 * Percent_IntInt(ActiveTestNr, 5))), PauseTime);
        Sleep(PauseTime);
        // End:0x1D0
        if(AIController.myPawn.CanDoMove(45))
        {
            AIController.myPawn.SetMove(45);
        }
        // End:0x213
        else
        {
            AIController.myPawn.TimedScreenMessage("Can't do move MOVE_BotTurnStanding");
        }
        // End:0x241 [Loop If]
        if(AIController.myPawn.IsInMove(45))
        {
            Sleep(0.030);
            // [Loop Continue]
            goto J0x213;
        }
        Sleep(PauseTime);
        ++ ActiveTestNr;
End:

        // [Loop Continue]
        goto J0x6F;
    }
    PutAiInPositionForStartTest();
    AIController.myPawn.TimedScreenMessage("Test Over", LongPauseTime);
    // End:0x2A2
    if(bRunAllTests)
    {
        GotoState('TestStandingTurning_OrdinaryTurningSystem');
    }
    stop;        
}

state TestStandingTurning_OrdinaryTurningSystem
{
    ignores EndState;

    function BeginState(name PreviousStateName)
    {
        AIController.StopFiring();
        //return;        
    }

Begin:
    ActiveTestNr = 0;
    TestAngle = -180;
    PutAiInPositionForStartTest();
    PutPlayerInDefaultPosition();
    AIController.myPawn.TimedScreenMessage("Test:Standing turning with native rotation", LongPauseTime);
    Sleep(LongPauseTime);
    J0x7D:
    // End:0x127 [Loop If]
    if(TestAngle <= 180)
    {
        TestAngle += 15;
        AIController.myPawn.TimedScreenMessage("Testing angle:" @ string(TestAngle), PauseTime);
        PutPlayerInPositionForTurningTest(float(TestAngle) + ((float(AIController.Player.Rotation.Yaw) * 360.0) / 65536.0));
        Sleep(PauseTime);
        ++ ActiveTestNr;
End:

        // [Loop Continue]
        goto J0x7D;
    }
    PutAiInPositionForStartTest();
    AIController.myPawn.TimedScreenMessage("Test Over", LongPauseTime);
    // End:0x176
    if(bRunAllTests)
    {
        GotoState('TestAimPoses');
    }
    stop;        
}

state TestAimPoses
{
    function BeginState(name PreviousStateName)
    {
        AIController.myPawn.AllowStandingTurning(false);
        //return;        
    }

    function EndState(name NextStateName)
    {
        AIController.myPawn.AllowStandingTurning(true);
        //return;        
    }

Begin:
    ActiveTestNr = 0;
    PutAiInPositionForStartTest();
    PutPlayerInDefaultPosition();
    AIController.myPawn.TimedScreenMessage("Test:AimPoses", LongPauseTime);
    Sleep(LongPauseTime);
startTest:

    // End:0x76
    if(ActiveTestNr == 0)
    {
        J0x60:
        // End:0x76 [Loop If]
        if(ActiveTestNr == 0)
        {
            Sleep(0.030);
End:

            // [Loop Continue]
            goto J0x60;
        }
    }
    PutAiInPositionForStartTest();
    AIController.myPawn.TimedScreenMessage("Test finished", LongPauseTime);
    stop;        
}

defaultproperties
{
    AngleStep=15
    FocusAngleStep=30
    PauseTime=2.0
    LongPauseTime=3.0
}