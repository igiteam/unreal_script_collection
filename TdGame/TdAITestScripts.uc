                TargetLocation = vect(-500.0, 300.0, -335.0);
                DestinationActor.SetLocation(TargetLocation);
                AIController.myPawn.SetWalking(false);
                AIController.myPawn.TimedScreenMessage("Start angle:" @ string(TestAngle), 1.0);
                AIController.HaltAfterMoveToGoal = false;
