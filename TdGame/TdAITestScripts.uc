function BackOneTest()
{
    // End:0x12
    if(ActiveTestNr > 0)
    {
        -- ActiveTestNr;
    }
    GotoState(,, 'startTest');
    //return;    
}

function NextTest()
{
    ++ ActiveTestNr;
    GotoState(,, 'startTest');
    //return;    
}

function SlomoSpeed(float SlomoSpeed)
{
    PauseTime = default.PauseTime * SlomoSpeed;
    // End:0x2C
    if(SlomoSpeed == 0.10)
    {
        PauseTime *= float(2);
    }
    LongPauseTime = default.LongPauseTime * SlomoSpeed;
    //return;    
}

private final function Vector GetMoveToLocation(float Angle)
{
    local Vector DirVect;

    Angle *= ((float(2) * 3.1415930) / 360.0);
    DirVect.X = Cos(Angle);
    DirVect.Y = Sin(Angle);
    DirVect.Z = 0.0;
    return (DirVect * float(600)) + AIController.Location;
    //return ReturnValue;    
}

function SetAiRotation(int AiRotation)
{
    local Rotator PawnRotation;

    PawnRotation = AIController.myPawn.Rotation;
    PawnRotation.Yaw = int((65536.0 * float(AiRotation)) / float(360));
    AIController.myPawn.SetRotation(PawnRotation);
    AIController.AimingRotation = PawnRotation;
    AIController.myPawn.DesiredRotation = PawnRotation;
    //return;    
}

function PutAiInPositionForStartTest()
{
    AIController.myPawn.StopAllCustomAnimations(0.0);
    AIController.Freeze();
    AIController.WaitForKismetCommand();
    AIController.SetLocation(vect(-1000.0, 300.0, -335.0));
    AIController.SetRotation(rot(0, 0, 0));
    AIController.myPawn.SetLocation(vect(-1000.0, 300.0, -335.0));
    AIController.myPawn.SetRotation(rot(0, 0, 0));
    AIController.myPawn.LegRotation = 0;
    AIController.myPawn.SetMove(1);
    TdMove_BotStartRunning(AIController.myPawn.Moves[43]).MinTimeBetweenTwoStartMoves = 0.0;
    TdMove_BotStartWalking(AIController.myPawn.Moves[42]).MinTimeBetweenTwoStartMoves = 0.0;
    //return;    
}

function PutPlayerInDefaultPosition()
{
    local Vector NewLocation;

    NewLocation = vect(-300.0, 300.0, -335.0);
    AIController.Player.SetLocation(NewLocation);
    //return;    
}

function bool HasReachedTarget(Vector Target)
{
    return VSize2D(Target - AIController.myPawn.Location) < 150.0;
    //return ReturnValue;    
}

function bool HasReachedStopTarget(Vector Target)
{
    return VSize2D(Target - AIController.myPawn.Location) < 50.0;
    //return ReturnValue;    
}

function PutAiInPositionForStopTest(float Angle, float Dist)
{
    local float UnrealAngle;
    local Rotator AngleRotator;

    UnrealAngle = (Angle * 65536.0) / 360.0;
    AngleRotator.Yaw = int(UnrealAngle);
    Normalize(AngleRotator);
    AIController.myPawn.StopAllCustomAnimations(0.0);
    AIController.Freeze();
    AIController.WaitForKismetCommand();
    AIController.SetLocation(vect(-1000.0, 300.0, -335.0) - (vector(AngleRotator) * Dist));
    AIController.SetRotation(AngleRotator);
    AIController.myPawn.SetLocation(vect(-1000.0, 300.0, -335.0) - (vector(AngleRotator) * Dist));
    AIController.myPawn.SetRotation(AngleRotator);
    AIController.myPawn.LegRotation = AIController.myPawn.Rotation.Yaw;
    AIController.myPawn.SetMove(1);
    //return;    
}

function PutPlayerInPositionForTurningTest(float Angle)
{
    local float UnrealAngle, Dist;
    local Rotator AngleRotator;

    UnrealAngle = (Angle * 65536.0) / 360.0;
    AngleRotator.Yaw = int(UnrealAngle);
    Normalize(AngleRotator);
    Dist = 400.0;
    AIController.Player.SetLocation(vect(-1000.0, 300.0, -335.0) - (vector(AngleRotator) * Dist));
    AIController.Player.SetRotation(AngleRotator);
    AIController.Player.Controller.SetRotation(AngleRotator);
    //return;    
}

function Vector GetStopLocation()
{
    return vect(-1000.0, 300.0, -335.0);
    //return ReturnValue;    
}

function AdjustRotationForMovingBackwards(float Angle)
{
    local Rotator NewRotation;

    // End:0xCD
    if(Abs(Angle) >= float(135))
    {
        NewRotation = AIController.myPawn.Rotation;
        NewRotation.Yaw += int(65536.0 / float(2));
        NewRotation.Yaw = NormalizeRotAxis(NewRotation.Yaw);
        AIController.SetRotation(NewRotation);
        AIController.myPawn.SetRotation(NewRotation);
        AIController.myPawn.LegRotation = NewRotation.Yaw;
    }
    //return;    
}

function DrawDebug()
{
    local Vector DebugPos;

    // End:0xFA
    if(bDrawDebug)
    {
        // End:0xFA
        if((AIController.myPawn.IsInMove(41) || AIController.myPawn.IsInMove(42)) || AIController.myPawn.IsInMove(43))
        {
            DebugPos = AIController.myPawn.Location;
            // End:0xB7
            if(VSize(OldDebugPos - DebugPos) > float(50))
            {
                OldDebugPos = DebugPos;
            }
            DrawDebugLineTime(OldDebugPos, DebugPos, 0, 255, 0, 10.0);
            DrawDebugSphereTime(DebugPos, 1.0, 4, 255, 0, 0, 10.0);
            OldDebugPos = DebugPos;
        }
    }
    //return;    
}

state TestStartRun_AnimationAngles
{
    function BeginState(name PreviousStateName)
    {
        CheatManager.Invisible();
        //return;        
    }

    function EndState(name NextStateName)
    {
        CheatManager.Invisible();
        //return;        
    }

Begin:
    ActiveTestNr = 0;
    TestAngle = 0;
    PutAiInPositionForStartTest();
    AIController.myPawn.SetWalking(false);
    AIController.myPawn.TimedScreenMessage("Test:StandToRun animation angles", LongPauseTime);
    Sleep(LongPauseTime);
    J0x84:
    // End:0x1AC [Loop If]
    if(ActiveTestNr < 5)
    {
        PutAiInPositionForStartTest();
        switch(ActiveTestNr)
        {
            // End:0xB0
            case 0:
                TestAngle = 0;
                // End:0xF8
                break;
            // End:0xC2
            case 1:
                TestAngle = -90;
                // End:0xF8
                break;
            // End:0xD5
            case 2:
                TestAngle = -179;
                // End:0xF8
                break;
            // End:0xE5
            case 3:
                TestAngle = 90;
                // End:0xF8
                break;
            // End:0xF5
            case 4:
                TestAngle = 179;
                // End:0xF8
                break;
            // End:0xFFFF
            default:
                AIController.myPawn.TimedScreenMessage("Run in angle:" @ string(TestAngle), 1.0);
                Sleep(PauseTime);
                TargetLocation = GetMoveToLocation(float(TestAngle));
                AIController.HaltAfterMoveToGoal = false;
                AIController.MoveStraightToPos(TargetLocation);
                J0x179:
                // End:0x1A2 [Loop If]
                if(!HasReachedTarget(TargetLocation))
                {
                    DrawDebug();
                    Sleep(0.030);
                    // [Loop Continue]
                    goto J0x179;
                }
                ++ ActiveTestNr;
End:

                // [Loop Continue]
                goto J0x84;
            }
            PutAiInPositionForStartTest();
            AIController.myPawn.TimedScreenMessage("Test finished", LongPauseTime);
            // End:0x1FF
            if(bRunAllTests)
            {
                GotoState('TestStartRun_AllAngles');
            }
            stop;                                                            
}

