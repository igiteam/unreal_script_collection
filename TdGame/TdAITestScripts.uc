    }

Begin:
    ActiveTestNr = 0;
    TestAngle = 0;
    Distance = 400.0;
    PutPlayerInDefaultPosition();
    AIController.myPawn.SetWalking(false);
    AIController.myPawn.TimedScreenMessage("Test:Stop Running", LongPauseTime);
    PutAiInPositionForStopTest(float(TestAngle), Distance);
    Sleep(LongPauseTime);
    J0x96:
    // End:0x288 [Loop If]
    if(ActiveTestNr < 5)
    {
        // End:0xDC
        if(bUsePerfectStop)
        {
            TdMove_BotStop(AIController.myPawn.Moves[41]).UseDebugPerfectStop(true);
        }
        switch(ActiveTestNr)
        {
            // End:0xF2
            case 0:
                TestAngle = 0;
                // End:0x13A
                break;
            // End:0x104
            case 1:
                TestAngle = -90;
                // End:0x13A
                break;
            // End:0x117
            case 2:
                TestAngle = -175;
                // End:0x13A
                break;
            // End:0x127
            case 3:
                TestAngle = 90;
                // End:0x13A
                break;
            // End:0x137
            case 4:
                TestAngle = 175;
                // End:0x13A
                break;
            // End:0xFFFF
            default:
                Distance = 600.0;
                ActiveSubTestNr = 0;
                J0x14C:
                // End:0x27E [Loop If]
                if(ActiveSubTestNr < 4)
                {
                    Distance -= float(75);
                    PutAiInPositionForStopTest(float(TestAngle), Distance);
                    AIController.myPawn.TimedScreenMessage((("Stop in angle:" @ string(TestAngle)) @ "Distance") @ string(Distance), 1.0);
                    TargetLocation = GetStopLocation();
                    AIController.HaltAfterMoveToGoal = true;
                    AIController.MoveStraightToPos(TargetLocation);
                    bHasReachedTarget = false;
                    J0x20D:
                    // End:0x26C [Loop If]
                    if(!bHasReachedTarget || AIController.myPawn.IsInMove(41))
                    {
                        // End:0x257
                        if(HasReachedStopTarget(TargetLocation))
                        {
                            bHasReachedTarget = true;
                        }
                        DrawDebug();
                        Sleep(0.030);
                        // [Loop Continue]
                        goto J0x20D;
                    }
                    Sleep(PauseTime);
                    ++ ActiveSubTestNr;
                    // [Loop Continue]
                    goto J0x14C;
                }
                ++ ActiveTestNr;
End:

                // [Loop Continue]
                goto J0x96;
            }
            AIController.myPawn.TimedScreenMessage("Test finished", LongPauseTime);
            // End:0x2D1
            if(bRunAllTests)
            {
                GotoState('TestStopRun_AllAngles');
            }
            stop;                                    
}

