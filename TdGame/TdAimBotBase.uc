function float GetOffsetThreshold()
{
    switch(Outer.myPawn.GetFiringRange())
    {
        // End:0x4B
        case 2:
            return Outer.myTemplate.OffsetThreshold.Far;
        // End:0x75
        case 0:
            return Outer.myTemplate.OffsetThreshold.Near;
        // End:0xFFFF
        default:
            return Outer.myTemplate.OffsetThreshold.Medium;
    }
    //return ReturnValue;    
}

