class TdMove_Balance extends TdPhysicsMove
    native
    config(PawnMovement);

var TdBalanceWalkVolume Volume;
var float CurrentParamOnCurve;
var bool bIsFacingForward;
var bool bIsInDangerMode;
var bool bHasFallen;
var float BalanceFactor;
var float CounterTimer;
var Rotator CurrentMoveDirection;
var float ExternalForce;
var config float TimeToCounter;
var config float GravityInfluence;
var config float ControlInfluence;
var config float SpeedInfluence;
var config float CameraInfluence;

function bool CanDoMove()
{
    // End:0x54
    if(((PawnOwner.MovementState != 1) && PawnOwner.MovementState != 15) && PawnOwner.MovementState != 16)
    {
        return false;
    }
    return super(TdMove).CanDoMove();
    //return ReturnValue;    
}

simulated function StartMove()
{
    local Vector PointOnSpline, SplineDirection;
    local float NormalizedParam, Forwardness;

    super.StartMove();
    Volume.FindClosestPointOnDSpline(PawnOwner.Location, PointOnSpline, CurrentParamOnCurve);
    NormalizedParam = CurrentParamOnCurve / float(Volume.NumSplineSegments);
    SplineDirection = Volume.GetSlopeOnSpline(NormalizedParam);
    Forwardness = vector(PawnOwner.Rotation) Dot Normal(SplineDirection);
    bIsFacingForward = Forwardness > 0.0;
    SetPreciseRotation(rotator(SplineDirection * ((bIsFacingForward) ? 1.0 : -1.0)), 0.20);
    BalanceFactor = (((bIsFacingForward) ? -0.20 : 0.20) * vector(PawnOwner.Rotation)) Dot (SplineDirection Cross vect(0.0, 0.0, 1.0));
    ExternalForce = 0.0;
    bHasFallen = false;
    bIsInDangerMode = false;
    // End:0x166
    if(PawnOwner.GetWeaponType() == 1)
    {
        ResetCameraLook(0.50);
        PawnOwner.DropWeapon();
    }
    //return;    
}

simulated function StopMove()
{
    PawnOwner.UseRootMotion(false);
    super.StopMove();
    PawnOwner.FaceRotationTimeLeft = 0.40;
    //return;    
}

simulated function int GetMinLookConstrainYaw()
{
    return ((PawnOwner.GetWeaponType() == 1) ? -2000 : MinLookConstraint.Yaw);
    //return ReturnValue;    
}

simulated function int GetMaxLookConstrainYaw()
{
    return ((PawnOwner.GetWeaponType() == 1) ? 2000 : MaxLookConstraint.Yaw);
    //return ReturnValue;    
}

simulated function int GetMinLookConstrainPitch()
{
    return ((PawnOwner.GetWeaponType() == 1) ? -2000 : MinLookConstraint.Pitch);
    //return ReturnValue;    
}

simulated function int GetMaxLookConstrainPitch()
{
    return ((PawnOwner.GetWeaponType() == 1) ? 2000 : MaxLookConstraint.Pitch);
    //return ReturnValue;    
}

simulated event Falloff()
{
    bHasFallen = true;
    PawnOwner.SetPhysics(2);
    // End:0x5C
    if(BalanceFactor < 0.0)
    {
        PlayMoveAnim(2, name("walkbalancefalloffleft"), 1.0, 0.30, 0.30, true);
    }
    // End:0x90
    else
    {
        PlayMoveAnim(2, name("walkbalancefalloffright"), 1.0, 0.30, 0.30, true);
    }
    PawnOwner.UseRootMotion(true);
    //return;    
}

simulated function OnCeaseRelevantRootMotion(AnimNodeSequence SeqNode)
{
    SetMoveTimer(0.10, false, 'GoIntoFalling');
    PawnOwner.SetAnimationMovementState(2);
    //return;    
}

simulated function GoIntoFalling()
{
    PawnOwner.SetMove(2);
    //return;    
}

simulated event HitWall(Vector HitNormal, Actor Wall)
{
    PawnOwner.StopCustomAnim(2, 0.10);
    PawnOwner.SetMove(20);
    //return;    
}

defaultproperties
{
    TimeToCounter=0.80
    GravityInfluence=0.30
    ControlInfluence=1.50
    SpeedInfluence=2.50
    CameraInfluence=0.30
    ControllerState=PlayerBalanceWalk
    SpeedModifier=0.340
    bConstrainLook=true
    bDisableFaceRotation=true
    bDisableControllerFacingPawnYawRotation=true
    bAvoidLedges=false
    AiAimOneShotPenalties=(Easy=50.0,Medium=50.0,Hard=50.0)
    MovementGroup=MG_TwoHandsBusy
    AimMode=MAM_NoHands
    RedoMoveTime=0.50
    MinLookConstraint=(Pitch=-13000,Yaw=-6000,Roll=-32768)
    MaxLookConstraint=(Pitch=25000,Yaw=6000,Roll=32768)
    AnimBlendTime=0.40
}