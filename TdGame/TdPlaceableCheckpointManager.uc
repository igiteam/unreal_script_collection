                // [Explicit Continue]
                goto J0x1D9;
            }
            // End:0x1D9
            if(SeperateStartSpot != none)
            {
                CurrentDistance = VSize(Track[0].Location - SeperateStartSpot.Location);
            }
            J0x1D9:
            ++ Idx;
            J0x1E3:
            // [Loop Continue]
            goto J0x4B;
        }
        CurrentDistance = 0.0;
        Idx = TrackDataStartIdx + 1;
        J0x1FC:
        // End:0x315 [Loop If]
        if(Idx < Track.Length)
        {
            // End:0x2C8
            if(Track[Idx].ShouldGenerateTrackData(TrackIndex) || Idx == (Track.Length - 1))
            {
