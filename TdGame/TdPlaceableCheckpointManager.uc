                }
                // End:0x10E
                else
                {
                    // End:0x10E
                    if(SeperateStartSpot != none)
                    {
                        CurrentDistance += VSize(Track[0].Location - SeperateStartSpot.Location);
                    }
                }
                NewTrackData.TotalDistance += CurrentDistance;
                NewTrackData.IntermediateDistance[NewTrackData.IntermediateDistance.Length] = CurrentDistance;
                TrackDataStartIdx = Idx;
                // [Explicit Break]
