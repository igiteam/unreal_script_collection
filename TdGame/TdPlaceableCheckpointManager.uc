                DirectionHintQuat = QuatFromRotator(rotator(DirectionHint));
                DirectionHintRot = QuatToRotator(DirectionHintQuat);
                Tracks[TIdx].Checkpoints[CPIdx].SetDirectionHint(DirectionHintRot);
                // [Explicit Continue]
                goto J0x18A;
            }
            Tracks[TIdx].Checkpoints[CPIdx].SetDirectionHint(rot(-16384, 0, 0));
            Tracks[TIdx].Checkpoints[CPIdx].SetLastCheckpoint(Tracks[TIdx].TrackIndex);
            J0x18A:
            ++ CPIdx;
            // [Loop Continue]
            goto J0x1E;
