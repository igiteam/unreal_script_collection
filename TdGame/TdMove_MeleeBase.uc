simulated function DeliverDamage(float Damage, Vector HitLocation, Vector ImpactMomentum, class<TdDamageType> DamageType, TraceHitInfo Hit)
{
    TargetPawn.TakeDamage(int(Damage), PawnOwner.Controller, HitLocation, ImpactMomentum, DamageType, Hit);
    // End:0x85
    if(PawnOwner.Controller.IsA('TdPlayerController'))
    {
        TdPlayerController(PawnOwner.Controller).ClientPlayForceFeedbackWaveform(MeleeWaveform);
    }
    //return;    
}

simulated function TriggerMove()
{
    // End:0x54
    if((PawnOwner.WorldInfo.NetMode == NM_Client) && PawnOwner.IsLocallyControlled())
    {
        PawnOwner.ServerTriggerMelee(0, MeleeState);
    }
    //return;    
}

