function bool CanDoMove()
{
    // End:0x0D
    if(!super(TdMove).CanDoMove())
    {
        return false;
    }
    // End:0x2D
    if(PawnOwner.GetMobilityMultiplier() < CanDoMoveTaserLimit)
    {
        return false;
    }
    // End:0x65
    if((PawnOwner.WeaponAnimState == 3) || PawnOwner.WeaponAnimState == 4)
    {
        return false;
    }
    return true;
    //return ReturnValue;    
}

simulated function StartMove()
{
    local TdPlayerController PC;

    super.StartMove();
    PC = TdPlayerController(PawnOwner.Controller);
    // End:0x51
    if(PC != none)
    {
        TargetPawn = PC.GetMeleeTarget(TargetingMaxDistance * 3.0);
    }
    MeleeState = 1;
    PawnOwner.OnTutorialEvent(14);
    //return;    
}

simulated function StopMove()
{
    local TdPlayerController PC;

    super.StopMove();
    PawnOwner.StopCustomAnim(0, 0.150);
    PawnOwner.StopCustomAnim(2, 0.150);
    PawnOwner.StopCustomAnim(7, 0.150);
    // End:0xCA
    if((TargetPawn != none) && PawnOwner.Controller.IsA('TdPlayerController'))
    {
        PC = TdPlayerController(PawnOwner.Controller);
        PC.TargetingPawn = TargetPawn;
        PC.TargetingPawnInterp = 0.0;
    }
    //return;    
}

