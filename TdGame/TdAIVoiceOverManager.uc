    var name AnimName;
    var bool bLoopVoiceAnim;
    var bool bRadio;

    structdefaultproperties
    {
        outText=""
        spamTime=0.0
        Prio=0.0
        triggeredTime=0.0
        currentPrio=0.0
        minFriends=0
        minDelayTime=0.0
        maxDelayTime=0.0
        bCanRepeat=false
        voices=0
        SCue=none
        NextVariation=0
        AnimName=None
        bLoopVoiceAnim=false
        bRadio=false
    }
};

