    VO_Chopper_Halt,
    VO_Chopper_Pursuit,
    VO_Count,
    VO_None,
    VO_MAX
};

struct native CueInfo
{
    var array<SoundCue> Cues;
    var int NextSubVariant;

    structdefaultproperties
    {
        Cues=none
        NextSubVariant=0
    }
};

