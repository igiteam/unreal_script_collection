function StoreLastValidPlayerLocation()
{
    // End:0x90
    if(((TutorialPawn != none) && TutorialPawn.Physics == 1) && ((TutorialPawn.MovementState == 1) || TutorialPawn.MovementState == 16) || TutorialPawn.MovementState == 15)
    {
        LastValidPlayerLocation = TutorialPawn.Location;
    }
    //return;    
}

exec function StartMovementChallenge(int Index)
{
    local name MCStateName;
    local int Idx;
    local DataStoreClient DataStoreClient;
    local UIDataStore_TdGameObjectivesData ObjectiveData;

    // End:0x1B
    if((Index <= 0) || Index >= 40)
    {
        return;
    }
    // End:0x3A
    if(!GameReplicationInfo.bMatchHasBegun)
    {
        StartMatch();
    }
    // End:0x15E
    if(CheckpointManager.ActivateTrack(Index))
    {
        ActiveMovementChallenge = byte(Index);
        MCStateName = 'WalkThrough';
        Idx = 0;
        J0x75:
        // End:0xD0 [Loop If]
        if(Idx < InitialTutorialStates.Length)
        {
            // End:0xC6
            if(Index == InitialTutorialStates[Idx].Challenge)
            {
                MCStateName = InitialTutorialStates[Idx].StateName;
                // [Explicit Break]
                goto J0xD0;
            }
            ++ Idx;
            J0xD0:
            // [Loop Continue]
            goto J0x75;
        }
        GotoState(MCStateName);
        DataStoreClient = class'UIInteraction'.static.GetDataStoreClient();
        // End:0x15B
        if(DataStoreClient != none)
        {
            ObjectiveData = UIDataStore_TdGameObjectivesData(DataStoreClient.FindDataStore('TdGameObjectivesData'));
            // End:0x15B
            if(ObjectiveData != none)
            {
                ObjectiveData.ResolveAndSetCheckpointObjective('Challenges', GetEnum(enum'EMovementChallenge', ActiveMovementChallenge), true);
            }
        }
        J0x15E:
    }
    // End:0x15E
    else
    {
    }
    //return;    
}

exec function ReStartMovementChallenge(int Index)
{
    local PlayerStart StartSpot;

    // End:0x25
    if(TutorialPawn.LastResetTimeStamp == WorldInfo.TimeSeconds)
    {
        return;
    }
    // End:0x7F
    if(!IsCombatTutorialChallenge(Index))
    {
        TdHUD(TutorialPlayer.myHUD).TriggerCustomColorBlink(0.0, 0.40, 0.0, 0.0, 0.0, true, None);
    }
    GotoState('Waiting');
    ResetGameSequence();
    WorldInfo.MyEmitterPool.ResetPool();
    TutorialPlayer.StopSounds(0.0, 'VO');
    TutorialPlayer.StopSounds(0.0, 'DialogueRadio');
    TutorialPlayer.StopSounds(0.0, 'DialogueOther');
    TutorialPlayer.StopSounds(0.0, 'DialogueFaith');
    TutorialPlayer.SetSoundMode(0,, true, 1.50);
    // End:0x169
    if(AiTutorialController != none)
    {
        AiTutorialController.OnResetChallenge();
    }
    SendMCKismetEvent(byte(Index), class'SeqEvt_TdMovementChallengeReset');
    StartSpot = FindMCStartSpot(byte(Index));
    // End:0x1B9
    if(StartSpot != none)
    {
        ResetPlayer(TutorialPawn, StartSpot);
        J0x1B9:
    }
    // End:0x1B9
    else
    {
    }
    ClearIgnoreInput();
    StartMovementChallenge(Index);
    //return;    
}

function ClearActivateTutorialMessages()
{
    local TdUIScene_TutorialHUDMessage LocalScene;
    local TdGameUISceneClient SceneClient;

    SceneClient = TdGameUISceneClient(class'UIRoot'.static.GetSceneClient());
    // End:0x8B
    if(SceneClient != none)
    {
        LocalScene = TdUIScene_TutorialHUDMessage(SceneClient.FindSceneByTag('TutorialMessage'));
        // End:0x8B
        if(LocalScene != none)
        {
            LocalScene.__OnSceneDeactivated__Delegate = None;
            LocalScene.CloseScene(LocalScene,, 3);
        }
    }
    //return;    
}

function ReStartCurrentMovementChallengeLight()
{
    TdHUD(TutorialPlayer.myHUD).TriggerCustomColorBlink(0.0, 0.40, 0.0, 0.0, 0.0, true, None);
    ResetPlayer(TutorialPawn);
    TdTutorialCheckpoint(LastCheckPoint).SendCompletedEvent(ActiveMovementChallenge);
    TutorialPlayer.StopSounds(0.0, 'VO');
    TutorialPlayer.StopSounds(0.0, 'DialogueRadio');
    TutorialPlayer.StopSounds(0.0, 'DialogueOther');
    TutorialPlayer.StopSounds(0.0, 'DialogueFaith');
    TutorialPlayer.SetSoundMode(0,, true, 1.50);
    //return;    
}

exec function ReStartCurrentMovementChallenge()
{
    ReStartMovementChallenge(ActiveMovementChallenge);
    //return;    
}

