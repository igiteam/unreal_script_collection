event PostLogin(PlayerController NewPlayer)
{
    local DataStoreClient DataStoreClient;
    local UIDataStore_TdGameObjectivesData ObjectiveData;

    super(GameInfo).PostLogin(NewPlayer);
    DataStoreClient = class'UIInteraction'.static.GetDataStoreClient();
    // End:0x70
    if(DataStoreClient != none)
    {
        ObjectiveData = UIDataStore_TdGameObjectivesData(DataStoreClient.FindDataStore('TdGameObjectivesData'));
        // End:0x70
        if(ObjectiveData != none)
        {
            ObjectiveData.ClearCurrentSubObjective();
        }
    }
    TutorialPlayer = TdPlayerController(NewPlayer);
    //return;    
}

event PreBeginPlay()
{
    super.PreBeginPlay();
    CheckpointManager = Spawn(class'TdPlaceableCheckpointManager', self);
    CheckpointManager.Initialize(class'TdTutorialCheckpoint', self);
    TutorialMessageClass = class<TdLocalMessage>(DynamicLoadObject("TdTuContent.TdTutorialMessage", class'Class'));
    FeedbackMessageClass = class<TdLocalMessage>(DynamicLoadObject("TdTuContent.TdTutorialFeedbackMessage", class'Class'));
    //return;    
}

