function bool IsCombatTutorialChallenge(int Index)
{
    return (Index > 23) && Index < 34;
    //return ReturnValue;    
}

function GetStartSpots(TdSPTutorialGame.EMovementChallenge Track, out array<TdTutorialStart> TutorialStartSpots)
{
    local TdTutorialStart TutorialStartPoint;
    local int Idx;

    TutorialStartSpots.Remove(0, TutorialStartSpots.Length);
    Idx = 0;
    J0x14:
    // End:0x93 [Loop If]
    if(Idx < StartPoints.Length)
    {
        TutorialStartPoint = TdTutorialStart(StartPoints[Idx]);
        // End:0x89
        if((TutorialStartPoint != none) && (Track == 0) || TutorialStartPoint.IsStartSpotInTrack(Track))
        {
            TutorialStartSpots[TutorialStartSpots.Length] = TutorialStartPoint;
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x14;
    }
    //return;    
}

function PlayerStart FindMCStartSpot(TdSPTutorialGame.EMovementChallenge Track)
{
    local int Idx;
    local TdTutorialStart BestTutorialStartPoint;
    local float BestDistToStartPoint, CompareDist;
    local array<TdTutorialStart> TutorialStartSpots;

    BestDistToStartPoint = 1000000000.0;
    GetStartSpots(Track, TutorialStartSpots);
    Idx = 0;
    J0x26:
    // End:0x11E [Loop If]
    if(Idx < TutorialStartSpots.Length)
    {
        // End:0xC1
        if((LastCheckPoint != none) && LastCheckPoint.IsCheckpointInTrack(Track))
        {
            CompareDist = VSize2D(LastCheckPoint.Location - TutorialStartSpots[Idx].Location);
            // End:0xBE
            if(BestDistToStartPoint > CompareDist)
            {
                BestDistToStartPoint = CompareDist;
                BestTutorialStartPoint = TutorialStartSpots[Idx];
            }
            // [Explicit Continue]
            goto J0x114;
        }
        CompareDist = VSize2D(LastValidPlayerLocation - TutorialStartSpots[Idx].Location);
        // End:0x114
        if(BestDistToStartPoint > CompareDist)
        {
            BestDistToStartPoint = CompareDist;
            BestTutorialStartPoint = TutorialStartSpots[Idx];
        }
        J0x114:
        ++ Idx;
        // [Loop Continue]
        goto J0x26;
    }
    return BestTutorialStartPoint;
    //return ReturnValue;    
}

function PlayerStart GetActivePlayerStart()
{
    return FindMCStartSpot(ActiveMovementChallenge);
    //return ReturnValue;    
}

function ResetGameSequence()
{
    local int Index;
    local Sequence GameSequence;
    local SeqVar_Object SequenceObj;
    local Actor LOIActor;
    local SequenceOp Op;

    GameSequence = WorldInfo.GetGameSequence();
    Index = 0;
    J0x1D:
    // End:0x100 [Loop If]
    if(Index < GameSequence.SequenceObjects.Length)
    {
        Op = SequenceOp(GameSequence.SequenceObjects[Index]);
        // End:0x8C
        if(Op != none)
        {
            // End:0x89
            if(Op.bActive)
            {
                Op.Reset();
            }
            // [Explicit Continue]
            goto J0xF6;
        }
        SequenceObj = SeqVar_Object(GameSequence.SequenceObjects[Index]);
        // End:0xF6
        if(SequenceObj != none)
        {
            LOIActor = Actor(SequenceObj.GetObjectValue());
            // End:0xF6
            if(LOIActor != none)
            {
                LOIActor.OnDeactivateLOI(none);
            }
        }
        J0xF6:
        ++ Index;
        // [Loop Continue]
        goto J0x1D;
    }
    ClearActivateTutorialMessages();
    // End:0x13D
    if(TutorialPlayer.CurrentForcedLookAtPoint != none)
    {
        TutorialPlayer.CurrentForcedLookAtPoint.UnRegisterLookAtPoint();
    }
    TutorialPlayer.CurrentLookAtPoint = none;
    TutorialPlayer.SetCinematicMode(false, false, false, true, true, true, true);
    TutorialPlayer.IgnoreButtonInput(false);
    TutorialPlayer.IgnoreMoveInput(false);
    TutorialPlayer.IgnoreLookInput(false);
    //return;    
}

function ResetPlayer(TdPlayerPawn PawnToReset, optional NavigationPoint StartSpot)
{
    local NavigationPoint PlayerStartPoint;
    local TdWeapon Weapon;

    PawnToReset.LastResetTimeStamp = WorldInfo.TimeSeconds;
    // End:0x39
    if(StartSpot != none)
    {
        PlayerStartPoint = StartSpot;
    }
    // End:0x4E
    else
    {
        PlayerStartPoint = FindClosestStartSpot(LastValidPlayerLocation);
    }
    Weapon = TdWeapon(PawnToReset.Weapon);
    // End:0x96
    if(Weapon != none)
    {
        Weapon.InvManager.RemoveFromInventory(Weapon);
    }
    PawnToReset.SetLocation(PlayerStartPoint.Location);
    PawnToReset.SetRotation(PlayerStartPoint.Rotation);
    PawnToReset.Controller.SetRotation(PlayerStartPoint.Rotation);
    PawnToReset.GotoState('None');
    PawnToReset.SetMove(1);
    PawnToReset.StopCustomAnim(2, 0.0);
    PawnToReset.StopAllCustomAnimations(0.0);
    PawnToReset.SetAnimationMovementState(1, 0.0);
    PawnToReset.Velocity = vect(0.0, 0.0, 0.0);
    PawnToReset.Acceleration = vect(0.0, 0.0, 0.0);
    PawnToReset.Health = 100;
    PawnToReset.EnterFallingHeight = PlayerStartPoint.Location.Z;
    PawnToReset.ResetMoves();
    //return;    
}

function bool PreventDeath(Pawn KilledPawn, Controller Killer, class<DamageType> DamageType, Vector HitLocation)
{
    local array<TdTutorialStart> TutorialStartSpots;

    GetStartSpots(ActiveMovementChallenge, TutorialStartSpots);
    BroadcastLocalizedMessage(FeedbackMessageClass, 33);
    // End:0x8C
    if((((TutorialStartSpots.Length > 1) && LastCheckPoint != none) && !IsCombatTutorialChallenge(ActiveMovementChallenge)) && !IsCheckpointIn(CheckpointManager.GetFirstCheckpoint(), NextCheckPoints))
    {
        ReStartCurrentMovementChallengeLight();
    }
    // End:0x96
    else
    {
        ReStartCurrentMovementChallenge();
    }
    return true;
    //return ReturnValue;    
}

function SendMCKismetEvent(TdSPTutorialGame.EMovementChallenge MovementChallange, class<SeqEvt_TdMovementChallengeEvent> EventClass, optional TdTutorialCheckpoint Sender)
{
    local int Index;
    local Sequence GameSequence;
    local array<SequenceObject> MovementChallengeEvents;
    local SeqEvt_TdMovementChallengeEvent MCEvent;

    GameSequence = WorldInfo.GetGameSequence();
    GameSequence.FindSeqObjectsByClass(EventClass, true, MovementChallengeEvents);
    Index = 0;
    J0x39:
    // End:0x12D [Loop If]
    if(Index < MovementChallengeEvents.Length)
    {
        MCEvent = SeqEvt_TdMovementChallengeEvent(MovementChallengeEvents[Index]);
        // End:0x94
        if(MCEvent.MovementChallenge == MovementChallange)
        {
            MCEvent.CheckActivate(self, self);
            // [Explicit Continue]
            goto J0x123;
        }
        // End:0xDE
        if((MCEvent.MovementChallenge == 38) && !IsCombatTutorialChallenge(MovementChallange))
        {
            MCEvent.CheckActivate(self, self);
            // [Explicit Continue]
            goto J0x123;
        }
        // End:0x123
        if((MCEvent.MovementChallenge == 39) && IsCombatTutorialChallenge(MovementChallange))
        {
            MCEvent.CheckActivate(self, self);
        }
        J0x123:
        ++ Index;
        // [Loop Continue]
        goto J0x39;
    }
    //return;    
}

function SendTutorialKismetEvent(TdSPTutorialGame.EMovementChallenge MovementChallange, int TutorialEvent, optional TdTutorialCheckpoint Sender)
{
    local int ObjectIndex, TutorialEventIndex;
    local Sequence GameSequence;
    local array<SequenceObject> SequenceObjects;
    local SeqEvt_TdTutorialEvent SequenceTutorialEvent;

    GameSequence = WorldInfo.GetGameSequence();
    GameSequence.FindSeqObjectsByClass(class'SeqEvt_TdTutorialEvent', true, SequenceObjects);
    ObjectIndex = 0;
    J0x39:
    // End:0xED [Loop If]
    if(ObjectIndex < SequenceObjects.Length)
    {
        SequenceTutorialEvent = SeqEvt_TdTutorialEvent(SequenceObjects[ObjectIndex]);
        // End:0xE3
        if(SequenceTutorialEvent.MovementChallenge == MovementChallange)
        {
            TutorialEventIndex = 0;
            J0x83:
            // End:0xE3 [Loop If]
            if(TutorialEventIndex < SequenceTutorialEvent.TutorialEvents.Length)
            {
                // End:0xD9
                if(SequenceTutorialEvent.TutorialEvents[TutorialEventIndex] == byte(TutorialEvent))
                {
                    SequenceTutorialEvent.CheckActivate(self, self);
                    return;
                }
                ++ TutorialEventIndex;
                // [Loop Continue]
                goto J0x83;
            }
        }
        ++ ObjectIndex;
        // [Loop Continue]
        goto J0x39;
    }
    //return;    
}

function Killed(Controller Killer, Controller KilledPlayer, Pawn KilledPawn, class<DamageType> DamageType)
