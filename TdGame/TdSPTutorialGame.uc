function bool IsPunchAttack(class<DamageType> AttackType)
{
    return (AttackType == class'TdDmgType_MeleeLeft') || AttackType == class'TdDmgType_MeleeRight';
    //return ReturnValue;    
}

function bool IsLowMeleeAttack(class<DamageType> AttackType)
{
    return AttackType == class'TdDmgType_MeleeCrouch';
    //return ReturnValue;    
}

function bool IsJumpKickAttack(class<DamageType> AttackType)
{
    return AttackType == class'TdDmgType_MeleeAir';
    //return ReturnValue;    
}

function bool IsSlideKickAttack(class<DamageType> AttackType)
{
    return AttackType == class'TdDmgType_MeleeSlide';
    //return ReturnValue;    
}

function bool IsVaultAttack(class<DamageType> AttackType)
{
    return AttackType == class'TdDmgType_MeleeVaultKick';
    //return ReturnValue;    
}

function OnTutorialCompleted(delegate<OnStayInTutorial> InOnStayInTutorial, optional string NextLevelName)
{
    __OnStayInTutorial__Delegate = InOnStayInTutorial;
    OnLevelCompleted(TutorialPlayer, WorldInfo.GetMapName(), NextLevelName);
    //return;    
}

function OnLevelCompleted(TdPlayerController PC, string CurrentLevelName, optional string InNextLevelName, optional string InNextCheckpointName)
{
    local TdProfileSettings Profile;
    local string MapName;

    // End:0x95
    if(bShouldSaveCheckpointProgress)
    {
        Profile = PC.GetProfileSettings();
        MapName = "edge_p";
        Profile.SetProfileSettingValue(Profile.900, MapName);
        MapName = "Edge_Start";
        Profile.SetProfileSettingValue(Profile.901, MapName);
    }
    super.OnLevelCompleted(PC, CurrentLevelName, InNextLevelName, InNextCheckpointName);
    //return;    
}

event PostSublevelStreaming(string Options)
{
    super(TdGameInfo).PostSublevelStreaming(Options);
    // End:0x3C
    if(!HasOption(Options, "NoControllerCheck"))
    {
        CheckDeviceConnected();
    }
    //return;    
}

function CheckDeviceConnected()
{
    local TdPlayerController PC;

    // End:0x9B
    if(WorldInfo.IsConsoleBuild())
    {
        // End:0x9A
        foreach LocalPlayerControllers(class'TdPlayerController', PC)
        {
            // End:0x99
            if((OnlineSub != none) && !OnlineSub.SystemInterface.IsControllerConnected(LocalPlayer(PC.Player).ControllerId))
            {
                TdHUD(PC.myHUD).DelayedPauseGame();
            }            
        }        
    }
    //return;    
}

function OnLoadNextLevel()
{
    local TdGameUISceneClient SC;

    // End:0x74
    if(OnLCAsyncHelper.NextLevelName != "")
    {
        OnStayInTutorial(false);
        __OnStayInTutorial__Delegate = None;
        // End:0x5D
        if(bShouldSaveCheckpointProgress)
        {
            TdGameData.StartNewGame(bShouldSaveCheckpointProgress, true);
        }
        // End:0x71
        else
        {
            TdGameData.QuitToMainMenu();
        }
    }
    // End:0xAD
    else
    {
        SC = TdGameUISceneClient(class'UIRoot'.static.GetSceneClient());
        SC.OpenMessageBox(OnMsgInit);
    }
    //return;    
}

private final function OnMsgInit(UIScene OpenScene, bool bInitialActivation)
{
    local TdUIScene_MessageBox MsgBox;
    local array<string> ButtonCallouts;
    local array<PotentialOptionKeys> MessageboxOptionKeyMappings;
    local string msg;

    ButtonCallouts[0] = Localize("TdButtonCallouts", "RestartTutorial", "TdGameUI");
    // End:0x88
    if(bShouldSaveCheckpointProgress)
    {
        ButtonCallouts[1] = Localize("TdButtonCallouts", "PlayStoryMode", "TdGameUI");
    }
    // End:0xC4
    else
    {
        ButtonCallouts[1] = Localize("TdButtonCallouts", "PlayMainMenu", "TdGameUI");
    }
    msg = Localize("TdMessageBox", "TutorialCompleted", "TdGameUI");
    MsgBox = TdUIScene_MessageBox(OpenScene);
    MsgBox.__OnNotifyOptionSelected__Delegate = OnPreSelectionAnim;
    MessageboxOptionKeyMappings.Length = 2;
    MessageboxOptionKeyMappings[0].Keys.AddItem('XboxTypeS_B');
    MessageboxOptionKeyMappings[1].Keys.AddItem('XboxTypeS_A');
    MsgBox.SetPotentialOptions(ButtonCallouts, MessageboxOptionKeyMappings);
    MsgBox.Display(msg,, OnSelection);
    //return;    
}

private final function OnPreSelectionAnim(TdUIScene_MessageBox MsgBox, int SIndex, int PIndex)
{
    MsgBox.SceneTransitionAnimOveride = 1;
    //return;    
}

private final function OnSelection(TdUIScene_MessageBox MsgBox, int SIndex, int PIndex)
{
    local OnLevelCompletedAsyncHelper ZeroAsyncHelper;

    // End:0x59
    if(SIndex == 1)
    {
        OnStayInTutorial(false);
        // End:0x42
        if(bShouldSaveCheckpointProgress)
        {
            TdGameData.StartNewGame(bShouldSaveCheckpointProgress, true);
        }
        // End:0x56
        else
        {
            TdGameData.QuitToMainMenu();
        }
    }
    // End:0x8D
    else
    {
        // End:0x8D
        if(SIndex == 0)
        {
            OnStayInTutorial(true);
            OnLCAsyncHelper = ZeroAsyncHelper;
            GotoState('PlayGround');
        }
    }
    __OnStayInTutorial__Delegate = None;
    //return;    
}

function ClearIgnoreInput()
{
    local TdPlayerController PC;

    // End:0x56
    foreach WorldInfo.AllControllers(class'TdPlayerController', PC)
    {
        PC.ResetPlayerMovementInput();
        PC.bCinematicMode = false;
        PC.bGodMode = false;        
    }    
    //return;    
}

function SetObjective(name CheckpointName)
{
    //return;    
}

auto state Waiting
{
    function BeginState(name PreviousState)
    {
        ActiveMovementChallenge = 0;
        NextCheckPoints.Remove(0, NextCheckPoints.Length);
        LastCheckPoint = none;
        //return;        
    }
    stop;    
}

state WalkThrough
{
    function bool IsInWalkTrough()
    {
        return true;
        //return ReturnValue;        
    }

    function BeginState(name PreviousState)
    {
        LastCheckPoint = none;
        GetNextCheckpoints(none, NextCheckPoints);
        SendMCKismetEvent(ActiveMovementChallenge, class'SeqEvt_TdMovementChallengeStarted');
        CheckTouching(TutorialPawn, NextCheckPoints);
        //return;        
    }

    function EndState(name NextState)
    {
        ActiveMovementChallenge = 0;
        NextCheckPoints.Remove(0, NextCheckPoints.Length);
        LastCheckPoint = none;
        //return;        
    }

    function ChallegeCompleted(TdPawn Pawn, TdPlayerController Controller)
    {
        SendMCKismetEvent(ActiveMovementChallenge, class'SeqEvt_TdMovementChallengeCompleted');
        GotoState('Waiting');
        //return;        
    }

    function bool IsTouchingCheckpoint(TdTutorialCheckpoint CP, TdPawn Pawn)
    {
        local Actor ToucingActor;

        // End:0x61
        foreach Pawn.TouchingActors(class'Actor', ToucingActor)
        {
            // End:0x4E
            if(CP.TouchVolume != none)
            {
                // End:0x4B
                if(ToucingActor == CP.TouchVolume)
                {                    
                    return true;
                }
                // End:0x60
                continue;
            }
            // End:0x60
            if(CP == ToucingActor)
            {                
                return true;
            }            
        }        
        return false;
        //return ReturnValue;        
    }

    function OnTutorialEvent(int TutorialEvent, TdPawn Pawn)
    {
        TestCheckpointCompletion(0, TutorialEvent, Pawn);
        //return;        
    }

    function OnAttackEvent(class<DamageType> AttackType, TdPawn Pawn)
    {
        local int EventIdentifier;

        EventIdentifier = GetTutorialEventIdenfier(AttackType);
        // End:0x4D
        if(class<TdDmgType_Bullet>(AttackType) != none)
        {
            ReStartMovementChallenge(ActiveMovementChallenge);
            BroadcastLocalizedMessage(FeedbackMessageClass, 33);
        }
        // End:0x76
        else
        {
            OnTutorialEvent(EventIdentifier, Pawn);
            SendTutorialKismetEvent(ActiveMovementChallenge, EventIdentifier);
        }
        //return;        
    }

    function OnAiKismetEvent(int EventIdentifier)
    {
        SendTutorialKismetEvent(ActiveMovementChallenge, EventIdentifier);
        //return;        
    }

    function bool CanAttack()
    {
        return (ActiveMovementChallenge == 31) || ActiveMovementChallenge == 33;
        //return ReturnValue;        
    }

    function bool ValidAttack(class<DamageType> AttackType)
    {
        local int Index;
        local bool bValidAttack;
        local TdTutorialCheckpoint Checkpoint;

        bValidAttack = false;
        Index = 0;
        J0x0F:
        // End:0x78 [Loop If]
        if(Index < NextCheckPoints.Length)
        {
            Checkpoint = TdTutorialCheckpoint(NextCheckPoints[Index]);
            // End:0x6E
            if(Checkpoint.CanCompleteCheckpoint(ActiveMovementChallenge, 0, byte(GetTutorialEventIdenfier(AttackType))))
            {
                bValidAttack = true;
            }
            ++ Index;
            // [Loop Continue]
            goto J0x0F;
        }
        return bValidAttack;
        //return ReturnValue;        
    }

    function int GetTutorialEventIdenfier(class<DamageType> AttackType)
    {
        local int EventIdentifier;

        // End:0x1D
        if(IsPunchAttack(AttackType))
        {
            EventIdentifier = 3;
        }
        // End:0x99
        else
        {
            // End:0x3A
            if(IsLowMeleeAttack(AttackType))
            {
                EventIdentifier = 4;
            }
            // End:0x99
            else
            {
                // End:0x57
                if(IsJumpKickAttack(AttackType))
                {
                    EventIdentifier = 5;
                }
                // End:0x99
                else
                {
                    // End:0x74
                    if(IsSlideKickAttack(AttackType))
                    {
                        EventIdentifier = 6;
                    }
                    // End:0x99
                    else
                    {
                        // End:0x91
                        if(IsVaultAttack(AttackType))
                        {
                            EventIdentifier = 7;
                        }
                        // End:0x99
                        else
                        {
                            EventIdentifier = 10;
                        }
                    }
                }
            }
        }
        return EventIdentifier;
        //return ReturnValue;        
    }

    function OnPlayerSetMove(TdPawn.EMovement NewMove, TdPlayerPawn Pawn)
    {
        TestCheckpointCompletion(NewMove, 0, Pawn);
        //return;        
    }

    function TestCheckpointCompletion(TdPawn.EMovement NewMove, int TutorialEvent, TdPawn Pawn)
    {
        local int Idx;
        local TdTutorialCheckpoint CP;

        Idx = 0;
        J0x07:
        // End:0x1C2 [Loop If]
        if(Idx < NextCheckPoints.Length)
        {
            CP = TdTutorialCheckpoint(NextCheckPoints[Idx]);
            // End:0x10C
            if(CP.HasCompletionCriterias(ActiveMovementChallenge))
            {
                // End:0x109
                if(IsTouchingCheckpoint(CP, Pawn))
                {
                    // End:0xB7
                    if(CP.CanCompleteCheckpoint(ActiveMovementChallenge, NewMove, byte(TutorialEvent)))
                    {
                        ProcessCompletedCheckpoint(CP, Pawn, TdPlayerController(Pawn.Controller));
                    }
                    // End:0x109
                    else
                    {
                        // End:0x109
                        if(CP.ShouldResetPlayer(ActiveMovementChallenge, NewMove, byte(TutorialEvent)))
                        {
                            ReStartMovementChallenge(ActiveMovementChallenge);
                            BroadcastLocalizedMessage(FeedbackMessageClass, 33);
                            // [Explicit Break]
                            goto J0x1C2;
                        }
                    }
                }
                // [Explicit Continue]
                goto J0x1B8;
            }
            // End:0x1B8
            if((CP.IsCheckpointInTrack(ActiveMovementChallenge) && CP.ShouldResetPlayer(ActiveMovementChallenge, NewMove, byte(TutorialEvent))) && CP == CheckpointManager.GetNextCheckpoint(NextCheckPoints[0]))
            {
                // End:0x1B8
                if(IsTouchingCheckpoint(CP, Pawn))
                {
                    ReStartMovementChallenge(ActiveMovementChallenge);
                    BroadcastLocalizedMessage(FeedbackMessageClass, 33);
                    J0x1B8:
                    // [Explicit Break]
                    goto J0x1C2;
                }
            }
            ++ Idx;
            J0x1C2:
            // [Loop Continue]
            goto J0x07;
        }
        //return;        
    }

    function ProcessCompletedCheckpoint(TdTutorialCheckpoint Checkpoint, TdPawn Pawn, TdPlayerController Controller)
    {
        Checkpoint.SendCompletedEvent(ActiveMovementChallenge);
        // End:0x64
        if(CheckpointManager.GetFinalCheckpoint() == Checkpoint)
        {
            BroadcastLocalizedMessage(FeedbackMessageClass, 32);
            OnLastCheckpointCompleted(Checkpoint, Pawn, Controller);
            return;
        }
        GetNextCheckpoints(Checkpoint, NextCheckPoints);
        LastCheckPoint = Checkpoint;
        //return;        
    }

    function OnCheckpointCompleted(TdPlaceableCheckpoint Checkpoint, TdPlayerPawn Pawn, TdPlayerController Controller)
    {
        local TdTutorialCheckpoint TouchedCheckpoint;

        TouchedCheckpoint = TdTutorialCheckpoint(Checkpoint);
        // End:0x16E
        if(TouchedCheckpoint != none)
        {
            // End:0xD4
            if(IsCheckpointIn(TouchedCheckpoint, NextCheckPoints))
            {
                // End:0x7D
                if(TouchedCheckpoint.CanCompleteCheckpoint(ActiveMovementChallenge, Pawn.MovementState, 0))
                {
                    ProcessCompletedCheckpoint(TouchedCheckpoint, Pawn, Controller);
                }
                // End:0xD1
                else
                {
                    // End:0xD1
                    if(TouchedCheckpoint.ShouldResetPlayer(ActiveMovementChallenge, Pawn.MovementState, 0))
                    {
                        ReStartMovementChallenge(ActiveMovementChallenge);
                        BroadcastLocalizedMessage(FeedbackMessageClass, 33);
                    }
                }
            }
            // End:0x16E
            else
            {
                // End:0x16E
                if((TouchedCheckpoint.IsCheckpointInTrack(ActiveMovementChallenge) && CheckpointManager.GetNextCheckpoint(NextCheckPoints[0]) == TouchedCheckpoint) && TouchedCheckpoint.ShouldResetPlayer(ActiveMovementChallenge, Pawn.MovementState, 0))
                {
                    ReStartMovementChallenge(ActiveMovementChallenge);
                    BroadcastLocalizedMessage(FeedbackMessageClass, 33);
                }
                // End:0x16E
                else
                {
                }
            }
        }
        //return;        
    }

    function OnLastCheckpointCompleted(TdPlaceableCheckpoint Checkpoint, TdPawn Pawn, TdPlayerController Controller)
    {
        Checkpoint.Show(false);
        ChallegeCompleted(Pawn, Controller);
        //return;        
    }

    function NavigationPoint FindClosestStartSpot(Vector ObjectLocation)
    {
        local PlayerStart TutorialStartPoint;

        TutorialStartPoint = FindMCStartSpot(ActiveMovementChallenge);
        // End:0x29
        if(TutorialStartPoint != none)
        {
            return TutorialStartPoint;
        }
        // End:0x31
        else
        {
            return StartPoints[0];
        }
        //return ReturnValue;        
    }

    event Tick(float DeltaTime)
    {
        local float GameSpeedDiff, NewGameSpeed, TargetGameSpeed, GameSpeedFadeTime;

        super(Actor).Tick(DeltaTime);
        GameSpeedFadeTime = 0.50;
        // End:0x87
        if(bTutorialReactionTimeHelper)
        {
            TargetGameSpeed = 0.10;
            // End:0x84
            if(GameSpeed > TargetGameSpeed)
            {
                GameSpeedDiff = (DeltaTime / GameSpeedFadeTime) / WorldInfo.TimeDilation;
                NewGameSpeed = FMax(TargetGameSpeed, GameSpeed - GameSpeedDiff);
                SetGameSpeed(NewGameSpeed);
            }
        }
        // End:0x103
        else
        {
            // End:0x103
            if(!TutorialPlayer.bReactionTime && GameSpeed < 1.0)
            {
                TargetGameSpeed = 1.0;
                GameSpeedDiff = (DeltaTime / GameSpeedFadeTime) / WorldInfo.TimeDilation;
                NewGameSpeed = FMin(1.0, GameSpeed + GameSpeedDiff);
                SetGameSpeed(NewGameSpeed);
            }
        }
        //return;        
    }
    stop;    
}

state ButtonWalkThrough extends WalkThrough
{
    function BeginState(name PreviousState)
    {
        super.BeginState(PreviousState);
        TutorialPlayer.IgnoreMoveInput(true);
        //return;        
    }

    function OnPlayerSetMove(TdPawn.EMovement NewMove, TdPlayerPawn Pawn)
    {
        super.OnPlayerSetMove(NewMove, Pawn);
        TutorialPlayer.IgnoreMoveInput(true);
        //return;        
    }

    function EndState(name NextState)
    {
        super.EndState(NextState);
        TutorialPlayer.IgnoreMoveInput(false);
        //return;        
    }

    function bool IsInWalkTrough()
    {
        return true;
        //return ReturnValue;        
    }
    stop;    
}

state PlayGround
{
    function BeginState(name PreviousState)
    {
        local DataStoreClient DataStoreClient;
        local UIDataStore_TdGameObjectivesData ObjectiveData;

        DataStoreClient = class'UIInteraction'.static.GetDataStoreClient();
        // End:0x65
        if(DataStoreClient != none)
        {
            ObjectiveData = UIDataStore_TdGameObjectivesData(DataStoreClient.FindDataStore('TdGameObjectivesData'));
            // End:0x65
            if(ObjectiveData != none)
            {
                ObjectiveData.ClearCurrentSubObjective();
            }
        }
        //return;        
    }

    function bool PreventDeath(Pawn KilledPawn, Controller Killer, class<DamageType> DamageType, Vector HitLocation)
    {
        ResetPlayer(TdPlayerPawn(KilledPawn));
        TdHUD(TutorialPlayer.myHUD).TriggerCustomColorBlink(0.0, 0.40, 0.0, 0.0, 0.0, true, None);
        return true;
        //return ReturnValue;        
    }
    stop;    
}

defaultproperties
{
    InitialTutorialStates(0)=(Challenge=EMC_ButtonTest,StateName=ButtonWalkThrough)
    DefaultPawnClass=class'TdTutorialPawn'
    HUDType=class'TdTutorialHUD'
}