function bool GetNextCheckpoints(TdPlaceableCheckpoint Current, out array<TdPlaceableCheckpoint> outCheckpoints)
{
    local TdTutorialCheckpoint Next;
    local bool bFoundCheckpoints;

    outCheckpoints.Remove(0, outCheckpoints.Length);
    // End:0x3B
    if(Current != none)
    {
        Next = TdTutorialCheckpoint(CheckpointManager.GetNextCheckpoint(Current));
    }
    // End:0x56
    else
    {
        Next = TdTutorialCheckpoint(CheckpointManager.GetFirstCheckpoint());
    }
    // End:0xE0 [Loop If]
    if(Next != none)
    {
        outCheckpoints[outCheckpoints.Length] = Next;
        bFoundCheckpoints = true;
        // End:0xBD
        if(!Next.IsOptional(ActiveMovementChallenge) || Next == CheckpointManager.GetFinalCheckpoint())
        {
            // [Explicit Break]
            goto J0xE0;
        }
        // End:0xDD
        else
        {
            Next = TdTutorialCheckpoint(CheckpointManager.GetNextCheckpoint(Next));
        }
        J0xE0:
        // [Loop Continue]
        goto J0x56;
    }
    return bFoundCheckpoints;
    //return ReturnValue;    
}

function bool IsCheckpointIn(TdPlaceableCheckpoint Test, array<TdPlaceableCheckpoint> InCheckPoints)
{
    local int Idx;

    Idx = 0;
    J0x07:
    // End:0x38 [Loop If]
    if(Idx < InCheckPoints.Length)
    {
        // End:0x2E
        if(InCheckPoints[Idx] == Test)
        {
            return true;
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    return false;
    //return ReturnValue;    
}

function CheckTouching(TdPlayerPawn Pawn, array<TdPlaceableCheckpoint> InNextCheckPoints)
{
    local int Idx;

    Idx = 0;
    J0x07:
    // End:0x7D [Loop If]
    if(Idx < InNextCheckPoints.Length)
    {
        // End:0x73
        if(InNextCheckPoints[Idx].IsOverlapping(Pawn))
        {
            InNextCheckPoints[Idx].Touch(Pawn, none, Pawn.Location, vect(0.0, 0.0, 1.0));
            return;
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

