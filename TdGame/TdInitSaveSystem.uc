private final function OnShowOverwriteCorruptDialogue(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    BlockUIInput(false);
    switch(SelectedOption)
    {
        // End:0x1C
        case 1:
            ShowConfirmOverwriteDialogue();
            // End:0x2E
            break;
        // End:0xFFFF
        default:
            OnRetryDelegate();
            //return;
    }    
}

