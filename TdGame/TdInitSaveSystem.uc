private final function ShowXenonReselectDevice_MsgBoxInit(UIScene OpenedScene, bool bInitialActivation)
{
    local TdUIScene_MessageBox MsgBox;
    local array<string> PotentialOptions;
    local array<PotentialOptionKeys> PotentialOptionKeyMappings;

