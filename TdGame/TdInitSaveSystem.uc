class TdInitSaveSystem extends Object;

var transient Ts.TsSystem.ETsResult SaveInitResult;
var private transient string SaveErrorMessageBody;
var private transient string SaveErrorMessageTitle;
var delegate<OnInitSavefileSystemDone> __OnInitSavefileSystemDone__Delegate;
var delegate<OnContinueWithoutSavingDelegate> __OnContinueWithoutSavingDelegate__Delegate;
var delegate<OnOverwriteDelegate> __OnOverwriteDelegate__Delegate;
var delegate<OnRetryDelegate> __OnRetryDelegate__Delegate;

delegate OnInitSavefileSystemDone()
{
    //return;    
}

function InitSavefileSystem(optional bool bAutoReplaceCorrupt)
{
    local TsSystem SaveS;
    local int ControllerId;

    bAutoReplaceCorrupt = false;
    BlockUIInput(true);
    ControllerId = class'UIRoot'.static.GetCurrentUIController().Outer.Outer.GamePlayers[0].ControllerId;
    SaveS = class'TsSystem'.static.GetTsSystem();
    SaveS.ClearCachedProfile();
    SaveS.InitializeToC(byte(ControllerId), bAutoReplaceCorrupt, OnSaveSystemInitialized);
    //return;    
}

private final function OnSaveSystemInitialized(Ts.TsSystem.ETsResult Result)
{
    local TsSystem SaveS;
    local string Dummy;

    SaveS = class'TsSystem'.static.GetTsSystem();
    SaveInitResult = Result;
    // End:0x3A
    if(SaveInitResult == 0)
    {
        FinishInit();
    }
    // End:0x14A
    else
    {
        // End:0x81
        if(class'WorldInfo'.static.IsConsoleBuild(1) && SaveS.GetLastError(Dummy) == 7)
        {
            BlockUIInput(false);
            ShowXenonDeviceRemoved();
        }
        // End:0x14A
        else
        {
            // End:0xA1
            if(SaveInitResult == 7)
            {
                BlockUIInput(false);
                ShowOverwriteCorruptSavefileDialogue();
            }
            // End:0x14A
            else
            {
                // End:0xC1
                if(SaveInitResult == 9)
                {
                    BlockUIInput(true);
                    ShowBadOwnerMsgBox();
                }
                // End:0x14A
                else
                {
                    // End:0x106
                    if(class'WorldInfo'.static.IsConsoleBuild(1) && SaveInitResult == 6)
                    {
                        SaveS.SetNoSaving(true);
                        FinishInit();
                    }
                    // End:0x14A
                    else
                    {
                        // End:0x13D
                        if(class'WorldInfo'.static.IsConsoleBuild(1) && SaveInitResult == 2)
                        {
                            BlockUIInput(false);
                            ShowXenonReselectDevice();
                        }
                        // End:0x14A
                        else
                        {
                            BlockUIInput(false);
                            ShowSaveSystemErrorBox();
                        }
                    }
                }
            }
        }
    }
    //return;    
}

private final function ShowSaveSystemErrorBox()
{
    local Ts.TsSystem.ETsError ErrorCode;
    local string ErrorMessage;

    ErrorCode = class'TsSystem'.static.GetLastError(ErrorMessage);
    ShowRetryContinueWithoutSavingDialogue(Localize("TdStart", "SaveInitErrorBody" $ string(ErrorCode), "TdGameUI"), Localize("TdStart", "SaveInitErrorTitle", "TdGameUI"), OnSaveSystemErrorContinueWithoutSaving, OnSaveSystemErrorRetry);
    //return;    
}

private final function OnSaveSystemErrorContinueWithoutSaving()
{
    local TsSystem SaveS;

    SaveS = class'TsSystem'.static.GetTsSystem();
    SaveS.SetNoSaving(true);
    FinishInit();
    //return;    
}

private final function OnSaveSystemErrorRetry()
{
    InitSavefileSystem();
    //return;    
}

