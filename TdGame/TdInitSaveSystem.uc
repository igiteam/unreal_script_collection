private final function BlockUIInput(bool bBlock)
{
    local TdUIScene ActiveScene;

    ActiveScene = TdUIScene(GetSceneClient().GetActiveScene());
    // End:0x55
    if(ActiveScene != none)
    {
        TdUIInteraction(ActiveScene.GetCurrentUIController()).BlockUIInput(bBlock);
    }
    //return;    
}

