private final function FinishInit()
{
    BlockUIInput(false);
    ReadProfile();
    //return;    
}

private final function ReadProfile()
{
    local OnlineSubsystem OnlineSub;
    local OnlineProfileSettings Profile;

    BlockUIInput(true);
    OnlineSub = class'GameEngine'.static.GetOnlineSubsystem();
    Profile = OnlineSub.PlayerInterface.GetProfileSettings(byte(class'UIInteraction'.static.GetPlayerControllerId(0)));
    OnlineSub.PlayerInterface.AddReadProfileSettingsCompleteDelegate(byte(class'UIInteraction'.static.GetPlayerControllerId(0)), OnProfileReadComplete);
    // End:0x10E
    if(!OnlineSub.PlayerInterface.ReadProfileSettings(byte(class'UIInteraction'.static.GetPlayerControllerId(0)), Profile))
    {
        OnlineSub.PlayerInterface.ClearReadProfileSettingsCompleteDelegate(byte(class'UIInteraction'.static.GetPlayerControllerId(0)), OnProfileReadComplete);
        OnProfileWriteComplete(false);
    }
    //return;    
}

private final function OnProfileReadComplete(bool bWasSuccessful)
{
    local OnlineSubsystem OnlineSub;
    local TsSystem SaveS;
    local string Dummy;

    BlockUIInput(false);
    OnlineSub = class'GameEngine'.static.GetOnlineSubsystem();
    OnlineSub.PlayerInterface.ClearReadProfileSettingsCompleteDelegate(byte(class'UIInteraction'.static.GetPlayerControllerId(0)), OnProfileReadComplete);
    SaveS = class'TsSystem'.static.GetTsSystem();
    // End:0xBB
    if((class'WorldInfo'.static.IsConsoleBuild(1) && !bWasSuccessful) && SaveS.GetLastError(Dummy) == 7)
    {
        ShowXenonDeviceRemoved();
    }
    // End:0xF9
    else
    {
        // End:0xEF
        if(!bWasSuccessful && SaveS.IsCorruptProfileDetected())
        {
            BlockUIInput(false);
            ShowOverwriteCorruptProfileDialogue();
        }
        // End:0xF9
        else
        {
            FinishReadProfile();
        }
    }
    //return;    
}

private final function ShowOverwriteCorruptProfileDialogue()
{
    ShowOverwriteCorruptDialogue(Localize("TdStart", "SaveOverwriteCorruptProfileBody", "TdGameUI"), Localize("TdStart", "SaveOverwriteCorruptProfileTitle", "TdGameUI"), OnOverwriteProfileOverwrite, ReadProfile);
    //return;    
}

private final function OnOverwriteProfileContinueWithoutSaving()
{
    local TsSystem SaveS;

    SaveS = class'TsSystem'.static.GetTsSystem();
    SaveS.SetNoSaving(true);
    FinishReadProfile();
    //return;    
}

private final function OnOverwriteProfileRetryRead()
{
    ReadProfile();
    //return;    
}

private final function OnOverwriteProfileOverwrite()
{
    local OnlineSubsystem OnlineSub;
    local TdProfileSettings ProfileSettings;

    BlockUIInput(true);
    OnlineSub = class'GameEngine'.static.GetOnlineSubsystem();
    ProfileSettings = TdProfileSettings(OnlineSub.PlayerInterface.GetProfileSettings(byte(class'UIInteraction'.static.GetPlayerControllerId(0))));
    OnlineSub.PlayerInterface.AddWriteProfileSettingsCompleteDelegate(byte(class'UIInteraction'.static.GetPlayerControllerId(0)), OnProfileWriteComplete);
    // End:0x113
    if(!OnlineSub.PlayerInterface.WriteProfileSettings(byte(class'UIInteraction'.static.GetPlayerControllerId(0)), ProfileSettings))
    {
        OnlineSub.PlayerInterface.ClearWriteProfileSettingsCompleteDelegate(byte(class'UIInteraction'.static.GetPlayerControllerId(0)), OnProfileWriteComplete);
        OnProfileWriteComplete(false);
    }
    //return;    
}

private final function OnProfileWriteComplete(bool bWasSuccessful)
{
    local OnlineSubsystem OnlineSub;
    local TsSystem SaveS;
    local string Dummy;

    BlockUIInput(false);
    OnlineSub = class'GameEngine'.static.GetOnlineSubsystem();
    OnlineSub.PlayerInterface.ClearWriteProfileSettingsCompleteDelegate(byte(class'UIInteraction'.static.GetPlayerControllerId(0)), OnProfileWriteComplete);
    SaveS = class'TsSystem'.static.GetTsSystem();
    // End:0x84
    if(bWasSuccessful)
    {
        FinishReadProfile();
    }
    // End:0xDE
    else
    {
        // End:0xD8
        if((class'WorldInfo'.static.IsConsoleBuild(1) && !bWasSuccessful) && SaveS.GetLastError(Dummy) == 7)
        {
            BlockUIInput(false);
            ShowXenonDeviceRemoved();
        }
        // End:0xDE
        else
        {
            ShowProfileWriteRetryDialogue();
        }
    }
    //return;    
}

private final function ShowProfileWriteRetryDialogue()
{
    local Ts.TsSystem.ETsError ErrorCode;
    local string ErrorMessage;

    ErrorCode = class'TsSystem'.static.GetLastError(ErrorMessage);
    ShowRetryContinueWithoutSavingDialogue(Localize("TdStart", "ProfileInitErrorBody" $ string(ErrorCode), "TdGameUI"), Localize("TdStart", "ProfileInitErrorTitle", "TdGameUI"), OnOverwriteProfileContinueWithoutSaving, OnOverwriteProfileRetry);
    //return;    
}

private final function OnOverwriteProfileRetry()
{
    ReadProfile();
    //return;    
}

function FinishReadProfile()
{
    BlockUIInput(false);
    OnInitSavefileSystemDone();
    //return;    
}

