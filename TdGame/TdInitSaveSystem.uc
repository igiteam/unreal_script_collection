    MsgBox.Display(Localize("TdStart", "SaveXenonReselectDeviceBody", "TdGameUI"), Localize("TdStart", "SaveXenonReselectDeviceTitle", "TdGameUI"), OnShowXenonReselectDevice);
    //return;    
}

private final function OnShowXenonReselectDevice(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    local TsSystem SaveS;

    BlockUIInput(false);
    // End:0x20
    if(SelectedOption == 1)
    {
        InitSavefileSystem();
    }
    // End:0x51
    else
    {
        SaveS = class'TsSystem'.static.GetTsSystem();
        SaveS.SetNoSaving(true);
        FinishInit();
    }
    //return;    
}

