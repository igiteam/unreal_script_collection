class TdMove_RumpSlide extends TdPhysicsMove
    native
    config(PawnMovement);

var private ForceFeedbackWaveform SlideWaveform;
var float TimeFalling;
var config float MaxSlideSpeed;
var config float SideControl;
var config float GravityModifier;
var config float InitialSpeedLoss;
var config float MinSlideFloorZ;
var float OldFloorZ;
var bool bTouchedFallHeightVolume;

function bool CanDoMove()
{
    // End:0x26
    if(PawnOwner.UncontrolledSlideNormal.Z >= MinSlideFloorZ)
    {
        return false;
    }
    // End:0x4C
    if(PawnOwner.UncontrolledSlideNormal.Z < 0.60)
    {
        return false;
    }
    return super(TdMove).CanDoMove();
    //return ReturnValue;    
}

simulated function StartMove()
{
    super.StartMove();
    TimeFalling = 0.0;
    PawnOwner.GravityModifier = GravityModifier;
    PawnOwner.Velocity = (((PawnOwner.UncontrolledSlideNormal Cross vect(0.0, 0.0, -1.0)) Cross PawnOwner.UncontrolledSlideNormal) * VSize(PawnOwner.Velocity)) * InitialSpeedLoss;
    PawnOwner.SetAnimationMovementState(1);
    SetTimer(0.0);
    OldFloorZ = PawnOwner.WalkableFloorZ;
    PawnOwner.WalkableFloorZ = MinSlideFloorZ;
    PawnOwner.StreakEffectOverride = 1.0;
    bTouchedFallHeightVolume = false;
    //return;    
}

simulated function StopMove()
{
    super.StopMove();
    PawnOwner.WalkableFloorZ = OldFloorZ;
    PawnOwner.GravityModifier = 1.0;
    PawnOwner.LastFootstepMaterial = none;
    PawnOwner.StopSlideEffect();
    PawnOwner.StreakEffectOverride = 0.0;
    TdPlayerController(PawnOwner.Controller).ClientStopForceFeedbackWaveform(SlideWaveform);
    //return;    
}

simulated function TouchedFallHeightVolume()
{
    bTouchedFallHeightVolume = true;
    //return;    
}

simulated function OnTimer()
{
    StartSliding();
    //return;    
}

simulated function StartSliding()
{
    local Vector Side, Surface;

    Side = PawnOwner.UncontrolledSlideNormal Cross vect(0.0, 0.0, 1.0);
    Surface = PawnOwner.UncontrolledSlideNormal Cross Side;
    SetPreciseRotation(rotator(Surface), AnimBlendTime);
    PawnOwner.SetAnimationMovementState(0);
    PlayMoveAnim(2, 'crouchslideintoend45', 1.0, 0.150, 0.20, false);
    TdPlayerController(PawnOwner.Controller).ClientPlayForceFeedbackWaveform(SlideWaveform);
    PawnOwner.StartSlideEffect();
    //return;    
}

