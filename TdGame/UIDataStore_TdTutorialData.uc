private final event TdProfileSettings GetProfileSettings()
{
    local TdProfileSettings Result;
    local OnlineSubsystem OnlineSub;
    local OnlinePlayerInterface PlayerInterface;

    OnlineSub = class'GameEngine'.static.GetOnlineSubsystem();
    // End:0x7B
    if(OnlineSub != none)
    {
        PlayerInterface = OnlineSub.PlayerInterface;
        // End:0x7B
        if(NotEqual_InterfaceInterface(PlayerInterface, (none)))
        {
            Result = TdProfileSettings(PlayerInterface.GetProfileSettings(byte(PlayerOwner.ControllerId)));
        }
    }
    return Result;
    //return ReturnValue;    
}

