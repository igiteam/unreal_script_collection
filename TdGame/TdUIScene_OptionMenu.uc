function SetupButtonBar()
{
    local string SaveSettingsButtonMarkup;

    ButtonBar.AppendButton("<Strings:TdGameUI.TdbuttonCallouts.Cancel>", OnButtonBar_Cancel);
    SaveSettingsButtonMarkup = ((GetLoginStatus(PlayerOwner.ControllerId) == 0) ? "<Strings:TdGameUI.TdbuttonCallouts.Accept>" : "<Strings:TdGameUI.TdbuttonCallouts.SaveSettings>");
    ButtonBar.AppendButton(SaveSettingsButtonMarkup, OnButtonBar_Accept);
    ButtonBar.AppendButton("<Strings:TdGameUI.TdbuttonCallouts.ResetToDefaults>", OnButtonBar_Reset);
    ButtonBar.DisableButton(1, true);
    //return;    
}

function bool OnButtonBar_Cancel(UIScreenObject Sender, int PlayerIndex)
{
    OnCancel();
    return true;
    //return ReturnValue;    
}

function bool OnButtonBar_Accept(UIScreenObject Sender, int PlayerIndex)
{
    OnAccept();
    return true;
    //return ReturnValue;    
}

function bool OnButtonBar_Reset(UIScreenObject Sender, int PlayerIndex)
{
    OnReset();
    return true;
    //return ReturnValue;    
}

protected function OnReset_MessageBoxCallback(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    // End:0x15
    if(SelectedOption == 1)
    {
        DoReset();
    }
    //return;    
}

function OnReset()
{
    OpenMessageBox(OnReset_MsgBoxInit);
    //return;    
}

function OnReset_MsgBoxInit(UIScene OpenedScene, bool bInitialActivation)
{
    TdUIScene_MessageBox(OpenedScene).DisplayAcceptCancelBox("<Strings:TdGameUI.TdMessageBox.ResetWarning_Message>", "<Strings:TdGameUI.TdMessageBox.ResetWarning_Title>", OnReset_MessageBoxCallback);
    //return;    
}

function OnCancel()
{
    // End:0x20
    if(bChanged)
    {
        OpenMessageBox(WillNotSave_MsgBoxInit);
    }
    // End:0x2B
    else
    {
        OnCloseScene();
    }
    //return;    
}

private final function WillNotSave_MsgBoxInit(UIScene OpenedScene, bool bInitialActivation)
{
    TdUIScene_MessageBox(OpenedScene).__OnNotifyOptionSelected__Delegate = OnWillNotSave_OptionSelected;
    TdUIScene_MessageBox(OpenedScene).DisplayAcceptCancelBox("<Strings:TdGameUI.TdMessageBox.WillNotSave_Message>", "<Strings:TdGameUI.TdMessageBox.WillNotSave_Title>", OnCancel_Confirm);
    //return;    
}

function OnWillNotSave_OptionSelected(TdUIScene_MessageBox MsgBoxScene, int SelectedOption, int PlayerIndex)
{
    // End:0x1D
    if(SelectedOption == 1)
    {
        MsgBoxScene.SceneTransitionAnimOveride = 1;
    }
    //return;    
}

function OnCancel_Confirm(TdUIScene_MessageBox MsgBox, int SelectedOption, int PlayerIndex)
{
    // End:0x15
    if(SelectedOption == 1)
    {
        OnCancelChanges();
    }
    //return;    
}

function OnCancelChanges()
{
    ResetWidgetValues();
    SaveWidgetValues();
    OnCloseScene(2);
    //return;    
}

function OnAccept()
{
    local UIDataStore_OnlinePlayerData PlayerData;
    local int ControllerId;

    GetTdInteraction().BlockUIInput(true);
    ButtonBar.DisableAllButtons(true);
    SaveWidgetValues();
    ControllerId = class'UIInteraction'.static.GetPlayerControllerId(0);
    PlayerInterface.AddWriteProfileSettingsCompleteDelegate(byte(ControllerId), OnProfileWriteComplete);
    PlayerData = UIDataStore_OnlinePlayerData(FindDataStore('OnlinePlayerData', GetPlayerOwner()));
    // End:0xB5
    if(PlayerData != none)
    {
        PlayerData.SaveProfileData();
    }
    InitializeSettings();
    //return;    
}

function InitializeSettings()
{
    //return;    
}

event OnProfileWriteComplete(bool bSucceeded)
{
    GetTdInteraction().BlockUIInput(false);
    ButtonBar.DisableAllButtons(false);
    PlayerInterface.ClearWriteProfileSettingsCompleteDelegate(byte(class'UIInteraction'.static.GetPlayerControllerId(0)), OnProfileWriteComplete);
    // End:0x73
    if(bSucceeded)
    {
        OnCloseScene();
    }
    // End:0x87
    else
    {
        OpenMessageBox(ProfileWriteFailed_MsgBoxInit);
    }
    //return;    
}

private final function ProfileWriteFailed_MsgBoxInit(UIScene OpenedScene, bool bInitialActivation)
{
    TdUIScene_MessageBox(OpenedScene).__OnNotifyOptionSelected__Delegate = OnProfileWriteFailed_PreSelection;
    TdUIScene_MessageBox(OpenedScene).DisplayAcceptCancelRetryBox("<Strings:TdGameUI.TdMessageBox.FailedToWriteProfileOptions_Message>", "<Strings:TdGameUI.TdMessageBox.FailedToWriteProfile_Title>", OnProfileWriteFailed_Closed);
    //return;    
}

private final function OnProfileWriteFailed_PreSelection(TdUIScene_MessageBox InMessageBox, int SelectedOption, int PlayerIndex)
{
    InMessageBox.SceneTransitionAnimOveride = 1;
    //return;    
}

function OnProfileWriteFailed_Closed(TdUIScene_MessageBox MsgBox, int SelectedOption, int PlayerIndex)
{
    switch(SelectedOption)
    {
        // End:0x19
        case 1:
            OnAccept();
            // End:0x1C
            break;
        // End:0xFFFF
        default:
            //return;
    }    
}

function DoReset()
{
    local int OptionIndex;

    OnChange();
    ResetSettingsToDefault();
    OptionIndex = 0;
    J0x1B:
    // End:0x9C [Loop If]
    if(OptionIndex < OptionObjects.Length)
    {
        // End:0x60
        if(UISlider(OptionObjects[OptionIndex]) != none)
        {
            UISlider(OptionObjects[OptionIndex]).RefreshSubscriberValue();
            // [Explicit Continue]
            goto J0x92;
        }
        // End:0x92
        if(UITdOptionButton(OptionObjects[OptionIndex]) != none)
        {
            UITdOptionButton(OptionObjects[OptionIndex]).RefreshSubscriberValue();
        }
        J0x92:
        ++ OptionIndex;
        // [Loop Continue]
        goto J0x1B;
    }
    SaveWidgetValues();
    //return;    
}

function OnCloseScene(optional Engine.UIScene.ESceneTransitionAnim SceneAnim)
{
    SceneAnim = 0;
    CloseScene(self, false, SceneAnim);
    //return;    
}

function OnOptionValueChanged(UIObject Sender, int PlayerIndex)
{
    OnChange();
    SaveWidgetValues();
    //return;    
}

function OnChange()
{
    bChanged = true;
    ButtonBar.DisableButton(1, false);
    //return;    
}

function bool HandleInputKey(const out InputEventParameters EventParms)
{
    local bool bResult;

    // End:0xFC
    if(EventParms.EventType == 1)
    {
        // End:0x79
        if(((EventParms.InputKeyName == 'XboxTypeS_A') || EventParms.InputKeyName == 'Enter') && bChanged)
        {
            OnAccept();
            bResult = true;
        }
        // End:0xFC
        else
        {
            // End:0xAC
            if(EventParms.InputKeyName == 'XboxTypeS_X')
            {
                OnReset();
                bResult = true;
            }
            // End:0xFC
            else
            {
                // End:0xFC
                if((EventParms.InputKeyName == 'XboxTypeS_B') || EventParms.InputKeyName == 'Escape')
                {
                    OnCancel();
                    bResult = true;
                }
            }
        }
    }
    return bResult;
    //return ReturnValue;    
}

event bool PlayInputKeyNotification(const out InputEventParameters EventParms)
{
    local bool bResult;

    // End:0x60
    if(EventParms.EventType == 1)
    {
        // End:0x60
        if(EventParms.InputKeyName == 'XboxTypeS_X')
        {
            PlayUISound('Default', EventParms.PlayerIndex);
            bResult = true;
        }
    }
    return bResult || super(TdUIScene).PlayInputKeyNotification(EventParms);
    //return ReturnValue;    
}

function SaveWidgetValues()
{
    local array<UIDataStore> OutDataStores;
    local int OptionIndex;

    OptionIndex = 0;
    J0x07:
    // End:0x47 [Loop If]
    if(OptionIndex < OptionObjects.Length)
    {
        UIDataStorePublisher(OptionObjects[OptionIndex]).SaveSubscriberValue(OutDataStores);
        ++ OptionIndex;
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

function ResetSettingsToDefault()
{
    //return;    
}

