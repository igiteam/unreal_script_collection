    {
        StoragePawn=none
        SeatPawn=none
        SeatPawnClass=none
        CharacterSeatSocket=None
        CharacterSeatBone=None
        CameraSeatSocket=None
        CameraOffset=0.0
        CameraEyeHeight=0.0
        ViewPitchMin=0.0
        ViewPitchMax=0.0
    }
};

struct native TimePosition
{
    var Vector Position;
    var float Time;

    structdefaultproperties
    {
        Position=(X=0.0,Y=0.0,Z=0.0)
        Time=0.0
    }
};

