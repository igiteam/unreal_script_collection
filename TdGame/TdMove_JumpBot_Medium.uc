class TdMove_JumpBot_Medium extends TdMove_JumpBot_Base
    native
    config(PawnMovement);

simulated function BeginJump()
{
    PlayMoveAnim(2, 'JumpUpMediumNormal', 1.0, 0.10, 0.10);
    SetTimer(0.050);
    //return;    
}

simulated event StartAnticipation()
{
    super.StartAnticipation();
    PlayMoveAnim(2, 'JumpLandMediumStart', 1.0, 0.10, 0.10);
    bAnticipating = true;
    //return;    
}

simulated function OnTimer()
{
    SetPreciseLocation(GetPreciseLandingLocation(), 3, ForcedSpeed);
    //return;    
}

simulated event ReachedPreciseLocation()
{
    PawnOwner.SetMove(20);
    //return;    
}

simulated event FailedToReachPreciseLocation()
{
    PawnOwner.SetMove(2);
    //return;    
}
