simulated function PlayFiringAnimation()
{
    local name PawnAnimSeqName, WeaponAnimSeqName;
    local bool WeaponRequestSpecialAnimation;
    local Rotator ViewRotation;
    local TdPawn TakedownPawn;

    TakedownPawn = TdPawn(Owner);
    WeaponRequestSpecialAnimation = GetFireAnimName(WeaponAnimSeqName);
    // End:0x106
    if(TakedownPawn != none)
    {
        PawnAnimSeqName = TakedownPawn.PlayFireAnimation(WeaponAnimSeqName, WeaponRequestSpecialAnimation);
        // End:0x9D
        if(TakedownPawn.RecoilControl1p != none)
        {
            TakedownPawn.RecoilControl1p.AddImpulse(RecoilAmount, RecoilRecoverTime, MinRecoil, MaxRecoil);
        }
        // End:0x106
        if(TakedownPawn.Controller != none)
        {
            ViewRotation = TakedownPawn.Controller.Rotation;
            ViewRotation.Pitch += int(KickbackAmount);
            TakedownPawn.Controller.SetRotation(ViewRotation);
        }
    }
    // End:0x195
    if((PawnAnimSeqName != 'None') && TakedownPawn != none)
    {
        // End:0x157
        if(WeaponAnimationNode1p != none)
        {
            WeaponAnimationNode1p.PlayCustomAnim(PawnAnimSeqName, 1.0, 0.10, 0.20, false, true);
        }
        // End:0x195
        if((WeaponAnimationNode3p != none) && TakedownPawn != none)
        {
            WeaponAnimationNode3p.PlayCustomAnim(PawnAnimSeqName, 1.0, 0.10, 0.20, false, true);
        }
    }
    //return;    
}

