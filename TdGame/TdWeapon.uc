}

simulated function FireAmmunition()
{
    local TdPlayerController PC;
    local TdBotPawn BotPawn;

    PC = TdPlayerController(Instigator.Controller);
    BotPawn = TdBotPawn(Instigator);
    // End:0x52
    if((BotPawn != none) && !BotPawn.IsOkToFireBullet())
    {
        return;
    }
    ConsumeAmmo(CurrentFireMode);
    PlayFiringSound();
    // End:0x8C
    if(PC != none)
    {
        PC.AddStatsEvent(0);
    }
    switch(WeaponFireTypes[CurrentFireMode])
    {
        // End:0xAE
        case 0:
            InstantFire();
            // End:0xD5
            break;
        // End:0xC0
        case 1:
            ProjectileFire();
            // End:0xD5
            break;
        // End:0xD2
        case 2:
            CustomFire();
            // End:0xD5
            break;
        // End:0xFFFF
        default:
            // End:0x11B
            if(AIController(Instigator.Controller) != none)
            {
                AIController(Instigator.Controller).NotifyWeaponFired(self, CurrentFireMode);
            }
            // End:0x13B
            else
            {
                // End:0x13B
                if(PC != none)
                {
                    PC.NotifyWeaponFired(self);
                }
            }
            //return;
    }    
}

