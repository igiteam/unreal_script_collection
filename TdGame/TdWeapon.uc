simulated function float GetInstantHitDamage(int Mode, float Distance)
{
    local float Damage, zeroToOne;

    // End:0x35
    if(WorldInfo.GRI.IsMultiplayerGame())
    {
        Damage = InstantHitDamageMP[Mode];
    }
    // End:0x46
    else
    {
        Damage = InstantHitDamage[Mode];
    }
    // End:0x121
    if((Distance > FallOffDistance) && Distance < WeaponRange)
    {
        zeroToOne = FPctByRange(Distance, FallOffDistance, WeaponRange);
        switch(WeaponFallOffTypes[Mode])
        {
            // End:0xA8
            case 0:
                Damage *= (float(1) - zeroToOne);
                // End:0x11E
                break;
            // End:0xCC
            case 1:
                Damage *= FMin(-0.20 * Loge(zeroToOne), 1.0);
                // End:0x11E
                break;
            // End:0xEB
            case 2:
                Damage /= ((float(3) * zeroToOne) + float(1));
                // End:0x11E
                break;
            // End:0x11B
            case 3:
                Damage *= (float(1) - FMin(-0.20 * Loge(1.0 - zeroToOne), 1.0));
                // End:0x11E
                break;
            // End:0xFFFF
            default:
                // End:0x13B
                break;
            }
    }
    // End:0x13B
    if(Distance >= WeaponRange)
    {
        Damage = 0.0;
    }
    // End:0x15C
    if(!Instigator.IsHumanControlled())
    {
        Damage *= AIDamageMultiplier;
    }
    return Damage;
    //return ReturnValue;    
}

simulated function float GetInstantHitMomentum(int Mode, float Distance)
{
    local float Momentum, zeroToOne;

    Momentum = 0.0;
    // End:0x2E
    if(Distance < FallOffDistance)
    {
        Momentum = InstantHitMomentum[Mode];
    }
    // End:0x125
    else
    {
        // End:0x125
        if(Distance < WeaponRange)
        {
            zeroToOne = FPctByRange(Distance, FallOffDistance, WeaponRange);
            switch(WeaponFallOffTypes[Mode])
            {
                // End:0x8B
                case 0:
                    Momentum = InstantHitMomentum[Mode] * (float(1) - zeroToOne);
                    // End:0x125
                    break;
                // End:0xBB
                case 1:
                    Momentum = InstantHitMomentum[Mode] * FMin(-0.20 * Loge(zeroToOne), 1.0);
                    // End:0x125
                    break;
                // End:0xE6
                case 2:
                    Momentum = InstantHitMomentum[Mode] / ((float(3) * zeroToOne) + float(1));
                    // End:0x125
                    break;
                // End:0x122
                case 3:
                    Momentum = InstantHitMomentum[Mode] * (float(1) - FMin(-0.20 * Loge(1.0 - zeroToOne), 1.0));
                    // End:0x125
                    break;
                // End:0xFFFF
                default:
                }
            }
            return Momentum;
            //return ReturnValue;            
}

function DropFrom(Vector StartLocation, Vector StartVelocity)
{
    TdPawn(Owner).TossWeapon(self, StartVelocity);
    //return;    
}

function DropFromEx(Vector StartLocation, Vector StartVelocity, Rotator StartRotation, Vector StartAngularVelocity)
{
    local TdPickup P;

    // End:0x11
    if(!CanThrow())
    {
        return;
    }
    ForceEndFire();
    DetachWeapon();
    ClientWeaponThrown();
    // End:0x62
    if((DroppedPickupClass == none) || DroppedPickupMesh == none)
    {
        TdPawn(Owner).RemoveWeaponAfterDrop();
        return;
    }
    P = TdPickup(Spawn(DroppedPickupClass,,, StartLocation, StartRotation));
    // End:0xAC
    if(P == none)
    {
        TdPawn(Owner).RemoveWeaponAfterDrop();
        return;
    }
    P.SetRotation(StartRotation);
    P.Velocity = StartVelocity;
    P.Inventory = self;
    P.InventoryClass = Class;
    P.SetAmmoCount(AmmoCount);
    P.SetClipCount(ClipCount);
    P.Instigator = Instigator;
    DroppedPickupMesh.SetDepthPriorityGroup(1);
    P.SetPickupMesh(DroppedPickupMesh);
    P.CollisionSnd = WeaponCollisionSnd;
    // End:0x255
    if(SkeletalMeshComponent(DroppedPickupMesh).PhysicsAsset != none)
    {
        P.CollisionComponent.SetRBPosition(StartLocation);
        P.CollisionComponent.SetRBRotation(StartRotation);
        P.CollisionComponent.SetRBAngularVelocity(StartAngularVelocity, true);
        P.CollisionComponent.SetRBLinearVelocity(StartVelocity);
        P.CollisionComponent.SetTraceBlocking(false, false);
        P.CollisionComponent.SetActorCollision(false, false);
        J0x255:
    }
    // End:0x255
    else
    {
    }
    P.LifeSpan = float(Max(TimeThrownWeaponStaysInWorld, 2));
    P.SetTimer(float(TimeThrownWeaponStaysInWorld - 1), false);
    //return;    
}

simulated state WeaponFiring
{
    simulated function bool IsFiring()
    {
        return true;
        //return ReturnValue;        
    }

    simulated function RefireCheckTimer()
    {
        local TdPawn myPawn;

        // End:0x9F
        if((WorldInfo.NetMode != NM_Standalone) && !Instigator.IsLocallyControlled())
        {
            myPawn = TdPawn(Instigator);
            // End:0x9F
            if(bStickyAim && StickyActor != none)
            {
                UpdateStickyActor(none, Instigator.Controller, myPawn.Moves[myPawn.MovementState], FireInterval[CurrentFireMode]);
            }
        }
        super.RefireCheckTimer();
        //return;        
    }
    stop;    
}

simulated state WeaponReloading
{
    ignores ReloadWeapon, WeaponEmpty, StartFire;

    simulated function BeginState(name PreviousStateName)
    {
        // End:0x1C
        if(ReloadWaitTime > 0.0)
        {
            TimeReloadWait();
        }
        // End:0x32
        else
        {
            TimeWeaponReloading();
            PlayReloadAnimation(1);
        }
        //return;        
    }

    simulated function bool IsReloading()
    {
        // End:0x15
        if(IsTimerActive('ReloadWaitComplete'))
        {
            return false;
        }
        return true;
        //return ReturnValue;        
    }

    simulated function bool IsInStateReloading()
    {
        return true;
        //return ReturnValue;        
    }

    simulated function bool ShouldRefire()
    {
        return false;
        //return ReturnValue;        
    }

    simulated function EndState(name NextStateName)
    {
        ClearTimer('WeaponReloadedTimer');
        TdPawn(Instigator).PlayWeaponStoppedReloading();
        //return;        
    }

    simulated function bool TryPutDown()
    {
        PutDownWeapon();
        return true;
        //return ReturnValue;        
    }
    stop;    
}

simulated state WeaponLoopReloading extends WeaponReloading
{
    ignores ReloadWeapon;

    simulated function BeginState(name PreviousStateName)
    {
        ReloadTime = StartReloadTime;
        TimeWeaponReloading();
        PlayReloadAnimation(0);
        //return;        
    }

    simulated function EndState(name NextStateName)
    {
        super.EndState(NextStateName);
        //return;        
    }

    simulated function bool IsReloading()
    {
        // End:0x15
        if(IsTimerActive('ReloadWaitComplete'))
        {
            return false;
        }
        return true;
        //return ReturnValue;        
    }

    simulated function bool IsInStateReloading()
    {
        return true;
        //return ReturnValue;        
    }

    simulated function WeaponReloaded(optional bool SuccessfulReload)
    {
        SuccessfulReload = true;
        // End:0x46
        if((AmmoCount < (MaxAmmo - 1)) || bRemoteWeapon)
        {
            ReloadTime = default.ReloadTime;
            TimeWeaponReloading();
            PlayReloadAnimation(1);
        }
        // End:0x67
        else
        {
            ReloadTime = EndReloadTime;
            TimeWeaponEndReloading();
            PlayReloadAnimation(2);
        }
        // End:0x77
        if(SuccessfulReload)
        {
            ++ AmmoCount;
        }
        //return;        
    }

    simulated function WeaponEndReloaded()
    {
        WeaponReloaded();
        //return;        
    }

    simulated function WeaponStoppedReloading()
    {
        // End:0x23
        if(bRemoteWeapon)
        {
            GotoState('Active');
            PlayReloadAnimation(2);
        }
        //return;        
    }

    simulated function StartFire(byte FireModeNum)
    {
        // End:0x1F
        if(Role < ROLE_Authority)
        {
            ServerStartFire(FireModeNum);
        }
        // End:0x34
        if(AmmoCount > 0)
        {
            WeaponEndReloaded();
        }
        //return;        
    }

    reliable server function ServerStartFire(byte FireModeNum)
    {
        // End:0x15
        if(AmmoCount > 0)
        {
            WeaponEndReloaded();
        }
        //return;        
    }
    stop;    
}

simulated state WeaponBursting extends WeaponFiring
{
    simulated function BeginState(name PrevStateName)
    {
        BurstCnt = 1;
        super.BeginState(PrevStateName);
        //return;        
    }

    simulated function EndState(name NextStateName)
    {
        super.EndState(NextStateName);
        ClearTimer('RefireCheckTimer');
        //return;        
    }

    simulated function bool TryPutDown()
    {
        bWeaponPutDown = true;
        return true;
        //return ReturnValue;        
    }

    simulated function bool IsFiring()
    {
        return true;
        //return ReturnValue;        
    }

    simulated function RefireCheckTimer()
    {
        local TdPawn myPawn;
        local TdBotPawn BotPawn;

        // End:0x9F
        if((WorldInfo.NetMode != NM_Standalone) && !Instigator.IsLocallyControlled())
        {
            myPawn = TdPawn(Instigator);
            // End:0x9F
            if(bStickyAim && StickyActor != none)
            {
                UpdateStickyActor(none, Instigator.Controller, myPawn.Moves[myPawn.MovementState], FireInterval[CurrentFireMode]);
            }
        }
        // End:0xB4
        if(bWeaponPutDown)
        {
            PutDownWeapon();
            return;
        }
        BotPawn = TdBotPawn(Instigator);
        // End:0xEC
        if((BotPawn != none) && !BotPawn.IsOkToFireBullet())
        {
            return;
        }
        // End:0x132
        if((BurstCnt >= BurstMax) || !HasAmmo(CurrentFireMode))
        {
            EndFire(CurrentFireMode);
            GotoState('Active');
        }
        // End:0x143
        else
        {
            ++ BurstCnt;
            FireAmmunition();
        }
        //return;        
    }
    stop;    
}

simulated state WeaponPuttingDown
{
    simulated function WeaponIsDown()
    {
        // End:0x19
        if(InvManager.CancelWeaponChange())
        {
            return;
        }
        GotoState('Inactive');
        InvManager.ChangedWeapon();
        //return;        
    }
    stop;    
}

simulated state OutOfAmmo
{
    function BeginState(name PreviouseState)
    {
        // End:0x1C
        if(bAutoDrop)
        {
            SetTimer(1.50, false, 'DropWeaponTimer');
        }
        // End:0x91
        if(OutOfAmmoAnimName != 'None')
        {
            // End:0x60
            if(WeaponAnimationNode1p != none)
            {
                WeaponAnimationNode1p.PlayCustomAnim(OutOfAmmoAnimName, 1.0, 0.0, -1.0, true, true);
            }
            // End:0x91
            if(WeaponAnimationNode3p != none)
            {
                WeaponAnimationNode3p.PlayCustomAnim(OutOfAmmoAnimName, 1.0, 0.0, -1.0, true, true);
            }
        }
        //return;        
    }

    function DropWeaponTimer()
    {
        TdPawn(Instigator).DropWeapon();
        TdPawn(Instigator).OnTutorialEvent(10);
        //return;        
    }

    simulated function StartFire(byte FireModeNum)
    {
        // End:0x30
        if(WeaponClickSnd != none)
        {
            Instigator.PlaySound(WeaponClickSnd, true, true, true, GetPhysicalFireStartLoc());
        }
        //return;        
    }
    stop;    
}

