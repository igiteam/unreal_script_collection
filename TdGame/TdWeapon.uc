simulated function PlayFireEffects(byte FireModeNum, optional Vector HitLocation)
{
    // End:0x6C
    if(Instigator.IsHumanControlled())
    {
        // End:0x39
        if(ShellEjectDelay > 0.0)
        {
            SetTimer(ShellEjectDelay, false, 'PlayShellCaseEject');
        }
        // End:0x43
        else
        {
            PlayShellCaseEject();
        }
        TdPlayerController(TdPawn(Owner).Controller).ClientPlayForceFeedbackWaveform(FiringWaveform);
    }
    CauseMuzzleFlash();
    //return;    
}

simulated function StopFireEffects(byte FireModeNum)
{
    StopMuzzleFlash();
    // End:0x42
    if(ShellEjectEmitter != none)
    {
        ShellEjectEmitter.ParticleSystemComponent.DeactivateSystem();
        SetTimer(2.0, false, 'HideShellEject');
    }
    // End:0x70
    if((FireModeNum < bAutomaticReFire.Length) && bAutomaticReFire[FireModeNum])
    {
        PlayReverbSound();
    }
    //return;    
}

simulated function PlayShellCaseEject()
{
    local Vector ShellPos;
    local Rotator ShellRot;

    // End:0x8A
    if(ShellEjectEmitter != none)
    {
        Mesh1p.GetSocketWorldLocationAndRotation(ShellEjectSocket, ShellPos, ShellRot);
        ShellEjectEmitter.SetRotation(ShellRot);
        ShellEjectEmitter.SetLocation(ShellPos);
        ShellEjectEmitter.SetHidden(false);
        ClearTimer('HideShellEject');
        ShellEjectEmitter.ParticleSystemComponent.ActivateSystem();
    }
    //return;    
}

simulated function HideShellEject()
{
    ShellEjectEmitter.SetHidden(true);
    ShellEjectEmitter.ParticleSystemComponent.RewindEmitterInstances();
    //return;    
}

