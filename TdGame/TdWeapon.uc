simulated function bool ShouldRefire()
{
    local TdPlayerPawn PlayerInstigator;

    // End:0x7C
    if(Instigator.IsHumanControlled())
    {
        PlayerInstigator = TdPlayerPawn(Instigator);
        // End:0x7C
        if((PlayerInstigator.AgainstWallState == 1) || (PlayerInstigator.AgainstWallState == 2) && WeaponType == 2)
        {
            EndFire(CurrentFireMode);
            return false;
        }
    }
    // End:0xC7
    if((!HasAnyAmmo() || !HasAmmo(CurrentFireMode)) || !bAutomaticReFire[CurrentFireMode])
    {
        EndFire(CurrentFireMode);
        return false;
    }
    return StillFiring(CurrentFireMode);
    //return ReturnValue;    
}

simulated function WeaponFired(byte FiringMode, optional Vector HitLocation)
{
    PlayFireEffects(FiringMode, HitLocation);
    // End:0x3A
    if(Instigator != none)
    {
        Instigator.WeaponFired(false, HitLocation);
    }
    PlayFiringAnimation();
    //return;    
}

simulated function WeaponStoppedFiring(byte FiringMode)
{
    // End:0x20
    if(Instigator != none)
    {
        Instigator.WeaponStoppedFiring(false);
    }
    StopFireEffects(FiringMode);
    //return;    
}

simulated function FlashCountUpdated(byte FlashCount, byte FiringMode, bool bViaReplication)
{
    // End:0x23
    if(FlashCount > 0)
    {
        WeaponFired(FiringMode);
    }
    // End:0x32
    else
    {
        WeaponStoppedFiring(FiringMode);
    }
    //return;    
}

simulated function FlashLocationUpdated(byte FiringMode, Vector FlashLocation, bool bViaReplication)
{
    local bool bZeroFlashCount;

    bZeroFlashCount = IsZero(FlashLocation);
    // End:0x65
    if((WorldInfo.NetMode != NM_Client) || bRemoteWeapon)
    {
        // End:0x56
        if(!bZeroFlashCount)
        {
            WeaponFired(FiringMode, FlashLocation);
        }
        // End:0x65
        else
        {
            WeaponStoppedFiring(FiringMode);
        }
    }
    // End:0x8F
    if(!bZeroFlashCount && bViaReplication)
    {
        CalcRemoteImpactEffects(FiringMode, FlashLocation);
    }
    //return;    
}

simulated function CalcRemoteImpactEffects(byte FireModeNum, Vector GivenHitLocation)
{
    local ImpactInfo Impact;
    local Vector AimDirection, WeaponLocation;

    // End:0x44
    if(Instigator != none)
    {
        WeaponLocation = Instigator.Location;
        WeaponLocation.Z += Instigator.BaseEyeHeight;
    }
    // End:0x4F
    else
    {
        WeaponLocation = Location;
    }
    AimDirection = Normal(GivenHitLocation - WeaponLocation) * 30.0;
    Impact = CalcRemoteWeaponFire(GivenHitLocation - AimDirection, GivenHitLocation + AimDirection);
    // End:0xC1
    if(Impact.HitActor == none)
    {
        Impact.HitLocation = GivenHitLocation;
    }
    // End:0xD0
    else
    {
        PlayImpactEffects(Impact);
    }
    //return;    
}

simulated function ImpactInfo CalcRemoteWeaponFire(Vector StartTrace, Vector EndTrace)
{
    local Vector HitLocation, HitNormal;
    local Actor HitActor;
    local TraceHitInfo HitInfo;
    local ImpactInfo CurrentImpact;

    HitActor = GetTraceOwner().Trace(HitLocation, HitNormal, EndTrace, StartTrace, true, vect(0.0, 0.0, 0.0), HitInfo, 1);
    // End:0x56
    if(HitActor == none)
    {
        HitLocation = EndTrace;
    }
    CurrentImpact.HitActor = HitActor;
    CurrentImpact.HitLocation = HitLocation;
    CurrentImpact.HitNormal = HitNormal;
    CurrentImpact.RayDir = Normal(EndTrace - StartTrace);
    CurrentImpact.HitInfo = HitInfo;
    return CurrentImpact;
    //return ReturnValue;    
}

simulated function ProcessInstantHit(byte FiringMode, ImpactInfo Impact)
{
    // End:0x112
    if(Impact.HitActor != none)
    {
        Impact.HitActor.TakeDamage(int(GetInstantHitDamage(FiringMode, Impact.TracedDistance)), Instigator.Controller, Impact.HitLocation, (GetInstantHitMomentum(FiringMode, Impact.TracedDistance)) * Impact.RayDir, InstantHitDamageTypes[FiringMode], Impact.HitInfo, self);
        // End:0x112
        if(Impact.HitActor.IsA('Trigger') || Impact.HitActor.IsA('TriggerVolume'))
        {
            return;
        }
    }
    // End:0x176
    if(WorldInfo.NetMode != NM_DedicatedServer)
    {
        // End:0x151
        if(BulletTraceTemplate != none)
        {
            SpawnTracerEffect(Impact.HitLocation);
        }
        // End:0x176
        if(Impact.HitActor != none)
        {
            RegisterPendingImpact(Impact);
        }
    }
    //return;    
}

simulated function RegisterPendingImpact(ImpactInfo Impact)
{
    local TdPawn Victim;
    local PendingImpact ImpactToDelay;

    // End:0x82
    if(!Impact.HitActor.bStatic)
    {
        Victim = TdPawn(Impact.HitActor);
        // End:0x70
        if((Victim != none) && Victim.PreventWeaponImpactEffect(Instigator.Controller))
        {
            return;
        }
        PlayImpactEffects(Impact);
    }
    // End:0xD2
    else
    {
        ImpactToDelay.Impact = Impact;
        ImpactToDelay.TimeToImpact = Impact.TracedDistance / 20000.0;
        PendingImpacts[PendingImpacts.Length] = ImpactToDelay;
    }
    //return;    
}

simulated event PlayImpactEffects(ImpactInfo Impact)
{
    local TdPlayerPawn Victim;
    local TdBotPawn PawnInstigator;

    Victim = TdPlayerPawn(Impact.HitActor);
    PawnInstigator = TdBotPawn(Instigator);
    // End:0x57
    if(Victim == none)
    {
        SpawnImpactEffects(Impact);
        SpawnImpactDecal(Impact);
    }
    // End:0xAA
    else
    {
        // End:0xAA
        if((PawnInstigator != none) && PawnInstigator.myController.IsHitRelevant(class'TdDmgType_LowCaliber_Bullet', Impact.HitInfo.BoneName) == false)
        {
            return;
        }
    }
    SpawnImpactSounds(Impact);
    //return;    
}

simulated function SpawnTracerEffect(Vector HitLocation)
{
    local Vector ShotDirection, MuzzleLocation;
    local Rotator MuzzleRotation;
    local editinline SkeletalMeshComponent WeaponMesh;
    local TdEmitter CurrentTracerEmitter;
    local float Lifetime;

    WeaponMesh = SkeletalMeshComponent(Mesh);
    // End:0x69
    if((WeaponMesh != none) && MuzzleFlashSocket != 'None')
    {
        // End:0x69
        if(!WeaponMesh.GetSocketWorldLocationAndRotation(MuzzleFlashSocket, MuzzleLocation, MuzzleRotation))
        {
            MuzzleLocation = Owner.Location;
        }
    }
    ShotDirection = HitLocation - MuzzleLocation;
    MuzzleRotation = rotator(ShotDirection);
    // End:0x9B
    if(VSize(ShotDirection) < 3000.0)
    {
        return;
    }
    Lifetime = -0.50 + Sqrt(((2.0 * VSize(HitLocation - MuzzleLocation)) / float(40000)) + 0.250);
    Lifetime -= WorldInfo.DeltaSeconds;
    CurrentTracerEmitter = TracerEmitters[TracerEmitterIdx];
    CurrentTracerEmitter.ClearTimer('KillProjectile');
    CurrentTracerEmitter.SetTimer(Lifetime, false, 'KillProjectile');
    CurrentTracerEmitter.bStasis = false;
    CurrentTracerEmitter.SetHidden(false);
    CurrentTracerEmitter.SetLocation(MuzzleLocation);
    CurrentTracerEmitter.SetRotation(MuzzleRotation);
    CurrentTracerEmitter.SetDrawScale3D(vect(4.0, 1.0, 1.0));
    CurrentTracerEmitter.ParticleSystemComponent.ActivateSystem();
    TracerEmitterIdx += 1;
    // End:0x1C7
    if(TracerEmitterIdx >= 3)
    {
        TracerEmitterIdx = 0;
    }
    //return;    
}

simulated function SpawnImpactSounds(ImpactInfo Impact)
{
    local PhysicalMaterial ParentPhysMaterial;
    local SoundCue ImpactSound;
    local TraceHitInfo HitInfo;

    HitInfo = Impact.HitInfo;
    // End:0x7A
    if(HitInfo.PhysMaterial != none)
    {
        ImpactSound = GetImpactSound(Impact.HitInfo.PhysMaterial);
        ParentPhysMaterial = HitInfo.PhysMaterial.Parent;
    }
    // End:0x111
    else
    {
        // End:0x111
        if(HitInfo.Material != none)
        {
            // End:0x107
            if(HitInfo.Material.PhysMaterial != none)
            {
                ImpactSound = GetImpactSound(HitInfo.Material.PhysMaterial);
                ParentPhysMaterial = HitInfo.Material.PhysMaterial.Parent;
            }
            // End:0x10E
            else
            {
                ParentPhysMaterial = none;
            }
        }
        // End:0x111
        else
        {
        }
    }
    // End:0x156 [Loop If]
    if((none == ImpactSound) && ParentPhysMaterial != none)
    {
        ImpactSound = GetImpactSound(ParentPhysMaterial);
        ParentPhysMaterial = ParentPhysMaterial.Parent;
        // [Loop Continue]
        goto J0x111;
    }
    // End:0x176
    if(none == ImpactSound)
    {
        ImpactSound = GetImpactSound(DefaultImpactMaterial);
    }
    // End:0x1A1
    if(ImpactSound != none)
    {
        PlaySound(ImpactSound, true, false, false, Impact.HitLocation, false);
    }
    //return;    
}

simulated function SoundCue GetImpactSound(PhysicalMaterial PMaterial)
{
    local SoundCue retval;

    retval = none;
    // End:0x75
    if((((PMaterial == none) || PMaterial.PhysicalMaterialProperty == none) || TdPhysicalMaterialProperty(PMaterial.PhysicalMaterialProperty) == none) || TdPhysicalMaterialProperty(PMaterial.PhysicalMaterialProperty).TdPhysicalMaterialImpactSounds == none)
    {
        retval = none;
    }
    // End:0xA3
    else
    {
        retval = GetWeaponSpecificImpactSound(TdPhysicalMaterialProperty(PMaterial.PhysicalMaterialProperty).TdPhysicalMaterialImpactSounds);
    }
    return retval;
    //return ReturnValue;    
}

simulated function SoundCue GetWeaponSpecificImpactSound(TdPhysicalMaterialImpactSounds ImpactSounds)
{
    return ImpactSounds.LightAmmo;
    //return ReturnValue;    
}

simulated function SpawnImpactEffects(ImpactInfo Impact)
{
    local PhysicalMaterial ParentPhysMaterial;
    local ParticleSystem ImpactEffect;
    local editinline ParticleSystemComponent PSC;
    local TraceHitInfo HitInfo;
    local TdPawn Victim;
    local float MaxImpactEffectDistance;
    local Vector HitReflection;

    HitInfo = Impact.HitInfo;
    MaxImpactEffectDistance = 3000.0;
    // End:0x48
    if(!EffectIsRelevant(Impact.HitLocation, false, MaxImpactEffectDistance))
    {
        return;
    }
    // End:0x6C
    if(Impact.HitLocation == vect(0.0, 0.0, 0.0))
    {
        return;
    }
    Victim = TdPawn(Impact.HitActor);
    // End:0xA9
    if((Victim != none) && Victim.IsHumanControlled())
    {
        return;
    }
    // End:0xFE
    if(HitInfo.PhysMaterial != none)
    {
        ImpactEffect = GetImpactEffect(HitInfo.PhysMaterial);
        ParentPhysMaterial = HitInfo.PhysMaterial.Parent;
    }
    // End:0x18E
    else
    {
        // End:0x18E
        if(HitInfo.Material != none)
        {
            // End:0x187
            if(HitInfo.Material.PhysMaterial != none)
            {
                ImpactEffect = GetImpactEffect(HitInfo.Material.PhysMaterial);
                ParentPhysMaterial = HitInfo.Material.PhysMaterial.Parent;
            }
            // End:0x18E
            else
            {
                ParentPhysMaterial = none;
            }
        }
    }
    // End:0x1CF [Loop If]
    if((ImpactEffect == none) && ParentPhysMaterial != none)
    {
        ImpactEffect = GetImpactEffect(ParentPhysMaterial);
        ParentPhysMaterial = ParentPhysMaterial.Parent;
        // [Loop Continue]
        goto J0x18E;
    }
    // End:0x1EB
    if(ImpactEffect == none)
    {
        ImpactEffect = GetImpactEffect(DefaultImpactMaterial);
    }
    // End:0x2BE
    if(ImpactEffect != none)
    {
        HitReflection = MirrorVectorByNormal(Impact.RayDir, Impact.HitNormal);
        HitReflection += (((1.0 - (HitReflection Dot Impact.HitNormal)) * 0.30) * Impact.HitNormal);
        PSC = WorldInfo.MyEmitterPool.SpawnEmitter(ImpactEffect, Impact.HitLocation, rotator(HitReflection), Impact.HitActor);
        PSC.ActivateSystem();
    }
    //return;    
}

simulated function bool EffectIsRelevant(Vector SpawnLocation, bool bForceDedicated, optional float CullDistance)
{
    local PlayerController P;
    local float distanceSq, SightDotLook;

    // End:0x22
    if(WorldInfo.NetMode == NM_DedicatedServer)
    {
        return bForceDedicated;
    }
    // End:0xA2
    if((WorldInfo.NetMode == NM_ListenServer) && WorldInfo.Game.NumPlayers > 1)
    {
        // End:0x68
        if(bForceDedicated)
        {
            return true;
        }
        // End:0x9F
        if(((Instigator != none) && Instigator.IsHumanControlled()) && Instigator.IsLocallyControlled())
        {
            return true;
        }
    }
    // End:0xC4
    else
    {
        // End:0xC4
        if((Instigator != none) && Instigator.IsHumanControlled())
        {
            return true;
        }
    }
    // End:0xF4
    if(SpawnLocation == Location)
    {
        return (WorldInfo.TimeSeconds - LastRenderTime) < 0.50;
    }
    // End:0x12D
    else
    {
        // End:0x12D
        if((Instigator != none) && (WorldInfo.TimeSeconds - Instigator.LastRenderTime) < 1.0)
        {
            return true;
        }
    }
    // End:0x22D
    foreach LocalPlayerControllers(class'PlayerController', P)
    {
        // End:0x22C
        if(P.Pawn != none)
        {
            distanceSq = VSizeSq(P.Pawn.Location - SpawnLocation);
            // End:0x19C
            if(distanceSq < float(300 * 300))
            {                
                return true;
            }
            // End:0x22C
            if((CullDistance == float(0)) || distanceSq < (CullDistance * CullDistance))
            {
                SightDotLook = Normal(SpawnLocation - P.Pawn.Location) Dot vector(P.Pawn.Rotation);
                // End:0x22C
                if(SightDotLook >= P.Pawn.PeripheralVision)
                {                    
                    return true;
                }
            }
        }        
    }    
    return false;
    //return ReturnValue;    
}

final function ParticleSystem GetImpactEffect(PhysicalMaterial PMaterial)
{
    local ParticleSystem retval;

    retval = none;
    // End:0xF2
    if((((none != PMaterial) && none != PMaterial.PhysicalMaterialProperty) && none != TdPhysicalMaterialProperty(PMaterial.PhysicalMaterialProperty)) && none != TdPhysicalMaterialProperty(PMaterial.PhysicalMaterialProperty).TdPhysicalMaterialImpactEffects)
    {
        // End:0xC1
        if(class'TdGameInfo'.static.IsPhysXEnhanced())
        {
            retval = GetSpecificImpactEffectPhysX(TdPhysicalMaterialProperty(PMaterial.PhysicalMaterialProperty).TdPhysicalMaterialImpactEffects);
            // End:0xC1
            if(none != retval)
            {
                return retval;
            }
        }
        retval = GetSpecificImpactEffect(TdPhysicalMaterialProperty(PMaterial.PhysicalMaterialProperty).TdPhysicalMaterialImpactEffects);
    }
    // End:0xF9
    else
    {
        retval = none;
    }
    return retval;
    //return ReturnValue;    
}

function ParticleSystem GetSpecificImpactEffect(TdPhysicalMaterialImpactEffects ImpactEffects)
{
    return none;
    //return ReturnValue;    
}

function ParticleSystem GetSpecificImpactEffectPhysX(TdPhysicalMaterialImpactEffects ImpactEffects)
{
    return none;
    //return ReturnValue;    
}

simulated function SpawnImpactDecal(ImpactInfo Impact)
{
    local TraceHitInfo HitInfo;
    local editinline DecalComponent ImpactDecal;
    local float AngleOfImpact, RandScaling, UsedRotation, Stretching;
    local Vector Upward;

    HitInfo = Impact.HitInfo;
    // End:0x3D7
    if((DecalTypeToUse != 3) && IsDecalRelevant(Impact.HitLocation, DecalCullDistance))
    {
        AngleOfImpact = 57.295780 * Acos(-Impact.HitNormal Dot Impact.RayDir);
        ImpactDecal = GetDecalData(HitInfo, AngleOfImpact);
        // End:0x3D7
        if(ImpactDecal != none)
        {
            RandScaling = 1.0 + (FRand() * 0.50);
            Stretching = 1.0;
            ImpactDecal.HitLocation = Impact.HitLocation;
            ImpactDecal.HitNormal = Impact.HitNormal;
            ImpactDecal.HitBinormal = Normal(Impact.RayDir Cross Impact.HitNormal);
            ImpactDecal.HitTangent = ImpactDecal.HitNormal Cross ImpactDecal.HitBinormal;
            // End:0x19A
            if(ImpactDecal.DecalRotation == float(360))
            {
                UsedRotation = FRand() * float(360);
            }
            // End:0x2EB
            else
            {
                // End:0x2D6
                if(ImpactDecal.DecalRotation == float(-360))
                {
                    Upward = vect(0.0, 0.0, 1.0);
                    // End:0x213
                    if(Abs(ImpactDecal.HitNormal Dot Upward) < 0.99990)
                    {
                        Upward = Normal(Upward - ProjectOnTo(Upward, ImpactDecal.HitNormal));
                    }
                    // End:0x260
                    else
                    {
                        // End:0x24D
                        if(ImpactDecal.HitNormal.Z > 0.0)
                        {
                            Upward = vect(-1.0, 0.0, 0.0);
                        }
                        // End:0x260
                        else
                        {
                            Upward = vect(1.0, 0.0, 0.0);
                        }
                    }
                    Stretching += ((AngleOfImpact / 90.0) * DecalStretchingMultiplier);
                    UsedRotation = 57.295780 * Acos(Upward Dot ImpactDecal.HitTangent);
                    // End:0x2D3
                    if((ImpactDecal.HitBinormal Dot Upward) > float(0))
                    {
                        UsedRotation = 360.0 - UsedRotation;
                    }
                }
                // End:0x2EB
                else
                {
                    UsedRotation = ImpactDecal.DecalRotation;
                }
            }
            WorldInfo.MyDecalManager.SpawnDecal(ImpactDecal.DecalMaterial, Impact.HitLocation, rotator(-Impact.HitNormal), ImpactDecal.Width * RandScaling, (ImpactDecal.Height * RandScaling) * Stretching, 10.0, ImpactDecal.bNoClip, UsedRotation, Impact.HitInfo.HitComponent, false, false, HitInfo.BoneName, HitInfo.Item, HitInfo.LevelIndex);
        }
    }
    //return;    
}

simulated function bool IsDecalRelevant(Vector SpawnLocation, optional float CullDistance)
{
    local PlayerController P;
    local float distanceSq, SightDotLook;

    // End:0x151
    if(Instigator != none)
    {
        // End:0x24
        if(Instigator.IsHumanControlled())
        {
            return true;
        }
        // End:0x50
        else
        {
            // End:0x50
            if((WorldInfo.TimeSeconds - Instigator.LastRenderTime) < 1.0)
            {
                return true;
            }
        }
        // End:0x150
        foreach LocalPlayerControllers(class'PlayerController', P)
        {
            // End:0x14F
            if(P.Pawn != none)
            {
                distanceSq = VSizeSq(P.Pawn.Location - SpawnLocation);
                // End:0xBF
                if(distanceSq < float(300 * 300))
                {                    
                    return true;
                }
                // End:0x14F
                if((CullDistance == float(0)) || distanceSq < (CullDistance * CullDistance))
                {
                    SightDotLook = Normal(SpawnLocation - P.Pawn.Location) Dot vector(P.Pawn.Rotation);
                    // End:0x14F
                    if(SightDotLook >= P.Pawn.PeripheralVision)
                    {                        
                        return true;
                    }
                }
            }            
        }        
    }
    return false;
    //return ReturnValue;    
}

simulated function DecalComponent GetDecalData(TraceHitInfo HitInfo, optional float ImpactAngle)
{
    local PhysicalMaterial ParentPhysMaterial;
    local editinline DecalComponent dc;

    ImpactAngle = 0.0;
    // End:0x67
    if(HitInfo.PhysMaterial != none)
    {
        dc = ActuallyGetDecal(HitInfo.PhysMaterial, ImpactAngle);
        ParentPhysMaterial = HitInfo.PhysMaterial.Parent;
    }
    // End:0x103
    else
    {
        // End:0x103
        if(HitInfo.Material != none)
        {
            // End:0xF9
            if(HitInfo.Material.PhysMaterial != none)
            {
                dc = ActuallyGetDecal(HitInfo.Material.PhysMaterial, ImpactAngle);
                ParentPhysMaterial = HitInfo.Material.PhysMaterial.Parent;
            }
            // End:0x100
            else
            {
                ParentPhysMaterial = none;
            }
        }
        // End:0x103
        else
        {
        }
    }
    // End:0x14D [Loop If]
    if((dc == none) && ParentPhysMaterial != none)
    {
        dc = ActuallyGetDecal(ParentPhysMaterial, ImpactAngle);
        ParentPhysMaterial = ParentPhysMaterial.Parent;
        // [Loop Continue]
        goto J0x103;
    }
    // End:0x178
    if(dc == none)
    {
        // End:0x16D
        if(DefaultDecalComponent == none)
        {
            InitDefaultDecalProperties();
        }
        dc = DefaultDecalComponent;
    }
    return dc;
    //return ReturnValue;    
}

simulated function DecalComponent ActuallyGetDecal(PhysicalMaterial mtrl, float Angle)
{
    local TdPhysicalMaterialDecals Decals;
    local editinline DecalComponent retval;
    local int NumberOfDecals;

    // End:0x27D
    if((((none != mtrl) && none != mtrl.PhysicalMaterialProperty) && none != TdPhysicalMaterialProperty(mtrl.PhysicalMaterialProperty)) && none != TdPhysicalMaterialProperty(mtrl.PhysicalMaterialProperty).TdPhysicalMaterialDecals)
    {
        Decals = TdPhysicalMaterialProperty(mtrl.PhysicalMaterialProperty).TdPhysicalMaterialDecals;
        switch(DecalTypeToUse)
        {
            // End:0x130
            case 0:
                // End:0xEF
                if(Angle < Decals.CriticalAngle)
                {
                    NumberOfDecals = Decals.Light_Weapon_Impact.Length;
                    // End:0xEC
                    if(NumberOfDecals > 0)
                    {
                        retval = Decals.Light_Weapon_Impact[Rand(NumberOfDecals)];
                    }
                }
                // End:0x12D
                else
                {
                    NumberOfDecals = Decals.Light_Weapon_Ricochet.Length;
                    // End:0x12D
                    if(NumberOfDecals > 0)
                    {
                        retval = Decals.Light_Weapon_Ricochet[Rand(NumberOfDecals)];
                    }
                }
                // End:0x27A
                break;
            // End:0x1D0
            case 1:
                // End:0x18F
                if(Angle < Decals.CriticalAngle)
                {
                    NumberOfDecals = Decals.Heavy_Weapon_Impact.Length;
                    // End:0x18C
                    if(NumberOfDecals > 0)
                    {
                        retval = Decals.Heavy_Weapon_Impact[Rand(NumberOfDecals)];
                    }
                }
                // End:0x1CD
                else
                {
                    NumberOfDecals = Decals.Heavy_Weapon_Ricochet.Length;
                    // End:0x1CD
                    if(NumberOfDecals > 0)
                    {
                        retval = Decals.Heavy_Weapon_Ricochet[Rand(NumberOfDecals)];
                    }
                }
                // End:0x27A
                break;
            // End:0x270
            case 2:
                // End:0x22F
                if(Angle < Decals.CriticalAngle)
                {
                    NumberOfDecals = Decals.ShotGun_Impact.Length;
                    // End:0x22C
                    if(NumberOfDecals > 0)
                    {
                        retval = Decals.ShotGun_Impact[Rand(NumberOfDecals)];
                    }
                }
                // End:0x26D
                else
                {
                    NumberOfDecals = Decals.ShotGun_Ricochet.Length;
                    // End:0x26D
                    if(NumberOfDecals > 0)
                    {
                        retval = Decals.ShotGun_Ricochet[Rand(NumberOfDecals)];
                    }
                }
                // End:0x27A
                break;
            // End:0xFFFF
            default:
                retval = none;
                // End:0x284
                break;
            }
    }
    retval = none;
    return retval;
    //return ReturnValue;    
}

