    }
    // End:0xD0
    if((((CurrentFireMode < bAutomaticReFire.Length) && !bAutomaticReFire[CurrentFireMode]) && CurrentFireMode < WeaponReverbSnd1p.Length) && WeaponReverbSnd1p[CurrentFireMode] != none)
    {
        Instigator.PlaySound(WeaponReverbSnd1p[CurrentFireMode], true, true, true, GetPhysicalFireStartLoc());
    }
    //return;    
}

simulated function WeaponPlaySlapBackSound(SoundCue SC)
{
    local Vector EndTrace, AimDir, RealStartLoc, HitNormal, HitLocation;

    local int I, Counter;
    local float Angle, AngleLimit, usedangle;
    local Actor HitObject;

    AngleLimit = 3.1415930 * 1.50;
    RealStartLoc = GetPhysicalFireStartLoc();
    AimDir = vector(Instigator.GetBaseAimRotation());
    AimDir.Z = 0.0;
    Angle = (float(rotator(AimDir).Yaw) * (3.1415930 / float(32768))) - (AngleLimit * 0.50);
    Counter = 0;
    I = 0;
    J0x9B:
    // End:0x1BE [Loop If]
    if((I < MaxNumberOfSlapBackRays) && Counter < NumberOfSlapBacks)
    {
        usedangle = Angle + RandRange(0.0, AngleLimit);
        AimDir.X = Cos(usedangle);
        AimDir.Y = Sin(usedangle);
        EndTrace = RealStartLoc + (AimDir * float(RangeOfSlapBackRays));
        HitObject = Trace(HitLocation, HitNormal, EndTrace, RealStartLoc, false);
        // End:0x1B4
        if(HitObject != none)
        {
            ++ Counter;
            // End:0x192
            if(WorldInfo.NetMode == NM_DedicatedServer)
            {
                Owner.PlaySound(SC, false, true, false, HitLocation);
            }
            // End:0x1B1
            else
            {
                Owner.PlaySound(SC, false, false, false, HitLocation);
            }
            J0x1B4:
            // [Explicit Continue]
            goto J0x1B4;
        }
        ++ I;
        // [Loop Continue]
        goto J0x9B;
    }
    //return;    
}

simulated function PlayFiringSound()
{
    Instigator.MakeNoise(1.0, 'WeaponFireNoise');
    // End:0x38
    if(Instigator.IsHumanControlled())
    {
        WeaponPlaySounds1p();
    }
    WeaponPlaySounds3p();
    // End:0x5C
    if(WeaponSlapBackSnd != none)
    {
        WeaponPlaySlapBackSound(WeaponSlapBackSnd);
    }
    //return;    
}

