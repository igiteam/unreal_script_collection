simulated function bool IsValidStickyActor(Actor PotentialStickyActor, Pawn myPawn)
{
    local TdPawn PotentialStickyPawn;

    PotentialStickyPawn = TdPawn(PotentialStickyActor);
    // End:0x53
    if(PotentialStickyPawn != none)
    {
        return !PotentialStickyPawn.IsSameTeam(myPawn) && PotentialStickyPawn.AllowStickyAim();
    }
    // End:0x95
    else
    {
        // End:0x95
        if((Instigator.GetTeam() != none) && Instigator.GetTeam().TeamIndex == 1)
        {
            return false;
        }
    }
    return true;
    //return ReturnValue;    
}

