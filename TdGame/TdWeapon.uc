    // End:0xAA
    if(((SKMesh != none) && MuzzleFlashPSCTemplate != none) && MuzzleFlashSocket != 'None')
    {
        // End:0x90
        if(MuzzleFlashPSC == none)
        {
            MuzzleFlashPSC = new (Outer) class'TdParticleSystemComponent';
            MuzzleFlashPSC.SetDepthPriorityGroup(SKMesh.DepthPriorityGroup);
            MuzzleFlashPSC.SetTemplate(MuzzleFlashPSCTemplate);
            MuzzleFlashPSC.DeactivateSystem();
        }
        SKMesh.AttachComponentToSocket(MuzzleFlashPSC, MuzzleFlashSocket);
    }
    //return;    
}

