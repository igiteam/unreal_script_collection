final simulated event AnimNodeSequence GetWeaponAnimation()
{
    local AnimNodeSlot CustomAnimationSlot;
    local AnimNodeSequence AnimationNodeSequence;

    // End:0x0D
    if(Mesh3p == none)
    {
        return none;
    }
    CustomAnimationSlot = AnimNodeSlot(Mesh3p.FindAnimNode('Custom_Weapon'));
    // End:0x3E
    if(CustomAnimationSlot == none)
    {
        return none;
    }
    AnimationNodeSequence = CustomAnimationSlot.GetCustomAnimNodeSeq();
    return AnimationNodeSequence;
    //return ReturnValue;    
}

simulated function UpdateAnimSets(bool bIsFemale, bool bIsFirstPerson)
{
    // End:0x6C
    if(bIsFirstPerson)
    {
        Mesh1p.AnimSets[0] = ((WeaponType == 2) ? TdPawn(Instigator).CommonArmedLight1p : TdPawn(Instigator).CommonArmedHeavy1p);
        Mesh1p.AnimSets[1] = AnimationSetCharacter1p;
    }
    Mesh3p.AnimSets[0] = ((WeaponType == 2) ? TdPawn(Instigator).CommonArmedLight3p : TdPawn(Instigator).CommonArmedHeavy3p);
    Mesh3p.AnimSets[1] = AnimationSetFemale3p;
    //return;    
}

simulated function UpdateAnimations()
{
    Mesh1p.super(TdWeapon).UpdateAnimations();
    Mesh3p.super(TdWeapon).UpdateAnimations();
    //return;    
}

simulated function SetFirstPerson(bool bActive)
{
    // End:0x39
    if(bActive)
    {
        Mesh = Mesh1p;
        Mesh1p.SetOwnerNoSee(false);
        Mesh3p.SetOwnerNoSeeWithShadow(true);
    }
    // End:0x77
    else
    {
        Mesh = Mesh3p;
        Mesh1p.SetOwnerNoSee(true);
        Mesh3p.SetOwnerNoSee(false);
        Mesh3p.SetOwnerNoSeeWithShadow(false);
    }
    //return;    
}

simulated function ImpactInfo CalcWeaponFire(Vector StartTrace, Vector EndTrace, optional out array<ImpactInfo> ImpactList)
{
    local ImpactInfo Info;

    Info = super.CalcWeaponFire(StartTrace, EndTrace, ImpactList);
    // End:0x5A
    if(TdPawn(Owner) != none)
    {
        TdPawn(Owner).CheckForProximityShots(StartTrace, Info.HitLocation);
    }
    PassThroughLimit = default.PassThroughLimit;
    return Info;
    //return ReturnValue;    
}

simulated function bool PassThroughDamage(Actor HitActor, optional TraceHitInfo HitInfo)
{
    // End:0x62
    if((PassThroughLimit > 0) && HitActor.bIgnoreForAITraces || (HitInfo.HitComponent != none) && HitInfo.HitComponent.bIsTransparentToPlayerAndAI)
    {
        -- PassThroughLimit;
        return true;
    }
    return super.PassThroughDamage(HitActor, HitInfo);
    //return ReturnValue;    
}

simulated function bool GetReloadAnimName(TdWeapon.EWeaponReloadAnimationType ReloadType, out name ReloadAnimName)
{
    local TdBotPawn AiPawn;

    AiPawn = TdBotPawn(Owner);
    // End:0x7C
    if(AiPawn == none)
    {
        switch(ReloadType)
        {
            // End:0x3A
            case 0:
                ReloadAnimName = 'reloadstart';
                // End:0x6B
                break;
            // End:0x51
            case 1:
                ReloadAnimName = 'Reload';
                // End:0x6B
                break;
            // End:0x68
            case 2:
                ReloadAnimName = 'reloadend';
                // End:0x6B
                break;
            // End:0xFFFF
            default:
                return ReloadType != 1;
        }
    }
    // End:0xCE
    else
    {
        switch(ReloadType)
        {
            // End:0x9B
            case 0:
                ReloadAnimName = 'reloadstart';
                // End:0xCC
                break;
            // End:0xB2
            case 1:
                ReloadAnimName = 'Reload';
                // End:0xCC
                break;
            // End:0xC9
            case 2:
                ReloadAnimName = 'reloadend';
                // End:0xCC
                break;
            // End:0xFFFF
            default:
                return true;
            }
    }
    return true;
    //return ReturnValue;    
}

simulated function WeaponPlaySounds3p()
{
    // End:0x54
    if((CurrentFireMode < WeaponFireSnd3p.Length) && WeaponFireSnd3p[CurrentFireMode] != none)
    {
        Instigator.PlaySound(WeaponFireSnd3p[CurrentFireMode], false, true, false, GetPhysicalFireStartLoc(),, false);
    }
    // End:0xD0
    if((((CurrentFireMode < bAutomaticReFire.Length) && !bAutomaticReFire[CurrentFireMode]) && CurrentFireMode < WeaponReverbSnd3p.Length) && WeaponReverbSnd3p[CurrentFireMode] != none)
    {
        Instigator.PlaySound(WeaponReverbSnd3p[CurrentFireMode], false, true, false, GetPhysicalFireStartLoc(),, false);
    }
    //return;    
}

