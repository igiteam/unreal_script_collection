simulated function PreBeginPlay()
{
    local int Idx;

    super(Actor).PreBeginPlay();
    // End:0xB8
    if(BulletTraceTemplate != none)
    {
        Idx = 0;
        J0x18:
        // End:0xB8 [Loop If]
        if(Idx < 3)
        {
            TracerEmitters[Idx] = Spawn(class'TdEmitter');
            TracerEmitters[Idx].SetTemplate(BulletTraceTemplate, false);
            TracerEmitters[Idx].bDestroyOnSystemFinish = false;
            TracerEmitters[Idx].LifeSpan = 0.0;
            TracerEmitters[Idx].KillProjectile();
            ++ Idx;
            // [Loop Continue]
            goto J0x18;
        }
    }
    //return;    
}

simulated function PostBeginPlay()
{
    local int I;
    local float Rand;

    super(Actor).PostBeginPlay();
    WeaponAnimationNode1p = GetWeaponAnimationNode1p();
    WeaponAnimationNode3p = GetWeaponAnimationNode3p();
    // End:0x3E
    if((WeaponAnimationNode1p == none) && WeaponAnimationNode3p == none)
    {
    }
    // End:0x149
    if((WorldInfo.NetMode == NM_Standalone) && Instigator != none)
    {
        // End:0xE7
        if(Instigator.IsHumanControlled())
        {
            ShellEjectEmitter = Spawn(class'TdEmitter', self);
            ShellEjectEmitter.bDestroyOnSystemFinish = false;
            ShellEjectEmitter.SetTemplate(ShellEjectPS);
            ShellEjectEmitter.LifeSpan = 0.0;
            ShellEjectEmitter.KillProjectile();
        }
        // End:0x149
        else
        {
            Rand = (2.0 * FRand()) - 1.0;
            I = 0;
            J0x104:
            // End:0x149 [Loop If]
            if(I < FireInterval.Length)
            {
                ActualFireIntervalNoise[I] = (Rand * FireIntervalNoise[I]) * FireInterval[I];
                ++ I;
                // [Loop Continue]
                goto J0x104;
            }
        }
    }
    // End:0x17E
    if(OverrideWeaponFireTypeForAI && TdBotPawn(Instigator) != none)
    {
        FiringStatesArray[0] = 'WeaponFiring';
        bAutomaticReFire[0] = true;
    }
    //return;    
}

simulated event Destroyed()
{
    local int Idx;

    // End:0x48
    if(BulletTraceTemplate != none)
    {
        Idx = 0;
        J0x12:
        // End:0x48 [Loop If]
        if(Idx < 3)
        {
            TracerEmitters[Idx].Destroy();
            TracerEmitters[Idx] = none;
            ++ Idx;
            // [Loop Continue]
            goto J0x12;
        }
    }
    super.Destroyed();
    //return;    
}

