function SetDifficultyLevel(int Difficulty)
{
    switch(Difficulty)
    {
        // End:0xCF
        case 0:
            // End:0x3F
            if(FallOffDistances.Easy > 0.0)
            {
                FallOffDistance = FallOffDistances.Easy;
            }
            // End:0x4A
            else
            {
                FallOffDistance = default.FallOffDistance;
            }
            // End:0x7F
            if(Damages.Easy > 0.0)
            {
                InstantHitDamage[0] = Damages.Easy;
            }
            // End:0x8E
            else
            {
                InstantHitDamage[0] = default.InstantHitDamage[0];
            }
            // End:0xC1
            if(Ranges.Easy > 0.0)
            {
                WeaponRange = Ranges.Easy;
            }
            // End:0xCC
            else
            {
                WeaponRange = default.WeaponRange;
            }
            // End:0x25E
            break;
        // End:0x196
        case 1:
            // End:0x106
            if(FallOffDistances.Medium > 0.0)
            {
                FallOffDistance = FallOffDistances.Medium;
            }
            // End:0x111
            else
            {
                FallOffDistance = default.FallOffDistance;
            }
            // End:0x146
            if(Damages.Medium > 0.0)
            {
                InstantHitDamage[0] = Damages.Medium;
            }
            // End:0x155
            else
            {
                InstantHitDamage[0] = default.InstantHitDamage[0];
            }
            // End:0x188
            if(Ranges.Medium > 0.0)
            {
                WeaponRange = Ranges.Medium;
            }
            // End:0x193
            else
            {
                WeaponRange = default.WeaponRange;
            }
            // End:0x25E
            break;
        // End:0x25B
        case 2:
            // End:0x1CE
            if(FallOffDistances.Hard > 0.0)
            {
                FallOffDistance = FallOffDistances.Hard;
            }
            // End:0x1D9
            else
            {
                FallOffDistance = default.FallOffDistance;
            }
            // End:0x20E
            if(Damages.Hard > 0.0)
            {
                InstantHitDamage[0] = Damages.Hard;
            }
            // End:0x21D
            else
            {
                InstantHitDamage[0] = default.InstantHitDamage[0];
            }
            // End:0x250
            if(Ranges.Hard > 0.0)
            {
                WeaponRange = Ranges.Hard;
            }
            // End:0x25B
            else
            {
                WeaponRange = default.WeaponRange;
        }
        // End:0xFFFF
        default:
            //return;
    }    
}

simulated function TdAnimNodeSlot GetWeaponAnimationNode1p()
{
    // End:0x2A
    if(Mesh1p != none)
    {
        return TdAnimNodeSlot(Mesh1p.FindAnimNode('Custom_Weapon'));
    }
    return none;
    //return ReturnValue;    
}

