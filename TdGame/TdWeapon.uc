        Instigator.PlaySound(WeaponReverbSnd3p[CurrentFireMode], false, true, false, GetPhysicalFireStartLoc(),, false);
    }
    //return;    
}

simulated function AttachWeaponComponentsToPlayer(optional bool bIsFirstPerson)
{
    local int I;

    // End:0x54
    if(bIsFirstPerson)
    {
        TdPawn(Instigator).Mesh1p.AttachComponentToSocket(Mesh1p, 'WeaponSocket');
        AttachWeaponEffects(Mesh1p);
        SetFirstPerson(true);
    }
    // End:0x6E
    else
    {
        AttachWeaponEffects(Mesh3p);
        SetFirstPerson(false);
    }
    TdPawn(Instigator).Mesh3p.AttachComponentToSocket(Mesh3p, 'WeaponSocket');
    // End:0x171
    if((Mesh1p != none) && Mesh3p != none)
    {
        // End:0x11F
        if(TdPawn(Instigator).Mesh1p != none)
        {
            Mesh1p.SetShadowParent(TdPawn(Instigator).Mesh1p);
            Mesh1p.SetLightEnvironment(TdPawn(Instigator).Mesh1p.LightEnvironment);
        }
        Mesh3p.SetShadowParent(TdPawn(Instigator).Mesh3p);
        Mesh3p.SetLightEnvironment(TdPawn(Instigator).Mesh3p.LightEnvironment);
    }
    SetHidden(false);
    // End:0x1C7
    if(((Role == ROLE_Authority) && TdPawn(Instigator) != none) && !bRemoteWeapon)
    {
        TdPawn(Instigator).ReplicatedWeaponClass = self.Class;
    }
    I = 0;
    J0x1CE:
    // End:0x20C [Loop If]
    if(I < AimOffsetProfileNames.Length)
    {
        TdPawn(Instigator).SetAimOffsetNodesProfile(AimOffsetProfileNames[I]);
        ++ I;
        // [Loop Continue]
        goto J0x1CE;
    }
    //return;    
}

simulated function DetachWeapon()
{
    local TdPawn P;

    P = TdPawn(Instigator);
    // End:0x140
    if((P != none) && P.Mesh3p.IsComponentAttached(Mesh3p))
    {
        // End:0x6E
        if((Role == ROLE_Authority) && !bRemoteWeapon)
        {
            P.ReplicatedWeaponClass = none;
        }
        // End:0xCF
        if(Mesh1p != none)
        {
            // End:0xAD
            if(P.Mesh1p != none)
            {
                P.Mesh1p.DetachComponent(Mesh1p);
            }
            Mesh1p.SetShadowParent(none);
            Mesh1p.SetLightEnvironment(none);
        }
        // End:0x11B
        if(Mesh3p != none)
        {
            P.Mesh3p.DetachComponent(Mesh3p);
            Mesh3p.SetShadowParent(none);
            Mesh3p.SetLightEnvironment(none);
        }
        SetHidden(true);
        DetachWeaponEffects(Mesh1p);
        DetachWeaponEffects(Mesh3p);
    }
    //return;    
}

simulated function AttachWeaponEffects(TdSkeletalMeshComponent SKMesh)
