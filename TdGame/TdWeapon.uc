    PawnOwner = TdPawn(Owner);
    // End:0x4E
    if((WeaponAnimationNode1p != none) && PawnOwner != none)
    {
        WeaponAnimationNode1p.PlayCustomAnim(AnimationName, 1.0, 0.0, 0.0, false, true);
    }
    // End:0x8C
    if((WeaponAnimationNode3p != none) && PawnOwner != none)
    {
        WeaponAnimationNode3p.PlayCustomAnim(AnimationName, 1.0, 0.0, 0.0, false, true);
    }
    //return;    
}

