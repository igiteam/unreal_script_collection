simulated function StartFire(byte FireModeNum)
{
    local TdPlayerPawn PlayerInstigator;

    PlayerInstigator = TdPlayerPawn(Instigator);
    // End:0x65
    if(PlayerInstigator != none)
    {
        // End:0x65
        if((PlayerInstigator.AgainstWallState == 1) || (PlayerInstigator.AgainstWallState == 2) && WeaponType == 2)
        {
            return;
        }
    }
    // End:0x102
    if((Instigator == none) || !Instigator.bNoWeaponFiring)
    {
        // End:0xF3
        if(Role < ROLE_Authority)
        {
            // End:0xE4
            if((StickyActor != none) && bStickyAim)
            {
                ServerStartStickyFire(FireModeNum, StickyRotation.Yaw, StickyRotation.Pitch, StickyActor);
            }
            // End:0xF3
            else
            {
                ServerStartFire(FireModeNum);
            }
        }
        BeginFire(FireModeNum);
    }
    //return;    
}

