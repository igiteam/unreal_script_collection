    StickyActor = NewStickyActor;
    UpdateStickyActor(HUD, Controller, CurrentMove, DeltaTime);
    //return;    
}

simulated function UpdateStickyActor(TdHUD HUD, Controller Controller, TdMove CurrentMove, float DeltaTime)
{
    local Vector WeaponStartTraceLocation, AimLocation, AimDelta, ToEnemy, CameraLocation, CamRotX,
	    CamRotY, CamRotZ, TargetLocation, TargetLocTemp;

    local Rotator CameraOrientation;
    local float DeltaAimDistY, TargetWidth, TargetWidthOuter;

    // End:0x3E
    if((TdPawn(Instigator) != none) && TdPawn(Instigator).GetMobilityMultiplier() < 0.90)
    {
        StickyActor = none;
        return;
    }
    WeaponStartTraceLocation = Instigator.GetWeaponStartTraceLocation();
    // End:0x124
    if(((HUD != none) && HUD.TargetingActor != none) && HUD.TargetingActor != StickyActor)
    {
        // End:0x124
        if(IsValidStickyActor(HUD.TargetingActor, Controller.Pawn))
        {
            StickyActor = HUD.TargetingActor;
            StickyRotation = Instigator.GetAdjustedAimFor(self, WeaponStartTraceLocation);
            // End:0x124
            if((IsFiring()) && Role < ROLE_Authority)
            {
                ServerUpdateStickyActor(StickyActor);
            }
        }
    }
    // End:0x131
    if(StickyActor == none)
    {
        return;
    }
    TargetLocation = StickyActor.Location + vect(0.0, 0.0, 10.0);
    ToEnemy = WeaponStartTraceLocation - StickyActor.Location;
    Controller.GetPlayerViewPoint(CameraLocation, CameraOrientation);
    GetAxes(CameraOrientation, CamRotX, CamRotY, CamRotZ);
    AimLocation = CameraLocation + (CamRotX * VSize(ToEnemy));
    AimDelta = AimLocation - TargetLocation;
    TargetLocTemp = TargetLocation;
    TargetLocTemp.Z = AimLocation.Z;
    DeltaAimDistY = PointDistToLine(AimLocation, TargetLocTemp - CameraLocation, CameraLocation);
    TargetWidth = CylinderComponent(StickyActor.CollisionComponent).CollisionRadius * 0.80;
    TargetWidthOuter = Lerp(TargetWidth + 5.0, TargetWidth * 2.0, VSize(ToEnemy) / 1000.0);
    // End:0x2BF
    if((DeltaAimDistY > TargetWidth) && DeltaAimDistY < TargetWidthOuter)
    {
        AimLocation += (((DeltaAimDistY - TargetWidth) + 20.0) * Normal(-AimDelta));
    }
    StickyRotation = rotator(AimLocation - WeaponStartTraceLocation);
    // End:0x34D
    if(Instigator.IsLocallyControlled() && StickyActor != none)
    {
        // End:0x34D
        if((WorldInfo.TimeSeconds - StickyActor.LastRenderTime) > 1.0)
        {
            StickyActor = none;
            // End:0x34D
            if((IsFiring()) && Role < ROLE_Authority)
            {
                ServerResetStickyActor();
            }
        }
    }
    //return;    
}

reliable server function ServerResetStickyActor()
{
    StickyActor = none;
    //return;    
}

reliable server function ServerUpdateStickyActor(Actor inActor)
{
    StickyRotation.Yaw = Instigator.Controller.Rotation.Yaw;
    StickyRotation.Pitch = Instigator.Controller.Rotation.Pitch;
    StickyActor = inActor;
    //return;    
}

