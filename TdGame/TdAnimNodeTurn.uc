class TdAnimNodeTurn extends TdAnimNodeBlendList
    native
    hidecategories(Object,Object,Object);

var transient bool PlayingTurnAnimation;
var transient float LegTurnPerSecond;
var transient float TimeStandingStill;
var(TimerSettings) float IdleTimer;
var(AngularSettings) float SafeRegionLimit;
var(AngularSettings) float ExtendedRegionLimit;
var array<TdAnimNodeDirBone> AimNodes;

event OnBecomeRelevant()
{
    PlayingTurnAnimation = false;
    SetActiveChild(0, 0.0);
    TimeStandingStill = 0.0;
    //return;    
}

event OnCeaseRelevant()
{
    PlayingTurnAnimation = false;
    SetActiveMove(0);
    //return;    
}

defaultproperties
