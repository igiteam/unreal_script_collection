simulated event int SetupTemplate(AITemplate TheTemplate)
{
    local AITemplate_SniperCop sniperTemplate;

    // End:0x13A
    if(super.SetupTemplate(TheTemplate) > 0)
    {
        switch(SetupTemplateCount)
        {
            // End:0x137
            case 3:
                sniperTemplate = AITemplate_SniperCop(TheTemplate);
                // End:0x12D
                if(sniperTemplate != none)
                {
                    LoseTargetTime = sniperTemplate.LoseTargetTime;
                    AimOffset = sniperTemplate.AimOffset;
                    RandomWalkSpeed = sniperTemplate.RandomWalkSpeed;
                    switch(GetDifficultyLevel())
                    {
                        // End:0x9D
                        case 0:
                            TimeToCalibrate = sniperTemplate.TimeToCalibrateEasy;
                            // End:0xD9
                            break;
                        // End:0xB9
                        case 1:
                            TimeToCalibrate = sniperTemplate.TimeToCalibrateMedium;
                            // End:0xD9
                            break;
                        // End:0xD6
                        case 2:
                            TimeToCalibrate = sniperTemplate.TimeToCalibrateHard;
                            // End:0xD9
                            break;
                        // End:0xFFFF
                        default:
                            TimeToCalibrateOnObjectFactor = sniperTemplate.TimeToCalibrateOnObjectFactor;
                            TriggerBotAccuracy = sniperTemplate.TriggerBotAccuracy;
                            HomingInOnTargetSpeed = sniperTemplate.HomingInOnTargetSpeed;
                            BreakDistance = sniperTemplate.BreakDistance;
                        }
                        ++ SetupTemplateCount;
                        goto J0x13A;
                    J0x13A:
                // End:0xFFFF
                default:
                }
            return SetupTemplateCount - 3;
            //return ReturnValue;        
}

function TdAimBotBase CreateAimBot()
{
    NormalAimBot = new (self) class'TdAimBot';
    SniperAimBot = new (self) class'TdAimBotSniper';
    return NormalAimBot;
    //return ReturnValue;    
}

event Tick(float DeltaTime)
{
    UpdateFocalPoint();
    UpdateAlternativeTarget();
    super.Tick(DeltaTime);
    //return;    
}

function UpdateCombatState()
{
    SetTimer(0.10 + (0.10 * FRand()), true, 'TestCombatTransitions');
    SetTimer(0.20 + (0.20 * FRand()), true, 'TestLastKnownLocationVisible');
    //return;    
}

function OnTdAIPerfectAim(SeqAct_TdAIPerfectAim Action)
{
    // End:0x79
    if((Action.AccuracyImprovementRate != float(0)) && Action.ShouldEnable())
    {
        NormalAimBot.OverrideImprovementRate(Action.AccuracyImprovementRate);
        SniperAimBot.OverrideImprovementRate(Action.AccuracyImprovementRate);
    }
    // End:0xAB
    else
    {
        NormalAimBot.OverrideImprovementRate(0.0);
        SniperAimBot.OverrideImprovementRate(0.0);
    }
    //return;    
}

function UpdateAlternativeTarget()
{
    local GameBreakableActor BreakableActor;

    // End:0xAC
    if(AlternativeTargetArea != none)
    {
        BreakableActor = GameBreakableActor(AlternativeTarget);
        // End:0x71
        if((AlternativeTarget == none) || (BreakableActor != none) && BreakableActor.bDestroyed)
        {
            AlternativeTarget = none;
            AIManager.RemoveGrenadeArea(AlternativeTargetArea);
            AlternativeTargetArea = none;
            return;
        }
        // End:0xAC
        if((Enemy == none) || !AlternativeTargetArea.IsPawnInArea(Enemy))
        {
            AlternativeTarget = none;
            AlternativeTargetArea = none;
            return;
        }
    }
    //return;    
}

function TestCombatTransitions()
{
    // End:0x1C
    if(scriptingActivated || !IsCurrentStateInterruptable())
    {
        return;
    }
    // End:0x47
    if((TimeSince(EnemySeenLastTime) < float(20)) && EnemyClose())
    {
        super.TestCombatTransitions();
        return;
    }
    // End:0x6C
    if(!IsInState('HoldAndSnipe', true))
    {
        TdGotoState('HoldAndSnipe');
    }
    //return;    
}

// Export UTdAI_Sniper::execCheckFireCondition(FFrame&, void* const)
native function CheckFireCondition();

function bool EnemyClose()
{
    return (Enemy != none) && VSize(Enemy.Location - Pawn.Location) < BreakDistance;
    //return ReturnValue;    
}

function UpdateFocalPoint()
{
    //return;    
}

event bool AllowFire()
{
    // End:0x16
    if(!IsMoving())
    {
        return super.AllowFire();
    }
    return false;
    //return ReturnValue;    
}

function TdAI_Sniper.FindResult FindSniperSpot()
{
    local TdSniperSpot ss, bestSs;
    local TdAI_Sniper.FindResult Result;
    local float RangeVal, bestRange;

    bestRange = 10000000.0;
    // End:0x127
    foreach WorldInfo.AllNavigationPoints(class'TdSniperSpot', ss)
    {
        // End:0x61
        if((Enemy != none) && !ss.PointInside(Enemy.Location))
        {
            continue;            
        }
        // End:0x89
        if(ss.Occupied && ss != SniperSpot)
        {
            continue;            
        }
        // End:0xC8
        if((Pawn.Anchor.NetworkID & PathNetworkMask) != (ss.NetworkID & PathNetworkMask))
        {
            continue;            
        }
        RangeVal = VSizeSq(ss.Location - Pawn.Location);
        // End:0x126
        if((bestSs == none) || RangeVal < bestRange)
        {
            bestSs = ss;
            bestRange = RangeVal;
        }        
    }    
    // End:0x1E9
    if(bestSs == none)
    {
        bestRange = 10000000.0;
        // End:0x1E8
        foreach WorldInfo.AllNavigationPoints(class'TdSniperSpot', ss)
        {
            // End:0x1E7
            if((Pawn.Anchor.NetworkID & PathNetworkMask) == (ss.NetworkID & PathNetworkMask))
            {
                RangeVal = VSizeSq(ss.Location - Pawn.Location);
                // End:0x1E7
                if(RangeVal < bestRange)
                {
                    bestSs = ss;
                    bestRange = RangeVal;
                }
            }            
        }        
    }
    // End:0x253
    if(bestSs != none)
    {
        // End:0x20E
        if(SniperSpot == bestSs)
        {
            Result = 2;
        }
        // End:0x250
        else
        {
            // End:0x22B
            if(SniperSpot != none)
            {
                SniperSpot.Occupied = false;
            }
            SniperSpot = bestSs;
            SniperSpot.Occupied = true;
            Result = 1;
        }
    }
    // End:0x25B
    else
    {
        Result = 0;
    }
    return Result;
    //return ReturnValue;    
}

function bool LaserActive()
{
    return false;
    //return ReturnValue;    
}

event bool ForceShootAt(TdExplosiveTargetArea TargetArea)
{
    // End:0x51
    if(((TargetArea != none) && TargetArea.TargetActor != none) && Enemy != none)
    {
        AlternativeTargetArea = TargetArea;
        AlternativeTarget = TargetArea.TargetActor;
        return true;
    }
    return false;
    //return ReturnValue;    
}

state HoldAndSnipe extends TdState
{
    function BeginState(name PreviousStateName)
    {
        super.BeginState(PreviousStateName);
        AimBot = SniperAimBot;
        SetWantedFocus(1);
        Pawn.SetWalking(false);
        //return;        
    }

    function EndState(name NextStateName)
    {
        super.EndState(NextStateName);
        // End:0x28
        if(SniperSpot != none)
        {
            SniperSpot.Occupied = false;
        }
        AimBot = NormalAimBot;
        //return;        
    }

    function UpdateFocalPoint()
    {
        // End:0x50
        if((TdPlayerPawn(Enemy) != none) && EnemyVisible)
        {
            PawnFocus.SetFocalPoint(SniperAimBot.GetTargetPos(TdPlayerPawn(Enemy)));
        }
        // End:0x73
        else
        {
            PawnFocus.SetFocalPoint(SniperAimBot.BlindPos);
        }
        //return;        
    }

    event bool AllowFire()
    {
        local TdAimBotSniper myAimBot;

        myAimBot = TdAimBotSniper(AimBot);
        // End:0x61
        if((((myAimBot != none) && ReadyToFire) && super(TdAIController).AllowFire()) && !IsMoving())
        {
            return myAimBot.AllowFire(TdPlayerPawn(Enemy));
        }
        return false;
        //return ReturnValue;        
    }

    function bool LaserActive()
    {
        return UseLaser;
        //return ReturnValue;        
    }

    function CheckCrouching()
    {
        // End:0x52
        if(((SniperSpot != none) && SniperSpot.Crouch) || bForceSniperCrouched)
        {
            // End:0x4F
            if(!myPawn.IsCrouching())
            {
                Crouch(true);
            }
        }
        // End:0x74
        else
        {
            // End:0x74
            if(myPawn.IsCrouching())
            {
                Crouch(false);
            }
        }
        //return;        
    }

    function Rotator GetAdjustedAimFor(Weapon W, Vector StartFireLoc)
    {
        return SniperAimBot.GetRotation(TdPlayerPawn(Enemy));
        //return ReturnValue;        
    }

Begin:
    Sleep(1.0);
    switch(FindSniperSpot())
    {
        // End:0x27
        case 2:
            goto 'Stay';
            // End:0x4E
            break;
        // End:0x39
        case 1:
            goto 'MoveToSpot';
            // End:0x4E
            break;
        // End:0x4B
        case 0:
            goto 'Stay';
            // End:0x4E
            break;
        // End:0xFFFF
        default:
            CheckCrouching();
            // End:0x126
            if(SniperSpot != none)
            {
                // End:0xB3
                if(VSize(Pawn.Location - SniperSpot.Location) < 500.0)
                {
                    Pawn.SetWalking(true);
                    SetWantedFocus(2);
                }
                // End:0xD4
                else
                {
                    Pawn.SetWalking(false);
                    SetWantedFocus(3);
                }
                bReachedMoveGoal = false;
                J0xDC:
                // End:0x123 [Loop If]
                if(!bReachedMoveGoal)
                {
                    // End:0x10D
                    if(SetMoveGoal(SniperSpot))
                    {
                        UseLaser = false;
                        MoveToTarget();
                        J0x10D:
                    }
                    // End:0x10D
                    else
                    {
                    }
                    // End:0x120
                    if(!bReachedMoveGoal)
                    {
                        Sleep(0.10);
                    }
                    // [Loop Continue]
                    goto J0xDC;
                }
            }
            // End:0x14A
            else
            {
                TdGotoState('Error',, "No sniper sogpot",, true);
            }
            ReadyToFire = true;
            // End:0x1E1
            if((TimeSince(EnemySeenLastTime) > float(20)) || EnemySeenLastTime == float(0))
            {
                // End:0x1E1
                if(SniperSpot != none)
                {
                    LastActuallySeenLocation = SniperSpot.Location + (vector(SniperSpot.Rotation) * SniperSpot.AttackVolumeRadius);
                    LastActuallySeenLocation.Z -= (SniperSpot.AttackVolumeHeight / 2.0);
                }
            }
            SetWantedFocus(1);
            UseLaser = true;
            CheckCrouching();
            StartFiring();
            Sleep(0.50);
            J0x211:
            // End:0x26E [Loop If]
            if((Enemy != none) && SniperSpot.PointInside(Enemy.Location))
            {
                // End:0x263
                if(!myPawn.HasAmmo())
                {
                    goto 'Reload';
                }
                Sleep(0.20);
                // [Loop Continue]
                goto J0x211;
            }
            goto 'Begin';
Reload:

            ReadyToFire = false;
            UseLaser = false;
            J0x288:
            // End:0x2AA [Loop If]
            if(myPawn.IsInStateReloading())
            {
                Sleep(0.10);
                // [Loop Continue]
                goto J0x288;
            }
            SniperAimBot.ResetAiming();
            goto 'Stay';
            stop;                                                
}

