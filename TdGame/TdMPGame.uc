function bool CheckStartGame()
{
    // End:0x1E
    if((NumTravellingPlayers > 0) || MinWarmupPlayersNeeded > NumPlayers)
    {
        return false;
    }
    return true;
    //return ReturnValue;    
}

function SetGameTimer(bool bEnable, optional float RemainingTime, optional float RemainingMinute)
{
    RemainingTime = -1.0;
    RemainingMinute = -1.0;
    GameReplicationInfo.bStopCountDown = !bEnable;
    // End:0x4F
    if(RemainingTime >= float(0))
    {
        GameReplicationInfo.RemainingTime = int(RemainingTime);
    }
    // End:0x73
    if(RemainingMinute >= float(0))
    {
        GameReplicationInfo.RemainingMinute = int(RemainingMinute);
    }
    //return;    
}

auto state PendingMatch
{
    function EndState(name NextStateName)
    {
        super.EndState(NextStateName);
        //return;        
    }

    function BeginState(name PreviousStateName)
    {
        super(Object).BeginState(PreviousStateName);
        // End:0x3D
        if(!bUseWarmup || bUseWarmup && CheckStartGame())
        {
            StartMatch();
        }
        // End:0x47
        else
        {
            StartWarmup();
        }
        //return;        
    }

    event PostLogin(PlayerController NewPlayer)
    {
        super(GameInfo).PostLogin(NewPlayer);
        HandleLateWarmupJoin(NewPlayer);
        //return;        
    }

    function StartWarmup()
    {
        local TdPlayerController C;

        SetGameTimer(false);
        TdGameReplicationInfo(GameReplicationInfo).bMatchIsInWarmup = true;
        // End:0x70
        foreach WorldInfo.AllControllers(class'TdPlayerController', C)
        {
            // End:0x6F
            if(!C.PlayerReplicationInfo.bOnlySpectator)
            {
                RestartPlayer(C);
            }            
        }        
        //return;        
    }

    function HandleLateWarmupJoin(Controller NewPlayer)
    {
        // End:0x51
        if(bUseWarmup)
        {
            // End:0x23
            if(CheckStartGame())
            {
                EndWarmup();
            }
            // End:0x51
            else
            {
                // End:0x51
                if(!NewPlayer.PlayerReplicationInfo.bOnlySpectator)
                {
                    RestartPlayer(NewPlayer);
                }
            }
        }
        //return;        
    }

    function EndWarmup()
    {
        local TdPlayerController C;

        // End:0x2A
        if(GameReplicationInfo.bStopCountDown)
        {
            SetGameTimer(true, float(WarmupCountDownTime), 1.0);
        }
        // End:0x8F
        foreach WorldInfo.AllControllers(class'TdPlayerController', C)
        {
            // End:0x8E
            if(!C.PlayerReplicationInfo.bOnlySpectator)
            {
                C.ForcePreRoundSpectate();
                C.ClientForcePreRoundSpectate();
            }            
        }        
        //return;        
    }

    event Timer()
    {
        global.Timer();
        // End:0x29
        if(GameReplicationInfo.RemainingTime <= 0)
        {
            StartMatch();
        }
        //return;        
    }

    function float RatePlayerStart(PlayerStart P, byte Team, Controller Player)
    {
        local float Score;

        Score += float(Rand(100));
        return float(Max(0, int(Score)));
        //return ReturnValue;        
    }

    event HandleSeamlessTravelPlayer(out Controller C)
    {
        super(GameInfo).HandleSeamlessTravelPlayer(C);
        HandleLateWarmupJoin(C);
        //return;        
    }
    stop;    
}

state MatchInProgress
{
    function BeginState(name PreviousStateName)
    {
        DeadControllers.Remove(0, DeadControllers.Length);
        bInitialSpawn = true;
        InitialSpawn();
        bInitialSpawn = false;
        SetTimer(GlobalPlayerRespawnTime, true, 'RespawnTimer');
        //return;        
    }

    simulated function EndState(name NextStateName)
    {
        DeadControllers.Remove(0, DeadControllers.Length);
        ClearTimer('RespawnTimer');
        //return;        
    }

    event PostLogin(PlayerController NewPlayer)
    {
        super(GameInfo).PostLogin(NewPlayer);
        AddToRespawnList(NewPlayer);
        //return;        
    }

    function Logout(Controller Exiting)
    {
        RemoveFromRespawnList(Exiting);
        super(GameInfo).Logout(Exiting);
        //return;        
    }

    function InitialSpawn()
    {
        local TdPlayerController C;
        local int SpawnAttempts;

        // End:0x94
        foreach WorldInfo.AllControllers(class'TdPlayerController', C)
        {
            SpawnAttempts = 0;
            J0x24:
            // End:0x93 [Loop If]
            if(C.IsDead() && !C.PlayerReplicationInfo.bOnlySpectator)
            {
                RestartPlayer(C);
                // End:0x89
                if(SpawnAttempts >= 3)
                {
                    AddToRespawnList(C);
                    // End:0x93
                    continue;
                }
                ++ SpawnAttempts;
                // [Loop Continue]
                goto J0x24;
            }            
        }        
        //return;        
    }

    function NotifyKilled(Controller Killer, Controller Killed, Pawn KilledPawn)
    {
        global.NotifyKilled(Killer, Killed, KilledPawn);
        AddToRespawnList(Killed);
        //return;        
    }

    event Timer()
    {
        global.Timer();
        // End:0x52
        if(TimeLimit > 0)
        {
            GameReplicationInfo.bStopCountDown = false;
            // End:0x52
            if(GameReplicationInfo.RemainingTime <= 0)
            {
                EndGame(none, "TimeLimit");
            }
        }
        //return;        
    }

    function RespawnTimer()
    {
        local int SpawnAttempts, Idx;
        local TdPlayerController C;

        // DebugMode:False
        assert(DeadControllers.Length > MaxPlayers);
        Idx = 0;
        J0x18:
        // End:0xD4 [Loop If]
        if(Idx < DeadControllers.Length)
        {
            // End:0xC7
            if(DeadControllers[Idx].TimeToRespawn <= WorldInfo.TimeSeconds)
            {
                SpawnAttempts = 0;
                C = DeadControllers[Idx].C;
                J0x75:
                // End:0xC4 [Loop If]
                if(SpawnAttempts <= 3)
                {
                    RestartPlayer(C);
                    ++ SpawnAttempts;
                    // End:0xC1
                    if(!C.IsDead())
                    {
                        DeadControllers.Remove(-- Idx, 1);
                        // [Explicit Break]
                        goto J0xC4;
                    }
                    J0xC4:
                    // [Loop Continue]
                    goto J0x75;
                }
                // [Explicit Continue]
                goto J0xCA;
            }
            J0xCA:
            // [Explicit Break]
            goto J0xD4;
            ++ Idx;
            J0xD4:
            // [Loop Continue]
            goto J0x18;
        }
        //return;        
    }
    stop;    
}

state MatchOver
{
    ignores RespawnTimer;

    function BeginState(name PreviousStateName)
    {
        SetGameTimer(true, TimeBetweenMatches, 1.0);
        KillRemainingPlayers();
        ClearRespawnList();
        OpenPostGameScene();
        //return;        
    }

    event Timer()
    {
        global.Timer();
        // End:0x29
        if(GameReplicationInfo.RemainingTime <= 0)
        {
            RestartGame();
        }
        //return;        
    }
    stop;    
}

defaultproperties
{
    CriminalClasses(0)="TdMpContent.Pawn_CriminalHeavy"
    CriminalClasses(1)="TdMpContent.Pawn_CriminalProwler"
    CriminalClasses(2)="TdMpContent.Pawn_CriminalFixer"
    PoliceClasses(0)="TdMpContent.Pawn_PoliceSWAT"
    PoliceClasses(1)="TdMpContent.Pawn_PoliceUndercover"
    PoliceClasses(2)="TdMpContent.Pawn_PoliceRiotUnit"
    VictoryMessageClass=class'TdVictoryMessage'
    bAllowViewTargetSwitching=true
    HUDType=class'TdMPHUD'
    GameMessageClass=class'TdGameMessage'
}