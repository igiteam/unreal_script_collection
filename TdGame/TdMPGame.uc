class TdMPGame extends TdGameInfo
    abstract
    config(Game)
    hidecategories(Navigation,Movement,Collision);

struct DeadPlayerController
{
    var TdPlayerController C;
    var float TimeToRespawn;

    structdefaultproperties
    {
        C=none
        TimeToRespawn=0.0
    }
};

var config string IpServerNumber;
var const config float GlobalPlayerRespawnTime;
var const config float IndividualPlayerMinRespawnTime;
var const config float TimeBetweenRounds;
var const config float TimeBetweenMatches;
var const config int MaxRounds;
var int RoundCount;
var protected array<string> CriminalClasses;
var protected array<string> PoliceClasses;
var array<DeadPlayerController> DeadControllers;
var bool bInitialSpawn;
var config bool bUseWarmup;
var class<TdVictoryMessage> VictoryMessageClass;
var config int MinWarmupPlayersNeeded;
var config int WarmupCountDownTime;

event InitGame(string Options, out string ErrorMessage)
{
    super.InitGame(Options, ErrorMessage);
    TimeLimit = Max(0, GetIntOption(Options, "TimeLimit", TimeLimit));
    MaxPlayers = Max(0, GetIntOption(Options, "MaxPlayers", MaxPlayers));
    MinWarmupPlayersNeeded = Max(0, GetIntOption(Options, "MinWarmupPlayersNeeded", MinWarmupPlayersNeeded));
    MinWarmupPlayersNeeded = Min(MinWarmupPlayersNeeded, MaxPlayers);
    bUseWarmup = (ParseOption(Options, "bUseWarmup")) ~= "1";
    DeathMessageClass = class<TdLocalMessage>(DynamicLoadObject("TdMpContent.TdDeathMessage", class'Class'));
    //return;    
}

function PreBeginPlay()
{
    super.PreBeginPlay();
    AccuireSpectatorPoints();
    //return;    
}

function Reset()
{
    super.Reset();
    SetGameTimer(false, float(TimeLimit * 60), float(TimeLimit));
    //return;    
}

function InitGameReplicationInfo()
{
    SetGameTimer(false, float(TimeLimit * 60), float(TimeLimit));
    super(GameInfo).InitGameReplicationInfo();
    //return;    
}

function StartMatch()
{
    local Actor A;

    SetGameTimer(true, float(TimeLimit * 60), float(TimeLimit));
    TdGameReplicationInfo(GameReplicationInfo).bMatchIsInWarmup = false;
    // End:0x59
    foreach AllActors(class'Actor', A)
    {
        A.MatchStarting();        
    }    
    bWaitingToStartMatch = false;
    RoundCount = 0;
    GotoState('MatchInProgress');
    StartOnlineGame();
    WorldInfo.NotifyMatchStarted();
    //return;    
}

function bool CheckEndGame(PlayerReplicationInfo Winner, string Reason)
{
    GameReplicationInfo.Winner = Winner;
    return super(GameInfo).CheckEndGame(Winner, Reason);
    //return ReturnValue;    
}

function EndGame(PlayerReplicationInfo Winner, string Reason)
{
    super(GameInfo).EndGame(Winner, Reason);
    // End:0x27
    if(bGameEnded)
    {
        GotoState('MatchOver');
    }
    //return;    
}

function KillRemainingPlayers()
{
    local Controller Player;
    local PlayerController PC;
    local Pawn OldPawn;

    // End:0xDA
    foreach WorldInfo.AllControllers(class'Controller', Player)
    {
        // End:0x96
        if(Player.Pawn != none)
        {
            OldPawn = Player.Pawn;
            Player.Pawn.StopFiring();
            Player.UnPossess();
            // End:0x96
            if(TdPawn(OldPawn) != none)
            {
                OldPawn.Destroy();
            }
        }
        PC = PlayerController(Player);
        // End:0xD9
        if(PC != none)
        {
            PC.ClientReset();
            PC.Reset();
        }        
    }    
    //return;    
}

function RespawnBag()
{
    //return;    
}

function class<Pawn> GetDefaultPlayerClass(Controller C)
{
    local class<Pawn> ResultClass;
    local int RandIndex;
    local string ClassName;

    // End:0x20
    if((CriminalClasses.Length == 0) || PoliceClasses.Length == 0)
    {
        return DefaultPawnClass;
    }
    // End:0x9B
    if(C.PlayerReplicationInfo != none)
    {
        // End:0x60
        if(Rand(1) == 0)
        {
            RandIndex = Rand(CriminalClasses.Length);
            ClassName = CriminalClasses[RandIndex];
        }
        // End:0x7F
        else
        {
            RandIndex = Rand(PoliceClasses.Length);
            ClassName = PoliceClasses[RandIndex];
        }
        ResultClass = class<Pawn>(DynamicLoadObject(ClassName, class'Class'));
    }
    // End:0xB1
    if(ResultClass == none)
    {
        ResultClass = DefaultPawnClass;
    }
    return ResultClass;
    //return ReturnValue;    
}

function Pawn SpawnDefaultPawnFor(Controller NewPlayer, NavigationPoint StartSpot)
{
    local Rotator StartRotation;
    local Pawn ResultPawn;
    local Vector SpawnOffset;
    local int Attempts;
    local float Radius;

    StartRotation.Yaw = StartSpot.Rotation.Yaw;
    Attempts = 0;
    J0x32:
    // End:0x127 [Loop If]
    if(Attempts < 5)
    {
        ResultPawn = Spawn(GetDefaultPlayerClass(NewPlayer),,, StartSpot.Location + SpawnOffset, StartRotation,, false);
        // End:0x11A
        if(ResultPawn == none)
        {
            // End:0xB0
            if(TdPlayerStart(StartSpot) != none)
            {
                Radius = TdPlayerStart(StartSpot).Radius;
            }
            // End:0xC5
            else
            {
                Radius = class'TdPlayerStart'.default.Radius;
            }
            SpawnOffset.X = float(Rand(int(Radius * float(2)))) - Radius;
            SpawnOffset.Y = float(Rand(int(Radius * float(2)))) - Radius;
            // [Explicit Continue]
            goto J0x11D;
        }
        J0x11D:
        // [Explicit Break]
        goto J0x127;
        ++ Attempts;
        J0x127:
        // [Loop Continue]
        goto J0x32;
    }
    return ResultPawn;
    //return ReturnValue;    
}

function OpenPostGameScene()
{
    local TdPlayerController TdPC;

    // End:0x46
    foreach WorldInfo.AllControllers(class'TdPlayerController', TdPC)
    {
        // End:0x45
        if(TdPC != none)
        {
            TdPC.ClientOpenScene('TdEndOfRound');
        }        
    }    
    //return;    
}

function AddToRespawnList(Controller C)
{
    local DeadPlayerController DeadC;

    // End:0x9D
    if(C.IsA('TdPlayerController') && !C.PlayerReplicationInfo.bOnlySpectator)
    {
        DeadC.C = TdPlayerController(C);
        DeadC.TimeToRespawn = WorldInfo.TimeSeconds + IndividualPlayerMinRespawnTime;
        DeadControllers.Insert(DeadControllers.Length, 1);
        DeadControllers[DeadControllers.Length - 1] = DeadC;
    }
    //return;    
}

function ClearRespawnList()
{
    DeadControllers.Remove(0, DeadControllers.Length);
    DeadControllers.Length = 0;
    //return;    
}

function RemoveFromRespawnList(Controller C)
{
    local int Idx;

    // End:0x67
    if(C.IsA('TdPlayerController'))
    {
        Idx = 0;
        J0x1F:
        // End:0x67 [Loop If]
        if(Idx < DeadControllers.Length)
        {
            // End:0x5D
            if(DeadControllers[Idx].C == C)
            {
                DeadControllers.Remove(-- Idx, 1);
            }
            ++ Idx;
            // [Loop Continue]
            goto J0x1F;
        }
    }
    //return;    
}

function BroadcastDeathMessage(Controller Killer, Controller Other, class<DamageType> DamageType)
{
    // End:0x39
    if(Killer == Other)
    {
        BroadcastLocalized(self, DeathMessageClass, 14, none, Other.PlayerReplicationInfo, DamageType);
    }
    // End:0x15A
    else
    {
        // End:0x6E
        if(Killer == none)
        {
            BroadcastLocalized(self, DeathMessageClass, 13, none, Other.PlayerReplicationInfo, DamageType);
        }
        // End:0x15A
        else
        {
            // End:0xDD
            if(Killer.PlayerReplicationInfo.Team == Other.PlayerReplicationInfo.Team)
            {
                BroadcastLocalized(self, DeathMessageClass, 15, Killer.PlayerReplicationInfo, Other.PlayerReplicationInfo, DamageType);
            }
            // End:0x15A
            else
            {
                // End:0x125
                if(class<TdDmgType_Melee>(DamageType) != none)
                {
                    BroadcastLocalized(self, DeathMessageClass, 16, Killer.PlayerReplicationInfo, Other.PlayerReplicationInfo, DamageType);
                }
                // End:0x15A
                else
                {
                    BroadcastLocalized(self, DeathMessageClass, 12, Killer.PlayerReplicationInfo, Other.PlayerReplicationInfo, DamageType);
                }
            }
        }
    }
    //return;    
}

