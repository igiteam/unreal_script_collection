class TdDirectionalFlareEmitter extends TdFlareEmitter
    native
    hidecategories(Navigation);

var() Actor Light;
var() float Cone;
var() float MaxScale;
var float FlareScale;
var float ConePlusOne;
var float OneMinusConeInv;

simulated event PostBeginPlay()
{
    ConePlusOne = 1.0 + Cone;
    OneMinusConeInv = 1.0 / (float(1) - Cone);
    super.PostBeginPlay();
