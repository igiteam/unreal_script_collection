simulated function float GetWeaponRatingFor(Weapon W)
{
    local TdWeapon TdWeap;

    TdWeap = TdWeapon(W);
    // End:0x39
    if((TdWeap != none) && Instigator.IsHumanControlled())
    {
        return -1.0;
    }
    // End:0x45
    else
    {
        return super.GetWeaponRatingFor(W);
    }
    //return ReturnValue;    
}

simulated function ChangedWeapon()
{
    local TdWeapon NewWeapon;
    local Engine.Inventory.EInventorySlot FreeSlot;

    super.ChangedWeapon();
    NewWeapon = TdWeapon(Instigator.Weapon);
    // End:0xFE
    if(NewWeapon != none)
    {
        // End:0xB3
        if(NewWeapon.InventorySlot == 0)
        {
            FreeSlot = FindFreeSlotForWeaponClass(NewWeapon.Class);
            // End:0x90
            if(FreeSlot != 0)
            {
                NewWeapon.AssignToSlot(FreeSlot);
            }
            // End:0xB3
            else
            {
                NewWeapon.AssignToSlot(NewWeapon.default.DefaultInventorySlot);
            }
        }
        // End:0xFE
        if((NewWeapon.InventorySlot == 1) || NewWeapon.InventorySlot == 2)
        {
            LastActiveGunSlot = NewWeapon.InventorySlot;
        }
    }
    //return;    
}

