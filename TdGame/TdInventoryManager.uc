class TdInventoryManager extends InventoryManager
    config(Game)
    hidecategories(Navigation);

var(Inventory) config float WeaponPickupTime;
var transient Engine.Inventory.EInventorySlot LastActiveGunSlot;

simulated function SwitchGun()
{
    local bool bFoundWeapon;
    local TdWeapon CandidateWeapon, W;

    // End:0x22
    if(LastActiveGunSlot == 1)
    {
        bFoundWeapon = SwitchToWeaponInSlot(2);
    }
    // End:0x41
    else
    {
        // End:0x41
        if(LastActiveGunSlot == 2)
        {
            bFoundWeapon = SwitchToWeaponInSlot(1);
        }
    }
    // End:0xA4
    if(!bFoundWeapon)
    {
        // End:0x6E
        foreach InventoryActors(class'TdWeapon', W)
        {
            CandidateWeapon = W;
            // End:0x6E
            break;            
        }        
        // End:0x8B
        if(CandidateWeapon != none)
        {
            SetCurrentWeapon(CandidateWeapon);
            return;
        }
        TdPawn(Instigator).SetUnarmed();
    }
    //return;    
}

simulated function SwitchToSpecificWeapon(int Index)
{
    local TdWeapon StartWeapon, CandidateWeapon, W;
    local int weaponCounter;

    weaponCounter = 1;
    // End:0x1C
    if(Index < 1)
    {
        NextWeapon();
    }
    StartWeapon = TdWeapon(Instigator.Weapon);
    // End:0x51
    if(PendingWeapon != none)
    {
        StartWeapon = TdWeapon(PendingWeapon);
    }
    // End:0x89
    foreach InventoryActors(class'TdWeapon', W)
    {
        // End:0x81
        if(Index == weaponCounter)
        {
            CandidateWeapon = W;
            // End:0x89
            break;
        }
        ++ weaponCounter;        
    }    
    // End:0xA8
    if((CandidateWeapon == none) || CandidateWeapon == StartWeapon)
    {
        return;
    }
    SetCurrentWeapon(CandidateWeapon);
    //return;    
}

