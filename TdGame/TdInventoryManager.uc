private final simulated function bool SwitchToWeaponInSlot(Engine.Inventory.EInventorySlot Slot)
{
    local TdWeapon StartWeapon, CandidateWeapon;

    StartWeapon = TdWeapon(Instigator.Weapon);
    // End:0x35
    if(PendingWeapon != none)
    {
        StartWeapon = TdWeapon(PendingWeapon);
    }
    CandidateWeapon = GetWeaponFromSlot(Slot);
    // End:0x71
    if(CandidateWeapon != none)
    {
        // End:0x71
        if(CandidateWeapon != StartWeapon)
        {
            SetCurrentWeapon(CandidateWeapon);
            return true;
        }
    }
    return false;
    //return ReturnValue;    
}

private final simulated function TdWeapon GetWeaponFromSlot(Engine.Inventory.EInventorySlot Slot)
{
    local TdWeapon W;

    // End:0x38
    foreach InventoryActors(class'TdWeapon', W)
    {
        // End:0x37
        if(W.InventorySlot == Slot)
        {            
            return W;
        }        
    }    
    return none;
    //return ReturnValue;    
}

simulated function PressedSwitchWeapon()
{
    local TdWeapon CurrentWeapon;

    CurrentWeapon = TdWeapon(Instigator.Weapon);
    // End:0x45
    if(((CurrentWeapon != none) && PendingWeapon != none) && CurrentWeapon != PendingWeapon)
    {
        return;
    }
    // End:0x73
    if(WorldInfo.GRI.IsMultiplayerGame())
    {
        SwitchGun();
    }
    // End:0x7D
    else
    {
        TryToPickUpWeapon();
    }
    //return;    
}

simulated function TryToPickUpWeapon()
{
    local TdPickup Pickup;
    local Engine.Inventory.EInventorySlot FreeSlot;
    local TdWeapon WeaponToPickup;

    Pickup = FindNearbyPickup();
    // End:0xF2
    if(Pickup != none)
    {
        // End:0x49
        if(Pickup.Inventory != none)
        {
            WeaponToPickup = TdWeapon(Pickup.Inventory);
        }
        // End:0x8E
        else
        {
            Pickup.Inventory = Spawn(Pickup.InventoryClass);
            WeaponToPickup = TdWeapon(Pickup.Inventory);
        }
        // End:0xF2
        if(WeaponToPickup != none)
        {
            FreeSlot = FindFreeSlotForWeaponClass(WeaponToPickup.Class);
            // End:0xEF
            if(FreeSlot != 0)
            {
                Pickup.GiveTo(Instigator);
                SwitchToWeaponInSlot(FreeSlot);
                J0xEF:
            }
            // End:0xEF
            else
            {
            }
            J0xF2:
        }
        // End:0xF2
        else
        {
        }
    }
    //return;    
}

final simulated function TdPickup FindNearbyPickup()
{
    local TdPickup Pickup;

    // End:0x60
    foreach Instigator.TouchingActors(class'TdPickup', Pickup)
    {
        // End:0x5C
        if(Pickup.CanBePickedUpBy(Instigator) && Pickup.GetAmmoCount() > 0)
        {            
            return Pickup;
            // End:0x5F
            continue;
        }        
        return none;        
    }    
    return none;
    //return ReturnValue;    
}

simulated function Engine.Inventory.EInventorySlot FindFreeSlotForWeaponClass(class<TdWeapon> WeaponClass)
{
    // End:0x45
    if(WeaponClass.default.DefaultInventorySlot != 0)
    {
        // End:0x45
        if(GetWeaponFromSlot(WeaponClass.default.DefaultInventorySlot) == none)
        {
            return WeaponClass.default.DefaultInventorySlot;
        }
    }
    // End:0x73
    if(WeaponClass.default.WeaponType == 1)
    {
        // End:0x70
        if(GetWeaponFromSlot(2) == none)
        {
            return 2;
        }
    }
    // End:0x9E
    else
    {
        // End:0x9E
        if(WeaponClass.default.WeaponType == 2)
        {
            // End:0x9E
            if(GetWeaponFromSlot(1) == none)
            {
                return 1;
            }
        }
    }
    return 0;
    //return ReturnValue;    
}

