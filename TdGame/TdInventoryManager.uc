{
    super.RemoveFromInventory(ItemToRemove);
    // End:0x4C
    if(ItemToRemove != none)
    {
        // End:0x4C
        if((Instigator.Health > 0) && Instigator.Weapon == none)
        {
            ClientSwitchToBestWeaponAfterDrop();
        }
    }
    //return;    
}

