class TdMove_MeleeAirAboveBot extends TdMove_MeleeBase
    config(PawnMovement);

function PlayCannedAnim(name AnimationName)
{
    PawnOwner.UseRootMotion(true);
    PawnOwner.UseRootRotation(true);
    PlayMoveAnim(0, AnimationName, 1.0, 0.0, 0.20, true, true);
    SetTimer(3.30);
    //return;    
}

simulated function StopMove()
{
    super.StopMove();
    BotOwner.OnMeleedFromAir();
    //return;    
}

simulated function OnTimer()
{
    PawnOwner.SetCollision(PawnOwner.bCollideActors, true);
    PawnOwner.bCollideWorld = true;
    //return;    
}

simulated function OnCustomAnimEnd(AnimNodeSequence SeqNode, float PlayedTime, float ExcessTime)
{
    PawnOwner.SetMove(1);
    //return;    
}

defaultproperties
{
    bDisableCollision=true
}