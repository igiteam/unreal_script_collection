class TdMove_StumbleHard extends TdMove_Stumble
    config(PawnMovement);

simulated function PlayStumbleAnimation()
{
    PawnOwner.StopCustomAnim(7, 0.20);
    PawnOwner.StopCustomAnim(4, 0.20);
    PawnOwner.StopCustomAnim(2, 0.20);
    PawnOwner.UseRootMotion(true);
    PlayMoveAnim(2, 'GetHitStumbleBwdFar2', 1.0, 0.10, 0.20, true);
    SetTimer(0.80);
    // End:0xF5
    if(PawnOwner.GetWeaponType() == 1)
    {
        ResetCameraLook(0.250);
        PawnOwner.TossWeapon(PawnOwner.Weapon);
        PawnOwner.RemoveWeaponAfterDrop();
    }
    //return;    
}

simulated function Vector GetFocusLocation()
{
    local Vector PawnRootLocation;

    PawnRootLocation = PawnOwner.Location;
    PawnRootLocation.Z -= PawnOwner.CylinderComponent.CollisionHeight;
    return PawnRootLocation + vect(0.0, 0.0, 150.0);
    //return ReturnValue;    
}
