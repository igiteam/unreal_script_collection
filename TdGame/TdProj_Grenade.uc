class TdProj_Grenade extends TdProjectile
    abstract
    hidecategories(Navigation);

var() export editinline PrimitiveComponent Mesh;
var float TimeToExplode;
var(Sounds) SoundCue ExplodingSound;
var(Sounds) SoundCue BouncingSound;
var(Effects) ParticleSystem ExplodingEffect;
var() export editinline ParticleSystemComponent PSC_SmokeTrail;
var repnotify bool bHasExploded;
var export editinline AudioComponent InFlightSound;
var SoundCue InFlightSoundTemplate;

replication
{
    // Pos:0x000
    if(bNetDirty)
        bHasExploded
}

simulated function PostBeginPlay()
{
    super(Projectile).PostBeginPlay();
    // End:0xDE
    if(WorldInfo.NetMode != NM_DedicatedServer)
    {
        // End:0x58
        if(PSC_SmokeTrail != none)
        {
            PSC_SmokeTrail.SetHidden(false);
            AttachComponent(PSC_SmokeTrail);
            PSC_SmokeTrail.ActivateSystem();
        }
        // End:0xDE
        if((InFlightSound == none) && InFlightSoundTemplate != none)
        {
            InFlightSound = CreateAudioComponent(InFlightSoundTemplate, true, true);
            InFlightSound.bAutoDestroy = true;
            InFlightSound.Location = self.Location;
            self.AttachComponent(InFlightSound);
            InFlightSound.FadeIn(0.30, 1.0);
        }
    }
    //return;    
}

simulated function ReplicatedEvent(name VarName)
{
    // End:0x28
    if(VarName == 'bHasExploded')
    {
        bHasExploded = false;
        DoExplosion();
    }
    // End:0x33
    else
    {
        super(Actor).ReplicatedEvent(VarName);
    }
    //return;    
}

simulated function Init(Vector Direction)
{
    local Rotator weaponRot;

    super(Projectile).Init(Direction);
    CollisionComponent = Mesh;
    CollisionComponent.SetScale3D(vect(1.0, 1.0, 1.0));
    CollisionComponent.SetBlockRigidBody(false);
    CollisionComponent.SetActorCollision(false, false);
    SkeletalMeshComponent(CollisionComponent).PhysicsWeight = 1.0;
    SkeletalMeshComponent(CollisionComponent).SetHasPhysicsAssetInstance(true);
    SetPhysics(10);
    CollisionComponent.SetNotifyRigidBodyCollision(true);
    CollisionComponent.ScriptRigidBodyCollisionThreshold = 100.0;
    CollisionComponent.WakeRigidBody();
    CollisionComponent.SetRBRotation(weaponRot);
    CollisionComponent.SetRBAngularVelocity(vect(20.0, 20.0, 20.0), true);
    CollisionComponent.SetRBLinearVelocity(Speed * Direction);
    SetTimer(0.050, false, 'ActivateCollision');
    bBounce = true;
    SetTimer(FMin(TimeToExplode, LifeSpan), false, 'DoExplosion');
    //return;    
}

event ActivateCollision()
{
    CollisionComponent.SetBlockRigidBody(true);
    CollisionComponent.SetActorCollision(true, false);
    //return;    
}

event RigidBodyCollision(PrimitiveComponent HitComponent, PrimitiveComponent OtherComponent, const out CollisionImpactData RigidCollisionData, int ContactIndex)
{
    PlaySound(BouncingSound, true, false, false, Location, false);
    //return;    
}

simulated function DoExplosion()
{
    // End:0x0B
    if(bHasExploded)
    {
        return;
    }
    Explode(Location, vect(0.0, 0.0, 1.0));
    PlaySound(ExplodingSound, true, false, false, Location, false);
    bHasExploded = true;
    SetPhysics(0);
    HideProjectile();
    SetCollision(false, false);
    //return;    
}

simulated function DestroyTheProjectile(ParticleSystemComponent PSC)
{
    //return;    
}

simulated function HideProjectile()
{
    local editinline MeshComponent ComponentIt;

    // End:0x1B
    if(PSC_SmokeTrail != none)
    {
        PSC_SmokeTrail.DeactivateSystem();
    }
    // End:0x40
    foreach ComponentList(class'MeshComponent', ComponentIt)
    {
        ComponentIt.SetHidden(true);        
    }    
    //return;    
}

function WarnProjExplode()
{
    local AIController C;

    // End:0x4C
    foreach WorldInfo.AllControllers(class'AIController', C)
    {
        // End:0x4B
        if(!C.IsDead())
        {
            C.WarnProjExplode(self);
        }        
    }    
    //return;    
}

simulated function Explode(Vector HitLocation, Vector HitNormal)
{
    local bool bOnGround;
    local Actor TraceActor;
    local Vector TraceHL, TraceHN, TraceDest, TraceStart, TraceExtent;

    local TraceHitInfo HitInfo;

    // End:0x0B
    if(bHasExploded)
    {
        return;
    }
    bHasExploded = true;
    // End:0x2E
    if(Physics == 0)
    {
        bOnGround = true;
    }
    // End:0x8C
    else
    {
        TraceStart = Location;
        TraceDest = Location - vect(0.0, 0.0, 15.0);
        TraceActor = Trace(TraceHL, TraceHN, TraceDest, TraceStart, false, TraceExtent, HitInfo, 2);
        bOnGround = TraceActor != none;
    }
    // End:0xA9
    if(bOnGround)
    {
        HitLocation += vect(0.0, 0.0, 16.0);
    }
    GrenadeExplosion(HitLocation, HitNormal, bOnGround);
    //return;    
}

simulated function GrenadeExplosion(Vector HitLocation, Vector HitNormal, bool bOnGround)
{
    local Emitter EmitActor;

    // End:0x7D
    if(WorldInfo.NetMode != NM_DedicatedServer)
    {
        EmitActor = Spawn(class'TdEmitter',,, HitLocation + (HitNormal * float(3)), rotator(HitNormal));
        EmitActor.SetTemplate(ExplodingEffect, true);
        EmitActor.ParticleSystemComponent.ActivateSystem();
    }
    // End:0xF0
    if(Role == ROLE_Authority)
    {
        MakeNoise(1.0);
        HurtRadius(float(InnerCoreDamage), float(InnerCoreDamageRadius), MyDamageType, MomentumTransfer, HitLocation,, InstigatorController, true);
        HurtRadius(OuterCoreDamage, float(OuterCoreDamageRadius), MyDamageType, MomentumTransfer, HitLocation,, InstigatorController, false);
    }
    // End:0x132
    if(false)
    {
        DrawDebugSphereTime(HitLocation, float(InnerCoreDamageRadius), 12, 255, 128, 16, 1.0);
        DrawDebugSphereTime(HitLocation, float(OuterCoreDamageRadius), 12, 255, 16, 16, 1.0);
    }
    //return;    
}

