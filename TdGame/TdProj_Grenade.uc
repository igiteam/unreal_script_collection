    InnerCoreDamage=600
    InnerCoreDamageRadius=256
    OuterCoreDamage=400.0
    OuterCoreDamageRadius=512
    MaxSpeed=0.0
    Damage=50.0
    MomentumTransfer=1.0
    CylinderComponent=CylinderComponent'Default__TdProj_Grenade.CollisionCylinder'
    bAlwaysRelevant=true
    bNetInitialRotation=true
    bKillDuringLevelTransition=true
    bCollideComplex=true
    bBounce=true
    Components(0)=SpriteComponent'Default__TdProj_Grenade.Sprite'
    Components(1)=CylinderComponent'Default__TdProj_Grenade.CollisionCylinder'
    Physics=PHYS_RigidBody
    TickGroup=TG_PostAsyncWork
