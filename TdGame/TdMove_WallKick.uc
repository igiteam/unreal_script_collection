class TdMove_WallKick extends TdPhysicsMove
    config(PawnMovement);

var(WallKick) config float WallKickMaxDistance;
var(WallKick) config float WallKickCheckHeight;
var(WallKick) config float WallKickExtentWidth;
var(WallKick) config float WallKickExtentHeight;
var(WallKick) config float WallKickVelocity2D;
var(WallKick) config float WallKickVelocityZ;

function bool CanDoMove()
{
    return false;
    //return ReturnValue;    
}

simulated function StartMove()
{
    local Vector KickVelocity, WallProjVelocity;

    super.StartMove();
    WallProjVelocity = PawnOwner.Velocity - (PawnOwner.MoveNormal * (PawnOwner.Velocity Dot PawnOwner.MoveNormal));
    WallProjVelocity.Z = 0.0;
    KickVelocity = PawnOwner.MoveNormal * WallKickVelocity2D;
    PawnOwner.Velocity.X = KickVelocity.X + WallProjVelocity.X;
    PawnOwner.Velocity.Y = KickVelocity.Y + WallProjVelocity.Y;
    PawnOwner.Velocity.Z += WallKickVelocityZ;
    //return;    
}

defaultproperties
{
    WallKickMaxDistance=60.0
    WallKickCheckHeight=90.0
    WallKickExtentWidth=20.0
    WallKickExtentHeight=10.0
    WallKickVelocity2D=300.0
    WallKickVelocityZ=580.0
    PawnPhysics=PHYS_Falling
    ControllerState=PlayerWalking
    bCheckForGrab=true
    bCheckForVaultOver=true
    bTriggersCompliment=true
    RedoMoveTime=1.0
}