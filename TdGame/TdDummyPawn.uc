class TdDummyPawn extends GamePawn
    config(Game)
    hidecategories(Navigation);

var SeqAct_TdDummyWeaponFire FireAction;

function bool StopWeaponFiring()
{
    local int I;
    local bool bResult;
    local TdWeapon TdWeap;

    TdWeap = TdWeapon(Weapon);
    // End:0xA5
    if(TdWeap != none)
    {
        TdWeap.ClearPendingFire(0);
        TdWeap.EndFire(0);
        TdWeap.ClearPendingFire(1);
        TdWeap.EndFire(1);
        TdWeap.ServerStopFire(0);
        TdWeap.ServerStopFire(1);
        bResult = true;
    }
    // End:0x115
    if(InvManager != none)
    {
        I = 0;
        J0xB7:
        // End:0x115 [Loop If]
        if(I < InvManager.PendingFire.Length)
        {
            // End:0x10B
            if(InvManager.PendingFire[I] > 0)
            {
                bResult = true;
                InvManager.PendingFire[I] = 0;
            }
            ++ I;
            // [Loop Continue]
            goto J0xB7;
        }
    }
    return bResult;
    //return ReturnValue;    
}

simulated function WeaponFired(bool bViaReplication, optional Vector HitLocation)
{
    super(Pawn).WeaponFired(bViaReplication, HitLocation);
    FireAction.NotifyDummyFire();
    TdWeapon(Weapon).PlayShellCaseEject();
    //return;    
}

simulated function Rotator GetAdjustedAimFor(Weapon InWeapon, Vector projStart)
{
    local Rotator ReturnAimRotation, BaseRotation;
    local Vector WeaponAimVector;

    // End:0xA3
    if(FireAction.Target != none)
    {
        WeaponAimVector = FireAction.Target.Location - FireAction.Origin.Location;
        // End:0x78
        if(VSize(WeaponAimVector) < 0.10)
        {
            BaseRotation = Weapon.Rotation;
        }
        // End:0xA0
        else
        {
            BaseRotation = rotator(FireAction.Target.Location - projStart);
        }
    }
    // End:0xAE
    else
    {
        BaseRotation = Rotation;
    }
    ReturnAimRotation = BaseRotation + (FireAction.MaxSpread * (1.0 - (2.0 * FRand())));
    return ReturnAimRotation;
    //return ReturnValue;    
}

simulated function Vector GetWeaponStartTraceLocation(optional Weapon CurrentWeapon)
{
    return GetPawnViewLocation();
    //return ReturnValue;    
}

simulated function Vector GetPawnViewLocation()
{
    // End:0x4A
    if((Weapon != none) && TdWeapon(Weapon).MuzzleFlashPSC != none)
    {
        return TdWeapon(Weapon).MuzzleFlashPSC.GetPosition();
    }
    // End:0x51
    else
    {
        return super(Pawn).GetPawnViewLocation();
    }
    //return ReturnValue;    
}

simulated event Tick(float DeltaTime)
{
    local Vector WeaponAimVector;

    // End:0xDA
    if((FireAction.Origin != none) && FireAction.Target != none)
    {
        WeaponAimVector = FireAction.Target.Location - FireAction.Origin.Location;
        Weapon.SetLocation(FireAction.Origin.Location);
        // End:0xC6
        if(VSize(WeaponAimVector) < 0.10)
        {
            Weapon.SetRotation(FireAction.Target.Rotation);
        }
        // End:0xDA
        else
        {
            Weapon.SetRotation(rotator(WeaponAimVector));
        }
    }
    //return;    
}

