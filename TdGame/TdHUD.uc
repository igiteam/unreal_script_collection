function PreBeginPlay()
{
    super(Actor).PreBeginPlay();
    LinkHUDContent();
    //return;    
}

function LinkHUDContent()
{
    // End:0x6B
    if(HUDContentClass == none)
    {
        HUDContentClass = class<TdHUDContent>(DynamicLoadObject(HUDContentClassName, class'Class'));
        // End:0x44
        if(HUDContentClass != none)
        {
            LoadHUDContent(HUDContentClass);
        }
        // End:0x68
        else
        {
            DiskAccessIndicatorScene = class'TdHUDContent'.static.GetUISceneByName('TdDiskAccessIndicator');
        }
        J0x6B:
    }
    // End:0x6B
    else
    {
    }
    //return;    
}

function PostBeginPlay()
{
    local TsSystem TsSys;

    super.PostBeginPlay();
    EffectManager = new (self) class'TdHudEffectManager';
    EffectManager.StartUp();
    EffectManager.InitSavedDOFValues();
    ToggleZoomState(false);
    WorldInfo.SetSceneExposureReset(true);
    // End:0xBB
    if(LocalPlayer(PlayerOwner.Player).PlayerPostProcess != none)
    {
        FadeEffect = MaterialEffect(LocalPlayer(PlayerOwner.Player).PlayerPostProcess.FindPostProcessEffect('FadeInEffect'));
    }
    // End:0x162
    if(FadeEffect != none)
    {
        FadeEffect.bShowInGame = false;
        FadeEffectMaterialInstance = new (none) class'MaterialInstanceConstant';
        FadeEffectMaterialInstance.SetParent(FadeEffect.Material);
        FadeEffect.Material = FadeEffectMaterialInstance;
        FadeAmount = 0.0;
        FadeEffectMaterialInstance.SetScalarParameterValue('FadeInAmount', FadeAmount);
        TriggerCustomFadeIn(FMax(default.FadeInTime, 0.01660));
    }
    SetPostProcessVars(0.0, 0.0);
    TsSys = class'TsSystem'.static.GetTsSystem();
    // End:0x1B0
    if(TsSys != none)
    {
        TsSys.RegisterOnDiskAccessDelegate(NotifyDiskAccess);
    }
    //return;    
}

simulated function Tick(float DeltaTime)
{
    local TdGameUISceneClient SceneClient;

    super(Actor).Tick(DeltaTime);
    EffectManager.Update(DeltaTime, RealTimeRenderDelta);
    // End:0xAC
    if(PendingPauseTicks > 0)
    {
        -- PendingPauseTicks;
        // End:0xAC
        if(PendingPauseTicks == 0)
        {
            SceneClient = TdGameUISceneClient(LocalPlayer(PlayerOwner.Player).ViewportClient.UIController.SceneClient);
            // End:0xA5
            if(!SceneClient.IsTransitioning())
            {
                PauseGame();
            }
            // End:0xAC
            else
            {
                PendingPauseTicks = 1;
            }
        }
    }
    //return;    
}

event Destroyed()
{
    local TsSystem TsSys;

    TsSys = class'TsSystem'.static.GetTsSystem();
    // End:0x3E
    if(TsSys != none)
    {
        TsSys.UnRegisterOnDiskAccessDelegate(NotifyDiskAccess);
    }
    super.Destroyed();
    //return;    
}

