exec function TriggerCustomColorBlink(float InFadeOutTime, float InFadeInTime, float R, float G, float B, optional bool bRealTime, optional delegate<OnMaxFade> InOnMaxFade)
{
    FadeEffectMaterialInstance.SetVectorParameterValue('FadeColor', MakeLinearColor(R, G, B, 1.0));
    LatentFadeIn = InFadeInTime;
    __OnMaxFade__Delegate = InOnMaxFade;
    bUseRealTimeFade = bRealTime;
    TriggerCustomFadeOut(InFadeOutTime);
    //return;    
}

exec function TriggerCustomBlink(float InFadeOutTime, float InFadeInTime, optional bool bRealTime, optional delegate<OnMaxFade> InOnMaxFade)
{
    FadeEffectMaterialInstance.SetVectorParameterValue('FadeColor', MakeLinearColor(0.0, 0.0, 0.0, 0.0));
    LatentFadeIn = InFadeInTime;
    __OnMaxFade__Delegate = InOnMaxFade;
    bUseRealTimeFade = bRealTime;
    TriggerCustomFadeOut(InFadeOutTime);
    //return;    
}

exec function TriggerCustomColorFadeIn(float Time, LinearColor FadeColor, optional bool bRealTime, optional delegate<OnMaxFade> InOnDone, optional bool bForceFullFadeAmount)
{
    FadeEffectMaterialInstance.SetVectorParameterValue('FadeColor', FadeColor);
    TriggerCustomFadeIn(Time, bRealTime, InOnDone, bForceFullFadeAmount);
    //return;    
}

exec function TriggerCustomColorFadeOut(float Time, LinearColor FadeColor, optional bool bRealTime, optional delegate<OnMaxFade> InOnDone)
{
    FadeEffectMaterialInstance.SetVectorParameterValue('FadeColor', FadeColor);
    TriggerCustomFadeOut(Time, bRealTime, InOnDone);
    //return;    
}

private final function TriggerCustomFadeIn(float Time, optional bool bRealTime, optional delegate<OnMaxFade> InOnDone, optional bool bForceFullFadeAmount)
{
    // End:0x2C
    if(__OnMaxFade__Delegate != none)
    {
        OnMaxFade();
        __OnMaxFade__Delegate = None;
    }
    // End:0xC6
    if((FadeAmount < 1.0) || bForceFullFadeAmount)
    {
        // End:0x5A
        if(bForceFullFadeAmount)
        {
            FadeAmount = 0.0;
        }
        bIsFadingIn = true;
        FadeEffect.bShowInGame = true;
        FadeInTime = FMax(Time, 0.01660);
        FadeOutTime = 0.0;
        // End:0xAB
        if(__OnDoneFade__Delegate != none)
        {
            OnDoneFade();
        }
        __OnDoneFade__Delegate = InOnDone;
        bUseRealTimeFade = bRealTime;
    }
    // End:0xD5
    else
    {
        OnMaxFade();
    }
    //return;    
}

private final function TriggerCustomFadeOut(float Time, optional bool bRealTime, optional delegate<OnMaxFade> InOnDone)
{
    // End:0x7D
    if(FadeAmount > 0.0)
    {
        bIsFadingIn = false;
        FadeOutTime = FMax(Time, 0.01660);
        FadeEffect.bShowInGame = true;
        FadeInTime = 0.0;
        // End:0x62
        if(__OnDoneFade__Delegate != none)
        {
            OnDoneFade();
        }
        __OnDoneFade__Delegate = InOnDone;
        bUseRealTimeFade = bRealTime;
    }
    // End:0xB2
    else
    {
        OnMaxFade();
        // End:0xB2
        if(LatentFadeIn > 0.0)
        {
            TriggerCustomFadeIn(LatentFadeIn, bRealTime, __OnMaxFade__Delegate);
        }
    }
    //return;    
}

function ToggleZoomState(bool bZoom)
{
    // End:0x0D
    if(EffectManager == none)
    {
        return;
    }
    // End:0x6D
    if(bZoom)
    {
        TargetingMaxDistance = 2.0 * default.TargetingMaxDistance;
        EffectManager.ActivateZoomInDOF();
        // End:0x6A
        if(TdPlayerController(PlayerOwner) != none)
        {
            TdPlayerController(PlayerOwner).SetNearClippingPlane(20.0);
        }
    }
    // End:0xBA
    else
    {
        TargetingMaxDistance = default.TargetingMaxDistance;
        EffectManager.DeActivateZoomInDOF();
        // End:0xBA
        if(TdPlayerController(PlayerOwner) != none)
        {
            TdPlayerController(PlayerOwner).SetNearClippingPlane(10.0);
        }
    }
    //return;    
}

function PauseGame()
{
    local int OpenSceneIndex;
    local bool ShouldPause;
    local UIInteraction UIController;
    local TdGameUISceneClient SceneClient;
    local UIScene PauseScene;

    // End:0x0F
    if(IsInMainMenu())
    {
        return;
    }
    ShouldPause = true;
    // End:0x70
    if(TdPlayerController(PlayerOwner).GetCurrentPlayerData() == none)
    {
        // End:0x70
        if((WorldInfo.GRI == none) || WorldInfo.GRI.IsMultiplayerGame())
        {
            return;
        }
    }
    // End:0xAC
    if((WorldInfo.Game != none) && !WorldInfo.Game.CanOpenPauseMenu())
    {
        return;
    }
    UIController = LocalPlayer(PlayerOwner.Player).ViewportClient.UIController;
    SceneClient = TdGameUISceneClient(UIController.SceneClient);
    // End:0x114
    if(SceneClient.IsTransitioning())
    {
        PendingPauseTicks = 1;
        return;
    }
    OpenSceneIndex = 0;
    J0x11B:
    // End:0x17E [Loop If]
    if(OpenSceneIndex < UIController.SceneClient.ActiveScenes.Length)
    {
        // End:0x174
        if(UIController.SceneClient.ActiveScenes[OpenSceneIndex].bPauseGameWhileActive)
        {
            ShouldPause = false;
        }
        ++ OpenSceneIndex;
        // [Loop Continue]
        goto J0x11B;
    }
    // End:0x225
    if(ShouldPause)
    {
        WorldInfo.ForceGarbageCollection();
        // End:0x1DE
        if(SceneClient != none)
        {
            SceneClient.OpenSceneEx(PauseSceneRef, LocalPlayer(PlayerOwner.Player), 3, OnPauseSceneOpened);
        }
        // End:0x225
        else
        {
            UIController.OpenScene(PauseSceneRef, LocalPlayer(PlayerOwner.Player), PauseScene);
            PauseScene.__OnSceneDeactivated__Delegate = UnPauseGame;
        }
    }
    //return;    
}

private final function OnPauseSceneOpened(UIScene OpenedScene, bool bInitialActivation)
{
    OpenedScene.__OnSceneDeactivated__Delegate = UnPauseGame;
    //return;    
}

function UnPauseGame(UIScene DeactivatedScene)
{
    //return;    
}

function DelayedPauseGame()
{
    PendingPauseTicks = 2;
    //return;    
}

function OpenInGameMenu()
{
    local UIInteraction UIController;
    local int OpenSceneIndex;
    local bool ShouldShowIngameMenu;
    local TdGameUISceneClient SceneClient;
    local TdUIScene_LoadIndicator LoadIndicator;

    // End:0x0F
    if(IsInMainMenu())
    {
        return;
    }
    // End:0x4B
    if((WorldInfo.Game != none) && !WorldInfo.Game.CanOpenPauseMenu())
    {
        return;
    }
    LoadIndicator = TdUIScene_LoadIndicator(DiskAccessIndicatorInstance);
    // End:0x68
    if(LoadIndicator != none)
    {
        return;
    }
    ShouldShowIngameMenu = true;
    UIController = LocalPlayer(PlayerOwner.Player).ViewportClient.UIController;
    // End:0x1BE
    if((UIController != none) && InGameMenuRef != none)
    {
        OpenSceneIndex = 0;
        J0xBD:
        // End:0x123 [Loop If]
        if(OpenSceneIndex < UIController.SceneClient.ActiveScenes.Length)
        {
            // End:0x119
            if(UIController.SceneClient.ActiveScenes[OpenSceneIndex].bPauseGameWhileActive)
            {
                ShouldShowIngameMenu = false;
                // [Explicit Break]
                goto J0x123;
            }
            ++ OpenSceneIndex;
            J0x123:
            // [Loop Continue]
            goto J0xBD;
        }
        // End:0x1BE
        if(ShouldShowIngameMenu)
        {
            WorldInfo.ForceGarbageCollection();
            SceneClient = TdGameUISceneClient(UIController.SceneClient);
            // End:0x194
            if(SceneClient != none)
            {
                SceneClient.OpenSceneEx(InGameMenuRef, LocalPlayer(PlayerOwner.Player));
            }
            // End:0x1BE
            else
            {
                UIController.OpenScene(InGameMenuRef, LocalPlayer(PlayerOwner.Player));
            }
        }
    }
    //return;    
}

function bool IsInMainMenu()
{
    return WorldInfo.GetMapName() ~= "TDMAINMENU";
    //return ReturnValue;    
}

function PlayTakeHit(Vector HitDir, int Damage, class<DamageType> DamageType)
{
    local TdHUD.EDamageType dmt;

    EffectManager.ThePlayerPawn = TdPlayerPawn(PlayerOwner.Pawn);
    // End:0x3F
    if(class<TdDmgType_Bullet>(DamageType) != none)
    {
        dmt = 0;
    }
    // End:0xF9
    else
    {
        // End:0x5A
        if(class<TdDmgType_Melee>(DamageType) != none)
        {
            dmt = 5;
        }
        // End:0xF9
        else
        {
            // End:0x75
            if(class<DmgType_Fell>(DamageType) != none)
            {
                dmt = 4;
            }
            // End:0xF9
            else
            {
                // End:0x8F
                if(DamageType == class'TdDmgType_Taser')
                {
                    dmt = 1;
                }
                // End:0xF9
                else
                {
                    // End:0xA9
                    if(DamageType == class'TdDmgType_ElectricShock')
                    {
                        dmt = 2;
                    }
                    // End:0xF9
                    else
                    {
                        // End:0xC3
                        if(DamageType == class'TdDmgType_Explosion')
                        {
                            dmt = 3;
                        }
                        // End:0xF9
                        else
                        {
                            // End:0xDD
                            if(DamageType == class'TdDmgType_Flashbang')
                            {
                                dmt = 6;
                            }
                            // End:0xF9
                            else
                            {
                                // End:0xF7
                                if(DamageType == class'TdDmgType_HeavyFlashbang')
                                {
                                    dmt = 7;
                                }
                                // End:0xF9
                                else
                                {
                                    return;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    EffectManager.DisplayHit(HitDir, Damage, dmt);
    //return;    
}

