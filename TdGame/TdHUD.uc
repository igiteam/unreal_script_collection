static function Font GetFontSizeIndex(int FontSize)
{
    // End:0x14
    if(FontSize == 0)
    {
        return default.SmallFont;
    }
    // End:0x58
    else
    {
        // End:0x28
        if(FontSize == 1)
        {
            return default.SmallFont;
        }
        // End:0x58
        else
        {
            // End:0x3D
            if(FontSize == 2)
            {
                return default.MediumFont;
            }
            // End:0x58
            else
            {
                // End:0x52
                if(FontSize == 3)
                {
                    return default.LargeFont;
                }
                // End:0x58
                else
                {
                    return default.LargeFont;
                }
            }
        }
    }
    //return ReturnValue;    
}

event PostRender()
{
    RenderDelta = WorldInfo.TimeSeconds - LastHUDRenderTime;
    RealTimeRenderDelta = WorldInfo.RealTimeSeconds - LastRealTimeHUDRenderTime;
    // End:0x7A
    if((SizeX != float(Canvas.SizeX)) || SizeY != float(Canvas.SizeY))
    {
        PreCalcValues();
    }
    // End:0x13F
    if(PlayerOwner != none)
    {
        // End:0xF3
        if(PlayerOwner.ViewTarget != none)
        {
            // End:0xDB
            if(Pawn(PlayerOwner.ViewTarget) != none)
            {
                ViewedInfo = Pawn(PlayerOwner.ViewTarget).PlayerReplicationInfo;
            }
            // End:0xF0
            else
            {
                ViewedInfo = PlayerOwner.PlayerReplicationInfo;
            }
        }
        // End:0x13F
        else
        {
            // End:0x12A
            if(PlayerOwner.Pawn != none)
            {
                ViewedInfo = PlayerOwner.Pawn.PlayerReplicationInfo;
            }
            // End:0x13F
            else
            {
                ViewedInfo = PlayerOwner.PlayerReplicationInfo;
            }
        }
    }
    Canvas.DrawColor = ConsoleColor;
    // End:0x239
    if(bShowHUD)
    {
        // End:0x1C5
        if(bShowScores)
        {
            // End:0x1C2
            if(ScoreBoard != none)
            {
                ScoreBoard.Canvas = Canvas;
                ScoreBoard.DrawHUD();
                // End:0x1C2
                if(ScoreBoard.bDisplayMessages && bDisplayConsoleMessages)
                {
                    DisplayConsoleMessages();
                }
            }
        }
        // End:0x239
        else
        {
            DrawHUD();
            // End:0x1FC
            if(PlayerOwner.ProgressTimeOut > WorldInfo.TimeSeconds)
            {
                DisplayProgressMessage();
            }
            // End:0x20F
            if(bDisplayConsoleMessages)
            {
                DisplayConsoleMessages();
            }
            // End:0x239
            if(bDisplayGameMessages && WorldInfo.Pauser == none)
            {
                DisplayLocalMessages();
            }
        }
    }
    // End:0x24C
    if(bShowBadConnectionAlert)
    {
        DisplayBadConnectionAlert();
    }
    LastHUDRenderTime = WorldInfo.TimeSeconds;
    LastRealTimeHUDRenderTime = WorldInfo.RealTimeSeconds;
    //return;    
}

event NotifyDiskAccess(bool IsAccessing, Ts.TsSystem.ETsDiskAccess AccessType)
{
    local TdPlayerController PlayerOwnerController;
    local TdUIScene_LoadIndicator IndicatorScene;
    local TdGameUISceneClient SC;

    SC = TdGameUISceneClient(class'UIRoot'.static.GetSceneClient());
    // End:0x472
    if(SC != none)
    {
        // End:0x32C
        if(IsAccessing)
        {
            // End:0x57
            if(DiskAccessIndicatorInstance == none)
            {
                // End:0x57
                if(SC.OpenDiskAccessScene(DiskAccessIndicatorScene, DiskAccessIndicatorInstance))
                {
                }
            }
            // End:0x329
            if(DiskAccessIndicatorInstance != none)
            {
                IndicatorScene = TdUIScene_LoadIndicator(DiskAccessIndicatorInstance);
                // End:0x329
                if(IndicatorScene != none)
                {
                    switch(AccessType)
                    {
                        // End:0xB7
                        case 1:
                            IndicatorScene.Setup("", false);
                            IndicatorScene.bIsDiscAccess = true;
                            // End:0x329
                            break;
                        // End:0xE9
                        case 2:
                            IndicatorScene.Setup("", false);
                            IndicatorScene.bIsDiscAccess = true;
                            // End:0x329
                            break;
                        // End:0x11B
                        case 3:
                            IndicatorScene.Setup("", true);
                            IndicatorScene.bIsDiscAccess = true;
                            // End:0x329
                            break;
                        // End:0x14D
                        case 4:
                            IndicatorScene.Setup("", true);
                            IndicatorScene.bIsDiscAccess = true;
                            // End:0x329
                            break;
                        // End:0x17F
                        case 6:
                            IndicatorScene.Setup("", false);
                            IndicatorScene.bRequiresOnlineService = true;
                            // End:0x329
                            break;
                        // End:0x1B1
                        case 5:
                            IndicatorScene.Setup("", false);
                            IndicatorScene.bRequiresOnlineService = true;
                            // End:0x329
                            break;
                        // End:0x1F0
                        case 7:
                            IndicatorScene.Setup(IndicatorScene.CreatingSaveDataMessage, false, true);
                            IndicatorScene.bIsDiscAccess = true;
                            // End:0x329
                            break;
                        // End:0x22F
                        case 8:
                            IndicatorScene.Setup(IndicatorScene.LoadingSaveDataMessage, false, true);
                            IndicatorScene.bIsDiscAccess = true;
                            // End:0x329
                            break;
                        // End:0x26E
                        case 9:
                            IndicatorScene.Setup(IndicatorScene.CheckingSaveDataMessage, false, true);
                            IndicatorScene.bIsDiscAccess = true;
                            // End:0x329
                            break;
                        // End:0x326
                        case 10:
                            // End:0x323
                            if(!IndicatorScene.bIsLoadingLevel)
                            {
                                PlayerOwnerController = TdPlayerController(PlayerOwner);
                                PlayerOwnerController.IgnoreMoveInput(true);
                                PlayerOwnerController.IgnoreLookInput(true);
                                PlayerOwnerController.IgnoreButtonInput(true);
                                PlayerOwnerController.EnableHighPrioLoading(true);
                                IndicatorScene.bIsLoadingLevel = true;
                                IndicatorScene.Setup(IndicatorScene.LoadingLevelMessage, false);
                            }
                            // End:0x329
                            break;
                        // End:0xFFFF
                        default:
                        }
                    }
                }
                // End:0x472
                else
                {
                    IndicatorScene = TdUIScene_LoadIndicator(DiskAccessIndicatorInstance);
                    // End:0x472
                    if(IndicatorScene != none)
                    {
                        // End:0x369
                        if(AccessType == 0)
                        {
                            IndicatorScene.bIsDiscAccess = false;
                        }
                        // End:0x41E
                        if((AccessType == 10) && IndicatorScene.bIsLoadingLevel)
                        {
                            PlayerOwnerController = TdPlayerController(PlayerOwner);
                            PlayerOwnerController.IgnoreMoveInput(false);
                            PlayerOwnerController.IgnoreLookInput(false);
                            PlayerOwnerController.IgnoreButtonInput(false);
                            PlayerOwnerController.EnableHighPrioLoading(false);
                            IndicatorScene.bIsLoadingLevel = false;
                            SC.CloseDiskAccessScene();
                            DiskAccessIndicatorInstance = none;
                        }
                        // End:0x472
                        else
                        {
                            // End:0x45B
                            if(IndicatorScene.bIsLoadingLevel)
                            {
                                IndicatorScene.Setup(IndicatorScene.LoadingLevelMessage, false);
                                return;
                            }
                            // End:0x472
                            else
                            {
                                SC.CloseDiskAccessScene();
                                DiskAccessIndicatorInstance = none;
                            }
                        }
                    }
                }
            }
            //return;            
}

defaultproperties
{
    TinyFont=MultiFont'UI_Fonts_Final.Helvetica_Small_Bold'
    SmallFont=MultiFont'UI_Fonts_Final.Helvetica_Small_Bold'
    MediumFont=MultiFont'UI_Fonts_Final.Helvetica_Large_Normal'
    LargeFont=MultiFont'UI_Fonts_Final.Helvetica_Headline_Thick_Italic'
    HUDContentClassName="TdGame.TdHUDContent"
    TargetingMaxDistance=10000.0
    FontDSOffset=0.040
    FontDSColor=(R=0,G=80,B=130,A=128)
    FadeInTime=1.0
    FadeOutTime=1.0
    bAlwaysTick=true
}