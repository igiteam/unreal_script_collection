{
    EffectManager.UnDisplayDeath();
    EffectManager.ResetPPEffects();
    EffectManager.ResetParticles();
    EffectManager.ResetScopeEffect();
    EffectManager.ResetMotionBlurEffects();
    //return;    
}

function OpenSceneByName(name SceneToShow)
{
    local TdGameUISceneClient SC;
    local UIScene ActualScene;
    local LocalPlayer LP;

    // End:0x15
    if(HUDContentClass == none)
    {
        LinkHUDContent();
    }
    ActualScene = HUDContentClass.static.GetUISceneByName(SceneToShow);
    // End:0x42
    if(ActualScene == none)
    {
        return;
    }
    LP = LocalPlayer(PlayerOwner.Player);
    SC = TdGameUISceneClient(class'UIRoot'.static.GetSceneClient());
    // End:0xA2
    if(SC != none)
    {
        SC.OpenSceneEx(ActualScene, LP);
    }
    //return;    
}

function CloseSceneByName(name SceneToClose)
{
    local UIScene TdScene;

    TdScene = HUDContentClass.static.GetUISceneByName(SceneToClose);
    // End:0x46
    if(TdScene != none)
    {
        TdScene.CloseScene(TdScene);
    }
    //return;    
}

