function ComputeHUDPosition(float PosX, float PosY, float Width, float Height, out Vector2D FinalPos)
{
    local float ResolutionScaleX, ResolutionScaleY;

    ResolutionScaleX = Canvas.ClipX / 1280.0;
    ResolutionScaleY = Canvas.ClipY / 720.0;
    // End:0x6E
    if(PosX < float(0))
    {
        FinalPos.X = (Abs(PosX) * ResolutionScaleX) - Width;
    }
    // End:0x8B
    else
    {
        FinalPos.X = PosX * ResolutionScaleX;
    }
    // End:0xC1
    if(PosY < float(0))
    {
        FinalPos.Y = (Abs(PosY) * ResolutionScaleY) - Height;
    }
    // End:0xDE
    else
    {
        FinalPos.Y = PosY * ResolutionScaleY;
    }
    //return;    
}

function ClearLocalMessages()
{
    local int LocalMessagesCount, I;

    LocalMessagesCount = 8;
    I = 0;
    J0x0F:
    // End:0x40 [Loop If]
    if(I < LocalMessagesCount)
    {
        LocalMessages[I].Message = none;
        ++ I;
        // [Loop Continue]
        goto J0x0F;
    }
    //return;    
}

function DrawMessage(int MessageIdx, float PosY, out float DX, out float DY)
{
    local float FadeValue;
    local int MessageArea;
    local float ScreenX, ScreenY, PosX, DSOffset;

    // End:0x54
    if(LocalMessages[MessageIdx].Lifetime > 0.0)
    {
        FadeValue = FMin(1.0, LocalMessages[MessageIdx].EndOfLife - WorldInfo.TimeSeconds);
    }
    MessageArea = LocalMessages[MessageIdx].Message.static.GetMessageArea(LocalMessages[MessageIdx].Switch);
    switch(MessageArea)
    {
        // End:0xD5
        case 1:
            PosX = 0.950 - (LocalMessages[MessageIdx].DX / Canvas.ClipX);
        // End:0x118
        case 2:
            PosX = 0.50 - ((LocalMessages[MessageIdx].DX * 0.50) / Canvas.ClipX);
            // End:0x12D
            break;
        // End:0x12A
        case 0:
            PosX = 0.050;
            // End:0x12D
            break;
        // End:0xFFFF
        default:
            Canvas.Font = LocalMessages[MessageIdx].StringFont;
            DSOffset = (Canvas.Font.GetMaxCharHeight() * MediumFont.GetScalingFactor(float(Canvas.SizeY))) * FontDSOffset;
            DSOffset = FMax(1.0, DSOffset);
            GetScreenCoordsEx(PosX, PosY, ScreenX, ScreenY, LocalMessages[MessageIdx]);
            DX = LocalMessages[MessageIdx].DX / Canvas.ClipX;
            DY = LocalMessages[MessageIdx].DY / Canvas.ClipY;
            // End:0x2E6
            if(LocalMessages[MessageIdx].Message.default.bDrawOutline)
            {
                Canvas.DrawColor = FontDSColor;
                Canvas.DrawColor.A = byte((FadeValue ** float(2)) * float(Canvas.DrawColor.A));
                DrawMessageText(LocalMessages[MessageIdx], ScreenX + DSOffset, ScreenY + DSOffset);
            }
            Canvas.DrawColor = LocalMessages[MessageIdx].DrawColor;
            Canvas.DrawColor.A = byte((FadeValue ** 0.50) * float(Canvas.DrawColor.A));
            DrawMessageText(LocalMessages[MessageIdx], ScreenX, ScreenY);
            LocalMessages[MessageIdx].Drawn = true;
            //return;
    }    
}

function GetScreenCoordsEx(float PosX, float PosY, out float ScreenX, out float ScreenY, out HudLocalizedMessage InMessage)
{
    ScreenX = ((PosX * HudCanvasScale) * Canvas.ClipX) + (((1.0 - HudCanvasScale) / 2.0) * Canvas.ClipX);
    ScreenY = ((PosY * HudCanvasScale) * Canvas.ClipY) + (((1.0 - HudCanvasScale) / 2.0) * Canvas.ClipY);
    ScreenY -= (InMessage.DY * 0.50);
    //return;    
}

function DrawTextWithOutLine(float XPos, float YPos, float OffsetX, float OffsetY, string TextToDraw, Color TextColor)
{
    Canvas.SetPos(XPos + OffsetX, YPos + OffsetY);
    Canvas.DrawColor = FontDSColor;
    Canvas.DrawColor.A *= Square(FadeAmount);
    Canvas.DrawText(TextToDraw);
    Canvas.SetPos(XPos, YPos);
    Canvas.DrawColor = TextColor;
    Canvas.DrawColor.A = byte(float(255) * FadeAmount);
    Canvas.DrawText(TextToDraw);
    //return;    
}

function string GetTimeString(float Seconds)
{
    return class'TdUtils'.static.FormatFloatTime(Seconds);
    //return ReturnValue;    
}

function string GetFormattedTime(int Time)
{
    local string StringTime;

    StringTime = string(Time);
    // End:0x24
    if(Time < 10)
    {
        return "0" $ StringTime;
    }
    return StringTime;
    //return ReturnValue;    
}

function DrawHUD()
{
    local TdGameReplicationInfo MyGRI;

    MyGRI = TdGameReplicationInfo(WorldInfo.GRI);
    PlayerOwner.DrawHUD(self);
    // End:0xD6
    if(MyGRI != none)
    {
        // End:0xCC
        if(WorldInfo.Pauser == none)
        {
            // End:0x6F
            if(MyGRI.bMatchIsInWarmup)
            {
                DrawWarmupHUD();
            }
            // End:0xC9
            else
            {
                // End:0xC9
                if(MyGRI.bMatchHasBegun)
                {
                    // End:0xBF
                    if(!PlayerOwner.IsDead() && PlayerOwner.Pawn != none)
                    {
                        DrawLivingHUD();
                    }
                    // End:0xC9
                    else
                    {
                        DrawDeadHUD();
                    }
                }
            }
        }
        // End:0xD6
        else
        {
            DrawPausedHUD();
        }
    }
    //return;    
}

