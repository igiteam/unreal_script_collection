class TdMove_BotPursuitFinishingAttack extends TdMove_BotMelee
    config(AIMeleeAttacks);

var() config MeleeAttackProperties FinishingAttackProperties;

simulated function TriggerMove()
{
    BotOwner.IgnoreMoveInput(true);
    BotOwner.myController.HeadFocus.PushEnabled(false, Class.Name);
    PlayMoveAnim(2, 'MeleeFinishStart', 1.0, 0.20, -1.0, true);
    BotOwner.UseRootMotion(true);
    BotOwner.UseRootRotation(false);
    BotOwner.CurrentRotationSpeed = 0;
    BotOwner.DirectionOfMovement = vector(BotOwner.Rotation);
    AttackProperties = FinishingAttackProperties;
    //return;    
}

simulated event StopMove()
{
    BotOwner.myController.HeadFocus.PopEnabled(Class.Name);
    super.StopMove();
    BotOwner.IgnoreMoveInput(false);
    BotOwner.UseRootRotation(false);
    BotOwner.UseRootMotion(false);
    BotOwner.myController.Freeze();
    BotOwner.myController.HeadFocus.PopEnabled(Class.Name);
    //return;    
}

simulated function TriggerMiss()
{
    PlayMoveAnim(2, 'MeleeFinishMiss', 1.0, 0.20, 0.20, true);
    BotOwner.UseRootMotion(true);
    BotOwner.UseRootRotation(false);
    //return;    
}

simulated function TriggerHit()
{
    SetTimer(3.0);
    BotOwner.UseRootMotion(false);
    BotOwner.UseRootRotation(false);
    //return;    
}

simulated function OnTimer()
{
    PawnOwner.SetMove(1);
    //return;    
}

simulated function bool TestHit()
{
    local TdMove_LayOnGround PlayerLayOnGroundMove;
    local TdPlayerPawn Player;

    Player = BotOwner.myController.Player;
    // End:0x51
    if(Player.MovementState == 35)
    {
        Player.SetMove(26);
    }
    PlayerLayOnGroundMove = TdMove_LayOnGround(Player.Moves[Player.MovementState]);
    // End:0xA4
    if((PlayerLayOnGroundMove != none) && !PlayerLayOnGroundMove.bIsDoingBackRoll)
    {
        return true;
    }
    // End:0xA6
    else
    {
        return false;
    }
    //return ReturnValue;    
}

defaultproperties
{
    FinishingAttackProperties=(HitAngle=0.0,HitRange=0.0,AttackHeightAdjustment=0.0,MissedAttackPenelty=0.0,Damage=700.0,AttackSpeed=1.0,RotationSpeed=0.0,RotationLimitAngle=0.0,HitDetectionStartTime=-1.0,PredictionTime=0.0,PredictionWeight=0.0,InvulnerableDamageTypes=none,bIsInterruptableByDodge=false)
    bEnableFootPlacement=false
}