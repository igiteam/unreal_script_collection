class UIDataProvider_TdOnlineFriends extends UIDataProvider_OnlineFriends
    transient
    native
    hidecategories(Object,UIRoot);

event OnRegister(LocalPlayer InPlayer)
{
    local OnlineSubsystem OnlineSub;
    local OnlinePlayerInterface PlayerInterface;

    super.OnRegister(InPlayer);
    // End:0x8F
    if(Player != none)
    {
        OnlineSub = class'GameEngine'.static.GetOnlineSubsystem();
        // End:0x8F
        if(OnlineSub != none)
        {
            PlayerInterface = OnlineSub.PlayerInterface;
            // End:0x8F
            if(NotEqual_InterfaceInterface(PlayerInterface, (none)))
            {
                PlayerInterface.AddFriendsChangeDelegate(byte(Player.ControllerId), OnFriendsChange);
            }
        }
    }
    //return;    
}

event OnUnregister()
{
    local OnlineSubsystem OnlineSub;
    local OnlinePlayerInterface PlayerInterface;

    OnlineSub = class'GameEngine'.static.GetOnlineSubsystem();
    // End:0x79
    if(OnlineSub != none)
    {
        PlayerInterface = OnlineSub.PlayerInterface;
        // End:0x79
        if(NotEqual_InterfaceInterface(PlayerInterface, (none)))
        {
            PlayerInterface.ClearFriendsChangeDelegate(byte(Player.ControllerId), OnFriendsChange);
        }
    }
    super.OnUnregister();
    //return;    
}

function OnFriendsChange()
{
    OnFriendsReadComplete(true);
    //return;    
}

defaultproperties
{
    NickNameCol="ONLINE ID"
}