class TdGameInfo extends GameInfo
    abstract
    native
    config(Game)
    hidecategories(Navigation,Movement,Collision);

struct native DefaultInvItem
{
    var name PawnClassName;
    var string InventoryClassName;
    var int Ammo;
    var int Clips;
    var Engine.Inventory.EInventorySlot Slot;

    structdefaultproperties
    {
        PawnClassName=None
        InventoryClassName=""
        Ammo=-2
        Clips=-2
        Slot=EISlot_None
    }
};

var bool ShowBulletTraces;
var const bool bAllowViewTargetSwitching;
