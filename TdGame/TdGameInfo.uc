function Killed(Controller Killer, Controller KilledPlayer, Pawn KilledPawn, class<DamageType> DamageType)
{
    local TdPlayerController TdKillerPC;
    local bool bMelee;

    bMelee = class<TdDmgType_Melee>(DamageType) != none;
    TdKillerPC = TdPlayerController(Killer);
    // End:0x78
    if((TdKillerPC != none) && bMelee)
    {
        // End:0x62
        if(DamageType == class'TdDmgType_MeleeDisarm')
        {
            TdKillerPC.AddStatsEvent(3);
        }
        // End:0x78
        else
        {
            TdKillerPC.AddStatsEvent(1);
        }
    }
    super.Killed(Killer, KilledPlayer, KilledPawn, DamageType);
    //return;    
}

