event Tick(float DeltaTime)
{
    // End:0x3C
    if(bIsInitialTick)
    {
        bIsInitialTick = false;
        ReadInitialWidgetValues();
        SetInitialWidgetValues();
        // End:0x3C
        if(ButtonFromSceneRestored == none)
        {
            SetActivePanel(0);
        }
    }
    UpdateSelectionField();
    PanelBGRenderer.Tick(DeltaTime);
    // End:0xB2
    if(FadeTimer <= (TimeToFadeStart + FadeTime))
    {
        FadeTimer += DeltaTime;
        DescriptionLabel.Opacity = FMin(FMax((FadeTimer - TimeToFadeStart) / FadeTime, 0.0), 1.0);
    }
    //return;    
}

function UpdateSelectionField()
{
    local float ScreenRegionTop, ScreenRegionBottom, ScreenRegionHeight, Top, Bottom;

    local UIObject FocusedObject;

    FocusedObject = GetFocusedControl(true);
    // End:0x117
    if((FocusedObject != none) && UIPanel(FocusedObject.GetOwner()) == PanelData[CurrentPanelIndex].Panel)
    {
        LastFocusedObject = FocusedObject;
        ScreenRegionTop = ScreenRegionPanel.GetPosition(1, 4);
        ScreenRegionBottom = ScreenRegionPanel.GetPosition(3, 4);
        ScreenRegionHeight = ScreenRegionBottom - ScreenRegionTop;
        Top = (FocusedObject.GetPosition(1, 4) - ScreenRegionTop) / ScreenRegionHeight;
        Bottom = (FocusedObject.GetPosition(3, 4) - ScreenRegionTop) / ScreenRegionHeight;
        PanelBGRenderer.SetSelectionFieldPos(CurrentPanelIndex, Top, Bottom);
    }
    //return;    
}

function ReadInitialWidgetValues()
{
    local int PanelIdx;
    local UIObject ObjectPtr;
    local float CaptionYPos, CaptionWidth, CaptionHeight, StickXPos;

    PanelIdx = 0;
    J0x07:
    // End:0x154 [Loop If]
    if(PanelIdx < 4)
    {
        ObjectPtr = PanelData[PanelIdx].PanelCaptionButton;
        // End:0x14A
        if(ObjectPtr != none)
        {
            CaptionHeight = ObjectPtr.GetPosition(3, 4) - ObjectPtr.GetPosition(1, 4);
            CaptionYPos = ObjectPtr.GetPosition(1, 4) + (CaptionHeight / 2.0);
            CaptionWidth = ObjectPtr.GetPosition(2, 4) - ObjectPtr.GetPosition(0, 4);
            StickXPos = ObjectPtr.GetPosition(0, 4) + (CaptionWidth / 2.0);
            PanelData[PanelIdx].DefaultCaptionYPos = CaptionYPos;
            PanelData[PanelIdx].DefaultCaptionWidth = CaptionWidth;
            PanelData[PanelIdx].StickPosX = StickXPos;
        }
        ++ PanelIdx;
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

event SetInitialWidgetValues()
{
    //return;    
}

function OnQuitGame()
{
    OpenMessageBox(OnQuitConfirm_MsgBoxInit);
    //return;    
}

private final function OnQuitConfirm_MsgBoxInit(UIScene OpenedScene, bool bInitialActivation)
{
    local string MessTitle, MessBody;

    MessTitle = "<Strings:TdGameUI.TdMessageBox.QuitConfirm_Title>";
    MessBody = "<Strings:TdGameUI.TdMessageBox.QuitConfirm_Message>";
    TdUIScene_MessageBox(OpenedScene).DisplayAcceptCancelBox(MessBody, MessTitle, OnQuitConfirmed);
    //return;    
}

private final function OnQuitConfirmed(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    // End:0x29
    if(!IsConsole() && SelectedOption == 1)
    {
        ConsoleCommand("quit");
    }
    //return;    
}

function SwitchTab(int Dir)
{
    local int NewPanelIndex;

    NewPanelIndex = Percent_IntInt((CurrentPanelIndex + Dir) + 4, 4);
    SetActivePanel(NewPanelIndex);
    //return;    
}

function SetActivePanel(int PanelIndex, optional bool Silent)
{
    local int I;

    // End:0x12
    if(PanelIndex == CurrentPanelIndex)
    {
        return;
    }
    // End:0x127
    if(PanelIndex != -1)
    {
        bIsAnimatingPanel = true;
        LastPanelIndex = CurrentPanelIndex;
        CurrentPanelIndex = PanelIndex;
        I = 0;
        J0x46:
        // End:0x8D [Loop If]
        if(I < 4)
        {
            PanelData[I].bIsFocusedPanel = false;
            SetPanelVisibility(I, false);
            SetCaptionVisibility(I, true);
            ++ I;
            // [Loop Continue]
            goto J0x46;
        }
        PanelData[CurrentPanelIndex].bIsFocusedPanel = true;
        PanelBGRenderer.SetActivePanel(CurrentPanelIndex, Silent);
        ActivateLevelEvent(name("panel" $ string(CurrentPanelIndex + 1)));
        DescriptionLabel.SetVisibility(PanelIndex < 2);
        FadeTimer = 0.0;
        // End:0x127
        if(!Silent)
        {
            PlayUISound('TabChangeRight');
        }
    }
    //return;    
}

function PanelAnimFinished(int FinishedPanelIndex, bool bPanelActive)
{
    // End:0x3C
    if(FinishedPanelIndex == CurrentPanelIndex)
    {
        SetPanelVisibility(FinishedPanelIndex, true);
        SetCaptionVisibility(FinishedPanelIndex, false);
        UpdateSelectionField();
        bIsAnimatingPanel = false;
    }
    // End:0x48
    else
    {
        SetCaptionVisibility(FinishedPanelIndex, true);
    }
    //return;    
}

private final function SetPanelVisibility(int PanelIndex, bool bVisible)
{
    local UIObject FocusedObject;

    FocusedObject = GetFocusedControl(true);
    // End:0x3C
    if(!bVisible && FocusedObject != none)
    {
        FocusedObject.KillFocus(none);
    }
    PanelData[PanelIndex].Panel.SetVisibility(bVisible);
    // End:0xD7
    if(bVisible)
    {
        // End:0xA5
        if(ButtonFromSceneRestored == none)
        {
            PanelData[PanelIndex].Panel.SetFocusToChild();
        }
        // End:0xD7
        else
        {
            ButtonFromSceneRestored.SetFocus(PanelData[PanelIndex].Panel);
            ButtonFromSceneRestored = none;
        }
    }
    //return;    
}

private final function SetCaptionVisibility(int PanelIndex, bool bVisible)
{
    PanelData[PanelIndex].PanelCaptionButton.SetVisibility(bVisible);
    PanelData[PanelIndex].BigPanelCaptionButton.SetVisibility(!bVisible);
    //return;    
}

function OnActivated(UIScene ActivatedScene, bool bInitialActivation)
{
    //return;    
}

function bool HandleInputKey(const out InputEventParameters EventParms)
{
    local bool bResult;

    // End:0x107
    if(EventParms.EventType == 0)
    {
        // End:0x8F
        if(((EventParms.InputKeyName == 'XboxTypeS_DPad_Right') || EventParms.InputKeyName == 'Gamepad_LeftStick_Right') || EventParms.InputKeyName == 'Right')
        {
            SwitchTab(1);
            bResult = true;
        }
        // End:0x104
        else
        {
            // End:0x104
            if(((EventParms.InputKeyName == 'XboxTypeS_DPad_Left') || EventParms.InputKeyName == 'Gamepad_LeftStick_Left') || EventParms.InputKeyName == 'Left')
            {
                SwitchTab(-1);
                bResult = true;
            }
        }
    }
    // End:0x1C1
    else
    {
        // End:0x1C1
        if(EventParms.EventType == 1)
        {
            // End:0x163
            if((EventParms.InputKeyName == 'XboxTypeS_Y') && !IsConsole())
            {
                OnShowFriends();
                bResult = true;
            }
            // End:0x1C1
            else
            {
                // End:0x1C1
                if(((EventParms.InputKeyName == 'XboxTypeS_X') || EventParms.InputKeyName == 'Escape') && !IsConsole())
                {
                    OnQuitGame();
                    bResult = true;
                }
            }
        }
    }
    return bResult;
    //return ReturnValue;    
}

