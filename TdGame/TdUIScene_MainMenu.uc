class TdUIScene_MainMenu extends TdUIScene
    native
    config(UI)
    hidecategories(Object,UIRoot,Object);

enum ETdMainMenuPanel
{
    TDMMP_STORY,
    TDMMP_TIMETRIAL,
    TDMMP_OPTIONS,
    TDMMP_EXTRAS,
    TDMMP_MAX
};

struct native TdMainMenuPanelStruct
{
    var UIPanel Panel;
    var UIImage BgImage;
    var UIButton PanelCaptionButton;
    var UIButton BigPanelCaptionButton;
    var bool bIsFocusedPanel;
    var float AnimTime;
    var float DefaultCaptionYPos;
    var float DefaultCaptionWidth;
    var float StickPosX;

    structdefaultproperties
    {
        Panel=none
        BgImage=none
        PanelCaptionButton=none
        BigPanelCaptionButton=none
        bIsFocusedPanel=false
        AnimTime=0.0
        DefaultCaptionYPos=0.0
        DefaultCaptionWidth=0.0
        StickPosX=0.0
    }
};

var transient UISafeRegionPanel SafeRegionPanel;
var transient UISafeRegionPanel ScreenRegionPanel;
var name PanelNames[4];
var name PanelBgNames[4];
var name CaptionNames[4];
var name BigCaptionNames[4];
var transient TdOnlineLoginHandler LoginHandler;
var bool bIsAnimatingPanel;
var private bool bIsInitialTick;
var config bool bShowDownloadsButton;
var transient UIObject LastFocusedObject;
var TdMainMenuPanelStruct PanelData[4];
var int CurrentPanelIndex;
var int LastPanelIndex;
var float DefaultStickWidth;
var transient UILabel DescriptionLabel;
var transient float TimeToFadeStart;
var transient float FadeTime;
var transient float FadeTimer;
var transient TdMenuPostProcesWrapper PanelBGRenderer;
var transient UIButton ButtonFromSceneRestored;

event PostInitialize()
{
    local int PanelIndex;
    local array<UIImage> BgImages;

    super.PostInitialize();
    __OnSceneActivated__Delegate = OnActivated;
    CurrentPanelIndex = -1;
    LastPanelIndex = -1;
    // End:0x11F
    if(IsGame())
    {
        InitializeWidgetsData();
        PanelIndex = 0;
        J0x49:
        // End:0x7D [Loop If]
        if(PanelIndex < 4)
        {
            BgImages.AddItem(PanelData[PanelIndex].BgImage);
            ++ PanelIndex;
            // [Loop Continue]
            goto J0x49;
        }
        PanelBGRenderer = new class'TdMenuPostProcesWrapper';
        PanelBGRenderer.Initialize(BgImages, PanelAnimFinished);
        LoginHandler = new class'TdOnlineLoginHandler';
        LoginHandler.Initialize(TdGameUISceneClient(class'UIRoot'.static.GetSceneClient()), GetPlayerOwner());
        UpdateGamepadSettingVis(GetOnlineSubsystem().SystemInterface.IsControllerConnected(0));
    }
    //return;    
}

function InitializeWidgetsData()
{
    local UIPanel CurrentPanel;
    local UILabelButton CurrentButton;
    local int PanelIdx, ButtonIndex;
    local TdProfileSettings Profile;

    PanelIdx = 0;
    J0x07:
    // End:0x3E5 [Loop If]
    if(PanelIdx < 4)
    {
        PanelData[PanelIdx].Panel = UIPanel(FindChild(PanelNames[PanelIdx], true));
        PanelData[PanelIdx].BgImage = UIImage(FindChild(PanelBgNames[PanelIdx], true));
        PanelData[PanelIdx].PanelCaptionButton = UIButton(FindChild(CaptionNames[PanelIdx], true));
        PanelData[PanelIdx].BigPanelCaptionButton = UIButton(FindChild(BigCaptionNames[PanelIdx], true));
        CurrentPanel = PanelData[PanelIdx].Panel;
        ButtonIndex = 0;
        J0xEE:
        // End:0x3DB [Loop If]
        if(ButtonIndex < CurrentPanel.Children.Length)
        {
            CurrentButton = UILabelButton(CurrentPanel.Children[ButtonIndex]);
            // End:0x3D1
            if(CurrentButton != none)
            {
                CurrentButton.__OnClicked__Delegate = OnPanelButton_Clicked;
                CurrentButton.SetVisibility(true);
                CurrentButton.__NotifyActiveStateChanged__Delegate = ButtonStateChange;
                // End:0x21B
                if(((CurrentButton.Name == 'DownloadsButton') || CurrentButton.Name == 'XBoxAchievementsButton') && !IsConsole(1) || GetLoginStatus(GetPlayerOwner().ControllerId) == 0)
                {
                    CurrentButton.SetVisibility(false);
                    CurrentButton.SetEnabled(false);
                    // [Explicit Continue]
                    goto J0x3D1;
                }
                // End:0x273
                if((CurrentButton.Name == 'DownloadsButton') && !bShowDownloadsButton)
                {
                    CurrentButton.SetVisibility(false);
                    CurrentButton.SetEnabled(false);
                    // [Explicit Continue]
                    goto J0x3D1;
                }
                // End:0x2CD
                if(CurrentButton.Name == 'LoadGameButton')
                {
                    // End:0x2CA
                    if(!CanContinueGame())
                    {
                        CurrentButton.SetVisibility(false);
                        CurrentButton.SetEnabled(false);
                    }
                    // [Explicit Continue]
                    goto J0x3D1;
                }
                // End:0x351
                if(CurrentButton.Name == 'LoadLevelButton')
                {
                    Profile = GetProfileSettings();
                    // End:0x34E
                    if((Profile != none) && !Profile.IsLevelUnlocked(0))
                    {
                        CurrentButton.SetVisibility(false);
                        CurrentButton.SetEnabled(false);
                    }
                    // [Explicit Continue]
                    goto J0x3D1;
                }
                // End:0x3D1
                if(CurrentButton.Name == 'LevelRaceButton')
                {
                    Profile = GetProfileSettings();
                    // End:0x3D1
                    if((Profile != none) && !Profile.IsAllLevelsUnlocked())
                    {
                        CurrentButton.SetVisibility(false);
                        CurrentButton.SetEnabled(false);
                    }
                }
            }
            J0x3D1:
            ++ ButtonIndex;
            // [Loop Continue]
            goto J0xEE;
        }
        ++ PanelIdx;
        // [Loop Continue]
        goto J0x07;
    }
    PanelData[0].PanelCaptionButton.__OnClicked__Delegate = OnButtonClicked_Panel0;
    PanelData[1].PanelCaptionButton.__OnClicked__Delegate = OnButtonClicked_Panel1;
    PanelData[2].PanelCaptionButton.__OnClicked__Delegate = OnButtonClicked_Panel2;
    PanelData[3].PanelCaptionButton.__OnClicked__Delegate = OnButtonClicked_Panel3;
    //return;    
}

function ButtonStateChange(UIScreenObject Sender, int PlayerIndex, UIState NewlyActiveState, optional UIState PreviouslyActiveState)
{
    // End:0x1C
    if(UIState_Focused(NewlyActiveState) != none)
    {
        FadeTimer = 0.0;
    }
    //return;    
}

function SetupButtonBar()
{
    // End:0x14
    if(IsConsole())
    {
        UpdateButtonBar(true);
    }
    // End:0x3F
    else
    {
        UpdateButtonBar(GetOnlineSubsystem().SystemInterface.IsControllerConnected(0));
    }
    //return;    
}

private final function UpdateButtonBar(bool bAcceptVisible)
{
    ButtonBar.ClearButtons();
    // End:0x42
    if(bAcceptVisible)
    {
        ButtonBar.AppendButton("Accept", None);
    }
    // End:0x97
    if(!IsConsole())
    {
        ButtonBar.AppendButton("Friends", OnButtonBar_ShowFriends);
        ButtonBar.AppendButton("Quit", OnButtonBar_QuitGame);
    }
    //return;    
}

function UpdateGamepadSettingVis(bool bIsVisible)
{
    local UIObject Object, ParentObject;
    local bool bWasFocused;

    Object = FindChild('GamepadButton', true);
    // End:0xCA
    if(Object != none)
    {
        bWasFocused = Object.IsFocused();
        Object.SetVisibility(bIsVisible);
        Object.SetEnabled(bIsVisible);
        // End:0xCA
        if(bWasFocused)
        {
            ParentObject = Object.GetOwner();
            // End:0xCA
            if(ParentObject.IsA('UIPanel'))
            {
                ParentObject.SetFocusToChild(FindChild('VideoButton', true));
            }
        }
    }
    //return;    
}

function OnControllerChange(int ControllerId, bool Connected)
{
    super.OnControllerChange(ControllerId, Connected);
    // End:0x46
    if(!IsConsole() && ControllerId == 0)
    {
        UpdateGamepadSettingVis(Connected);
        UpdateButtonBar(Connected);
    }
    //return;    
}

function bool OnButtonBar_ShowFriends(UIScreenObject Sender, int PlayerIndex)
{
    OnShowFriends();
    return true;
    //return ReturnValue;    
}

function bool OnButtonBar_QuitGame(UIScreenObject Sender, int PlayerIndex)
{
    OnQuitGame();
    return true;
    //return ReturnValue;    
}

function bool OnPanelButton_Clicked(UIScreenObject Sender, int PlayerIndex)
{
    return HandleButtonClicked(UILabelButton(Sender));
    //return ReturnValue;    
}

event SceneActivated(bool bInitialActivation)
{
    local UIDataStore_TdGameData GameDataStore;

    super.SceneActivated(bInitialActivation);
    // End:0x44
    if(!LoginHandler.IsInLoginProcess())
    {
        ActivateLevelEvent(name("panel" $ string(CurrentPanelIndex + 1)));
    }
    GameDataStore = GetGameDataStore();
    // End:0x8E
    if(bInitialActivation)
    {
        switch(GameDataStore.RebootReason)
        {
            // End:0x8B
            case 3:
                OpenMessageBox(ConnectionLost_MsgBoxInit);
                // End:0x8E
                break;
            // End:0xFFFF
            default:
            }
            //return;            
}

function ConnectionLost_MsgBoxInit(UIScene OpenedScene, bool bInitialActivation)
{
    local string ErrorMsg;
    local TpSystemBase SystemBase;

    // End:0x45
    if(IsConsole(2))
    {
        ErrorMsg = Localize("Errors", "Ps3_Connection_Lost", "TdGameUI");
    }
    // End:0xB7
    else
    {
        SystemBase = class'TpSystemBase'.static.Get();
        ErrorMsg = (SystemBase.GetLatestError().LocErrorString $ " ") $ (Localize("Errors", "Return_To_Menu", "TdGameUI"));
    }
    TdUIScene_MessageBox(OpenedScene).DisplayAcceptBox(ErrorMsg, "<Strings:TdGameUI.Errors.Critical_Error>", OnRebootErrorMessageCallback);
    //return;    
}

private final function OnRebootErrorMessageCallback(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    GetGameDataStore().RebootReason = 0;
    //return;    
}

event SceneDeactivated()
{
    super.SceneDeactivated();
    PanelBGRenderer.Destroy();
    LoginHandler.Finalize();
    LoginHandler = none;
    //return;    
}

function SceneSavedForRestore()
{
    local UIObject FocusedObject;
    local UIDataStore_TdGameData GameDataStore;

    GameDataStore = GetGameDataStore();
    FocusedObject = GetFocusedControl(true);
    GameDataStore.RestoredMenuSerialized = (("?MainMenuPanel=" $ string(CurrentPanelIndex)) $ "?MainMenuActiveObject=") $ string(FocusedObject.Name);
    //return;    
}

function SceneRestored()
{
    local string Serialized, StoredFocusedObjectName;
    local int StoredPanelIndex;

    Serialized = GetGameDataStore().RestoredMenuSerialized;
    StoredPanelIndex = int(ParseOption(Serialized, "MainMenuPanel"));
    SetActivePanel(StoredPanelIndex, true);
    StoredFocusedObjectName = ParseOption(Serialized, "MainMenuActiveObject");
    ButtonFromSceneRestored = UIButton(FindChild(name(StoredFocusedObjectName), true));
    //return;    
}

function bool HandleButtonClicked(UILabelButton InButton)
{
    local bool bResult;

    // End:0x31F
    if(!bIsAnimatingPanel)
    {
        ActivateLevelEvent(name(string(InButton.Name) $ "_Clicked"));
        // End:0x66
        if(InButton.Name == 'NewGameButton')
        {
            OnStartGame();
            bResult = true;
        }
        // End:0x31F
        else
        {
            // End:0x98
            if(InButton.Name == 'LoadLevelButton')
            {
                OnLoadLevel();
                bResult = true;
            }
            // End:0x31F
            else
            {
                // End:0xCA
                if(InButton.Name == 'LoadGameButton')
                {
                    OnLoadSaveGame();
                    bResult = true;
                }
                // End:0x31F
                else
                {
                    // End:0xFC
                    if(InButton.Name == 'TimeTrialOnlineButton')
                    {
                        OnTimeTrialRace();
                        bResult = true;
                    }
                    // End:0x31F
                    else
                    {
                        // End:0x12E
                        if(InButton.Name == 'LevelRaceButton')
                        {
                            OnLevelRace();
                            bResult = true;
                        }
                        // End:0x31F
                        else
                        {
                            // End:0x160
                            if(InButton.Name == 'LeaderboardsButton')
                            {
                                OnTimeTrialLeaderboard();
                                bResult = true;
                            }
                            // End:0x31F
                            else
                            {
                                // End:0x192
                                if(InButton.Name == 'ControlsButton')
                                {
                                    OnControlsSettings();
                                    bResult = true;
                                }
                                // End:0x31F
                                else
                                {
                                    // End:0x1C4
                                    if(InButton.Name == 'AudioButton')
                                    {
                                        OnAudioSettings();
                                        bResult = true;
                                    }
                                    // End:0x31F
                                    else
                                    {
                                        // End:0x1F6
                                        if(InButton.Name == 'VideoButton')
                                        {
                                            OnVideoSettings();
                                            bResult = true;
                                        }
                                        // End:0x31F
                                        else
                                        {
                                            // End:0x228
                                            if(InButton.Name == 'GameSettingsButton')
                                            {
                                                OnGameSettings();
                                                bResult = true;
                                            }
                                            // End:0x31F
                                            else
                                            {
                                                // End:0x25A
                                                if(InButton.Name == 'GamepadButton')
                                                {
                                                    OnGamepadSettings();
                                                    bResult = true;
                                                }
                                                // End:0x31F
                                                else
                                                {
                                                    // End:0x28C
                                                    if(InButton.Name == 'DownloadsButton')
                                                    {
                                                        OnDownloads();
                                                        bResult = true;
                                                    }
                                                    // End:0x31F
                                                    else
                                                    {
                                                        // End:0x2BE
                                                        if(InButton.Name == 'XBoxAchievementsButton')
                                                        {
                                                            OnAchievements();
                                                            bResult = true;
                                                        }
                                                        // End:0x31F
                                                        else
                                                        {
                                                            // End:0x2F0
                                                            if(InButton.Name == 'UnlocksButton')
                                                            {
                                                                OnUnlocks();
                                                                bResult = true;
                                                            }
                                                            // End:0x31F
                                                            else
                                                            {
                                                                // End:0x31F
                                                                if(InButton.Name == 'CreditsButton')
                                                                {
                                                                    OnCredits();
                                                                    bResult = true;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // End:0x33D
    if(bResult)
    {
        PlayUISound('Accept', GetPlayerIndex());
    }
    return bResult;
    //return ReturnValue;    
}

function OnStartGame()
{
    // End:0x3D
    if(GetGameDataStore().CheckpointManager.CanContinueGame())
    {
        OpenMessageBox(OnStartGame_MsgBoxInit);
    }
    // End:0x48
    else
    {
        OpenNewGameScene(false);
    }
    //return;    
}

private final function OnStartGame_MsgBoxInit(UIScene OpenedScene, bool bInitialActivation)
{
    TdUIScene_MessageBox(OpenedScene).DisplayAcceptCancelBox("<Strings:TdGameUI.TdMessageBox.NewGameWarningMessage>", "<Strings:TdGameUI.TdMessageBox.NewGameWarningTitle>", OnNewGameWarning_Callback, false);
    TdUIScene_MessageBox(OpenedScene).__OnNotifyOptionSelected__Delegate = OnNewGameWarning_PreCallback;
    //return;    
}

private final function OnNewGameWarning_PreCallback(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    // End:0x1D
    if(SelectedOption == 1)
    {
        MessageBox.SceneTransitionAnimOveride = 1;
    }
    //return;    
}

private final function OnNewGameWarning_Callback(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    // End:0x16
    if(SelectedOption == 1)
    {
        OpenNewGameScene(true);
    }
    //return;    
}

function OpenNewGameScene(bool bSkipPrevSceneAnim)
{
    OpenScene(class'TdHUDContent'.static.GetUISceneByName('TdDifficultySettings', "TdMenuContent.TdHUDContentMainMenu"), ((bSkipPrevSceneAnim) ? 2 : 0));
    //return;    
}

function OnLoadLevel()
{
    OpenScene(class'TdHUDContent'.static.GetUISceneByName('TdLoadLevel', "TdMenuContent.TdHUDContentMainMenu"));
    //return;    
}

function OnLoadSaveGame()
{
    local string MapName, CheckpointName;
    local UIDataStore_TdGameData GameData;

    GameData = UIDataStore_TdGameData(FindDataStore('TdGameData'));
    // End:0x79
    if((GameData != none) && GameData.CheckpointManager.GetContinueGame(MapName, CheckpointName))
    {
        GameData.StartGame(MapName, CheckpointName,,, true, true);
    }
    //return;    
}

function bool CanContinueGame()
{
    local UIDataStore_TdGameData GameData;

    GameData = UIDataStore_TdGameData(FindDataStore('TdGameData'));
    // End:0x49
    if(GameData != none)
    {
        return GameData.CheckpointManager.CanContinueGame();
    }
    return false;
    //return ReturnValue;    
}

function OnTimeTrialRace()
{
    LoginHandler.__OnConnectedAndFriendsLoaded__Delegate = OpenTimeTrialSceneCallback;
    LoginHandler.__OnPlayOffline__Delegate = OpenTimeTrialOfflineSceneCallback;
    LoginHandler.StartConnection(false);
    LoginHandler.SetLocalUserNum(GetPlayerOwner().ControllerId);
    //return;    
}

function OnLevelRace()
{
    LoginHandler.__OnConnectedAndFriendsLoaded__Delegate = OpenLevelRaceSceneCallback;
    LoginHandler.__OnPlayOffline__Delegate = OpenLevelRaceOfflineSceneCallback;
    LoginHandler.StartConnection(false);
    LoginHandler.SetLocalUserNum(GetPlayerOwner().ControllerId);
    //return;    
}

function OnTimeTrialLeaderboard()
{
    LoginHandler.__OnConnectedAndFriendsLoaded__Delegate = OpenLeaderboardSceneCallback;
    LoginHandler.StartConnection(true);
    LoginHandler.SetLocalUserNum(GetPlayerOwner().ControllerId);
    //return;    
}

function OnShowFriends()
{
    ActivateLevelEvent('FriendsButton_Clicked');
    // End:0x2B
    if(IsConsole())
    {
        ShowFriendsScene();
    }
    // End:0x7E
    else
    {
        LoginHandler.__OnConnectedAndFriendsLoaded__Delegate = OnShowFriendsScene_Callback;
        LoginHandler.StartConnection(true);
        LoginHandler.SetLocalUserNum(GetPlayerOwner().ControllerId);
    }
    //return;    
}

function OnShowFriendsScene_Callback(Engine.UIScene.ESceneTransitionAnim SceneAnim)
{
    ShowFriendsScene(SceneAnim);
    //return;    
}

