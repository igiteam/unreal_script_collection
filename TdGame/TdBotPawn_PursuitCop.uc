function bool ShouldMeleeCauseStumbleFar()
{
    // End:0x21
    if(TdAI_Pursuit(myController).PendingMeleeAttack == 3)
    {
        return false;
    }
    return true;
    //return ReturnValue;    
}

function TakeDamage(int Damage, Controller InstigatedBy, Vector HitLocation, Vector damageMomentum, class<DamageType> DamageType, optional TraceHitInfo HitInfo, optional Actor DamageCauser)
{
    super.TakeDamage(Damage, InstigatedBy, HitLocation, damageMomentum, DamageType, HitInfo, DamageCauser);
    myController.LastStumbleTime = WorldInfo.TimeSeconds;
    //return;    
}

function bool IsDoingSpecialMove()
{
    return ((((((((((MovementState == 8) || MovementState == 9) || MovementState == 11) || MovementState == 10) || MovementState == 16) || MovementState == 67) || MovementState == 40) || MovementState == 64) || MovementState == 65) || MovementState == 66) || MovementState == 68;
    //return ReturnValue;    
}

