class TdRobberStashpoint extends TdStashpoint
    config(Game)
    placeable
    hidecategories(Navigation);

auto state Idle
{
    ignores CompleteStashing;
    stop;    
}

state Stashing
{
    ignores InitiateStashing;

Begin:
    TimeOfStashingInitiated = WorldInfo.TimeSeconds;
    SetTimer(1.0, true, 'NotifyProgressed');
    stop;                
}

defaultproperties
{
    TerritoryOfTeam=0
    begin object name=CollisionCylinder class=CylinderComponent
        CollisionHeight=100.0
        CollisionRadius=300.0
        CollideActors=true
    object end
    // Reference: CylinderComponent'Default__TdRobberStashpoint.CollisionCylinder'
    Components(0)=CollisionCylinder
    begin object name=StaticMeshComponent0 class=StaticMeshComponent
        bOverrideLightMapResolution=false
        HiddenGame=true
        CastShadow=false
        LightingChannels=(bInitialized=true,Static=true,Dynamic=true)
        CollideActors=false
        BlockRigidBody=false
        RBChannel=RBCC_GameplayPhysics
    object end
    // Reference: StaticMeshComponent'Default__TdRobberStashpoint.StaticMeshComponent0'
    Components(1)=StaticMeshComponent0
    begin object name=CollisionCylinder class=CylinderComponent
        CollisionHeight=100.0
        CollisionRadius=300.0
        CollideActors=true
    object end
    // Reference: CylinderComponent'Default__TdRobberStashpoint.CollisionCylinder'
    CollisionComponent=CollisionCylinder
}