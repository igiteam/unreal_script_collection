function SetStretchId(int InStretchId)
{
    local int Idx;
    local string Key;

    StretchId = InStretchId;
    IdToStatKeyMappings.Remove(0, IdToStatKeyMappings.Length);
    IdToStatKeyMappings.Add(Properties.Length);
    Idx = 0;
    J0x2B:
    // End:0x106 [Loop If]
    if(Idx < Properties.Length)
    {
        // End:0x8E
        if(Properties[Idx].PropertyId >= 20)
        {
            Key = (("TD_" $ string(StretchId)) $ "_") $ string(Properties[Idx].PropertyId);
        }
        // End:0xB3
        else
        {
            Key = "TD_" $ string(Properties[Idx].PropertyId);
        }
        IdToStatKeyMappings[Idx].StatId = Properties[Idx].PropertyId;
        IdToStatKeyMappings[Idx].StatKey = Key;
        ++ Idx;
        // [Loop Continue]
        goto J0x2B;
    }
    //return;    
}
