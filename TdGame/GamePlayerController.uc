class GamePlayerController extends PlayerController
    abstract
    native
    config(Game)
    hidecategories(Navigation);

// Export UGamePlayerController::execGetChapterStrings(FFrame&, void* const)
native function GetChapterStrings(int eChapter, out string ChapterName, out string ActName);

simulated function DisplayChapterTitle(int DisplayChapter, float TotalDisplayTime, float TotalFadeTime)
{
    ClientDisplayChapterTitle(DisplayChapter, TotalDisplayTime, TotalFadeTime);
    //return;    
}

reliable client simulated function ClientDisplayChapterTitle(int DisplayChapter, float TotalDisplayTime, float TotalFadeTime)
{
    local string ChapterName, ActName;

    // End:0x51
    if(myHUD != none)
    {
        GetChapterStrings(DisplayChapter, ChapterName, ActName);
        GameHUD(myHUD).StartDrawingChapterTitle(ChapterName, ActName, TotalDisplayTime, TotalFadeTime);
    }
    //return;    
}

defaultproperties
{
    CylinderComponent=CylinderComponent'Default__GamePlayerController.CollisionCylinder'
    Components(0)=SpriteComponent'Default__GamePlayerController.Sprite'
    Components(1)=CylinderComponent'Default__GamePlayerController.CollisionCylinder'
    CollisionComponent=CylinderComponent'Default__GamePlayerController.CollisionCylinder'
}