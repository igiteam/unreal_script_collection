class TdEmoteMessage extends TdLocalMessage;

var SoundCue VOTaunt[2];
var SoundCue VONeedAssistance[2];
var SoundCue VOPraise[2];

static simulated function SoundCue Get3DAnnouncementSound(optional int Switch, optional PlayerReplicationInfo AnnouncerPRI, optional PlayerReplicationInfo OtherPRI)
{
    // End:0x86
    if(AnnouncerPRI != none)
    {
        switch(Switch)
        {
            // End:0x3A
            case 0:
                return default.VOTaunt[AnnouncerPRI.Team.TeamIndex];
            // End:0x5E
            case 1:
                return default.VONeedAssistance[AnnouncerPRI.Team.TeamIndex];
            // End:0x83
            case 2:
                return default.VOPraise[AnnouncerPRI.Team.TeamIndex];
            // End:0xFFFF
            default:
            }
            //return ReturnValue;            
}
