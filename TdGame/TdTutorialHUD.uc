class TdTutorialHUD extends TdSPHUD
    transient
    config(Game)
    hidecategories(Navigation);

var(HUDIcons) Vector2D RaceTimerPos;
var(HUDIcons) Vector2D TutorialInfoPos;
var transient UIScene TutorialMessageScene;

function LoadHUDContent(class<TdHUDContent> ContentClass)
{
    super.LoadHUDContent(ContentClass);
    PauseSceneRef = ContentClass.static.GetUISceneByName('TdTutorialPause');
    TutorialMessageScene = ContentClass.static.GetUISceneByName('TutorialMessage');
    InGameMenuRef = ContentClass.static.GetUISceneByName('TdChallengeObjectives');
    //return;    
}

function DrawLivingHUD()
{
    super.DrawLivingHUD();
    //return;    
}

defaultproperties
{
    RaceTimerPos=(X=50.0,Y=20.0)
    TutorialInfoPos=(X=640.0,Y=500.0)
    bDisplayGameMessages=true
    HUDContentClassName="TdTuContent.TdHUDContentTutorial"
}