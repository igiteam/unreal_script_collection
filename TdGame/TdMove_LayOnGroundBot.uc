class TdMove_LayOnGroundBot extends TdMove
    config(PawnMovement);

var float LayDownIdleTime;

function bool CanDoMove()
{
    return true;
    //return ReturnValue;    
}

simulated function StartMove()
{
    super.StartMove();
    SetTimer(LayDownIdleTime);
    //return;    
}

simulated function StopMove()
{
    super.StopMove();
    PawnOwner.EnableWeaponPose();
    //return;    
}

simulated function OnTimer()
{
    PlayMoveAnim(0, name("GroundToStand"), 1.0, 0.10, 0.10);
    PawnOwner.SetAnimationMovementState(1, 0.20);
    //return;    
}

simulated function OnCustomAnimEnd(AnimNodeSequence SeqNode, float PlayedTime, float ExcessTime)
{
    PawnOwner.SetMove(1);
    //return;    
}

defaultproperties
{
    LayDownIdleTime=0.250
}