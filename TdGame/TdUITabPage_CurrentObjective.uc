function LinkSceneWidgets()
{
    local int SubObjectiveIndex;

    SubObjectiveIndex = 0;
    J0x07:
    // End:0xA1 [Loop If]
    if(SubObjectiveIndex < 4)
    {
        SubObjectivesWidgets[SubObjectiveIndex].Label = UILabel(FindChild(name("SubObjectiveLabel_" $ string(SubObjectiveIndex)), true));
        SubObjectivesWidgets[SubObjectiveIndex].Image = UIImage(FindChild(name("SubObjectiveImage_" $ string(SubObjectiveIndex)), true));
        ++ SubObjectiveIndex;
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

function ReadSubObjectiveData()
{
    local array<SubObjectiveStruct> SubObjectives;
    local int SubObjectiveIndex;
    local name FieldName;

    // End:0x158
    if(TdGameObjectivesData != none)
    {
        FieldName = TdUIScene_ObjectivesScene(GetScene()).ObjectivesToReadFieldName;
        TdGameObjectivesData.GetSubObjectives(FieldName, SubObjectives, true);
        SubObjectiveIndex = 0;
        J0x4C:
        // End:0x158 [Loop If]
        if(SubObjectiveIndex < 4)
        {
            SubObjectivesWidgets[SubObjectiveIndex].Label.SetVisibility(false);
            SubObjectivesWidgets[SubObjectiveIndex].Image.SetVisibility(false);
            // End:0x14E
            if(SubObjectiveIndex < SubObjectives.Length)
            {
                SubObjectivesWidgets[SubObjectiveIndex].Label.SetDataStoreBinding(SubObjectives[SubObjectiveIndex].FriendlyName);
                SubObjectivesWidgets[SubObjectiveIndex].Label.SetVisibility(true);
                SubObjectivesWidgets[SubObjectiveIndex].Image.SetVisibility(SubObjectives[SubObjectiveIndex].bIsFinished);
            }
            ++ SubObjectiveIndex;
            // [Loop Continue]
            goto J0x4C;
        }
    }
    //return;    
}

