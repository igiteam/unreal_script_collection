simulated function StopMove()
{
    super.StopMove();
    RootOffset = default.RootOffset;
    // End:0x65
    if(TdMove_Grab(PawnOwner.Moves[3]).CurrentFoldedType != 1)
    {
        TdMove_Grab(PawnOwner.Moves[3]).SetCurrentFoldedType(0);
    }
    // End:0xC6
    if(PawnOwner.PendingMovementState != 3)
    {
        // End:0xC6
        if(TdMove_Grab(PawnOwner.Moves[3]).CurrentFoldedType == 1)
        {
            PawnOwner.StopCustomAnim(2, 0.20);
        }
    }
    bPrepareToGrab = false;
    //return;    
}

