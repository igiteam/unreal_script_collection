class TdWeaponPickupFactory extends PickupFactory
    hidecategories(Navigation,Lighting,LightColor,Force);

var() repnotify class<TdWeapon> WeaponPickupClass;

replication
{
    // Pos:0x000
    if((Role == ROLE_Authority) && bNetInitial)
        WeaponPickupClass
}

simulated function PreBeginPlay()
{
    super.PreBeginPlay();
    PickupClassChanged();
    //return;    
}

simulated function PickupClassChanged()
{
    InventoryType = WeaponPickupClass;
    //return;    
}

simulated event ReplicatedEvent(name VarName)
{
    // End:0x2A
    if(VarName == 'WeaponPickupClass')
    {
        PickupClassChanged();
        SetPickupMesh();
    }
    // End:0x35
    else
    {
        super.ReplicatedEvent(VarName);
    }
    //return;    
}

defaultproperties
