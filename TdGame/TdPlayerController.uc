        {
            DelayedPauseGame();
        }
    }
    //return;    
}

function OnExternalUIChanged(bool bIsOpening)
{
    local GameUISceneClient SceneClient;

    SceneClient = class'UIRoot'.static.GetSceneClient();
    // End:0x42
    if(WorldInfo.IsConsoleBuild(2))
    {
        SceneClient.bInputIntercepted = bIsOpening;
    }
    SceneClient.ActivateBGSaturation(bIsOpening, 2);
    bIsExternalUIOpen = bIsOpening;
    // End:0x8F
    if(bIsOpening && !IsInMainMenu())
    {
        DelayedPauseGame();
    }
    //return;    
}

