function OnLRCompleted(TdTTResult OnlineResult, TdTTResult OfflineResult)
{
    local DataStoreClient DataStoreManager;
    local UIDataStore_TdTimeTrialData TimeTrialData;
    local int ProviderIndex;

    // End:0xDF
    if(((OnlineResult != none) && OnlineResult.bBeatQualifyerTime) || OfflineResult.bBeatQualifyerTime)
    {
        DataStoreManager = class'UIInteraction'.static.GetDataStoreClient();
        // End:0xDF
        if(DataStoreManager != none)
        {
            TimeTrialData = UIDataStore_TdTimeTrialData(DataStoreManager.FindDataStore('TdTimeTrialData'));
            // End:0xDF
            if(TimeTrialData != none)
            {
                ProviderIndex = TimeTrialData.GetStretchProviderIndexFromId(TimeTrialData.GetCurrentWorkingStretchId(), 'TdLevelRaceStretches');
                // End:0xDF
                if(ProviderIndex != -1)
                {
                    UnlockAchievement(16 + ProviderIndex);
                }
            }
        }
    }
    //return;    
}

function OnTTStretchCompleted(TdTTResult OnlineResult, TdTTResult OfflineResult)
{
    // End:0x5D
    if(((OnlineResult != none) && OnlineResult.CurrentTime.TotalRating >= 50) || OfflineResult.CurrentTime.TotalRating >= 50)
    {
        UnlockAchievement(15);
    }
    // End:0xBA
    if(((OnlineResult != none) && OnlineResult.CurrentTime.TotalRating >= 35) || OfflineResult.CurrentTime.TotalRating >= 35)
    {
        UnlockAchievement(14);
    }
    // End:0x117
    if(((OnlineResult != none) && OnlineResult.CurrentTime.TotalRating >= 20) || OfflineResult.CurrentTime.TotalRating >= 20)
    {
        UnlockAchievement(13);
    }
    // End:0x158
    if(((OnlineResult != none) && OnlineResult.bBeatQualifyerTime) || OfflineResult.bBeatQualifyerTime)
    {
        UnlockAchievement(10);
    }
    // End:0x180
    if(GetProfileSettings().IsAllTTStretchesUnlocked())
    {
        UnlockAchievement(12);
    }
    //return;    
}

function UnlockAchievement(int AchievementId)
{
    local SeqAct_TdUnlockAchievement.ETdAchievements TempEnum;
    local string NameOfEnum;

    TempEnum = byte(AchievementId);
    NameOfEnum = "Achievement unlocked: " @ string(TempEnum);
    ClientUnlockAchievement(AchievementId, NameOfEnum);
    //return;    
}

