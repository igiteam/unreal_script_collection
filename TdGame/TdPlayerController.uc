function NotifyWeaponFired(Weapon PlayerWeapon)
{
    local int Index;
    local SeqEvt_TdWeaponFired WeaponFiredEvent;

    Index = 0;
    J0x07:
    // End:0xDB [Loop If]
    if(Index < WeaponFiredEvents.Length)
    {
        WeaponFiredEvent = WeaponFiredEvents[Index];
        // End:0x36
        if(WeaponFiredEvent == none)
        {
            // [Explicit Continue]
            goto J0xD1;
        }
        // End:0x76
        if((WeaponFiredEvent.ConditionalWeaponClass != none) && !ClassIsChildOf(PlayerWeapon.Class, WeaponFiredEvent.ConditionalWeaponClass))
        {
            // [Explicit Continue]
            goto J0xD1;
        }
        // End:0xB8
        if((WeaponFiredEvent.ConditionalVolume != none) && !myPawn.IsTouchingVolume(WeaponFiredEvent.ConditionalVolume))
        {
