function bool ViewAPlayer(int Dir)
{
    local TdPlayerPawn PlayerPawn;
    local bool bSuccess;

    bSuccess = super(PlayerController).ViewAPlayer(Dir);
    // End:0xC4
    if(!bSuccess)
    {
        PlayerPawn = TdPlayerPawn(WorldInfo.PawnList);
        // End:0xC4
        if(PlayerPawn != none)
        {
            SetViewTarget(PlayerPawn);
            // End:0x9A
            if(PlayerCamera.CameraStyle == 'ThirdPerson')
            {
                SetCameraMode('FirstPerson');
                PlayerPawn.SetFirstPerson(true);
            }
            // End:0xC2
            else
            {
                SetCameraMode('ThirdPerson');
                PlayerPawn.SetFirstPerson(false);
            }
            return true;
        }
    }
    return bSuccess;
    //return ReturnValue;    
}

