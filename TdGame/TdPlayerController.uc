function SetInputHint()
{
    local TdPawn.EMoveActionHint Hint;
    local bool bMax;

    // End:0x1C
    if((IsButtonInputIgnored()) || myPawn == none)
    {
        return;
    }
    Hint = 0;
    bMax = false;
    // End:0x16B
    if(bLeftThumbStickPassedDeadZone)
    {
        // End:0x92
        if(PlayerInput.aBaseY > 0.80)
        {
            Hint = ((TdPlayerInput(PlayerInput).bInvertGamepadYAxis) ? 4 : 3);
            bMax = PlayerInput.aBaseY > 0.960;
        }
        // End:0xEC
        else
        {
            // End:0xEC
            if(PlayerInput.aBaseY < -0.80)
            {
                Hint = ((TdPlayerInput(PlayerInput).bInvertGamepadYAxis) ? 3 : 4);
                bMax = PlayerInput.aBaseY < -0.960;
            }
        }
        // End:0x12D
        if(PlayerInput.aStrafe > 0.30)
        {
            Hint = 2;
            bMax = PlayerInput.aStrafe > 0.960;
        }
        // End:0x16B
        else
        {
            // End:0x16B
            if(PlayerInput.aStrafe < -0.30)
            {
                Hint = 1;
                bMax = PlayerInput.aStrafe < -0.960;
            }
        }
    }
    myPawn.SetMoveActionHint(Hint, bMax);
    // End:0x1CA
    if((Abs(PlayerInput.aBaseY) < 0.30) && Abs(PlayerInput.aStrafe) < 0.30)
    {
        bLeftThumbStickPassedDeadZone = true;
    }
    //return;    
}

