function TdRegisterPlayerDataStores()
{
    local LocalPlayer LP;
    local DataStoreClient DataStoreManager;

    LP = LocalPlayer(Player);
    // End:0x124
    if(LP != none)
    {
        DataStoreManager = class'UIInteraction'.static.GetDataStoreClient();
        // End:0x124
        if(DataStoreManager != none)
        {
            TutorialDataStore = UIDataStore_TdTutorialData(DataStoreManager.FindDataStore('TdTutorialData', LP));
            // End:0xB0
            if(TutorialDataStore == none)
            {
                TutorialDataStore = DataStoreManager.CreateDataStore(TutorialDataClass);
                // End:0xB0
                if(TutorialDataStore != none)
                {
                    DataStoreManager.RegisterDataStore(TutorialDataStore, LP);
                }
            }
            StringAliasBindingsMapStore = UIDataStore_TdStringAliasBindingsMap(DataStoreManager.FindDataStore('StringAliasBindings', LP));
            // End:0x124
            if(StringAliasBindingsMapStore == none)
            {
                StringAliasBindingsMapStore = DataStoreManager.CreateDataStore(StringAliasBindingsMapClass);
                // End:0x124
                if(StringAliasBindingsMapStore != none)
                {
                    DataStoreManager.RegisterDataStore(StringAliasBindingsMapStore, LP);
                }
            }
        }
    }
    //return;    
}

function TdUnregisterPlayerDataStores()
{
    local LocalPlayer LP;
    local DataStoreClient DataStoreManager;
    local UIDataStore_TdTutorialData TutorialData;
    local UIDataStore_TdStringAliasBindingsMap BindingsMap;

    LP = LocalPlayer(Player);
    // End:0xD8
    if(LP != none)
    {
        DataStoreManager = class'UIInteraction'.static.GetDataStoreClient();
        // End:0xD8
        if(DataStoreManager != none)
        {
            TutorialDataStore = none;
            TutorialData = UIDataStore_TdTutorialData(DataStoreManager.FindDataStore('TdTutorialData', LP));
            // End:0x8C
            if(TutorialData != none)
            {
                DataStoreManager.UnregisterDataStore(TutorialData);
            }
            StringAliasBindingsMapStore = none;
            BindingsMap = UIDataStore_TdStringAliasBindingsMap(DataStoreManager.FindDataStore('StringAliasBindings'));
            // End:0xD8
            if(BindingsMap != none)
            {
                DataStoreManager.UnregisterDataStore(BindingsMap);
            }
        }
    }
    //return;    
}

