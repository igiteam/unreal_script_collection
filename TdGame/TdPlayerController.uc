unreliable server final function ServerViewNextSpectatorPoint()
{
    local TdGameInfo MyGameClass;
    local TdSpectatorPoint NewSpectatorPoint, CurrSpectatorPoint;

    MyGameClass = TdGameInfo(WorldInfo.Game);
    // End:0xB9
    if(MyGameClass != none)
    {
        CurrSpectatorPoint = TdSpectatorPoint(GetViewTarget());
        // End:0x67
        if(CurrSpectatorPoint != none)
        {
            NewSpectatorPoint = MyGameClass.GetNextSpectatorPoint(CurrSpectatorPoint);
        }
        // End:0x81
        else
        {
            NewSpectatorPoint = MyGameClass.GetFirstSpectatorPoint();
        }
        // End:0xAF
        if(NewSpectatorPoint != none)
        {
            SetViewTarget(NewSpectatorPoint);
            ClientSetViewTarget(NewSpectatorPoint);
        }
        // End:0xB9
        else
        {
            ServerViewNextPlayer();
        }
    }
    //return;    
}

