final exec function TriggerEmoteMessage(int Switch)
{
    // End:0xAB
    if((WorldInfo.GRI.IsMultiplayerGame() && myPawn != none) && (LastEmoteMessageTime + AllowedEmoteMessageInterval) < WorldInfo.TimeSeconds)
    {
        LastEmoteMessageTime = WorldInfo.TimeSeconds;
        // End:0xA0
        if(Role < ROLE_Authority)
        {
            class'TdAnnouncerBase'.static.Play3DLocationalAnnouncement(myPawn, TdEmoteMessageClass, Switch, false, false, PlayerReplicationInfo);
        }
        ServerTriggerEmoteMessage(Switch);
    }
    //return;    
}

