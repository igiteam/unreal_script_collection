function SetCameraMode(name NewCamMode)
{
    local bool bUsePp;

    bUsePp = NewCamMode == 'FirstPerson';
    // End:0x4B
    if(myHUD != none)
    {
        TdHUD(myHUD).EffectManager.TogglePostProcessEffects(bUsePp);
    }
    super(PlayerController).SetCameraMode(NewCamMode);
    //return;    
}

exec function FreeFlightCamera(optional byte FireModeNum)
{
    // End:0x43
    if(PlayerCamera.CameraStyle == 'FreeFlight')
    {
        SetCameraMode('FixedPerson');
        SetFixedPersonCameraSettings(Pawn);
    }
    // End:0x211
    else
    {
        // End:0x8C
        if(PlayerCamera.CameraStyle == 'FixedPerson')
        {
            SetCameraMode('Fixed');
            PlayerCamera.SetViewTarget(Pawn);
        }
        // End:0x211
        else
        {
            // End:0xBF
            if(PlayerCamera.CameraStyle == 'Fixed')
            {
                SetCameraMode('FreeCam');
            }
            // End:0x211
            else
            {
                // End:0xF2
                if(PlayerCamera.CameraStyle == 'FreeCam')
                {
                    SetCameraMode('ThirdPerson');
                }
                // End:0x211
                else
                {
                    // End:0x145
                    if(PlayerCamera.CameraStyle == 'ThirdPerson')
                    {
                        // End:0x12F
                        if(myPawn != none)
                        {
                            myPawn.SetFirstPerson(true);
                        }
                        SetCameraMode('FirstPerson');
                    }
                    // End:0x211
                    else
                    {
                        // End:0x211
                        if(PlayerCamera.IsA('TdPlayerCamera'))
                        {
                            SetCameraMode('FreeFlight');
                            TdPlayerCamera(PlayerCamera).FreeflightPosition = Pawn.Location;
                            TdPlayerCamera(PlayerCamera).FreeflightRotation = Pawn.Rotation;
                            myPawn.SetIgnoreMoveInput();
                            myPawn.SetIgnoreLookInput();
                            myPawn.SetFirstPerson(false);
                            myPawn.Mesh.ForceSkelUpdate();
                        }
                    }
                }
            }
        }
    }
    //return;    
}

