                    AC.OcclusionFilterDuckLevel = OcclusionFilterDuckLevel;
                    AC.OcclusionFadeTime = OcclusionFadeTime;
                    AC.LocationOffset = SoundOffset;
                    AC.bDebugOffset = bSoundOffsetDebug;
                }
            }
        }
        // End:0x295
        if(((((ASound.SoundGroup == 'VOMain') || ASound.SoundGroup == 'DialogueRadio') || ASound.SoundGroup == 'DialogueFaith') || ASound.SoundGroup == 'DialogueOther') && !(WorldInfo.Game != none) && WorldInfo.Game.IsA('TdSPTimeTrialGame'))
        {
            SetSoundMode(2, ASound.GetCueDuration() + 0.30);
        }
    }
    //return;    
}

simulated function bool CanDoSoundMode(Engine.AudioDevice.ESoundMode SoundMode)
{
    switch(SoundMode)
    {
        // End:0x75
        case 2:
            // End:0x72
            if(((((bReactionTime || CurrentSoundMode == 9) || CurrentSoundMode == 8) || CurrentSoundMode == 1) || CurrentSoundMode == 7) || CurrentSoundMode == 6)
            {
                return false;
            }
            // End:0x159
            break;
        // End:0x85
        case 0:
            // End:0x85
            if(bReactionTime)
            {
                return false;
        }
        // End:0x8A
        case 3:
        // End:0xC8
        case 4:
            // End:0xC5
            if(((CurrentSoundMode == 9) || CurrentSoundMode == 8) || CurrentSoundMode == 6)
            {
                return false;
            }
            // End:0x159
            break;
        // End:0x106
        case 1:
            // End:0x103
            if(((CurrentSoundMode == 9) || CurrentSoundMode == 8) || CurrentSoundMode == 6)
            {
                return false;
            }
            // End:0x159
            break;
        // End:0x156
        case 7:
            // End:0x153
            if((((CurrentSoundMode == 1) || CurrentSoundMode == 9) || CurrentSoundMode == 8) || CurrentSoundMode == 6)
            {
                return false;
            }
            // End:0x159
            break;
        // End:0xFFFF
        default:
            return true;
    }
    //return ReturnValue;    
}

function SetSoundMode(Engine.AudioDevice.ESoundMode SoundMode, optional float Duration, optional bool WithForce, optional float FadeTime)
{
    WithForce = false;    
    // End:0x2A
    if(!WithForce && !CanDoSoundMode(SoundMode))
    {
        return;
    }
    // End:0x7D
    if((Duration > 0.0) && (CurrentSoundMode != SoundMode) || GetTimerRate('ClearSoundMode') < Duration)
    {
        SetTimer(Duration, false, 'ClearSoundMode');
    }
    CurrentSoundMode = SoundMode;
    SetSoundModeNative(SoundMode, FadeTime);
    //return;    
}

simulated function ClearSoundMode()
{
    // End:0x1F
    if(IsDead())
    {
        SetSoundMode(9);
    }
    // End:0x8D
    else
    {
        // End:0x63
        if(self.IsInState('PlayerDying') && myPawn.Physics == 2)
        {
            SetSoundMode(6);
        }
        // End:0x8D
        else
        {
            // End:0x7E
            if(bReactionTime)
            {
                SetSoundMode(3);
            }
            // End:0x8D
            else
            {
                SetSoundMode(0);
            }
        }
    }
    //return;    
}

