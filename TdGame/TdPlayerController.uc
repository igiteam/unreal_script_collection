        //return;        
    }

    exec function NextViewTarget()
    {
        // End:0x2B
        if(WorldInfo.GRI.AllowViewTargetSwitching())
        {
            ServerViewNextPlayer();
        }
        //return;        
    }

    exec function PrevViewTarget()
    {
        // End:0x2B
        if(WorldInfo.GRI.AllowViewTargetSwitching())
        {
            ServerViewPrevPlayer();
        }
        //return;        
    }

    exec function NextStaticViewTarget()
    {
        // End:0x27
        if(WorldInfo.GRI.AllowViewTargetSwitching())
        {
            ServerViewNextSpectatorPoint();
        }
        //return;        
    }

    exec function PrevStaticViewTarget()
    {
        // End:0x27
        if(WorldInfo.GRI.AllowViewTargetSwitching())
        {
            ServerViewPrevSpectatorPoint();
        }
        //return;        
    }

    unreliable server function ServerViewNextPlayer()
    {
        local TdPawn MyPawnViewTarget;

        super(PlayerController).ServerViewNextPlayer();
        // End:0x56
        if(IsLocalPlayerController())
        {
            MyPawnViewTarget = TdPawn(ViewTarget);
            // End:0x56
            if(MyPawnViewTarget != none)
            {
                SetCameraMode('ThirdPerson');
                MyPawnViewTarget.SetFirstPerson(false);
            }
        }
        //return;        
    }

    reliable client simulated event ClientSetViewTarget(Actor A, optional ViewTargetTransitionParams TransitionParams)
    {
        super(PlayerController).ClientSetViewTarget(A, TransitionParams);
        // End:0x59
        if(ViewTarget.IsA('TdPawn'))
        {
            TdPawn(ViewTarget).SetFirstPerson(false);
            SetCameraMode('ThirdPerson');
        }
        // End:0x84
        else
        {
            // End:0x84
            if(ViewTarget.IsA('TdSpectatorPoint'))
            {
                SetCameraMode('Spectating');
            }
        }
        //return;        
    }

    function bool IsDead()
    {
        return true;
        //return ReturnValue;        
    }
    stop;    
}

state PlayerWalking
{
    event bool NotifyLanded(Vector HitNormal, Actor FloorActor)
    {
        return bUpdating;
        //return ReturnValue;        
    }

    function ProcessMove(float DeltaTime, Vector newAccel, Engine.Actor.EDoubleClickDir DoubleClickMove, Rotator DeltaRot)
    {
        // End:0x1A
        if((Pawn == none) || myPawn == none)
        {
            return;
        }
        // End:0x6E
        if(Role == ROLE_Authority)
        {
            myPawn.SetRemoteViewYaw(Rotation.Yaw);
            Pawn.SetRemoteViewPitch(Rotation.Pitch);
        }
        Pawn.Acceleration = newAccel;
        CheckCrouch();
        CheckJumpPressed();
        CheckJumpReleased();
        //return;        
    }

    function PlayerMove(float DeltaTime)
    {
        local Vector X, Y, Z, newAccel, WalkDirection;

        local Rotator OldRotation;
        local bool SprintRequested;

        GetAxes(Pawn.Rotation, X, Y, Z);
        CheckTriggerStopAnim();
        // End:0x96
        if(bIsStopping)
        {
            // End:0x93
            if(myPawn.MovementState == 1)
            {
                myPawn.Velocity = Normal(myPawn.Velocity) * StoppingVelocity;
                newAccel = Normal(myPawn.Velocity) * StoppingVelocity;
            }
        }
        // End:0x405
        else
        {
            WalkDirection = Normal((PlayerInput.aForward * X) + (PlayerInput.aStrafe * Y));
            // End:0x13F
            if(myPawn.Physics == 2)
            {
                bIsStopping = false;
                newAccel = myPawn.GetSprintAcceleration(PlayerInput.aForward, PlayerInput.aStrafe, int(PlayerInput.aTurn), DeltaTime);
            }
            // End:0x405
            else
            {
                // End:0x33E
                if(VSize2D(WalkDirection) > 0.0)
                {
                    AccelerationTime += DeltaTime;
                    StoppingVelocity = 200.0;
                    SprintRequested = ((PlayerInput.aForward > InputMaxSprintHeightLimit) && InputSize > InputMaxSprintRaduisLimit) && (Pawn.Velocity Dot WalkDirection) > float(0);
                    // End:0x213
                    if(SprintRequested)
                    {
                        newAccel = myPawn.GetSprintAcceleration(PlayerInput.aForward, PlayerInput.aStrafe, int(PlayerInput.aTurn), DeltaTime);
                    }
                    // End:0x33B
                    else
                    {
                        // End:0x279
                        if(VSize2D(WalkDirection) > 0.50)
                        {
                            newAccel = myPawn.GetWalkAcceleration(PlayerInput.aForward, PlayerInput.aStrafe, int(PlayerInput.aTurn), DeltaTime);
                        }
                        // End:0x33B
                        else
                        {
                            PlayerInput.aForward = 0.10 * myPawn.sign(PlayerInput.aForward);
                            PlayerInput.aStrafe = 0.10 * myPawn.sign(PlayerInput.aStrafe);
                            newAccel = myPawn.GetWalkAcceleration(PlayerInput.aForward, PlayerInput.aStrafe, int(PlayerInput.aTurn), DeltaTime);
                        }
                    }
                }
                // End:0x405
                else
                {
                    newAccel = myPawn.GetWalkAcceleration(PlayerInput.aForward, PlayerInput.aStrafe, int(PlayerInput.aTurn), DeltaTime);
                    // End:0x3FA
                    if((AccelerationTime > 0.0) && AccelerationTime < 0.150)
                    {
                        bIsStopping = true;
                        SetTimer(0.250, false, 'PlayStop');
                        StoppingVelocity = 35.0;
                        myPawn.Velocity = Normal(myPawn.Velocity) * StoppingVelocity;
                    }
                    AccelerationTime = 0.0;
                }
            }
        }
        OldRotation = Rotation;
        UpdateRotation(DeltaTime);
        bDoubleJump = false;
        // End:0x45D
        if(Role < ROLE_Authority)
        {
            ReplicateMove(DeltaTime, newAccel, 0, OldRotation - Rotation);
        }
        // End:0x480
        else
        {
            ProcessMove(DeltaTime, newAccel, 0, OldRotation - Rotation);
        }
        bReleasedJump = false;
        bPressedJump = false;
        // End:0x5A2
        if(ControllerTilt)
        {
            // End:0x4DC
            if(((ActualAccelZ - LastZAxisTilt) < SixAxisDisarmZ) && (ActualAccelY - LastYAxisTilt) > SixAxisDisarmY)
            {
                DisarmTimeMultiplier = 0.20;
                SnatchAttempt();
            }
            // End:0x58C
            if(((((ActualAccelZ - LastZAxisTilt) > SixAxisRollZ) && (ActualAccelY - LastYAxisTilt) > SixAxisRollY) && myPawn.Physics == 2) && (myPawn.RollTriggerTime + 0.80) < myPawn.WorldInfo.TimeSeconds)
            {
                myPawn.RollTriggerTime = myPawn.WorldInfo.TimeSeconds + 0.20;
            }
            LastZAxisTilt = ActualAccelZ;
            LastYAxisTilt = ActualAccelY;
        }
        //return;        
    }

    function CheckTriggerStopAnim()
    {
        local float WalkCyclePos;

        // End:0x1C
        if(myPawn.MovementState != 1)
        {
            return;
        }
        // End:0x15C
        if((Abs(PlayerInput.aForward) <= 0.010) && Abs(PlayerInput.aStrafe) <= 0.010)
        {
            // End:0x159
            if(bIsWalking)
            {
                // End:0x95
                if(myPawn.MasterSync3p.Groups[0].MasterNode.AnimSeq == none)
                {
                    return;
                }
                WalkCyclePos = myPawn.MasterSync3p.Groups[0].MasterNode.CurrentTime / myPawn.MasterSync3p.Groups[0].MasterNode.AnimSeq.SequenceLength;
                // End:0x123
                if(WalkCyclePos >= WalkCyclePart2)
                {
                    PlayStopLeft();
                }
                // End:0x149
                else
                {
                    // End:0x13F
                    if(WalkCyclePos <= WalkCyclePart1)
                    {
                        PlayStopLeft();
                    }
                    // End:0x149
                    else
                    {
                        PlayStopRight();
                    }
                }
                bIsStopping = false;
                bIsWalking = false;
            }
        }
        // End:0x1DB
        else
        {
            // End:0x1DB
            if((!bIsWalking && !bIsStopping) && myPawn.CurrentWalkingState >= 2)
            {
                ClearTimer('PlayStopLeft');
                ClearTimer('PlayStopRight');
                myPawn.StopCustomAnim(3, StopAnimBlendOut);
                bIsWalking = true;
                bIsStopping = false;
            }
        }
        //return;        
    }

    event PlayStop()
    {
        bIsStopping = false;
        //return;        
    }

    function bool ShouldPlayStopAnim()
    {
        local TdWeapon TdW;

        TdW = TdWeapon(myPawn.Weapon);
        return (myPawn.MovementState == 1) && (TdW == none) || (TdW.WeaponType != 1) && !TdW.IsZoomingOrZoomed();
        //return ReturnValue;        
    }

    event PlayStopLeft()
    {
        // End:0x3F
        if(ShouldPlayStopAnim())
        {
            myPawn.PlayCustomAnim(5, 'walktostandpassleft', 1.0, StopAnimBlendIn, StopAnimBlendOut, false, true, false);
        }
        bIsStopping = false;
        //return;        
    }

    event PlayStopRight()
    {
        // End:0x3F
        if(ShouldPlayStopAnim())
        {
            myPawn.PlayCustomAnim(5, 'walktostandpassright', 1.0, StopAnimBlendIn, StopAnimBlendOut, false, true, false);
        }
        bIsStopping = false;
        //return;        
    }

    function BeginState(name PreviousStateName)
    {
        DoubleClickDir = 0;
        bPressedJump = false;
        GroundPitch = 0;
        bIsStopping = false;
        // End:0xD8
        if(Pawn != none)
        {
            Pawn.ShouldCrouch(false);
            // End:0xD8
            if(((((Pawn.Physics != 2) && Pawn.Physics != 10) && Pawn.Physics != 4) && Pawn.Physics != 13) && Pawn.Physics != 12)
            {
                Pawn.SetPhysics(1);
            }
        }
        //return;        
    }
    stop;    
}

state PlayerGrabbing
{
    function BeginState(name PreviousStateName)
    {
        // End:0x25
        if(myPawn.MovementState != 21)
        {
            bLeftThumbStickPassedDeadZone = false;
        }
        // End:0x2D
        else
        {
            bLeftThumbStickPassedDeadZone = true;
        }
        //return;        
    }

    function EndState(name NextStateName)
    {
        bLeftThumbStickPassedDeadZone = true;
        //return;        
    }

    function ProcessMove(float DeltaTime, Vector newAccel, Engine.Actor.EDoubleClickDir DoubleClickMove, Rotator DeltaRot)
    {
        // End:0x21D
        if((myPawn != none) && !myPawn.bForceRMVelocity || myPawn.bIsUsingRootMotion)
        {
            // End:0x6A
            if(newAccel.Y > 8.0)
            {
                myPawn.HandleMoveAction(15);
            }
            // End:0x21D
            else
            {
                // End:0x9D
                if(newAccel.Y < -8.0)
                {
                    myPawn.HandleMoveAction(13);
                }
                // End:0x21D
                else
                {
                    // End:0xD0
                    if(newAccel.Y > 3.0)
                    {
                        myPawn.HandleMoveAction(14);
                    }
                    // End:0x21D
                    else
                    {
                        // End:0x103
                        if(newAccel.Y < -3.0)
                        {
                            myPawn.HandleMoveAction(12);
                        }
                        // End:0x21D
                        else
                        {
                            // End:0x152
                            if((newAccel.X > 8.0) && myPawn.MoveActionHint == 3)
                            {
                                myPawn.HandleMoveAction(9);
                            }
                            // End:0x21D
                            else
                            {
                                // End:0x1A1
                                if((newAccel.X < -8.0) && myPawn.MoveActionHint == 4)
                                {
                                    myPawn.HandleMoveAction(10);
                                }
                                // End:0x21D
                                else
                                {
                                    // End:0x1D4
                                    if(newAccel.X > 3.0)
                                    {
                                        myPawn.HandleMoveAction(7);
                                    }
                                    // End:0x21D
                                    else
                                    {
                                        // End:0x207
                                        if(newAccel.X < -3.0)
                                        {
                                            myPawn.HandleMoveAction(8);
                                        }
                                        // End:0x21D
                                        else
                                        {
                                            myPawn.HandleMoveAction(0);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // End:0x271
        if(Role == ROLE_Authority)
        {
            Pawn.SetRemoteViewPitch(Rotation.Pitch);
            myPawn.SetRemoteViewYaw(Rotation.Yaw);
        }
        Pawn.Acceleration = vect(0.0, 0.0, 0.0);
        CheckJumpPressed();
        CheckJumpReleased();
        CheckCrouch();
        //return;        
    }

    function bool ShouldDelayJump()
    {
        return false;
        //return ReturnValue;        
    }

    function PlayerMove(float DeltaTime)
    {
        local Vector newAccel;
        local Rotator OldRotation, ViewRotation;
        local bool bDelayJump;

        OldRotation = Rotation;
        ViewRotation = Rotation;
        newAccel = vect(0.0, 0.0, 0.0);
        newAccel.X = PlayerInput.aForward * 10.0;
        newAccel.Y = PlayerInput.aStrafe * 10.0;
        SetRotation(ViewRotation);
        UpdateRotation(DeltaTime);
        // End:0xC0
        if(bPressedJump && ShouldDelayJump())
        {
            bDelayJump = !bReleasedJump;
            bPressedJump = false;
        }
        // End:0xD0
        else
        {
            bDelayJump = false;
            bReleasedJump = false;
        }
        // End:0x106
        if(Role < ROLE_Authority)
        {
            ReplicateMove(DeltaTime, newAccel, 0, OldRotation - Rotation);
        }
        // End:0x129
        else
        {
            ProcessMove(DeltaTime, newAccel, 0, OldRotation - Rotation);
        }
        bReleasedJump = false;
        bPressedJump = bDelayJump;
        //return;        
    }
    stop;    
}

state PlayerBalanceWalk extends PlayerWalking
{
    function PlayerMove(float DeltaTime)
    {
        local Vector newAccel;
        local Rotator OldRotation;
        local float Balance;

        Balance = ((ControllerTilt && PlayerInput.aStrafe == 0.0) ? PlayerInput.aPS3AccelX : PlayerInput.aStrafe);
        newAccel = vector(myPawn.Rotation) * (myPawn.GetWalkAcceleration(PlayerInput.aForward, 0.0, int(PlayerInput.aTurn), DeltaTime) Dot vector(myPawn.Rotation));
        newAccel += ((vector(myPawn.Rotation) Cross vect(0.0, 0.0, 1.0)) * Balance);
        OldRotation = Rotation;
        UpdateRotation(DeltaTime);
        bDoubleJump = false;
        // End:0x13A
        if(Role < ROLE_Authority)
        {
            ReplicateMove(DeltaTime, newAccel, 0, OldRotation - Rotation);
        }
        // End:0x15D
        else
        {
            ProcessMove(DeltaTime, newAccel, 0, OldRotation - Rotation);
        }
        bReleasedJump = false;
        bPressedJump = false;
        //return;        
    }
    stop;    
}

state PlayerLedgeWalking extends PlayerWalking
{
    ignores SetInputHint;

    function PlayerMove(float DeltaTime)
    {
        local Vector newAccel;
        local Rotator OldRotation;

        newAccel.Y = PlayerInput.aStrafe * 10.0;
        newAccel.X = PlayerInput.aForward * 10.0;
        newAccel.Z = 0.0;
        OldRotation = Rotation;
        UpdateRotation(DeltaTime);
        bDoubleJump = false;
        // End:0xBC
        if(Role < ROLE_Authority)
        {
            ReplicateMove(DeltaTime, newAccel, 0, OldRotation - Rotation);
        }
        // End:0xDF
        else
        {
            ProcessMove(DeltaTime, newAccel, 0, OldRotation - Rotation);
        }
        bReleasedJump = false;
        bPressedJump = false;
        //return;        
    }

    function ProcessMove(float DeltaTime, Vector newAccel, Engine.Actor.EDoubleClickDir DoubleClickMove, Rotator DeltaRot)
    {
        // End:0xB3
        if((myPawn != none) && !myPawn.bForceRMVelocity || myPawn.bIsUsingRootMotion)
        {
            // End:0x6A
            if(newAccel.Y > 6.0)
            {
                myPawn.HandleMoveAction(14);
            }
            // End:0xB3
            else
            {
                // End:0x9D
                if(newAccel.Y < -6.0)
                {
                    myPawn.HandleMoveAction(12);
                }
                // End:0xB3
                else
                {
                    myPawn.HandleMoveAction(0);
                }
            }
        }
        // End:0x107
        if(Role == ROLE_Authority)
        {
            Pawn.SetRemoteViewPitch(Rotation.Pitch);
            myPawn.SetRemoteViewYaw(Rotation.Yaw);
        }
        Pawn.Acceleration = vect(0.0, 0.0, 0.0);
        CheckJumpPressed();
        CheckJumpReleased();
        //return;        
    }
    stop;    
}

state PlayerWallWalking
{
    function UpdateRotation(float DeltaTime)
    {
        local Rotator ViewRotation, DeltaRot;

        ViewRotation = Rotation;
        DesiredRotation = ViewRotation;
        DeltaRot.Yaw = int(PlayerInput.aTurn);
        DeltaRot.Pitch = int(PlayerInput.aLookUp);
        // End:0xE1
        if(myPawn != none)
        {
            // End:0xA2
            if(CurrentLookAtPoint != none)
            {
                CurrentLookAtPoint.UpdateViewRotation(ViewRotation, DeltaTime, DeltaRot, myPawn.Location);
            }
            myPawn.Moves[myPawn.MovementState].UpdateViewRotation(ViewRotation, DeltaTime, DeltaRot);
        }
        ProcessViewRotation(DeltaTime, ViewRotation, DeltaRot);
        SetRotation(ViewRotation);
        ViewShake(DeltaTime);
        // End:0x144
        if(Pawn != none)
        {
            Pawn.FaceRotation(Pawn.Rotation, DeltaTime);
        }
        UpdateStickyAim(DeltaTime);
        //return;        
    }

    function ProcessMove(float DeltaTime, Vector newAccel, Engine.Actor.EDoubleClickDir DoubleClickMove, Rotator DeltaRot)
    {
        Pawn.Acceleration = newAccel;
        // End:0x69
        if(Role == ROLE_Authority)
        {
            myPawn.SetRemoteViewYaw(Rotation.Yaw);
            Pawn.SetRemoteViewPitch(Rotation.Pitch);
        }
        CheckJumpPressed();
        CheckJumpReleased();
        CheckCrouch();
        //return;        
    }

    function bool ShouldDelayJump()
    {
        return false;
        //return ReturnValue;        
    }

    function PlayerMove(float DeltaTime)
    {
        local Vector newAccel;
        local Rotator OldRotation, ViewRotation;
        local bool bDelayJump;

        GroundPitch = 0;
        ViewRotation = Rotation;
        SetRotation(ViewRotation);
        OldRotation = Rotation;
        UpdateRotation(DeltaTime);
        newAccel = vect(0.0, 0.0, 0.0);
        // End:0x79
        if(bPressedJump && ShouldDelayJump())
        {
            bDelayJump = !bReleasedJump;
            bPressedJump = false;
        }
        // End:0x89
        else
        {
            bDelayJump = false;
            bReleasedJump = false;
        }
        // End:0xBF
        if(Role < ROLE_Authority)
        {
            ReplicateMove(DeltaTime, newAccel, 0, OldRotation - Rotation);
        }
        // End:0xE2
        else
        {
            ProcessMove(DeltaTime, newAccel, 0, OldRotation - Rotation);
        }
        bReleasedJump = false;
        bPressedJump = bDelayJump;
        //return;        
    }

    function SetInputHint()
    {
        local float StrafeThresholdValue;

        super(TdPlayerController).SetInputHint();
        StrafeThresholdValue = ((myPawn.IsInMove(6)) ? WallClimbingDodgeJumpThreshold : WallRunningDodgeJumpThreshold);
        // End:0xFD
        if(bLeftThumbStickPassedDeadZone)
        {
            // End:0x82
            if(PlayerInput.aStrafe > StrafeThresholdValue)
            {
                myPawn.SetMoveActionHint(2, PlayerInput.aStrafe > 0.960);
            }
            // End:0xFD
            else
            {
                // End:0xCC
                if(PlayerInput.aStrafe < -StrafeThresholdValue)
                {
                    myPawn.SetMoveActionHint(1, PlayerInput.aStrafe < -0.960);
                }
                // End:0xFD
                else
                {
                    // End:0xFD
                    if(myPawn.MoveActionHint != 3)
                    {
                        myPawn.SetMoveActionHint(0, false);
                    }
                }
            }
        }
        //return;        
    }

    function BeginState(name PreviousStateName)
    {
        WallRunningAlignYaw = Pawn.Rotation.Yaw;
        OldFloor = Pawn.Floor;
        GetAxes(Rotation, ViewX, ViewY, ViewZ);
        GroundPitch = 0;
        //return;        
    }

    function EndState(name NextStateName)
    {
        GroundPitch = 0;
        //return;        
    }
    stop;    
}

state Spectating
{
    ignores StartFire, StartAltFire, AttemptReactionTime;

    exec function NextStaticViewTarget()
    {
        // End:0x27
        if(WorldInfo.GRI.AllowViewTargetSwitching())
        {
            ServerViewNextSpectatorPoint();
        }
        //return;        
    }

    exec function PrevStaticViewTarget()
    {
        // End:0x27
        if(WorldInfo.GRI.AllowViewTargetSwitching())
        {
            ServerViewPrevSpectatorPoint();
        }
        //return;        
    }

    exec function NextViewTarget()
    {
        // End:0x2B
        if(WorldInfo.GRI.AllowViewTargetSwitching())
        {
            ServerViewNextPlayer();
        }
        //return;        
    }

    exec function PrevViewTarget()
    {
        // End:0x2B
        if(WorldInfo.GRI.AllowViewTargetSwitching())
        {
            ServerViewPrevPlayer();
        }
        //return;        
    }

    unreliable server function ServerViewNextPlayer()
    {
        local TdPawn MyPawnViewTarget;

        super(PlayerController).ServerViewNextPlayer();
        // End:0x56
        if(IsLocalPlayerController())
        {
            MyPawnViewTarget = TdPawn(ViewTarget);
            // End:0x56
            if(MyPawnViewTarget != none)
            {
                SetCameraMode('ThirdPerson');
                MyPawnViewTarget.SetFirstPerson(false);
            }
        }
        //return;        
    }

    reliable client simulated event ClientSetViewTarget(Actor A, optional ViewTargetTransitionParams TransitionParams)
    {
        super(PlayerController).ClientSetViewTarget(A, TransitionParams);
        // End:0x59
        if(ViewTarget.IsA('TdPawn'))
        {
            TdPawn(ViewTarget).SetFirstPerson(false);
            SetCameraMode('ThirdPerson');
        }
        // End:0x84
        else
        {
            // End:0x84
            if(ViewTarget.IsA('TdSpectatorPoint'))
            {
                SetCameraMode('Spectating');
            }
        }
        //return;        
    }

    event PlayerTick(float DeltaTime)
    {
        // End:0x5A
        if(ViewTarget.IsA('Pawn'))
        {
            TargetViewRotation = ViewTarget.Rotation;
            TargetViewRotation.Pitch = Pawn(ViewTarget).RemoteViewPitch << 8;
        }
        super(PlayerController).PlayerTick(DeltaTime);
        //return;        
    }
    stop;    
}

state Ropeburn
{
    function BeginState(name PreviousStateName)
    {
        bRopeburnDisarmSucceeded = false;
        //return;        
    }

    function EndState(name NextStateName)
    {
        bRopeburnDisarmSucceeded = false;
        bIgnoreButtonInput = 0;
        //return;        
    }

    function ProcessMove(float DeltaTime, Vector PawnAcceleration, Engine.Actor.EDoubleClickDir DoubleClickMove, Rotator DeltaRotation)
    {
        // End:0x54
        if(Role == ROLE_Authority)
        {
            myPawn.SetRemoteViewYaw(Rotation.Yaw);
            Pawn.SetRemoteViewPitch(Rotation.Pitch);
        }
        //return;        
    }

    function PlayerMove(float DeltaTime)
    {
        local Rotator PreviousRotation;

        PreviousRotation = Rotation;
        UpdateRotation(DeltaTime);
        // End:0x55
        if(Role == ROLE_Authority)
        {
            ProcessMove(DeltaTime, vect(0.0, 0.0, 0.0), 0, PreviousRotation - Rotation);
        }
        //return;        
    }

    exec function PressedSwitchWeapon()
    {
        // End:0x13
        if(!bCinematicMode)
        {
            bRopeburnDisarmSucceeded = true;
        }
        //return;        
    }
    stop;    
}

state PlayerDying
{
    ignores ProcessMove;

    function PlayerMove(float DeltaTime)
    {
        local Vector newAccel;
        local Rotator OldRotation, ViewRotation;
        local bool bDelayJump;

        OldRotation = Rotation;
        ViewRotation = Rotation;
        newAccel = vect(0.0, 0.0, 0.0);
        newAccel.X = PlayerInput.aForward * 10.0;
        newAccel.Y = PlayerInput.aStrafe * 10.0;
        SetRotation(ViewRotation);
        UpdateRotation(DeltaTime);
        // End:0xC0
        if(bPressedJump && ShouldDelayJump())
        {
            bDelayJump = !bReleasedJump;
            bPressedJump = false;
        }
        // End:0xD0
        else
        {
            bDelayJump = false;
            bReleasedJump = false;
        }
        // End:0x106
        if(Role < ROLE_Authority)
        {
            ReplicateMove(DeltaTime, newAccel, 0, OldRotation - Rotation);
        }
        // End:0x129
        else
        {
            ProcessMove(DeltaTime, newAccel, 0, OldRotation - Rotation);
        }
        bReleasedJump = false;
        bPressedJump = bDelayJump;
        //return;        
    }

    function BeginState(name PreviousStateName)
    {
        OnTdDisableReactionTime(none);
        super(Object).BeginState(PreviousStateName);
        //return;        
    }
    stop;    
}

state Dead
{
    ignores StartFire, AttemptReactionTime;

    exec function NextViewTarget()
    {
        // End:0x2B
        if(WorldInfo.GRI.IsMultiplayerGame())
        {
            ServerViewNextPlayer();
        }
        //return;        
    }

    exec function PrevViewTarget()
    {
        // End:0x2B
        if(WorldInfo.GRI.IsMultiplayerGame())
        {
            ServerViewPrevPlayer();
        }
        //return;        
    }

    exec function NextStaticViewTarget()
    {
        // End:0x27
        if(WorldInfo.GRI.IsMultiplayerGame())
        {
            ServerViewNextSpectatorPoint();
        }
        //return;        
    }

    exec function PrevStaticViewTarget()
    {
        // End:0x27
        if(WorldInfo.GRI.IsMultiplayerGame())
        {
            ServerViewPrevSpectatorPoint();
        }
        //return;        
    }

    function BeginState(name PreviousStateName)
    {
        local TdSPGame SPGame;

        SPGame = TdSPGame(WorldInfo.Game);
        // End:0x39
        if(SPGame != none)
        {
            SPGame.OnPlayerDead();
        }
        myPawn = none;
        super.BeginState(PreviousStateName);
        // End:0x8B
        if(WorldInfo.GRI.IsMultiplayerGame())
        {
            IgnoreLookInput(false);
            IgnoreMoveInput(false);
            ServerViewNextSpectatorPoint();
        }
        // End:0x97
        else
        {
            SetViewTarget(self);
        }
        StopSounds(0.10, 'VO');
        ClientStopForceFeedbackWaveform();
        //return;        
    }

    unreliable server function ServerViewNextPlayer()
    {
        local TdPawn MyPawnViewTarget;

        super(PlayerController).ServerViewNextPlayer();
        // End:0x56
        if(IsLocalPlayerController())
        {
            MyPawnViewTarget = TdPawn(ViewTarget);
            // End:0x56
            if(MyPawnViewTarget != none)
            {
                SetCameraMode('ThirdPerson');
                MyPawnViewTarget.SetFirstPerson(false);
            }
        }
        //return;        
    }

    reliable client simulated event ClientSetViewTarget(Actor A, optional ViewTargetTransitionParams TransitionParams)
    {
        super(PlayerController).ClientSetViewTarget(A, TransitionParams);
        // End:0x59
        if(ViewTarget.IsA('TdPawn'))
        {
            TdPawn(ViewTarget).SetFirstPerson(false);
            SetCameraMode('ThirdPerson');
        }
        // End:0x84
        else
        {
            // End:0x84
            if(ViewTarget.IsA('TdSpectatorPoint'))
            {
                SetCameraMode('Spectating');
            }
        }
        //return;        
    }

    function PlayerMove(float DeltaTime)
    {
        local Vector X, Y, Z;
        local Rotator DeltaRot, ViewRotation;

        // End:0x1D
        if(bPressedJump)
        {
            StartFire(0);
            bPressedJump = false;
        }
        GetAxes(Rotation, X, Y, Z);
        ViewRotation = Rotation;
        DeltaRot.Yaw = int(PlayerInput.aTurn);
        DeltaRot.Pitch = int(PlayerInput.aLookUp);
        ProcessViewRotation(DeltaTime, ViewRotation, DeltaRot);
        // End:0xB8
        if(ViewTarget != self)
        {
            ViewRotation.Roll = 0;
        }
        SetRotation(ViewRotation);
        // End:0xFB
        if(Role < ROLE_Authority)
        {
            ReplicateMove(DeltaTime, vect(0.0, 0.0, 0.0), 0, rot(0, 0, 0));
        }
        //return;        
    }

Begin:
    stop;                
}

