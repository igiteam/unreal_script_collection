event PlayerTick(float DeltaTime)
{
    MaintainEnemyList();
    MouseX = PlayerInput.aMouseX;
    MouseY = PlayerInput.aMouseY;
    // End:0x7B
    if(ControllerTilt)
    {
        ActualAccelX = PlayerInput.aPS3AccelX;
        ActualAccelY = PlayerInput.aPS3AccelY;
        ActualAccelZ = PlayerInput.aPS3AccelZ;
    }
    // End:0x9C
    else
    {
        ActualAccelX = 0.0;
        ActualAccelY = 0.0;
        ActualAccelZ = 0.0;
    }
    super(PlayerController).PlayerTick(DeltaTime);
    UpdateReactionTime(DeltaTime);
    // End:0xDA
    if(!WorldInfo.IsPlayInEditor())
    {
        UpdateMomentumStats(DeltaTime);
    }
    //return;    
}

function UpdateMomentumStats(float DeltaTime)
{
    // End:0x2A
    if(myPawn == none)
    {
        // End:0x27
        if(CachedWalkingState == 5)
        {
            AddStatsEvent(7);
        }
    }
    // End:0xDC
    else
    {
        // End:0xAB
        if(myPawn.CurrentWalkingState != CachedWalkingState)
        {
            // End:0x87
            if((myPawn.CurrentWalkingState == 5) && !myPawn.bUncontrolledSlide)
            {
                AddStatsEvent(6);
            }
            // End:0x93
            else
            {
                AddStatsEvent(7);
            }
            CachedWalkingState = myPawn.CurrentWalkingState;
        }
        // End:0xDC
        else
        {
            // End:0xDC
            if((CachedWalkingState == 5) && myPawn.bUncontrolledSlide)
            {
                AddStatsEvent(7);
            }
        }
    }
    //return;    
}

simulated function DisplayDebug(HUD HUD, out float out_YL, out float out_YPos)
{
    local Canvas Canvas;

    Canvas = HUD.Canvas;
    Canvas.SetDrawColor(255, 255, 255, 255);
    out_YPos += out_YL;
    Canvas.SetPos(4.0, out_YPos);
    Canvas.DrawText((((("CONTROLLER " $ (GetItemName(string(self)))) $ " Physics ") $ (GetPhysicsName())) $ " Pawn ") $ (GetItemName(string(Pawn))));
    out_YPos += out_YL;
    Canvas.SetPos(4.0, out_YPos);
    // End:0x182
    if(Pawn == none)
    {
        // End:0x124
        if(PlayerReplicationInfo == none)
        {
            Canvas.DrawText("NO PLAYERREPLICATIONINFO", false);
        }
        // End:0x147
        else
        {
            PlayerReplicationInfo.DisplayDebug(HUD, out_YL, out_YPos);
        }
        out_YPos += out_YL;
        Canvas.SetPos(4.0, out_YPos);
        super(Actor).DisplayDebug(HUD, out_YL, out_YPos);
    }
    // End:0x1D2
    if((PlayerCamera != none) && HUD.ShouldDisplayDebug('Camera'))
    {
        PlayerCamera.DisplayDebug(HUD, out_YL, out_YPos);
    }
    Canvas.SetDrawColor(0, 255, 0, 255);
    out_YPos += (out_YL + float(10));
    Canvas.SetPos(4.0, out_YPos);
    Canvas.DrawText("Current State: " $ string(GetStateName()));
    out_YPos += out_YL;
    Canvas.SetPos(4.0, out_YPos);
    Canvas.DrawText("Physics state: " $ (GetPhysicsName()));
    out_YPos += out_YL;
    Canvas.SetPos(4.0, out_YPos);
    Canvas.DrawText("Ignore look: " $ string(bIgnoreLookInput));
    out_YPos += out_YL;
    Canvas.SetPos(4.0, out_YPos);
    Canvas.DrawText("Ignore move: " $ string(bIgnoreMoveInput));
    out_YPos += out_YL;
    Canvas.SetPos(4.0, out_YPos);
    Canvas.DrawText("Ibnore button: " $ string(bIgnoreButtonInput));
    out_YPos += out_YL;
    Canvas.SetPos(4.0, out_YPos);
    Canvas.DrawText("Cinematic: " $ string(bCinematicMode));
    out_YPos += out_YL;
    Canvas.SetPos(4.0, out_YPos);
    Canvas.DrawText("bDuck: " $ string(bDuck));
    out_YPos += out_YL;
    Canvas.SetPos(4.0, out_YPos);
    Canvas.DrawText("bIsLoading: " $ string(IsLoadingLevel()));
    out_YPos += out_YL;
    Canvas.SetPos(4.0, out_YPos);
    Canvas.DrawText("Controller rotation: " $ string(Rotation));
    out_YPos += out_YL;
    Canvas.SetPos(4.0, out_YPos);
    // End:0x613
    if(Pawn != none)
    {
        Canvas.DrawText("Pawn rotation: " $ string(Pawn.Rotation));
        out_YPos += out_YL;
        Canvas.SetPos(4.0, out_YPos);
        Canvas.DrawText((((("Pawn position: " $ string(Pawn.Location.X)) $ ", ") $ string(Pawn.Location.Y)) $ ", ") $ string(Pawn.Location.Z));
        out_YPos += out_YL;
        Canvas.SetPos(4.0, out_YPos);
    }
    //return;    
}

