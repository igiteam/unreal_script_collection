function ForceFullReactionTimeEnergy()
{
    // End:0x2C
    if(bReactionTime)
    {
        WorldInfo.Game.SetGameSpeed(1.0);
    }
    bReactionTime = false;
    ReactionTimeEnergy = 100.0;
    TdHUD(myHUD).EffectManager.ActivateReactionTimeTeaser();
    //return;    
}

exec function AttemptReactionTime()
{
    // End:0x2F
    if(!WorldInfo.GRI.GameClass.static.AllowReactionTime())
    {
        return;
    }
    // End:0x49
    if(bCinematicMode || IsButtonInputIgnored())
    {
        return;
    }
    // End:0x65
    if(WorldInfo.NetMode != NM_Standalone)
    {
        return;
    }
    // End:0x9D
    if(myPawn.IsInState('Dying') || myPawn.IsInState('UncontrolledFall'))
    {
        return;
    }
    // End:0xD2
    if((ReactionTimeEnergy < float(100)) || WorldInfo.Game.GameSpeed < 1.0)
    {
        return;
    }
    TdHUD(myHUD).ToggleReactionTime(true);
    bReactionTime = true;
    SetSoundMode(3);
    myPawn.OnTutorialEvent(15);
    //return;    
}

function UpdateStickyAim(float DeltaTime)
{
    local TdHUD HUD;
    local TdWeapon CurrentWeapon;
    local TdMove CurrentMove;

    // End:0x0D
    if(myPawn == none)
    {
        return;
    }
    HUD = TdHUD(myHUD);
    CurrentWeapon = TdWeapon(myPawn.Weapon);
    CurrentMove = myPawn.Moves[myPawn.MovementState];
    // End:0x85
    if(((HUD == none) || CurrentWeapon == none) || CurrentMove == none)
    {
        return;
    }
    CurrentWeapon.UpdateStickyActor(HUD, self, CurrentMove, DeltaTime);
    //return;    
}

