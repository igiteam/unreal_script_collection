}

function SetFixedPersonCameraSettings(Actor A)
{
    TdPlayerCamera(PlayerCamera).FreeflightPosition = TdPlayerCamera(PlayerCamera).FreeflightPosition - A.Location;
    TdPlayerCamera(PlayerCamera).FixedPersonDistance = VSize(TdPlayerCamera(PlayerCamera).FreeflightPosition);
    TdPlayerCamera(PlayerCamera).FreeflightPosition = Normal(TdPlayerCamera(PlayerCamera).FreeflightPosition);
    TdPlayerCamera(PlayerCamera).FixedPersonVectorRelativeRotator = A.Rotation;
    TdPlayerCamera(PlayerCamera).FreeflightRotation = TdPlayerCamera(PlayerCamera).FreeflightRotation - A.Rotation;
    myPawn.StopIgnoreMoveInput();
    myPawn.StopIgnoreLookInput();
    PlayerCamera.SetViewTarget(A);
    //return;    
}

