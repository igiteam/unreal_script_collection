exec function LockCameraOnTarget(optional byte FireModeNum)
{
    local Vector CamLoc, StartShot, EndShot, X, Y, Z,
	    HitLocation, HitNormal, ZeroVec;

    local Actor HitActor;
    local TraceHitInfo HitInfo;
    local Rotator CamRot;

    // End:0x20
    if(PlayerCamera.CameraStyle != 'FreeFlight')
    {
        return;
    }
    GetPlayerViewPoint(CamLoc, CamRot);
    GetAxes(CamRot, X, Y, Z);
    ZeroVec = vect(0.0, 0.0, 0.0);
    StartShot = CamLoc;
    EndShot = StartShot + (10000.0 * X);
    HitActor = Pawn.Trace(HitLocation, HitNormal, EndShot, StartShot, true, ZeroVec, HitInfo);
    // End:0xE1
    if(HitActor != none)
    {
        SetCameraMode('FixedPerson');
        SetFixedPersonCameraSettings(HitActor);
    }
    //return;    
}

