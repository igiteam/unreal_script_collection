function bool SetPause(bool bPause, optional delegate<CanUnpause> CanUnpauseDelegate)
{
    local bool bResult;

    bResult = super(PlayerController).SetPause(bPause, CanUnpauseDelegate);
    // End:0x66
    if(bPause == IsPaused())
    {
        // End:0x4E
        if(bPause)
        {
            SetAudioGroupVolume('InGameMusic', 0.250);
        }
        // End:0x66
        else
        {
            SetAudioGroupVolume('InGameMusic', 1.0);
        }
    }
    return bResult;
    //return ReturnValue;    
}

exec function RetrieveSettingsFromProfile()
{
    SetAudioProfileSettings();
    SetVideoProfileSettings();
    SetKeyBindingsProfileSettings();
    SetControlBindingsProfileSettings();
    SetGameProfileSettings();
    //return;    
}

exec function SetAudioProfileSettings()
{
    local int Value;
    local TdProfileSettings ProfileSettings;

    ProfileSettings = GetProfileSettings();
    // End:0x56
    if(ProfileSettings.GetProfileSettingValueIntByName('MasterVolume', Value))
    {
        SetAudioGroupVolume('Master', float(Value) / 10.0);
    }
    // End:0x9C
    if(ProfileSettings.GetProfileSettingValueIntByName('MusicVolume', Value))
    {
        SetAudioGroupVolume('Music', float(Value) / 10.0);
    }
    // End:0x136
    if(ProfileSettings.GetProfileSettingValueIntByName('DialogueVolume', Value))
    {
        // End:0x115
        if((WorldInfo.Game != none) && WorldInfo.Game.IsA('TdSPTimeTrialGame'))
        {
            SetAudioGroupVolume('VO', 0.0);
        }
        // End:0x136
        else
        {
            SetAudioGroupVolume('VO', float(Value) / 10.0);
        }
    }
    //return;    
}

exec function SetVideoProfileSettings()
{
    local int Value;
    local TdProfileSettings ProfileSettings;

    ProfileSettings = GetProfileSettings();
    // End:0x4D
    if(ProfileSettings.GetProfileSettingValueIntByName('Brightness', Value))
    {
        SetGamma(float(Value) / 10.0);
    }
    // End:0x8A
    if(ProfileSettings.GetProfileSettingValueIntByName('Contrast', Value))
    {
        SetContrast(float(Value) / 10.0);
    }
    //return;    
}

exec function SetKeyBindingsProfileSettings()
{
    local TdPlayerInput TdInput;
    local TdProfileSettings ProfileSettings;

    ProfileSettings = GetProfileSettings();
    TdInput = TdPlayerInput(PlayerInput);
    // End:0x5E
    if(TdInput != none)
    {
        ProfileSettings.ApplyKeyBindings(TdInput);
        ProfileSettings.ApplyGamepadBindings(TdInput);
    }
    ClearDataStoreBindingsCache();
    //return;    
}

function ClearDataStoreBindingsCache()
{
    local LocalPlayer LP;
    local DataStoreClient DataStoreManager;
    local UIDataStore_TdStringAliasBindingsMap BindingsDataStore;

    LP = LocalPlayer(Player);
    // End:0x98
    if(LP != none)
    {
        DataStoreManager = class'UIInteraction'.static.GetDataStoreClient();
        // End:0x98
        if(DataStoreManager != none)
        {
            BindingsDataStore = UIDataStore_TdStringAliasBindingsMap(DataStoreManager.FindDataStore('StringAliasBindings', LP));
            // End:0x98
            if(BindingsDataStore != none)
            {
                BindingsDataStore.ClearBoundKeyCache();
                BindingsDataStore.RefreshSubscribers();
            }
        }
    }
    //return;    
}

exec function SetMouseProfileSettings()
{
    local int Value;
    local TdPlayerInput TdInput;
    local TdProfileSettings ProfileSettings;

    ProfileSettings = GetProfileSettings();
    TdInput = TdPlayerInput(PlayerInput);
    // End:0xB0
    if(TdInput != none)
    {
        // End:0x72
        if(ProfileSettings.GetProfileSettingValueIntByName('Sensitivity', Value))
        {
            TdInput.SetRangedSensitivityMultiplier(float(Value) / 10.0);
        }
        // End:0xB0
        if(ProfileSettings.GetProfileSettingValueIdByName('InvertYAxis', Value))
        {
            TdInput.bInvertMouse = Value == 1;
        }
    }
    //return;    
}

exec function SetControlBindingsProfileSettings(optional array<KeyBind> PresetMappings)
{
    local int Value;
    local TdPlayerInput TdInput;
    local TdProfileSettings ProfileSettings;

    ProfileSettings = GetProfileSettings();
    TdInput = TdPlayerInput(PlayerInput);
    // End:0x132
    if(TdInput != none)
    {
        // End:0x73
        if(ProfileSettings.GetProfileSettingValueIntByName('Sensitivity', Value))
        {
            TdInput.SetRangedSensitivityMultiplier(float(Value) / 10.0);
        }
        // End:0xB1
        if(ProfileSettings.GetProfileSettingValueIdByName('InvertYAxis', Value))
        {
            TdInput.bInvertMouse = Value == 1;
        }
        // End:0xEF
        if(ProfileSettings.GetProfileSettingValueIdByName('ControllerVibration', Value))
        {
            ForceFeedbackManager.bAllowsForceFeedback = Value == 1;
        }
        // End:0x114
        if(ProfileSettings.GetProfileSettingValueIdByName('AutoAim', Value))
        {
        }
        ProfileSettings.ApplyGamepadBindings(TdInput, PresetMappings);
    }
    ControllerTilt = !ProfileSettings.GetProfileSettingValueIdByName('ControllerTilt', Value) || Value == 1;
    SetControllerTiltDesiredIfAvailable(ControllerTilt);
    SetControllerTiltActive(ControllerTilt);
    ControllerTilt = ControllerTilt && IsControllerTiltActive();
    ClearDataStoreBindingsCache();
    //return;    
}

exec function SetGameProfileSettings()
{
    local int Value;
    local TdProfileSettings ProfileSettings;
    local TdSPHUD CurrentSPHud;

    SetDifficultyLevel(GetDifficultyLevel());
    ProfileSettings = GetProfileSettings();
    // End:0xA2
    if(ProfileSettings.GetProfileSettingValueIdByName('GameSubtitles', Value))
    {
        // End:0x90
        if((WorldInfo.Game != none) && WorldInfo.Game.IsA('TdSPTimeTrialGame'))
        {
            SetShowSubtitles(false);
        }
        // End:0xA2
        else
        {
            SetShowSubtitles(Value != 0);
        }
    }
    // End:0xDB
    if(ProfileSettings.GetProfileSettingValueIdByName('FaithOVision', Value))
    {
        UpdateFaithOVisionFlag(GetDifficultyLevel());
    }
    // End:0x136
    if(ProfileSettings.GetProfileSettingValueIdByName('Reticule', Value))
    {
        CurrentSPHud = TdSPHUD(myHUD);
        // End:0x136
        if(CurrentSPHud != none)
        {
            CurrentSPHud.SetDrawCrosshairFlag(byte(Value));
        }
    }
    //return;    
}

function SetDifficultyLevel(int Level)
{
    local TdAIController AIGuy;

    // End:0x37
    foreach WorldInfo.AllControllers(class'TdAIController', AIGuy)
    {
        AIGuy.SetDifficultyLevel(Level);        
    }    
    // End:0x5C
    if(myPawn != none)
    {
        myPawn.SetDifficultyLevel(Level);
    }
    switch(Level)
    {
        // End:0x81
        case 0:
            ReactionTimeEnergyBuildRate = ReactionTimeBuildRates.Easy;
            // End:0xBC
            break;
        // End:0x9E
        case 1:
            ReactionTimeEnergyBuildRate = ReactionTimeBuildRates.Medium;
            // End:0xBC
            break;
        // End:0xB9
        case 2:
            ReactionTimeEnergyBuildRate = ReactionTimeBuildRates.Hard;
        // End:0xFFFF
        default:
            UpdateFaithOVisionFlag(Level);
            //return;
    }    
}

function int GetDifficultyLevel()
{
    local int Value;
    local TdProfileSettings ProfileSettings;

    // End:0x1C
    if(TdSPLevelRace(WorldInfo.Game) != none)
    {
        return 1;
    }
    ProfileSettings = GetProfileSettings();
    // End:0x67
    if((ProfileSettings != none) && ProfileSettings.GetProfileSettingValueIdByName('GameDifficulty', Value))
    {
        return Value;
    }
    // End:0x69
    else
    {
        return 1;
    }
    //return ReturnValue;    
}

function int GetFaithOVisionFromProfile()
{
    local int Value;
    local TdProfileSettings ProfileSettings;

    ProfileSettings = GetProfileSettings();
    // End:0x4B
    if((ProfileSettings != none) && ProfileSettings.GetProfileSettingValueIdByName('FaithOVision', Value))
    {
        return Value;
    }
    // End:0x4E
    else
    {
        return 2;
    }
    //return ReturnValue;    
}

function UpdateFaithOVisionFlag(int DifficultyLevel)
{
    local TdAIController AIController;
    local Actor A;
    local bool bOldValue;

    bOldValue = bCanSeeLOI;
    // End:0x3A
    if(TdSPTutorialGame(WorldInfo.Game) != none)
    {
        LOIIndex = 2;
        bCanSeeLOI = true;
    }
    // End:0x77
    else
    {
        // End:0x68
        if(DifficultyLevel != 2)
        {
            LOIIndex = GetFaithOVisionFromProfile();
            bCanSeeLOI = LOIIndex != 0;
        }
        // End:0x77
        else
        {
            bCanSeeLOI = false;
            LOIIndex = 0;
        }
    }
    // End:0xBC
    foreach WorldInfo.AllControllers(class'TdAIController', AIController)
    {
        AIController.myPawn.SetRunnerVisionEnabled(LOIIndex == 2);        
    }    
    // End:0x126
    if((bCanSeeLOI && !bOldValue) && WorldInfo.IsLOIEnabled())
    {
        // End:0x125
        foreach AllActors(class'Actor', A)
        {
            // End:0x124
            if(A.bLOIObject)
            {
                A.AssignPlayerToLOI(self);
            }            
        }        
    }
    //return;    
}

function bool IsAiRunnerVisionEnabled()
{
    return LOIIndex == 2;
    //return ReturnValue;    
}

function SetNewDifficulty(int I)
{
    local TdProfileSettings ProfileSettings;
    local int SettingId;

    // End:0x1B
    if((I < 0) || I > 2)
    {
        return;
    }
    ProfileSettings = GetProfileSettings();
    // End:0x8A
    if((ProfileSettings != none) && ProfileSettings.GetProfileSettingId('GameDifficulty', SettingId))
    {
        ProfileSettings.SetProfileSettingValueId(SettingId, I);
        SetDifficultyLevel(I);
    }
    //return;    
}

