        }
        WeaponFiredEvent.CheckActivate(self, PlayerWeapon);
        J0xD1:
        ++ Index;
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

exec function ReloadWeapon()
{
    // End:0x70
    if(((myPawn.Moves[myPawn.MovementState].MovementGroup > 0) || myPawn.AgainstWallState != 0) || myPawn.WeaponAnimState == 4)
    {
        return;
    }
    UnZoom();
    TdWeapon(Pawn.Weapon).ReloadWeapon();
    //return;    
}

exec function PressedSwitchWeapon()
{
    local TdInventoryManager InvMan;
    local TdMOVE_Disarm DisarmMove;

    // End:0x0F
    if(IsButtonInputIgnored())
    {
        return;
    }
    myPawn.OnTutorialEvent(19);
    InvMan = TdInventoryManager(Pawn.InvManager);
    DisarmTimeMultiplier = 1.0;
    // End:0x171
    if((((((((((myPawn.AgainstWallState != 0) || myPawn.WeaponAnimState == 4) || WorldInfo.Pauser != none) || myPawn.IsFiring()) || myPawn.IsReloading()) || bCinematicMode) || myPawn.MovementState == 2) || myPawn.MovementState == 20) || myPawn.Moves[myPawn.MovementState].MovementGroup > 0) || TdWeapon(myPawn.Weapon).IsZooming())
    {
        return;
    }
    // End:0x268
    else
    {
        // End:0x1A9
        if(myPawn.Weapon != none)
        {
            UnZoom();
            myPawn.DropWeapon();
            return;
        }
        // End:0x268
        else
        {
            // End:0x1BB
            if(SnatchAttempt())
            {
                return;
            }
            // End:0x268
            else
            {
                // End:0x268
                if((InvMan != none) && myPawn.Moves[myPawn.MovementState].bAllowPickup)
                {
                    InvMan.PressedSwitchWeapon();
                    // End:0x268
                    if(myPawn.Weapon == none)
                    {
                        DisarmMove = TdMOVE_Disarm(myPawn.Moves[18]);
                        DisarmMove.ForceMiss(true);
                        myPawn.HandleMoveAction(4);
                    }
                }
            }
        }
    }
    // End:0x2B2
    if((myPawn.Weapon != none) && myPawn.Weapon.IsA('TdWeapon_Sniper_BarretM95'))
    {
        CallPopUp(1, 4.0);
    }
    //return;    
}

