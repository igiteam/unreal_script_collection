unreliable server function ServerUseCarriedObject(bool bTapped)
{
    local TdPlayerReplicationInfo MyPRI;

    MyPRI = TdPlayerReplicationInfo(PlayerReplicationInfo);
    // End:0xA5
    if(myPawn != none)
    {
        // End:0x8C
        if(myPawn.IsCarryingObject())
        {
            // End:0x57
            if(bTapped)
            {
                MyPRI.OnUseCarriedObject(myPawn);
            }
            // End:0x89
            else
            {
                MyPRI.OnUseCarriedObject(myPawn.CarriedObject.GetCarriedActor());
            }
        }
        // End:0xA5
        else
        {
            MyPRI.OnUseCarriedObject(myPawn);
        }
    }
    //return;    
}

