function bool SnatchAttempt()
{
    local float CloseCombatRange, ForwardVelocity;

    // End:0x42
    if(!((myPawn != none) && myPawn.MovementState != 18) && !myPawn.HasWeapon())
    {
        return false;
    }
    ForwardVelocity = myPawn.Velocity Dot vector(myPawn.Rotation);
    CloseCombatRange = FMin(FMax(FMax(0.0, ForwardVelocity) * 0.40, CloseCombatMinRange), CloseCombatMaxRange);
    TargetPawn = GetHumanTarget(CloseCombatRange, CloseCombatMaxAngle);
    // End:0xB8
    if(TargetPawn == none)
    {
        return false;
    }
    // End:0x12C
    if((TargetPawn.MovementState == 35) && (Normal(TargetPawn.Location - Pawn.Location) Dot vector(Pawn.Rotation)) < 0.0)
    {
        myPawn.HandleMoveAction(3);
    }
    // End:0x161
    else
    {
        myPawn.HandleMoveAction(4);
        // End:0x161
        if(Role < ROLE_Authority)
        {
            ServerTriggerSnatch(TargetPawn);
        }
    }
    return true;
    //return ReturnValue;    
}

reliable server function ServerTriggerSnatch(TdPawn TargetPawnReplication)
{
    TargetPawn = TargetPawnReplication;
    myPawn.HandleMoveAction(4);
    //return;    
}

function TdPawn GetHumanTarget(float MaxDistance, float MaxAngle)
{
    local TdPawn P, ClosestPawn;
    local float MinDistance;

    // End:0x24
    if((Pawn == none) || Pawn.Controller == none)
    {
        return none;
    }
    MinDistance = 10000000.0;
    // End:0x18B
    foreach TdPlayerController(myPawn.Controller).LocalEnemyActors(P)
    {
        // End:0x15A
        if((vector(Pawn.Controller.Rotation) Dot Normal(P.Location - Pawn.Location)) > MaxAngle)
        {
            // End:0x127
            if((VSize(Pawn.Location - P.Location) < MinDistance) && P.IsValidEnemyTargetFor(Pawn.PlayerReplicationInfo, true))
            {
                ClosestPawn = P;
                MinDistance = VSize(Pawn.Location - P.Location);
            }
            // End:0x157
            if(bDebugCloseCombat)
            {
                DrawDebugSphereTime(P.Location, 4.0, 4, 0, 0, 150, 20.0);
            }
            // End:0x18A
            continue;
        }
        // End:0x18A
        if(bDebugCloseCombat)
        {
            DrawDebugSphereTime(P.Location, 4.0, 4, 30, 30, 30, 20.0);
        }        
    }    
    // End:0x199
    if(ClosestPawn == none)
    {
        return none;
    }
    // End:0x209
    if(bDebugCloseCombat && MinDistance < MaxDistance)
    {
        DrawDebugSphereTime(ClosestPawn.Location, 4.50, 4, 255, 0, 0, 20.0);
        DrawDebugLineTime(myPawn.Location, ClosestPawn.Location, 255, 0, 0, 20.0);
    }
    return (((VSize2D(Pawn.Location - ClosestPawn.Location) < MaxDistance) && VSize(Pawn.Location - ClosestPawn.Location) < CloseCombatMaxRange) ? ClosestPawn : none);
    //return ReturnValue;    
}

