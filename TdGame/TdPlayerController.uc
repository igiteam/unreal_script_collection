event OnProfileReadComplete(bool bSucceeded)
{
    local Actor A;
    local TdProfileSettings P;
    local TdSPGame Game;

    P = GetProfileSettings();
    RetrieveSettingsFromProfile();
    SetDifficultyLevel(GetDifficultyLevel());
    // End:0x8A
    if(bCanSeeLOI && WorldInfo.IsLOIEnabled())
    {
        // End:0x89
        foreach AllActors(class'Actor', A)
        {
            // End:0x88
            if(A.bLOIObject)
            {
                A.AssignPlayerToLOI(self);
            }            
        }        
    }
    // End:0x12B
    if(P != none)
    {
        // End:0xB0
        if(StatsManager == none)
        {
            StatsManager = new (self) class'TdStatsManager';
        }
        StatsManager.SetToDefaults(P);
        Game = TdSPGame(WorldInfo.Game);
        // End:0x128
        if(Game != none)
        {
            StatsManager.LoadStatsFromProfile(P, Game.bShouldSaveCheckpointProgress, Game.bShouldSaveCheckpointProgress, true);
        }
        J0x12B:
    }
    // End:0x12B
    else
    {
    }
    //return;    
}

function ClientUpdatePosition()
{
    local TdSavedMove CurrentMove;
    local int realbRun, realbDuck;
    local bool bRealJump, bRealStopJump, bRealPreciseDestination;

    bUpdatePosition = false;
    // End:0x31
    if((Pawn != none) && Pawn.Physics == 10)
    {
        return;
    }
    realbRun = bRun;
    realbDuck = bDuck;
    bRealJump = bPressedJump;
    bRealStopJump = bReleasedJump;
    bUpdating = true;
    bRealPreciseDestination = bPreciseDestination;
    ClearAckedMoves();
    CurrentMove = TdSavedMove(SavedMoves);
    J0x94:
    // End:0x250 [Loop If]
    if(CurrentMove != none)
    {
        // End:0xD4
        if((PendingMove == CurrentMove) && Pawn != none)
        {
            PendingMove.SetInitialPosition(Pawn);
        }
        // End:0x100
        if(Pawn != none)
        {
            Pawn.bForceRMVelocity = CurrentMove.bForceRMVelocity;
        }
        MoveAutonomous(CurrentMove.Delta, CurrentMove.CompressedFlags(), CurrentMove.Acceleration, rot(0, 0, 0));
        // End:0x233
        if(Pawn != none)
        {
            Pawn.bForceRMVelocity = false;
            CurrentMove.SavedLocation = Pawn.Location;
            CurrentMove.SavedVelocity = Pawn.Velocity;
            CurrentMove.EndBase = Pawn.Base;
            // End:0x233
            if((CurrentMove.EndBase != none) && !CurrentMove.EndBase.bWorldGeometry)
            {
                CurrentMove.SavedRelativeLocation = Pawn.Location - CurrentMove.EndBase.Location;
            }
        }
        CurrentMove = TdSavedMove(CurrentMove.NextMove);
        // [Loop Continue]
        goto J0x94;
    }
    bUpdating = false;
    bDuck = byte(realbDuck);
    bRun = byte(realbRun);
    bPressedJump = bRealJump;
    bReleasedJump = bRealStopJump;
    bPreciseDestination = bRealPreciseDestination;
    //return;    
}

