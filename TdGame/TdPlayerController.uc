final function SendServerMove(SavedMove NewMove, Vector ClientLoc, byte ClientRoll, int View, SavedMove OldMove)
{
    // End:0x148
    if(myPawn != none)
    {
        // End:0x8D
        if(myPawn.IsInMove(9) && NewMove.bForceRMVelocity)
        {
            VaultServerMove(NewMove.TimeStamp, NewMove.RMVelocity * float(10), ClientLoc, NewMove.CompressedFlags(), ClientRoll, View);
        }
        // End:0x145
        else
        {
            // End:0xF4
            if(NewMove.bForceRMVelocity)
            {
                RMServerMove(NewMove.TimeStamp, NewMove.RMVelocity * float(10), ClientLoc, NewMove.CompressedFlags(), ClientRoll, View);
            }
            // End:0x145
            else
            {
                ServerMove(NewMove.TimeStamp, NewMove.Acceleration * float(10), ClientLoc, NewMove.CompressedFlags(), ClientRoll, View);
            }
        }
    }
    // End:0x199
    else
    {
        ServerMove(NewMove.TimeStamp, NewMove.Acceleration * float(10), ClientLoc, NewMove.CompressedFlags(), ClientRoll, View);
    }
    //return;    
}

reliable server function RMServerMove(float TimeStamp, Vector InAccel, Vector ClientLoc, byte MoveFlags, byte ClientRoll, int View)
{
    // End:0x11
    if(CurrentTimeStamp >= TimeStamp)
    {
        return;
    }
    Pawn.bForceRMVelocity = true;
    Pawn.RMVelocity = InAccel * 0.10;
    InAccel = Pawn.AccelRate * Normal(InAccel);
    ServerMove(TimeStamp, InAccel, ClientLoc, MoveFlags, ClientRoll, View);
    Pawn.bForceRMVelocity = false;
    //return;    
}

reliable server function VaultServerMove(float TimeStamp, Vector InAccel, Vector ClientLoc, byte MoveFlags, byte ClientRoll, int View)
{
    local Rotator ViewRot, PawnRot, DeltaRot;
    local float DeltaTime;

    // End:0x11
    if(CurrentTimeStamp >= TimeStamp)
    {
        return;
    }
    // End:0x48
    if(myPawn == none)
    {
        ServerMove(TimeStamp, Normal(InAccel), ClientLoc, MoveFlags, ClientRoll, View);
        return;
    }
    // End:0x71
    if(ClientLoc != vect(1.0, 2.0, 3.0))
    {
        myPawn.SetLocation(ClientLoc);
    }
    myPawn.Velocity = InAccel * 0.10;
    bWasSpeedHack = false;
    DeltaTime = FMin(MaxResponseTime, TimeStamp - CurrentTimeStamp);
    CurrentTimeStamp = TimeStamp;
    ServerTimeStamp = WorldInfo.TimeSeconds;
    ViewRot.Pitch = View & 65535;
    ViewRot.Yaw = View >> 16;
    ViewRot.Roll = 0;
    LastActiveTime = WorldInfo.TimeSeconds;
    DeltaRot = Rotation - ViewRot;
    SetRotation(ViewRot);
    // End:0x158
    if(AcknowledgedPawn != Pawn)
    {
        return;
    }
    // End:0x1AB
    if(Pawn != none)
    {
        PawnRot = Rotation;
        PawnRot.Roll = 256 * ClientRoll;
        Pawn.FaceRotation(PawnRot, DeltaTime);
    }
    // End:0x20A
    if((Pawn == none) || !Pawn.bHardAttach)
    {
        SavedMoveClass.static.SetFlags(MoveFlags, self);
        ProcessMove(DeltaTime, InAccel, 0, DeltaRot);
        bDoubleJump = false;
    }
    PendingAdjustment.TimeStamp = TimeStamp;
    PendingAdjustment.bAckGoodMove = 1;
    //return;    
}

function UpdateRotation(float DeltaTime)
{
    local Rotator DeltaRot, NewRotation, ViewRotation;
    local float RotSpeedMod;

    ViewRotation = Rotation;
    DesiredRotation = ViewRotation;
    // End:0x79
    if(myPawn != none)
    {
        RotSpeedMod = FMax(0.40, 1.0 - float(Min(1, int(Abs(float(Normalize(Rotation - myPawn.Rotation).Pitch) / 16384.0) + 0.30))));
    }
    // End:0x84
    else
    {
        RotSpeedMod = 1.0;
    }
    // End:0xD8
    if(bRightThumbStickPassedDeadZone)
    {
        DeltaRot.Yaw = int(PlayerInput.aTurn * RotSpeedMod);
        DeltaRot.Pitch = int(PlayerInput.aLookUp);
    }
    // End:0x103
    if(bCinematicMode && Pawn != none)
    {
        SetRotation(Pawn.Rotation);
    }
    // End:0x225
    else
    {
        // End:0x1F2
        if(myPawn != none)
        {
            // End:0x162
            if(CurrentForcedLookAtPoint != none)
            {
                CurrentForcedLookAtPoint.UpdateViewRotation(ViewRotation, DeltaTime, DeltaRot, myPawn.GetEyeLocation(myPawn.Location));
            }
            // End:0x1B3
            else
            {
                // End:0x1B3
                if(CurrentLookAtPoint != none)
                {
                    CurrentLookAtPoint.UpdateViewRotation(ViewRotation, DeltaTime, DeltaRot, myPawn.GetEyeLocation(myPawn.Location));
                }
            }
            myPawn.Moves[myPawn.MovementState].UpdateViewRotation(ViewRotation, DeltaTime, DeltaRot);
        }
        ProcessViewRotation(DeltaTime, ViewRotation, DeltaRot);
        ViewRotation.Roll = 0;
        SetRotation(ViewRotation);
    }
    ViewShake(DeltaTime);
    NewRotation = ViewRotation;
    NewRotation.Roll = Rotation.Roll;
    // End:0x289
    if(Pawn != none)
    {
        Pawn.FaceRotation(NewRotation, DeltaTime);
    }
    UpdateStickyAim(DeltaTime);
    // End:0x2E3
    if(!bRightThumbStickPassedDeadZone)
    {
        // End:0x2E3
        if((Abs(PlayerInput.aTurn) < 0.30) && Abs(PlayerInput.aLookUp) < 0.30)
        {
            bRightThumbStickPassedDeadZone = true;
        }
    }
    //return;    
}

function UpdateReactionTime(float DeltaTime)
{
    local float ReactionTimeToDrain, ReactionTimeToFadeIn, ReactionTimeToFadeOut, NewGameSpeed;

    // End:0x0D
    if(myPawn == none)
    {
        return;
    }
    // End:0x17E
    if(bReactionTime)
    {
        // End:0x5C
        if(!bOverrideReactionTimeSettings)
        {
            ReactionTimeToDrain = (100.0 / ReactionTimeDrain) * DeltaTime;
            ReactionTimeToDrain /= WorldInfo.TimeDilation;
            ReactionTimeEnergy -= ReactionTimeToDrain;
        }
        // End:0xC9
        if(ReactionTimeEnergy <= float(0))
        {
            bReactionTime = false;
            TdHUD(myHUD).ToggleReactionTime(false);
            ReactionTimeEnergy = 0.0;
            NewGameSpeed = 1.0;
            SetSoundMode(0);
            myPawn.OnTutorialEvent(22);
        }
        // End:0x158
        else
        {
            ReactionTimeToFadeIn = ReactionTimeFadeIn;
            ReactionTimeToFadeOut = ReactionTimeFadeOut;
            // End:0x11D
            if(ReactionTimeEnergy > ReactionTimeToFadeIn)
            {
                NewGameSpeed = Lerp(ReactionTimeMaxEffect, 1.0, (ReactionTimeEnergy - ReactionTimeToFadeIn) / (100.0 - ReactionTimeToFadeIn));
            }
            // End:0x158
            else
            {
                // End:0x14D
                if(ReactionTimeEnergy < ReactionTimeToFadeOut)
                {
                    NewGameSpeed = Lerp(1.0, ReactionTimeMaxEffect, ReactionTimeEnergy / ReactionTimeToFadeOut);
                }
                // End:0x158
                else
                {
                    NewGameSpeed = ReactionTimeMaxEffect;
                }
            }
        }
        WorldInfo.Game.SetGameSpeed(NewGameSpeed);
    }
    // End:0x21B
    else
    {
        // End:0x21B
        if(ReactionTimeEnergy < 100.0)
        {
            ReactionTimeEnergy += ((ReactionTimeEnergyBuildRate * DeltaTime) * myPawn.VelocityMagnitude);
            // End:0x21B
            if((ReactionTimeEnergy >= 100.0) && WorldInfo.GRI.GameClass.static.AllowReactionTime())
            {
                ReactionTimeEnergy = 100.0;
                TdHUD(myHUD).EffectManager.ActivateReactionTimeTeaser();
            }
        }
    }
    //return;    
}

