function ForcePreRoundSpectate()
{
    local Pawn PawnToKill;

    // End:0x66
    if(Pawn != none)
    {
        PawnToKill = Pawn;
        Pawn.StopFiring();
        UnPossess();
        PawnToKill.Died(none, none, PawnToKill.Location);
        PawnToKill.Destroy();
    }
    GotoState('PlayerWaiting');
    // End:0x94
    if(!ViewTarget.IsA('TdSpectatorPoint'))
    {
        ServerViewNextSpectatorPoint();
    }
    //return;    
}

