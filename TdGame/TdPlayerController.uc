function AddStatsEvent(SeqAct_TdRegisterStat.EAchievementStatsID Id)
{
    local float time_stamp;
    local TdProfileSettings ProfileSettings;
    local bool bSaveProfile, bNew;

    time_stamp = WorldInfo.TimeSeconds;
    ProfileSettings = GetProfileSettings();
    bSaveProfile = false;
    // End:0x3A
    if(ProfileSettings == none)
    {
        return;
    }
    switch(Id)
    {
        // End:0x47
        case 11:
        // End:0x4C
        case 12:
        // End:0x51
        case 13:
        // End:0x56
        case 14:
        // End:0x5B
        case 15:
        // End:0x60
        case 16:
        // End:0x65
        case 17:
        // End:0x6A
        case 18:
        // End:0x6F
        case 19:
        // End:0x74
        case 20:
        // End:0x79
        case 21:
        // End:0x7E
        case 22:
        // End:0x83
        case 23:
        // End:0x88
        case 24:
        // End:0x8D
        case 25:
        // End:0x92
        case 26:
        // End:0x97
        case 27:
        // End:0x9C
        case 28:
        // End:0xA1
        case 29:
        // End:0xA6
        case 30:
        // End:0xAB
        case 31:
        // End:0xB0
        case 32:
        // End:0xB5
        case 33:
        // End:0xBA
        case 34:
        // End:0xBF
        case 35:
        // End:0xC4
        case 36:
        // End:0xC9
        case 37:
        // End:0xCE
        case 38:
        // End:0xD3
        case 39:
        // End:0x19B
        case 40:
            bNew = StatsManager.GetStatCount(Id, ProfileSettings) == 0;
            // End:0x155
            if(StatsManager.RegisterStats(Id, time_stamp, ProfileSettings))
            {
                UnlockAchievement(43);
                // End:0x155
                if(ProfileSettings.IsAllBagsFound())
                {
                    UnlockAchievement(42);
                }
            }
            // End:0x17D
            if(ProfileSettings.IsXBagsFound(StatsManager))
            {
                UnlockAchievement(44);
            }
            bSaveProfile = true;
            // End:0x198
            if(bNew)
            {
                TriggerPickupFlash();
            }
            // End:0x34D
            break;
        // End:0x1DD
        case 2:
            // End:0x1DA
            if(StatsManager.RegisterStats(Id, time_stamp, ProfileSettings))
            {
                bSaveProfile = false;
                UnlockAchievement(33);
            }
            // End:0x34D
            break;
        // End:0x21F
        case 3:
            // End:0x21C
            if(StatsManager.RegisterStats(Id, time_stamp, ProfileSettings))
            {
                bSaveProfile = false;
                UnlockAchievement(34);
            }
            // End:0x34D
            break;
        // End:0x261
        case 1:
            // End:0x25E
            if(StatsManager.RegisterStats(Id, time_stamp, ProfileSettings))
            {
                bSaveProfile = false;
                UnlockAchievement(35);
            }
            // End:0x34D
            break;
        // End:0x2A3
        case 7:
            // End:0x2A0
            if(StatsManager.RegisterStats(Id, time_stamp, ProfileSettings))
            {
                bSaveProfile = false;
                UnlockAchievement(32);
            }
            // End:0x34D
            break;
        // End:0x2E5
        case 10:
            // End:0x2E2
            if(StatsManager.RegisterStats(Id, time_stamp, ProfileSettings))
            {
                bSaveProfile = false;
                UnlockAchievement(36);
            }
            // End:0x34D
            break;
        // End:0x327
        case 9:
            // End:0x324
            if(StatsManager.RegisterStats(Id, time_stamp, ProfileSettings))
            {
                bSaveProfile = false;
                UnlockAchievement(37);
            }
            // End:0x34D
            break;
        // End:0xFFFF
        default:
            StatsManager.RegisterStats(Id, time_stamp, ProfileSettings);
            // End:0x35C
            if(bSaveProfile)
            {
                TryWriteProfile();
            }
            //return;
    }    
}

private final function TryWriteProfile()
{
    local TdProfileSettings ProfileSettings;
    local LocalPlayer LocPlayer;
    local int ControllerId;

    LocPlayer = LocalPlayer(Player);
    ProfileSettings = GetProfileSettings();
    ControllerId = LocPlayer.ControllerId;
    // End:0xE8
    if(((OnlineSub != none) && LocPlayer != none) && ProfileSettings != none)
    {
        OnlineSub.PlayerInterface.AddWriteProfileSettingsCompleteDelegate(byte(ControllerId), OnProfileWriteComplete);
        // End:0xE8
        if(!OnlineSub.PlayerInterface.WriteProfileSettings(byte(ControllerId), ProfileSettings))
        {
            OnlineSub.PlayerInterface.ClearWriteProfileSettingsCompleteDelegate(byte(ControllerId), OnProfileWriteComplete);
        }
    }
    //return;    
}

private final function OnProfileWriteComplete(bool bSuccess)
{
    OnlineSub.PlayerInterface.ClearWriteProfileSettingsCompleteDelegate(byte(class'UIInteraction'.static.GetPlayerControllerId(0)), OnProfileWriteComplete);
    // End:0x47
    if(bSuccess)
    {
    }
    // End:0x4D
    else
    {
        ShowErrorMessageBox();
    }
    //return;    
}

private final function ShowErrorMessageBox()
{
    local TdGameUISceneClient SceneClient;

    SceneClient = TdGameUISceneClient(class'UIRoot'.static.GetSceneClient());
    SceneClient.OpenMessageBox(OnShowErrorMessageBox_Init, 2);
    //return;    
}

private final function OnShowErrorMessageBox_Init(UIScene OpenedScene, bool bInitialActivation)
{
    local TdUIScene_MessageBox ErrorMessageBox;
    local TdGameUISceneClient SceneClient;

    ErrorMessageBox = TdUIScene_MessageBox(OpenedScene);
    SceneClient = TdGameUISceneClient(class'UIRoot'.static.GetSceneClient());
    ErrorMessageBox.bPauseGameWhileActive = true;
    SceneClient.RequestPausedUpdate();
    ErrorMessageBox.DisplayAcceptCancelRetryBox("<Strings:TdGameUI.TdMessageBox.FailedToWriteProfileProgress_Message>", "<Strings:TdGameUI.TdMessageBox.FailedToWriteProfile_Title>", OnErrorMessageBoxClosed);
    //return;    
}

private final function OnErrorMessageBoxClosed(TdUIScene_MessageBox InMessageBox, int SelectedOption, int PlayerIndex)
{
    switch(SelectedOption)
    {
        // End:0x12
        case 1:
            TryWriteProfile();
        // End:0xFFFF
        default:
            //return;
    }    
}

event CallPopUp(TdSPHUD.EPopUpType Type, float Duration)
{
    local TdSPHUD HUD;
    local string Message;

    HUD = TdSPHUD(myHUD);
    // End:0x1D
    if(HUD == none)
    {
        return;
    }
    switch(Type)
    {
        // End:0x59
        case 1:
            Message = Localize("TdPopUps", "PopUp1", "TdGameUI");
            // End:0x11A
            break;
        // End:0x7B
        case 4:
            Message = HUD.BuildBagString();
            // End:0x11A
            break;
        // End:0xAF
        case 2:
            Message = Localize("TdPopUps", "PopUp2", "TdGameUI");
            // End:0x11A
            break;
        // End:0xE3
        case 3:
            Message = Localize("TdPopUps", "PopUp3", "TdGameUI");
            // End:0x11A
            break;
        // End:0x117
        case 5:
            Message = Localize("TdPopUps", "PopUp4", "TdGameUI");
            // End:0x11A
            break;
        // End:0xFFFF
        default:
            HUD.ActivatePopUp(Type, Duration, Message);
            //return;
    }    
}

function Reset()
{
    super(PlayerController).Reset();
    PlayerInput.ResetInput();
    bCinemaDisableInputMove = false;
    bCinemaDisableInputLook = false;
    bCinematicMode = false;
    bIgnoreLookInput = 0;
    bIgnoreMoveInput = 0;
    bGodMode = false;
    ClientStopForceFeedbackWaveform();
    bOverrideReactionTimeSettings = false;
    ReactionTimeEnergy = 0.0;
    UpdateReactionTime(1.0);
    bReactionTime = false;
    ReactionTimeEnergy = ReactionTimeSpawnLevel;
    TargetingPawn = none;
    TargetingPawnInterp = 0.0;
    TargetPawn = none;
    TargetActor = none;
    CurrentLookAtPoint = none;
    CurrentForcedLookAtPoint = none;
    bLeftThumbStickPassedDeadZone = default.bLeftThumbStickPassedDeadZone;
    bRightThumbStickPassedDeadZone = default.bRightThumbStickPassedDeadZone;
    LocalEnemies.Length = 0;
    bDisableLoadFromLastCheckpoint = false;
    AddStatsEvent(7);
    //return;    
}

function OnDisableLoadFromLastCheckpoint(SeqAct_DisableLoadFromLastCheckpoint Action)
{
    bDisableLoadFromLastCheckpoint = Action.bShouldBeDisabled;
    //return;    
}

function bool CanLoadFromLastCheckpoint()
{
    return !bDisableLoadFromLastCheckpoint && IsCutsceneSkippable();
    //return ReturnValue;    
}

function OnLevelCompleted(int LevelIndex, TdSPGame Game)
{
    local TdProfileSettings Profile;
    local SeqAct_TdUnlockAchievement.ETdAchievements Id;
    local int Difficulty, ProRunner;

    Profile = GetProfileSettings();
    // End:0x1D
    if(Profile == none)
    {
        return;
    }
    Profile.OnLevelCompleted(LevelIndex);
    // End:0x264
    if((LevelIndex >= 1) && LevelIndex <= 10)
    {
        StatsManager.SaveStatsToProfile(Profile, false, Game.bShouldSaveCheckpointProgress, true);
        // End:0x185
        if(LevelIndex == 10)
        {
            // End:0x120
            if(Profile.GetProfileSettingValueId(Profile.252, Difficulty) && Difficulty == 2)
            {
                // End:0x120
                if(Profile.GetProfileSettingValueInt(Profile.1003, ProRunner) && ProRunner == 1)
                {
                    // End:0x120
                    if(Game.bShouldSaveCheckpointProgress)
                    {
                        Id = 27;
                        UnlockAchievement(Id);
                    }
                }
            }
            Id = 26;
            UnlockAchievement(Id);
            // End:0x182
            if(Game.bShouldSaveCheckpointProgress)
            {
                // End:0x17A
                if((GetStatCount(5)) == 0)
                {
                    Id = 31;
                    UnlockAchievement(Id);
                }
                // End:0x182
                else
                {
                    Id = 31;
                }
            }
        }
        // End:0x1AC
        else
        {
            Id = byte((1 + LevelIndex) - 1);
            UnlockAchievement(Id);
        }
        // End:0x264
        if(Game.bAllowSPLevelAchievements)
        {
            // End:0x1ED
            if((GetStatCount(0)) == 0)
            {
                Id = 30;
                UnlockAchievement(Id);
            }
            // End:0x1F5
            else
            {
                Id = 30;
            }
            // End:0x223
            if((GetStatCount(8)) == 0)
            {
                Id = 29;
                UnlockAchievement(Id);
            }
            // End:0x22B
            else
            {
                Id = 29;
            }
            // End:0x259
            if((GetStatCount(4)) == 0)
            {
                Id = 28;
                UnlockAchievement(Id);
            }
            // End:0x261
            else
            {
                Id = 28;
            }
            J0x264:
        }
        // End:0x264
        else
        {
        }
    }
    //return;    
}

