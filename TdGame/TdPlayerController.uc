    }
    //return;    
}

exec function ZoomWeapon()
{
    local TdWeapon TdW;
    local float FOV, Rate, delay;

    // End:0x1B
    if(!myPawn.CanZoom())
    {
        return;
    }
    // End:0xE2
    if((myPawn.MovementState == 1) || myPawn.MovementState == 15)
    {
        TdW = TdWeapon(Pawn.Weapon);
        // End:0xE2
        if(((TdW != none) && TdW.bCanZoom) && !TdW.IsZooming())
        {
            TdW.ToggleZoom(FOV, Rate, delay);
            StartZoom(FOV, Rate, delay);
        }
    }
    //return;    
}

function AdjustFOV(float DeltaTime)
{
    local float DeltaFOV;

    FOVZoomDelay -= DeltaTime;
    // End:0xAA
    if((FOVAngle != DesiredFOV) && FOVZoomDelay <= 0.0)
    {
        FOVZoomDelay = 0.0;
        // End:0x9F
        if(FOVZoomRate > 0.0)
        {
            DeltaFOV = FOVZoomRate * DeltaTime;
            // End:0x83
            if(FOVAngle > DesiredFOV)
            {
                FOVAngle = FMax(DesiredFOV, FOVAngle - DeltaFOV);
            }
            // End:0x9C
            else
            {
                FOVAngle = FMin(DesiredFOV, FOVAngle + DeltaFOV);
            }
        }
        // End:0xAA
        else
        {
            FOVAngle = DesiredFOV;
        }
    }
    //return;    
}

simulated function StartZoom(float NewDesiredFOV, float NewZoomRate, float delay)
{
    FOVZoomRate = NewZoomRate;
    DesiredFOV = NewDesiredFOV;
    FOVZoomDelay = delay;
    //return;    
}

reliable client simulated function ClientStopZoom()
{
    DesiredFOV = FOVAngle;
    FOVZoomRate = 0.0;
    //return;    
}

// Export UTdPlayerController::execSetNearClippingPlane(FFrame&, void* const)
native simulated function SetNearClippingPlane(float Value);

simulated function EndZoom()
{
    DesiredFOV = DefaultFOV;
    FOVAngle = DefaultFOV;
    FOVZoomRate = 0.0;
    //return;    
}

simulated event UnZoom()
{
    local TdWeapon TdW;
    local float FOV, Rate;

    TdW = TdWeapon(Pawn.Weapon);
    // End:0x78
    if((TdW != none) && TdW.IsZoomingOrZoomed())
    {
        TdW.ZoomOut(FOV, Rate);
        StartZoom(DefaultFOV, Rate, 0.0);
    }
    // End:0x8E
    else
    {
        DesiredFOV = DefaultFOV;
        FOVZoomRate = 20.0;
    }
    //return;    
}

reliable client simulated function ClientEndZoom()
{
    EndZoom();
    //return;    
}

reliable client simulated function ClientSetOnlineStatus()
{
    local array<LocalizedStringSetting> StringSettings;
    local array<SettingsProperty> Properties;
    local int StatusId, ControllerId;
    local LocalizedStringSetting StringSetting;

    ControllerId = LocalPlayer(Player).ControllerId;
    StatusId = 0;
    // End:0x38
    if(IsInMainMenu())
    {
        StatusId = 1;
    }
    // End:0x15E
    else
    {
        // End:0xF7
        if((class<TdSPStoryGame>(WorldInfo.GRI.GameClass) != none) || class<TdSPTutorialGame>(WorldInfo.GRI.GameClass) != none)
        {
            // End:0xB1
            if(class<TdSPLevelRace>(WorldInfo.GRI.GameClass) != none)
            {
                StatusId = 4;
            }
            // End:0xB9
            else
            {
                StatusId = 2;
            }
            StringSetting.Id = 1;
            StringSetting.ValueIndex = GetMapId();
            StringSettings.AddItem(StringSetting);
        }
        // End:0x15E
        else
        {
            // End:0x15E
            if(class<TdSPTimeTrialGame>(WorldInfo.GRI.GameClass) != none)
            {
                StatusId = 3;
                StringSetting.Id = 0;
                StringSetting.ValueIndex = GetMapId(true);
                StringSettings.AddItem(StringSetting);
            }
        }
    }
    OnlineSub.PlayerInterface.SetOnlineStatus(byte(ControllerId), StatusId, StringSettings, Properties);
    //return;    
}

function int GetMapId(optional bool TimeTrial)
{
    local array<PresBind> PresBindings;
    local TdGameUISceneClient SceneClient;
    local UIDataStore_TdTimeTrialData TTDataStore;
    local int Idx;

    // End:0x91
    if(WorldInfo.IsConsoleBuild())
    {
        PresBindings = class'TpPresenceManager'.default.PresenceBindings;
        Idx = 0;
        J0x31:
        // End:0x8E [Loop If]
        if(Idx < PresBindings.Length)
        {
            // End:0x84
            if(PresBindings[Idx].LevelName ~= WorldInfo.GetMapName())
            {
                return PresBindings[Idx].PresenceId;
            }
            ++ Idx;
            // [Loop Continue]
            goto J0x31;
        }
    }
    // End:0x128
    else
    {
        SceneClient = TdGameUISceneClient(GetUIController().SceneClient);
        // End:0xF3
        if(TimeTrial)
        {
            TTDataStore = UIDataStore_TdTimeTrialData(SceneClient.FindDataStore('TdTimeTrialData'));
            return TTDataStore.GetCurrentWorkingStretchProviderIndex();
        }
        return SceneClient.GetGameDataStore().GetMapIndexFromFileName(WorldInfo.GetMapName());
    }
    //return ReturnValue;    
}

