function Initialize(TdGameUISceneClient SClient, LocalPlayer Owner)
{
    SceneClient = SClient;
    PlayerOwner = Owner;
    OnlineSub = class'GameEngine'.static.GetOnlineSubsystem();
    // End:0x4C
    if(OnlineSub != none)
    {
        PlayerInterface = OnlineSub.PlayerInterface;
    }
    SystemBase = class'TpSystemBase'.static.Get();
    // End:0x1E9
    if(SystemBase != none)
    {
        Connection = SystemBase.GetConnection();
        Connection.__OnConnectionReady__Delegate = OnConnectionReady;
        Connection.__OnConnectionFailed__Delegate = OnConnectionFailed;
        Connection.__OnLoginReady__Delegate = OnLoginReady;
        Connection.__OnDisplayPersonas__Delegate = OnDisplayPersonas;
        Connection.__OnGetTOS__Delegate = OnGetTOS;
        Connection.__OnDisconnect__Delegate = OnDisconnect;
        Connection.__OnDisplayCountrySelect__Delegate = OnDisplayCountrySelect;
        Connection.__OnCreateAccountReady__Delegate = OnCreateAccountReady;
        Connection.__OnCreateAccountError__Delegate = OnCreateAccountError;
        Connection.__OnLoginPersonaError__Delegate = OnLoginPersonaError;
        Connection.__OnCreatePersonaError__Delegate = OnCreatePersonaError;
        Connection.__OnLoginAccountError__Delegate = OnLoginAccountError;
        Connection.__OnDisplayConfirmMessage__Delegate = OnDisplayConfirmMessage;
        Connection.__OnDisplayParentalEmail__Delegate = OnDisplayParentalEmail;
    }
    LatestCreatedPersona = "";
    AccountLoginPC = class'TdHUDContent'.static.GetUISceneByName('TdAccountLoginPC', "TdMenuContent.TdHUDContentMainMenu");
    TOS = class'TdHUDContent'.static.GetUISceneByName('TdTOS', "TdMenuContent.TdHUDContentMainMenu");
    CreateAccountConsole = class'TdHUDContent'.static.GetUISceneByName('TdCreateAccountConsole', "TdMenuContent.TdHUDContentMainMenu");
    CreateAccountConfirm = class'TdHUDContent'.static.GetUISceneByName('TdCreateAccountConfirm', "TdMenuContent.TdHUDContentMainMenu");
    CreateAccountPC = class'TdHUDContent'.static.GetUISceneByName('TdCreateAccountPC', "TdMenuContent.TdHUDContentMainMenu");
    OnlineCheck = class'TdHUDContent'.static.GetUISceneByName('TdOnlineCheck', "TdMenuContent.TdHUDContentMainMenu");
    CreatePersonaScene = class'TdHUDContent'.static.GetUISceneByName('TdCreatePersona', "TdMenuContent.TdHUDContentMainMenu");
    ParentalEmailScene = class'TdHUDContent'.static.GetUISceneByName('TdParentalEmail', "TdMenuContent.TdHUDContentMainMenu");
    OnlineSub.SystemInterface.AddConnectionStatusChangeDelegate(OnConnectionChange);
    //return;    
}

function Finalize()
{
    OnlineSub.SystemInterface.ClearConnectionStatusChangeDelegate(OnConnectionChange);
    SceneClient = none;
    OnlineSub = none;
    PlayerInterface = none;
    SystemBase = none;
