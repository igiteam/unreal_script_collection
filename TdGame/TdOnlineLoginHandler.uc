private final function OnSuccess()
{
    local TpAssociationManager AssociationManager;

    AssociationManager = SystemBase.GetAssociationManager();
    // End:0x65
    if(AssociationManager.IsFriendsListLoaded())
    {
        PlayerInterface.ClearReadFriendsCompleteDelegate(byte(LocalUserNum), OnFriendsListLoaded);
        CloseModalBox(OnSucces_ClosedModal);
    }
    //return;    
}

private final function OnSucces_ClosedModal()
{
    // End:0x32
    if(NotEqual_InterfaceInterface(CreateAccountInstance, (none)))
    {
        CreateAccountInstance.CreateAccountDone(0);
        CreateAccountInstance = none;
    }
    OnConnectedAndFriendsLoaded(2);
    bIsInLoginProcess = false;
    //return;    
}

private final function OnFailure(bool UserAbort)
{
    PlayerInterface.ClearReadFriendsCompleteDelegate(byte(LocalUserNum), OnFriendsListLoaded);
    // End:0x7D
    if(!UserAbort)
    {
        // End:0x5B
        if(ConnectionRequired)
        {
            SceneClient.OpenMessageBox(OnFailure_Disconnect_MsgBoxInit, 2);
        }
        // End:0x7A
        else
        {
            SceneClient.OpenMessageBox(OnFailure_ShowOffline_MsgBoxInit, 2);
        }
    }
    // End:0x8E
    else
    {
        // End:0x8E
        if(!ConnectionRequired)
        {
            ShowOffline();
        }
    }
    bIsInLoginProcess = false;
    //return;    
}

private final function OnFailure_Disconnect_MsgBoxInit(UIScene OpenedScene, bool bInitialActivation)
{
    local string LocTitle, LocMessage;

    LocMessage = SystemBase.GetLatestError().LocErrorString;
    LocTitle = Localize("TpErrors", "Failed_Connect_Title", "TdGameUI");
    TdUIScene_MessageBox(OpenedScene).DisplayAcceptBox(LocMessage, LocTitle, OnDisconnect_MessageBoxCallback);
    //return;    
}

private final function OnFailure_ShowOffline_MsgBoxInit(UIScene OpenedScene, bool bInitialActivation)
{
    local string LocTitle, LocMessage;

    LocMessage = SystemBase.GetLatestError().LocErrorString;
    LocTitle = Localize("TpErrors", "Failed_Connect_Title", "TdGameUI");
    TdUIScene_MessageBox(OpenedScene).DisplayAcceptBox(LocMessage, LocTitle, OnShowOffline_MessageBoxCallback);
    //return;    
}

private final function ShowOffline()
{
    SceneClient.OpenSceneEx(OnlineCheck, PlayerOwner, 2, OnlineCheck_Opened);
    //return;    
}

private final function OnlineCheck_Opened(UIScene OpenedScene, bool bInitialActivation)
{
    TdUIScene_OnlineCheck(OpenedScene).__PlayOffline__Delegate = PlayOfflineCallback;
    //return;    
}

private final function PlayOfflineCallback()
{
    OnPlayOffline(2);
    bIsInLoginProcess = false;
    __OnPlayOffline__Delegate = None;
    //return;    
}

private final function OnDisconnect_MessageBoxCallback(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    Disconnect();
    //return;    
}

private final function OnShowOffline_MessageBoxCallback(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    ShowOffline();
    //return;    
}

private final function OnConfirmMessage_MessageBoxCallback(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    Connection.ConfirmMessage();
    //return;    
}

private final function OnRepromptDisplay_MessageBoxCallback(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    Connection.RepromptDisplay();
    //return;    
}

private final function OnModalBoxCancel_MessageBoxCallback(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    ModalConnectingMessageBox = none;
    // End:0x18
    if(!ConnectionRequired)
    {
        UserAbort();
    }
    //return;    
}

private final function OnModalBoxPreSelecting()
{
    // End:0x11
    if(ConnectionRequired)
    {
        bIsInLoginProcess = false;
    }
    //return;    
}

private final function OnCreatePersonaDone_MessageBoxCallback(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    LoginPersona(LatestCreatedPersona);
    //return;    
}

private final function ShowModalBox(delegate<OnModalBoxOpened> ModalBoxOpened, optional Engine.UIScene.ESceneTransitionAnim SceneAnim)
{
    SceneAnim = 0;
    __OnModalBoxOpened__Delegate = ModalBoxOpened;
    // End:0x3E
    if(ModalConnectingMessageBox == none)
    {
        SceneClient.OpenMessageBox(ShowModalBox_MsgBoxInit, SceneAnim);
    }
    //return;    
}

private final function ShowModalBox_MsgBoxInit(UIScene OpenedScene, bool bInitialActivation)
{
    local string LocTitle, LocMessage;

    ModalConnectingMessageBox = TdUIScene_MessageBox(OpenedScene);
    // End:0x129
    if(ModalConnectingMessageBox != none)
    {
        LocTitle = Localize("TdModalConnectingMessageBox", "TitleText", "TdGameUI");
        LocMessage = Localize("TdModalConnectingMessageBox", "DescriptionText", "TdGameUI");
        ModalConnectingMessageBox.bRequiresOnlineService = true;
        ModalConnectingMessageBox.__OnNotifyOptionSelected__Delegate = OnNotifyModalBoxCancel;
        ModalConnectingMessageBox.DisplayCancelBox(LocMessage, LocTitle, OnModalBoxCancel_MessageBoxCallback);
        ModalConnectingMessageBox.__OnPreSelecting__Delegate = OnModalBoxPreSelecting;
        ModalConnectingMessageBox.__OnSceneFullyOpened__Delegate = OnModalBoxFullyOpened;
    }
    //return;    
}

function OnNotifyModalBoxCancel(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    local TpProtoHTTP ProtoHTTP;

    ProtoHTTP = SystemBase.GetProtoHTTP();
    ProtoHTTP.__OnGetVersion__Delegate = None;
    Connection.DisconnectAsync();
    //return;    
}

private final function OnModalBoxFullyOpened(UIScene OpenedScene)
{
    OnModalBoxOpened();
    __OnModalBoxOpened__Delegate = None;
    //return;    
}

private final function CloseModalBox(delegate<OnModalBoxClosed> ModalBoxClosed)
{
    __OnModalBoxClosed__Delegate = ModalBoxClosed;
    // End:0x5B
    if(ModalConnectingMessageBox != none)
    {
        ModalConnectingMessageBox.SceneTransitionAnimOveride = 1;
        ModalConnectingMessageBox.__OnClosed__Delegate = ModalBoxAboutToDie;
        ModalConnectingMessageBox.Close();
    }
    // End:0x61
    else
    {
        ModalBoxAboutToDie();
    }
    //return;    
}

private final function ModalBoxAboutToDie()
{
    OnModalBoxClosed();
    __OnModalBoxClosed__Delegate = None;
    ModalConnectingMessageBox = none;
    //return;    
}
