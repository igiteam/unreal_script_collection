    Connection.__OnLoginAccountError__Delegate = None;
    Connection.__OnDisplayConfirmMessage__Delegate = None;
    Connection.__OnDisplayParentalEmail__Delegate = None;
    Connection = none;
    //return;    
}

function OnConnectionChange(Engine.OnlineSubsystem.EOnlineServerConnectionStatus ConnectionStatus)
{
    // End:0x35
    if(ConnectionStatus == 0)
    {
        PlayerInterface.ClearReadFriendsCompleteDelegate(byte(LocalUserNum), OnFriendsListLoaded);
    }
    //return;    
}

function bool IsInLoginProcess()
{
    return bIsInLoginProcess;
    //return ReturnValue;    
}

function StartConnection(bool IsConnectionRequired)
{
    ModalConnectingMessageBox = none;
    ConnectionRequired = IsConnectionRequired;
    bSkipSilentLoginAccount = false;
    // End:0x47
    if(Connection.IsLoggedIn())
    {
        OnConnectedAndFriendsLoaded(0);
    }
    // End:0x5F
    else
    {
        bIsInLoginProcess = true;
        ShowModalBox(VerifyVersion);
    }
    //return;    
}

function VerifyVersion()
{
    local TpProtoHTTP ProtoHTTP;
    local string Param;

    Param = (("?key=" $ class'TdEADMPatcherWrapper'.static.GetCDKey()) $ "&suffix=") $ string(class'TdEADMPatcherWrapper'.static.GetParamSuffix());
    ProtoHTTP = SystemBase.GetProtoHTTP();
    ProtoHTTP.__OnGetVersion__Delegate = OnVerifyVersion;
    ProtoHTTP.GetCurrentVersion(Param);
    //return;    
}

private final function OnVerifyVersion(string CurrentVersion)
{
    local TpProtoHTTP ProtoHTTP;

    ProtoHTTP = SystemBase.GetProtoHTTP();
    ProtoHTTP.__OnGetVersion__Delegate = None;
    // End:0x53
    if(CurrentVersion == "-1")
    {
        CloseModalBox(ShowNoConnection);
    }
    // End:0x8B
    else
    {
        // End:0x7C
        if(class'TdEADMPatcherWrapper'.static.IsLocalVersionNewerThan(CurrentVersion))
        {
            OnStartConnection();
        }
        // End:0x8B
        else
        {
            CloseModalBox(ShowBadVersion);
        }
    }
    //return;    
}

