private final function ShowNoConnection_Init(UIScene OpenedScene, bool bInitialActivation)
{
    local string MessageTitle, MessageBody;
    local TdUIScene_MessageBox Scene;

    Scene = TdUIScene_MessageBox(OpenedScene);
    MessageTitle = Localize("TpErrors", "Failed_Connect_Title", "TdGameUI");
    MessageBody = Localize("TpErrors", "Failed_Connect_Body", "TdGameUI");
    Scene.DisplayAcceptCancelBox(MessageBody, MessageTitle, OnShowBadVersion_Response);
    //return;    
}

private final function ShowBadVersion()
{
    SceneClient.OpenMessageBox(ShowBadVersion_Init, 2);
    //return;    
}

private final function ShowBadVersion_Init(UIScene OpenedScene, bool bInitialActivation)
{
    local string MessageTitle, MessageBody;
    local TdUIScene_MessageBox Scene;

    Scene = TdUIScene_MessageBox(OpenedScene);
    // End:0xBF
    if(class'TdEADMPatcherWrapper'.static.IsEADMInstalled())
    {
        MessageTitle = Localize("TpErrors", "Bad_Version_Title", "TdGameUI");
        MessageBody = Localize("TpErrors", "Bad_Version_EADM", "TdGameUI");
        Scene.DisplayAcceptCancelBox(MessageBody, MessageTitle, OnShowBadVersion_Response);
    }
    // End:0x155
    else
    {
        MessageTitle = Localize("TpErrors", "Bad_Version_Title", "TdGameUI");
        MessageBody = Localize("TpErrors", "Bad_Version_NoEADM", "TdGameUI");
        Scene.DisplayAcceptBox(MessageBody, MessageTitle, OnShowBadVersion_Response);
    }
    //return;    
}

private final function OnShowBadVersion_Response(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    // End:0x22
    if(SelectedOption == 1)
    {
        class'TdEADMPatcherWrapper'.static.StartPatching();
    }
    // End:0x29
    else
    {
        OnFailure(true);
    }
    //return;    
}

function OnStartConnection()
{
    local string EncLogin, Persona;
    local TdProfileSettings ProfileSettings;

    // End:0x77
    if(NotEqual_InterfaceInterface(PlayerInterface, (none)))
    {
        ProfileSettings = TdProfileSettings(PlayerInterface.GetProfileSettings(byte(LocalUserNum)));
        ProfileSettings.GetProfileSettingValue(700, EncLogin);
        ProfileSettings.GetProfileSettingValue(701, Persona);
    }
    Connection.ConnectSilentAsync(EncLogin, Persona);
    PlayerInterface.AddReadFriendsCompleteDelegate(byte(LocalUserNum), OnFriendsListLoaded);
    //return;    
}

