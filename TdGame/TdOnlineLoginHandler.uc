private final function CreateAccountConsole_Opened(UIScene OpenedScene, bool bInitialActivation)
{
    local TdUIScene_CreateAccountConsole CreateAccountConsoleScene;

    CreateAccountConsoleScene = TdUIScene_CreateAccountConsole(OpenedScene);
    CreateAccountConsoleScene.SetValues(EmailStrParam, PasswdStrParam, bAcceptEAMailParam, bAcceptThirdPartyMailParam);
    CreateAccountConsoleScene.__ConfirmCreateAccountConsole__Delegate = ConfirmCreateAccountConsole;
    CreateAccountConsoleScene.__UserAbort__Delegate = UserAbort;
    CreateAccountInstance = CreateAccountConsoleScene;
    //return;    
}

private final function CreateAccountPC_Opened(UIScene OpenedScene, bool bInitialActivation)
{
    local TdUIScene_CreateAccountPC CreateAccountPCScene;
    local int Idx;

    CreateAccountPCScene = TdUIScene_CreateAccountPC(OpenedScene);
    CreateAccountPCScene.SetValues(bAcceptEAMailParam, bAcceptThirdPartyMailParam);
    CreateAccountPCScene.__UserAbort__Delegate = UserAbort;
    CreateAccountPCScene.__CreateAccountOnPC__Delegate = CreateAccountOnPC;
    CreateAccountPCScene.LoginData.AccountProvider.ClearCountries();
    Idx = 0;
    J0x91:
    // End:0x12B [Loop If]
    if(Idx < TOSCountries.Length)
    {
        CreateAccountPCScene.LoginData.AccountProvider.AddCountry(TOSCountries[Idx].Description, TOSCountries[Idx].ISOCode, TOSCountries[Idx].RegistrationAgeLimit, TOSCountries[Idx].ParentalControlAgeLimit);
        ++ Idx;
        // [Loop Continue]
        goto J0x91;
    }
    CreateAccountPCScene.LoginData.RefreshSubscribers();
    CreateAccountInstance = CreateAccountPCScene;
    //return;    
}

