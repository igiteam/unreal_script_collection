private final function OnConnectionReady(string EncLogin, string Persona)
{
    local TdProfileSettings ProfileSettings;

    // End:0xCC
    if(((!SceneClient.IsConsole() && NotEqual_InterfaceInterface(PlayerInterface, (none))) && EncLogin != "") && Persona != "")
    {
        ProfileSettings = TdProfileSettings(PlayerInterface.GetProfileSettings(byte(LocalUserNum)));
        ProfileSettings.SetProfileSettingValue(700, EncLogin);
        ProfileSettings.SetProfileSettingValue(701, Persona);
        PlayerInterface.WriteProfileSettings(byte(LocalUserNum), ProfileSettings);
    }
    OnSuccess();
    //return;    
}

