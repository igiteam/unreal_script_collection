class TdValveSkeletalMeshActor extends SkeletalMeshActor
    hidecategories(Navigation);

simulated function PlayAnimation(name AnimSeqName, float Rate)
{
    local TdAnimNodeSequence ValveSeqNode;

    ValveSeqNode = TdAnimNodeSequence(SkeletalMeshComponent.FindAnimNode('ValveAnimation'));
    // End:0xA3
    if(ValveSeqNode != none)
    {
        ValveSeqNode.bIgnoreRootOffset = true;
        ValveSeqNode.SetAnim(AnimSeqName);
        ValveSeqNode.PlayAnim(false, Rate, ((Rate > 0.0) ? 0.0 : ValveSeqNode.AnimSeq.SequenceLength));
    }
    //return;    
}

simulated function AddValveRoll(int RollValue)
{
    local SkelControlSingleBone ValveControl;

    ValveControl = SkelControlSingleBone(SkeletalMeshComponent.FindSkelControl('ValveController'));
    // End:0x50
    if(ValveControl != none)
    {
        ValveControl.BoneRotation.Roll += RollValue;
    }
    //return;    
}

