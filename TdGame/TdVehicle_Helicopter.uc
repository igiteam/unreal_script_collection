function Initialize(TdAI_HeliController C)
{
    myController = C;
    SetPhysics(0);
    StartDustEffect();
    //return;    
}

event int AddGunner(Pawn Pawn)
{
    local TdPawn P;
    local int I;
    local TdAIController C;

    I = 0;
    J0x07:
    // End:0xF5 [Loop If]
    if(I < Seats.Length)
    {
        // End:0xEB
        if(Seats[I].StoragePawn == none)
        {
            P = TdPawn(Pawn);
            C = TdAIController(P.Controller);
            // End:0x7C
            if(C != none)
            {
                C.AbortMoveTo();
            }
            P.SetAsGunner(self, I, Seats[I].LocOffset, Seats[I].YawOffset);
            Seats[I].StoragePawn = Pawn;
            ++ NumberOfGunners;
            return I;
        }
        ++ I;
        // [Loop Continue]
        goto J0x07;
    }
    return -1;
    //return ReturnValue;    
}

function Pawn GetGunner(int Index)
{
    // End:0x27
    if(Index < Seats.Length)
    {
        return Seats[Index].StoragePawn;
    }
    return none;
    //return ReturnValue;    
}

function int GetNumberOfGunners()
{
    return NumberOfGunners;
    //return ReturnValue;    
}

function StartDustEffect()
{
    local ParticleSystem PS;

    HeliDustEffectEmitter = Spawn(class'TdEmitter', self);
    HeliDustEffectEmitter.bDestroyOnSystemFinish = false;
    HeliDustEffectEmitter.LifeSpan = 0.0;
    PS = particlesystem'PS_FX_LevelFX_Smoke_Heli_AiHeli_01';
    // End:0xB2
    if((HeliDustEffectEmitter != none) && PS != none)
    {
        HeliDustEffectEmitter.SetTemplate(PS);
        HeliDustEffectEmitter.SetHidden(false);
        HeliDustEffectEmitter.ParticleSystemComponent.ActivateSystem();
        bIsHeliDustEffectActive = true;
    }
    // End:0xBA
    else
    {
        bIsHeliDustEffectActive = true;
    }
    //return;    
}

