class TdMove_Cutscene extends TdPhysicsMove
    config(PawnMovement);

var Vector TargetLocation;
var Rotator TargetRotation;

function bool CanDoMove()
{
    return true;
    //return ReturnValue;    
}

simulated function StartMove()
{
    local Vector ToTarget;
    local float TimeToTarget;

    super.StartMove();
    ToTarget = TargetLocation - PawnOwner.Location;
    TimeToTarget = VSize2D(ToTarget) / 250.0;
    // End:0x7E
    if(TimeToTarget > 0.40)
    {
        SetPreciseRotation(rotator(ToTarget), 0.20);
        SetMoveTimer(TimeToTarget - 0.30, false, 'AlignToTargetRotation');
    }
    // End:0x8E
    else
    {
        SetPreciseRotation(TargetRotation, 0.20);
    }
    SetPreciseLocation(TargetLocation, 0, 250.0);
    //return;    
}

simulated function StopMove()
{
    super.StopMove();
    //return;    
}

simulated event ReachedPreciseLocation()
{
    PawnOwner.Velocity = vect(0.0, 0.0, 0.0);
    PawnOwner.Acceleration = vect(0.0, 0.0, 0.0);
    PawnOwner.SetMove(1);
    //return;    
}

simulated function AlignToTargetRotation()
{
    SetPreciseRotation(TargetRotation, 0.20);
    //return;    
}

simulated function Landed(Vector aNormal, Actor anActor)
{
    //return;    
}

defaultproperties
{
    PawnPhysics=PHYS_Flying
    bDisableCollision=true
    DisableMovementTime=-1.0
    DisableLookTime=-1.0
}