simulated function AttachWeaponEffects(TdSkeletalMeshComponent SKMesh)
{
    local Vector SightLocation;
    local Rotator SightRotation;

    super(TdWeapon).AttachWeaponEffects(SKMesh);
    // End:0x2C1
    if((Instigator != none) && !Instigator.IsHumanControlled())
    {
        // End:0x66
        if(!SKMesh.GetSocketWorldLocationAndRotation(LaserSightSocket, SightLocation, SightRotation))
        {
            SightLocation = Owner.Location;
        }
        LaserBeamEmitter = Spawn(class'TdEmitter');
        LaserBeamEmitter.SetTemplate(LaserBeamTemplate, false);
        LaserBeamEmitter.bDestroyOnSystemFinish = false;
        LaserBeamEmitter.LifeSpan = 0.0;
        LaserBeamEmitter.bStasis = false;
        LaserBeamEmitter.SetHidden(false);
        LaserBeamEmitter.SetLocation(SightLocation);
        LaserBeamEmitter.SetRotation(SightRotation);
        LaserBeamEmitter.SetDrawScale3D(vect(1.0, 1.0, 1.0));
        LaserBeamEmitter.ParticleSystemComponent.ActivateSystem();
        LaserSourceLensFlare = Spawn(class'TdLensFlareSource');
        LaserSourceLensFlare.SetTemplate(LaserSourceLensFlareTemplate);
        LaserSourceLensFlare.LifeSpan = 0.0;
        LaserSourceLensFlare.bStasis = false;
        LaserSourceLensFlare.SetHidden(false);
        LaserSourceLensFlare.SetLocation(SightLocation);
        LaserSourceLensFlare.SetRotation(SightRotation);
        LaserSourceLensFlare.SetDrawScale3D(vect(1.0, 1.0, 1.0));
        LaserHitEmitter = Spawn(class'TdEmitter');
        LaserHitEmitter.SetTemplate(LaserHitTemplate, false);
        LaserHitEmitter.bDestroyOnSystemFinish = false;
        LaserHitEmitter.LifeSpan = 0.0;
        LaserHitEmitter.bStasis = false;
        LaserHitEmitter.SetHidden(true);
        LaserHitEmitter.SetLocation(SightLocation);
        LaserHitEmitter.SetRotation(SightRotation);
        LaserHitEmitter.SetDrawScale3D(vect(1.0, 1.0, 1.0));
        LaserHitEmitter.ParticleSystemComponent.ActivateSystem();
        LasersAttached = true;
    }
    //return;    
}

simulated function DetachWeaponEffects(TdSkeletalMeshComponent SKMesh)
{
    super(TdWeapon).DetachWeaponEffects(SKMesh);
    // End:0x79
    if(LasersAttached)
    {
        // End:0x33
        if(LaserBeamEmitter != none)
        {
            LaserBeamEmitter.Destroy();
            LaserBeamEmitter = none;
        }
        // End:0x52
        if(LaserSourceLensFlare != none)
        {
            LaserSourceLensFlare.Destroy();
            LaserSourceLensFlare = none;
        }
        // End:0x71
        if(LaserHitEmitter != none)
        {
            LaserHitEmitter.Destroy();
            LaserHitEmitter = none;
        }
        LasersAttached = false;
    }
    //return;    
}

simulated function InitiateScopeEffect()
{
    local LocalPlayer LocPlayer;

    LocPlayer = LocalPlayer(PlayerController(Instigator.Controller).Player);
    // End:0x36
    if(LocPlayer == none)
    {
        return;
    }
    // End:0x79
    if(LocPlayer.PlayerPostProcess != none)
    {
        ScopeEffect = MaterialEffect(LocPlayer.PlayerPostProcess.FindPostProcessEffect('ScopeEffect'));
    }
    // End:0xE1
    if(ScopeEffect != none)
    {
        ScopeEffectMaterialInstance = new (none) class'MaterialInstanceConstant';
        ScopeEffectMaterialInstance.SetParent(ScopeEffect.Material);
        ScopeEffect.Material = ScopeEffectMaterialInstance;
        ScopeEffect.bShowInGame = false;
        J0xE1:
    }
    // End:0xE1
    else
    {
    }
    //return;    
}

simulated function Tick(float DeltaTime)
{
    super(Actor).Tick(DeltaTime);
    // End:0x70
    if(Instigator != none)
    {
        // End:0x5D
        if(Instigator.IsHumanControlled())
        {
            // End:0x5A
            if(IsZoomingOrZoomed())
            {
                // End:0x4B
                if(ScopeEffect == none)
                {
                    InitiateScopeEffect();
                }
                TickScopeEffect(DeltaTime);
            }
        }
        // End:0x70
        else
        {
            // End:0x70
            if(LasersAttached)
            {
                TickLaserBeam();
            }
        }
    }
    //return;    
}

function TickLaserBeam()
{
    local editinline SkeletalMeshComponent WeaponMesh;
    local TdAimBotSniper AimBot;
    local Vector SightLocation;
    local Rotator SightRotation;
    local Vector TargetLocation, HitLocation, HitNormal;
    local float TracedDistance;
    local TraceHitInfo HitInfo;
    local Actor HitActor;
    local Vector ScaleVec;
    local TdAI_Sniper Sniper;
    local Vector LaserDir, BullitDir, AimLocation, BullitStartLocation;
    local int MaxRecursions;

    Sniper = TdAI_Sniper(Instigator.Controller);
    // End:0x4BA
    if((Sniper != none) && Sniper.LaserActive())
    {
        WeaponMesh = SkeletalMeshComponent(Mesh);
        // End:0x4B7
        if((WeaponMesh != none) && LaserSightSocket != 'None')
        {
            // End:0xA7
            if(!WeaponMesh.GetSocketWorldLocationAndRotation(LaserSightSocket, SightLocation, SightRotation))
            {
                SightLocation = Owner.Location;
            }
            BullitStartLocation = Sniper.GetWeaponStartTraceLocation();
            AimLocation = Sniper.AimBot.GetAimLocation(none);
            BullitDir = Normal(AimLocation - BullitStartLocation);
            TargetLocation = BullitStartLocation + (BullitDir * (VSize(Sniper.Location - Sniper.Player.Location) + float(3000)));
            HitActor = GetTraceOwner().Trace(HitLocation, HitNormal, TargetLocation, BullitStartLocation, true, vect(0.0, 0.0, 0.0), HitInfo, 8);
            MaxRecursions = 3;
            J0x18D:
            // End:0x233 [Loop If]
            if(((MaxRecursions > 0) && HitActor != none) && HitActor.bIgnoreForAITraces || HitInfo.HitComponent.bIsTransparentToPlayerAndAI)
            {
                HitActor = GetTraceOwner().Trace(HitLocation, HitNormal, TargetLocation, HitLocation + (BullitDir * 5.0), true, vect(0.0, 0.0, 0.0), HitInfo, 8);
                -- MaxRecursions;
                // [Loop Continue]
                goto J0x18D;
            }
            // End:0x25D
            if(HitActor == none)
            {
                LaserHitEmitter.SetHidden(true);
                HitLocation = TargetLocation;
            }
            // End:0x29A
            else
            {
                // End:0x289
                if(HitActor.IsA('TdPlayerPawn'))
                {
                    LaserHitEmitter.SetHidden(true);
                }
                // End:0x29A
                else
                {
                    LaserHitEmitter.SetHidden(false);
                }
            }
            TracedDistance = VSize(HitLocation - SightLocation);
            LaserDir = Normal(HitLocation - SightLocation);
            // End:0x30C
            if(VSize(LaserDir Cross (Sniper.PlayerController.PlayerCamera.Location - SightLocation)) < float(90))
            {
                LaserBeamFadeParameter = 0.0;
            }
            // End:0x317
            else
            {
                LaserBeamFadeParameter = 1.0;
            }
            // End:0x353
            if((LaserDir Dot vector(SightRotation)) < 0.90)
            {
                LaserBeamEmitter.SetHidden(true);
                LaserHitEmitter.SetHidden(true);
                return;
            }
            ScaleVec = vect(1.0, 0.250, 0.250);
            ScaleVec.X = TracedDistance / 6000.0;
            LaserBeamEmitter.SetHidden(false);
            LaserBeamEmitter.SetLocation(HitLocation);
            LaserBeamEmitter.SetRotation(rotator(-LaserDir));
            LaserBeamEmitter.SetDrawScale3D(ScaleVec);
            LaserBeamEmitter.SetFloatParameter('TilingScale', ScaleVec.X);
            LaserBeamEmitter.SetFloatParameter('FX_LaserBeamDistanceFade', LaserBeamFadeParameter);
            LaserSourceLensFlare.SetHidden(false);
            LaserSourceLensFlare.SetLocation(SightLocation);
            LaserSourceLensFlare.SetRotation(rotator(LaserDir));
            LaserHitEmitter.SetLocation(HitLocation);
            LaserHitEmitter.SetRotation(rotator(HitNormal));
            AimBot = TdAimBotSniper(Sniper.AimBot);
            // End:0x4B7
            if(AimBot != none)
            {
                AimBot.DistanceToLaserPoint = TracedDistance;
            }
        }
    }
    // End:0x4ED
    else
    {
        LaserBeamEmitter.SetHidden(true);
        LaserSourceLensFlare.SetHidden(true);
        LaserHitEmitter.SetHidden(true);
    }
    //return;    
}

simulated function TickScopeEffect(float DeltaTime)
{
    local bool bShouldDrawOverlay;
    local float FOVDelay;

    bShouldDrawOverlay = false;
    // End:0xBE
    if(bZoomed)
    {
        // End:0xA8
        if(!bWasZoomed)
        {
            bWasZoomed = bZoomed;
            bIsZooming = true;
            FOVDelay = (class'TdPlayerCamera'.default.DefaultFOV - ZoomFOV) / ZoomRate;
            TdHUD(TdPlayerController(Instigator.Controller).myHUD).TriggerCustomBlink(ZoomDelay, FOVDelay);
            SetTimer(ZoomDelay, false, 'DoneZoomingIn');
        }
        // End:0xBB
        else
        {
            // End:0xBB
            if(!bIsZooming)
            {
                bShouldDrawOverlay = true;
            }
        }
    }
    // End:0x16C
    else
    {
        // End:0x15B
        if(bWasZoomed)
        {
            bWasZoomed = bZoomed;
            bIsZooming = true;
            bShouldDrawOverlay = true;
            FOVDelay = (class'TdPlayerCamera'.default.DefaultFOV - ZoomFOV) / ZoomRate;
            TdHUD(TdPlayerController(Instigator.Controller).myHUD).TriggerCustomBlink(FOVDelay, ZoomDelay);
            SetTimer(FOVDelay, false, 'DoneZoomingOut');
        }
        // End:0x16C
        else
        {
            // End:0x16C
            if(bIsZooming)
            {
                bShouldDrawOverlay = true;
            }
        }
    }
    // End:0x1CE
    if(bShouldDrawOverlay)
    {
        ScopeEffectMaterialInstance.SetScalarParameterValue('FXFScreen_SniperScopeMoveX', 0.50);
        ScopeEffectMaterialInstance.SetScalarParameterValue('FXFScreen_SniperScopeMoveY', 0.50);
        ScopeEffect.bShowInGame = true;
    }
    // End:0x1E0
    else
    {
        ScopeEffect.bShowInGame = false;
    }
    //return;    
}

simulated function Rotator AddSpread(Rotator BaseAim)
{
    local Vector X, Y, Z;
    local float CurrentSpread, RandY, RandZ;

    // End:0x21
    if(!Instigator.IsHumanControlled())
    {
        return super(Weapon).AddSpread(BaseAim);
    }
    CurrentSpread = ((IsZoomingOrZoomed()) ? Spread[CurrentFireMode] : Spread[CurrentFireMode] + AdditionalUnzoomedSpread);
    // End:0x6D
    if(CurrentSpread == float(0))
    {
        return BaseAim;
    }
    // End:0xE5
    else
    {
        GetAxes(BaseAim, X, Y, Z);
        RandY = FRand() - 0.50;
        RandZ = Sqrt(0.50 - Square(RandY)) * (FRand() - 0.50);
        return rotator((X + ((RandY * CurrentSpread) * Y)) + ((RandZ * CurrentSpread) * Z));
    }
    //return ReturnValue;    
}

simulated function bool GetFireAnimName(out name FireAnimName)
{
    // End:0x1D
    if(bZoomed)
    {
        FireAnimName = 'zoomfire';
        return true;
    }
    // End:0x29
    else
    {
        return super(TdWeapon).GetFireAnimName(FireAnimName);
    }
    //return ReturnValue;    
}

simulated function bool IsZoomingOrZoomed()
{
    return bCanZoom && (bZoomed || bWasZoomed) || IsZooming();
    //return ReturnValue;    
}

simulated function bool IsZooming()
{
    return bIsZooming;
    //return ReturnValue;    
}

simulated function bool ToggleZoom(out float outDesiredFOV, out float outZoomRate, out float outDelay)
{
    // End:0x0D
    if(!bCanZoom)
    {
        return false;
    }
    bWasZoomed = bZoomed;
    // End:0x59
    if(!bZoomed && IsInState('Active'))
    {
        outDelay = ZoomDelay;
        ZoomIn(outDesiredFOV, outZoomRate);
    }
    // End:0x78
    else
    {
        outDelay = 0.0;
        ZoomOut(outDesiredFOV, outZoomRate);
    }
    outZoomRate = ZoomRate;
    return bZoomed;
    //return ReturnValue;    
}

simulated function ZoomIn(out float outDesiredFOV, out float outZoomRate)
{
    // End:0x0D
    if(!bCanZoom)
    {
        return;
    }
    bWasZoomed = bZoomed;
    bZoomed = true;
    outDesiredFOV = ZoomFOV;
    outZoomRate = ZoomRate;
    TdPawn(Owner).PlayZoomInAnimation();
    //return;    
}

simulated function ZoomOut(out float outDesiredFOV, out float outZoomRate)
{
    local float ZoomOutDelay;

    // End:0x0D
    if(!bCanZoom)
    {
        return;
    }
    bWasZoomed = bZoomed;
    bZoomed = false;
    outDesiredFOV = class'TdPlayerCamera'.default.DefaultFOV;
    outZoomRate = ZoomRate;
    ZoomOutDelay = (outDesiredFOV - ZoomFOV) / ZoomRate;
    SetTimer(ZoomOutDelay, false, 'PlayZoomOutAnimation');
    //return;    
}

function DoneZoomingOut()
{
    local TdHUD HUD;

    self.Mesh.SetHidden(false);
    TdPawn(Owner).Mesh.SetHidden(false);
    ScopeEffect.bShowInGame = false;
    HUD = TdHUD(TdPlayerController(TdPawn(Owner).Controller).myHUD);
    // End:0x97
    if(HUD != none)
    {
        HUD.ToggleZoomState(false);
    }
    bIsZooming = false;
    // End:0xB2
    if(!bZoomed)
    {
        bWasZoomed = false;
    }
    //return;    
}

function DoneZoomingIn()
{
    local TdHUD HUD;

    self.Mesh.SetHidden(true);
    TdPawn(Owner).Mesh.SetHidden(true);
    HUD = TdHUD(TdPlayerController(TdPawn(Owner).Controller).myHUD);
    // End:0x85
    if(HUD != none)
    {
        HUD.ToggleZoomState(true);
    }
    bIsZooming = false;
    //return;    
}

function PlayZoomOutAnimation()
{
    TdPawn(Owner).PlayZoomOutAnimation();
    //return;    
}

