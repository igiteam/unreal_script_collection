event bool IsElementEnabled(name FieldName, int CollectionIndex)
{
    local OnlineSubsystem OnlineSub;
    local TdProfileSettings Profile;
    local bool bResult;

    bResult = true;
    // End:0xA5
    if(FieldName == 'TdMaps')
    {
        OnlineSub = class'GameEngine'.static.GetOnlineSubsystem();
        // End:0xA5
        if(OnlineSub != none)
        {
            Profile = TdProfileSettings(OnlineSub.PlayerInterface.GetProfileSettings(byte(class'UIInteraction'.static.GetPlayerControllerId(0))));
            // End:0xA5
            if(Profile != none)
            {
                bResult = Profile.IsLevelUnlocked(CollectionIndex);
            }
        }
    }
    return bResult;
    //return ReturnValue;    
}

function StartNewGameWithTutorial(optional bool bPlayCutScene)
{
    local string StartMap, URL;

    StartMap = "tutorial_p";
    URL = ((bPlayCutScene) ? "?PlayCutSceneMovie" : "");
    StartGame(StartMap,, "TdGame.TdSPTutorialGame", URL, true, true);
    //return;    
}

function StartNewGame(bool bShouldSaveCheckpointProgress, bool bAllowSPLevelAchievements)
{
    local string StartMap, Checkpoint;

    StartMap = "Edge_p";
    Checkpoint = "Edge_Start";
    StartGame(StartMap, Checkpoint, "TdGame.TdSPStoryGame",, bShouldSaveCheckpointProgress, bAllowSPLevelAchievements);
    //return;    
}

function StartGame(string LevelName, optional string CheckpointName, optional string GameMode, optional string URL, optional bool bShouldSaveCheckpointProgress, optional bool bAllowSPLevelAchievements)
{
    local string ExecCmd;

    ExecCmd = "start " $ LevelName;
    // End:0x4C
    if(CheckpointName != "")
    {
        ExecCmd $= ("?LoadCheckpoint=" $ CheckpointName);
    }
    // End:0x74
    if(GameMode != "")
    {
        ExecCmd $= ("?Game=" $ GameMode);
    }
    // End:0x9F
    if(bShouldSaveCheckpointProgress)
    {
        ExecCmd $= "?AllowCPSaving=TRUE";
    }
    // End:0xD3
    if(bAllowSPLevelAchievements)
    {
        ExecCmd $= "?AllowLevelAchievements=TRUE";
    }
    ExecCmd $= URL;
    GetCurrentUIController().Outer.ViewportConsole.ConsoleCommand(ExecCmd);
    //return;    
}

function QuitToMainMenu()
{
    local PlayerController PC;
    local WorldInfo World;

    World = class'Engine'.static.GetCurrentWorldInfo();
    // End:0x66
    foreach World.AllControllers(class'PlayerController', PC)
    {
        PC.Reset();
        PC.myHUD.Reset();        
    }    
    StartGame("TdMainMenu",, "TdGame.TdMenuGameInfo",, false, false);
    //return;    
}

function RestartFromLastCheckpoint(optional bool bShouldSaveCheckpointProgress, optional bool bAllowSPLevelAchievements)
{
    local WorldInfo World;
    local TdSPGame SPGame;

    World = class'Engine'.static.GetCurrentWorldInfo();
    SPGame = TdSPGame(World.Game);
    // End:0x51
    if(SPGame != none)
    {
        SPGame.RestartFromLastCheckpoint();
    }
    //return;    
}

event Registered(LocalPlayer PlayerOwner)
{
    super(UIDataStore).Registered(PlayerOwner);
    // End:0x3B
    if(CheckpointManager == none)
    {
        CheckpointManager = new (self) class'TdCheckpointManager';
        CheckpointManager.Initialize(self);
    }
    //return;    
}

