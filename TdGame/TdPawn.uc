{
    local TdWeapon WP;

    // End:0x51
    if(MyWeapon != none)
    {
        WP = MyWeapon;
        WP.LOIDisplayEffectTime = EffectDisplayTime;
        WP.LOIOriginalDisplayEffectTime = EffectDisplayTime;
        WP.LOINotify(true);
    }
    //return;    
}

