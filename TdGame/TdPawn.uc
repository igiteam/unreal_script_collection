        Mesh1p.AnimSets[1] = ((NewWeapon != none) ? ((NewWeapon.WeaponType == 2) ? CommonArmedLight1p : CommonArmedHeavy1p) : none);
        Mesh1p.AnimSets[2] = ((NewWeapon != none) ? NewWeapon.AnimationSetCharacter1p : none);
