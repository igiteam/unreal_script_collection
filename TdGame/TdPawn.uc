simulated function SetIgnoreLookInput(optional float Time)
{
    local TdPlayerController PC;

    Time = -1.0;
    // End:0x1A
    if(Time == 0.0)
    {
        return;
    }
    PC = TdPlayerController(Controller);
    // End:0x37
    if(PC == none)
    {
        return;
    }
    // End:0x65
    if(PC.bCinematicMode || PC.IsButtonInputIgnored())
    {
        return;
    }
    ClearTimer('StopIgnoreLookInput');
    // End:0xB2
    if((Time > 0.0) && !PC.IsLookInputIgnored())
    {
        SetTimer(Time, false, 'StopIgnoreLookInput');
    }
    PC.bIgnoreLookInput = 1;
    //return;    
}

