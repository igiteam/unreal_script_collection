simulated event bool CanDoMove(TdPawn.EMovement NewMove)
{
    // End:0x0D
    if(!bAllowMoveChange)
    {
        return false;
    }
    // End:0x22
    if(PendingMovementState != MovementState)
    {
        return false;
    }
    return Moves[NewMove].CanDoMove();
    //return ReturnValue;    
}

simulated event bool SetMove(TdPawn.EMovement NewMove, optional bool bViaReplication, optional bool bCheckCanDo)
{
    bViaReplication = false;
    bCheckCanDo = false;
    // End:0x1F
    if(NewMove == MovementState)
    {
        return false;
    }
    // End:0x2C
    if(!bAllowMoveChange)
    {
        return false;
    }
    // End:0x6A
    if(((TdPlayerController(Controller) != none) && TdPlayerController(Controller).bCinematicMode) && NewMove != 1)
    {
        return false;
    }
    PendingMovementState = NewMove;
    // End:0xA3
    if(bCheckCanDo && !Moves[NewMove].CanDoMove())
    {
        return false;
    }
    // End:0x139
    if(bViaReplication)
    {
        // End:0xD8
        if(MovementState != 0)
        {
            Moves[MovementState].StopReplicatedMove();
        }
        OldMovementState = MovementState;
        MovementState = NewMove;
        // End:0x11A
        if(OldMovementState != 0)
        {
            Moves[OldMovementState].PostStopMove();
        }
        Moves[MovementState].StartReplicatedMove();
    }
    // End:0x1F2
    else
    {
        // End:0x165
        if(MovementState != 0)
        {
            Moves[MovementState].StopMove();
        }
        OldMovementState = MovementState;
        MovementState = NewMove;
        // End:0x1A7
        if(OldMovementState != 0)
        {
            Moves[OldMovementState].PostStopMove();
        }
        ReplicatedMovementState = NewMove;
        SetNetUpdateTime(WorldInfo.TimeSeconds - float(1));
        Moves[MovementState].StartMove();
        NotifyNewMove();
    }
    return true;
    //return ReturnValue;    
}

function NotifyNewMove()
{
    // End:0x37
    if((OldMovementState == 16) || OldMovementState == 48)
    {
        SlideStoppedTimeStamp = WorldInfo.TimeSeconds;
    }
    //return;    
}

