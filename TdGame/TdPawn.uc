simulated function UpdateWeaponAnimState(float DeltaTime)
{
    local TdPawn.EWeaponType CurrentWeaponType;
    local float TimeToStayReady;
    local TdPawn.EWeaponAnimState NewWeaponAnimState;

    CurrentWeaponType = GetWeaponType();
    AmountTilUnarmed -= (VelocityMagnitude * DeltaTime);
    TimeToStayReady = ((CurrentWeaponType == 2) ? 5.0 : 1.0);
    // End:0xE0
    if(((AmountTilUnarmed <= 0.0) && WeaponAnimState == 2) && BecameReadyTime < (WorldInfo.TimeSeconds - TimeToStayReady))
    {
        // End:0xBE
        if(CurrentWeaponType == 1)
        {
            NewWeaponAnimState = ((Moves[MovementState].bTwoHandedFullBodyAnimations) ? 5 : 2);
        }
        // End:0xC6
        else
        {
            NewWeaponAnimState = 1;
        }
        SetWeaponAnimState(NewWeaponAnimState);
        AmountTilUnarmed = 0.0;
    }
    //return;    
}

