        Weap = TdWeapon(InvManager.CreateInventory(ReplicatedWeaponClass, true));
        // End:0xC1
        if(Weap != none)
        {
            Weap.bRemoteWeapon = true;
            Weap.RemoteRole = ROLE_None;
            J0xC1:
        }
        // End:0xC1
        else
        {
        }
    }
    // End:0xE8
    if(Weap != none)
    {
        InvManager.SetCurrentWeapon(Weap);
        J0xE8:
    }
    // End:0xE8
    else
    {
    }
    //return;    
}

