replication
{
    // Pos:0x000
    if(bDemoRecording || (bNetDirty && bNetOwner) && Role == ROLE_Authority)
        TaserDamageLevel

    // Pos:0x02E
    if(bDemoRecording || (!bNetOwner && bNetDirty) && Role == ROLE_Authority)
        AnimationMovementState, CurrentGrabTurnType, 
        LadderType, ReloadCount, 
        ReplicatedCustomAnim, ReplicatedMovementState, 
        ReplicatedWeaponClass, bClimbDownFast, 
        bClimbLeftHand

    // Pos:0x05E
    if(bDemoRecording || !bNetOwner && Role == ROLE_Authority)
        LastPhysHitInfo, RemoteViewYaw

    // Pos:0x083
    if(bDemoRecording || !bNetOwner && Role == ROLE_Authority)
        PatchOne, PatchThree, 
        PatchTwo
}

