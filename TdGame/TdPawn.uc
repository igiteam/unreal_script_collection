reliable server function ServerTestMeleeHit(TdPawn Target, float Damage, class<DamageType> DamageType, Vector HitLocation, Vector ImpactMomentum, TraceHitInfo Hit)
{
    local Vector ToTarget;

    ToTarget = Location - Target.Location;
    // End:0xCA
    if((VSize(ToTarget) < 180.0) && (vector(Rotation) Dot Normal(ToTarget)) < 0.0)
    {
        Target.PlayMeleeImpact(Hit.PhysMaterial, 1, HitLocation, -ImpactMomentum, ImpactMomentum, Hit.BoneName, DamageType);
        Target.TakeDamage(int(Damage), Controller, HitLocation, ImpactMomentum, DamageType, Hit);
    }
    //return;    
}

reliable server function ServerTriggerMelee(TdPawn.EMeleeServerAction ServerAction, byte NewMeleeState)
{
    local TdMove_MeleeBase MeleeMove;

    MeleeMove = TdMove_MeleeBase(Moves[MovementState]);
    // End:0x25
    if(MeleeMove == none)
    {
        return;
    }
    MeleeMove.SetMeleeState(NewMeleeState);
    switch(ServerAction)
    {
        // End:0x62
        case 0:
            MeleeMove.TriggerMove();
            // End:0x97
            break;
        // End:0x7B
        case 1:
            MeleeMove.TriggerHit();
        // End:0x94
        case 2:
            MeleeMove.TriggerMiss();
        // End:0xFFFF
        default:
            //return;
    }    
}

function TakeTaserDamage(Vector ImpactMomentum)
{
    TimeSinceLastTaserDamage = 0.0;
    TaserDamageLevel = FClamp(TaserDamageLevel + class'TdDmgType_Taser'.default.ContiniousTaserDamage, class'TdDmgType_Taser'.default.InitialTaserDamage, 100.0);
    Moves[MovementState].TakeTaserDamage(ImpactMomentum);
    //return;    
}

function TakeFallingDamage()
{
    local float EffectiveSpeed, Damage, LandSpeed;

    LandSpeed = Velocity.Z + float(Max(0, int(vector(Rotation) Dot Velocity)));
    // End:0x12A
    if(LandSpeed < (-0.50 * MaxFallSpeed))
    {
        // End:0x127
        if(Role == ROLE_Authority)
        {
            MakeNoise(1.0, 'PlayerMovementNoise');
            // End:0x127
            if(LandSpeed < (float(-1) * MaxFallSpeed))
            {
                EffectiveSpeed = LandSpeed;
                // End:0x9F
                if(TouchingWaterVolume())
                {
                    EffectiveSpeed += float(100);
                }
                // End:0xBD
                if(IsInState('UncontrolledFall'))
                {
                    EffectiveSpeed -= float(1000);
                }
                // End:0x127
                if(EffectiveSpeed < (float(-1) * MaxFallSpeed))
                {
                    Damage = ((-100.0 * UnrealEngineFallDamageScale) * (EffectiveSpeed + MaxFallSpeed)) / MaxFallSpeed;
                    TakeDamage(int(Damage), none, Location, vect(0.0, 0.0, 0.0), class'DmgType_Fell');
                }
            }
        }
    }
    // End:0x151
    else
    {
        // End:0x151
        if(LandSpeed < (-1.40 * JumpZ))
        {
            MakeNoise(0.50, 'PlayerMovementNoise');
        }
    }
    //return;    
}

simulated function bool CanSkillRoll()
{
    // End:0x7D
    if(((((GetWeaponType() == 1) || MovementState == 25) || MovementState == 72) || MovementState == 32) || (MovementState == 20) && Moves[OldMovementState].IsA('TdMove_MeleeBase'))
    {
        return false;
    }
    return (RollTriggerTime + 0.20) > WorldInfo.TimeSeconds;
    //return ReturnValue;    
}

simulated function PlayPhysicsBodyImpact(Controller InstigatedBy, PhysicalHitInfo Hit)
{
    // End:0x3C
    if((((Mesh3p == none) || Physics == 10) || bPlayedDeath) || IsInState('Dying'))
    {
        return;
    }
    // End:0x6A
    if((Mesh3p.PhysicsAsset == none) || Mesh3p.PhysicsAssetInstance == none)
    {
        return;
    }
    // End:0x87
    if(class<TdDmgType_BarbedWire>(Hit.DamageType) != none)
    {
        return;
    }
    // End:0x110
    if((MovementState != 35) || class<TdDmgType_Melee>(Hit.DamageType) != none)
    {
        StumbleDamage(((InstigatedBy == none) ? none : TdPawn(InstigatedBy.Pawn)), Hit.HitLocation, Hit.Momentum, Hit.DamageType);
    }
    // End:0x130
    if(Hit.HitBone == 'None')
    {
        return;
    }
    // End:0x152
    if(!Hit.DamageType.default.bCausePhysicalHitReaction)
    {
        return;
    }
    GetImpactPhysicsImpulse(Hit);
    PhysicsHitReactionBlendTimer = PhysicsHitReactionBlendInTime;
    //return;    
}

final simulated function bool StartPhysicsBodyImpact(name HitBoneName, bool bUseMotors, PhysicalHitInfo Hit)
{
    local bool bFoundBone;
    local int BoneIndex;
    local Vector2D MotorStrength;

    BoneIndex = 0;
    J0x07:
    // End:0x6B [Loop If]
    if(BoneIndex < Hit.DamageType.default.PhysicsBodyImpactBoneList.Length)
    {
        // End:0x61
        if(Hit.DamageType.default.PhysicsBodyImpactBoneList[BoneIndex] == HitBoneName)
        {
            bFoundBone = true;
            // [Explicit Break]
            goto J0x6B;
        }
        ++ BoneIndex;
        J0x6B:
        // [Loop Continue]
        goto J0x07;
    }
    // End:0x78
    if(!bFoundBone)
    {
        return false;
    }
    Mesh3p.PhysicsAssetInstance.SetNamedBodiesFixed(false, Hit.DamageType.default.PhysicsBodyImpactBoneList, Mesh3p, false);
    Mesh3p.bUpdateJointsFromAnimation = true;
    MotorStrength = Hit.DamageType.default.PhysHitReactionMotorStrength;
    Mesh3p.PhysicsAssetInstance.SetAllMotorsAngularDriveParams(MotorStrength.X, MotorStrength.Y, 0.0);
    Mesh3p.PhysicsAssetInstance.SetAllMotorsAngularPositionDrive(true, true);
    Mesh3p.WakeRigidBody();
    Mesh3p.PhysicsWeight = 1.0;
    return true;
    //return ReturnValue;    
}

final simulated function Vector GetImpactPhysicsImpulse(PhysicalHitInfo Hit)
{
    local Vector Impulse;
    local Rotator HitRotation;

    HitRotation = rotator(Hit.Momentum);
    HitRotation.Yaw += (Rand(12000) - 6000);
    LastPhysHitInfo.Momentum = vector(HitRotation);
    Impulse = vector(HitRotation) * Hit.DamageType.default.KDamageImpulse;
    Impulse *= (1.0 - FClamp(PhysicsHitReactionBlendTimer / Hit.DamageType.default.PhysicsHitReactionDuration, 0.0, 1.0));
    Impulse *= PhysicsHitReactionScale;
    return Impulse;
    //return ReturnValue;    
}

final simulated function StopPhysicsBodyImpact()
{
    Mesh3p.PhysicsWeight = 0.0;
    PhysicsHitReactionBlendTimer = 0.0;
    PhysicsHitReactionBlendOut = 0.0;
    Mesh3p.PhysicsAssetInstance.SetAllMotorsAngularDriveStrength(1.0, 1.0, 1.0, Mesh3p);
    Mesh3p.PhysicsAssetInstance.SetAllBodiesFixed(true);
    Mesh3p.bUpdateJointsFromAnimation = false;
    Mesh3p.PhysicsAssetInstance.SetAllMotorsAngularPositionDrive(false, false);
    //return;    
}

final simulated function UpdatePhysicalAnimBlendValue(float DeltaTime)
{
    // End:0x11
    if(PhysicsHitReactionBlendTimer <= 0.0)
    {
        return;
    }
    Mesh3p.PhysicsWeight = FClamp(PhysicsHitReactionBlendTimer / FMin(LastPhysHitInfo.DamageType.default.PhysicsHitReactionBlendOutTime, 1.0), 0.0, 1.0);
    PhysicsHitReactionBlendTimer -= DeltaTime;
    // End:0x7B
    if(PhysicsHitReactionBlendTimer <= 0.0)
    {
        PhysicsHitReactionBlendTimer = 0.0;
    }
    //return;    
}

singular simulated function Rotator GetBaseAimRotation()
{
    local Vector POVLoc;
    local Rotator POVRot;

    // End:0x51
    if(((Controller != none) && !InCamAimMode()) && !InFreeCam())
    {
        Controller.GetPlayerViewPoint(POVLoc, POVRot);
        return POVRot;
    }
    POVRot = Rotation;
    // End:0x90
    if(POVRot.Pitch == 0)
    {
        POVRot.Pitch = RemoteViewPitch << 8;
    }
    return POVRot;
    //return ReturnValue;    
}

