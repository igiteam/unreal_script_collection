function AddVelocity(Vector NewVelocity, Vector HitLocation, class<DamageType> DamageType, optional TraceHitInfo HitInfo)
{
    // End:0x25
    if(bIgnoreForces || NewVelocity == vect(0.0, 0.0, 0.0))
    {
        return;
    }
    // End:0x7A
    if((Physics == 1) || ((Physics == 9) || Physics == 8) && NewVelocity.Z > default.JumpZ)
    {
        SetPhysics(2);
    }
    // End:0xC5
    if((Velocity.Z > default.JumpZ) && NewVelocity.Z > float(0))
    {
        NewVelocity.Z *= 0.50;
    }
    Velocity += NewVelocity;
    //return;    
}

simulated function StumbleDamage(TdPawn InstigatorPawn, Vector HitLocation, Vector damageMomentum, class<DamageType> DamageType)
{
    local TdMove_StumbleBase StumbleMove;
    local bool StumbleHard;

    StumbleHard = DamageType == class'TdDmgType_MeleeSecondSwing';
    // End:0x32
    if(StumbleHard)
    {
        StumbleMove = TdMove_StumbleBase(Moves[55]);
    }
    // End:0x45
    else
    {
        StumbleMove = TdMove_StumbleBase(Moves[35]);
    }
    // End:0xDD
    if(StumbleMove != none)
    {
        StumbleMove.InstigatorLocation = ((InstigatorPawn != none) ? InstigatorPawn.Location : vect(0.0, 0.0, 0.0));
        StumbleMove.Instigator = InstigatorPawn;
        StumbleMove.damageMomentum = damageMomentum;
        StumbleMove.DamageLocation = HitLocation;
        StumbleMove.HitDamageType = DamageType;
    }
    // End:0xF5
    if(StumbleHard)
    {
        HandleMoveAction(18);
    }
    // End:0x101
    else
    {
        HandleMoveAction(17);
    }
    //return;    
}

