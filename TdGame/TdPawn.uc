simulated event PlayFootStepSound(int FootDown)
{
    local float Loudness;
    local Actor TraceActor;
    local Vector out_HitLocation, HitLocation, out_HitNormal, HitNormal, TraceDest, TraceStart,
	    TraceExtent, FacingDir, BoneLocation;

    local TraceHitInfo HitInfo, newHitInfo;
    local int triggerID;

    FacingDir = vector(Rotation);
    FacingDir.Z = 0.0;
    FacingDir = Normal(FacingDir);
    // End:0xC9
    if(FootDown < 0)
    {
        triggerID = -FootDown;
        // End:0x77
        if(triggerID <= 20)
        {
            BoneLocation = Mesh.GetBoneLocation('LeftFoot', 0);
        }
        // End:0xC6
        else
        {
            // End:0xA6
            if(triggerID <= 30)
            {
                BoneLocation = Mesh.GetBoneLocation('LeftHand', 0);
            }
            // End:0xC6
            else
            {
                BoneLocation = Mesh.GetBoneLocation('LeftShoulder', 0);
            }
        }
    }
    // End:0x172
    else
    {
        // End:0x160
        if(FootDown > 0)
        {
            triggerID = FootDown;
            // End:0x10E
            if(triggerID <= 20)
            {
                BoneLocation = Mesh.GetBoneLocation('RightFoot', 0);
            }
            // End:0x15D
            else
            {
                // End:0x13D
                if(triggerID <= 30)
                {
                    BoneLocation = Mesh.GetBoneLocation('RightHand', 0);
                }
                // End:0x15D
                else
                {
                    BoneLocation = Mesh.GetBoneLocation('RightShoulder', 0);
                }
            }
        }
        // End:0x172
        else
        {
            BoneLocation = Location;
            triggerID = 0;
        }
    }
    TraceStart = BoneLocation;
    // End:0x1C0
    if(triggerID == 0)
    {
        TraceDest = (TraceStart - (vect(0.0, 0.0, 1.0) * (GetCollisionHeight()))) - vect(0.0, 0.0, 35.0);
    }
    // End:0x640
    else
    {
        switch(MovementState)
        {
            // End:0x1CD
            case 1:
            // End:0x1D2
            case 15:
            // End:0x1D7
            case 16:
            // End:0x1DC
            case 20:
            // End:0x1E1
            case 29:
            // End:0x1E6
            case 18:
            // End:0x1EB
            case 17:
            // End:0x1F0
            case 24:
            // End:0x1F5
            case 27:
            // End:0x1FA
            case 28:
            // End:0x1FF
            case 38:
            // End:0x204
            case 37:
            // End:0x272
            case 35:
                // End:0x24E
                if((triggerID >= 8) && triggerID <= 10)
                {
                    TraceDest = TraceStart - ((vect(0.0, 0.0, 1.0) * FootstepTraceLength) * 2.0);
                }
                // End:0x26F
                else
                {
                    TraceDest = TraceStart - (vect(0.0, 0.0, 1.0) * FootstepTraceLength);
                }
                // End:0x640
                break;
            // End:0x277
            case 7:
            // End:0x27C
            case 11:
            // End:0x2AC
            case 33:
                TraceDest = TraceStart - ((vect(0.0, 0.0, 1.0) * FootstepTraceLength) * 2.0);
                // End:0x640
                break;
            // End:0x2EB
            case 4:
                TraceDest = TraceStart - (((FacingDir Cross vect(0.0, 0.0, 1.0)) + vect(0.0, 0.0, 1.0)) * FootstepTraceLength);
                // End:0x640
                break;
            // End:0x32A
            case 5:
                TraceDest = TraceStart + (((FacingDir Cross vect(0.0, 0.0, 1.0)) - vect(0.0, 0.0, 1.0)) * FootstepTraceLength);
                // End:0x640
                break;
            // End:0x380
            case 8:
                // End:0x355
                if(triggerID > 20)
                {
                    TraceStart = MoveLedgeLocation + vect(0.0, 0.0, 5.0);
                }
                TraceDest = TraceStart + ((FacingDir - vect(0.0, 0.0, 0.50)) * FootstepTraceLength);
                // End:0x640
                break;
            // End:0x385
            case 9:
            // End:0x3DB
            case 14:
                // End:0x3B0
                if(triggerID > 20)
                {
                    TraceStart = MoveLedgeLocation + vect(0.0, 0.0, 2.0);
                }
                TraceDest = TraceStart + ((FacingDir - vect(0.0, 0.0, 0.50)) * FootstepTraceLength);
                // End:0x640
                break;
            // End:0x3E0
            case 3:
            // End:0x3E5
            case 6:
            // End:0x3EA
            case 22:
            // End:0x3EF
            case 21:
            // End:0x3F4
            case 2:
            // End:0x424
            case 61:
                TraceDest = TraceStart + ((FacingDir + vect(0.0, 0.0, 0.50)) * FootstepTraceLength);
                // End:0x640
                break;
            // End:0x4CD
            case 10:
                // End:0x47A
                if(triggerID > 20)
                {
                    TraceStart = MoveLedgeLocation + vect(0.0, 0.0, 2.0);
                    TraceDest = TraceStart + ((FacingDir - vect(0.0, 0.0, 0.50)) * FootstepTraceLength);
                }
                // End:0x4CA
                else
                {
                    // End:0x4A2
                    if(triggerID == 7)
                    {
                        TraceDest = TraceStart + (FacingDir * FootstepTraceLength);
                    }
                    // End:0x4CA
                    else
                    {
                        TraceDest = TraceStart + ((FacingDir - vect(0.0, 0.0, 1.0)) * FootstepTraceLength);
                    }
                }
                // End:0x640
                break;
            // End:0x4D2
            case 19:
            // End:0x542
            case 23:
                // End:0x51E
                if((triggerID > 20) || triggerID == 11)
                {
                    TraceStart = Location;
                    TraceDest = TraceStart + ((FacingDir * float(4)) * FootstepTraceLength);
                }
                // End:0x53F
                else
                {
                    TraceDest = TraceStart - (vect(0.0, 0.0, 1.0) * FootstepTraceLength);
                }
                // End:0x640
                break;
            // End:0x547
            case 12:
            // End:0x5DC
            case 34:
                // End:0x59C
                if(OldMovementState == 4)
                {
                    TraceDest = TraceStart - (float(2) * (((FacingDir Cross vect(0.0, 0.0, 1.0)) + vect(0.0, 0.0, 1.0)) * FootstepTraceLength));
                }
                // End:0x5D9
                else
                {
                    TraceDest = TraceStart + (float(2) * (((FacingDir Cross vect(0.0, 0.0, 1.0)) - vect(0.0, 0.0, 1.0)) * FootstepTraceLength));
                }
                // End:0x640
                break;
            // End:0x612
            case 13:
                TraceDest = TraceStart - ((float(2) * (FacingDir + vect(0.0, 0.0, 0.50))) * FootstepTraceLength);
                // End:0x640
                break;
            // End:0x617
            case 0:
            // End:0xFFFF
            default:
                TraceDest = TraceStart - (vect(0.0, 0.0, 1.0) * (GetCollisionHeight()));
            }
            TraceExtent = vect(0.50, 0.50, 0.50) * FootstepTraceWidth;
            TraceActor = Trace(out_HitLocation, out_HitNormal, TraceDest, TraceStart, true, TraceExtent, HitInfo, 1);
            // End:0x7F8
            if(TraceActor != none)
            {
                HitLocation = out_HitLocation;
                HitNormal = out_HitNormal;
                // End:0x75F
                if((HitInfo.Material == none) && HitInfo.PhysMaterial == none)
                {
                    TraceActor = Trace(out_HitLocation, out_HitNormal, TraceDest, HitLocation, true, vect(0.0, 0.0, 0.0), newHitInfo, 1);
                    // End:0x75F
                    if((TraceActor != none) && (newHitInfo.Material != none) || newHitInfo.PhysMaterial != none)
                    {
                        HitInfo = newHitInfo;
                        HitLocation = out_HitLocation;
                        HitNormal = out_HitNormal;
                    }
                }
                // End:0x7C0
                if((Role == ROLE_Authority) || IsLocallyControlled())
                {
                    ActuallyPlayFootStepSound(triggerID, HitInfo, TraceStart);
                    Loudness = VelocityMagnitude / GroundSpeed;
                    MakeNoise((Loudness * Loudness) * Loudness, 'PlayerMovementNoise');
                }
                // End:0x7F8
                if(WorldInfo.NetMode != NM_DedicatedServer)
                {
                    ActuallyPlayFootParticleEffect(triggerID, HitInfo, HitLocation, HitNormal);
                }
            }
            //return;            
}

final function ActuallyPlayFootStepSound(int FootDown, TraceHitInfo HitInfo, optional Vector HitLoc)
{
    local PhysicalMaterial ParentPhysMaterial;
    local array<SoundCue> FootStepSounds;
    local int ArrayIndex;
    local Vector triggerLocation;

    // End:0x2B
    if((FootDown == 12) || (FootDown >= 26) && FootDown < 31)
    {
        return;
    }
    // End:0x9B
    if(HitInfo.PhysMaterial != none)
    {
        FootStepSounds = GetFootStepSounds(HitInfo.PhysMaterial, FootDown);
        ParentPhysMaterial = HitInfo.PhysMaterial.Parent;
        LastFootstepMaterial = HitInfo.PhysMaterial;
    }
    // End:0x157
    else
    {
        // End:0x157
        if(HitInfo.Material != none)
        {
            // End:0x149
            if(HitInfo.Material.PhysMaterial != none)
            {
                FootStepSounds = GetFootStepSounds(HitInfo.Material.PhysMaterial, FootDown);
                ParentPhysMaterial = HitInfo.Material.PhysMaterial.Parent;
                LastFootstepMaterial = HitInfo.Material.PhysMaterial;
            }
            // End:0x157
            else
            {
                ParentPhysMaterial = none;
                LastFootstepMaterial = none;
            }
        }
    }
    // End:0x1A9 [Loop If]
    if((FootStepSounds.Length == 0) && ParentPhysMaterial != none)
    {
        FootStepSounds = GetFootStepSounds(ParentPhysMaterial, FootDown);
        LastFootstepMaterial = ParentPhysMaterial;
        ParentPhysMaterial = ParentPhysMaterial.Parent;
        // [Loop Continue]
        goto J0x157;
    }
    // End:0x1D2
    if(FootStepSounds.Length == 0)
    {
        FootStepSounds = GetFootStepSounds(DefaultFootstepMaterial, FootDown);
        LastFootstepMaterial = none;
    }
    // End:0x1F7
    if(HitLoc != vect(0.0, 0.0, 0.0))
    {
        triggerLocation = HitLoc;
    }
    // End:0x202
    else
    {
        triggerLocation = Location;
    }
    ArrayIndex = 0;
    J0x209:
    // End:0x255 [Loop If]
    if(ArrayIndex < FootStepSounds.Length)
    {
        // End:0x24B
        if(FootStepSounds[ArrayIndex] != none)
        {
            self.PlaySound(FootStepSounds[ArrayIndex], false, true, false, triggerLocation);
        }
        ++ ArrayIndex;
        // [Loop Continue]
        goto J0x209;
    }
    //return;    
}

simulated function ActuallyPlayFootParticleEffect(int FootDown, TraceHitInfo HitInfo, optional Vector HitLoc, optional Vector HitNormal)
{
    local PhysicalMaterial ParentPhysMaterial;
    local ParticleSystem FootStepEffect;
    local editinline ParticleSystemComponent PSC;

    // End:0x5C
    if(HitInfo.PhysMaterial != none)
    {
        FootStepEffect = GetFootStepEffect(HitInfo.PhysMaterial, FootDown);
        ParentPhysMaterial = HitInfo.PhysMaterial.Parent;
    }
    // End:0xF1
    else
    {
        // End:0xF1
        if(HitInfo.Material != none)
        {
            // End:0xEA
            if(HitInfo.Material.PhysMaterial != none)
            {
                FootStepEffect = GetFootStepEffect(HitInfo.Material.PhysMaterial, FootDown);
                ParentPhysMaterial = HitInfo.Material.PhysMaterial.Parent;
            }
            // End:0xF1
            else
            {
                ParentPhysMaterial = none;
            }
        }
    }
    // End:0x137 [Loop If]
    if((FootStepEffect == none) && ParentPhysMaterial != none)
    {
        FootStepEffect = GetFootStepEffect(ParentPhysMaterial, FootDown);
        ParentPhysMaterial = ParentPhysMaterial.Parent;
        // [Loop Continue]
        goto J0xF1;
    }
    // End:0x158
    if(FootStepEffect == none)
    {
        FootStepEffect = GetFootStepEffect(DefaultFootstepMaterial, FootDown);
    }
    // End:0x228
    if((HitLoc != vect(0.0, 0.0, 0.0)) && FootStepEffect != none)
    {
        // End:0x1E3
        if((MovementState == 47) && FootDown == 12)
        {
            PSC = WorldInfo.MyEmitterPool.SpawnEmitter(FootStepEffect, TdMove_Vertigo(Moves[47]).LastActualVertigoEdgePosition, Rotation);
        }
        // End:0x217
        else
        {
            PSC = WorldInfo.MyEmitterPool.SpawnEmitter(FootStepEffect, HitLoc, Rotation);
        }
        PSC.ActivateSystem();
    }
    //return;    
}

final function array<SoundCue> GetFootStepSounds(PhysicalMaterial PMaterial, int FootDown)
{
    local array<SoundCue> Retvals;
    local bool loop;
    local SoundCue tmpCue;

    loop = true;
    J0x08:
    // End:0x118 [Loop If]
    if((((loop && none != PMaterial) && none != PMaterial.PhysicalMaterialProperty) && none != TdPhysicalMaterialProperty(PMaterial.PhysicalMaterialProperty)) && none != TdPhysicalMaterialProperty(PMaterial.PhysicalMaterialProperty).TdPhysicalMaterialFootSteps)
    {
        tmpCue = GetSpecificFootStepSound(TdPhysicalMaterialProperty(PMaterial.PhysicalMaterialProperty).TdPhysicalMaterialFootSteps, FootDown);
        // End:0xC7
        if(tmpCue != none)
        {
            Retvals[Retvals.Length] = tmpCue;
        }
        loop = TdPhysicalMaterialProperty(PMaterial.PhysicalMaterialProperty).TdPhysicalMaterialFootSteps.bPlayOnTopOfParent;
        // End:0x115
        if(loop)
        {
            PMaterial = PMaterial.Parent;
        }
        // [Loop Continue]
        goto J0x08;
    }
    return Retvals;
    //return ReturnValue;    
}

