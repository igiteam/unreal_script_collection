function PlayMeleeImpact(PhysicalMaterial PhysMat, TdPawn.EMeleeImpactType Type, Vector TargetHitLocation, Vector TargetHitNormal, Vector TargetHitMomentum, name TargetHitBone, class<DamageType> DamageType)
{
    local SoundCue ImpactSound;
    local TdPhysicalMaterialProperty MaterialProperties;
    local ParticleSystem ImpactEffect, ImpactEffectHead;
    local editinline ParticleSystemComponent PSC;

    // End:0x27
    if(Type == 3)
    {
        PlaySound(soundcue'Gun_Body', false, true, false, TargetHitLocation);
        return;
    }
    // End:0x13A
    if((PhysMat != none) && PhysMat.PhysicalMaterialProperty != none)
    {
        MaterialProperties = TdPhysicalMaterialProperty(PhysMat.PhysicalMaterialProperty);
        // End:0x13A
        if((MaterialProperties != none) && MaterialProperties.TdPhysicalMaterialMelee != none)
        {
            switch(Type)
            {
                // End:0xB1
                case 0:
                    ImpactSound = MaterialProperties.TdPhysicalMaterialMelee.ImpactSoundGun;
                // End:0xD5
                case 1:
                    ImpactSound = MaterialProperties.TdPhysicalMaterialMelee.ImpactSoundFist;
                // End:0xF9
                case 2:
                    ImpactSound = MaterialProperties.TdPhysicalMaterialMelee.ImpactSoundFoot;
                // End:0xFFFF
                default:
                    ImpactEffect = MaterialProperties.TdPhysicalMaterialMelee.ImpactEffect;
                    ImpactEffectHead = MaterialProperties.TdPhysicalMaterialMelee.ImpactEffectHead;
                }
            }
            // End:0x15A
            if(ImpactSound != none)
            {
                PlaySound(ImpactSound, false, true, false, TargetHitLocation);
            }
            // End:0x178
            if((DamageType != none) && DamageType == class'TdDmgType_MeleeAir')
            {
                return;
            }
            // End:0x1F9
            if(ImpactEffect != none)
            {
                PSC = WorldInfo.MyEmitterPool.SpawnEmitter(ImpactEffect, TargetHitLocation);
                Mesh3p.AttachComponent(PSC, TargetHitBone, vect(14.0, 0.0, 16.0), rot(-16556, 0, 0));
                PSC.ActivateSystem();
            }
            // End:0x270
            if((Health <= 0) && ImpactEffectHead != none)
            {
                PSC = WorldInfo.MyEmitterPool.SpawnEmitter(ImpactEffectHead, TargetHitLocation);
                Mesh3p.AttachComponentToSocket(PSC, 'MeleeEffectHeadSocket');
                PSC.ActivateSystem();
            }
            //return;            
}

function StartSlideEffect()
{
    local TraceHitInfo HitInfo;
    local ParticleSystem PS;

    bIsPlayingSlideEffect = true;
    HitInfo = CheckSlideSurface();
    SlidingSoundComponent0 = CreateAudioComponent(GetSlideSound(HitInfo), false, true);
    // End:0xA6
    if(SlidingSoundComponent0 != none)
    {
        SlidingSoundComponent0.bUseOwnerLocation = true;
        SlidingSoundComponent0.bAllowSpatialization = true;
        SlidingSoundComponent0.bAutoDestroy = true;
        AttachComponent(SlidingSoundComponent0);
        SlidingSoundComponent0.FadeIn(0.10, 1.0);
        bAlternateSound = false;
    }
    PS = GetSlideEffect(HitInfo);
    // End:0x144
    if((SlideEffectEmitter != none) && PS != none)
    {
        SlideEffectEmitter.SetTemplate(PS);
        Mesh.AttachComponent(SlideEffectEmitter.ParticleSystemComponent, 'LeftFoot');
        SlideEffectEmitter.SetHidden(false);
        SlideEffectEmitter.ParticleSystemComponent.ActivateSystem();
    }
    //return;    
}

function StopSlideEffect()
{
    bIsPlayingSlideEffect = false;
    // End:0x2D
    if(SlidingSoundComponent0 != none)
    {
        SlidingSoundComponent0.FadeOut(0.50, 0.0);
    }
    // End:0x52
    if(SlidingSoundComponent1 != none)
    {
        SlidingSoundComponent1.FadeOut(0.50, 0.0);
    }
    // End:0x8C
    if(SlideEffectEmitter != none)
    {
        DetachComponent(SlideEffectEmitter.ParticleSystemComponent);
        SlideEffectEmitter.ParticleSystemComponent.DeactivateSystem();
    }
    //return;    
}

function TraceHitInfo CheckSlideSurface()
{
    local Vector HitNormal, HitLocation, TraceDest, TraceStart, TraceExtent;

    local TraceHitInfo HitInfo;

    TraceStart = Mesh.GetBoneLocation('RightFoot', 0);
    TraceDest = TraceStart - (vect(0.0, 0.0, 1.0) * FootstepTraceLength);
    Trace(HitLocation, HitNormal, TraceDest, TraceStart, true, TraceExtent, HitInfo, 1);
    return HitInfo;
    //return ReturnValue;    
}

event UpdateSlideEffect()
{
    local SoundCue SoundToPlay;
    local editinline AudioComponent ActiveComponent;
    local ParticleSystem PSToSpawn;
    local TraceHitInfo HitInfo;

    HitInfo = CheckSlideSurface();
    SoundToPlay = GetSlideSound(HitInfo);
    ActiveComponent = ((bAlternateSound) ? SlidingSoundComponent1 : SlidingSoundComponent0);
    // End:0x138
    if((ActiveComponent == none) || ActiveComponent.SoundCue != SoundToPlay)
    {
        bAlternateSound = !bAlternateSound;
        // End:0x9A
        if(ActiveComponent != none)
        {
            ActiveComponent.FadeOut(0.50, 0.0);
        }
        ActiveComponent = CreateAudioComponent(SoundToPlay, false, true);
        // End:0x138
        if(ActiveComponent != none)
        {
            ActiveComponent.bUseOwnerLocation = true;
            ActiveComponent.bAllowSpatialization = true;
            ActiveComponent.bAutoDestroy = true;
            AttachComponent(ActiveComponent);
            ActiveComponent.FadeIn(0.10, 1.0);
            // End:0x12D
            if(bAlternateSound)
            {
                SlidingSoundComponent1 = ActiveComponent;
            }
            // End:0x138
            else
            {
                SlidingSoundComponent0 = ActiveComponent;
            }
        }
    }
    PSToSpawn = GetSlideEffect(HitInfo);
    // End:0x326
    if(SlideEffectEmitter != none)
    {
        // End:0x28D
        if(PSToSpawn != SlideEffectEmitter.ParticleSystemComponent.Template)
        {
            // End:0x270
            if(PSToSpawn != none)
            {
                // End:0x1CF
                if(SlideEffectEmitter.ParticleSystemComponent != none)
                {
                    SlideEffectEmitter.ParticleSystemComponent.DeactivateSystem();
                    SlideEffectEmitter.ParticleSystemComponent.ResetToDefaults();
                }
                SlideEffectEmitter.ParticleSystemComponent.SetTemplate(PSToSpawn);
                SlideEffectEmitter.ParticleSystemComponent.RewindEmitterInstances();
                Mesh.AttachComponent(SlideEffectEmitter.ParticleSystemComponent, 'LeftFoot');
                SlideEffectEmitter.ParticleSystemComponent.SetHidden(false);
                SlideEffectEmitter.ParticleSystemComponent.ActivateSystem();
            }
            // End:0x28A
            else
            {
                SlideEffectEmitter.ParticleSystemComponent.DeactivateSystem();
            }
        }
        // End:0x326
        else
        {
            // End:0x326
            if(PSToSpawn != none)
            {
                // End:0x326
                if(!SlideEffectEmitter.ParticleSystemComponent.bIsActive)
                {
                    SlideEffectEmitter.ParticleSystemComponent.RewindEmitterInstances();
                    SlideEffectEmitter.ParticleSystemComponent.KillParticlesForced();
                    SlideEffectEmitter.ParticleSystemComponent.bJustAttached = true;
                    SlideEffectEmitter.ParticleSystemComponent.ActivateSystem();
                }
            }
        }
    }
    //return;    
}

function SoundCue GetSlideSound(TraceHitInfo HitInfo)
{
    local array<SoundCue> SoundsToPlay;
    local PhysicalMaterial ParentPhysMaterial;
    local int FootDown;

    FootDown = 36;
    // End:0x62
    if(HitInfo.PhysMaterial != none)
    {
        SoundsToPlay = GetFootStepSounds(HitInfo.PhysMaterial, FootDown);
        ParentPhysMaterial = HitInfo.PhysMaterial.Parent;
    }
    // End:0xF7
    else
    {
        // End:0xF7
        if(HitInfo.Material != none)
        {
            // End:0xF0
            if(HitInfo.Material.PhysMaterial != none)
            {
                SoundsToPlay = GetFootStepSounds(HitInfo.Material.PhysMaterial, FootDown);
                ParentPhysMaterial = HitInfo.Material.PhysMaterial.Parent;
            }
            // End:0xF7
            else
            {
                ParentPhysMaterial = none;
            }
        }
    }
    // End:0x13E [Loop If]
    if((SoundsToPlay.Length == 0) && ParentPhysMaterial != none)
    {
        SoundsToPlay = GetFootStepSounds(ParentPhysMaterial, FootDown);
        ParentPhysMaterial = ParentPhysMaterial.Parent;
        // [Loop Continue]
        goto J0xF7;
    }
    // End:0x160
    if(SoundsToPlay.Length == 0)
    {
        SoundsToPlay = GetFootStepSounds(DefaultFootstepMaterial, FootDown);
    }
    return ((SoundsToPlay.Length == 0) ? DefaultSlidingSound : SoundsToPlay[0]);
    //return ReturnValue;    
}

function ParticleSystem GetSlideEffect(TraceHitInfo HitInfo)
{
    local PhysicalMaterial ParentPhysMaterial;
    local ParticleSystem FootStepEffect;
    local int FootDown;

    FootDown = 36;
    // End:0x62
    if(HitInfo.PhysMaterial != none)
    {
        FootStepEffect = GetFootStepEffect(HitInfo.PhysMaterial, FootDown);
        ParentPhysMaterial = HitInfo.PhysMaterial.Parent;
    }
    // End:0xF7
    else
    {
        // End:0xF7
        if(HitInfo.Material != none)
        {
            // End:0xF0
            if(HitInfo.Material.PhysMaterial != none)
            {
                FootStepEffect = GetFootStepEffect(HitInfo.Material.PhysMaterial, FootDown);
                ParentPhysMaterial = HitInfo.Material.PhysMaterial.Parent;
            }
            // End:0xF7
            else
            {
                ParentPhysMaterial = none;
            }
        }
    }
    // End:0x13D [Loop If]
    if((FootStepEffect == none) && ParentPhysMaterial != none)
    {
        FootStepEffect = GetFootStepEffect(ParentPhysMaterial, FootDown);
        ParentPhysMaterial = ParentPhysMaterial.Parent;
        // [Loop Continue]
        goto J0xF7;
    }
    return FootStepEffect;
    //return ReturnValue;    
}

