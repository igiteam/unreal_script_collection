event OnAnimEnd(AnimNodeSequence SeqNode, float PlayedTime, float ExcessTime)
{
    TdAnimNodeSequence(SeqNode).ResetNodeStates();
    // End:0x88
    if(SeqNode.SkelComponent == Mesh)
