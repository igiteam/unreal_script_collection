event NotifyActivateUsed(Actor InOriginator, SeqEvent_Used UsedEvent)
{
    local TdMove_Interact InteractMove;
    local int LinkIt;

    LinkIt = 0;
    J0x07:
    // End:0x54 [Loop If]
    if(LinkIt < UsedEvent.OutputLinks.Length)
    {
        SeqEvent_TdUsed(UsedEvent).OutputLinks[LinkIt].bHasImpulse = false;
        LinkIt += 1;
        // [Loop Continue]
        goto J0x07;
    }
    // End:0x121
    if(((TdTrigger(InOriginator) != none) && SeqEvent_TdUsed(UsedEvent) != none) && SeqEvent_TdUsed(UsedEvent).bInteract == false)
    {
        InteractMove = TdMove_Interact(Moves[39]);
        InteractMove.SetCurrentTrigger(TdTrigger(InOriginator));
        InteractMove.SetCurrentEvent(SeqEvent_TdUsed(UsedEvent));
        // End:0x10D
        if(Moves[39].CanDoMove())
        {
            SetMove(39);
        }
        // End:0x121
        else
        {
            InteractMove.ReleaseCurrentTriggerAndEvent();
        }
    }
    // End:0x16C
    if((SeqEvent_TdUsed(UsedEvent) != none) && MovementState != 39)
    {
        UsedEvent.TriggerCount -= 1;
        SeqEvent_TdUsed(UsedEvent).bInteract = false;
    }
    //return;    
}

