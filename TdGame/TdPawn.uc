function CheckForProximityShots(Vector Start, Vector End)
{
    local Vector Dir;
    local float Dist;
    local TdBotPawn P;
    local Vector botVec;
    local float botDist;
    local Vector pointOnLine;
    local float distFromLine;

    Dir = End - Start;
    Dist = VSize(Dir);
    // End:0x38
    if(Dist > float(1))
    {
        Dir /= Dist;
    }
    // End:0x149
    foreach WorldInfo.AllPawns(class'TdBotPawn', P)
    {
        // End:0x70
        if(P.Controller == none)
        {
            continue;            
        }
        botVec = P.Location - Start;
        botDist = botVec Dot Dir;
        // End:0xC1
        if((botDist < float(100)) || botDist > Dist)
        {
            continue;            
        }
        pointOnLine = Start + (Dir * botDist);
        distFromLine = VSize(P.Location - pointOnLine);
        // End:0x148
        if(distFromLine < TdAIController(P.Controller).SuppressionDistance)
        {
            TdAIController(P.Controller).ReportNearMiss(distFromLine);
        }        
    }    
    //return;    
}

event EnableLeftHandIK()
{
    LeftHandWorldIKController.SetSkelControlStrength(1.0, 0.20);
    //return;    
}

event DisableLeftHandIK()
{
    LeftHandWorldIKController.SetSkelControlStrength(0.0, 0.20);
    //return;    
}

event EnableRightHandIK()
{
    RightHandWorldIKController.SetSkelControlStrength(1.0, 0.20);
    //return;    
}

event DisableRightHandIK()
{
    RightHandWorldIKController.SetSkelControlStrength(0.0, 0.20);
    //return;    
}

function SetSynchPosOffset(float Offset, float Duration)
{
    OverrideSynchPosOffset = Offset;
    SetTimer(Duration, false, 'ResetSynchPosOffset');
    //return;    
}

function ResetSynchPosOffset()
{
    ClearTimer('ResetSynchPosOffset');
    OverrideSynchPosOffset = -1.0;
    //return;    
}

// Export UTdPawn::execGetAverageSpeed(FFrame&, void* const)
native function float GetAverageSpeed(float Time);

simulated function SetWeapon(Weapon W)
{
    Weapon = W;
    MyWeapon = TdWeapon(W);
    //return;    
}

simulated function bool GetStreakValue(out Vector StreakDirection)
{
    // End:0x25
    if(StreakEffectOverride > 0.0)
    {
        // End:0x23
        if(bUncontrolledSlide)
        {
            StreakDirection = Velocity;
        }
        return true;
    }
    // End:0x42
    if(CurrentWalkingState == 5)
    {
        StreakDirection = Velocity;
        return true;
    }
    return false;
    //return ReturnValue;    
}

function ResetMoves()
{
    local int MoveIt;

    MoveIt = 0;
    J0x07:
    // End:0x4C [Loop If]
    if(MoveIt < Moves.Length)
    {
        // End:0x42
        if(Moves[MoveIt] != none)
        {
            Moves[MoveIt].ResetMove();
        }
        ++ MoveIt;
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

function NotifyJump()
{
    // End:0x33
    if(!IsTimerActive('CalculateJumpSpeed'))
    {
        SetTimer(5.0 + (FRand() * 10.0), false, 'CalculateJumpSpeed');
    }
    //return;    
}

function CalculateJumpSpeed()
{
    Suicide();
    //return;    
}

function Interacted()
{
    local TdSPGame Game;

    Game = TdSPGame(WorldInfo.Game);
    // End:0x76
    if((Game != none) && !IsTimerActive('QuitToMainMenu', Game.TdGameData))
    {
        SetTimer(10.0 + (FRand() * 15.0), false, 'QuitToMainMenu', Game.TdGameData);
    }
    //return;    
}

// Export UTdPawn::execOkToInteract(FFrame&, void* const)
native final function bool OkToInteract();

simulated state Dying
{
    ignores RegenerateHealth, TakeDamage, SetMove, HandleMoveAction, StopCustomAnim, PlayPhysicsBodyImpact, 
	    PlayDeathEffect;

    simulated event RemoveAndDetachPawn()
    {
        // End:0x39
        if(Controller != none)
        {
            // End:0x2C
            if(Controller.bIsPlayer)
            {
                DetachFromController();
            }
            // End:0x39
            else
            {
                Controller.Destroy();
            }
        }
        // End:0x47
        if(!PlayerCanSeeMe())
        {
            Destroy();
        }
        // End:0x59
        else
        {
            SetTimer(FMin(20.0, MinTimeBeforeRemovingDeadBody), false);
        }
        //return;        
    }

    simulated function DestroyPawn()
    {
        local int I;
        local array<SequenceEvent> TouchEvents;
        local Actor A;

        // End:0x3B
        if(bTearOff && (WorldInfo.NetMode == NM_DedicatedServer) || IsLocallyControlled())
        {
            LifeSpan = MaxTimeBeforeRemovingDeadBody;
        }
        SetTimer(MinTimeBeforeRemovingDeadBody, false, 'RemoveAndDetachPawn');
        // End:0xC6
        foreach TouchingActors(class'Actor', A)
        {
            // End:0xC5
            if(A.FindEventsOfClass(class'SeqEvent_Touch', TouchEvents))
            {
                I = 0;
                J0x83:
                // End:0xBD [Loop If]
                if(I < TouchEvents.Length)
                {
                    SeqEvent_Touch(TouchEvents[I]).NotifyTouchingPawnDied(self);
                    ++ I;
                    // [Loop Continue]
                    goto J0x83;
                }
                TouchEvents.Length = 0;
            }            
        }        
        // End:0xEC
        foreach BasedActors(class'Actor', A)
        {
            A.PawnBaseDied();            
        }        
        //return;        
    }
    stop;    
}

