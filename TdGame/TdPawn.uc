// Export UTdPawn::execCanDropWeapon(FFrame&, void* const)
native function bool CanDropWeapon();

function bool CanZoom()
{
    return !(((Moves[MovementState].MovementGroup > 0) || AgainstWallState != 0) || WeaponAnimState == 4) || IsTimerActive('DropWeapon');
    //return ReturnValue;    
}

simulated function DropWeapon()
{
    local TdWeapon TdW;
    local TdAnimNodeSequence AnimSeq1p;

    TdW = MyWeapon;
    // End:0x18
    if(TdW == none)
    {
        return;
    }
    // End:0x3F
    if((WeaponAnimState == 4) || IsTimerActive('RemoveWeaponAfterDrop'))
    {
        return;
    }
    ClearTimer('DropWeapon');
    // End:0x7B
    if(TdW.IsZoomingOrZoomed())
    {
        SetTimer(0.50, false, 'DropWeapon');
        return;
    }
    SetWeaponAnimState(4);
    PlayCustomAnim(1, 'throwaway', 1.0, 0.10, 0.0, false, true, false);
    // End:0x15B
    if(TdW.WeaponType == 1)
    {
        // End:0x112
        if(TdW.WeaponAnimationNode1p != none)
        {
            TdW.WeaponAnimationNode1p.PlayCustomAnim('weaponpose', 1.0, 0.10, -1.0, false, true);
        }
        // End:0x15B
        if(TdW.WeaponAnimationNode3p != none)
        {
            TdW.WeaponAnimationNode3p.PlayCustomAnim('weaponpose', 1.0, 0.10, -1.0, false, true);
        }
    }
    AnimSeq1p = TdAnimNodeSequence(CustomCannedUpperBodyNode1p.GetCustomAnimNodeSeq());
    SetTimer(AnimSeq1p.AnimSeq.SequenceLength, false, 'RemoveWeaponAfterDrop');
    //return;    
}

function TossWeapon(Weapon Weap, optional Vector ForceVelocity)
{
    local TdWeapon TdW;
    local Vector WeaponLocation, WeaponVelocity, WeaponAngularVelocity, v1, v2, v3;

    local Rotator WeaponRotation;

    TdW = TdWeapon(Weap);
    // End:0x19B
    if(TdW != none)
    {
        WeaponLOINotifyOFF();
        GetAxes(Controller.Rotation, v1, v2, v3);
        // End:0xB1
        if(Health <= 0)
        {
            WeaponVelocity = (Velocity * 2.0) + (((v1 * 25.0) + (v2 * 25.0)) + (v3 * 25.0));
            WeaponAngularVelocity.X = 50.0 + (60.0 * FRand());
        }
        // End:0x11E
        else
        {
            WeaponVelocity = ((v1 * TdW.WeaponDropLinearVelocity.X) + (v2 * TdW.WeaponDropLinearVelocity.Y)) + (v3 * TdW.WeaponDropLinearVelocity.Z);
        }
        // End:0x15F
        if(!CanDropWeapon())
        {
            WeaponLocation = Location;
            WeaponRotation = Rotation;
            WeaponRotation.Pitch -= int(16384.0);
        }
        // End:0x173
        else
        {
            GetWeaponJointPosition(WeaponLocation, WeaponRotation);
        }
        TdW.DropFromEx(WeaponLocation, WeaponVelocity, WeaponRotation, WeaponAngularVelocity);
    }
    //return;    
}

function RemoveWeaponAfterDrop()
{
    local TdWeapon TdW;

    TdW = MyWeapon;
    // End:0x8A
    if(TdW != none)
    {
        // End:0x3B
        if(!TdW.bHidden)
        {
            TossWeapon(TdW);
        }
        // End:0x7D
        if(TdW.Instigator.InvManager != none)
        {
            TdW.InvManager.RemoveFromInventory(TdW);
        }
        TdW.Destroy();
    }
    SetAimOffsetNodesProfile('OneHanded');
    //return;    
}

