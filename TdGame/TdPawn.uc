simulated event PreBeginPlay()
{
    super(Pawn).PreBeginPlay();
    //return;    
}

simulated event PostBeginPlay()
{
    super(Pawn).PostBeginPlay();
    InitMoves();
    CacheAnimNodes();
    SlideEffectEmitter = Spawn(class'TdEmitter', self);
    SlideEffectEmitter.bDestroyOnSystemFinish = false;
    SlideEffectEmitter.LifeSpan = 0.0;
    SlideEffectEmitter.KillProjectile();
    MaxHealth = default.Health;
    //return;    
}

simulated function CacheAnimNodes()
{
    local AnimNode Node;
    local AnimNodeAimOffset AimNode;
    local TdAnimNodePoseOffset PoseOffsetNode;

    // End:0xCF
    if(Mesh3p != none)
    {
        RootControl3p = SkelControlSingleBone(Mesh3p.FindSkelControl('RootControl'));
        SwingControl3p = SkelControlSingleBone(Mesh3p.FindSkelControl('SwingControl'));
        LeftLegControl3p = TdSkelControlFootPlacement(Mesh3p.FindSkelControl('LeftFootPlacementControl'));
        RightLegControl3p = TdSkelControlFootPlacement(Mesh3p.FindSkelControl('RightFootPlacementControl'));
        LeftLegControl3p.SetSkelControlStrength(0.0, 0.0);
        RightLegControl3p.SetSkelControlStrength(0.0, 0.0);
    }
    // End:0xE6
    if(Mesh3p.Animations == none)
    {
        return;
    }
    // End:0x400
    foreach Mesh3p.AllAnimNodes(class'AnimNode', Node)
    {
        AimNode = AnimNodeAimOffset(Node);
        PoseOffsetNode = TdAnimNodePoseOffset(Node);
        // End:0x140
        if(AimNode != none)
        {
            AimOffsetNodes[AimOffsetNodes.Length] = AimNode;
        }
        // End:0x158
        if(PoseOffsetNode != none)
        {
            PoseOffsetNodes.AddItem(PoseOffsetNode);
        }
        // End:0x17C
        if(Node.NodeName == 'None')
        {
            continue;            
            // End:0x3FF
            continue;
        }
        // End:0x1AC
        if(Node.NodeName == 'Custom_Canned')
        {
            CustomCannedNode3p = TdAnimNodeSlot(Node);
            // End:0x3FF
            continue;
        }
        // End:0x1DC
        if(Node.NodeName == 'Custom_CannedUpperBody')
        {
            CustomCannedUpperBodyNode3p = TdAnimNodeSlot(Node);
            // End:0x3FF
            continue;
        }
        // End:0x20C
        if(Node.NodeName == 'Custom_FullBody')
        {
            CustomFullBodyNode3p = TdAnimNodeSlot(Node);
            // End:0x3FF
            continue;
        }
        // End:0x23C
        if(Node.NodeName == 'Custom_FullBody_Dir')
        {
            CustomFullBodyDirNode3p = TdAnimNodeSlot(Node);
            // End:0x3FF
            continue;
        }
        // End:0x26C
        if(Node.NodeName == 'Custom_UpperBody')
        {
            CustomUpperBodyNode3p = TdAnimNodeSlot(Node);
            // End:0x3FF
            continue;
        }
        // End:0x29C
        if(Node.NodeName == 'Custom_LowerBody')
        {
            CustomLowerBodyNode3p = TdAnimNodeSlot(Node);
            // End:0x3FF
            continue;
        }
        // End:0x2CC
        if(Node.NodeName == 'Custom_Weapon')
        {
            CustomWeaponNode3p = TdAnimNodeSlot(Node);
            // End:0x3FF
            continue;
        }
        // End:0x2FC
        if(Node.NodeName == 'Custom_Face')
        {
            CustomFaceNode = TdAnimNodeSlot(Node);
            // End:0x3FF
            continue;
        }
        // End:0x32C
