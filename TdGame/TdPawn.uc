event StartPassengerDriving(Vehicle V, int seatIndex)
{
    local name PawnSeatSocket;
    local SkeletalMeshSocket S;

    StopFiring();
    // End:0x17
    if(Health <= 0)
    {
        return;
    }
    PassengerDrivenVehicle = V;
    MyPassengerSeatIndex = seatIndex;
    SetNetUpdateTime(WorldInfo.TimeSeconds - float(1));
    bIgnoreForces = true;
    Velocity = vect(0.0, 0.0, 0.0);
    Acceleration = vect(0.0, 0.0, 0.0);
    bCanTeleport = false;
    SetCollision(false, false);
    bCollideWorld = false;
    SetBase(none);
    SetPhysics(0);
    SetHardAttach(true);
    PawnSeatSocket = TdVehicle(PassengerDrivenVehicle).Seats[seatIndex].CharacterSeatSocket;
    S = V.Mesh.GetSocketByName(PawnSeatSocket);
    SetBase(PassengerDrivenVehicle,, PassengerDrivenVehicle.Mesh, S.BoneName);
    SetRelativeLocation(S.RelativeLocation);
    SetRelativeRotation(S.RelativeRotation);
    SetPhysics(0);
    //return;    
}

event SetAsGunner(Vehicle V, int seatIndex, optional Vector Offset, optional float Yaw)
{
    local name PawnSeatSocket;
    local SkeletalMeshSocket S;
    local Rotator Rot;

    PassengerDrivenVehicle = V;
    MyPassengerSeatIndex = seatIndex;
    SetNetUpdateTime(WorldInfo.TimeSeconds - float(1));
    bIgnoreForces = true;
    Velocity = vect(0.0, 0.0, 0.0);
    Acceleration = vect(0.0, 0.0, 0.0);
    bCanTeleport = false;
    SetCollision(false, false);
    bCollideWorld = false;
    SetBase(none);
    SetPhysics(0);
    SetHardAttach(true);
    PawnSeatSocket = TdVehicle_Helicopter(PassengerDrivenVehicle).Seats[seatIndex].CharacterSeatSocket;
    S = V.Mesh.GetSocketByName(PawnSeatSocket);
    SetBase(PassengerDrivenVehicle,, PassengerDrivenVehicle.Mesh, S.BoneName);
    SetRelativeLocation(S.RelativeLocation + Offset);
    Rot = S.RelativeRotation;
    Rot.Yaw += int(Yaw);
    SetRelativeRotation(Rot);
    SetPhysics(0);
    //return;    
}

event StopPassengerDriving(Vehicle V)
{
    StopFiring();
    // End:0x17
    if(Health <= 0)
    {
        return;
    }
    PassengerDrivenVehicle = none;
    MyPassengerSeatIndex = -1;
    SetNetUpdateTime(WorldInfo.TimeSeconds - float(1));
    bIgnoreForces = false;
    Velocity = vect(0.0, 0.0, 0.0);
    Acceleration = vect(0.0, 0.0, 0.0);
    bCanTeleport = true;
    SetCollision(true, true);
    bCollideWorld = true;
    SetLocation(V.Location + vect(0.0, 0.0, 200.0));
    SetBase(none);
    SetPhysics(1);
    //return;    
}

