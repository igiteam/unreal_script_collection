simulated function FaceRotation(Rotator NewRotation, float DeltaTime)
{
    local Rotator RotDelta, PawnRotation;

    // End:0x0B
    if(bIsUsingRootRotation)
    {
        return;
    }
    // End:0x1A
    if(InFreeCam())
    {
        return;
    }
    // End:0x37
    if(Moves[MovementState].bDisableFaceRotation)
    {
        return;
    }
    // End:0xC1
    if(FaceRotationTimeLeft > 0.0)
    {
        PawnRotation = Rotation;
        RotDelta = Normalize(NewRotation - PawnRotation);
        PawnRotation.Yaw += int(float(RotDelta.Yaw) * FMin(1.0, DeltaTime / FaceRotationTimeLeft));
        SetRotation(Normalize(PawnRotation));
        FaceRotationTimeLeft -= DeltaTime;
        return;
    }
    // End:0xF5
    if(Physics == 1)
    {
        NewRotation.Pitch = 0;
        NewRotation.Roll = 0;
    }
    PawnRotation = Rotation;
    NewRotation = Normalize(NewRotation);
    PawnRotation.Yaw = NewRotation.Yaw;
    // End:0x1A2
    if(Physics == 2)
    {
        NewRotation.Roll = 0;
        NewRotation.Pitch = 0;
        RotDelta = Normalize(NewRotation - Rotation);
        NewRotation = Rotation + ((RotDelta * DeltaTime) * 5.0);
    }
    PawnRotation.Pitch = 0;
    PawnRotation.Roll = 0;
    SetRotation(PawnRotation);
    //return;    
}

