simulated function Tick(float DeltaTime)
{
    AIAimOldMovementState = MovementState;
    UpdateVelocityVariables();
    UpdateWalkingState();
    // End:0x56
    if(Role == ROLE_Authority)
    {
        RegenerateHealth(DeltaTime);
        // End:0x56
        if(ReplicateCustomAnimCount > 1)
        {
            ReplicateCustomAnimCount = 0;
        }
    }
    // End:0x77
    if(!IsLocallyControlled() && IsHumanControlled())
    {
        UpdatePhysicalAnimBlendValue(DeltaTime);
    }
    // End:0x97
    if(ActiveMovementVolume != none)
    {
        ActiveMovementVolume.PawnUpdate(self);
    }
    super(Actor).Tick(DeltaTime);
    //return;    
}

