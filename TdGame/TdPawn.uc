simulated event ReplicatedEvent(name VarName)
{
    // End:0x20
    if(VarName == 'ReplicatedWeaponClass')
    {
        UpdateRemoteWeapon();
    }
    // End:0xE2
    else
    {
        // End:0x41
        if(VarName == 'ReloadCount')
        {
            ReloadCountUpdated(true);
        }
        // End:0xE2
        else
        {
            // End:0x7B
            if(VarName == 'ReplicatedMovementState')
            {
                // End:0x78
                if(ReplicatedMovementState != MovementState)
                {
                    SetMove(ReplicatedMovementState, true);
                }
            }
            // End:0xE2
            else
            {
                // End:0x9B
                if(VarName == 'ReplicatedCustomAnim')
                {
                    PlayReplicatedCustomAnim();
                }
                // End:0xE2
                else
                {
                    // End:0xC1
                    if(VarName == 'AnimationMovementState')
                    {
                        SetAnimationMovementState(AnimationMovementState);
                    }
                    // End:0xE2
                    else
                    {
                        // End:0xD7
                        if(VarName == 'LastPhysHitInfo')
                        {
                        }
                        // End:0xE2
                        else
                        {
                            super(Pawn).ReplicatedEvent(VarName);
                        }
                    }
                }
            }
        }
    }
    //return;    
}

