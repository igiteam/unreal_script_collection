event TakeDamage(int Damage, Controller InstigatedBy, Vector HitLocation, Vector damageMomentum, class<DamageType> DamageType, optional TraceHitInfo HitInfo, optional Actor DamageCauser)
{
    local class<TdDamageType> CurrentDamageType;

    CurrentDamageType = class<TdDamageType>(DamageType);
    // End:0xEE
    if(CurrentDamageType != none)
    {
        LastPhysHitInfo.DamageType = CurrentDamageType;
        LastPhysHitInfo.HitBone = HitInfo.BoneName;
        LastPhysHitInfo.HitLocation = HitLocation;
        LastPhysHitInfo.Momentum = damageMomentum;
        LastPhysHitInfo.HitReactionDuration = CurrentDamageType.default.PhysicsHitReactionDuration;
        // End:0xD8
        if(class<TdDmgType_Bullet>(DamageType) != none)
        {
            LastPhysHitInfo.AngularVelocity = class<TdDmgType_Bullet>(DamageType).default.AngularVelocity;
        }
        // End:0xEE
        else
        {
            LastPhysHitInfo.AngularVelocity = 0.0;
        }
    }
    UpdateSpecialDamage(Damage, DamageType);
    LastDamageTaken = Damage;
    // End:0x146
    if((Health - Damage) <= 0)
    {
        Damage = Moves[MovementState].HandleDeath(Damage);
    }
    // End:0x1FC
    if(IsHumanControlled())
    {
        // End:0x1C1
        if(((class<TdDmgType_Shove>(DamageType) != none) || class<TdDmgType_Melee>(DamageType) != none) || class<TdDmgType_Taser>(DamageType) != none)
        {
            StumbleDamage(((InstigatedBy != none) ? TdPawn(InstigatedBy.Pawn) : none), HitLocation, damageMomentum, DamageType);
        }
        // End:0x1FC
        else
        {
            BulletDamage(((InstigatedBy != none) ? TdPawn(InstigatedBy.Pawn) : none), HitLocation, damageMomentum, DamageType);
        }
    }
    super(Pawn).TakeDamage(Damage, InstigatedBy, HitLocation, damageMomentum, DamageType, HitInfo);
    // End:0x25A
    if((!IsHumanControlled() && Health > 0) && CurrentDamageType != none)
    {
        PlayPhysicsBodyImpact(InstigatedBy, LastPhysHitInfo);
    }
    UpdateDamageStats(InstigatedBy, DamageType);
    TimeSinceLastDamage = 0.0;
    HealthFrac = 0.0;
    //return;    
}

function UpdateSpecialDamage(out int Damage, class<DamageType> DamageType)
{
    local Vector ElectricShockVelocity;

    // End:0x4A
    if((DamageType == class'TdDmgType_Flashbang') || DamageType == class'TdDmgType_HeavyFlashbang')
    {
        StunDamageLevel = FClamp(StunDamageLevel + float(Damage), 0.0, 100.0);
        Damage = 1;
    }
    // End:0x123
    else
    {
        // End:0x123
        if(DamageType == class'TdDmgType_ElectricShock')
        {
            // End:0x96
            if(!Moves[MovementState].bUseCustomCollision && Physics == 2)
            {
                SetMove(2);
            }
            ElectricShockVelocity = -VelocityDir;
            ElectricShockVelocity.Z = FClamp(class'TdDmgType_ElectricShock'.default.DamageZDirection, 0.10, 1.0);
            ElectricShockVelocity = ElectricShockVelocity * class'TdDmgType_ElectricShock'.default.DamageImpulse;
            Velocity = ElectricShockVelocity;
            Acceleration = Normal(ElectricShockVelocity);
            TaserDamageLevel = FClamp(TaserDamageLevel + float(Damage), 0.0, 100.0);
        }
    }
    //return;    
}

function UpdateDamageStats(Controller InstigatedBy, class<DamageType> DamageType)
{
    local TdPlayerController TargetPC, SourcePC;

    // End:0x94
    if((class<TdDmgType_Bullet>(DamageType) != none) || DamageType == class'TdDmgType_Taser')
    {
        // End:0x91
        if(InstigatedBy != none)
        {
            TargetPC = TdPlayerController(Controller);
            // End:0x60
            if(TargetPC != none)
            {
                TargetPC.AddStatsEvent(4);
            }
            // End:0x91
            else
            {
                SourcePC = TdPlayerController(InstigatedBy);
                // End:0x91
                if(SourcePC != none)
                {
                    SourcePC.AddStatsEvent(5);
                }
            }
        }
    }
    // End:0xD4
    else
    {
        // End:0xD4
        if(DamageType == class'TdDmgType_MeleeWallRun')
        {
            SourcePC = TdPlayerController(InstigatedBy);
            // End:0xD4
            if(SourcePC != none)
            {
                SourcePC.AddStatsEvent(2);
            }
        }
    }
    //return;    
}

function AdjustDamage(out int inDamage, out Vector OutMomentum, Controller InstigatedBy, Vector HitLocation, class<DamageType> DamageType, optional TraceHitInfo HitInfo)
{
    local editinline TdSkeletalMeshComponent MeshComponent;
    local float ArmorValue;

    MeshComponent = TdSkeletalMeshComponent(HitInfo.HitComponent);
    // End:0x29
    if(MeshComponent == none)
    {
        return;
    }
    // End:0x73
    if(HitInfo.BoneName == 'Neck')
    {
        // End:0x65
        if(class<TdDmgType_Melee>(DamageType) != none)
        {
            ArmorValue = ArmorMeleeHead;
        }
        // End:0x70
        else
        {
            ArmorValue = ArmorBulletsHead;
        }
    }
    // End:0x162
    else
    {
        // End:0x139
        if(((MeshComponent.IsChildBoneOf(HitInfo.BoneName, 'LeftUpLeg') || MeshComponent.IsChildBoneOf(HitInfo.BoneName, 'RightUpLeg')) || HitInfo.BoneName == 'RightUpLeg') || HitInfo.BoneName == 'LeftUpLeg')
        {
            // End:0x12B
            if(class<TdDmgType_Melee>(DamageType) != none)
            {
                ArmorValue = ArmorMeleeLegs;
            }
            // End:0x136
            else
            {
                ArmorValue = ArmorBulletsLegs;
            }
        }
        // End:0x162
        else
        {
            // End:0x157
            if(class<TdDmgType_Melee>(DamageType) != none)
            {
                ArmorValue = ArmorMeleeBody;
            }
            // End:0x162
            else
            {
                ArmorValue = ArmorBulletsBody;
            }
        }
    }
    inDamage = Max(0, int(float(inDamage) * (1.0 - ArmorValue)));
    //return;    
}

function bool Died(Controller Killer, class<DamageType> DamageType, Vector HitLocation)
{
    local bool retval;

    Moves[MovementState].StopMove();
    retval = super(Pawn).Died(Killer, DamageType, HitLocation);
    // End:0x64
    if(retval)
    {
        NotifyTakeHit(Killer, HitLocation, LastDamageTaken, DamageType, TearOffMomentum);
    }
    return retval;
    //return ReturnValue;    
}

