class TdBotPawn_Tutorial extends TdBotPawn
    config(AI)
    hidecategories(Navigation);

exec function AnimationHideWeapon()
{
    Weapon.Mesh.SetHidden(false);
    //return;    
}

simulated function Turn(float DeltaTime)
{
    //return;    
}

simulated event PostBeginPlay()
{
    local TdAnimNodeDirBone AimNode;

    // End:0x3B
    foreach Mesh.AllAnimNodes(class'TdAnimNodeDirBone', AimNode)
    {
        // End:0x3A
        if(AimNode != none)
        {
            AimNode.bUsePitch = false;
        }        
    }    
    super.PostBeginPlay();
    //return;    
}

function TakeDamage(int Damage, Controller InstigatedBy, Vector HitLocation, Vector damageMomentum, class<DamageType> DamageType, optional TraceHitInfo HitInfo, optional Actor DamageCauser)
{
    // End:0x37
    if(class<TdDmgType_Bullet>(DamageType) == none)
    {
        super.TakeDamage(0, InstigatedBy, HitLocation, damageMomentum, DamageType, HitInfo, DamageCauser);
    }
    myController.NotifyDamage(InstigatedBy, DamageType, 0);
    //return;    
}

event AddToInventory(class<TdWeapon> WeaponClass)
{
    super.AddToInventory(WeaponClass);
    InitializeWeaponAnimationSets();
    //return;    
}

function bool PreventWeaponImpactEffect(Controller InstigatorController)
{
    return true;
    //return ReturnValue;    
}

