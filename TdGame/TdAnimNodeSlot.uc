final function AccelerateBlend(float BlendAmount)
{
    local int I;
    local float BlendDelta;

    I = 0;
    J0x07:
    // End:0x6E [Loop If]
    if(I < Children.Length)
    {
        BlendDelta = TargetWeight[I] - Children[I].Weight;
        Children[I].Weight += (BlendDelta * BlendAmount);
        ++ I;
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}
