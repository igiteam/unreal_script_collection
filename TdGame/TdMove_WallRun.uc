function bool CanDoMove()
{
    local LedgeHitInfo WallRunHit;
    local TdMovementExclusionVolume EMVolume;
    local TdPawn.EMovement WantedMove;
    local float LastJumpLocationDelta;
    local Vector StartTrace, EndTrace, Extent;
    local float HalfVel2DSize;

    // End:0x0D
    if(!super(TdMove).CanDoMove())
    {
        return false;
    }
    // End:0x2A
    if(PawnOwner.GetWeaponType() == 1)
    {
        return false;
    }
    // End:0x4D
    if(VSizeSq2D(PawnOwner.Velocity) < Square(WallRunningMinSpeed))
    {
        return false;
    }
    // End:0x7B
    if((PawnOwner.Velocity Dot vector(PawnOwner.Rotation)) < 0.0)
    {
        return false;
    }
    LastJumpLocationDelta = VSize(PawnOwner.Location - PawnOwner.LastJumpLocation);
    WantedMove = 0;
    // End:0x101
    if(LastJumpLocationDelta < 30.0)
    {
        // End:0xDF
        if(PawnOwner.MoveActionHint == 2)
        {
            WantedMove = 4;
        }
        // End:0x101
        else
        {
            // End:0x101
            if(PawnOwner.MoveActionHint == 1)
            {
                WantedMove = 5;
            }
        }
    }
    // End:0x138
    if((WantedMove != 0) && FindWallSide(WantedMove, WallRunHit))
    {
        NextMove = WantedMove;
    }
    // End:0x14D
    else
    {
        NextMove = FindWallForward(WallRunHit);
    }
    // End:0x15F
    if(NextMove == 0)
    {
        return false;
    }
    // End:0x175
    if(WallRunHit.FeetExcluded)
    {
        return false;
    }
    EMVolume = GetMovementExclusionVolume(WallRunHit.LedgeLocation);
    // End:0x1B3
    if((EMVolume != none) && EMVolume.bExcludeFootMoves)
    {
        return false;
    }
    // End:0x1E0
    if((PawnOwner.Velocity Dot WallRunHit.MoveNormal) >= 0.0)
    {
        return false;
    }
    // End:0x36F
    if(PawnOwner.Velocity.Z < 0.0)
    {
        StartTrace = WallRunHit.LedgeLocation + (WallRunHit.MoveNormal * PawnOwner.CylinderComponent.CollisionRadius);
        StartTrace.Z -= (PawnOwner.CylinderComponent.CollisionHeight * 2.0);
        HalfVel2DSize = VSize2D(PawnOwner.Velocity) * 0.50;
        // End:0x2DA
        if(NextMove == 4)
        {
            EndTrace = (WallRunHit.MoveNormal Cross vect(0.0, 0.0, -1.0)) * HalfVel2DSize;
        }
        // End:0x306
        else
        {
            EndTrace = (WallRunHit.MoveNormal Cross vect(0.0, 0.0, 1.0)) * HalfVel2DSize;
        }
        EndTrace.Z -= 45.0;
        EndTrace += StartTrace;
        Extent.X = 1.0;
        Extent.Y = 1.0;
        // End:0x36F
        if(MovementTraceForBlocking(EndTrace, StartTrace, Extent))
        {
            return false;
        }
    }
    PawnOwner.MovementActor = WallRunHit.MoveActor;
    PawnOwner.bFoundLedgeExcludesFootMoves = WallRunHit.FeetExcluded;
    PawnOwner.bFoundLedgeExcludesHandMoves = WallRunHit.HandsExcluded;
    PawnOwner.MoveNormal = WallRunHit.MoveNormal;
    WallNormal = WallRunHit.MoveNormal;
    PredictedWallHitLocation = WallRunHit.LedgeLocation;
    return true;
    //return ReturnValue;    
}

simulated function int HandleDeath(int Damage)
{
    PawnOwner.SetMove(2);
    PawnOwner.SetAnimationMovementState(72);
    return super(TdMove).HandleDeath(Damage);
    //return ReturnValue;    
}

simulated function ReachedWall()
{
    local Vector Velocity2D;

    Velocity2D = PawnOwner.Velocity;
    Velocity2D.Z = 0.0;
    Velocity2D = WallRunningBeginSpeed * Normal(Velocity2D);
    PawnOwner.Velocity.X = Velocity2D.X;
    PawnOwner.Velocity.Y = Velocity2D.Y;
    // End:0x119
    if(PlayCameraHitWallEffect)
    {
        // End:0xDD
        if(PawnOwner.MovementState == 4)
        {
            PlayMoveAnim(6, 'wallrunimpactright', 1.0, 0.150, 0.150);
        }
        // End:0x119
        else
        {
            // End:0x119
            if(PawnOwner.MovementState == 5)
            {
                PlayMoveAnim(6, 'wallrunimpactleft', 1.0, 0.150, 0.150);
            }
        }
    }
    bHasReachedWall = true;
    bDisableFaceRotation = true;
    //return;    
}

simulated function StartMove()
{
    local Vector WallrunDir, HitLocation, HitNormal, Start, End, Extent;

    local float Grav, Speed, WallRunHeight, AnimPlayRate;

    super.StartMove();
    bHasReachedWall = false;
    bStartMovingIntoWall = true;
    bChangedConstraints = false;
    bTurned90FromWall = false;
    WallRunningBeginSpeed = VSize2D(PawnOwner.Velocity);
    // End:0x77
    if(PawnOwner.Velocity.Z > 0.0)
    {
        WallRunningBeginSpeed = FMax(WallRunningBeginSpeed, WallRunningVelocityStartLimit);
    }
    // End:0xC9
    if(PawnOwner.OldMovementState == 12)
    {
        ++ ConsequtiveWallruns;
        WallRunningHorisontalDeceleration = default.WallRunningHorisontalDeceleration * float(1 + ConsequtiveWallruns);
        WallRunningHorisontalAcceleration = default.WallRunningHorisontalAcceleration * float(1 + ConsequtiveWallruns);
    }
    // End:0xE6
    else
    {
        ConsequtiveWallruns = 0;
        WallRunningHorisontalDeceleration = default.WallRunningHorisontalDeceleration;
        WallRunningHorisontalAcceleration = default.WallRunningHorisontalAcceleration;
    }
    PawnOwner.SetPhysics(12);
    bHasReachedWall = false;
    bStartMovingIntoWall = false;
    WallrunDir = vector(PawnOwner.Rotation);
    WallrunDir -= ((WallrunDir Dot WallNormal) * WallNormal);
    WallrunDir.Z = 0.0;
    WallrunDir = Normal(WallrunDir);
    Start = PawnOwner.Location;
    End = Start;
    End.Z += WallRunningHorisontalInitialZHeight;
    // End:0x1F3
    if(MovementTrace(HitLocation, HitNormal, End, Start, PawnOwner.GetCollisionExtent()))
    {
        WallRunHeight = HitLocation.Z - PawnOwner.Location.Z;
    }
    // End:0x1FE
    else
    {
        WallRunHeight = WallRunningHorisontalInitialZHeight;
    }
    WallRunHeight -= (PawnOwner.Location.Z - PawnOwner.LastJumpLocation.Z);
    WallRunHeight = float(Max(int(WallRunHeight), 0));
    Grav = WallRunningHorisontalAcceleration;
    Speed = Sqrt((2.0 * WallRunHeight) * Grav);
    // End:0x2D3
    if((PawnOwner.Velocity.Z > 0.0) && PawnOwner.OldMovementState != 12)
    {
        PawnOwner.Velocity.Z = Speed;
    }
    PawnOwner.SetBase(PawnOwner.MovementActor, WallNormal);
    SetTimer(WallRunningDelayPawnRotationTime);
    Extent.X = PawnOwner.CylinderComponent.CollisionRadius;
    Extent.Y = PawnOwner.CylinderComponent.CollisionRadius;
    Extent.Z = 10.0;
    Start = PredictedWallHitLocation;
    Start.Z += ((PawnOwner.CylinderComponent.CollisionHeight + 30.0) + Extent.Z);
    End = Start + (-WallNormal * WallRunningStrafeCheckDistance);
    AnimPlayRate = WallrunStartUpperBodyAnimPlayRate;
    // End:0x409
    if(!MovementTraceForBlocking(End, Start, Extent))
    {
        AnimPlayRate = 1.0;
    }
    // End:0x48B
    if(PawnOwner.MovementState == 4)
    {
        PlayMoveAnim(2, 'wallrunrightstart', AnimPlayRate, WallRunningIntoWallrunBlendInTime, WallRunningIntoWallrunBlendOutTime);
        MinContraintWorld = NormalizeRotAxis(rotator(WallNormal).Yaw);
        MaxContraintWorld = NormalizeRotAxis(rotator(WallNormal).Yaw + 16384);
    }
    // End:0x50A
    else
    {
        // End:0x50A
        if(PawnOwner.MovementState == 5)
        {
            PlayMoveAnim(2, 'wallrunleftstart', AnimPlayRate, WallRunningIntoWallrunBlendInTime, WallRunningIntoWallrunBlendOutTime);
            MinContraintWorld = NormalizeRotAxis(rotator(WallNormal).Yaw - 16384);
            MaxContraintWorld = NormalizeRotAxis(rotator(WallNormal).Yaw);
        }
    }
    TdPlayerController(PawnOwner.Controller).ClientPlayForceFeedbackWaveform(IntoWallrunWaveform);
    //return;    
}

simulated function OnTimer()
{
    FacePawnAlongWall();
    //return;    
}

simulated function FacePawnAlongWall()
{
    local Rotator NewRotation;

    NewRotation = rotator(WallNormal);
    NewRotation.Yaw += ((PawnOwner.MovementState == 4) ? 16384 : -16384);
    PawnOwner.MoveNormal = WallNormal;
    SetPreciseRotation(NewRotation, WallRunningRotatePawnAlongWallTime);
    //return;    
}

simulated function HandleMoveAction(TdPawn.EMovementAction Action)
{
    local Rotator WantedRotation;
    local Controller C;
    local TdPlayerPawn PlayerPawn;

    // End:0xD6
    if(Action == 16)
    {
        // End:0x4F
        if(!bTurned90FromWall)
        {
            PlayerPawn = TdPlayerPawn(PawnOwner);
            // End:0x4F
            if(PlayerPawn != none)
            {
                PlayerPawn.StartStringableMove(Class);
            }
        }
        C = PawnOwner.Controller;
        WantedRotation = rotator(PawnOwner.Floor);
        // End:0xB1
        if(C != none)
        {
            WantedRotation.Pitch = C.Rotation.Pitch;
        }
        bDisableControllerFacingPawnYawRotation = true;
        SetLookAtTargetAngle(WantedRotation, 0.150, 1.50);
        bTurned90FromWall = true;
    }
    //return;    
}

simulated function bool IsThisMoveStringable()
{
    return true;
    //return ReturnValue;    
}

simulated function StopMove()
{
    NextMove = 0;
    // End:0x5C
    if(!bTurned90FromWall)
    {
        PawnOwner.FaceRotationTimeLeft = 0.30;
        PawnOwner.LegRotation = PawnOwner.Controller.Rotation.Yaw;
    }
    super.StopMove();
    //return;    
}

simulated function TakeTaserDamage(Vector ImpactMomentum)
{
    // End:0x3C
    if(PawnOwner.Moves[2].CanDoMove())
    {
        PawnOwner.SetMove(2);
    }
    //return;    
}

