function bool HandleInputKey(const out InputEventParameters EventParms)
{
    local bool Result;

    Result = false;
    // End:0x1BA
    if(EventParms.EventType == 1)
    {
        // End:0x6A
        if(EventParms.InputKeyName == 'XboxTypeS_RightShoulder')
        {
            Backend.RequestTeamChange(GetPlayerOwner().Actor, 1);
        }
        // End:0x1BA
        else
        {
            // End:0xB5
            if(EventParms.InputKeyName == 'XboxTypeS_LeftShoulder')
            {
                Backend.RequestTeamChange(GetPlayerOwner().Actor, -1);
            }
            // End:0x1BA
            else
            {
                // End:0xFC
                if(EventParms.InputKeyName == 'XboxTypeS_RightTrigger')
                {
                    Backend.RequestRoleChange(GetPlayerOwner().Actor, 1);
                }
                // End:0x1BA
                else
                {
                    // End:0x147
                    if(EventParms.InputKeyName == 'XboxTypeS_LeftTrigger')
                    {
                        Backend.RequestRoleChange(GetPlayerOwner().Actor, -1);
                    }
                    // End:0x1BA
                    else
                    {
                        // End:0x18D
                        if(EventParms.InputKeyName == 'XboxTypeS_X')
                        {
                            Backend.RequestSetReady(GetPlayerOwner().Actor);
                        }
                        // End:0x1BA
                        else
                        {
                            // End:0x1BA
                            if(EventParms.InputKeyName == 'XboxTypeS_B')
                            {
                                __OnSceneClosed__Delegate = OnQuitToMainMenu;
                            }
                        }
                    }
                }
            }
        }
    }
    return Result;
    //return ReturnValue;    
}

defaultproperties
{
    SettingsDataStoreName=TdMPGameSettings
    EventProvider=UIComp_Event'Default__TdUIScene_Lobby.SceneEventComponent'
}