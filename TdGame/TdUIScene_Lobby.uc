function bool OnStartGamePrepare(UIScreenObject Sender, int PlayerIndex)
{
    __OnSceneClosed__Delegate = OnStartGame;
    return true;
    //return ReturnValue;    
}

function OnStartGame()
{
    local string MapName, GameMode;

    MapName = TdGameData.GetFileNameFromMapIndex(TdGameData.CurrentMap);
    GameMode = TdGameData.GetGameModeClassNameFromIndex(TdGameData.CurrentGameMode);
    Backend.StartGame(MapName, GameMode);
    //return;    
}

