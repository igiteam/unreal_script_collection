        PlayerWidgets[7]=none
    }
};

var UIDataStore_TdGameData TdGameData;
var UIDataStore_TdMPData TdMPData;
var() name SettingsDataStoreName;
var private transient TdLobbyBackend Backend;
var transient LobbyTeamWidgets TeamWidgets[2];
var transient UILabelButton StartGameButton;
var transient UIPanel SettingsPanel;
var transient UILabel NumPlayersInLobbyLabel;
var transient TdUIDrawLobbyPlayersPanel PlayersPanel;
var transient UITdOptionButton MapOptionList;
var transient UIPanel ButtonsPanel;
var bool bIsControllingClient;
var delegate<OnSceneClosed> __OnSceneClosed__Delegate;

delegate OnSceneClosed()
{
    //return;    
}

event PostInitialize()
{
    super.PostInitialize();
    Backend = new class'TdLobbyListenServerBackend';
    Backend.SetListener(TdLobbyEventListener(self));
    TdGameData = GetGameDataStore();
    TdMPData = UIDataStore_TdMPData(FindDataStore(SettingsDataStoreName));
    SettingsPanel.SetVisibility(bIsControllingClient);
    // End:0xA2
    if(bIsControllingClient)
    {
        // End:0xA2
        if(StartGameButton != none)
        {
            StartGameButton.__OnClicked__Delegate = OnStartGamePrepare;
        }
    }
    MapOptionList.__NotifyActiveStateChanged__Delegate = OnMapOptionList_ActiveStateChanged;
    ButtonsPanel.__NotifyActiveStateChanged__Delegate = OnButtonsPanel_ActiveStateChanged;
    PlayersPanel.__OnPlayerSlotClicked__Delegate = PlayersPanel_OnPlayerSlotClicked;
    SetPlayerDataWidgetBindings();
    //return;    
}

event SceneDeactivated()
{
    super.SceneDeactivated();
    Backend.Cleanup();
    //return;    
}

simulated function SetPlayerDataWidgetBindings()
{
    NumPlayersInLobbyLabel = UILabel(FindChild(name("NumPlayersInLobbyLabel"), true));
    //return;    
}

function OnMapOptionList_ActiveStateChanged(UIScreenObject Sender, int PlayerIndex, UIState NewlyActiveState, optional UIState PreviouslyActiveState)
{
    OnPrepareEnterPlayerPanel(3);
    //return;    
}

function OnButtonsPanel_ActiveStateChanged(UIScreenObject Sender, int PlayerIndex, UIState NewlyActiveState, optional UIState PreviouslyActiveState)
{
    OnPrepareEnterPlayerPanel(1);
    //return;    
}

function OnPrepareEnterPlayerPanel(Engine.UIRoot.EUIWidgetFace EnterFromFace)
{
    // End:0x29
    if(EnterFromFace == 1)
    {
        PlayersPanel.SetSelectedSlot(0, 0);
    }
    // End:0x65
    else
    {
        // End:0x65
        if(EnterFromFace == 3)
        {
            PlayersPanel.SetSelectedSlot(0, PlayersPanel.GetMaxPlayersInTeam() - 1);
        }
    }
    //return;    
}

