    ActiveGrenade = Grenade;
    //return;    
}

function bool NearbyOffensiveGrenadeExists(TdBotPawn Pawn)
{
    // End:0x3E
    if(ActiveGrenade != none)
    {
        return VSize2D(Pawn.Location - ActiveGrenade.Location) < float(3000);
    }
    // End:0x40
    else
    {
        return false;
    }
    //return ReturnValue;    
}

