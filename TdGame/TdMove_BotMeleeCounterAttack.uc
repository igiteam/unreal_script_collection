class TdMove_BotMeleeCounterAttack extends TdMove_BotMelee
    config(AIMeleeAttacks);

function bool CanDoMove()
{
    // End:0x2A
    if(!BotOwner.myController.IsEnemyWithinDot(0.150))
    {
        return false;
    }
    // End:0x4F
    if(BotOwner.myController.EnemyDistance2d > 200.0)
    {
        return false;
    }
    return super.CanDoMove();
    //return ReturnValue;    
}

simulated function StartMove()
{
    SetPawnRotation();
    super.StartMove();
    //return;    
}

simulated function StopMove()
{
    super.StopMove();
    //return;    
}

function SetPawnRotation()
{
    local TdPlayerPawn PlayerPawn;
    local Rotator BotOwnerRotation;

    PlayerPawn = TdPlayerPawn(BotOwner.myController.Enemy);
    BotOwnerRotation = BotOwner.Rotation;
    BotOwnerRotation.Yaw = rotator(PlayerPawn.Location - BotOwner.Location).Yaw;
    BotOwner.SetRotation(BotOwnerRotation);
    BotOwner.DesiredRotation = BotOwnerRotation;
    BotOwner.LegRotation = BotOwnerRotation.Yaw;
    //return;    
}

simulated function OnCustomAnimEnd(AnimNodeSequence SeqNode, float PlayedTime, float ExcessTime)
{
    CurrentCustomAnimName = 'None';
    // End:0x52
    if(!BotOwner.myController.IsEnemyWithinDot(0.0))
    {
        PawnOwner.SetMove(45);
    }
    // End:0x67
    else
    {
        super.OnCustomAnimEnd(SeqNode, PlayedTime, ExcessTime);
    }
    //return;    
}

simulated function OnAnimationStopped(AnimNodeSequence SeqNode)
{
    CurrentCustomAnimName = 'None';
    // End:0x50
    if(BotOwner.myController.IsEnemyWithinDot(0.0))
    {
        PawnOwner.SetMove(1);
    }
    // End:0x68
    else
    {
        PawnOwner.SetMove(45);
    }
    //return;    
}
