function bool CanDoMove()
{
    // End:0x1C
    if(PawnOwner.MovementState != 14)
    {
        return false;
    }
    // End:0x2D
    if(!IsFacingLedge())
    {
        return false;
    }
    return super(TdMove).CanDoMove();
    //return ReturnValue;    
}

simulated function StartMove()
{
    local TdPlayerPawn PlayerPawn;

    PlayerPawn = TdPlayerPawn(PawnOwner);
    PlayerPawn.SetAmbientShadowDirection(PawnOwner.MoveNormal, true);
    bSlopedLedge = PawnOwner.MoveLedgeNormal.Z < 0.9990;
    RelativeExtent = CalculateRelativeExtent(PawnOwner.CylinderComponent.CollisionRadius);
    RootOffset.X += (RelativeExtent + ((IsHangingFree()) ? 0.0 : 1.0));
    // End:0xE2
    if(bSlopedLedge && IsHangingFree())
    {
        RootOffset.Z += 3.0;
    }
    super.StartMove();
    SetMoveTimer(0.20, false, 'SetDPG');
    // End:0x153
    if(PawnOwner.Weapon != none)
    {
        // End:0x13F
        if(CurrentFoldedType == 1)
        {
            PawnOwner.SetWeaponAnimState(0);
        }
        // End:0x153
        else
        {
            PawnOwner.SetUnarmed();
        }
    }
    PawnOwner.Velocity = vect(0.0, 0.0, 0.0);
    TargetYaw = -1;
    TransferMove = TdMove_GrabTransfer(PawnOwner.Moves[31]);
    CurrentShimmyMove = 3;
    PawnOwner.CurrentGrabTurnType = 0;
    UpdateViewConstraints();
    bHangFreeVertigoEffect = false;
    bClimpUpFoldedActionReceived = false;
    bRequestDropDown = false;
    LastShimmyTimeSeconds = PawnOwner.WorldInfo.TimeSeconds;
    // End:0x206
    if(bSlopedLedge)
    {
        EnableGrabIK();
    }
    // End:0x257
    if(PlayerPawn.bTakeFallDamage)
    {
        PlayerPawn.TakeFallingDamage();
        PlayerPawn.EnterFallingHeight = PlayerPawn.Location.Z;
    }
    //return;    
}

function SetDPG()
{
    local TdPlayerPawn Pawn;

    Pawn = TdPlayerPawn(PawnOwner);
    // End:0x97
    if(Pawn != none)
    {
        Pawn.SetFirstPersonDPG(2);
        Pawn.Mesh3p.bCullModulatedShadowOnBackfaces = false;
        Pawn.SetShadowType(Pawn.Mesh1p, 0);
        Pawn.SetShadowType(Pawn.Mesh3p, 2);
    }
    //return;    
}

simulated function EnableGrabIK()
{
    local Vector LeftHandLocation, RightHandLocation, Right;

    Right = PawnOwner.MoveNormal Cross PawnOwner.MoveLedgeNormal;
    LeftHandLocation = PawnOwner.MoveLedgeLocation - (Right * 20.0);
    RightHandLocation = PawnOwner.MoveLedgeLocation + (Right * 20.0);
    LeftHandLocation.Z -= 11.0;
    RightHandLocation.Z -= 11.0;
    LeftHandLocation += (PawnOwner.MoveNormal * 3.0);
    RightHandLocation += (PawnOwner.MoveNormal * 3.0);
    PawnOwner.LeftHandWorldIKController.SetSkelControlStrength(1.0, 0.10);
    PawnOwner.LeftHandWorldIKController.EffectorLocation = LeftHandLocation;
    PawnOwner.LeftHandWorldIKController.EffectorLocationSpace = 0;
    PawnOwner.RightHandWorldIKController.SetSkelControlStrength(1.0, 0.10);
    PawnOwner.RightHandWorldIKController.EffectorLocation = RightHandLocation;
    PawnOwner.RightHandWorldIKController.EffectorLocationSpace = 0;
    //return;    
}

simulated function StopMove()
{
    local TdPlayerPawn PlayerPawn;

    PlayerPawn = TdPlayerPawn(PawnOwner);
    PlayerPawn.ResetAmbientShadowDirection(true);
    super.StopMove();
    PawnOwner.UseRootMotion(false);
    PawnOwner.UseRootRotation(false);
    PawnOwner.FaceRotationTimeLeft = 0.50;
    PawnOwner.LegRotation = PawnOwner.Controller.Rotation.Yaw;
    TransferMove = none;
    // End:0xE1
    if((PawnOwner.PendingMovementState != 10) && !bRequestDropDown)
    {
        PawnOwner.DisableHandsWorldIK();
    }
    // End:0x10C
    if(CurrentFoldedType != 1)
    {
        PawnOwner.StopCustomAnim(2, 0.20);
    }
    PlayerPawn.Mesh3p.bCullModulatedShadowOnBackfaces = true;
    PlayerPawn.SetShadowType(PlayerPawn.Mesh1p, 1);
    PlayerPawn.SetShadowType(PlayerPawn.Mesh3p, 1);
    RootOffset = default.RootOffset;
    bHangFreeVertigoEffect = false;
    bGrabFromVerticalWallrun = false;
    bRequestDropDown = false;
    bConstrainLook = true;
    bGrabFromHighZSpeed = false;
    //return;    
}

// Export UTdMove_Grab::execIsHangingFree(FFrame&, void* const)
native simulated function bool IsHangingFree();

simulated function bool IsFacingLedge()
{
    local float DotProduct;

    DotProduct = -PawnOwner.MoveNormal Dot vector(PawnOwner.Rotation);
    // End:0x4B
    if(DotProduct < Cos((GrabMaxAngle * 3.1415930) / 180.0))
    {
        return false;
    }
    return true;
    //return ReturnValue;    
}

simulated event UpdateGrabType(bool bMovingLeft)
{
    local TdAnimNodeSequence AnimNodeSeq1pPrev, AnimNodeSeq3pPrev, AnimNodeSeq1p, AnimNodeSeq3p;
    local float PrevNormalizedPosition;

    UpdateViewConstraints();
    // End:0x52
    if(PawnOwner.GrabAnimNode1p != none)
    {
        PawnOwner.GrabAnimNode1p.SetActiveMove(((GrabType == 0) ? 0 : 1));
    }
    // End:0x9A
    if(PawnOwner.GrabAnimNode3p != none)
    {
        PawnOwner.GrabAnimNode3p.SetActiveMove(((GrabType == 0) ? 0 : 1));
    }
    AnimNodeSeq1pPrev = TdAnimNodeSequence(PawnOwner.CustomFullBodyNode1p.GetCustomAnimNodeSeq());
    AnimNodeSeq3pPrev = TdAnimNodeSequence(PawnOwner.CustomFullBodyNode3p.GetCustomAnimNodeSeq());
    PawnOwner.CustomFullBodyNode1p.SetBlendOutTime(-1.0);
    PawnOwner.CustomFullBodyNode3p.SetBlendOutTime(-1.0);
    PlayMoveAnim(2, ((IsHangingFree()) ? ((bMovingLeft) ? 'HangFreeStrafeLeft' : 'HangFreeStrafe') : ((bMovingLeft) ? 'HangStrafeLeft' : 'HangStrafeRight')), 1.0, 0.20, 0.0);
    PrevNormalizedPosition = AnimNodeSeq1pPrev.GetNormalizedPosition();
    AnimNodeSeq1p = TdAnimNodeSequence(PawnOwner.CustomFullBodyNode1p.GetCustomAnimNodeSeq());
    AnimNodeSeq3p = TdAnimNodeSequence(PawnOwner.CustomFullBodyNode3p.GetCustomAnimNodeSeq());
    AnimNodeSeq1p.SetPosition(PrevNormalizedPosition * AnimNodeSeq1pPrev.GetAnimPlaybackLength(), false);
    AnimNodeSeq3p.SetPosition(PrevNormalizedPosition * AnimNodeSeq3pPrev.GetAnimPlaybackLength(), false);
    AnimNodeSeq1p.bResetOnBecomeRelevant = false;
    AnimNodeSeq3p.bResetOnBecomeRelevant = false;
    RootOffset.X += ((IsHangingFree()) ? -1.0 : 1.0);
    PawnOwner.SetRootOffset(RootOffset, 0.30);
    //return;    
}

simulated function SetGrabType(TdMove_Grab.EGrabType NewGrabType)
{
    PreviousGrabType = GrabType;
    GrabType = NewGrabType;
    //return;    
}

simulated function TdMove_Grab.EGrabType GetGrabType()
{
    return GrabType;
    //return ReturnValue;    
}

