}

simulated function SetCurrentFoldedType(TdMove_Grab.EGrabFoldedType NewFoldedType)
{
    CurrentFoldedType = NewFoldedType;
    //return;    
}

private final simulated function bool CanDropDown()
{
    // End:0x0B
    if(bHangFreeVertigoEffect)
    {
        return false;
    }
    // End:0x16
    if(bRequestDropDown)
    {
        return false;
    }
    return CurrentFoldedType == 0;
    //return ReturnValue;    
}

simulated function bool CanPullUp()
{
    // End:0x0B
    if(bHangFreeVertigoEffect)
    {
        return false;
    }
    // End:0x27
    if(bGrabFromVerticalWallrun && MoveActiveTime < 1.0)
    {
        return false;
    }
    // End:0x3E
    if(GetCurrentFoldedType() == 2)
    {
        return false;
    }
    // End:0x49
    if(bRequestDropDown)
    {
        return false;
    }
    // End:0x65
    if(bGrabFromHighZSpeed && MoveActiveTime < 1.0)
    {
        return false;
    }
    return true;
    //return ReturnValue;    
}

simulated function RequestDropDown()
{
    // End:0xF6
    if(CanDropDown())
    {
        // End:0xCF
        if(((CurrentShimmyMove != 2) && PawnOwner.CurrentGrabTurnType == 0) && !bGrabFromVerticalWallrun || bGrabFromVerticalWallrun && MoveActiveTime > 1.0)
        {
            PlayMoveAnim(2, ((IsHangingFree()) ? 'HangFreeEnd' : 'HangEnd'), 1.0, 0.10, 0.20);
            PawnOwner.SetAnimationMovementState(2, 0.20);
            SetMoveTimer(0.20, false, 'OnChangeDPGTimer');
        }
        // End:0xD5
        else
        {
            DropDown();
        }
        bRequestDropDown = true;
        PawnOwner.DisableHandsWorldIK(0.30);
    }
    //return;    
}

simulated function OnChangeDPGTimer()
{
    local TdPlayerPawn PlayerPawn;

    PlayerPawn = TdPlayerPawn(PawnOwner);
    // End:0x31
    if(PlayerPawn != none)
    {
        PlayerPawn.SetFirstPersonDPG(3);
    }
    //return;    
}

private final simulated function DropDown()
{
    PawnOwner.SetMove(2);
    //return;    
}

simulated function UpdateViewRotation(out Rotator out_Rotation, float DeltaTime, out Rotator DeltaRot)
{
    local bool bShouldTriggerHangFreeTurn;
    local Rotator ControllerDeltaRot, LookAtAfterVertigo;
    local int HangFreeTurnConstraintAngleDelta;

    // End:0x3F
    if(bHangFreeVertigoEffect || CurrentFoldedType != 0)
    {
        DeltaRot.Pitch = 0;
        DeltaRot.Yaw = 0;
    }
    // End:0xA3
    if(((DeltaRot.Yaw > 0) || DeltaRot.Yaw < 0) || (DeltaRot.Pitch > 0) || DeltaRot.Pitch < 0)
    {
        AbortLookAtTarget();
    }
    super(TdMove).UpdateViewRotation(out_Rotation, DeltaTime, DeltaRot);
    ControllerDeltaRot = Normalize(out_Rotation) - Normalize(PawnOwner.Rotation);
    ControllerDeltaRot = Normalize(ControllerDeltaRot);
    bIsWithinForwardView = (float(ControllerDeltaRot.Yaw) < StartTurningAngle) && float(ControllerDeltaRot.Yaw) > -StartTurningAngle;
    bIsTurnedRight = ControllerDeltaRot.Yaw >= 0;
    HangFreeTurnConstraintAngleDelta = 750;
    bShouldTriggerHangFreeTurn = ((IsHangingFree()) && (ControllerDeltaRot.Yaw >= (HangFreeMaxLookContraint.Yaw - HangFreeTurnConstraintAngleDelta)) || ControllerDeltaRot.Yaw <= (HangFreeMinLookContraint.Yaw + HangFreeTurnConstraintAngleDelta)) && !bHangFreeVertigoEffect;
    // End:0x3A3
    if(!IsHangingFree())
    {
        // End:0x2DC
        if(PawnOwner.CurrentGrabTurnType == 0)
        {
            // End:0x25C
            if(float(ControllerDeltaRot.Yaw) > StartTurningAngle)
            {
                PlayMoveAnim(2, 'HangTurnRightStart', 1.0, 0.20, 0.20);
                PawnOwner.CurrentGrabTurnType = 1;
                SetTimer(0.20);
            }
            // End:0x2D9
            else
            {
                // End:0x2C0
                if(float(ControllerDeltaRot.Yaw) < -StartTurningAngle)
                {
                    PlayMoveAnim(2, 'HangTurnLeftStart', 1.0, 0.20, 0.20);
                    PawnOwner.CurrentGrabTurnType = 1;
                    SetTimer(0.20);
                }
                // End:0x2D9
                else
                {
                    // End:0x2D9
                    if(MoveActiveTime > 1.0)
                    {
                        ClearTimer();
                    }
                }
            }
        }
        // End:0x3A0
        else
        {
            // End:0x3A0
            if(bIsWithinForwardView)
            {
                // End:0x359
                if(PawnOwner.CurrentGrabTurnType == 3)
                {
                    PlayMoveAnim(2, ((bIsTurnedRight) ? 'HangTurnRightEnd' : 'HangTurnLeftEnd'), 1.0, 0.20, 0.20);
                    PawnOwner.CurrentGrabTurnType = 2;
                    SetTimer(0.60);
                }
                // End:0x3A0
                else
                {
                    // End:0x3A0
                    if(PawnOwner.CurrentGrabTurnType == 1)
                    {
                        PawnOwner.StopCustomAnim(2, 0.20);
                        PawnOwner.CurrentGrabTurnType = 0;
                    }
                }
            }
        }
    }
    // End:0x3B5
    else
    {
        PawnOwner.CurrentGrabTurnType = 0;
    }
    // End:0x413
    if((((MoveActiveTime > StartLookingAtLedgeTime) && MoveActiveTime < StopLookingAtLedgeTime) && CurrentFoldedType == 0) && !bGrabFromVerticalWallrun)
    {
        SetLookAtTargetLocation(PawnOwner.MoveLedgeLocation, 0.30, 0.250);
    }
    // End:0x4AD
    if(bShouldTriggerHangFreeTurn)
    {
        bHangFreeVertigoEffect = true;
        PlayMoveAnim(2, ((bIsTurnedRight) ? 'HangFreeTurnRight' : 'HangFreeTurnLeft'), 1.0, 0.20, 0.20);
        LookAtAfterVertigo = PawnOwner.Rotation;
        LookAtAfterVertigo.Pitch = 0;
        SetLookAtTargetAngle(LookAtAfterVertigo, 0.20, 0.20);
        bConstrainLook = false;
        SetTimer(1.750);
    }
    //return;    
}

simulated function OnTimer()
{
    local Rotator LookAtAngle;

    // End:0x2F
    if(PawnOwner.CurrentGrabTurnType == 2)
    {
        PawnOwner.CurrentGrabTurnType = 0;
    }
    // End:0xA5
    else
    {
        // End:0x5E
        if(PawnOwner.CurrentGrabTurnType == 1)
        {
            PawnOwner.CurrentGrabTurnType = 3;
        }
        // End:0xA5
        else
        {
            AbortLookAtTarget();
            LookAtAngle = PawnOwner.Rotation;
            LookAtAngle.Pitch += 9000;
            SetLookAtTargetAngle(LookAtAngle, 0.20, 0.50);
        }
    }
    //return;    
}

simulated function UpdateViewConstraints()
{
    // End:0x71
    if(bSlopedLedge)
    {
        MinLookConstraint = SlopeMinLookContraint;
        MaxLookConstraint = SlopeMaxLookContraint;
        // End:0x6E
        if(IsHangingFree())
        {
            MinLookConstraint.Pitch = HangFreeMinLookContraint.Pitch;
            MaxLookConstraint.Pitch = HangFreeMaxLookContraint.Pitch;
        }
    }
    // End:0x114
    else
    {
        // End:0xC2
        if(CurrentShimmyMove == 2)
        {
            MinLookConstraint = ((IsHangingFree()) ? ShimmyAroundCornerFreeMinLookContraint : ShimmyAroundCornerMinLookContraint);
            MaxLookConstraint = ((IsHangingFree()) ? ShimmyAroundCornerFreeMaxLookContraint : ShimmyAroundCornerMaxLookContraint);
        }
        // End:0x114
        else
        {
            MinLookConstraint = ((IsHangingFree()) ? HangFreeMinLookContraint : class'TdMove_Grab'.default.MinLookConstraint);
            MaxLookConstraint = ((IsHangingFree()) ? HangFreeMaxLookContraint : class'TdMove_Grab'.default.MaxLookConstraint);
        }
    }
    //return;    
}

simulated function HandleMoveAction(TdPawn.EMovementAction Action)
{
    local bool MoveLeft, MoveRight;
    local Rotator LookAtAngle;

    super(TdMove).HandleMoveAction(Action);
    bClimpUpFoldedActionReceived = Action == 7;
    // End:0x4E
    if((CurrentShimmyMove == 0) && Action == 0)
    {
        AbortShimmy();
        return;
    }
    // End:0x7D
    if(((CurrentShimmyMove == 2) || bHangFreeVertigoEffect) || CurrentFoldedType == 1)
    {
        return;
    }
    MoveLeft = ((Action == 12) || Action == 13) && MoveActiveTime > DisableShimmyTime;
    MoveRight = ((Action == 14) || Action == 15) && MoveActiveTime > DisableShimmyTime;
    // End:0xF6
    if(bSlopedLedge)
    {
        return;
    }
    // End:0x101
    if(bRequestDropDown)
    {
        return;
    }
    // End:0x135
    if((MoveLeft || MoveRight) && !bIsWithinForwardView && !IsHangingFree())
    {
        return;
    }
    // End:0x1D1
    if((Action == 16) && CurrentFoldedType == 0)
    {
        StopLookingAtLedgeTime = 0.0;
        LookAtAngle = PawnOwner.Rotation;
        LookAtAngle.Yaw += ((bIsTurnedRight) ? MaxLookConstraint.Yaw : MinLookConstraint.Yaw);
        AbortLookAtTarget();
        SetLookAtTargetAngle(Normalize(LookAtAngle), 0.20);
    }
    // End:0x240
    if((MoveLeft || MoveRight) && (PawnOwner.WorldInfo.TimeSeconds - LastShimmyTimeSeconds) > 0.50)
    {
        // End:0x235
        if(CanShimmy(Action))
        {
            StartShimmy(Action);
        }
        // End:0x240
        else
        {
            AbortShimmy();
        }
    }
    //return;    
}

simulated event bool CanShimmy(TdPawn.EMovementAction ShimmyAction)
{
    local Vector Start, End, Extent, Direction, X, Y,
	    Z;

    local float DistanceCheck;

    // End:0x1C
    if(PawnOwner.CurrentGrabTurnType != 0)
    {
        return false;
    }
    PawnOwner.GetAxes(PawnOwner.Rotation, X, Y, Z);
    Direction = (((ShimmyAction == 12) || ShimmyAction == 13) ? -Y : Y);
    Direction = Normal(Direction);
    Direction.Z = 0.0;
    DistanceCheck = 35.0;
    Start = PawnOwner.MoveLedgeLocation + (PawnOwner.MoveNormal * (GrabDesiredLedgeOffset.X + RelativeExtent));
    Start.Z -= GrabDesiredLedgeOffset.Z;
    End = Start + (Direction * DistanceCheck);
    Extent = PawnOwner.GetCollisionExtent();
    // End:0x156
    if(!MovementTraceForBlocking(End, Start, Extent))
    {
        return true;
    }
    return false;
    //return ReturnValue;    
}

simulated event bool CanShimmyAroundCorner(TdPawn.EMovementAction ShimmyAction)
{
    local Vector Start, End, Extent, Direction, X, Y,
	    Z;

    local float Distance;
    local bool MoveLeft;

    PawnOwner.GetAxes(PawnOwner.Rotation, X, Y, Z);
    MoveLeft = (ShimmyAction == 12) || ShimmyAction == 13;
    Direction = ((MoveLeft) ? -Y : Y);
    Direction = Normal(Direction);
    Direction.Z = 0.0;
    Distance = ((GrabDesiredLedgeOffset.X * 2.0) + RelativeExtent) + 4.0;
    Start = PawnOwner.MoveLedgeLocation + (PawnOwner.MoveNormal * (GrabDesiredLedgeOffset.X + RelativeExtent));
    Start.Z -= GrabDesiredLedgeOffset.Z;
    End = Start + (Direction * Distance);
    Extent = PawnOwner.GetCollisionExtent();
    // End:0x1F9
    if(!MovementTraceForBlocking(End, Start, Extent))
    {
        Start = End;
        End = Start - (PawnOwner.MoveNormal * Distance);
        // End:0x1F4
        if(!MovementTraceForBlocking(End, Start, Extent))
        {
            TargetLocation = End;
            TargetYaw = PawnOwner.Rotation.Yaw + ((MoveLeft) ? 16384 : -16384);
            return true;
        }
        // End:0x1F6
        else
        {
            return false;
        }
    }
    // End:0x1FB
    else
    {
        return false;
    }
    //return ReturnValue;    
}

simulated event StartShimmy(TdPawn.EMovementAction ShimmyAction)
{
    local bool MoveLeft;

    MoveLeft = (ShimmyAction == 12) || ShimmyAction == 13;
    // End:0x122
    if(CurrentShimmyMove != 0)
    {
        AbortLookAtTarget();
        CurrentShimmyMove = 0;
        ShimmyVelocity = 60.0 * ((MoveLeft) ? -1.0 : 1.0);
        ShimmyTime = 1.0;
        LastShimmyTimeSeconds = PawnOwner.WorldInfo.TimeSeconds;
        PawnOwner.SetPhysics(4);
        PlayMoveAnim(2, ((IsHangingFree()) ? ((MoveLeft) ? 'HangFreeStrafeLeft' : 'HangFreeStrafe') : ((MoveLeft) ? 'HangStrafeLeft' : 'HangStrafeRight')), 1.0, 0.20, 0.0);
        CustomAnimNode = TdAnimNodeSequence(PawnOwner.GetCustomAnimation(2));
    }
    //return;    
}

simulated event StartShimmyAroundCorner(TdPawn.EMovementAction ShimmyAction)
{
    local bool MoveLeft;
    local Vector X, Y, Z;

    MoveLeft = (ShimmyAction == 12) || ShimmyAction == 13;
    PawnOwner.GetAxes(PawnOwner.Rotation, X, Y, Z);
    PawnOwner.UseRootMotion(true);
    SetMoveTimer(0.10, false, 'StartRootRotation');
    // End:0xB8
    if(MoveLeft)
    {
        PawnOwner.SetLocation((TargetLocation - (X * 63.8580)) + (Y * 60.7530));
    }
    // End:0xE6
    else
    {
        PawnOwner.SetLocation((TargetLocation - (X * 63.8580)) - (Y * 60.7530));
    }
    AbortLookAtTarget();
    ResetCameraLook(0.10);
    PawnOwner.StopCustomAnim(2, 0.20);
    // End:0x145
    if(MoveLeft)
    {
        PendingShimmyCornerAnimation = ((IsHangingFree()) ? 'HangFreeCornerOutSideLeft' : 'HangCornerOutSideLeft');
    }
    // End:0x16C
    else
    {
        PendingShimmyCornerAnimation = ((IsHangingFree()) ? 'HangFreeCornerOutSideRight' : 'HangCornerOutSideRight');
    }
    PawnOwner.SetPhysics(4);
    CurrentShimmyMove = 2;
    UpdateViewConstraints();
    //return;    
}

function StartRootRotation()
{
    PawnOwner.UseRootRotation(true);
    PlayMoveAnim(2, PendingShimmyCornerAnimation, 1.0, 0.150, 0.150, true, true);
    //return;    
}

simulated event AbortShimmy(optional bool bForceVelStop)
{
    local float NormalizedPosition;
    local Vector ZeroSpeed;

    bForceVelStop = false;
    // End:0x105
    if(CurrentShimmyMove != 2)
    {
        // End:0x8C
        if(bForceVelStop)
        {
            ZeroSpeed = vect(0.0, 0.0, 0.0);
            PawnOwner.Velocity = ZeroSpeed;
            PawnOwner.Acceleration = ZeroSpeed;
            PawnOwner.StopCustomAnim(2, 0.20);
            CurrentShimmyMove = 3;
            ShimmyTime = 0.0;
        }
        // End:0x105
        else
        {
            NormalizedPosition = CustomAnimNode.GetNormalizedPosition();
            // End:0x105
            if(((NormalizedPosition > 0.10) && NormalizedPosition < 0.250) || NormalizedPosition > 0.80)
            {
                PawnOwner.StopCustomAnim(2, 0.40);
                CurrentShimmyMove = 3;
                ShimmyTime = 0.0;
            }
        }
    }
    //return;    
}

simulated function OnCustomAnimEnd(AnimNodeSequence SeqNode, float PlayedTime, float ExcessTime)
{
    local Rotator NewRotation;

    // End:0x10C
    if(CurrentShimmyMove == 2)
    {
        // End:0x10A
        if((SeqNode.AnimSeqName == PendingShimmyCornerAnimation) && TargetYaw != -1)
        {
            NewRotation = PawnOwner.Rotation;
            NewRotation.Yaw = TargetYaw;
            PawnOwner.SetRotation(NewRotation);
            PawnOwner.SetLocation(TargetLocation);
            TargetYaw = -1;
            ShimmyTime = 0.0;
            RelativeExtent = CalculateRelativeExtent(PawnOwner.CylinderComponent.CollisionRadius);
            RootOffset.X = (default.RootOffset.X + RelativeExtent) + ((IsHangingFree()) ? 0.0 : 1.0);
        }
        // End:0x10C
        else
        {
            return;
        }
    }
    PawnOwner.UseRootMotion(false);
    PawnOwner.UseRootRotation(false);
    CurrentShimmyMove = 3;
    PawnOwner.Velocity = vect(0.0, 0.0, 0.0);
    PawnOwner.SetPhysics(0);
    UpdateViewConstraints();
    // End:0x295
    if(CurrentFoldedType == 1)
    {
        // End:0x1AD
        if(PawnOwner.Weapon != none)
        {
            PawnOwner.SetUnarmed();
        }
        // End:0x1FF
        if(bClimpUpFoldedActionReceived && PawnOwner.Moves[10].CanDoMove())
        {
            bClimpUpFoldedActionReceived = false;
            PawnOwner.SetMove(10);
        }
        // End:0x292
        else
        {
            // End:0x254
            if(IsHangingFree())
            {
                PlayMoveAnim(2, name("HangFreeFoldedEndHangFree"), 1.0, 0.0, 0.20);
                SetTimer(1.50);
            }
            // End:0x282
            else
            {
                PlayMoveAnim(2, name("HangFoldedEndHang"), 1.0, 0.0, 0.20);
            }
            CurrentFoldedType = 2;
            bConstrainLook = false;
        }
    }
    // End:0x2B5
    else
    {
        // End:0x2B5
        if(CurrentFoldedType == 2)
        {
            CurrentFoldedType = 0;
            bConstrainLook = true;
        }
    }
    // End:0x2CE
    if(bHangFreeVertigoEffect)
    {
        bHangFreeVertigoEffect = false;
        bConstrainLook = true;
    }
    // End:0x2FD
    if(PawnOwner.CurrentGrabTurnType == 1)
    {
        PawnOwner.CurrentGrabTurnType = 3;
    }
    // End:0x329
    else
    {
        // End:0x329
        if(PawnOwner.CurrentGrabTurnType == 2)
        {
            PawnOwner.CurrentGrabTurnType = 0;
        }
    }
    // End:0x338
    if(bRequestDropDown)
    {
        DropDown();
    }
    //return;    
}

simulated function StartReplicatedMove()
{
    RootOffset.X += CalculateRelativeExtent(PawnOwner.CylinderComponent.CollisionRadius);
    super(TdMove).StartReplicatedMove();
    SetGrabType(CheckWallLegPlacement());
    UpdateViewConstraints();
    //return;    
}

