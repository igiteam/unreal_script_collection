}

simulated function EnableFoldedHang()
{
    CurrentFoldedType = 1;
    PlayMoveAnim(2, name("HangFoldedStart"), 1.0, 0.20, 0.0);
    bConstrainLook = false;
    //return;    
}

simulated function TdMove_Grab.EGrabFoldedType GetCurrentFoldedType()
{
    return CurrentFoldedType;
