function InitUIPostProcess()
{
    local int I;
    local PostProcessChain PPP_UI;
    local GameUISceneClient SC;

    SC = class'UIRoot'.static.GetSceneClient();
    PPP_UI = SC.Outer.Outer.Outer.DefaultUIScenePostProcess;
    // End:0xD4
    if(PPP_UI != none)
    {
        I = 0;
        J0x5B:
        // End:0xBF [Loop If]
        if(I < PPP_UI.Effects.Length)
        {
            // End:0xB5
            if(TdUIBlurEffect(PPP_UI.Effects[I]) != none)
            {
                UIBlurPP_UI = TdUIBlurEffect(PPP_UI.Effects[I]);
            }
            ++ I;
            // [Loop Continue]
            goto J0x5B;
        }
        UIBlurPP_UI.BlurAmount = 0.0;
    }
    //return;    
}

function ToggleUIPostProcess()
{
    // End:0x20
    if(!bEnableUIPostProcessing)
    {
        // End:0x20
        if(UIBlurPP_UI == none)
        {
            InitUIPostProcess();
        }
    }
    bEnableUIPostProcessing = !bEnableUIPostProcessing;
    Outer.PlayerOwner.WorldInfo.bEnableUIPostProcessing = bEnableUIPostProcessing;
    //return;    
}

function BlurInUI(float FadeInTime)
{
    // End:0x15
    if(UIBlurPP_UI == none)
    {
        InitUIPostProcess();
    }
    // End:0x56
    if(FadeInTime > 0.0)
    {
        UIBlurInSpeed = 1.0 / FadeInTime;
        bEnableUIPostProcessing = true;
        UIBlurPP_UI.BlurAmount = 1.0;
    }
    // End:0x7E
    else
    {
        UIBlurPP_UI.BlurAmount = 0.0;
        UIBlurInSpeed = 0.0;
        bEnableUIPostProcessing = false;
    }
    Outer.PlayerOwner.WorldInfo.bEnableUIPostProcessing = bEnableUIPostProcessing;
    UIBlurOutSpeed = 0.0;
    //return;    
}

function BlurOutUI(float FadeOutTime)
{
    // End:0x15
    if(UIBlurPP_UI == none)
    {
        InitUIPostProcess();
    }
    // End:0x56
    if(FadeOutTime > 0.0)
    {
        UIBlurPP_UI.BlurAmount = 0.0;
        UIBlurOutSpeed = 1.0 / FadeOutTime;
        bEnableUIPostProcessing = true;
    }
    // End:0x7E
    else
    {
        UIBlurPP_UI.BlurAmount = 1.0;
        UIBlurOutSpeed = 0.0;
        bEnableUIPostProcessing = true;
    }
    Outer.PlayerOwner.WorldInfo.bEnableUIPostProcessing = bEnableUIPostProcessing;
    UIBlurInSpeed = 0.0;
    //return;    
}

function SetUIBlur(float T)
{
    // End:0x15
    if(UIBlurPP_UI == none)
    {
        InitUIPostProcess();
    }
    UIBlurPP_UI.BlurAmount = T;
    //return;    
}

function SetUIBlurEnabled(bool bEnabled)
{
    Outer.PlayerOwner.WorldInfo.bEnableUIPostProcessing = bEnabled;
    //return;    
}

final function Update(float DeltaTime, float RenderDelta)
{
    local Vector PlayerLocation;
    local PostProcessSettings PPS;

    // End:0x1A
    if(DOFAndBloomPP != none)
    {
        UpdateDOF(DeltaTime);
    }
    // End:0x3F
    if(bEnableUIPostProcessing && UIBlurPP_UI != none)
    {
        UpdateBlur_UI(DeltaTime);
    }
    PPS = Outer.WorldInfo.GetModifiedPostProcessSettings();
    // End:0xF6
    if(PPS.HazeEnabled)
    {
        PlayerLocation = LocalPlayer(Outer.PlayerOwner.Player).Actor.PlayerCamera.ViewTarget.POV.Location;
        // End:0xF6
        if(SunHazePP != none)
        {
            SunHazePP.SunVector = SunLocation - PlayerLocation;
        }
    }
    // End:0x117
    if(Outer.PlayerOwner.Pawn == none)
    {
        return;
    }
    ThePlayerPawn = TdPlayerPawn(Outer.PlayerOwner.Pawn);
    TheHUD = TdHUD(TdPlayerController(ThePlayerPawn.Controller).myHUD);
    CamLoc = ThePlayerPawn.GetPawnViewLocation();
    CamRot = ThePlayerPawn.GetPawnViewRotation();
    // End:0x1B0
    if(bEnableStreakEffect)
    {
        UpdateStreakEffect(DeltaTime);
    }
    // End:0x1C8
    if(bEnableUncontrolledFallingEffect)
    {
        UpdateUncontrolledFalling(DeltaTime);
    }
    ReactionTimeEffect.NormalizedTargetingDistance = Outer.TargetingHitDistance / Outer.TargetingMaxDistance;
    //return;    
}

function UpdateUncontrolledFalling(float DeltaTime)
{
    local Vector ParticlePos, PawnVelocity;

    // End:0x22A
    if((Outer.PlayerOwner.Pawn != none) && IsPlayerInUncontrolledSpeed(PawnVelocity))
    {
        // End:0x6E
        if(UncontrolledFallingEffect.bShowInGame)
        {
            UncontrolledFallingEffectFader = FClamp(UncontrolledFallingEffectFader + (DeltaTime * UncontrolledFallingEffectSpeed), 0.0, UncontrolledFallingEffectClamp);
        }
        // End:0x8B
        else
        {
            UncontrolledFallingEffectFader = 0.0;
            UncontrolledFallingEffect.bShowInGame = true;
        }
        UncontrolledFallingMaterialInstance.SetScalarParameterValue('FXFScreen_UncontrolledFalling', UncontrolledFallingEffectFader);
        ParticlePos = Outer.PlayerOwner.Pawn.Location + UncontrolledFallingEmitterOffset;
        // End:0x1C8
        if(UncontrolledFallingEffectEmitter == none)
        {
            UncontrolledFallingEffectEmitter = Outer.Spawn(class'TdEmitter',,, ParticlePos, rotator(PawnVelocity));
            UncontrolledFallingEffectEmitter.SetBase(Outer.PlayerOwner.Pawn);
            UncontrolledFallingEffectEmitter.SetOwner(Outer.PlayerOwner.Pawn);
            UncontrolledFallingEffectEmitter.SetTemplate(UncontrolledFallingParticles, false);
            UncontrolledFallingEffectEmitter.LifeSpan = 300.0;
            UncontrolledFallingEffectEmitter.ParticleSystemComponent.SetDepthPriorityGroup(3);
            UncontrolledFallingEffectEmitter.ParticleSystemComponent.ActivateSystem();
        }
        // End:0x227
        if(UncontrolledFallingEffectEmitter != none)
        {
            UncontrolledFallingEffectEmitter.SetLocation(ParticlePos);
            UncontrolledFallingEffectEmitter.SetRotation(rotator(PawnVelocity));
            UncontrolledFallingEffectEmitter.SetFloatParameter('FXFScreen_UncontrolledFalling_FXAlpha', FClamp(UncontrolledFallingEffectFader, 0.0, 1.0));
        }
    }
    // End:0x28A
    else
    {
        // End:0x28A
        if(UncontrolledFallingEffect.bShowInGame)
        {
            UncontrolledFallingMaterialInstance.SetScalarParameterValue('FXFScreen_UncontrolledFalling', 0.0);
            UncontrolledFallingEffect.bShowInGame = false;
            // End:0x283
            if(!UncontrolledFallingEffectEmitter.Destroy())
            {
            }
            UncontrolledFallingEffectEmitter = none;
        }
    }
    //return;    
}

function bool IsPlayerInUncontrolledSpeed(out Vector FallingVelocity)
{
    // End:0x16
    if(bForceUncontrolledFall)
    {
        FallingVelocity = ForcedUncontrolledFallVelocity;
        return true;
    }
    FallingVelocity = Outer.PlayerOwner.Pawn.Velocity;
    return Outer.PlayerOwner.Pawn.Velocity.Z < -UncontrolledFallingSpeedLimit;
    //return ReturnValue;    
}

function ResetParticles()
{
    HitEmitterPointer = 0;
    J0x07:
    // End:0x199 [Loop If]
    if(HitEmitterPointer < 4)
    {
        // End:0xE1
        if(DirectionalParticleSystemSlots[HitEmitterPointer].EffectEmitter != none)
        {
            // End:0xAB
            if(DirectionalParticleSystemSlots[HitEmitterPointer].EffectEmitter.ParticleSystemComponent != none)
            {
                DirectionalParticleSystemSlots[HitEmitterPointer].EffectEmitter.ParticleSystemComponent.KillParticlesForced();
                DirectionalParticleSystemSlots[HitEmitterPointer].EffectEmitter.ParticleSystemComponent.DeactivateSystem();
            }
            DirectionalParticleSystemSlots[HitEmitterPointer].EffectEmitter.Destroy();
            DirectionalParticleSystemSlots[HitEmitterPointer].EffectEmitter = none;
        }
        DirectionalParticleSystemSlots[HitEmitterPointer].EffectEmitter = Outer.Spawn(class'TdEmitter', Outer.PlayerOwner);
        DirectionalParticleSystemSlots[HitEmitterPointer].EffectEmitter.bDestroyOnSystemFinish = false;
        DirectionalParticleSystemSlots[HitEmitterPointer].EffectEmitter.LifeSpan = 0.0;
        DirectionalParticleSystemSlots[HitEmitterPointer].EffectEmitter.KillProjectile();
        ++ HitEmitterPointer;
        // [Loop Continue]
        goto J0x07;
    }
    HitEmitterPointer = 0;
    //return;    
}

function ResetPPEffects()
{
    local int EffectIndex;

    EffectIndex = 0;
    J0x07:
    // End:0x3B [Loop If]
    if(EffectIndex < HudImpactEffects.Length)
    {
        HudImpactEffects[EffectIndex].ResetPP();
        ++ EffectIndex;
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

function UpdateStreakEffect(float Delta)
{
    local Vector SpawnPos, PawnVelocity;
    local float DirectionalMultiplier;
    local bool bHasStreaks;

    PawnVelocity = vector(CamRot);
    bHasStreaks = TdPawn(Outer.PlayerOwner.Pawn).GetStreakValue(PawnVelocity);
    SpawnPos = (CamLoc + (StreakDistanceInCameraDirection * vector(CamRot))) + (StreakDistanceInMovementDirection * Normal(PawnVelocity));
    DirectionalMultiplier = ((bHasStreaks) ? FClamp(vector(CamRot) Dot Normal(PawnVelocity), 0.0, 1.0) : 0.0);
    // End:0x1B7
    if(((StreakEffectEmitter == none) && bHasStreaks) && DirectionalMultiplier > 0.50)
    {
        StreakEffectEmitter = Outer.Spawn(class'TdEmitter',,, SpawnPos, rotator(PawnVelocity));
        StreakEffectEmitter.SetBase(Outer.PlayerOwner.Pawn);
        StreakEffectEmitter.SetOwner(Outer.PlayerOwner.Pawn);
        StreakEffectEmitter.SetTemplate(StreakEffectParticles, false);
        StreakEffectEmitter.LifeSpan = 300.0;
        StreakEffectEmitter.ParticleSystemComponent.SetDepthPriorityGroup(3);
        StreakEffectEmitter.ParticleSystemComponent.ActivateSystem();
        StreakEffectDirection = Normal(PawnVelocity);
    }
    // End:0x2B8
    if(StreakEffectEmitter != none)
    {
        StreakEffectStrength += ((DirectionalMultiplier - StreakEffectStrength) * FMin(Delta / StreakEffectFadeTime, 1.0));
        StreakEffectDirection = Normal(VLerp(Normal(PawnVelocity), StreakEffectDirection, 0.90));
        // End:0x285
        if(bHasStreaks || StreakEffectStrength > 0.10)
        {
            StreakEffectEmitter.SetLocation(SpawnPos);
            StreakEffectEmitter.SetRotation(rotator(StreakEffectDirection));
            StreakEffectEmitter.ParticleSystemComponent.SetFloatParameter('FXFScreen_SprintActivated', StreakEffectStrength);
            StreakEffectEmitter.SetHidden(false);
        }
        // End:0x2B8
        else
        {
            StreakEffectEmitter.ParticleSystemComponent.DeactivateSystem();
            // End:0x2B1
            if(!StreakEffectEmitter.Destroy())
            {
            }
            StreakEffectEmitter = none;
        }
    }
    //return;    
}

function ResetHealthEffect()
{
    // End:0x9F
    if(HealthEffect != none)
    {
        HealthEffectMaterialInstance.SetScalarParameterValue('Health', 1.0);
        HealthEffect.bShowInGame = false;
        HealthEffectMaterialInstance.SetScalarParameterValue(PPHealthSaturationSettings.ParameterName, 0.0);
        PPHSSFadeInTimer = 0.0;
        PPHSSFadeInStart = 0.0;
        PPHSSFadeOutTimer = 0.0;
        PPHSSPeakDurationTimer = 0.0;
        PPHSSTargetStrength = 0.0;
    }
    //return;    
}

function ResetScopeEffect()
{
    local MaterialEffect LocalScope;
    local PostProcessChain PPP;

    PPP = LocalPlayer(Outer.PlayerOwner.Player).PlayerPostProcess;
    LocalScope = MaterialEffect(PPP.FindPostProcessEffect('ScopeEffect'));
    // End:0x6F
    if(LocalScope != none)
    {
        LocalScope.bShowInGame = false;
    }
    Outer.ToggleZoomState(false);
    //return;    
}

function DisplayDeath()
{
    // End:0x50
    if(bEnableDeathEffect)
    {
        // End:0x50
        if(DeathEffect != none)
        {
            DeathEffectMaterialInstance.SetScalarParameterValue('DeathAmount', 0.250);
            DeathEffect.bShowInGame = true;
            bFadeInDeathEffect = true;
        }
    }
    //return;    
}

function UnDisplayDeath()
{
    // End:0x2E
    if(bEnableDeathEffect)
    {
        // End:0x2E
        if(DeathEffect != none)
        {
            DeathEffect.bShowInGame = false;
            bFadeInDeathEffect = false;
        }
    }
    ResetHealthEffect();
    //return;    
}

function UpdateDOF(float DeltaTime)
{
    local float HitDistance, TargetAmount;
    local TdPawn myPawn;

    // End:0x24
    if((DOFAndBloomPP == none) || !DOFAndBloomPP.bAutofocus)
    {
        return;
    }
    // End:0x39C
    if(Outer.PlayerOwner != none)
    {
        DOFAndBloomPP.MaxFarBlurAmount = FMax(0.0, DOFAndBloomPP.MaxFarBlurAmount);
        myPawn = TdPawn(Outer.PlayerOwner.Pawn);
        // End:0x34E
        if(!Outer.bAnimatedFocusDistance)
        {
            // End:0x100
            if(myPawn != none)
            {
                // End:0x100
                if(myPawn.VelocityMagnitude > float(300))
                {
                    // End:0xFE
                    if(DOFAndBloomPP.MaxFarBlurAmount > 0.0)
                    {
                        DOFAndBloomPP.MaxFarBlurAmount -= (DOFAndBloomPP.AutofocusSpeedDown * DeltaTime);
                    }
                    return;
                }
            }
            // End:0x13B
            if(Outer.TargetingHitDistance < DOFAndBloomPP.AutofocusMaxDistance)
            {
                HitDistance = Outer.TargetingHitDistance;
            }
            // End:0x173
            else
            {
                // End:0x159
                if(DOFAndBloomPP.MaxFarBlurAmount <= 0.0)
                {
                    return;
                }
                // End:0x173
                else
                {
                    HitDistance = DOFAndBloomPP.AutofocusMaxDistance + float(1);
                }
            }
            // End:0x1B0
            if(HitDistance < AverageFocusDistance)
            {
                AverageFocusDistance -= (((AverageFocusDistance - HitDistance) * DOFAndBloomPP.AutofocusSpeedDown) * DeltaTime);
            }
            // End:0x1EA
            else
            {
                // End:0x1EA
                if(HitDistance > AverageFocusDistance)
                {
                    AverageFocusDistance += (((HitDistance - AverageFocusDistance) * DOFAndBloomPP.AutofocusSpeedUp) * DeltaTime);
                }
            }
            TargetAmount = (DOFAndBloomPP.AutofocusMaxDistance - (float(2) * FMax(AverageFocusDistance - (DOFAndBloomPP.AutofocusMaxDistance * 0.50), 0.0))) / DOFAndBloomPP.AutofocusMaxDistance;
            // End:0x30B
            if(HitDistance < DOFAndBloomPP.AutofocusMaxDistance)
            {
                // End:0x2B0
                if(DOFAndBloomPP.MaxFarBlurAmount < TargetAmount)
                {
                    DOFAndBloomPP.MaxFarBlurAmount += FMin(DOFAndBloomPP.AutofocusSpeedUp * DeltaTime, TargetAmount - DOFAndBloomPP.MaxFarBlurAmount);
                }
                // End:0x308
                else
                {
                    // End:0x308
                    if(DOFAndBloomPP.MaxFarBlurAmount > TargetAmount)
                    {
                        DOFAndBloomPP.MaxFarBlurAmount -= FMin(DOFAndBloomPP.AutofocusSpeedDown * DeltaTime, DOFAndBloomPP.MaxFarBlurAmount - TargetAmount);
                    }
                }
            }
            // End:0x34B
            else
            {
                // End:0x34B
                if(DOFAndBloomPP.MaxFarBlurAmount > 0.0)
                {
                    DOFAndBloomPP.MaxFarBlurAmount -= (DOFAndBloomPP.AutofocusSpeedDown * DeltaTime);
                }
            }
        }
        // End:0x363
        else
        {
            DOFAndBloomPP.MaxFarBlurAmount = 1.0;
        }
        DOFAndBloomPP.FocusDistance = ((Outer.bAnimatedFocusDistance) ? Outer.TargetingHitDistance : AverageFocusDistance);
    }
    //return;    
}

function UpdateBlur_UI(float DeltaTime)
{
    local float Blur;

    // End:0x6F
    if(UIBlurDemo)
    {
        UIBlurTimer += DeltaTime;
        Blur = 0.50 * (1.0 + Sin(2.0 * UIBlurTimer));
        class'TdDebugOutput'.static.AddGraphValue('Blur UI', Blur);
        UIBlurPP_UI.BlurAmount = Blur;
    }
    // End:0x147
    else
    {
        // End:0xE2
        if(UIBlurInSpeed > 0.0)
        {
            UIBlurPP_UI.BlurAmount -= (UIBlurInSpeed * DeltaTime);
            // End:0xDF
            if(UIBlurPP_UI.BlurAmount <= 0.0)
            {
                UIBlurPP_UI.BlurAmount = 0.0;
                UIBlurInSpeed = 0.0;
                UIBlurOutSpeed = 0.0;
            }
        }
        // End:0x147
        else
        {
            // End:0x147
            if(UIBlurOutSpeed > 0.0)
            {
                UIBlurPP_UI.BlurAmount += (UIBlurOutSpeed * DeltaTime);
                // End:0x147
                if(UIBlurPP_UI.BlurAmount >= 1.0)
                {
                    UIBlurPP_UI.BlurAmount = 1.0;
                    UIBlurOutSpeed = 0.0;
                }
            }
        }
    }
    UIBlurPP_UI.bShowInGame = true;
    UIBlurPP_UI.bShowInEditor = true;
    //return;    
}

function ActivateZoomInDOF()
{
    // End:0x0D
    if(DOFAndBloomPP == none)
    {
        return;
    }
    SavedMaxFarBlurAmount = DOFAndBloomPP.MaxFarBlurAmount;
    SavedMaxNearBlurAmount = DOFAndBloomPP.MaxNearBlurAmount;
    SavedAutofocusSpeedUp = DOFAndBloomPP.AutofocusSpeedUp;
    SavedAutofocusSpeedDown = DOFAndBloomPP.AutofocusSpeedDown;
    SavedAutofocusMaxDistance = DOFAndBloomPP.AutofocusMaxDistance;
    DOFAndBloomPP.MaxFarBlurAmount = ZoomMaxFarBlurAmount;
    DOFAndBloomPP.MaxNearBlurAmount = ZoomMaxNearBlurAmount;
    DOFAndBloomPP.AutofocusSpeedUp = ZoomAutofocusSpeedUp;
    DOFAndBloomPP.AutofocusSpeedDown = ZoomAutofocusSpeedDown;
    DOFAndBloomPP.AutofocusMaxDistance = ZoomAutofocusMaxDistance;
    DOFAndBloomPP.FocusDistance = 1000.0;
    //return;    
}

function ActivateSaturationEffect()
{
    SaturationEffect.SpecialActivatePP();
    //return;    
}

function DeActivateSaturationEffect()
{
    SaturationEffect.SpecialDeActivatePP();
    //return;    
}

function DeActivateZoomInDOF()
{
    local PostProcessSettings PPS;

    // End:0x0D
    if(DOFAndBloomPP == none)
    {
        return;
    }
    PPS = Outer.WorldInfo.GetModifiedPostProcessSettings();
    // End:0xF8
    if(true)
    {
        DOFAndBloomPP.MaxNearBlurAmount = PPS.DOF_MaxNearBlurAmount;
        DOFAndBloomPP.MaxFarBlurAmount = PPS.DOF_MaxFarBlurAmount;
        DOFAndBloomPP.AutofocusSpeedUp = PPS.DOF_AutofocusSpeed;
        DOFAndBloomPP.AutofocusSpeedDown = PPS.DOF_AutofocusSpeed;
        DOFAndBloomPP.AutofocusMaxDistance = PPS.DOF_AutofocusMaxDistance;
        DOFAndBloomPP.FocusDistance = PPS.DOF_FocusDistance;
    }
    // End:0x176
    else
    {
        DOFAndBloomPP.MaxNearBlurAmount = SavedMaxNearBlurAmount;
        DOFAndBloomPP.MaxFarBlurAmount = SavedMaxFarBlurAmount;
        DOFAndBloomPP.AutofocusSpeedUp = SavedAutofocusSpeedUp;
        DOFAndBloomPP.AutofocusSpeedDown = SavedAutofocusSpeedDown;
        DOFAndBloomPP.AutofocusMaxDistance = SavedAutofocusMaxDistance;
        DOFAndBloomPP.FocusDistance = 1000.0;
    }
    //return;    
}

function InitSavedDOFValues()
{
    local PostProcessSettings PPS;

    // End:0x0D
    if(DOFAndBloomPP == none)
    {
        return;
    }
    PPS = Outer.WorldInfo.GetModifiedPostProcessSettings();
    // End:0xF8
    if(true)
    {
        DOFAndBloomPP.MaxNearBlurAmount = PPS.DOF_MaxNearBlurAmount;
        DOFAndBloomPP.MaxFarBlurAmount = PPS.DOF_MaxFarBlurAmount;
        DOFAndBloomPP.AutofocusSpeedUp = PPS.DOF_AutofocusSpeed;
        DOFAndBloomPP.AutofocusSpeedDown = PPS.DOF_AutofocusSpeed;
        DOFAndBloomPP.AutofocusMaxDistance = PPS.DOF_AutofocusMaxDistance;
        DOFAndBloomPP.FocusDistance = PPS.DOF_FocusDistance;
    }
    // End:0x180
    else
    {
        SavedMaxFarBlurAmount = DOFAndBloomPP.MaxFarBlurAmount;
        SavedMaxNearBlurAmount = DOFAndBloomPP.MaxNearBlurAmount;
        SavedAutofocusSpeedUp = DOFAndBloomPP.AutofocusSpeedUp;
        SavedAutofocusSpeedDown = DOFAndBloomPP.AutofocusSpeedDown;
        SavedAutofocusMaxDistance = DOFAndBloomPP.AutofocusMaxDistance;
        DOFAndBloomPP.FocusDistance = DOFAndBloomPP.FocusDistance;
    }
    //return;    
}

