function ActivateForcedMotionBlur(Vector Direction, float Amount)
{
    MotionBlur.bShowInGame = true;
    MotionBlur.TdMotionBlurForce = true;
    MotionBlur.TdMotionBlurForcedDirection = Direction;
    MotionBlur.TdMotionBlurForcedAmount = Amount;
    //return;    
}

function DeActivateForcedMotionBlur()
{
    MotionBlur.TdMotionBlurForce = false;
    //return;    
}

function ResetMotionBlurEffects()
{
    MotionBlur.TdMotionBlurForce = false;
    //return;    
}

function ActivateForcedUncontrolledFall(Vector Direction)
{
    bForceUncontrolledFall = true;
    ForcedUncontrolledFallVelocity = Direction;
    //return;    
}

function DeActivateForcedUncontrolledFall()
{
    bForceUncontrolledFall = false;
    //return;    
}

function TogglePostProcessEffects(bool bEnable)
{
    // End:0x22
    if(MotionBlur != none)
    {
        MotionBlur.bShowInGame = bEnable;
    }
    // End:0x44
    if(DOFAndBloomPP != none)
    {
        DOFAndBloomPP.bShowInGame = bEnable;
    }
    bEnableHitEffect = bEnable;
    bEnableHealthEffect = bEnable && HealthEffect != none;
    bEnableDeathEffect = bEnable && DeathEffect != none;
    bEnableStreakEffect = bEnable;
    // End:0x245
    if(!bEnable)
    {
        // End:0xD3
        if(BulletHitEffect.Effect != none)
        {
            BulletHitEffect.Effect.bShowInGame = bEnable;
        }
        // End:0x109
        if(TaserHitEffect.Effect != none)
        {
            TaserHitEffect.Effect.bShowInGame = bEnable;
        }
        // End:0x13F
        if(MeleeHitEffect.Effect != none)
        {
            MeleeHitEffect.Effect.bShowInGame = bEnable;
        }
        // End:0x175
        if(FallDamageEffect.Effect != none)
        {
            FallDamageEffect.Effect.bShowInGame = bEnable;
        }
        // End:0x1AB
        if(ExplosionDamageEffect.Effect != none)
        {
            ExplosionDamageEffect.Effect.bShowInGame = bEnable;
        }
        // End:0x1E1
        if(FlashbangEffect.Effect != none)
        {
            FlashbangEffect.Effect.bShowInGame = bEnable;
        }
        // End:0x217
        if(ReactionTimeEffect.Effect != none)
        {
            ReactionTimeEffect.Effect.bShowInGame = bEnable;
        }
        HealthEffect.bShowInGame = bEnable;
        DeathEffect.bShowInGame = bEnable;
    }
    //return;    
}

