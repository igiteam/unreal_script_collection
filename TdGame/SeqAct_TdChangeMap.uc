class SeqAct_TdChangeMap extends SequenceAction
    hidecategories(Object);

var() string LevelName;
var() string CheckpointName;

event Activated()
{
    local DataStoreClient DataStoreManager;
    local UIDataStore_TdGameData GameData;

    DataStoreManager = class'UIInteraction'.static.GetDataStoreClient();
    // End:0x73
    if(DataStoreManager != none)
    {
        GameData = UIDataStore_TdGameData(DataStoreManager.FindDataStore('TdGameData'));
        // End:0x73
        if(GameData != none)
        {
            GameData.StartGame(LevelName, CheckpointName);
        }
    }
    //return;    
}

defaultproperties
{
    ObjName="Change Map"
    ObjCategory="Takedown"
}