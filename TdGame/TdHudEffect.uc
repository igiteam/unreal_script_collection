    }
};

var() config BlurSettings Blur;
var() config PPSettings PPStrength;
var ParticleSystem Particles;
var config Vector ParticleOrigin;
var transient bool bIsActive;
var() bool bEnablePPEffect;
var() config bool bDebugEffect;
var transient float PPFadeInTimer;
var transient float PPFadeInStart;
var transient float PPPeakDurationTimer;
var transient float PPFadeOutTimer;
var transient float PPTargetStrength;
var transient float PPCurrentStrength;
var MaterialEffect Effect;
var transient MaterialInstanceConstant MaterialInstance;

function InitializePP(PostProcessEffect PPE)
{
    Effect = MaterialEffect(PPE);
    // End:0x78
    if(Effect != none)
    {
        Effect.bShowInGame = false;
        MaterialInstance = new (none) class'MaterialInstanceConstant';
        MaterialInstance.SetParent(Effect.Material);
        Effect.Material = MaterialInstance;
    }
    // End:0x80
    else
    {
        bEnablePPEffect = false;
    }
    bIsActive = false;
    //return;    
}

function ResetPP()
{
    PPFadeInTimer = default.PPFadeInTimer;
    PPFadeOutTimer = default.PPFadeOutTimer;
    PPPeakDurationTimer = default.PPPeakDurationTimer;
    PPFadeInStart = default.PPFadeInStart;
    PPTargetStrength = default.PPTargetStrength;
    PPCurrentStrength = default.PPCurrentStrength;
    bIsActive = false;
    MaterialInstance.SetScalarParameterValue(PPStrength.ParameterName, 0.0);
    //return;    
}

defaultproperties
{
    Blur=(FadeInDuration=0.20,Duration=0.70,FadeOutDuration=2.0,FocusDistance=-500.0,MaxFarBlurAmount=1.0)
    PPStrength=(ParameterName=Strength,FadeInDuration=0.10,Duration=0.50,FadeOutDuration=1.50)
    ParticleOrigin=(X=40.0,Y=40.0,Z=23.0)
    bEnablePPEffect=true
