        FocusDistance=0.0
        MaxFarBlurAmount=0.0
    }
};

struct native PPSettings
{
    var name ParameterName;
    var float FadeInDuration;
    var float Duration;
    var float FadeOutDuration;

    structdefaultproperties
    {
        ParameterName=None
        FadeInDuration=0.0
        Duration=0.0
