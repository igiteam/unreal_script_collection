class TdMove_SwingJump extends TdPhysicsMove
    config(PawnMovement);

var TdSwingVolume TargetVolume;
var config float GravityModifier;
var config float GravityModifierTimer;
var config Vector TargetVolumeOffset;

function bool CanDoMove()
{
    return super(TdMove).CanDoMove();
    //return ReturnValue;    
}

simulated function StartMove()
{
    local Vector PawnToSwing;
    local float DistanceToTarget;

    PawnOwner.SetWeaponAnimState(1);
    PawnOwner.SetAnimationMovementState(60);
    PawnOwner.SetAnimationMovementState(0, 0.30);
    super.StartMove();
    // End:0x1B0
    if(TargetVolume != none)
    {
        PawnOwner.GravityModifier = GravityModifier;
        PawnOwner.GravityModifierTimer = GravityModifierTimer;
        PawnOwner.SetPhysics(4);
        PawnToSwing = TargetVolume.Location - PawnOwner.Location;
        DistanceToTarget = VSize2D(TargetVolume.Location - PawnOwner.Location);
        SetPreciseLocation((TargetVolume.Location + (Normal(PawnToSwing) * TargetVolumeOffset.X)) + (vect(0.0, 0.0, 1.0) * TargetVolumeOffset.Z), 3, DistanceToTarget / 0.90);
        PlayMoveAnim(2, name("SwingOff"), 1.0, 0.20, 0.20, false);
        SetTimer(0.90);
        // End:0x1B0
        if(PawnOwner.Weapon != none)
        {
            PawnOwner.SetUnarmed();
            MovementGroup = 2;
            AimMode = 3;
        }
    }
    //return;    
}

simulated function StopMove()
{
    super.StopMove();
    //return;    
}

simulated function OnTimer()
{
    PawnOwner.SetPhysics(2);
    //return;    
}

defaultproperties
{
    GravityModifier=0.730
    GravityModifierTimer=0.750
    TargetVolumeOffset=(X=-120.0,Y=0.0,Z=-20.0)
    PawnPhysics=PHYS_Falling
    ControllerState=PlayerWalking
    bCheckForGrab=true
    bCheckForVaultOver=true
    bCheckForWallClimb=true
    bCheckExitToFalling=true
    bTriggersCompliment=true
    bConstrainLook=true
    AiAimPenalties=(Easy=0.20,Medium=0.30,Hard=0.50)
    AiAimOneShotPenalties=(Easy=200.0,Medium=200.0,Hard=200.0)
    MinLookConstraint=(Pitch=-11000,Yaw=-32768,Roll=-32768)
    MaxLookConstraint=(Pitch=16384,Yaw=32768,Roll=32768)
}