function Initialize(TdAIController C)
{
    myController = C;
    SetAnimationController();
    ForcedWalkingStack = new (self) class'TdBubbleStack';
    ForcedWalkingStack.Initialize(false, 10, myController, 'ForceWalk');
    OldYaw = Rotation.Yaw;
    StartingLocation = Location;
    StartingRotation = Rotation;
    // End:0xA9
    if(RVEffect == none)
    {
        RVEffect = Spawn(class'TdAI_RunnerVisionEffect');
        RVEffect.SetHidden(true);
    }
    //return;    
}

simulated event PlayFootStepSound(int FootDown)
