protected function CheckFire()
{
    local bool CanFire;

    // End:0x0B
    if(bBurstWait)
    {
        return;
    }
    // End:0x52
    if(bNewBurst)
    {
        bOkToBurst = myController.AIManager.AskToBurst(self, float(CurrentBurstLength) * BurstDelayMax);
        bNewBurst = false;
        return;
    }
    CanFire = (((bOkToBurst && !bForceWaitForDamage) && !IsInMeleeMove()) && bIsWalkingOrStanding) && CanFireWeapon();
    // End:0xB6
    if(CanFire && !IsPressingWeaponTrigger)
    {
        StartFiringWeapon();
    }
    // End:0xD6
    else
    {
        // End:0xD6
        if(!CanFire && IsPressingWeaponTrigger)
        {
            StopFiringWeapon();
        }
    }
    //return;    
}

function StartFiringWeapon()
{
    StartFire(0);
    IsPressingWeaponTrigger = true;
    //return;    
}

function StopFiringWeapon()
{
    StopFiring();
    myController.AIManager.ReportBurstFinished(self);
    IsPressingWeaponTrigger = false;
    ShotCount = 0;
    Weapon.ForceEndFire();
    MyWeapon.AbortBurst();
    ClearTimer('StartNewBurst');
    //return;    
}

function bool IsOkToFireBullet()
{
    // End:0x10
    if(CurrentBurstMax == 1)
    {
        return true;
    }
    // End:0x2F
    else
    {
        return myController.AIManager.OkToFireBullet();
    }
    //return ReturnValue;    
}

function NotifyOkToBurst()
{
    bOkToBurst = true;
    //return;    
}

function PauseFiring()
{
    local float RefireDelay;

    StopFiringWeapon();
    RefireDelay = FRandRange(BurstDelayMin, BurstDelayMax);
    bBurstWait = true;
    SetTimer(RefireDelay, false, 'StartNewBurst');
    //return;    
}

function StartNewBurst()
{
    CurrentBurstLength = int(RandRange(float(CurrentBurstMin), float(CurrentBurstMax)));
    bBurstWait = false;
    bNewBurst = true;
    ClearTimer('StartNewBurst');
    ShotCount = 0;
    //return;    
}

simulated function WeaponFired(bool bViaReplication, optional Vector HitLocation)
{
    ++ ShotCount;
    // End:0x21
    if(ShotCount >= CurrentBurstLength)
    {
        BurstOver();
    }
    //return;    
}

function BurstOver()
{
    SetTimer(0.030, false, 'PauseFiring');
    //return;    
}

function InterruptBurst()
{
    StopFiringWeapon();
    BurstOver();
    //return;    
}

simulated function WeaponStoppedFiring(bool bViaReplication)
{
    BurstOver();
    //return;    
}

