simulated function CacheAnimNodes()
{
    local AnimNode Node;

    super.CacheAnimNodes();
    // End:0x125
    foreach Mesh3p.AllAnimNodes(class'AnimNode', Node)
    {
        // End:0x47
        if(Node.NodeName == 'None')
        {
            continue;            
            // End:0x124
            continue;
        }
        // End:0xB7
        if(Node.NodeName == 'HitReaction')
        {
            HitReactionNode = TdAnimNodeAimOffset(Node);
            HitReactionNode.Aim.X = 0.0;
            HitReactionNode.Aim.Y = 0.0;
            // End:0x124
            continue;
        }
        // End:0x124
        if(Node.NodeName == 'HitReaction2')
        {
            HitReactionNode2 = TdAnimNodeAimOffset(Node);
            HitReactionNode2.Aim.X = 0.0;
            HitReactionNode2.Aim.Y = 0.0;
        }        
    }    
    //return;    
}

function InitAnimationSettings()
{
    // End:0x0D
    if(Mesh == none)
    {
        return;
    }
    CustomFullBodyAnimNode = TdAnimNodeSlot(Mesh.FindAnimNode('Custom_FullBody'));
    LeftHandLocalIKController = SkelControlLimb(Mesh.FindSkelControl('LeftHandLocalIKController'));
    myAnimationController = Spawn(class'TdAIAnimationController', self,,,,, true);
    myAnimationController.Init(TdSkeletalMeshComponent(Mesh));
    SetAnimationController();
    //return;    
}

function InitSyncNodes()
{
    local AnimNodeSynch Node;

    // End:0x17
    if(Mesh.Animations == none)
    {
        return;
    }
    // End:0x5D
    foreach Mesh.AllAnimNodes(class'AnimNodeSynch', Node)
    {
        // End:0x5C
        if(Node.NodeName == 'LegMovementSyncGroup')
        {
            LegMovementSyncGroup = Node;
        }        
    }    
    //return;    
}

simulated function InitializeWeaponAnimationSets()
{
    local int Index;

    // End:0x0D
    if(MyWeapon == none)
    {
        return;
    }
    MyWeapon.Mesh3p.AnimSets.Length = Mesh.AnimSets.Length;
    Index = 0;
    J0x3F:
    // End:0x98 [Loop If]
    if(Index < Mesh.AnimSets.Length)
    {
        MyWeapon.Mesh3p.AnimSets[Index] = Mesh3p.AnimSets[Index];
        ++ Index;
        // [Loop Continue]
        goto J0x3F;
    }
    //return;    
}

function SetAnimationController()
