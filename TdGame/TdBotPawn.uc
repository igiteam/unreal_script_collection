event Landed(Vector aNormal, Actor anActor)
{
    // End:0xBE
    if(((Velocity.Z < float(-1700)) && MovementState == 2) && (myController.CurrentPath == none) || ((myController.CurrentPath.reachFlags & 8) == 0) && !myController.CurrentPath.Start.bIsSpecialMove)
    {
        TakeDamage(200, none, Location, vect(0.0, 0.0, 0.0), class'DmgType_Fell');
    }
    // End:0xE4
    else
    {
        Moves[MovementState].Landed(aNormal, anActor);
    }
    //return;    
}

event Falling()
{
    super(Pawn).Falling();
    myController.NotifyFalling();
    // End:0x67
    if((!bCanWalkOffLedges && FastTrace(Location - vect(0.0, 0.0, 300.0), Location)) && CanDoMove(77))
    {
        SetMove(77);
    }
    //return;    
}

function bool ShouldStumbleOffLedge()
{
    local Vector StartTraceLocation, EndTraceLocation, TraceVector;

    // End:0x22
    if(bCanWalkOffLedges || myController.Enemy == none)
    {
        return false;
    }
    StartTraceLocation = Location;
    StartTraceLocation.Z += MaxStepHeight;
    TraceVector = Normal(myController.Enemy.Location - Location);
    TraceVector.Z = 0.0;
    EndTraceLocation = StartTraceLocation - (TraceVector * 200.0);
    SetIgnoreAIPawnBlockingVolumes(true);
    // End:0xCC
    if(!FastTrace(EndTraceLocation, StartTraceLocation, GetCollisionExtent()))
    {
        SetIgnoreAIPawnBlockingVolumes(false);
        return false;
    }
    StartTraceLocation = Location - (TraceVector * 200.0);
    TraceVector = vect(0.0, 0.0, 0.0);
    TraceVector.Z += ((GetCollisionHeight()) + MaxStepHeight);
    EndTraceLocation = StartTraceLocation - TraceVector;
    // End:0x153
    if(!FastTrace(EndTraceLocation, StartTraceLocation, GetCollisionExtent()))
    {
        SetIgnoreAIPawnBlockingVolumes(false);
        return false;
    }
    SetIgnoreAIPawnBlockingVolumes(false);
    return true;
    //return ReturnValue;    
}

