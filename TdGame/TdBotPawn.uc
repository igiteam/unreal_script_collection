function MakeInvulnerableTo(class<DamageType> DamageType, name Identifier)
{
    local InvulnerableDamageTypeStruct NewDamageTypeStuct;

    NewDamageTypeStuct.DamageType = DamageType;
    NewDamageTypeStuct.Identifier = Identifier;
    InvulnerableDamageTypes.AddItem(NewDamageTypeStuct);
    //return;    
}

function MakeInvulnerableTo_StringVersion(array<name> DamageTypeNames, name Identifier)
{
    local name DamageTypeName;
    local InvulnerableDamageTypeStruct NewDamaTypeStuct;

    NewDamaTypeStuct.Identifier = Identifier;
    // End:0x1EB
    foreach DamageTypeNames(DamageTypeName,)
    {
        switch(DamageTypeName)
        {
            // End:0x52
            case 'AllMelee':
                NewDamaTypeStuct.DamageType = class'TdDmgType_Melee';
                // End:0x1DD
                break;
            // End:0x77
            case 'MeleeAir':
                NewDamaTypeStuct.DamageType = class'TdDmgType_MeleeAir';
                // End:0x1DD
                break;
            // End:0x9C
            case 'MeleeBarge':
                NewDamaTypeStuct.DamageType = class'TdDmgType_Barge';
                // End:0x1DD
                break;
            // End:0xC1
            case 'MeleeCrouch':
                NewDamaTypeStuct.DamageType = class'TdDmgType_MeleeCrouch';
                // End:0x1DD
                break;
            // End:0xE6
            case 'MeleeDisarm':
                NewDamaTypeStuct.DamageType = class'TdDmgType_MeleeDisarm';
                // End:0x1DD
                break;
            // End:0x10B
            case 'MeleeLeft':
                NewDamaTypeStuct.DamageType = class'TdDmgType_MeleeLeft';
                // End:0x1DD
                break;
            // End:0x146
            case 'MeleePunsh':
                NewDamaTypeStuct.DamageType = class'TdDmgType_MeleeLeft';
                NewDamaTypeStuct.DamageType = class'TdDmgType_MeleeRight';
                // End:0x1DD
                break;
            // End:0x16B
            case 'MeleeRight':
                NewDamaTypeStuct.DamageType = class'TdDmgType_MeleeRight';
                // End:0x1DD
                break;
            // End:0x190
            case 'MeleeSlide':
                NewDamaTypeStuct.DamageType = class'TdDmgType_MeleeSlide';
                // End:0x1DD
                break;
            // End:0x1B5
            case 'MeleeSoccerKick':
                NewDamaTypeStuct.DamageType = class'TdDmgType_MeleeSoccerKick';
                // End:0x1DD
                break;
            // End:0x1DA
            case 'MeleeWallRun':
                NewDamaTypeStuct.DamageType = class'TdDmgType_MeleeWallRun';
                // End:0x1DD
                break;
            // End:0xFFFF
            default:
                InvulnerableDamageTypes.AddItem(NewDamaTypeStuct);                
            }            
            //return;            
}

function RemoveInvulnerableTo(class<DamageType> DamageType, name Identifier)
{
    local InvulnerableDamageTypeStruct InvulnerableDamageType;

    // End:0x53
    foreach InvulnerableDamageTypes(InvulnerableDamageType,)
    {
        // End:0x52
        if((InvulnerableDamageType.DamageType == DamageType) && InvulnerableDamageType.Identifier == Identifier)
        {
            InvulnerableDamageTypes.RemoveItem(InvulnerableDamageType);
        }        
    }    
    //return;    
}

function RemoveAllInvulnerableTo(name Identifier)
{
    local InvulnerableDamageTypeStruct InvulnerableDamageType;
    local array<InvulnerableDamageTypeStruct> InvulnerableDamageTypesTemp;

    // End:0x37
    foreach InvulnerableDamageTypes(InvulnerableDamageType,)
    {
        // End:0x36
        if(InvulnerableDamageType.Identifier != Identifier)
        {
            InvulnerableDamageTypesTemp.AddItem(InvulnerableDamageType);
        }        
    }    
    InvulnerableDamageTypes = InvulnerableDamageTypesTemp;
    //return;    
}

private final function bool IsInvulnerableToThisDamageType(class<DamageType> DamageType)
{
    local InvulnerableDamageTypeStruct InvulnerableDamageType;

    // End:0x2E
    foreach InvulnerableDamageTypes(InvulnerableDamageType,)
    {
        // End:0x2D
        if(ClassIsChildOf(DamageType, InvulnerableDamageType.DamageType))
        {            
            return true;
        }        
    }    
    return false;
    //return ReturnValue;    
}

function AdjustDamage(out int inDamage, out Vector OutMomentum, Controller InstigatedBy, Vector HitLocation, class<DamageType> DamageType, optional TraceHitInfo HitInfo)
{
    // End:0x1F
    if(class<TdDmgType_Sniper_Bullet>(DamageType) != none)
    {
        inDamage = 99999;
    }
    // End:0x43
    else
    {
        super.AdjustDamage(inDamage, OutMomentum, InstigatedBy, HitLocation, DamageType, HitInfo);
    }
    //return;    
}

function TakeDamage(int Damage, Controller InstigatedBy, Vector HitLocation, Vector damageMomentum, class<DamageType> DamageType, optional TraceHitInfo HitInfo, optional Actor DamageCauser)
{
    local bool alreadyDead;
    local int HealthBefore;
    local TdPawn.EMeleeImpactType MeleeImpactType;
    local TdBotPawn.DeathAnimType PrevDeathAnimType;

    // End:0x24
    if((DamageType == class'TdDmgType_Flashbang') || DamageType == class'TdDmgType_HeavyFlashbang')
    {
        return;
    }
    HealthBefore = Health;
    // End:0x3F
    if(IsInvulnerableToThisDamageType(DamageType))
    {
        return;
    }
    // End:0x41B
    if((InstigatedBy == none) || (InstigatedBy.Pawn != none) && InstigatedBy.Pawn.IsHumanControlled())
    {
        // End:0xC2
        if((HitInfo.HitComponent != none) && HitInfo.HitComponent.TemplateName == 'RiotShield')
        {
            return;
        }
        alreadyDead = IsDead();
        // End:0x41B
        if(!alreadyDead)
        {
            // End:0x145
            if(((HitInfo.PhysMaterial != none) && HitInfo.PhysMaterial.Name == 'PM_Character_Head') && class<TdDmgType_Melee>(DamageType) == none)
            {
                Damage = int(float(Damage) * DamageMultiplier_Head);
            }
            // End:0x1B5
            else
            {
                // End:0x18F
                if((HitInfo.PhysMaterial != none) && HitInfo.PhysMaterial.Name == 'PM_Character_Shield')
                {
                    Damage = 0;
                }
                // End:0x1B5
                else
                {
                    // End:0x1B5
                    if(class<TdDmgType_Melee>(DamageType) == none)
                    {
                        Damage = int(float(Damage) * DamageMultiplier_Body);
                    }
                }
            }
            // End:0x1CA
            if(bAIGodMode)
            {
                Health += Damage;
            }
            PrevDeathAnimType = ActiveDeathAnimType;
            // End:0x201
            if(TdWeapon(DamageCauser) != none)
            {
                ActiveDeathAnimType = byte(TdWeapon(DamageCauser).DeathAnimType);
            }
            // End:0x29D
            if(((InstigatedBy.IsA('TdPlayerController') && InstigatedBy.Pawn != none) && !DamageType.IsA('TdDmgType_Melee')) && !DamageType.IsA('TdDmgType_MeleeDisarm'))
            {
                TdPlayerPawn(InstigatedBy.Pawn).LastEnemyHitTimeOut = WorldInfo.TimeSeconds + 0.350;
            }
            super.TakeDamage(Damage, InstigatedBy, HitLocation, damageMomentum, DamageType, HitInfo, DamageCauser);
            // End:0x2DC
            if(Health > 0)
            {
                ActiveDeathAnimType = PrevDeathAnimType;
            }
            // End:0x395
            if((class<TdDmgType_Melee>(DamageType) != none) && DamageType != class'TdDmgType_MeleeDisarm')
            {
                MeleeImpactType = ((((DamageType == class'TdDmgType_MeleeAir') || DamageType == class'TdDmgType_MeleeSlide') || DamageType == class'TdDmgType_MeleeWallRun') ? 2 : 1);
                PlayMeleeImpact(HitInfo.PhysMaterial, MeleeImpactType, HitLocation, -vector(InstigatedBy.Pawn.Rotation), damageMomentum, HitInfo.BoneName, DamageType);
            }
            bForceWaitForDamage = true;
            SetTimer(DamageTime, false, 'ForceWaitForDamage');
            // End:0x3DF
            if(!alreadyDead && Health <= 0)
            {
                myController.ReportBotDied();
            }
            // End:0x41B
            else
            {
                // End:0x41B
                if((HealthBefore - Health) > 0)
                {
                    myController.NotifyDamage(InstigatedBy, DamageType, HealthBefore - Health);
                }
            }
        }
    }
    //return;    
}

function PlayMeleeImpact(PhysicalMaterial PhysMat, TdPawn.EMeleeImpactType Type, Vector TargetHitLocation, Vector TargetHitNormal, Vector TargetHitMomentum, name TargetHitBone, class<DamageType> DamageType)
{
    // End:0x22
    if(IsInvulnerableToThisDamageType(DamageType) || class<TdDmgType_MeleeAirAbove>(DamageType) != none)
    {
        return;
    }
    super.PlayMeleeImpact(PhysMat, Type, TargetHitLocation, TargetHitNormal, TargetHitMomentum, TargetHitBone, DamageType);
    //return;    
}

function bool PreventWeaponImpactEffect(Controller InstigatorController)
{
    // End:0x39
    if(((InstigatorController != none) && InstigatorController.IsA('TdAIController')) || IsInState('Dying'))
    {
        return true;
    }
    return false;
    //return ReturnValue;    
}

simulated function StumbleDamage(TdPawn InstigatorPawn, Vector HitLocation, Vector damageMomentum, class<DamageType> DamageType)
{
    local TdMove_StumbleBase StumbleMove;

    StumbleMove = TdMove_StumbleBase(Moves[77]);
    // End:0xAB
    if(StumbleMove != none)
    {
        StumbleMove.InstigatorLocation = ((InstigatorPawn != none) ? InstigatorPawn.Location : vect(0.0, 0.0, 0.0));
        StumbleMove.Instigator = InstigatorPawn;
        StumbleMove.damageMomentum = damageMomentum;
        StumbleMove.DamageLocation = HitLocation;
        StumbleMove.HitDamageType = DamageType;
    }
    // End:0x174
    if(CanDoMove(84))
    {
        // End:0x11B
        if((((DamageType == class'TdDmgType_Melee') || DamageType == class'TdDmgType_MeleeLeft') || DamageType == class'TdDmgType_MeleeRight') || DamageType == class'TdDmgType_MeleeSoccerKick')
        {
            ++ ConsecutiveHitCount;
            MeleeAttackTime = WorldInfo.TimeSeconds;
        }
        // End:0x174
        else
        {
            // End:0x149
            if(DamageType == class'TdDmgType_MeleeCrouch')
            {
                ++ ConsecutiveCrouchHitCount;
                CrouchMeleeAttackTime = WorldInfo.TimeSeconds;
            }
            // End:0x174
            else
            {
                // End:0x174
                if(DamageType == class'TdDmgType_MeleeAir')
                {
                    ++ ConsecutiveAirHitCount;
                    AirMeleeAttackTime = WorldInfo.TimeSeconds;
                }
            }
        }
    }
    super.StumbleDamage(InstigatorPawn, HitLocation, damageMomentum, DamageType);
    //return;    
}

