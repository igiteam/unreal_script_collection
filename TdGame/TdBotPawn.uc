simulated function PlayDeathAnim()
{
    bDyingFromCover = myController.IsInCover;
    // End:0x4D
    if(DeathAnim.PawnImpulse > 0.0)
    {
        ImpulseHisAss(Normal(LastPhysHitInfo.Momentum));
    }
    // End:0xA3
    if(Abs(DeathAnim.CollisionScale - 1.0) > 0.010)
    {
        SetCollisionSize(default.CylinderComponent.CollisionRadius, default.CylinderComponent.CollisionHeight * DeathAnim.CollisionScale);
    }
    // End:0x1C9
    if(DeathAnim.AnimName != 'None')
    {
        // End:0x127
        if(bDyingFromCover)
        {
            PlayCustomAnim(0, DeathAnim.AnimName, DeathAnim.PlaybackSpeed, 0.30, -1.0, false, true, DeathAnim.bUseRootMotion, DeathAnim.bUseRootMotion);
        }
        // End:0x181
        else
        {
            PlayCustomAnim(0, DeathAnim.AnimName, DeathAnim.PlaybackSpeed, 0.20, -1.0, false, true, DeathAnim.bUseRootMotion, DeathAnim.bUseRootMotion);
        }
        GetCustomAnimation(0).bNoNotifies = true;
        // End:0x1C9
        if(DeathAnim.bUseRootMotion)
        {
            SetPhysics(4);
            UseRootMotion(true);
            UseRootRotation(true);
        }
    }
    StopPhysicsBodyImpact();
    Mesh.PhysicsAssetInstance.SetAllBodiesFixed(true);
    // End:0x225
    if(DeathAnim.TimeToEnableRagdoll > 0.0)
    {
        SetTimer(DeathAnim.TimeToEnableRagdoll, false, 'EnableRagdoll');
    }
    // End:0x22F
    else
    {
        EnableRagdoll();
    }
    // End:0x2F5
    if(DeathAnim.bUseMotors)
    {
        RagdollMotorBlendOut = DeathAnim.TimeToDisableMotors - DeathAnim.TimeToBlendOutMotors;
        // End:0x2A6
        if(DeathAnim.TimeToBlendOutMotors > 0.0)
        {
            SetTimer(DeathAnim.TimeToBlendOutMotors, false, 'StartBlendOutMotors');
        }
        // End:0x2B0
        else
        {
            StartBlendOutMotors();
        }
        // End:0x2EB
        if(DeathAnim.TimeToDisableMotors > 0.0)
        {
            SetTimer(DeathAnim.TimeToDisableMotors, false, 'TurnOffMotors');
        }
        // End:0x2F5
        else
        {
            TurnOffMotors();
        }
    }
    // End:0x330
    if(DeathAnim.TimeToFullRagdoll > 0.0)
    {
        SetTimer(DeathAnim.TimeToFullRagdoll, false, 'FullBodyRagdoll');
    }
    // End:0x33A
    else
    {
        FullBodyRagdoll();
    }
    // End:0x399
    if(DeathAnim.BoneImpulse > 0.0)
    {
        // End:0x38F
        if(DeathAnim.TimeToBoneImpulse > 0.0)
        {
            SetTimer(DeathAnim.TimeToBoneImpulse, false, 'GiveBoneImpulse');
        }
        // End:0x399
        else
        {
            GiveBoneImpulse();
        }
    }
    //return;    
}

simulated function GetDeathAnim(TdBotPawn.DeathAnimType Type, out DeathAnimData Data)
{
    switch(Type)
    {
        // End:0x1C
        case 0:
            Data = DeathAnimRagdoll;
            // End:0xE7
            break;
        // End:0x2E
        case 1:
            Data = DeathAnimRagdollHard;
            // End:0xE7
            break;
        // End:0x41
        case 2:
            Data = DeathAnimDeathFront;
            // End:0xE7
            break;
        // End:0x54
        case 3:
            Data = DeathAnimDeathFrontHard;
            // End:0xE7
            break;
        // End:0x67
        case 4:
            Data = DeathAnimDeathBack;
            // End:0xE7
            break;
        // End:0x7A
        case 5:
            Data = DeathAnimDeathBackHard;
            // End:0xE7
            break;
        // End:0x8D
        case 6:
            Data = DeathAnimDeathRight;
            // End:0xE7
            break;
        // End:0xA0
        case 7:
            Data = DeathAnimDeathRightHard;
            // End:0xE7
            break;
        // End:0xB3
        case 8:
            Data = DeathAnimDeathLeft;
            // End:0xE7
            break;
        // End:0xC6
        case 9:
            Data = DeathAnimDeathLeftHard;
            // End:0xE7
            break;
        // End:0xD9
        case 10:
            Data = DeathAnimDeathByAuto;
            // End:0xE7
            break;
        // End:0xFFFF
        default:
            Data = DeathAnimRagdoll;
            //return;
    }    
}

simulated function PlayDying(class<DamageType> DamageType, Vector HitLoc)
{
    local editinline AudioComponent AC;

    // End:0x20
    if(CanDoMove(2))
    {
        SetMove(2);
    }
    // End:0x2E
    else
    {
        SetMove(1);
    }
    SetPhysics(2);
    // End:0x4E
    if(bDyingFromCover)
    {
        StopAllCustomAnimations(0.30);
    }
    // End:0x5D
    else
    {
        StopAllCustomAnimations(0.10);
    }
    // End:0x7C
    if(Weapon != none)
    {
        MyWeapon.AbortBurst();
    }
    GetDeathAnim(ActiveDeathAnimType, DeathAnim);
    PlayDeathAnim();
    SetCollision(bCollideActors, false);
    // End:0xE6
    foreach AllOwnedComponents(class'AudioComponent', AC)
    {
        // End:0xE5
        if(AC.bStopWhenOwnerDestroyed)
        {
            AC.FadeOut(0.050, 0.0);
        }        
    }    
    super.PlayDying(DamageType, HitLoc);
    //return;    
}

simulated function ImpulseHisAss(Vector Direction)
{
    local Vector Impulse;

    Impulse = Direction;
    Impulse *= DeathAnim.PawnImpulse;
    Impulse.Z = DeathAnim.PawnZImpulse;
    Velocity += Impulse;
    GravityModifier = DeathAnim.GravityModifier;
    //return;    
}

simulated function GiveBoneImpulse()
{
    Mesh.AddImpulse(Normal(LastPhysHitInfo.Momentum) * DeathAnim.BoneImpulse, LastPhysHitInfo.HitLocation, LastPhysHitInfo.HitBone);
    //return;    
}

simulated function TickRagdoll(float DeltaTime)
{
    // End:0x52
    if(RagdollTimer > 0.0)
    {
        Mesh.PhysicsAssetInstance.SetAngularDriveScale(RagdollTimer / RagdollMotorBlendOut, RagdollTimer / RagdollMotorBlendOut, 0.0);
        RagdollTimer -= DeltaTime;
    }
    //return;    
}

simulated function EnableRagdoll()
{
    Mesh.PhysicsAssetInstance.SetNamedBodiesFixed(false, RagdollBones, Mesh, false);
    // End:0xDB
    if(DeathAnim.bUseMotors)
    {
        Mesh.PhysicsAssetInstance.SetAngularDriveScale(1.0, 1.0, 0.0);
        Mesh.PhysicsAssetInstance.SetNamedMotorsAngularPositionDrive(true, true, RagdollBones, Mesh, true);
        Mesh.PhysicsAssetInstance.SetAllMotorsAngularDriveParams(DeathAnim.MotorStrength, DeathAnim.MotorStrength, 0.0);
        Mesh.bUpdateJointsFromAnimation = true;
    }
    Mesh.PhysicsWeight = 1.0;
    Mesh.WakeRigidBody();
    //return;    
}

simulated function StartBlendOutMotors()
{
    RagdollTimer = RagdollMotorBlendOut;
    //return;    
}

simulated function TurnOffMotors()
{
    Mesh.PhysicsAssetInstance.SetAllMotorsAngularPositionDrive(false, false);
    Mesh.bUpdateJointsFromAnimation = false;
    //return;    
}

simulated function FullBodyRagdoll()
{
    Mesh.PhysicsAssetInstance.SetAllBodiesFixed(false);
    Mesh.SetRBCollidesWithChannel(5, true);
    SetPhysics(2);
    CylinderComponent.SetTraceBlocking(false, false);
    CylinderComponent.SetActorCollision(false, false);
    ActorCylinderComponent.SetTraceBlocking(false, false);
    ActorCylinderComponent.SetActorCollision(false, false);
    GravityModifier = 1.0;
    //return;    
}

// Export UTdBotPawn::execOnContentLoaded(FFrame&, void* const)
private native final function OnContentLoaded();

simulated event int SetupTemplate(AITemplate TheTemplate, bool bGiveDefaultInventory)
{
    local int I, N;
    local string Item;
    local SkeletalMesh NewSkelMesh;
    local TdAnimSet NewAnimSet;

    switch(SetupTemplateCount)
    {
        // End:0x11A
        case 0:
            myTemplate = TheTemplate;
            NewSkelMesh = SkeletalMesh(DynamicLoadObject(TheTemplate.SkeletalMesh, class'SkeletalMesh', false));
            // End:0x4E
            if(NewSkelMesh == none)
            {
                return SetupTemplateCount;
            }
            Mesh.SetSkeletalMesh(NewSkelMesh, false);
            N = 2;
            I = 0;
            J0x73:
            // End:0x100 [Loop If]
            if(I < N)
            {
                // End:0xF6
                if(TheTemplate.AnimationSets[I] != "")
                {
                    NewAnimSet = TdAnimSet(DynamicLoadObject(TheTemplate.AnimationSets[I], class'TdAnimSet', false));
                    // End:0xDB
                    if(NewAnimSet == none)
                    {
                        return SetupTemplateCount;
                    }
                    Mesh.AnimSets[I] = NewAnimSet;
                }
                ++ I;
                // [Loop Continue]
                goto J0x73;
            }
            Mesh.UpdateAnimations();
            ++ SetupTemplateCount;
            // End:0x501
            break;
        // End:0x12E
        case 1:
            OnContentLoaded();
            ++ SetupTemplateCount;
            // End:0x501
            break;
        // End:0x2D7
        case 2:
            bCanDoTakedownMoves = TheTemplate.bCanDoSpecialMoves;
            SpeedCurve_LightWeapon = TheTemplate.SpeedCurve_LightWeapon;
            SpeedCurve_HeavyWeapon = TheTemplate.SpeedCurve_HeavyWeapon;
            // End:0x226
            if(TheTemplate.MainWeaponClass != "")
            {
                AddToInventory(class<TdWeapon>(DynamicLoadObject(TheTemplate.MainWeaponClass, class'Class')));
                I = 0;
                J0x1BB:
                // End:0x226 [Loop If]
                if(I < TheTemplate.OtherWeaponClasses.Length)
                {
                    Item = TheTemplate.OtherWeaponClasses[I];
                    // End:0x21C
                    if(Item != "")
                    {
                        AddToInventory(class<TdWeapon>(DynamicLoadObject(Item, class'Class')));
                    }
                    ++ I;
                    // [Loop Continue]
                    goto J0x1BB;
                }
            }
            // End:0x266
            if(TheTemplate.DroppedGrenadeClass != "")
            {
                DroppedGrenadeClass = class<TdProj_Grenade>(TheTemplate.GetClassFromName(TheTemplate.DroppedGrenadeClass));
            }
            // End:0x2CD
            if(TheTemplate.ShieldClass != "")
            {
                myShield = TdInv_Shield(CreateInventory(class<Inventory>(DynamicLoadObject(TheTemplate.ShieldClass, class'Class'))));
                // End:0x2CD
                if(myShield != none)
                {
                    myShield.Activate();
                }
            }
            ++ SetupTemplateCount;
            // End:0x501
            break;
        // End:0x42C
        case 3:
            Controller.ClientSwitchToBestWeapon();
            SightRadius = TheTemplate.UncertainVisionRange;
            CertainSightRadius = TheTemplate.CertainVisionRange;
            PeripheralVision = Cos((TheTemplate.VisionAngle * 3.1415930) / 180.0);
            HearingThreshold = TheTemplate.HearingRange;
            MaxHealth = TheTemplate.MaxHealth;
            Health = MaxHealth;
            DamageMultiplier_Head = TheTemplate.DamageMultiplier_Head;
            DamageMultiplier_Body = TheTemplate.DamageMultiplier_Body;
            TdMove_LayOnGroundBot(Moves[26]).LayDownIdleTime = TheTemplate.MeleeLayDownIdleTime;
            AiProfileName = name(TheTemplate.ProfileName);
            bEnableMeleePose = TheTemplate.bEnableMeleePose;
            bEnableFootPlacement = TheTemplate.bEnableFootPlacement;
            bEnableInverseKinematics = TheTemplate.bEnableInverseKinematics;
            ++ SetupTemplateCount;
            // End:0x501
            break;
        // End:0x4FE
        case 4:
            InitializeWeaponAnimationSets();
            InitializeAimOffsetNodes();
            InitializePoseOffsetNodes();
            // End:0x46F
            if(!TheTemplate.CanRun)
            {
                SetWalking(true);
            }
            // End:0x4F4
            if(IsA('TdBotPawn_PatrolCop'))
            {
                // End:0x4F4
                if((AiProfileName == 'PatrolCopOneHanded') || AiProfileName == name("PatrolCopOneHanded-Glock"))
                {
                    AdditionalSkeletalMesh.SetSkeletalMesh(SkeletalMesh(DynamicLoadObject(TheTemplate.AdditionalSkeletalMesh, class'SkeletalMesh', false)), false);
                    AttachComponent(AdditionalSkeletalMesh);
                }
            }
            ++ SetupTemplateCount;
            // End:0x501
            break;
        // End:0xFFFF
        default:
            return SetupTemplateCount - 4;
    }
    //return ReturnValue;    
}

