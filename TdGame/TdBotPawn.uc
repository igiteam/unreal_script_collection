function name GetCurrentProfileName(AnimNodeAimOffset AimNode)
{
    local name AimProfileName;

    AimProfileName = 'None';
    // End:0x8F
    if(AimNode.TemplateNode != none)
    {
        // End:0x8C
        if(AimNode.CurrentProfileIndex < AimNode.TemplateNode.Profiles.Length)
        {
            AimProfileName = AimNode.TemplateNode.Profiles[AimNode.CurrentProfileIndex].ProfileName;
        }
    }
    // End:0xE3
    else
    {
        // End:0xE3
        if(AimNode.CurrentProfileIndex < AimNode.Profiles.Length)
        {
            AimProfileName = AimNode.Profiles[AimNode.CurrentProfileIndex].ProfileName;
        }
    }
    return AimProfileName;
    //return ReturnValue;    
}

