function float WhereInWalkCykle()
{
    local float CurrentTime, walkcycleTime;

    CurrentTime = LegMovementSyncGroup.Groups[0].MasterNode.CurrentTime;
    walkcycleTime = LegMovementSyncGroup.Groups[0].MasterNode.AnimSeq.SequenceLength;
    return CurrentTime / walkcycleTime;
    //return ReturnValue;    
}

