function AllowStandingTurning(bool bAllowTurning)
{
    bAllowStandingTurning = bAllowTurning;
    //return;    
}

simulated function Turn(float DeltaTime)
{
    local int LegRotationDiff;

    // End:0x0D
    if(!bAllowStandingTurning)
    {
        return;
    }
    LegRotationDiff = int((Abs(float(NormalizeRotAxis(LegRotation - Rotation.Yaw))) * 360.0) / 65536.0);
    // End:0x60
    if(LegRotationDiff < 20)
    {
        TurnTimer = 0.0;
        return;
    }
    // End:0x8B
    else
    {
        // End:0x8B
        if((LegRotationDiff < 70) && TurnTimer < 0.50)
        {
            TurnTimer += DeltaTime;
            return;
        }
    }
    // End:0xC7
    if((IsInMove(1)) && Moves[45].CanDoMove())
    {
        SetMove(45);
    }
    // End:0xD4
    else
    {
        TurnTimer = 0.0;
        return;
    }
    //return;    
}

simulated function Tick(float DeltaTime)
{
    ThisTick = DeltaTime;
    TickRagdoll(DeltaTime);
    // End:0x2B
    if(ThisTick == 0.0)
    {
        return;
    }
    super.Tick(ThisTick);
    // End:0x10D
    if(!IsDead())
    {
        bIsWalkingOrStanding = WalkingOrStanding();
        Turn(ThisTick);
        UpdateLeaning(ThisTick);
        // End:0x83
        if(bWantsToFire)
        {
            CheckFire();
        }
        InterpolateSlope(ThisTick);
        ViewPointLocation = GetViewpointLocation(false);
        ViewPointLocation_Crouching = GetViewpointLocation(true);
        bCanFire = ((bIsWalkingOrStanding && !IsInState('LookbackState')) && myAnimationController.CanFireWeapon()) && myController.CoverController.CanFireWeapon();
    }
    // End:0x127
    if(HitReactionNode != none)
    {
        UpdateHitReaction(DeltaTime);
    }
    //return;    
}

