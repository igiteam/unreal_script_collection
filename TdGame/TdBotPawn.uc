function int GetMainWeaponAmmoDropsDisarmed(int Difficulty)
{
    switch(Difficulty)
    {
        // End:0x62
        case 0:
            // End:0x3D
            if(bChaseAI)
            {
                return myController.myTemplate.MainWeaponAmmoDrops_Disarmed_CHASE.Easy;
            }
            // End:0x62
            else
            {
                return myController.myTemplate.MainWeaponAmmoDrops_Disarmed.Easy;
        }
        // End:0xBC
        case 1:
            // End:0x97
            if(bChaseAI)
            {
                return myController.myTemplate.MainWeaponAmmoDrops_Disarmed_CHASE.Medium;
            }
            // End:0xBC
            else
            {
                return myController.myTemplate.MainWeaponAmmoDrops_Disarmed.Medium;
        }
        // End:0x117
        case 2:
            // End:0xF2
            if(bChaseAI)
            {
                return myController.myTemplate.MainWeaponAmmoDrops_Disarmed_CHASE.Hard;
            }
            // End:0x117
            else
            {
                return myController.myTemplate.MainWeaponAmmoDrops_Disarmed.Hard;
        }
        // End:0xFFFF
        default:
            return 0;
    }
    //return ReturnValue;    
}

function int GetMainWeaponAmmoDropsDropped(int Difficulty)
{
    switch(Difficulty)
    {
        // End:0x62
        case 0:
            // End:0x3D
            if(bChaseAI)
            {
                return myController.myTemplate.MainWeaponAmmoDrops_Dropped_CHASE.Easy;
            }
            // End:0x62
            else
            {
                return myController.myTemplate.MainWeaponAmmoDrops_Dropped.Easy;
        }
        // End:0xBC
        case 1:
            // End:0x97
            if(bChaseAI)
            {
                return myController.myTemplate.MainWeaponAmmoDrops_Dropped_CHASE.Medium;
            }
            // End:0xBC
            else
            {
                return myController.myTemplate.MainWeaponAmmoDrops_Dropped.Medium;
        }
        // End:0x117
        case 2:
            // End:0xF2
            if(bChaseAI)
            {
                return myController.myTemplate.MainWeaponAmmoDrops_Dropped_CHASE.Hard;
            }
            // End:0x117
            else
            {
                return myController.myTemplate.MainWeaponAmmoDrops_Dropped.Hard;
        }
        // End:0xFFFF
        default:
            return 0;
    }
    //return ReturnValue;    
}

function SetDifficultyLevel(int Difficulty)
{
    local TdWeapon W;

    // End:0x0D
    if(myController == none)
    {
        return;
    }
    SetArmorDifficultyLevel(Difficulty);
    switch(Difficulty)
    {
        // End:0x9B
        case 0:
            MainWeaponAmmo_Disarmed = ((FactoryAmmoDisarm_Easy >= 0) ? FactoryAmmoDisarm_Easy : GetMainWeaponAmmoDropsDisarmed(0));
            MainWeaponAmmo_Dropped = ((FactoryAmmoDrop_Easy >= 0) ? FactoryAmmoDrop_Easy : GetMainWeaponAmmoDropsDropped(0));
            RegenerateDelay = myController.myTemplate.RegenerationDelay.Easy;
            // End:0x18C
            break;
        // End:0x112
        case 1:
            MainWeaponAmmo_Disarmed = ((FactoryAmmoDisarm_Medium >= 0) ? FactoryAmmoDisarm_Medium : GetMainWeaponAmmoDropsDisarmed(1));
            MainWeaponAmmo_Dropped = ((FactoryAmmoDrop_Medium >= 0) ? FactoryAmmoDrop_Medium : GetMainWeaponAmmoDropsDropped(1));
            RegenerateDelay = myController.myTemplate.RegenerationDelay.Medium;
            // End:0x18C
            break;
        // End:0x189
        case 2:
            MainWeaponAmmo_Disarmed = ((FactoryAmmoDisarm_Hard >= 0) ? FactoryAmmoDisarm_Hard : GetMainWeaponAmmoDropsDisarmed(2));
            MainWeaponAmmo_Dropped = ((FactoryAmmoDrop_Hard >= 0) ? FactoryAmmoDrop_Hard : GetMainWeaponAmmoDropsDropped(2));
            RegenerateDelay = myController.myTemplate.RegenerationDelay.Hard;
        // End:0xFFFF
        default:
            // End:0x1B0
            if(MyWeapon != none)
            {
                MyWeapon.SetDifficultyLevel(Difficulty);
            }
            // End:0x1E7
            foreach InvManager.InventoryActors(class'TdWeapon', W)
            {
                W.SetDifficultyLevel(Difficulty);                
            }            
            // End:0x232
            if(bChaseAI)
            {
                SoftLockStrength = myController.myTemplate.SoftLockStrength_CHASE;
                MeleeAttackLimit = myController.myTemplate.MeleeAttackLimit_CHASE;
            }
            // End:0x270
            else
            {
                SoftLockStrength = myController.myTemplate.SoftLockStrength;
                MeleeAttackLimit = myController.myTemplate.MeleeAttackLimit;
            }
            //return;
    }    
}

event UpdateAnimationBaseSpeed()
{
    local TdAnimNodeSequence AnimationSequence;

    // End:0x32
    foreach Mesh3p.AllAnimNodes(class'TdAnimNodeSequence', AnimationSequence)
    {
        AnimationSequence.UpdateBaseSpeed();        
    }    
    //return;    
}

