state LookbackState
{
    function PushedState()
    {
        super(Object).PushedState();
        myController.StopFiring();
        //return;        
    }

    function PoppedState()
    {
        super(Object).PoppedState();
        myController.HeadFocus.PopEnabled('LookBack');
        myController.StartFiring();
        StopCustomAnim(4, 0.20);
        //return;        
    }

    function StopLookback()
    {
        PopState();
        //return;        
    }

    function bool CanFireWeapon()
    {
        return false;
        //return ReturnValue;        
    }

Begin:
    FinishAnim(GetCustomAnimation(7));
    myController.HeadFocus.PushEnabled(false, 'LookBack');
    PlayCustomAnim(4, 'WalkLookBwd', 1.0, 0.10, 0.050, false, true, false, false);
    FinishAnim(GetCustomAnimation(4));
    PopState();
    stop;            
}

state Dying
{
    function BeginState(name PreviousStateName)
    {
        local Actor A;
        local array<SequenceEvent> TouchEvents;
        local int I;

        myController.HeadFocus.PushEnabled(false, 'Dying');
        Mesh.SetNotifyRigidBodyCollision(true);
        Mesh.ScriptRigidBodyCollisionThreshold = 150.0;
        // End:0x81
        if(bTearOff && WorldInfo.NetMode == NM_DedicatedServer)
        {
            LifeSpan = 2.0;
        }
        // End:0x94
        else
        {
            SetTimer(5.0, false, 'RemoveAndDetachPawn');
        }
        // End:0xA9
        if(Physics != 10)
        {
            SetPhysics(2);
        }
        SetCollision(true, false);
        // End:0x127
        foreach TouchingActors(class'Actor', A)
        {
            // End:0x126
            if(A.FindEventsOfClass(class'SeqEvent_Touch', TouchEvents))
            {
                I = 0;
                J0xE4:
                // End:0x11E [Loop If]
                if(I < TouchEvents.Length)
                {
                    SeqEvent_Touch(TouchEvents[I]).NotifyTouchingPawnDied(self);
                    ++ I;
                    // [Loop Continue]
                    goto J0xE4;
                }
                TouchEvents.Length = 0;
            }            
        }        
        // End:0x14D
        foreach BasedActors(class'Actor', A)
        {
            A.PawnBaseDied();            
        }        
        //return;        
    }

    event RigidBodyCollision(PrimitiveComponent HitComponent, PrimitiveComponent OtherComponent, const out CollisionImpactData RigidCollisionData, int ContactIndex)
    {
        local float ZVel;
        local Vector HitComponentPosition;

        // End:0xEC
        if(Abs(RigidCollisionData.ContactInfos[0].ContactNormal.Z) > 0.50)
        {
            ZVel = RigidCollisionData.ContactInfos[0].ContactVelocity[1].Z;
            HitComponentPosition = HitComponent.GetPosition();
            // End:0xA1
            if(ZVel < -500.0)
            {
                PlaySound(BodyFallHard, false, true, false, HitComponentPosition);
            }
            // End:0xEC
            else
            {
                // End:0xC8
                if(ZVel < -300.0)
                {
                    PlaySound(BodyFallMedium, false, true, false, HitComponentPosition);
                }
                // End:0xEC
                else
                {
                    // End:0xEC
                    if(ZVel < -200.0)
                    {
                        PlaySound(BodyFallSoft, false, true, false, HitComponentPosition);
                    }
                }
            }
        }
        //return;        
    }

Begin:
    PlayDeathEffect();
    Sleep(0.50);
    DestroyPawn();
    stop;                
}

