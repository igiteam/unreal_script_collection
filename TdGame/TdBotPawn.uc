function bool ShouldBlock(class<DamageType> MeleeDamageType)
{
    local bool bShouldBlock;

    // End:0x13
    if(!CanDoMove(84))
    {
        return false;
    }
    // End:0x3D
    if((WorldInfo.TimeSeconds - MeleeAttackTime) > BlockResetTime)
    {
        ResetBlockingParameters();
    }
    // End:0x6C
    if((WorldInfo.TimeSeconds - CrouchMeleeAttackTime) > (BlockResetTime + float(1)))
    {
        ResetCrouchBlockingParameters();
    }
    // End:0x96
    if((WorldInfo.TimeSeconds - AirMeleeAttackTime) > 3.0)
    {
        ResetAirBlockingParameters();
    }
    switch(MeleeDamageType)
    {
        // End:0xA6
        case class'TdDmgType_Melee':
        // End:0xAE
        case class'TdDmgType_MeleeLeft':
        // End:0xDB
        case class'TdDmgType_MeleeRight':
            // End:0xD0
            if(ConsecutiveHitCount >= MeleeAttackLimit)
            {
                bShouldBlock = true;
            }
            // End:0xD8
            else
            {
                bShouldBlock = false;
            }
            // End:0x158
            break;
        // End:0x104
        case class'TdDmgType_MeleeCrouch':
            // End:0xF9
            if(ConsecutiveCrouchHitCount >= 1)
            {
                bShouldBlock = true;
            }
            // End:0x101
            else
            {
                bShouldBlock = false;
            }
            // End:0x158
            break;
        // End:0x12D
        case class'TdDmgType_MeleeAir':
            // End:0x122
            if(ConsecutiveAirHitCount >= 1)
            {
                bShouldBlock = true;
            }
            // End:0x12A
            else
            {
                bShouldBlock = false;
            }
            // End:0x158
            break;
        // End:0x135
        case class'TdDmgType_Barge':
        // End:0x13D
        case class'TdDmgType_MeleeSlide':
        // End:0x145
        case class'TdDmgType_MeleeWallRun':
        // End:0x14D
        case class'TdDmgType_MeleeSoccerKick':
        // End:0xFFFF
        default:
            bShouldBlock = false;
            return bShouldBlock;
    }
    //return ReturnValue;    
}

