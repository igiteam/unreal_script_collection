function ActivateStasis(bool flag, bool UpdateControllerState)
{
    myController.ActivateStasis(flag, UpdateControllerState);
    bStasis = flag;
    bForceStasis = flag;
    myAnimationController.bStasis = flag;
    SetHidden(flag);
    InvManager.bStasis = flag;
    // End:0x96
    if(Weapon != none)
    {
        Weapon.bStasis = flag;
    }
    // End:0x11E
    if(flag)
    {
        SetPhysics(0);
        SetCollision(false, false);
        // End:0xC6
        if(CollisionComponent != none)
        {
            CollisionComponent.SetBlockRigidBody(false);
        }
        LastRenderTime = -999.0;
        // End:0xF1
        if(Weapon != none)
        {
            Weapon.LastRenderTime = -999.0;
        }
        InvManager.LastRenderTime = -999.0;
        myAnimationController.LastRenderTime = -999.0;
    }
    // End:0x153
    else
    {
        SetPhysics(1);
        SetCollision(true, true);
        // End:0x145
        if(CollisionComponent != none)
        {
            CollisionComponent.SetBlockRigidBody(true);
        }
        SetMove(1);
    }
    //return;    
}

