event RecycleBot()
{
    local int I;
    local string Item;

    SetMove(1);
    SetPhysics(1);
    SetAnchor(none);
    SetCollision(true, true);
    GotoState('None');
    myController.RecycleBot();
    // End:0x123
    if(IsDead())
    {
        RemoveRagDoll();
        // End:0x10B
        if(myTemplate.MainWeaponClass != "")
        {
            AddToInventory(class<TdWeapon>(DynamicLoadObject(myTemplate.MainWeaponClass, class'Class')));
            I = 0;
            J0xA0:
            // End:0x10B [Loop If]
            if(I < myTemplate.OtherWeaponClasses.Length)
            {
                Item = myTemplate.OtherWeaponClasses[I];
                // End:0x101
                if(Item != "")
                {
                    AddToInventory(class<TdWeapon>(DynamicLoadObject(Item, class'Class')));
                }
                ++ I;
                // [Loop Continue]
                goto J0xA0;
            }
        }
        Controller.ClientSwitchToBestWeapon();
    }
    // End:0x133
    else
    {
        OnDeath(self);
    }
    Health = 100;
    //return;    
}

function RemoveRagDoll()
{
    // End:0x25
    if(Mesh.RigidBodyIsAwake())
    {
        Mesh.PutRigidBodyToSleep();
    }
    Mesh.PhysicsAssetInstance.SetAllBodiesFixed(true);
    Mesh.SetRBCollidesWithChannel(5, false);
    CylinderComponent.SetTraceBlocking(false, true);
    CylinderComponent.SetActorCollision(true, true);
    ActorCylinderComponent.SetTraceBlocking(false, true);
    ActorCylinderComponent.SetActorCollision(true, true);
    //return;    
}

