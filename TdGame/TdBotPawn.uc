    if(myController.EnemyDistance < AudibleFeetRange)
    {
        super.PlayFootStepSound(FootDown);
    }
    //return;    
}

event bool Died(Controller Killer, class<DamageType> DamageType, Vector HitLocation)
{
    local bool Died;

    ClearTimer('StartNewBurst');
    ClearTimer('PauseFiring');
    RVEffect.SetHidden(true);
    bPawnRunnerVision = false;
    bIsRunnerVisionEnabled = false;
    Died = super.Died(Killer, DamageType, HitLocation);
    // End:0x85
    if(Died)
    {
        OnDeath(self);
        __OnDeath__Delegate = None;
    }
    return Died;
    //return ReturnValue;    
}

