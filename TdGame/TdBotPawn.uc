final function bool IsForcedToWalk()
{
    return bForceWalking;
    //return ReturnValue;    
}

final function bool WantsToRun()
{
    return !bIsWalking || bForceWalking && !bWantsToWalk;
    //return ReturnValue;    
}

event SetWalking(bool bNewIsWalking)
{
    // End:0x3E
    if((myController.myTemplate != none) && !myController.myTemplate.CanRun)
    {
        bNewIsWalking = true;
    }
    // End:0x4F
    if(IsInMove(41))
    {
        return;
    }
    // End:0x67
    if(bForceWalking)
    {
        bWantsToWalk = bNewIsWalking;
        return;
    }
    // End:0x8C
    if(!bNewIsWalking && bIsWalking)
    {
        TdSetRotation(Rotation);
    }
    // End:0xD6
    if(myController.IsInLatentMovement())
    {
        // End:0xD6
        if(!bIsWalking && bNewIsWalking)
        {
            myController.MoveTimer *= (AnimationRunSpeed / AnimationWalkSpeed);
        }
    }
    super(Pawn).SetWalking(bNewIsWalking);
    //return;    
}

function ForceWalking(bool flag, name Identifier)
{
    local bool bShouldForceWalk;

    // End:0x27
    if(flag)
    {
        ForcedWalkingStack.PushBool(true, Identifier);
    }
    // End:0x41
    else
    {
        ForcedWalkingStack.PopBool(Identifier);
    }
    bShouldForceWalk = ForcedWalkingStack.GetBool();
    // End:0x6F
    if(bShouldForceWalk == bForceWalking)
    {
        return;
    }
    // End:0x9B
    if(bShouldForceWalk)
    {
        bWantsToWalk = bIsWalking;
        SetWalking(true);
        bForceWalking = true;
    }
    // End:0xB3
    else
    {
        bForceWalking = false;
        SetWalking(bWantsToWalk);
    }
    //return;    
}

event SetIsSlowWalking(bool flag)
{
    // End:0x72
    if(myController.IsInLatentMovement())
    {
        // End:0x46
        if(!bIsSlowWalking && flag)
        {
            myController.MoveTimer *= 2.0;
        }
        // End:0x72
        else
        {
            // End:0x72
            if(bIsSlowWalking && !flag)
            {
                myController.MoveTimer *= 0.50;
            }
        }
    }
    bIsSlowWalking = flag;
    //return;    
}

event bool GetIsSlowWalking()
{
    return bIsSlowWalking;
    //return ReturnValue;    
}

event float GetRunSpeed()
{
    return AnimationRunSpeed;
    //return ReturnValue;    
}

event float GetWalkSpeed()
{
    return AnimationWalkSpeed;
    //return ReturnValue;    
}

function StartDebugFalling()
{
    // End:0x2E
    if(MovementState != 1)
    {
        bDebuggingFalling = true;
        DebugFallingSpeed = Velocity;
        DebugFallingPos = Location;
    }
    //return;    
}

function UpdateDebugFalling()
{
    local Vector NewSpeed, NewPos;

    // End:0x11
    if(DebugFallingPos == Location)
    {
        return;
    }
    // End:0xA5
    if(MovementState != 1)
    {
        NewSpeed = DebugFallingSpeed;
        NewSpeed.Z -= (800.0 * ThisTick);
        NewPos = DebugFallingPos + (((NewSpeed + DebugFallingSpeed) * 0.50) * ThisTick);
        DrawDebugLineTime(DebugFallingPos, NewPos, 255, 0, 0, 10.0);
        DebugFallingSpeed = NewSpeed;
        DebugFallingPos = NewPos;
    }
    // End:0xAD
    else
    {
        bDebuggingFalling = false;
    }
    //return;    
}

