function OnAIFireAt(SeqAct_AIFireAt Action)
{
    local bool Enable;
    local SeqVar_Object ObjVar;

    // End:0x2B
    if(Action.InputLinks[0].bHasImpulse)
    {
        Enable = true;
    }
    // End:0x86
    else
    {
        // End:0x56
        if(Action.InputLinks[1].bHasImpulse)
        {
            Enable = false;
        }
        // End:0x86
        else
        {
            // End:0x86
            if(Action.InputLinks[2].bHasImpulse)
            {
                Enable = !Enable;
            }
        }
    }
    // End:0x109
    if(Enable)
    {
        myController.ScriptActivated(true);
        // End:0xFB
        foreach Action.LinkedVariables(class'SeqVar_Object', ObjVar, "Fire At")
        {
            myController.StartScriptedFire(Actor(ObjVar.GetObjectValue()));
            // End:0xFB
            break;            
        }        
        FireWhenReady();
    }
    // End:0x113
    else
    {
        CeaseFire();
    }
    //return;    
}

function OnSetCombatRange(SeqAct_SetCombatRange RangeData)
{
    // End:0x23
    if(RangeData.ShouldReset())
    {
        ResetCombatRange();
        return;
    }
    // End:0x3E
    if(!RangeData.ShouldSet())
    {
        return;
    }
    // End:0x6C
    if(RangeData.MaxRange > 0.0)
    {
        ForceMaxCombatRange(RangeData.MaxRange);
    }
    // End:0x9A
    if(RangeData.PreferredRange > 0.0)
    {
        ForcePreferredCombatRange(RangeData.PreferredRange);
    }
    // End:0xD1
    if(GetPreferredCombatDistance_Internal() > GetMaxCombatDistance_Internal())
    {
        // End:0xC5
        if(!bForceCombatRange_Max)
        {
            ForceMaxCombatRange(GetPreferredCombatDistance_Internal());
        }
        // End:0xD1
        else
        {
            ForcePreferredCombatRange(GetMaxCombatDistance_Internal());
        }
    }
    //return;    
}

