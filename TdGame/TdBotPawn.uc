simulated event bool SetMove(TdPawn.EMovement NewMove, optional bool bViaReplication, optional bool bCheckCanDo)
{
    local bool bResult;
    local TdPawn.EMovement CurrentMove, OldMove;

    bViaReplication = false;
    bCheckCanDo = false;
    // End:0x24
    if(NewMove == GetMove())
    {
        return true;
    }
    OldMove = GetMove();
    myController.NotifySetMove(OldMove, NewMove, iSetMoveCounter);
    ++ iSetMoveCounter;
    bResult = super.SetMove(NewMove, bViaReplication, bCheckCanDo);
    CurrentMove = GetMove();
    -- iSetMoveCounter;
    myController.NotifyMoveChanged(OldMove, CurrentMove, iSetMoveCounter);
    // End:0xD1
    if(NewMove == 1)
    {
        IgnoreMoveInput(false);
    }
    return bResult;
    //return ReturnValue;    
}

