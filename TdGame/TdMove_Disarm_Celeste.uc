function TakeDisarmedPawnsWeapon()
{
    //return;    
}

simulated function MeleeAttackNotify()
{
    local Vector HitLocation, ImpactMomentum;
    local TdPawn Instigator;
    local TraceHitInfo Hit;

    Instigator = DisarmedPawn;
    HitLocation = PawnOwner.Location + (vector(PawnOwner.Rotation) * float(30));
    Hit.Material = none;
    Hit.PhysMaterial = PawnOwner.Mesh3p.GetPhysicalMaterialFromBone('Neck');
    Hit.BoneName = 'Neck';
    Hit.HitComponent = PawnOwner.Mesh3p;
    ImpactMomentum = -vector(PawnOwner.Rotation) * 600.0;
    PawnOwner.SetMove(1);
    TdBotPawn(Instigator).bShouldNextMeleeCausePlayerFall = true;
    PawnOwner.TakeDamage(10, Instigator.Controller, HitLocation, ImpactMomentum, class'TdDmgType_MeleeLeft', Hit);
    //return;    
}

function ChooseDisarmType(out Rotator YawOffset)
{
    local TdAi_Celeste.ECelesteStage BossFightStage;

    BossFightStage = TdAi_Celeste(DisarmedPawn.Controller).GetCelesteBossFightStage();
    switch(BossFightStage)
    {
        // End:0x65
        case 0:
            YawOffset.Yaw = 0;
            DisarmOffset = 100.0;
            DisarmAnim = 'SnatchFwd2';
            // End:0x9C
            break;
        // End:0x99
        case 1:
            YawOffset.Yaw = 0;
            DisarmOffset = 100.0;
            DisarmAnim = 'SnatchFwd3';
            // End:0x9C
            break;
        // End:0xFFFF
        default:
            //return;
    }    
}
