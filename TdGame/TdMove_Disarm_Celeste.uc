class TdMove_Disarm_Celeste extends TdMOVE_Disarm
    config(PawnMovement);

function bool CanDoMove()
{
    // End:0x0D
    if(!super.CanDoMove())
    {
        return false;
    }
    return true;
    //return ReturnValue;    
