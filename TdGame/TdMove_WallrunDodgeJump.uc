    native
    config(PawnMovement);

var(WallRunDodgeJump) config float BaseJumpZ;
var(WallRunDodgeJump) config float JumpAddXY;
var(WallRunDodgeJump) config float DodgeJumpInertiaConservation;
var(WallRunDodgeJump) config float JumpBlendInTime;
var(WallRunDodgeJump) config float JumpBlendOutTime;

function bool CanDoMove()
{
    // End:0x0D
    if(!super(TdMove).CanDoMove())
    {
        return false;
    }
    // End:0x7D
    if(((PawnOwner.MovementState == 5) && PawnOwner.MoveActionHint == 2) || (PawnOwner.MovementState == 4) && PawnOwner.MoveActionHint == 1)
    {
        return true;
    }
    return false;
    //return ReturnValue;    
}

simulated function StartMove()
{
    local Vector DodgeDirection;

    super.StartMove();
    PawnOwner.LastJumpLocation = PawnOwner.Location;
    DodgeDirection = (((PawnOwner.MoveActionHint == 1) ? -1.0 : 1.0) * JumpAddXY) * Normal(vect(0.0, 0.0, 1.0) Cross vector(PawnOwner.Rotation));
    PawnOwner.Velocity = DodgeDirection + (DodgeJumpInertiaConservation * PawnOwner.Velocity);
    PawnOwner.Velocity.Z = BaseJumpZ;
    // End:0x16F
    if(((PawnOwner.Base != none) && !PawnOwner.Base.bWorldGeometry) && PawnOwner.Base.Velocity.Z > 0.0)
    {
        PawnOwner.Velocity.Z += PawnOwner.Base.Velocity.Z;
    }
    PlayMoveAnim(2, ((PawnOwner.MoveActionHint == 1) ? name("dodgejumpleft") : name("dodgejumpright")), 1.0, 0.20, 0.20);
    //return;    
}

