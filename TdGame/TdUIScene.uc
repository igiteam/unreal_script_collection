event PostInitialize()
{
    __OnRawInputKey__Delegate = HandleInputKey;
    __OnTopSceneChanged__Delegate = TopSceneChanged;
    ButtonBar = TdUIButtonBar(FindChild('ButtonBar', true));
    // End:0x7B
    if(ButtonBar != none)
    {
        ButtonBar.__OnPlayClickNotification__Delegate = PlayInputKeyNotification;
        ButtonBar.ClearButtons();
        SetupButtonBar();
    }
    SceneAnimDuration = 0.250;
    //return;    
}

event SceneActivated(bool bInitialActivation)
{
    super.SceneActivated(bInitialActivation);
    // End:0x2C
    if(ButtonBar != none)
    {
        ButtonBar.ToggleSetButtons(true);
    }
    // End:0x71
    if(bInitialActivation && IsGame())
    {
        GetOnlineSubsystem().SystemInterface.AddControllerChangeDelegate(OnControllerChange);
    }
    //return;    
}

event SceneDeactivated()
{
    super.SceneDeactivated();
    // End:0x40
    if(IsGame())
    {
        GetOnlineSubsystem().SystemInterface.ClearControllerChangeDelegate(OnControllerChange);
    }
    //return;    
}

