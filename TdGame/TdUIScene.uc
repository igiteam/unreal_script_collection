event OnPostTick(float DeltaTime, bool bTopmostScene)
{
    local bool bWasAnimated;

    // End:0x53
    if(bShowingScene)
    {
        // End:0x50
        if(SceneAnimStepPos < SceneAnimDuration)
        {
            SceneAnimStepPos += DeltaTime;
            // End:0x48
            if(SceneAnimStepPos >= SceneAnimDuration)
            {
                SceneAnimStepPos = SceneAnimDuration;
                SceneAnimEnded();
            }
            bWasAnimated = true;
        }
    }
    // End:0xA3
    else
    {
        // End:0xA3
        if(bHidingScene)
        {
            // End:0xA3
            if(SceneAnimStepPos > 0.0)
            {
                SceneAnimStepPos -= DeltaTime;
                // End:0x9B
                if(SceneAnimStepPos <= 0.0)
                {
                    SceneAnimStepPos = 0.0;
                    SceneAnimEnded();
                }
                bWasAnimated = true;
            }
        }
    }
    // End:0xB6
    if(bWasAnimated)
    {
        UpdateSceneAnimVis();
    }
    //return;    
}

