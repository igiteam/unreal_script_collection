function string TrimWhitespace(string InString)
{
    local int StartIdx, EndIdx;
    local string FinalString;

    StartIdx = 0;
    J0x07:
    // End:0x3B [Loop If]
    if(StartIdx < Len(InString))
    {
        // End:0x31
        if(Asc(Mid(InString, StartIdx, 1)) != 32)
        {
            // [Explicit Break]
            goto J0x3B;
        }
        ++ StartIdx;
        J0x3B:
        // [Loop Continue]
        goto J0x07;
    }
    EndIdx = Len(InString) - 1;
    J0x4B:
    // End:0x79 [Loop If]
    if(EndIdx >= 0)
    {
        // End:0x6F
        if(Asc(Mid(InString, EndIdx, 1)) != 32)
        {
            // [Explicit Break]
            goto J0x79;
        }
        -- EndIdx;
        J0x79:
        // [Loop Continue]
        goto J0x4B;
    }
    // End:0xA9
    if(StartIdx <= EndIdx)
    {
        FinalString = Mid(InString, StartIdx, (EndIdx - StartIdx) + 1);
    }
    return FinalString;
    //return ReturnValue;    
}

