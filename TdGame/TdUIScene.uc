function OpenSceneByName(string SceneToOpen, optional Engine.UIScene.ESceneTransitionAnim SceneAnim, optional delegate<OnSceneActivated> SceneDelegate)
{
    local UIScene SceneToOpenReference;

    SceneAnim = 0;
    SceneDelegate = None;
    SceneToOpenReference = UIScene(DynamicLoadObject(SceneToOpen, class'UIScene'));
    // End:0x53
    if(SceneToOpenReference != none)
    {
        OpenScene(SceneToOpenReference, SceneAnim, SceneDelegate);
    }
    //return;    
}

function UIScene OpenScene(UIScene SceneToOpen, optional Engine.UIScene.ESceneTransitionAnim SceneAnim, optional delegate<OnSceneActivated> SceneDelegate)
{
    local bool bOpenNow;
    local UIScene OpenedScene;

    SceneAnim = 0;
    SceneDelegate = None;
    bOpenNow = true;
    __OnSceneOpened__Delegate = SceneDelegate;
    SceneTransitionAnim = SceneAnim;
    // End:0xF2
    if((((SceneTransitionAnim == 0) || SceneTransitionAnim == 1) && SceneToOpen != none) && !SceneToOpen.bRenderParentScenes || bAlwaysRenderScene)
    {
        // End:0xF2
        if(!bRenderParentScenes)
        {
            // End:0xF2
            if(BeginHideAnimation(false))
            {
                // End:0xBD
                if(SceneInputMode != 0)
                {
                    GetTdInteraction().BlockUIInput(true);
                }
                __PrivateOnHideAnimationEnded__Delegate = OnCurrentScene_HideAnimationEnded;
                SceneAnimStepPos = SceneAnimDuration;
                bHidingScene = true;
                PendingOpenScene = SceneToOpen;
                bOpenNow = false;
            }
        }
    }
    // End:0x110
    if(bOpenNow)
    {
        OpenedScene = FinishOpenScene(SceneToOpen);
    }
    return OpenedScene;
    //return ReturnValue;    
}

function OnCurrentScene_HideAnimationEnded()
{
    FinishOpenScene(PendingOpenScene);
    //return;    
}

function UIScene FinishOpenScene(UIScene SceneToOpen)
{
    local UIScene OpenedScene;
    local TdUIScene OpenedTdScene;
    local UIInteraction UIController;
    local GameUISceneClient GameSceneClient;
    local TdUIScene TdSceneToOpen;

    TdSceneToOpen = TdUIScene(SceneToOpen);
    // End:0x4D
    if(TdSceneToOpen != none)
    {
        TdSceneToOpen.__PrivateOnHideAnimationEnded__Delegate = None;
        TdSceneToOpen.__PrivateOnShowAnimationEnded__Delegate = None;
    }
    PendingOpenScene = none;
    __PrivateOnHideAnimationEnded__Delegate = None;
    OpenedScene = none;
    UIController = GetCurrentUIController();
    // End:0x204
    if((SceneToOpen != none) && UIController != none)
    {
        GameSceneClient = UIController.SceneClient;
        // End:0x117
        if(GameSceneClient != none)
        {
            GameSceneClient.InitializeScene(SceneToOpen, PlayerOwner, OpenedScene);
            // End:0x117
            if(OpenedScene != none)
            {
                // End:0xF8
                if(__OnSceneOpened__Delegate != none)
                {
                    OpenedScene.__OnSceneActivated__Delegate = __OnSceneOpened__Delegate;
                }
                GameSceneClient.OpenScene(OpenedScene, PlayerOwner, OpenedScene);
            }
        }
        OpenedTdScene = TdUIScene(OpenedScene);
        // End:0x204
        if(OpenedTdScene != none)
        {
            // End:0x1E6
            if((((SceneTransitionAnim == 0) || SceneTransitionAnim == 2) && !OpenedTdScene.bRenderParentScenes || bAlwaysRenderScene) && OpenedTdScene.BeginShowAnimation(true))
            {
                // End:0x1BC
                if(OpenedTdScene.SceneInputMode != 0)
                {
                    GetTdInteraction().BlockUIInput(true);
                }
                OpenedTdScene.bShowingScene = true;
                OpenedTdScene.SceneAnimStepPos = 0.0;
            }
            // End:0x204
            else
            {
                OpenedTdScene.OnSceneFullyOpened(OpenedTdScene);
            }
        }
    }
    __OnSceneOpened__Delegate = None;
    return OpenedScene;
    //return ReturnValue;    
}

function bool CloseScene(UIScene SceneToClose, optional bool bSkipKismetNotify, optional Engine.UIScene.ESceneTransitionAnim SceneAnim)
{
    local TdUIScene TdSceneToClose;
    local bool bResult;

    SceneAnim = 0;
    SceneTransitionAnim = SceneAnim;
    // End:0x15A
    if(SceneToClose.IsSceneActive())
    {
        TdSceneToClose = TdUIScene(SceneToClose);
        // End:0x143
        if((((TdSceneToClose != none) && (SceneTransitionAnim == 0) || SceneTransitionAnim == 1) && !TdSceneToClose.bRenderParentScenes || TdSceneToClose.GetPreviousScene().bAlwaysRenderScene) && TdSceneToClose.BeginHideAnimation(true))
        {
            // End:0xE3
            if(TdSceneToClose.SceneInputMode != 0)
            {
                GetTdInteraction().BlockUIInput(true);
            }
            TdSceneToClose.SceneAnimStepPos = SceneAnimDuration;
            TdSceneToClose.bHidingScene = true;
            TdSceneToClose.__PrivateOnHideAnimationEnded__Delegate = OnPendingCloseScene_HideAnimationEnded;
            TdSceneToClose.PendingCloseScene = TdSceneToClose;
            bResult = false;
        }
        // End:0x15A
        else
        {
            FinishCloseScene(SceneToClose);
            bResult = true;
        }
    }
    return bResult;
    //return ReturnValue;    
}

function OnPendingCloseScene_HideAnimationEnded()
{
    FinishCloseScene(PendingCloseScene);
    //return;    
}

function FinishCloseScene(UIScene SceneToClose)
{
    local TdUIScene TdSceneToClose, TopScene;

    TdSceneToClose = TdUIScene(SceneToClose);
    // End:0x46
    if(TdSceneToClose != none)
    {
        TdSceneToClose.bHidingScene = false;
        TdSceneToClose.__PrivateOnHideAnimationEnded__Delegate = None;
    }
    PendingCloseScene = none;
    // End:0x155
    if(SceneToClose != none)
    {
        TopScene = TdUIScene(SceneToClose.GetPreviousScene());
        SceneClient.CloseScene(SceneToClose);
        // End:0x155
        if(((TopScene != none) && !SceneToClose.bRenderParentScenes) && !TopScene.bAlwaysRenderScene)
        {
            // End:0x155
            if(((SceneTransitionAnim == 0) || SceneTransitionAnim == 2) && TopScene.BeginShowAnimation(false))
            {
                // End:0x12E
                if(TopScene.SceneInputMode != 0)
                {
                    GetTdInteraction().BlockUIInput(true);
                }
                TopScene.bShowingScene = true;
                TopScene.SceneAnimStepPos = 0.0;
            }
        }
    }
    //return;    
}

final function bool BeginShowAnimation(optional bool bInitialActivation)
{
    bInitialActivation = true;
    return false;
    //return ReturnValue;    
}

final function bool BeginHideAnimation(optional bool bClosingScene)
{
    bClosingScene = false;
    return false;
    //return ReturnValue;    
}

function AnimEnd(UIObject AnimTarget, int AnimIndex, UIAnimationSeq AnimSeq)
{
    // End:0x23
    if(bHidingScene)
    {
        bHidingScene = false;
        PrivateOnHideAnimationEnded();
    }
    // End:0x5E
    else
    {
        // End:0x5E
        if(bShowingScene)
        {
            bShowingScene = false;
            PrivateOnShowAnimationEnded();
            // End:0x5E
            if(__OnSceneFullyOpened__Delegate != none)
            {
                OnSceneFullyOpened(self);
            }
        }
    }
    //return;    
}

function SceneAnimEnded()
{
    // End:0x69
    if(bHidingScene)
    {
        bHidingScene = false;
        GetTdHUD().EffectManager.SetUIBlurEnabled(false);
        // End:0x57
        if(SceneInputMode != 0)
        {
            GetTdInteraction().BlockUIInput(false);
        }
        PrivateOnHideAnimationEnded();
    }
    // End:0xFF
    else
    {
        // End:0xFF
        if(bShowingScene)
        {
            bShowingScene = false;
            GetTdHUD().EffectManager.SetUIBlurEnabled(false);
            // End:0xC0
            if(SceneInputMode != 0)
            {
                GetTdInteraction().BlockUIInput(false);
            }
            PrivateOnShowAnimationEnded();
            // End:0xFF
            if(__OnSceneFullyOpened__Delegate != none && !bHasBeenShown)
            {
                bHasBeenShown = true;
                OnSceneFullyOpened(self);
            }
        }
    }
    //return;    
}

function UpdateSceneAnimVis()
{
    local float T, Value;

    T = SceneAnimStepPos / SceneAnimDuration;
    Value = Lerp(1.0, 0.0, T);
    GetTdHUD().EffectManager.SetUIBlur(Value);
    //return;    
}

function SetAnimatingScene(bool bShowing)
{
    bShowingScene = bShowing;
    bHidingScene = !bShowing;
    //return;    
}

function bool IsAnimatingScene()
{
    return bShowingScene || bHidingScene;
    //return ReturnValue;    
}

