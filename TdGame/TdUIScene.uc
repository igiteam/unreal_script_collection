function ShowFriendsScene(optional Engine.UIScene.ESceneTransitionAnim SceneAnim)
{
    SceneAnim = 0;
    // End:0x59
    if(IsConsole())
    {
        // End:0x56
        if(!GetPlayerInterface().ShowFriendsUI(byte(GetPlayerOwner().ControllerId)))
        {
            OpenMessageBox(OnInitMessageBox_ShowFriendsScene);
        }
    }
    // End:0xA7
    else
    {
        // End:0xA7
        if(GetPlayerInterface().GetLoginStatus(byte(PlayerOwner.ControllerId)) == 2)
        {
            OpenFriendsScene(OnInitMessageBox_ShowFriendsScene, SceneAnim);
        }
    }
    //return;    
}

function OnInitMessageBox_ShowFriendsScene(UIScene OpenedScene, bool bInitialActivation)
{
    local string NoFriendsUI_Title, NoFriendsUI_Message;

    // End:0x4E
    if(IsConsole(1))
    {
        NoFriendsUI_Message = Localize("TdMainMenu", "NoFriendsUI_Message_XBOX", "TdGameUI");
    }
    // End:0x8D
    else
    {
        NoFriendsUI_Message = Localize("TdMainMenu", "NoFriendsUI_Message_PS3", "TdGameUI");
    }
    NoFriendsUI_Title = Localize("TdMainMenu", "NoFriendsUI_Title", "TdGameUI");
    TdUIScene_MessageBox(OpenedScene).DisplayAcceptBox(NoFriendsUI_Message, NoFriendsUI_Title);
    //return;    
}

