function ViewGamerCard(UniqueNetId TargetPlayerId)
{
    GamerCardNetId = TargetPlayerId;
    OpenMessageBox(OnViewGamerCardMessageBoxInit);
    //return;    
}

function OnViewGamerCardMessageBoxInit(UIScene OpenedScene, bool bInitialActivation)
{
    local string Message, Title;

    // End:0x52
    if(IsConsole(1))
    {
        Message = "<Strings:TdGameUI.TdMessageBox.LoadingGamerCard_MessageXbox>";
    }
    // End:0x95
    else
    {
        Message = "<Strings:TdGameUI.TdMessageBox.LoadingGamerCard_MessagePs3>";
    }
    Title = "<Strings:TdGameUI.TdMessageBox.LoadingGamerCard_Title>";
    LoadingGamerCardMessageBox = TdUIScene_MessageBox(OpenedScene);
    LoadingGamerCardMessageBox.DisplayCancelBox(Message, Title);
    LoadingGamerCardMessageBox.__OnNotifyOptionSelected__Delegate = OnViewGamerCardMessageBoxPressed;
    LoadingGamerCardMessageBox.__OnSceneFullyOpened__Delegate = OnViewGamerCardMessageBoxFullyOpened;
    //return;    
}

private final function OnViewGamerCardMessageBoxFullyOpened(UIScene OpenedScene)
{
    GetPlayerInterfaceEx().AddShowGamerCardResultDelegate(OnViewGamerCard);
    // End:0x62
    if(GetPlayerInterfaceEx().ShowGamerCardUI(byte(GetPlayerOwner().ControllerId), GamerCardNetId) == false)
    {
        OnViewGamerCard(false);
    }
    //return;    
}

private final function OnViewGamerCard(bool bWasSuccessful)
{
    // End:0x23
    if(bWasSuccessful)
    {
        LoadingGamerCardMessageBox.Close();
    }
    // End:0x65
    else
    {
        LoadingGamerCardMessageBox.SceneTransitionAnimOveride = 1;
        LoadingGamerCardMessageBox.__OnClosed__Delegate = ShowGamerCardFailedMessage;
        LoadingGamerCardMessageBox.Close();
    }
    GetPlayerInterfaceEx().ClearShowGamerCardResultDelegate(OnViewGamerCard);
    //return;    
}

private final function OnViewGamerCardMessageBoxPressed(TdUIScene_MessageBox MessageBox, int SelectedOption, int PlayerIndex)
{
    GetPlayerInterfaceEx().CancelShowGamerCardUI();
    //return;    
}

private final function ShowGamerCardFailedMessage()
{
    OpenMessageBox(ShowGamerCardFailedMessage_Init, 2);
    //return;    
}

private final function ShowGamerCardFailedMessage_Init(UIScene OpenedScene, bool bInitialActivation)
{
    local TdUIScene_MessageBox MessageScene;
    local string Message, Title;

    // End:0x57
    if(IsConsole(1))
    {
        Message = "<Strings:TdGameUI.TdMessageBox.LoadingGamerCardError_MessageXbox>";
    }
    // End:0x9F
    else
    {
        Message = "<Strings:TdGameUI.TdMessageBox.LoadingGamerCardError_MessagePs3>";
    }
    Title = "<Strings:TdGameUI.TdMessageBox.LoadingGamerCardError_Title>";
    MessageScene = TdUIScene_MessageBox(OpenedScene);
    MessageScene.DisplayAcceptBox(Message, Title);
    //return;    
}

function ViewXBoxAchievements()
{
    // End:0x46
    if(!GetPlayerInterfaceEx().ShowAchievementsUI(byte(GetPlayerOwner().ControllerId)))
    {
        OpenMessageBox(OnViewXBoxAchievements_MsgBoxInit);
    }
    //return;    
}

function OnViewXBoxAchievements_MsgBoxInit(UIScene OpenedScene, bool bInitialActivation)
{
    local string AchievementsFailed_Title, AchievementsFailed_Message;

    AchievementsFailed_Title = Localize("TdMainMenu", "AchievementsFailed_Title", "TdGameUI");
    AchievementsFailed_Message = Localize("TdMainMenu", "AchievementsFailed_Message", "TdGameUI");
    TdUIScene_MessageBox(OpenedScene).DisplayAcceptBox(AchievementsFailed_Message, AchievementsFailed_Title);
    //return;    
}

