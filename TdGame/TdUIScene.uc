function TdProfileSettings GetProfileSettings(optional int PlayerIndex)
{
    local LocalPlayer LP;
    local TdProfileSettings ProfileSettings;

    PlayerIndex = GetBestPlayerIndex();
    LP = GetPlayerOwner(PlayerIndex);
    // End:0x75
    if((LP != none) && LP.Actor != none)
    {
        ProfileSettings = TdProfileSettings(LP.Actor.OnlinePlayerData.ProfileProvider.Profile);
    }
    return ProfileSettings;
    //return ReturnValue;    
}

event bool IsControllerInput(name KeyName)
{
    local bool bResult;
    local array<name> Keys;
    local int KeyIdx;

    Keys.Length = 24;
    Keys[0] = 'XboxTypeS_LeftThumbstick';
    Keys[1] = 'XboxTypeS_RightThumbstick';
    Keys[2] = 'XboxTypeS_Back';
    Keys[3] = 'XboxTypeS_Start';
    Keys[4] = 'XboxTypeS_A';
    Keys[5] = 'XboxTypeS_B';
    Keys[6] = 'XboxTypeS_X';
    Keys[7] = 'XboxTypeS_Y';
    Keys[8] = 'XboxTypeS_LeftShoulder';
    Keys[9] = 'XboxTypeS_RightShoulder';
    Keys[10] = 'XboxTypeS_LeftTrigger';
    Keys[11] = 'XboxTypeS_RightTrigger';
    Keys[12] = 'XboxTypeS_DPad_Up';
    Keys[13] = 'XboxTypeS_DPad_Down';
    Keys[14] = 'XboxTypeS_DPad_Right';
    Keys[15] = 'XboxTypeS_DPad_Left';
    Keys[16] = 'Gamepad_LeftStick_Up';
    Keys[17] = 'Gamepad_LeftStick_Down';
    Keys[18] = 'Gamepad_LeftStick_Right';
    Keys[19] = 'Gamepad_LeftStick_Left';
    Keys[20] = 'Gamepad_RightStick_Up';
    Keys[21] = 'Gamepad_RightStick_Down';
    Keys[22] = 'Gamepad_RightStick_Right';
    Keys[23] = 'Gamepad_RightStick_Left';
    KeyIdx = 0;
    J0x1BE:
    // End:0x1F8 [Loop If]
    if(KeyIdx < Keys.Length)
    {
        // End:0x1EE
        if(KeyName == Keys[KeyIdx])
        {
            bResult = true;
            // [Explicit Break]
            goto J0x1F8;
        }
        ++ KeyIdx;
        J0x1F8:
        // [Loop Continue]
        goto J0x1BE;
    }
    return bResult;
    //return ReturnValue;    
}

function int GetPlayerControllerId(int PlayerIndex)
{
    return GetCurrentUIController().super(TdUIScene).GetPlayerControllerId(PlayerIndex);
    //return ReturnValue;    
}

function bool HandleInputKey(const out InputEventParameters EventParms)
{
    return false;
    //return ReturnValue;    
}

event bool PlayInputKeyNotification(const out InputEventParameters EventParms)
{
    local bool bResult;

    super.PlayInputKeyNotification(EventParms);
    // End:0x133
    if(EventParms.EventType == 1)
    {
        // End:0xCE
        if((((EventParms.InputKeyName == 'XboxTypeS_A') || EventParms.InputKeyName == 'XboxTypeS_X') || EventParms.InputKeyName == 'XboxTypeS_Y') || EventParms.InputKeyName == 'Enter')
        {
            PlayUISound('Accept', EventParms.PlayerIndex);
            bResult = true;
        }
        // End:0x133
        else
        {
            // End:0x133
            if((EventParms.InputKeyName == 'XboxTypeS_B') || EventParms.InputKeyName == 'Escape')
            {
                PlayUISound('Cancel', EventParms.PlayerIndex);
                bResult = true;
            }
        }
    }
    return bResult;
    //return ReturnValue;    
}

function NotifyOnlineServiceStatusChanged(Engine.OnlineSubsystem.EOnlineServerConnectionStatus NewConnectionStatus)
{
    super.NotifyOnlineServiceStatusChanged(NewConnectionStatus);
    // End:0x30
    if((NewConnectionStatus != 1) && bRequiresOnlineService)
    {
        SceneAnimEnded();
    }
    //return;    
}

