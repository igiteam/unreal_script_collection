simulated function StartMove()
{
    super.StartMove();
    // End:0x26
    if(BotOwner != none)
    {
        BotOwner.UseLegRotation(false);
    }
    // End:0x4A
    if(bForceWalkingStateToIdle)
    {
        BotOwner.SetOverrideWalkingState(0, BlendInTime);
    }
    StartAnimation();
    //return;    
}

simulated function StopMove()
{
    AnimationName = 'None';
    CurrentCustomAnimName = 'None';
    super.StopMove();
    BotOwner.SetOverrideWalkingState(6);
    // End:0x5B
    if(BotOwner != none)
    {
        BotOwner.UseLegRotation(true);
    }
    //return;    
}

simulated function StartAnimation()
{
    PawnOwner.UseRootMotion(bUseRootMotion);
    PawnOwner.UseRootRotation(bUseRootRotation);
    PawnOwner.PlayCustomAnim(0, AnimationName, PlayRate, BlendInTime, BlendOutTime, bLoop, true, bUseRootMotion, bUseRootRotation);
    CurrentCustomAnimName = AnimationName;
    //return;    
}

simulated function OnCustomAnimEnd(AnimNodeSequence SeqNode, float PlayedTime, float ExcessTime)
{
    // End:0x0B
    if(bLoop)
