function bool ResolveSubObjectiveMapping(name MappingName, out name SubObjectiveName)
{
    local bool bResult;
    local int PairIndex;

    PairIndex = 0;
    J0x07:
    // End:0x68 [Loop If]
    if(PairIndex < ObjectiveMappings.Length)
    {
        // End:0x5E
        if(ObjectiveMappings[PairIndex].MappingName == MappingName)
        {
            SubObjectiveName = ObjectiveMappings[PairIndex].SubObjectiveName;
            bResult = true;
            // [Explicit Break]
            goto J0x68;
        }
        ++ PairIndex;
        J0x68:
        // [Loop Continue]
        goto J0x07;
    }
    return bResult;
    //return ReturnValue;    
}

