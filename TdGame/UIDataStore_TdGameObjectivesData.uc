function ResolveAndSetCheckpointObjective(name ObjectiveGameType, name CheckpointName, optional bool bOnlyHigher)
{
    local name SubObjectiveName;

    // End:0x32
    if(ResolveSubObjectiveMapping(CheckpointName, SubObjectiveName))
    {
        SetActiveSubObjective(ObjectiveGameType, SubObjectiveName, bOnlyHigher);
    }
    //return;    
}

