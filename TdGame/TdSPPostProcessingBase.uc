function ProcessRace(TdTTInput RaceInput, int InStretchId, delegate<OnPostProcessDone> PostProcessDone)
{
    local DataStoreClient DataStoreManager;
    local UIInteraction UIController;

    __OnPostProcessDone__Delegate = PostProcessDone;
    StretchId = InStretchId;
    UIController = class'UIRoot'.static.GetCurrentUIController();
    ControllerId = UIController.Outer.Outer.GamePlayers[0].ControllerId;
    PlayerName = Outer.OnlineSub.PlayerInterface.GetPlayerNickname(byte(ControllerId));
    Outer.OnlineSub.PlayerInterface.GetUniquePlayerId(byte(ControllerId), PlayerId);
    InputToProcess = RaceInput;
    DataStoreManager = class'UIInteraction'.static.GetDataStoreClient();
    // End:0x12A
    if((TTDataStore == none) && DataStoreManager != none)
    {
        TTDataStore = UIDataStore_TdTimeTrialData(DataStoreManager.FindDataStore('TdTimeTrialData'));
    }
    //return;    
}

protected function UpdateOnlineStats(TdTTInput TTOnlineInput, bool bOnlyAllTime, optional int InGhostTag)
{
    local TdLeaderboardWriteSPTT Stats;
    local int Idx;
    local UniqueNetId ZeroPlayerID;

    Stats = TdLeaderboardWriteSPTT(new Outer.OnlineStatsWriteClass);
    Stats.PeriodFlags.bIndefinite = WasNewRecord(TTOnlineInput.PlayerBest.TotalTime, TotalTime);
    // End:0xE4
    if(!bOnlyAllTime)
    {
        Stats.PeriodFlags.bMonthly = WasNewRecord(TTOnlineInput.PlayerMonthlyBest, TotalTime);
        Stats.PeriodFlags.bWeekly = WasNewRecord(TTOnlineInput.PlayerWeeklyBest, TotalTime);
    }
    // End:0x47F
    if((Stats.PeriodFlags.bWeekly || Stats.PeriodFlags.bMonthly) || Stats.PeriodFlags.bIndefinite)
    {
        Stats.SetStretchId(StretchId);
        Stats.SetFloatStat(20, TotalTime);
        Idx = 0;
        J0x17D:
        // End:0x1BF [Loop If]
        if(Idx < IntermediateTimes.Length)
        {
            Stats.SetFloatStat(21 + Idx, IntermediateTimes[Idx]);
            ++ Idx;
            // [Loop Continue]
            goto J0x17D;
        }
        Stats.SetIntStat(41, InGhostTag);
        Stats.SetFloatStat(43, AverageSpeed);
        Stats.SetFloatStat(44, float(DistanceRun));
        Stats.SetIntStat(19, TotalRating);
        // End:0x333
        if(ZeroPlayerID != PlayerId && !Outer.OnlineSub.StatsInterface.WriteOnlineStats(PlayerId, Stats))
        {
            SetError("<Strings:TdGameUI.TdMessageBox.TimeTrialSaveDataFailed_Title>", "<Strings:TdGameUI.TdMessageBox.TimeTrialSaveDataFailed_Message>" @ class'TpSystemBase'.static.Get().GetLatestError().LocErrorString);
        }
        Outer.OnlineSub.StatsInterface.AddFlushOnlineStatsCompleteDelegate(WriteOnlineStatsCompletedCallback);
        // End:0x47F
        if(!Outer.OnlineSub.StatsInterface.FlushOnlineStats())
        {
            Outer.OnlineSub.StatsInterface.ClearFlushOnlineStatsCompleteDelegate(WriteOnlineStatsCompletedCallback);
            SetError("<Strings:TdGameUI.TdMessageBox.TimeTrialSaveDataFailed_Title>", "<Strings:TdGameUI.TdMessageBox.TimeTrialSaveDataFailed_Message>" @ class'TpSystemBase'.static.Get().GetLatestError().LocErrorString);
        }
    }
    //return;    
}

private final function WriteOnlineStatsCompletedCallback(bool bSuccess)
{
    Outer.OnlineSub.StatsInterface.ClearFlushOnlineStatsCompleteDelegate(WriteOnlineStatsCompletedCallback);
    // End:0x48
    if(bSuccess)
    {
        CloseLoadScene();
    }
    // End:0x102
    else
    {
        SetError("<Strings:TdGameUI.TdMessageBox.TimeTrialSaveDataFailed_Title>", "<Strings:TdGameUI.TdMessageBox.TimeTrialSaveDataFailed_Message>" @ class'TpSystemBase'.static.Get().GetLatestError().LocErrorString);
    }
    //return;    
}

protected function UpdateOfflineStats(TdTTInput TTOfflineInput)
{
    local TdProfileSettings Profile;

    Profile = TdProfileSettings(Outer.OnlineSub.PlayerInterface.GetProfileSettings(byte(ControllerId)));
    Profile.OnTTStretchCompleted(StretchId, TotalTime, IntermediateTimes, AverageSpeed, float(DistanceRun), UnlockedStretch);
    Profile.SetTimeTrialRating(TotalRating);
    Outer.OnlineSub.PlayerInterface.AddWriteProfileSettingsCompleteDelegate(byte(ControllerId), OnProfileWriteComplete);
    // End:0x1EE
    if(!Outer.OnlineSub.PlayerInterface.WriteProfileSettings(byte(ControllerId), Profile))
    {
        Outer.OnlineSub.PlayerInterface.ClearWriteProfileSettingsCompleteDelegate(byte(ControllerId), OnProfileWriteComplete);
        SetError("<Strings:TdGameUI.TdMessageBox.TimeTrialSaveDataFailed_Title>", "<Strings:TdGameUI.TdMessageBox.TimeTrialSaveDataFailed_Message>" @ class'TpSystemBase'.static.Get().GetLatestError().LocErrorString);
    }
    //return;    
}

private final function OnProfileWriteComplete(bool bSuccess)
{
    Outer.OnlineSub.PlayerInterface.ClearWriteProfileSettingsCompleteDelegate(byte(ControllerId), OnProfileWriteComplete);
    // End:0x101
    if(!bSuccess)
    {
        SetError("<Strings:TdGameUI.TdMessageBox.TimeTrialSaveDataFailed_Title>", "<Strings:TdGameUI.TdMessageBox.TimeTrialSaveDataFailed_Message>" @ class'TpSystemBase'.static.Get().GetLatestError().LocErrorString);
    }
    // End:0x129
    else
    {
        // End:0x113
        if(bError)
        {
            ShowErrorMessageBox();
        }
        // End:0x129
        else
        {
            UpdateDataStoreAndResult(InputToProcess, true);
            FinishPostProcessing();
        }
    }
    //return;    
}

