private final function OnShowErrorMessageBox_Init(UIScene OpenedScene, bool bInitialActivation)
{
    ErrorMessageBox = TdUIScene_MessageBox(OpenedScene);
    // End:0x4E
    if(InputToProcess.bIsOnlineInfo)
    {
        ErrorMessageBox.DisplayAcceptCancelRetryBoxOnline(ErrorMessage, ErrorTitle, OnErrorMessageBoxClosed);
    }
    // End:0x76
    else
    {
        ErrorMessageBox.DisplayAcceptCancelRetryBox(ErrorMessage, ErrorTitle, OnErrorMessageBoxClosed);
    }
    //return;    
}

private final function OnErrorMessageBoxClosed(TdUIScene_MessageBox InMessageBox, int SelectedOption, int PlayerIndex)
{
    ErrorMessageBox = none;
    bError = false;
    switch(SelectedOption)
    {
        // End:0x37
        case 1:
            ProcessRace(InputToProcess, StretchId, __OnPostProcessDone__Delegate);
            // End:0x50
            break;
        // End:0xFFFF
        default:
            UpdateDataStoreAndResult(InputToProcess, false);
            FinishPostProcessing();
            //return;
    }    
}

function PPOnlineConnectionLost()
{
    __OnPostProcessDone__Delegate = None;
    Outer.OnlineSub.PlayerInterface.ClearWriteProfileSettingsCompleteDelegate(byte(ControllerId), OnProfileWriteComplete);
    Outer.OnlineSub.StatsInterface.ClearFlushOnlineStatsCompleteDelegate(WriteOnlineStatsCompletedCallback);
    // End:0xE9
    if(LoadIndicator != none)
    {
        LoadIndicator.__OnSceneActivated__Delegate = None;
        LoadIndicator.__OnSceneDeactivated__Delegate = None;
        LoadIndicator.__OnSceneFullyOpened__Delegate = None;
        LoadIndicator.__OnSceneOpened__Delegate = None;
    }
    // End:0x1A3
    if(ErrorMessageBox != none)
    {
        ErrorMessageBox.__OnClosed__Delegate = None;
        ErrorMessageBox.__OnNotifyOptionSelected__Delegate = None;
        ErrorMessageBox.__OnSelection__Delegate = None;
        ErrorMessageBox.__OnSceneActivated__Delegate = None;
        ErrorMessageBox.__OnSceneDeactivated__Delegate = None;
        ErrorMessageBox.__OnSceneFullyOpened__Delegate = None;
        ErrorMessageBox.__OnSceneOpened__Delegate = None;
    }
    //return;    
}
