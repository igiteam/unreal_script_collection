protected final function FinishPostProcessing()
{
    InputToProcess = none;
    OnPostProcessDone(TTResult);
    __OnPostProcessDone__Delegate = None;
    //return;    
}

protected function bool WasNewRecord(float TimeToBeat, float MyTime)
{
    return (TimeToBeat > MyTime) && TimeToBeat > 0.0;
    //return ReturnValue;    
}

protected function float RoundTime(float N)
{
    return float(Round(N * float(100))) * 0.010;
    //return ReturnValue;    
}

protected function ShowLoadScene(delegate<OnSceneFullyOpened> SceneFullyOpened)
{
    local TdGameUISceneClient SceneClient;
    local string LocTitle;
    local UIInteraction UIController;
    local LocalPlayer Player;

    SceneClient = TdGameUISceneClient(class'UIRoot'.static.GetSceneClient());
    // End:0x78
    if(InputToProcess.bIsOnlineInfo)
    {
        LocTitle = Localize("TdModalSaveLoadMessageBox", "SaveTitleTextOnline", "TdGameUI");
    }
    // End:0xFE
    if(LoadIndicator == none)
    {
        UIController = class'UIRoot'.static.GetCurrentUIController();
        // End:0xCF
        if(UIController != none)
        {
            Player = UIController.Outer.Outer.GamePlayers[0];
        }
        SceneClient.OpenLoadingScene(LocTitle, Player, OnShowLoadScene_Init, SceneFullyOpened);
        J0xFE:
    }
    // End:0xFE
    else
    {
    }
    //return;    
}

