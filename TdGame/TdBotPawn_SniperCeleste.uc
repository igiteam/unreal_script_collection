class TdBotPawn_SniperCeleste extends TdBotPawn
    config(AI)
    hidecategories(Navigation);

function PauseFiring()
{
    local float RefireDelay;

    StopFiringWeapon();
    // End:0x37
    if(TdAI_Sniper(myController).IsInState('HoldAndSnipe'))
    {
        RefireDelay = 0.10;
    }
    // End:0x51
    else
    {
        RefireDelay = FRandRange(BurstDelayMin, BurstDelayMax);
    }
    bBurstWait = true;
    SetTimer(RefireDelay, false, 'StartNewBurst');
    //return;    
}

