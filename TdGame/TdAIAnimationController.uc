}

event CoverAnimationOnCustomAnimEnd(AnimNodeSequence SequenceNode, float PlayedTime, float ExcessTime)
{
    SetCoverAnimationSequenceName('None');
    AiPawn.UseRootMotion(false);
    AiPawn.UseRootRotation(false);
    AiPawn.Velocity = vect(0.0, 0.0, 0.0);
    AiPawn.Acceleration = vect(0.0, 0.0, 0.0);
    //return;    
}

function CoverAnimationOnCeaseRelevantRootMotion(AnimNodeSequence SequenceNode)
{
    SetCoverAnimationSequenceName('None');
    AiPawn.UseRootMotion(false);
    AiPawn.UseRootRotation(false);
    AiPawn.Velocity = vect(0.0, 0.0, 0.0);
    AiPawn.Acceleration = vect(0.0, 0.0, 0.0);
    //return;    
}

