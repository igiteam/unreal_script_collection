    //return ReturnValue;    
}

function bool StopCoverAnimation(optional float StopTime)
{
    StopTime = 0.250;
    // End:0x1A
    if(!IsPlayingCoverAnimation())
    {
        return false;
    }
    AiPawn.StopCustomAnim(2, StopTime);
    return true;
    //return ReturnValue;    
}

function AnimNodeSequence GetCoverAnimation()
{
    return AiPawn.GetCustomAnimation(2);
    //return ReturnValue;    
}

function PlayCoverAnimation(TdAIAnimationController.ECoverAnimation CoverAnimation, TdAIAnimationController.ECoverDirectionState CoverAnimationDirectionState, Engine.CoverLink.ECoverType CoverType, optional bool Short)
{
    switch(CoverAnimation)
    {
        // End:0x3E
        case 0:
            StartAimFire(CoverAnimationDirectionState, CoverType);
            self.SetTimer(0.10, false, 'UpdateCoverState');
            // End:0x76
            break;
        // End:0x73
        case 1:
            StopAimFire(CoverAnimationDirectionState, CoverType);
            self.SetTimer(0.10, false, 'UpdateCoverState');
            // End:0x76
            break;
        // End:0xFFFF
        default:
            //return;
    }    
}

