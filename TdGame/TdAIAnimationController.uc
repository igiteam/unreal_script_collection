simulated event bool IsPlayingCoverAnimation()
{
    local AnimNodeSequence AnimationSequence;

    AnimationSequence = AiPawn.GetCustomAnimation(2);
    return (((AnimationSequence != none) && AnimationSequence.AnimSeq != none) && AnimationSequence.AnimSeqName == CoverAnimationSequenceName) && AnimationSequence.bPlaying;
    //return ReturnValue;    
}

