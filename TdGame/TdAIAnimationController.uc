function StartAimFire(TdAIAnimationController.ECoverDirectionState CoverAnimationDirectionState, Engine.CoverLink.ECoverType CoverType)
{
    // End:0x24
    if((CoverAnimationDirectionState == 0) || CoverType == 0)
    {
        return;
    }
    // End:0xAA
    if(CoverAnimationDirectionState == 1)
    {
        SetCoverAnimationSequenceName('CoverLeftIntoFireCrouch');
        AiPawn.PlayCustomAnim(2, CoverAnimationSequenceName, 1.0, 0.0, 0.0, false, true, true, true);
        AiPawn.UseRootMotion(true);
        AiPawn.UseRootRotation(true);
        CoverDirection = 1;
    }
    // End:0x19E
    else
    {
        // End:0x130
        if(CoverAnimationDirectionState == 2)
        {
            SetCoverAnimationSequenceName('CoverRightIntoFireCrouch');
            AiPawn.PlayCustomAnim(2, CoverAnimationSequenceName, 1.0, 0.0, 0.0, false, true, true, true);
            AiPawn.UseRootMotion(true);
            AiPawn.UseRootRotation(true);
            CoverDirection = 2;
        }
        // End:0x19E
        else
        {
            // End:0x19E
            if(CoverAnimationDirectionState == 3)
            {
                SetCoverAnimationSequenceName('CoverStillCrouchIntoStand');
                AiPawn.PlayCustomAnim(2, CoverAnimationSequenceName, 1.0, 0.0, 0.0, false, true, true, false);
                AiPawn.UseRootMotion(true);
                CoverDirection = 3;
            }
        }
    }
    SetPendingCoverState(2);
    //return;    
}

function StopAimFire(TdAIAnimationController.ECoverDirectionState CoverAnimationDirectionState, Engine.CoverLink.ECoverType CoverType)
{
    // End:0x24
    if((CoverAnimationDirectionState == 0) || CoverType == 0)
    {
        return;
    }
    // End:0xAA
    if(CoverAnimationDirectionState == 1)
    {
        SetCoverAnimationSequenceName('CoverLeftOutOfFireCrouch');
        AiPawn.PlayCustomAnim(2, CoverAnimationSequenceName, 1.0, 0.0, 0.0, false, true, true, true);
        AiPawn.UseRootMotion(true);
        AiPawn.UseRootRotation(true);
        CoverDirection = 1;
    }
    // End:0x19E
    else
    {
        // End:0x130
        if(CoverAnimationDirectionState == 2)
        {
            SetCoverAnimationSequenceName('CoverRightOutOfFireCrouch');
            AiPawn.PlayCustomAnim(2, CoverAnimationSequenceName, 1.0, 0.0, 0.0, false, true, true, true);
            AiPawn.UseRootMotion(true);
            AiPawn.UseRootRotation(true);
            CoverDirection = 2;
        }
        // End:0x19E
        else
        {
            // End:0x19E
            if(CoverAnimationDirectionState == 3)
            {
                SetCoverAnimationSequenceName('CoverStillCrouchOutOfStand');
                AiPawn.PlayCustomAnim(2, CoverAnimationSequenceName, 1.0, 0.0, 0.0, false, true, true, false);
                AiPawn.UseRootMotion(true);
                CoverDirection = 3;
            }
        }
    }
    SetPendingCoverState(1);
    //return;    
}

function name GetFireAnimationName()
{
    switch(CoverDirection)
    {
        // End:0x1A
        case 1:
            return 'CoverLeftFireCrouch';
            // End:0x4B
            break;
        // End:0x2C
        case 2:
            return 'CoverRightFireCrouch';
            // End:0x4B
            break;
        // End:0x3E
        case 3:
            return 'standfire';
            // End:0x4B
            break;
        // End:0xFFFF
        default:
            return 'standfire';
    }
    return 'None';
    //return ReturnValue;    
}

function PlayFireAnimation()
{
    // End:0x1C
    if(AiPawn.CurrentWalkingState == 4)
    {
        return;
    }
    // End:0x65
    if(AIController.IsInCover)
    {
        AiPawn.PlayCustomAnim(7, GetFireAnimationName(), 1.0, 0.0, 0.10, false, true, false, false);
    }
    // End:0xF8
    else
    {
        // End:0xC6
        if((AiPawn.CurrentWalkingState == 2) || AnimationState == 1)
        {
            AiPawn.PlayCustomAnim(7, 'standfire', 1.0, 0.060, 0.10, false, true, false, false);
        }
        // End:0xF8
        else
        {
            AiPawn.PlayCustomAnim(4, 'standfire', 1.0, 0.060, 0.10, false, true, false, false);
        }
    }
    //return;    
}

function PlayReloadAnimation()
{
    ReloadPlaybackRate = RandRange(0.750, 1.250);
    AiPawn.PlayCustomAnim(4, 'Reload', ReloadPlaybackRate, 0.20, 0.20, false, true, false, false);
    //return;    
}

function float GetReloadPlaybackRate()
{
    return ReloadPlaybackRate;
    //return ReturnValue;    
}

function PlayCustomCannedAnimation(name AnimationName)
{
    AiPawn.PlayCustomAnim(0, AnimationName, 1.0, 0.0, 0.20, false, true, false, false);
    //return;    
}

function PlayFaceAnimation(name AnimName, optional bool bLooping)
{
    bLooping = false;
    AiPawn.PlayFaceAnimation(AnimName, bLooping);
    //return;    
}

function StopFaceAnimation()
{
    AiPawn.StopFaceAnimation();
    //return;    
}

function AnimNodeAimOffset GetActiveAimNode()
{
    local AnimNode Node;
    local AnimNodeAimOffset AimNode;

    // End:0x65
    foreach AiPawn.Mesh.AllAnimNodes(class'AnimNode', Node)
    {
        AimNode = AnimNodeAimOffset(Node);
        // End:0x64
        if((AimNode != none) && AimNode.NodeTotalWeight > 0.10)
        {            
            return AimNode;
        }        
    }    
    return none;
    //return ReturnValue;    
}

function SetAimState(TdAIAnimationController.EAimState iAimState, float BlendTime, bool bInstantRotationUpdate)
{
    // End:0x15
    if(iAimState == AimState)
    {
        return;
    }
    AimState = iAimState;
    AimStateBlendValue = BlendTime;
    // End:0x46
    if(iAimState != 1)
    {
        bPendingLegRotationState = false;
    }
    // End:0x4E
    else
    {
        bPendingLegRotationState = true;
    }
    // End:0x75
    if((BlendTime == 0.0) || bInstantRotationUpdate)
    {
        UpdateLegRotation();
    }
    // End:0x98
    else
    {
        ClearTimer('UpdateLegRotation');
        SetTimer(BlendTime, false, 'UpdateLegRotation');
    }
    //return;    
}

function UpdateLegRotation()
{
    AiPawn.UseLegRotation(bPendingLegRotationState);
    //return;    
}

function bool CanFireWeapon()
{
    return !IsBusyCrouching();
    //return ReturnValue;    
}

private final function bool IsWalking()
{
    return ((AiPawn.MovementState == 1) || AiPawn.MovementState == 42) || AiPawn.MovementState == 41;
    //return ReturnValue;    
}

function TimerSetUseLazySpring()
{
    bUseLazySpring = bPendingLazySpringState;
    //return;    
}

function SetUseLazySpring(bool bUse, optional float Time)
{
    // End:0x20
    if(Time == 0.0)
    {
        bUseLazySpring = bUse;
    }
    // End:0x50
    else
    {
        bPendingLazySpringState = bUse;
        ClearTimer('TimerSetUseLazySpring');
        SetTimer(Time, false, 'TimerSetUseLazySpring');
    }
    //return;    
}

function OnCoverEntered()
{
    bIsInCover = true;
    //return;    
}

function OnCoverExited()
{
    bIsInCover = false;
    //return;    
}

function ResetAnimationState()
{
    AnimationState = 0;
    ClearTimer('OnSetMelee');
    ClearTimer('OnReleaseMelee');
    ClearTimer('OnSetCrouch');
    ClearTimer('OnReleaseCrouch');
    //return;    
}

function ClearAnimationState()
{
    switch(AnimationState)
    {
        // End:0x16
        case 1:
            ReleaseCrouchState();
            // End:0x3F
            break;
        // End:0x24
        case 2:
            ReleaseMeleeState();
            // End:0x3F
            break;
        // End:0xFFFF
        default:
            // End:0x3F
            if(AnimationState != 0)
            {
                AnimationState = 0;
            }
            //return;
    }    
}

function SetMeleeState()
{
    // End:0x2B
    if(AiPawn.IsInStateReloading())
    {
        AiPawn.StopReloadAnimation();
    }
    // End:0x59
    if(((AnimationState == 2) || IsBusyMelee()) || !IsWalking())
    {
        return;
    }
    // End:0xD7
    if(AiPawn.HasMeleeTransitionAnimation())
    {
        AiPawn.MyWeapon.StopFiring(0.10);
        AiPawn.PlayCustomAnim(4, 'StandToMeleeStand', 1.0, 0.20, 0.20, false, false, false, false);
        SetTimer(0.250, false, 'OnSetMelee');
    }
    // End:0xDF
    else
    {
        AnimationState = 2;
    }
    //return;    
}

private final function ReleaseMeleeState()
{
    // End:0x21
    if((AnimationState != 2) || IsBusyMelee())
    {
        return;
    }
    // End:0x7C
    if(AiPawn.HasMeleeTransitionAnimation())
    {
        AiPawn.PlayCustomAnim(4, 'StandMeleeToStand', 1.0, 0.20, 0.20, false, false, false, false);
        SetTimer(0.250, false, 'OnReleaseMelee');
    }
    // End:0x84
    else
    {
        AnimationState = 0;
    }
    //return;    
}

private final function OnSetMelee()
{
    AnimationState = 2;
    //return;    
}

private final function OnReleaseMelee()
{
    AnimationState = 0;
    //return;    
}

function SetCrouchState()
{
    // End:0x72
    if(((((AnimationState == 1) || IsBusyCrouching()) || AiPawn.IsInMove(42)) || AiPawn.IsInMove(43)) || AiPawn.IsInMove(41))
    {
        return;
    }
    // End:0xF4
    if(AiPawn.CurrentWalkingState == 0)
    {
        AiPawn.MyWeapon.StopFiring(0.10);
        AiPawn.PlayCustomAnim(2, 'StandIntoCrouch', 1.0, 0.20, 0.20, false, false, false, false);
        SetTimer(0.250, false, 'OnSetCrouch');
    }
    //return;    
}

private final function ReleaseCrouchState()
{
    // End:0x72
    if(((((AnimationState != 1) || IsBusyCrouching()) || AiPawn.IsInMove(42)) || AiPawn.IsInMove(43)) || AiPawn.IsInMove(41))
    {
        return;
    }
    // End:0xF7
    if(AiPawn.CurrentWalkingState == 0)
    {
        AiPawn.MyWeapon.StopFiring(0.10);
        AiPawn.PlayCustomAnim(2, 'CrouchIntoStand', 1.0, 0.20, 0.20, false, false, false, false);
        SetTimer(0.250, false, 'OnReleaseCrouch');
    }
    // End:0xFF
    else
    {
        AnimationState = 0;
    }
    //return;    
}

private final function OnSetCrouch()
{
    AnimationState = 1;
    //return;    
}

private final function OnReleaseCrouch()
{
    AnimationState = 0;
    //return;    
}

defaultproperties
