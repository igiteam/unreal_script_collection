class TdMove_LedgeWalk extends TdPhysicsMove
    native
    config(PawnMovement);

var TdLedgeWalkVolume Volume;
var float CurrentParamOnCurve;
var float StrafeFactor;
var float StrafeSpeed;
var bool bPendingLeavingVolume;

function bool CanDoMove()
{
    switch(PawnOwner.MovementState)
    {
        // End:0x21
        case 1:
            return super(TdMove).CanDoMove();
            // End:0x44
            break;
        // End:0x30
        case 20:
            return super(TdMove).CanDoMove();
            // End:0x44
            break;
        // End:0x3F
        case 29:
            return super(TdMove).CanDoMove();
            // End:0x44
            break;
        // End:0xFFFF
        default:
            return false;
    }
    return super(TdMove).CanDoMove();
    //return ReturnValue;    
}

simulated function StartMove()
{
    local Rotator LookAtAngle;
    local Vector Vel2D;

    super.StartMove();
    // End:0x44
    if(Volume.LedgeWalkType == 1)
    {
        SetCustomCollisionSize(10.0, PawnOwner.default.CylinderComponent.CollisionHeight);
    }
    SetLookAtTargetAngle(rotator(Volume.WallNormal), 0.50, 0.50);
    SetPreciseRotation(rotator(Volume.WallNormal), 0.50);
    StrafeFactor = 0.0;
    LookAtAngle = rotator(Volume.WallNormal);
    Vel2D = Normal(PawnOwner.Velocity);
    Vel2D.Z = 0.0;
    // End:0x126
    if(Volume.LedgeWalkType == 0)
    {
        LookAtAngle.Pitch = MinLookConstraint.Pitch + 7000;
        SetLookAtTargetAngle(LookAtAngle, 0.20);
    }
    // End:0x1C8
    else
    {
        // End:0x176
        if(Volume.WallNormal Cross Vel2D.Z < 0.0)
        {
            LookAtAngle.Yaw += MinLookConstraint.Yaw;
        }
        // End:0x198
        else
        {
            LookAtAngle.Yaw += MaxLookConstraint.Yaw;
        }
        // End:0x1C8
        if(VSize2D(PawnOwner.Velocity) > 50.0)
        {
            SetLookAtTargetAngle(LookAtAngle, 0.20);
        }
    }
    PawnOwner.Velocity = vect(0.0, 0.0, 0.0);
    PawnOwner.Acceleration = vect(0.0, 0.0, 0.0);
    bPendingLeavingVolume = false;
    PlayMoveAnim(2, name("LedgeInto"), 1.0, 0.20, 0.30, false);
    CheckLedgeWalkType();
    //return;    
}

simulated function CheckLedgeWalkType()
{
    // End:0x64
    if(Volume != none)
    {
        switch(Volume.LedgeWalkType)
        {
            // End:0x3B
            case 1:
                MinLookConstraint.Pitch = -6000;
                // End:0x64
                break;
            // End:0x40
            case 0:
            // End:0xFFFF
            default:
                MinLookConstraint.Pitch = default.MinLookConstraint.Pitch;
            }
            //return;            
}

simulated function HandleMoveAction(TdPawn.EMovementAction Action)
{
    super(TdMove).HandleMoveAction(Action);
    // End:0x9D
    if((Action == 1) && Volume.LedgeWalkType == 0)
    {
        // End:0x9B
        if(PawnOwner.Moves[11].CanDoMove())
        {
            PawnOwner.Velocity = vector(PawnOwner.Rotation) * 200.0;
            PawnOwner.SetMove(11);
        }
        return;
    }
    // End:0xCD
    if((Action != 12) && Action != 14)
    {
        StrafeSpeed = 0.0;
    }
    // End:0xF6
    else
    {
        // End:0xEB
        if(Action == 12)
        {
            StrafeSpeed = 80.0;
        }
        // End:0xF6
        else
        {
            StrafeSpeed = -80.0;
        }
    }
    //return;    
}

simulated function UpdateViewRotation(out Rotator out_Rotation, float DeltaTime, out Rotator DeltaRot)
{
    // End:0x64
    if(((DeltaRot.Yaw > 0) || DeltaRot.Yaw < 0) || (DeltaRot.Pitch > 0) || DeltaRot.Pitch < 0)
    {
        AbortLookAtTarget();
    }
    super(TdMove).UpdateViewRotation(out_Rotation, DeltaTime, DeltaRot);
    //return;    
}

simulated function NotifyLeavingVolume()
{
    bPendingLeavingVolume = true;
    SetTimer(0.20);
    //return;    
}

simulated function NotifyEnteringVolume()
{
    bPendingLeavingVolume = false;
    SetPreciseRotation(rotator(Volume.WallNormal), 0.50);
    CheckLedgeWalkType();
    //return;    
}

simulated function OnTimer()
{
    // End:0x21
    if(bPendingLeavingVolume)
    {
        PawnOwner.SetMove(1);
    }
    //return;    
}

simulated function StopMove()
{
    super.StopMove();
    SetCustomCollisionSize(PawnOwner.default.CylinderComponent.CollisionRadius, PawnOwner.default.CylinderComponent.CollisionHeight);
    //return;    
}

function DrawAnimDebugInfo(HUD HUD, out float out_YL, out float out_YPos)
{
    //return;    
}

defaultproperties
{
    ControllerState=PlayerLedgeWalking
    SpeedModifier=0.10
    bConstrainLook=true
    bDisableFaceRotation=true
    bDisableControllerFacingPawnYawRotation=true
    bAvoidLedges=false
    bEnableAgainstWall=true
    MovementGroup=MG_OneHandBusy
    MinLookConstraint=(Pitch=-14000,Yaw=-10000,Roll=-32768)
    MaxLookConstraint=(Pitch=16384,Yaw=10000,Roll=32768)
}