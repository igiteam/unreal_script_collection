class TdWeapon_Heavy extends TdWeapon
    abstract
    config(Weapons)
    hidecategories(Navigation);

function ParticleSystem GetSpecificImpactEffect(TdPhysicalMaterialImpactEffects ImpactEffects)
{
    // End:0x38
    if((Instigator != none) && Instigator.IsA('TdBotPawn_SupportHelicopterGunner'))
    {
        return ImpactEffects.HeliAmmo;
    }
    // End:0x48
    else
    {
        return ImpactEffects.HeavyAmmo;
    }
    //return ReturnValue;    
}

function ParticleSystem GetSpecificImpactEffectPhysX(TdPhysicalMaterialImpactEffects ImpactEffects)
{
    // End:0x42
    if((Instigator != none) && Instigator.IsA('TdBotPawn_SupportHelicopterGunner'))
    {
        return ImpactEffects.HeliAmmoPhysX.Template;
    }
    // End:0x5C
    else
    {
        return ImpactEffects.HeavyAmmoPhysX.Template;
    }
    //return ReturnValue;    
}

