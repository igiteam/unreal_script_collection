function bool CanDoMove()
{
    // End:0x0D
    if(PawnOwner == none)
    {
        return false;
    }
    // End:0x4A
    if((LastStopMoveTime > 0.0) && RedoMoveTime > (PawnOwner.WorldInfo.TimeSeconds - LastStopMoveTime))
    {
        return false;
    }
    // End:0x66
    if(PawnOwner.IsInState('Dying'))
    {
        return false;
    }
    LastCanDoMoveTime = PawnOwner.WorldInfo.TimeSeconds;
    return true;
    //return ReturnValue;    
}

event bool OnCanDoMove()
{
    return CanDoMove();
    //return ReturnValue;    
}

function bool CanStopMove()
{
    return true;
    //return ReturnValue;    
}

simulated function StartMove()
{
    local TdPlayerController PC;
    local TdPlayerPawn PlayerPawn;

    MoveActiveTime = 0.0;
    PlayerPawn = TdPlayerPawn(PawnOwner);
    // End:0x95
    if(PlayerPawn != none)
    {
        PlayerPawn.SetFirstPersonDPG(FirstPersonDPG);
        PlayerPawn.SetFirstPersonLowerBodyDPG(FirstPersonLowerBodyDPG);
        // End:0x81
        if(IsThisMoveStringable())
        {
            PlayerPawn.StartStringableMove(Class);
        }
        // End:0x95
        else
        {
            PlayerPawn.StartUnStringableMove();
        }
    }
    PC = TdPlayerController(PawnOwner.Controller);
    PawnOwner.SetIgnoreMoveInput(DisableMovementTime);
    PawnOwner.SetIgnoreLookInput(DisableLookTime);
    // End:0x184
    if(((PC != none) && PawnOwner.Weapon != none) && (PawnOwner.Weapon.IsA('TdWeapon_Light') && MovementGroup >= 2) || PawnOwner.Weapon.IsA('TdWeapon_Heavy') && MovementGroup >= 1)
    {
        PC.StopFire();
    }
    // End:0x1C5
    if(((PC != none) && PawnOwner.Weapon != none) && bShouldUnzoom)
    {
        PC.UnZoom();
    }
    // End:0x20B
    if(((AimMode == 3) && bShouldHolsterWeapon) && PawnOwner.Weapon != none)
    {
        PawnOwner.SetUnarmed();
    }
    // End:0x224
    if(bDisableActorCollision)
    {
        PawnOwner.SetCollision(true, false);
    }
    // End:0x25E
    if(bDisableCollision)
    {
        PawnOwner.SetCollision(PawnOwner.bCollideActors, false);
        PawnOwner.bCollideWorld = false;
    }
    // End:0x2A4
    if(bUseCustomCollision && !PawnOwner.Moves[PawnOwner.OldMovementState].bUseCustomCollision)
    {
        ShrinkCollision();
    }
    PawnOwner.SetRootOffset(RootOffset, 0.30);
    SetSwanNeckConstraints(SwanNeckEnableAtPitch, SwanNeckForward, SwanNeckDown);
    // End:0x2FC
    if(BotOwner != none)
    {
        BotOwner.UseLegRotation(true);
    }
    // End:0x32C
    if((PC != none) && !CanUseLookAtHint())
    {
        PC.LookAtRelease();
    }
    //return;    
}

simulated function ResetMove()
{
    LastCanDoMoveTime = default.LastCanDoMoveTime;
    LastStopMoveTime = default.LastStopMoveTime;
    MoveActiveTime = default.MoveActiveTime;
    //return;    
}

simulated function SetSwanNeckConstraints(int TriggerAtPitchThreshold, float ForwardMotion, float DownwardMotion)
{
    // End:0x74
    if(PawnOwner.SwanNeck1p != none)
    {
        PawnOwner.SwanNeck1p.StartTranslateAtDegree = float(TriggerAtPitchThreshold);
        PawnOwner.SwanNeck1p.QuadraticForwardTranslation = ForwardMotion;
        PawnOwner.SwanNeck1p.QuadraticDownwardTranslation = DownwardMotion;
    }
    //return;    
}

function CheckForCameraCollision(Vector CameraLocation, Rotator CameraRotation)
{
    local Vector HitLocation, HitNormal, TraceEnd, TraceStart, TraceExtent, MeshOffset;

    TraceStart = CameraLocation - (vector(PawnOwner.Rotation) * 5.0);
    TraceEnd = CameraLocation + (vector(PawnOwner.Rotation) * 11.0);
    TraceExtent = vect(2.0, 2.0, 2.0);
    // End:0xBE
    if(MovementTraceForBlockingEx(TraceEnd, TraceStart, TraceExtent, HitLocation, HitNormal))
    {
        MeshOffset.X = -VSize2D(TraceEnd - HitLocation);
        PawnOwner.OffsetMeshXY(MeshOffset, false);
    }
    //return;    
}

simulated function StopMove()
{
    local name FuncName;

    PawnOwner.StopIgnoreLookInput();
    PawnOwner.StopIgnoreMoveInput();
    // End:0x62
    if(bDisableCollision)
    {
        PawnOwner.SetCollision(PawnOwner.bCollideActors, true);
        PawnOwner.bCollideWorld = true;
    }
    // End:0x8A
    if(bDisableActorCollision)
    {
        PawnOwner.SetCollision(PawnOwner.bCollideActors, true);
    }
    // End:0xD0
    if(bUseCustomCollision && !PawnOwner.Moves[PawnOwner.PendingMovementState].bUseCustomCollision)
    {
        EnlargeCollision();
    }
    PawnOwner.UseRootMotion(false);
    PawnOwner.UseRootRotation(false);
    bUsePreciseLocation = false;
    bUsePreciseRotation = false;
    LastStopMoveTime = PawnOwner.WorldInfo.TimeSeconds;
    // End:0x164
    if((AimMode == 3) && PawnOwner.Weapon != none)
    {
        PawnOwner.SetArmed();
    }
    // End:0x1A0
    if(bTwoHandedFullBodyAnimations && PawnOwner.GetWeaponType() == 1)
    {
        PawnOwner.SetWeaponAnimState(2);
    }
    // End:0x1BA
    if(bLookAtTargetAngle || bLookAtTargetLocation)
    {
        AbortLookAtTarget();
    }
    bResetCameraLook = false;
    RootOffset = default.RootOffset;
    PawnOwner.SetRootOffset(vect(0.0, 0.0, 0.0), 0.30);
    PawnOwner.ClearAnimationMovementState();
    ClearTimer();
    // End:0x239
    foreach TimerFunctions(FuncName,)
    {
        PawnOwner.ClearTimer(FuncName, self);        
    }    
    TimerFunctions.Remove(0, TimerFunctions.Length);
    SetSwanNeckConstraints(class'TdMove'.default.SwanNeckEnableAtPitch, class'TdMove'.default.SwanNeckForward, class'TdMove'.default.SwanNeckDown);
    CurrentCustomAnimName = 'None';
    CurrentCustomAnimNode = none;
    //return;    
}

