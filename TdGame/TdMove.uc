{
    PreciseLocationSpeedToUse = -1.0;
    PreciseLocationSpeed = ((PreciseLocationSpeedToUse < 0.0) ? PawnOwner.GroundSpeed : PreciseLocationSpeedToUse);
    PreciseLocationInterpMode = InterpMode;
    PreciseLocation = PreciseLocationToReach;
    bUsePreciseLocation = true;
    bReachedPreciseLocation = false;
    // End:0x9C
