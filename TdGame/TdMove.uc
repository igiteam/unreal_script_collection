simulated function DrawSimulatedProxyAnimDebugInfo(HUD HUD, out float out_YL, out float out_YPos)
{
    local Canvas Canvas;

    Canvas = HUD.Canvas;
    Canvas.Font = class'Engine'.static.GetTinyFont();
    out_YL = 12.0;
    out_YPos += 50.0;
    out_YPos += out_YL;
    Canvas.SetPos(5.0, out_YPos);
    Canvas.SetDrawColor(255, 255, 255, 255);
    Canvas.DrawText("=== Ghost ===");
    out_YPos += out_YL;
    Canvas.SetPos(5.0, out_YPos);
    Canvas.DrawText("WeaponAnimState: " $ string(PawnOwner.WeaponAnimState));
    //return;    
}

function DisplayDebug(HUD HUD, out float out_YL, out float out_YPos)
{
    local Canvas Canvas;

    out_YPos += (out_YL + float(10));
    Canvas = HUD.Canvas;
    Canvas.SetDrawColor(255, 255, 255, 255);
    out_YPos += out_YL;
    Canvas.SetPos(4.0, out_YPos);
    Canvas.DrawText("MoveActiveTime: " $ string(MoveActiveTime));
    //return;    
}

