simulated function StopReplicatedMove()
{
    // End:0x46
    if(bUseCustomCollision && !PawnOwner.Moves[PawnOwner.PendingMovementState].bUseCustomCollision)
    {
        EnlargeCollision();
    }
    // End:0x72
    if(bShouldHolsterWeapon)
    {
        PawnOwner.AttachWeaponToHand(PawnOwner.Weapon);
    }
    RootOffset = default.RootOffset;
    PawnOwner.SetRootOffset(vect(0.0, 0.0, 0.0), 0.30);
    //return;    
}

simulated function StartReplicatedMove()
{
    // End:0x2C
    if(bShouldHolsterWeapon)
    {
        PawnOwner.DetachWeaponFromHand(PawnOwner.Weapon);
    }
    // End:0x72
    if(bUseCustomCollision && !PawnOwner.Moves[PawnOwner.OldMovementState].bUseCustomCollision)
    {
        ShrinkCollision();
    }
    PawnOwner.SetRootOffset(RootOffset, 0.30);
    //return;    
}

simulated function ConstrainAxis(int Angle, int MinAngle, int MaxAngle, float InterpolateSpeed, out int DeltaAngle)
{
    local int TargetAngle;
    local float Dampening;

    TargetAngle = Angle + DeltaAngle;
    // End:0x48
    if(Angle < MinAngle)
    {
        DeltaAngle = Max(int(float(MinAngle - Angle) * InterpolateSpeed), DeltaAngle);
    }
    // End:0x194
    else
    {
        // End:0x7E
        if(Angle > MaxAngle)
        {
            DeltaAngle = Min(int(float(MaxAngle - Angle) * InterpolateSpeed), DeltaAngle);
        }
        // End:0x194
        else
        {
            // End:0xA3
            if(TargetAngle < MinAngle)
            {
                DeltaAngle -= (TargetAngle - MinAngle);
            }
            // End:0xC5
            else
            {
                // End:0xC5
                if(TargetAngle > MaxAngle)
                {
                    DeltaAngle -= (TargetAngle - MaxAngle);
                }
            }
            TargetAngle = Angle + DeltaAngle;
            // End:0x137
            if(float(TargetAngle) < (float(MinAngle) * 0.60))
            {
                Dampening = Abs(float(MinAngle - Angle) / (float(MinAngle) * 0.40));
                DeltaAngle = Max(DeltaAngle, int(float(DeltaAngle) * Dampening));
            }
            // End:0x194
            else
            {
                // End:0x194
                if(float(TargetAngle) > (float(MaxAngle) * 0.60))
                {
                    Dampening = Abs(float(MaxAngle - Angle) / (float(MaxAngle) * 0.40));
                    DeltaAngle = Min(DeltaAngle, int(float(DeltaAngle) * Dampening));
                }
            }
        }
    }
    //return;    
}

simulated function UpdateViewRotation(out Rotator out_Rotation, float DeltaTime, out Rotator DeltaRot)
{
    local Rotator WantedRotation, HeadRot;
    local Vector WantedLookDir, HeadPos;
    local Rotator Delta, ControllerDelta;
    local int MinYaw, MaxYaw, MinPitch, maxPitch;

    // End:0xC5
    if(bLookAtTargetLocation)
    {
        // End:0xBC
        if((LookAtTargetDuration == -1.0) || LookAtTargetDuration >= MoveActiveTime)
        {
            PawnOwner.GetActorEyesViewPoint(HeadPos, HeadRot);
            WantedLookDir = LookAtTargetLocation - HeadPos;
            WantedRotation = Normalize(rotator(WantedLookDir));
            HeadRot = Normalize(out_Rotation);
            Delta = Normalize(WantedRotation - HeadRot);
            out_Rotation += (Delta * FMin(1.0, DeltaTime / LookAtTargetInterpolationTime));
        }
        // End:0xC2
        else
        {
            AbortLookAtTarget();
        }
    }
    // End:0x14F
    else
    {
        // End:0x14F
        if(bLookAtTargetAngle)
        {
            // End:0x149
            if((LookAtTargetDuration == -1.0) || LookAtTargetDuration >= MoveActiveTime)
            {
                WantedRotation = LookAtTargetAngle;
                HeadRot = Normalize(out_Rotation);
                Delta = Normalize(WantedRotation - HeadRot);
                out_Rotation += (Delta * FMin(1.0, DeltaTime / LookAtTargetInterpolationTime));
            }
            // End:0x14F
            else
            {
                AbortLookAtTarget();
            }
        }
    }
    // End:0x379
    if(bConstrainLook || PawnOwner.bConstrainLook)
    {
        ControllerDelta = Normalize(Normalize(out_Rotation) - Normalize(PawnOwner.Rotation));
        // End:0x20C
        if(bUseAbsoluteYawConstraint)
        {
            MinYaw = NormalizeRotAxis((GetMinLookConstrainYaw()) - PawnOwner.Rotation.Yaw);
            MaxYaw = NormalizeRotAxis((GetMaxLookConstrainYaw()) - PawnOwner.Rotation.Yaw);
        }
        // End:0x264
        else
        {
            MinYaw = Max(GetMinLookConstrainYaw(), PawnOwner.MinLookConstraint.Yaw);
            MaxYaw = Min(GetMaxLookConstrainYaw(), PawnOwner.MaxLookConstraint.Yaw);
        }
        MinPitch = Max(GetMinLookConstrainPitch(), PawnOwner.MinLookConstraint.Pitch);
        maxPitch = Min(GetMaxLookConstrainPitch(), PawnOwner.MaxLookConstraint.Pitch);
        Delta = DeltaRot;
        ConstrainAxis(ControllerDelta.Yaw, MinYaw, MaxYaw, DeltaTime / 0.20, DeltaRot.Yaw);
        ConstrainAxis(ControllerDelta.Pitch, MinPitch, maxPitch, DeltaTime / 0.20, DeltaRot.Pitch);
        Delta -= DeltaRot;
        PostConstrainCamera(Delta, DeltaRot);
        DeltaRot = Normalize(DeltaRot);
    }
    // End:0x462
    if(bResetCameraLook)
    {
        // End:0x448
        if(CancelResetCameraLookTime > PawnOwner.WorldInfo.TimeSeconds)
        {
            WantedRotation = PawnOwner.Rotation;
            WantedRotation.Pitch = 0;
            WantedRotation = Normalize(WantedRotation);
            HeadRot = Normalize(out_Rotation);
            Delta = Normalize(WantedRotation - HeadRot);
            out_Rotation += (Delta / FMax(1.0, (CancelResetCameraLookTime - PawnOwner.WorldInfo.TimeSeconds) / DeltaTime));
        }
        // End:0x462
        else
        {
            out_Rotation.Pitch = 0;
            bResetCameraLook = false;
        }
    }
    //return;    
}

simulated function UpdateMeleeAutoLockOn(TdPlayerController TdPC, float DeltaTime, Rotator ViewRotation, out Rotator out_DeltaRotation)
{
    local Rotator TargetRot, ToTargetRot, FocusRotation;
    local float ToTargetDelta;
    local bool bPositiveOnJoyIsTowardsEnemy, bPerformingDisarm;

    // End:0x4D
    if(TdPC.TargetingPawn == none)
    {
        TdPC.TargetingPawn = TdPC.GetHumanTarget(90.0, TdPC.CloseCombatMaxAngle);
    }
    // End:0x5F7
    if(TdPC.TargetingPawn != none)
    {
        bPerformingDisarm = PawnOwner.MovementState == 18;
        // End:0xC3
        if((TdPC.TargetingPawn.SoftLockStrength == 0.0) && !bPerformingDisarm)
        {
            TdPC.TargetingPawn = none;
            return;
        }
        // End:0x1DD
        if(!bPerformingDisarm && (((VSize(TdPC.TargetingPawn.Location - PawnOwner.Location) > 350.0) || Abs(TdPC.TargetingPawn.Location.Z - PawnOwner.Location.Z) > 150.0) || TdPC.TargetingPawn.Health <= 0) || (PawnOwner.WorldInfo.TimeSeconds - TdPC.TargetingPawn.LastRenderTime) > 2.0)
        {
            TdPC.TargetingPawn = none;
            TdPC.TargetingPawnInterp = 0.0;
            return;
        }
        ToTargetRot = Normalize(rotator(TdPC.TargetingPawn.Location - PawnOwner.Location));
        ToTargetDelta = float(Normalize(ToTargetRot - Normalize(TdPC.Rotation)).Yaw);
        bPositiveOnJoyIsTowardsEnemy = ToTargetDelta > float(0);
        // End:0x356
        if(!bPerformingDisarm && ((TdPC.PlayerInput.RawJoyRight > 0.70) && TdPC.PlayerInput.RawJoyLookRight < -0.70) || (TdPC.PlayerInput.RawJoyRight < -0.70) && TdPC.PlayerInput.RawJoyLookRight > 0.70)
        {
            TdPC.TargetingPawnInterp = 0.0;
            // End:0x351
            if(Abs(ToTargetDelta) > TdPC.TargetingCutoffAngle)
            {
                TdPC.TargetingPawnInterp = 0.0;
                TdPC.TargetingPawn = none;
            }
            return;
        }
        // End:0x4B7
        else
        {
            // End:0x483
            if(!bPerformingDisarm && (((TdPC.PlayerInput.RawJoyLookRight < 0.0) && bPositiveOnJoyIsTowardsEnemy) || (TdPC.PlayerInput.RawJoyLookRight > 0.0) && !bPositiveOnJoyIsTowardsEnemy) || Abs(ToTargetDelta) < float(100))
            {
                TdPC.TargetingPawnInterp = 0.0;
                // End:0x42D
                if(Abs(ToTargetDelta) > TdPC.TargetingCutoffAngle)
                {
                    TdPC.TargetingPawnInterp = 0.0;
                    TdPC.TargetingPawn = none;
                    return;
                }
                out_DeltaRotation.Yaw *= FClamp((Abs(ToTargetDelta) / TdPC.TargetingCutoffAngle) ** TdPC.TargetingPawn.SoftLockStrength, 0.10, 1.0);
                return;
            }
            // End:0x4B7
            else
            {
                TdPC.TargetingPawnInterp = FMin(1.0, TdPC.TargetingPawnInterp + (2.0 * DeltaTime));
            }
        }
        // End:0x525
        if(TdPC.TargetingPawn.MovementState == 69)
        {
            FocusRotation = rotator(TdPC.TargetingPawn.Mesh.GetBoneLocation('Hips') - PawnOwner.Location);
        }
        // End:0x557
        else
        {
            FocusRotation = rotator(TdPC.TargetingPawn.Location - PawnOwner.Location);
        }
        // End:0x57E
        if(TdPC.TargetingPawnInterp == 1.0)
        {
            TargetRot = FocusRotation;
        }
        // End:0x5BE
        else
        {
            TargetRot = RLerp(Normalize(PawnOwner.Controller.Rotation), FocusRotation, TdPC.TargetingPawnInterp, true);
        }
        out_DeltaRotation.Yaw = NormalizeRotAxis(TargetRot.Yaw - ViewRotation.Yaw);
    }
    //return;    
}

