class TdMove_Crouch extends TdPhysicsMove
    native
    config(PawnMovement);

function bool CanDoMove()
{
    return PawnOwner.MovementState != 15;
    //return ReturnValue;    
}

simulated function StopReplicatedMove()
{
    super(TdMove).StopReplicatedMove();
    //return;    
}

simulated function StartReplicatedMove()
{
    super(TdMove).StartReplicatedMove();
    //return;    
}

simulated function StartMove()
{
    super.StartMove();
    PawnOwner.SetPhysics(1);
    PawnOwner.StopCustomAnim(3, AnimBlendTime);
    PawnOwner.StopCustomAnim(5, AnimBlendTime);
    // End:0xE0
    if(PawnOwner.OldMovementState == 1)
    {
        TdPlayerPawn(PawnOwner).EnableFootPlacement(0.10);
        PawnOwner.SetRootOffset(vect(0.0, 0.0, 15.0), 0.10);
        SetMoveTimer(0.150, false, 'DisableRootOffset');
        PawnOwner.SetTimer(0.20, false, 'DisableFootPlacement');
    }
    PawnOwner.OnTutorialEvent(12);
    //return;    
}

simulated function DisableRootOffset()
{
    PawnOwner.SetRootOffset(vect(0.0, 0.0, 0.0), 0.10);
    //return;    
}

simulated function StopMove()
{
    super.StopMove();
    // End:0x7D
    if(PawnOwner.PendingMovementState == 1)
    {
        TdPlayerPawn(PawnOwner).EnableFootPlacement(0.0);
        PawnOwner.SetTimer(0.20, false, 'DisableFootPlacement');
        PlayMoveAnim(6, 'CrouchIntoStand', 1.0, 0.20, 0.20, false);
    }
    PawnOwner.bAvoidLedges = true;
    PawnOwner.SetHipsOffset(vect(0.0, 0.0, 0.0));
    //return;    
}

simulated function HandleMoveAction(TdPawn.EMovementAction Action)
{
    super(TdMove).HandleMoveAction(Action);
    PawnOwner.bAvoidLedges = Action == 5;
    //return;    
}

simulated event StopMovingToCrouchSit()
{
    PawnOwner.StopCustomAnim(2, 0.20);
    //return;    
}

simulated function Vector GetFocusLocation()
{
    local Vector PawnRootLocation;

    PawnRootLocation = PawnOwner.Location;
    PawnRootLocation.Z -= PawnOwner.CylinderComponent.CollisionHeight;
    return PawnRootLocation + vect(0.0, 0.0, 85.0);
    //return ReturnValue;    
}

function CheckForCameraCollision(Vector CameraLocation, Rotator CameraRotation)
{
    local Vector HitLocation, HitNormal, TraceEnd, TraceStart, TraceExtent, MeshOffset;

    // End:0xEE
    if(MoveActiveTime < 0.20)
    {
        TraceStart = CameraLocation - (vector(PawnOwner.Rotation) * 5.0);
        TraceEnd = CameraLocation + (vector(PawnOwner.Rotation) * 15.0);
        TraceEnd.Z += 5.0;
        TraceExtent = vect(2.0, 2.0, 2.0);
        // End:0xEB
        if(MovementTraceForBlockingEx(TraceEnd, TraceStart, TraceExtent, HitLocation, HitNormal))
        {
            MeshOffset.X = -VSize2D(TraceEnd - HitLocation) - 1.0;
            PawnOwner.OffsetMeshXY(MeshOffset, false);
        }
    }
    // End:0xFE
    else
    {
        super(TdMove).CheckForCameraCollision(CameraLocation, CameraRotation);
    }
    //return;    
}

simulated function UpdateViewRotation(out Rotator out_Rotation, float DeltaTime, out Rotator DeltaRot)
{
    local int RotYawDiff;
    local Vector HipsOffset;

    super(TdMove).UpdateViewRotation(out_Rotation, DeltaTime, DeltaRot);
    // End:0x66
    if((PawnOwner.OldMovementState == 16) && MoveActiveTime < 0.30)
    {
        PawnOwner.SetHipsOffset(vect(0.0, 0.0, 0.0));
    }
    // End:0x13B
    else
    {
        RotYawDiff = NormalizeRotAxis(PawnOwner.Controller.Rotation.Yaw) - PawnOwner.LegRotation;
        RotYawDiff = NormalizeRotAxis(RotYawDiff);
        HipsOffset.X = 25.0 * (Abs(float(RotYawDiff)) / 16384.0);
        HipsOffset.Y = 30.0 * (float(RotYawDiff) / 16384.0);
        HipsOffset.Z = 0.0;
        PawnOwner.SetHipsOffset(HipsOffset, 0.30, true);
    }
    //return;    
}

defaultproperties
{
    SpeedModifier=0.20
    bShouldUnzoom=false
    bConstrainLook=true
    bUseCustomCollision=true
    bUseCameraCollision=true
    bEnableFootPlacement=true
    bEnableAgainstWall=true
    bAllowPickup=true
    MinLookConstraint=(Pitch=-14000,Yaw=-32768,Roll=-32768)
    MaxLookConstraint=(Pitch=14000,Yaw=32768,Roll=32768)
    AnimBlendTime=0.250
}