event Registered(LocalPlayer PlayerOwner)
{
    local OnlineSubsystem OnlineSub;

    super(UIDataStore).Registered(PlayerOwner);
    OnlineSub = class'GameEngine'.static.GetOnlineSubsystem();
    // End:0x89
    if(OnlineSub != none)
    {
        OnlineSub.SystemInterface.AddControllerChangeDelegate(OnControllerChange);
        bControllerConnected = OnlineSub.SystemInterface.IsControllerConnected(PlayerOwner.ControllerId);
    }
    //return;    
}

event Unregistered(LocalPlayer PlayerOwner)
{
    local OnlineSubsystem OnlineSub;

    super(UIDataStore).Unregistered(PlayerOwner);
    OnlineSub = class'GameEngine'.static.GetOnlineSubsystem();
    // End:0x54
    if(OnlineSub != none)
    {
        OnlineSub.SystemInterface.ClearControllerChangeDelegate(OnControllerChange);
    }
    //return;    
}

function OnControllerChange(int ControllerId, bool Connected)
{
    bControllerConnected = Connected;
    ClearBoundKeyCache();
    RefreshSubscribers();
    //return;    
}

