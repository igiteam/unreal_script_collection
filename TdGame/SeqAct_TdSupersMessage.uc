class SeqAct_TdSupersMessage extends SequenceAction
    hidecategories(Object);

var() string SupersMessage;
var() float Duration;
var private TdGameUISceneClient SceneClient;
var private LocalPlayer Player;

event Activated()
{
    local UIScene LocalScene;

    SceneClient = TdGameUISceneClient(class'UIRoot'.static.GetSceneClient());
    Player = GetFirstLocalPlayer();
    // End:0xAF
    if(Len(SupersMessage) > 0)
    {
        // End:0xAF
        if(SceneClient != none)
        {
            LocalScene = SceneClient.FindSceneByTag('TdSupersMessage', Player);
            // End:0x7B
            if(LocalScene == none)
            {
                OpenNextSupersScene();
            }
            // End:0xAF
            else
            {
                LocalScene.__OnSceneDeactivated__Delegate = OnSupersSceneClosed;
                LocalScene.CloseScene(LocalScene);
            }
        }
    }
    //return;    
}

private final function OnSupersSceneClosed(UIScene ClosedScene)
{
    OpenNextSupersScene();
    //return;    
}

private final function OpenNextSupersScene()
{
    SceneClient.OpenSceneEx(class'TdHUDContent'.static.GetUISceneByName('TdSupersMessage'), Player,, OnSupersSceneOpened);
    //return;    
}

private final function OnSupersSceneOpened(UIScene OpenedScene, bool bInitialActivation)
{
    TdUIScene_SupersMessage(OpenedScene).SetupSupersMessage(SupersMessage, Duration);
    //return;    
}

function LocalPlayer GetFirstLocalPlayer()
{
    local TdPlayerController P;

    // End:0x35
    foreach GetWorldInfo().LocalPlayerControllers(class'TdPlayerController', P)
    {        
        return LocalPlayer(P.Player);        
    }    
    return none;
    //return ReturnValue;    
}

defaultproperties
{
    Duration=3.0
    OutputLinks=none
    VariableLinks=none
    ObjName="Supers Message"
    ObjCategory="Takedown"
}