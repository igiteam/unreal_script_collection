event PostBeginPlay()
{
    local TdAIManager AIManager;

    AIManager = TdSPStoryGame(WorldInfo.Game).AIManager;
    // End:0x44
    if(AIManager != none)
    {
        AIManager.AddGrenadeArea(self);
    }
    //return;    
}

event ThrowGrenade()
{
    local TdAIGrenadeController GrenadeController;

    // End:0x4D
    if(GrenadeNodes[0] != none)
    {
        GrenadeController = Spawn(class'TdAIGrenadeController');
        GrenadeController.ThrowInstantGrenade(self, GrenadeNodes[0].Location);
        J0x4D:
    }
    // End:0x4D
    else
    {
    }
    //return;    
}

