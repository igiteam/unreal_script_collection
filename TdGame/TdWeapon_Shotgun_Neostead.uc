class TdWeapon_Shotgun_Neostead extends TdWeapon_Heavy
    config(Weapons)
    hidecategories(Navigation);

var() int PelletCount;

simulated function CustomFire()
{
    local Vector StartTrace, EndTrace;
    local array<ImpactInfo> ImpactList;
    local int Idx, pellet;
    local ImpactInfo RealImpact;
    local Rotator BaseAim;

    StartTrace = Instigator.GetWeaponStartTraceLocation();
    BaseAim = GetAdjustedAim(StartTrace);
    pellet = 0;
    J0x37:
    // End:0x99 [Loop If]
    if(pellet < PelletCount)
    {
        EndTrace = StartTrace + (vector(AddSpread(BaseAim)) * (GetTraceRange()));
        RealImpact = CalcWeaponFire(StartTrace, EndTrace, ImpactList);
        ++ pellet;
        // [Loop Continue]
        goto J0x37;
    }
    Idx = 0;
    J0xA0:
    // End:0x155 [Loop If]
    if(Idx < ImpactList.Length)
    {
        // End:0x14B
        if((((TdPawn(Owner) != none) && TdPawn(Owner).IsHumanControlled()) || Idx < 3) || (ImpactList[Idx].HitActor != none) && ImpactList[Idx].HitActor.IsA('TdPawn'))
        {
            ProcessInstantHit(CurrentFireMode, ImpactList[Idx]);
        }
        ++ Idx;
        // [Loop Continue]
        goto J0xA0;
    }
    // End:0x17F
    if(Role == ROLE_Authority)
    {
        SetFlashLocation(RealImpact.HitLocation);
    }
    //return;    
}

function ParticleSystem GetSpecificImpactEffect(TdPhysicalMaterialImpactEffects ImpactEffects)
{
    return ImpactEffects.ShotgunPellet;
    //return ReturnValue;    
}

function ParticleSystem GetSpecificImpactEffectPhysX(TdPhysicalMaterialImpactEffects ImpactEffects)
{
    return ImpactEffects.ShotgunPelletPhysX.Template;
    //return ReturnValue;    
}

