event PostInitialize()
{
    super(UIScreenObject).PostInitialize();
    ArrowLeftButton.__OnClicked__Delegate = OnArrowLeft_Clicked;
    ArrowRightButton.__OnClicked__Delegate = OnArrowRight_Clicked;
    //return;    
}

event OnMoveSelectionLeft(int PlayerIndex)
{
    // End:0x52
    if(HasPrevValue())
    {
        SetPrevValue();
        UpdateArrowStates();
        PreventChangeSelection = GetWorldInfo().RealTimeSeconds + 0.20;
        PlayUISound(DecrementCue, PlayerIndex);
    }
    //return;    
}

event OnMoveSelectionRight(int PlayerIndex)
{
    // End:0x52
    if(HasNextValue())
    {
        SetNextValue();
        UpdateArrowStates();
        PreventChangeSelection = GetWorldInfo().RealTimeSeconds + 0.20;
        PlayUISound(IncrementCue, PlayerIndex);
    }
    //return;    
}

function bool OnArrowLeft_Clicked(UIScreenObject InButton, int PlayerIndex)
{
    // End:0x19
    if(IsFocused() == false)
    {
        SetFocus(none);
    }
    OnMoveSelectionLeft(PlayerIndex);
    return true;
    //return ReturnValue;    
}

function bool OnArrowRight_Clicked(UIScreenObject InButton, int PlayerIndex)
{
    // End:0x19
    if(IsFocused() == false)
    {
        SetFocus(none);
    }
    OnMoveSelectionRight(PlayerIndex);
    return true;
    //return ReturnValue;    
}

