class TdTeamDMHUD extends TdMPHUD
    transient
    config(Game)
    hidecategories(Navigation);

var(HUDIcons) Vector2D RunnerScore;
var(HUDIcons) Vector2D CopScore;

function DrawScore()
{
    local TdGameReplicationInfo MyGRI;
    local Vector2D pos;
    local float XL, YL;
    local int MyScore;

    MyGRI = TdGameReplicationInfo(WorldInfo.GRI);
    // End:0x27
    if(MyGRI == none)
    {
        return;
    }
    Canvas.DrawColor = WhiteColor;
    Canvas.DrawColor.A = 255;
    Canvas.Font = MediumFont;
    MyScore = int(MyGRI.Teams[0].Score);
    Canvas.TextSize(string(MyScore), XL, YL);
    ComputeHUDPosition(ScorePos.X, ScorePos.Y, 0.0, 0.0, pos);
    Canvas.SetPos((pos.X + RunnerScore.X) - (XL * 0.50), pos.Y);
    Canvas.DrawColorizedTile(PlayerIconTexture[0], 64.0, 64.0, 0.0, 0.0, 64.0, 64.0, MakeLinearColor(1.0, 1.0, 1.0, 1.0));
    Canvas.DrawText(string(MyScore));
    MyScore = int(MyGRI.Teams[1].Score);
    Canvas.TextSize(string(MyScore), XL, YL);
    Canvas.SetPos((pos.X + CopScore.X) - (XL * 0.50), pos.Y);
    Canvas.DrawColorizedTile(PlayerIconTexture[1], 64.0, 64.0, 0.0, 0.0, 64.0, 64.0, MakeLinearColor(1.0, 1.0, 1.0, 1.0));
    Canvas.DrawText(string(MyScore));
    //return;    
}

defaultproperties
{
    RunnerScore=(X=-80.0,Y=0.0)
    CopScore=(X=40.0,Y=0.0)
    ScorePos=(X=640.0,Y=35.0)
}