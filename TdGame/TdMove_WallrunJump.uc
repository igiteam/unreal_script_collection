class TdMove_WallrunJump extends TdPhysicsMove
    config(PawnMovement);

var(WallRunJump) config float WallRunningPushAwaySpeedNoob;
var(WallRunJump) config float WallRunningPushAwaySpeedProAdd;
var(WallRunJump) config float WallRunningPushForwardSpeedMin;
var(WallRunJump) config float WallRunningJumpOffZHeightForward;
var(WallRunJump) config float WallRunningJumpOffZHeightMaxAddTurned;
var float WallRunningJumpOffZSpeed;
var int MinContraintWorld;
var int MaxContraintWorld;

function bool CanDoMove()
{
    // End:0x0D
    if(!super(TdMove).CanDoMove())
    {
        return false;
    }
    return true;
    //return ReturnValue;    
}

simulated function StartMove()
{
    local Vector WallProjVelocity, SavedFloor, wallRunDir2D, camrotDir2D, Start, End,
	    HitLocation, HitNormal;

    local float PushSpeed, Gravity, Speed, JumpHeight;
    local Rotator WallNormal;

    SavedFloor = PawnOwner.Floor;
    WallNormal = rotator(PawnOwner.Floor);
    PawnOwner.bIllegalLedgeTimer = 2.0;
    PawnOwner.IllegalLedgeNormal = PawnOwner.Floor;
    // End:0xC3
    if(PawnOwner.OldMovementState == 5)
    {
        MinContraintWorld = NormalizeRotAxis(WallNormal.Yaw - 16000);
        MaxContraintWorld = NormalizeRotAxis(WallNormal.Yaw + 10000);
    }
    // End:0x109
    else
    {
        MinContraintWorld = NormalizeRotAxis(WallNormal.Yaw - 10000);
        MaxContraintWorld = NormalizeRotAxis(WallNormal.Yaw + 16000);
    }
    super.StartMove();
    PawnOwner.LastJumpLocation = PawnOwner.Location;
    WallProjVelocity = PawnOwner.Velocity - (SavedFloor * (PawnOwner.Velocity Dot SavedFloor));
    WallProjVelocity.Z = 0.0;
    wallRunDir2D = SavedFloor;
    wallRunDir2D.Z = 0.0;
    wallRunDir2D = Normal(wallRunDir2D);
    // End:0x237
    if(TdMove_WallRun(PawnOwner.Moves[40]).bTurned90FromWall)
    {
        camrotDir2D = SavedFloor;
        PawnOwner.FaceRotationTimeLeft = 0.10;
        PawnOwner.LegRotation = WallNormal.Yaw;
        SetLookAtTargetAngle(WallNormal, 0.10);
        SetPreciseRotation(WallNormal, 0.10);
        bDisableControllerFacingPawnYawRotation = true;
    }
    // End:0x258
    else
    {
        camrotDir2D = vector(PawnOwner.Controller.Rotation);
    }
    camrotDir2D.Z = 0.0;
    camrotDir2D = Normal(camrotDir2D);
    PushSpeed = wallRunDir2D Dot camrotDir2D;
    FMax(0.0, PushSpeed);
    JumpHeight = WallRunningJumpOffZHeightForward + (PushSpeed * WallRunningJumpOffZHeightMaxAddTurned);
    Start = PawnOwner.Location;
    End = Start;
    End.Z += JumpHeight;
    // End:0x349
    if(MovementTrace(HitLocation, HitNormal, End, Start, PawnOwner.GetCollisionExtent()))
    {
        JumpHeight = HitLocation.Z - PawnOwner.Location.Z;
    }
    Gravity = Abs(PawnOwner.GetGravityZ());
    Speed = (Gravity * 2.0) * Sqrt(JumpHeight / Gravity);
    Speed *= (1.0 / float(1 + TdMove_WallRun(PawnOwner.Moves[40]).ConsequtiveWallruns));
    WallRunningJumpOffZSpeed = FMax(Speed, 10.0);
    PawnOwner.Velocity.Z = Speed;
    PawnOwner.Velocity.X = SavedFloor.X * (WallRunningPushAwaySpeedNoob + (WallRunningPushAwaySpeedProAdd * PushSpeed));
    PawnOwner.Velocity.Y = SavedFloor.Y * (WallRunningPushAwaySpeedNoob + (WallRunningPushAwaySpeedProAdd * PushSpeed));
    PawnOwner.Velocity += (WallProjVelocity * (WallRunningPushForwardSpeedMin + ((float(1) - WallRunningPushForwardSpeedMin) * (float(1) - PushSpeed))));
    PawnOwner.StopCustomAnim(2, 0.20);
    // End:0x545
    if(PushSpeed > 0.60)
    {
        // End:0x515
        if(PawnOwner.OldMovementState == 5)
        {
            PlayMoveAnim(3, name("WallrunJumpLeft"), 1.0, 0.20, 0.20);
        }
        // End:0x542
        else
        {
            PlayMoveAnim(3, name("WallrunJumpRight"), 1.0, 0.20, 0.20);
        }
    }
    // End:0x56A
    else
    {
        PlayMoveAnim(3, name("JumpSlow"), 1.0, 0.20, 0.20);
    }
    PawnOwner.SetAnimationMovementState(11);
    //return;    
}

simulated function bool IsThisMoveStringable()
{
    return true;
    //return ReturnValue;    
}

simulated function StopMove()
{
    super.StopMove();
    // End:0x57
    if((PawnOwner.PendingMovementState != 2) && PawnOwner.PendingMovementState != 9)
    {
        PawnOwner.StopCustomAnim(3, 0.20);
    }
    //return;    
}

simulated function int GetMinLookConstrainYaw()
{
    return MinContraintWorld;
    //return ReturnValue;    
}

simulated function int GetMaxLookConstrainYaw()
{
    return MaxContraintWorld;
    //return ReturnValue;    
}

defaultproperties
{
    WallRunningPushAwaySpeedNoob=120.0
    WallRunningPushAwaySpeedProAdd=400.0
    WallRunningPushForwardSpeedMin=0.10
    WallRunningJumpOffZHeightForward=100.0
    WallRunningJumpOffZHeightMaxAddTurned=60.0
    PawnPhysics=PHYS_Falling
    ControllerState=PlayerWalking
    bCheckForGrab=true
    bCheckForVaultOver=true
    bCheckForWallClimb=true
    bCheckExitToFalling=true
    bUseAbsoluteYawConstraint=true
    AiAimOneShotPenalties=(Easy=75.0,Medium=75.0,Hard=75.0)
}