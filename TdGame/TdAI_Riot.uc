            goto J0x7B;
        }
        // End:0x7B
        if((Clients[I] != none) && !Clients[I].EnemyVisible)
        {
            fEnemyNotVisibleToWholeFormationTime = WorldInfo.TimeSeconds;
            return false;
        }
        J0x7B:
        ++ I;
        // [Loop Continue]
        goto J0x15;
    }
    return true;
    //return ReturnValue;    
}

function ApplyForShieldMasterPosition()
{
    // End:0x32
    if(!IAmShieldMaster && Team.GetShieldMaster(self) == none)
    {
        SetShieldMaster();
    }
    //return;    
