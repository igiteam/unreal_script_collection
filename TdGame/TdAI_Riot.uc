    //return;    
}

function bool CloserThanCurrentClient(TdAIController C, int I)
{
    return VSize(C.Pawn.Location - FormationPositions[I]) < (VSize(Clients[I].Pawn.Location - FormationPositions[I]) - float(30));
    //return ReturnValue;    
}

function bool ApplyForFormationPosition(TdAIController C)
{
    local TdAI_Riot riot;

    riot = TdAI_Riot(C);
    // End:0x8F
    if(riot != none)
    {
        // End:0x55
        if((Clients[3] == none) || CloserThanCurrentClient(C, 3))
        {
            AssignPosition(riot, 3);
            return true;
        }
        // End:0x8C
        else
        {
            // End:0x8C
            if((Clients[4] == none) || CloserThanCurrentClient(C, 4))
            {
                AssignPosition(riot, 4);
                return true;
            }
        }
    }
    // End:0x190
    else
    {
        // End:0xEA
        if((((Clients[0] == none) || CloserThanCurrentClient(C, 0)) && Clients[3] != none) && CanMoveIntoPosition(C))
        {
            AssignPosition(C, 0);
            return true;
        }
        // End:0x190
        else
        {
            // End:0x135
            if(((Clients[1] == none) || CloserThanCurrentClient(C, 1)) && CanMoveIntoPosition(C))
            {
                AssignPosition(C, 1);
                return true;
            }
            // End:0x190
            else
            {
                // End:0x190
                if((((Clients[2] == none) || CloserThanCurrentClient(C, 2)) && Clients[4] != none) && CanMoveIntoPosition(C))
                {
                    AssignPosition(C, 2);
                    return true;
                }
            }
        }
    }
    return false;
    //return ReturnValue;    
}

function bool CanMoveIntoPosition(TdAIController C)
{
    local Vector Dir, formationDir;

    formationDir = vector(Pawn.Rotation);
    Dir = Pawn.Location - C.Pawn.Location;
    Dir.Z = 0.0;
    Dir = Normal(Dir);
    return (Dir Dot formationDir) > 0.10;
    //return ReturnValue;    
}

function RemoveFromFormation(TdAIController C)
{
    local int I;

    I = 0;
    J0x07:
    // End:0x39 [Loop If]
    if(I < Clients.Length)
    {
        // End:0x2F
        if(Clients[I] == C)
