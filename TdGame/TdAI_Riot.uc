function SetShieldMaster()
{
    IAmShieldMaster = true;
    Team.SetShieldFormationMaster(self);
    //return;    
}

event Tick(float DeltaTime)
{
    super.Tick(DeltaTime);
    // End:0x10D
    if(IAmShieldMaster && !IsInState('RiotMelee', true))
    {
        SwitchFormationPositions();
        // End:0x64
        if(!IsReadyToMove())
        {
            UpdateShieldFormation(CFormationWidth + float(50), CFormationDepth + float(50));
        }
        // End:0xEF
        else
        {
            // End:0xC7
            if((TimeSince(LeftWideFormationTimeStamp) < 3.0) || !AnyClientsTrailingBehindAlot())
            {
                UpdateShieldFormation(CFormationWidth, CFormationDepth);
                // End:0xBC
                if(bUsingWideFormation)
                {
                    LeftWideFormationTimeStamp = WorldInfo.TimeSeconds;
                }
                bUsingWideFormation = false;
            }
            // End:0xEF
            else
            {
                UpdateShieldFormation(CFormationWidth + float(30), CFormationDepth + float(40));
                bUsingWideFormation = true;
            }
        }
        myPawn.SetIsSlowWalking(AnyClientsTrailingBehind());
    }
    //return;    
}

function SwitchFormationPositions()
{
    TrySwitchPositions(3, 4);
    // End:0x58
    if(((Clients[3] == none) && Clients[0] != none) || (Clients[4] == none) && Clients[2] != none)
    {
        SwitchPositions(0, 2);
    }
    // End:0x72
    if(Clients[3] != none)
    {
        TrySwitchPositions(0, 1);
    }
    // End:0x8D
    if(Clients[4] != none)
    {
        TrySwitchPositions(1, 2);
    }
    //return;    
}

function TrySwitchPositions(int P1, int P2)
{
    local float currentDist1, NewDist1, currentDist2, NewDist2, maxCurrentDist;

    // End:0x19E
    if((Clients[P1] != none) || Clients[P2] != none)
    {
        // End:0xA8
        if(Clients[P1] != none)
        {
            currentDist1 = VSizeSq(FormationPositions[P1] - Clients[P1].Pawn.Location);
            NewDist1 = VSizeSq(FormationPositions[P2] - Clients[P1].Pawn.Location);
        }
        // End:0xBE
        else
        {
            currentDist1 = 0.0;
            NewDist1 = 0.0;
        }
        // End:0x142
        if(Clients[P2] != none)
        {
            currentDist2 = VSizeSq(FormationPositions[P2] - Clients[P2].Pawn.Location);
            NewDist2 = VSizeSq(FormationPositions[P1] - Clients[P2].Pawn.Location);
        }
        // End:0x158
        else
        {
            currentDist2 = 0.0;
            NewDist2 = 0.0;
        }
        maxCurrentDist = FMax(currentDist1, currentDist2);
        // End:0x19E
        if((NewDist1 < maxCurrentDist) && NewDist2 < maxCurrentDist)
        {
            SwitchPositions(P1, P2);
        }
    }
    //return;    
}

function SwitchPositions(int P1, int P2)
{
    local TdAIController tempC;

    tempC = Clients[P1];
    Clients[P1] = Clients[P2];
    Clients[P2] = tempC;
    tempBool = IgnoredClients[P1];
    IgnoredClients[P1] = IgnoredClients[P2];
    IgnoredClients[P2] = tempBool;
    //return;    
}

