{
    return (((EnemyVisibleToWholeFormation()) && TimeSince(fEnemyNotVisibleToWholeFormationTime) > 1.0) && (CanFireFromHere()) || (BlockingPawn != none) && IsInFormation(BlockingPawn)) && !ShouldMoveIn();
    //return ReturnValue;    
}

function TestAdvanceMovement()
{
    // End:0x5D
