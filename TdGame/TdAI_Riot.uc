function float GetMoveDist()
{
    local Vector startPos;

    // End:0x55
    if(IsInLatentMovement())
    {
        // End:0x30
        if(MoveTarget != none)
        {
            startPos = MoveTarget.Location;
        }
        // End:0x52
        else
        {
            // End:0x52
            if(Destination != vect(0.0, 0.0, 0.0))
            {
                startPos = Destination;
            }
        }
    }
    // End:0x6A
    else
    {
        startPos = Pawn.Location;
    }
    return VSize(startPos - Pawn.Location);
    //return ReturnValue;    
}

function UpdateShieldFormation(float FormationWidth, float FormationDepth)
{
    local Vector Dir, Right, startPos;
    local int I;

    // End:0x4C
    if(false)
    {
        // End:0x27
        if(MoveTarget != none)
        {
            startPos = MoveTarget.Location;
        }
        // End:0x49
        else
        {
            // End:0x49
            if(Destination != vect(0.0, 0.0, 0.0))
            {
                startPos = Destination;
            }
        }
    }
    // End:0x61
    else
    {
        startPos = Pawn.Location;
    }
    Dir = vector(Pawn.Rotation);
    Right = -Dir Cross vect(0.0, 0.0, 1.0);
    bAdjusting = false;
    // End:0x101
    if((FormationWidthCount == 1) && IsInLatentMovement())
    {
        FormationWidth *= 0.50;
        bAdjusting = true;
        AdjustLoc = startPos + ((Clients[4] != none) ? FormationWidth * Right : -FormationWidth * Right);
    }
    FormationPositions[0] = (startPos + (FormationWidth * Right)) - (Dir * FormationDepth);
    FormationPositions[1] = startPos - (Dir * FormationDepth);
    FormationPositions[2] = (startPos - (FormationWidth * Right)) - (Dir * FormationDepth);
    FormationPositions[3] = startPos + (FormationWidth * Right);
    FormationPositions[4] = startPos - (FormationWidth * Right);
    I = 0;
    J0x1AE:
    // End:0x1EB [Loop If]
    if(I < FormationPositions.Length)
    {
        FormationPositions[I] += (Pawn.Velocity * 0.30);
        ++ I;
        // [Loop Continue]
        goto J0x1AE;
    }
    I = 0;
    J0x1F2:
    // End:0x242 [Loop If]
    if(I < Clients.Length)
    {
        // End:0x238
        if(Clients[I] != none)
        {
            Clients[I].UpdateFormationPos(FormationPositions[I]);
        }
        ++ I;
        // [Loop Continue]
        goto J0x1F2;
    }
    //return;    
}

function bool ShouldEnterMelee(float Range)
{
    local bool Result;

    Result = ((((myPawn.MovementState == 1) && (EnemyDistance < Range) || IsPredictedPositionWithinMeleeRange(Range)) && !EnemyHarmless()) && !IsEnemyBehindMe()) && IsPredictedEnemyReachable();
    return Result;
    //return ReturnValue;    
}

function TdAIController.EDisarmState QueryDisarmState(TdPawn Disarmer)
{
    local float RotationDot;

    RotationDot = vector(Disarmer.Rotation) Dot vector(myPawn.Rotation);
    // End:0x3C
    if(RotationDot > 0.80)
    {
        return 2;
    }
    return 0;
    //return ReturnValue;    
}

