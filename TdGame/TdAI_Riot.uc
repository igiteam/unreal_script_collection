function bool EnemyVisibleToWholeFormation()
{
    local int I;

    // End:0x0D
    if(!EnemyVisible)
    {
        return false;
    }
    I = 3;
    J0x15:
    // End:0x85 [Loop If]
    if(I < Clients.Length)
    {
        // End:0x36
        if(IgnoredClients[I])
        {
