{
    return false;
    //return ReturnValue;    
}

state RiotMelee extends TdState
{
    function BeginState(name PreviousStateName)
    {
        super.BeginState(PreviousStateName);
        StopFiring();
        SetWantedFocus(2);
        //return;        
    }

    function EndState(name NextStateName)
    {
        super.EndState(NextStateName);
        //return;        
    }

    function UpdatePawnFocus()
    {
        SetFocus(2);
        //return;        
    }

Begin:
    LastMeleeTimeStamp = WorldInfo.TimeSeconds;
    myPawn.SetMove(17);
    J0x2D:
    // End:0x53 [Loop If]
    if(!myPawn.IsInMove(1))
    {
        Sleep(0.10);
        // [Loop Continue]
        goto J0x2D;
    }
    TdGotoState('Advance');
    stop;        
}

defaultproperties
{
    MeleeTimer=2.0
    CFormationWidth=100.0
    CFormationDepth=90.0
    bAvoidPopulatedPaths=false
    MeleeState=RiotMelee
    Components(0)=SpriteComponent'Default__TdAI_Riot.Sprite'
}