        // [Loop Continue]
        goto J0x07;
    }
    // End:0xBB
    if(I < Clients.Length)
    {
        // End:0xAC
        if(I > 2)
        {
            // End:0x87
            if(I == 3)
            {
                // End:0x84
                if(Clients[0] != none)
                {
                    Clients[0].ForceLeaveFormation();
                }
            }
            // End:0xAC
            else
