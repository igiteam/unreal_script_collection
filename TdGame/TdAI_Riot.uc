function UpdateFormationRadius()
{
    FormationWidthCount = 0;
    // End:0x1C
    if(Clients[3] != none)
    {
        ++ FormationWidthCount;
    }
    // End:0x31
    if(Clients[4] != none)
    {
        ++ FormationWidthCount;
    }
    // End:0x6C
    if(FormationWidthCount == 1)
    {
        FormationCollisionRadius = (CFormationWidth * 0.50) + myPawn.CylinderComponent.CollisionRadius;
    }
    // End:0x92
    else
    {
        FormationCollisionRadius = CFormationWidth + myPawn.CylinderComponent.CollisionRadius;
    }
    //return;    
}

function bool TdFindPathToward(Actor anActor)
{
    local float oldCollisionRadius;
    local bool Result;

    // End:0xA2
    if(IAmShieldMaster && IsWide())
    {
        oldCollisionRadius = myPawn.CylinderComponent.CollisionRadius;
        myPawn.SetCollisionSize(FormationCollisionRadius, myPawn.CylinderComponent.CollisionHeight);
        Result = super.TdFindPathToward(anActor);
        myPawn.SetCollisionSize(oldCollisionRadius, myPawn.CylinderComponent.CollisionHeight);
    }
    // End:0xB4
    else
    {
        Result = super.TdFindPathToward(anActor);
    }
    return Result;
    //return ReturnValue;    
}

