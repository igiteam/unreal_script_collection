event ActivateBGSaturation(bool bActive, int Mask)
{
    local TdPlayerController PlayerOwner;
    local TdHUD HUD;
    local int OldMask;

    OldMask = BGSatMask;
    // End:0x29
    if(bActive)
    {
        BGSatMask = BGSatMask | Mask;
    }
    // End:0x3D
    else
    {
        BGSatMask = BGSatMask & ~Mask;
    }
    // End:0x6F
    if((bActive && OldMask != 0) || !bActive && BGSatMask != 0)
    {
        return;
    }
    PlayerOwner = TdPlayerController(Outer.Outer.Outer.GamePlayers[0].Actor);
    // End:0x121
    if(PlayerOwner != none)
    {
        HUD = TdHUD(PlayerOwner.myHUD);
        // End:0x121
        if(HUD != none)
        {
            // End:0x103
            if(bActive)
            {
                HUD.EffectManager.ActivateSaturationEffect();
            }
            // End:0x121
            else
            {
                HUD.EffectManager.DeActivateSaturationEffect();
            }
        }
    }
    //return;    
}

function bool IsTransitioning()
{
    local int Idx;
    local TdUIScene ActiveScene;

    Idx = 0;
    J0x07:
    // End:0x5D [Loop If]
    if(Idx < ActiveScenes.Length)
    {
        ActiveScene = TdUIScene(ActiveScenes[Idx]);
        // End:0x53
        if((ActiveScene != none) && ActiveScene.IsAnimatingScene())
        {
            return true;
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    return false;
    //return ReturnValue;    
}

function OpenSceneEx(UIScene SceneToOpen, optional LocalPlayer Player, optional Engine.UIScene.ESceneTransitionAnim SceneAnim, optional delegate<OnSceneActivated> SceneDelegate)
{
    local TdUIScene ActiveScene;

    SceneAnim = 0;
    SceneDelegate = None;
    ActiveScene = TdUIScene(GetActiveScene());
    // End:0x5A
    if(ActiveScene != none)
    {
        ActiveScene.OpenScene(SceneToOpen, SceneAnim, SceneDelegate);
    }
    // End:0x78
    else
    {
        InstantOpenScene(SceneToOpen, Player, SceneDelegate, SceneAnim);
    }
    //return;    
}

function UIScene InstantOpenScene(UIScene SceneToOpen, LocalPlayer Player, optional delegate<OnSceneActivated> SceneDelegate, optional Engine.UIScene.ESceneTransitionAnim SceneAnim)
{
    local TdUIInteraction TdUIInter;
    local UIScene OpenedScene;
    local TdUIScene OpenedTdScene;

    SceneDelegate = None;
    SceneAnim = 2;
    // End:0x13C
    if(SceneToOpen != none)
    {
        InitializeScene(SceneToOpen, Player, OpenedScene);
        // End:0x13C
        if(OpenedScene != none)
        {
            // End:0x5E
            if(SceneDelegate != none)
            {
                OpenedScene.__OnSceneActivated__Delegate = SceneDelegate;
            }
            OpenScene(OpenedScene, Player, OpenedScene);
            OpenedTdScene = TdUIScene(OpenedScene);
            // End:0x13C
            if(OpenedTdScene != none)
            {
                TdUIInter = TdUIInteraction(GetCurrentUIController());
                // End:0x11E
                if(((SceneAnim == 0) || SceneAnim == 2) && OpenedTdScene.BeginShowAnimation())
                {
                    // End:0x106
                    if(OpenedTdScene.SceneInputMode != 0)
                    {
                        TdUIInter.BlockUIInput(true);
                    }
                    OpenedTdScene.SetAnimatingScene(true);
                }
                // End:0x13C
                else
                {
                    OpenedTdScene.OnSceneFullyOpened(OpenedTdScene);
                }
            }
        }
    }
    return OpenedTdScene;
    //return ReturnValue;    
}

function OpenMessageBox(delegate<OnSceneActivated> MsgBoxInit, optional Engine.UIScene.ESceneTransitionAnim SceneAnim)
{
    SceneAnim = 0;
    StoredMsgBoxInit = MsgBoxInit;
    OpenSceneEx(class'TdHUDContent'.static.GetUISceneByName('TdMessageBox'), Outer.Outer.Outer.GamePlayers[0], SceneAnim, OnMsgBoxInit);
    //return;    
}

