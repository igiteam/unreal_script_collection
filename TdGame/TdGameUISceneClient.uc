function OnMsgBoxInit(UIScene ActivatedScene, bool bInitialActivation)
{
    // End:0x64
    if(bInitialActivation)
    {
        ActivatedScene.bRequiresOnlineService = GetActiveScene().GetPreviousScene().bRequiresOnlineService;
        OnSceneActivated(ActivatedScene, bInitialActivation);
        StoredMsgBoxInit = None;
    }
    //return;    
}

function OpenLoadingScene(string Text, LocalPlayer Player, optional delegate<LoadingSceneOpened> SceneOpened, optional delegate<OnSceneFullyOpened> SceneFullyOpened)
{
    SceneOpened = None;
    SceneFullyOpened = None;
    __LoadingSceneOpened__Delegate = SceneOpened;
    __LoadingSceneFullyOpened__Delegate = SceneFullyOpened;
    LoadingSceneText = Text;
    OpenSceneEx(class'TdHUDContent'.static.GetUISceneByName('TdLoadIndicator'), Player,, LoadingScene_Init);
    //return;    
}

private final function LoadingScene_Init(UIScene OpenedScene, bool bInitialActivation)
{
    TdUIScene_LoadIndicator(OpenedScene).__OnSceneFullyOpened__Delegate = LoadingScene_FullyOpened;
    TdUIScene_LoadIndicator(OpenedScene).Setup(LoadingSceneText, false);
    TdUIScene_LoadIndicator(OpenedScene).bRenderParentScenes = false;
    OpenedScene.bRequiresOnlineService = GetActiveScene().GetPreviousScene().bRequiresOnlineService;
    LoadingSceneOpened(OpenedScene, bInitialActivation);
    __LoadingSceneOpened__Delegate = None;
    //return;    
}

function LoadingScene_FullyOpened(UIScene OpenedScene)
{
    LoadingSceneFullyOpened(OpenedScene);
    __LoadingSceneFullyOpened__Delegate = None;
    //return;    
}

function UIDataStore FindDataStore(name DataStoreTag, optional LocalPlayer InPlayerOwner)
{
    return GetCurrentUIController().DataStoreManager.super(TdGameUISceneClient).FindDataStore(DataStoreTag, InPlayerOwner);
    //return ReturnValue;    
}

function UIDataStore_TdGameData GetGameDataStore()
{
    return UIDataStore_TdGameData(FindDataStore(ResourceDataStoreName));
    //return ReturnValue;    
}

function NotifyGameSessionEnded()
{
    CloseDiskAccessScene();
    super.NotifyGameSessionEnded();
    //return;    
}

function NotifyOnlineServiceStatusChanged(Engine.OnlineSubsystem.EOnlineServerConnectionStatus NewConnectionStatus)
{
    super.NotifyOnlineServiceStatusChanged(NewConnectionStatus);
    // End:0x43
    if(((NewConnectionStatus != 1) && DiskAccessScene != none) && DiskAccessScene.bRequiresOnlineService)
    {
        CloseDiskAccessScene();
    }
    //return;    
}

