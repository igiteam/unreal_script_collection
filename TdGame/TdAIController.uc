function bool TdPointReachable(Vector aPoint, optional bool bTestBotPawns, optional float minTimeToCollision, optional float minDistFromLine)
{
    bTestBotPawns = false;
    minTimeToCollision = 0.0;
    minDistFromLine = Pawn.GetCollisionRadius() * float(2);
    // End:0x96
    if((((PathLimits != none) && PathLimits.bEnabled) && PathLimits.Contains(Pawn.Location)) && !PathLimits.Contains(aPoint))
    {
        return false;
    }
    // End:0xBE
    if(bTestBotPawns && IsAIBlockingPath(aPoint, minTimeToCollision, minDistFromLine) != none)
    {
        return false;
    }
    return PointReachable(aPoint);
    //return ReturnValue;    
}

function bool TdActorReachable(Actor anActor, optional bool bTestBotPawns, optional float minTimeToCollision, optional float minDistFromLine)
{
    bTestBotPawns = false;
    minTimeToCollision = 0.0;
    minDistFromLine = Pawn.GetCollisionRadius() * float(2);
    // End:0xA0
    if((((PathLimits != none) && PathLimits.bEnabled) && PathLimits.Contains(Pawn.Location)) && !PathLimits.Contains(anActor.Location))
    {
        return false;
    }
    // End:0xD2
    if(bTestBotPawns && IsAIBlockingPath(anActor.Location, minTimeToCollision, minDistFromLine) != none)
    {
        return false;
    }
    // End:0xF0
    if(anActor == Enemy)
    {
        return IsPredictedEnemyReachable();
    }
    // End:0xF9
    else
    {
        return ActorReachable(anActor);
    }
    //return ReturnValue;    
}

function Vector GetPredictedEnemyLocation()
{
    // End:0x1E
    if(Team != none)
    {
        return AIManager.LastSeenLocation;
    }
    // End:0x2E
    else
    {
        return Enemy.Location;
    }
    //return ReturnValue;    
}

function bool IsPredictedEnemyReachable(optional bool bTestBotPawns)
{
    bTestBotPawns = false;
    // End:0x52
    if(!bHasDoneEnemyReachableTest)
    {
        PredictedEnemyLocation = GetPredictedEnemyLocation();
        bEnemyIsReachable = TdPointReachable(PredictedEnemyLocation, bTestBotPawns);
        // End:0x52
        if(bEnemyIsReachable)
        {
            SucceededPathToEnemy(PredictedEnemyLocation);
        }
    }
    bHasDoneEnemyReachableTest = true;
    return bEnemyIsReachable;
    //return ReturnValue;    
}

function HoldFire(bool flag)
{
    // End:0x29
    if(flag)
    {
        bHoldFire = flag;
        ClearTimer('UnholdFire');
    }
    // End:0x4B
    else
    {
        Say(6);
        SetTimer(0.70, false, 'UnholdFire');
    }
    //return;    
}

function UnholdFire()
{
    bHoldFire = false;
    //return;    
}

