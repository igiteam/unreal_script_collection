event PostBeginPlay()
{
    super(Controller).PostBeginPlay();
    // End:0x60
    if(bUseVoiceOver)
    {
        VoiceOverManager = TdSPStoryGame(WorldInfo.Game).VoiceOverManager;
        // End:0x3E
        if(VoiceOverManager == none)
        {
        }
        voice = Percent_IntInt(VoiceOverManager.GetVoiceNumber(), 2);
    }
    AIManager = TdSPGame(WorldInfo.Game).AIManager;
    CurrentCover = new (self) class'TdCover';
    PawnFocus = new (self) class'TdFocusHandler';
    HeadFocus = new (self) class'TdHeadFocusHandler';
    RealAimBot = CreateAimBot();
    AimBot = RealAimBot;
    PerfectAimBot = new (self) class'TdAimBot_Perfect';
    Interruptable = new (self) class'TdBubbleStack';
    CoverController = Spawn(class'TdCoverController');
    GrenadeController = Spawn(class'TdAIGrenadeController');
    //return;    
}

event Possess(Pawn inPawn, bool bVehicleTransition)
{
    AIManager.Add(self);
    super(Controller).Possess(inPawn, bVehicleTransition);
    // End:0x84
    if(inPawn != none)
    {
        Pawn.SetMovementPhysics();
        myPawn = TdBotPawn(inPawn);
        myPawn.Initialize(self);
        NotifyChangedWeapon(none, Pawn.Weapon);
    }
    BotMeleeMove = TdMove_BotMelee(myPawn.Moves[17]);
    // End:0xC4
    foreach WorldInfo.AllPawns(class'TdPlayerPawn', Player)
    {
        // End:0xC4
        break;        
    }    
    PlayerController = TdPlayerController(Player.Controller);
    myPawn.SetRunnerVisionEnabled(PlayerController.IsAiRunnerVisionEnabled());
    ForceKeepMoving(TdAIKeepMovingVolume(Pawn.PhysicsVolume) != none);
    //return;    
}

event UnPossess()
{
    super(Controller).UnPossess();
    //return;    
}

event Initialize()
{
    HeadFocus.Initialize(self);
    CurrentCover.Initialize(self);
    PawnFocus.Initialize(self);
    Interruptable.Initialize(true, 10, self, 'Interruptable');
    CoverController.Initialize(myPawn);
    SetEnemy(Team.Enemy);
    //return;    
}

function ResetAI()
{
    Interruptable.Reset();
    myPawn.SetMove(1);
    ScriptActivated(false);
    ClearScreenLog();
    ClearMovementVariables();
    ClearTimer('TestCombatTransitions');
    ClearTimer('TestLastKnownLocationVisible');
    ClearTimer('CheckCurrentCover');
    //return;    
}

