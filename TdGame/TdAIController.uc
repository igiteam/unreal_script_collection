event HearNoise(float Loudness, Actor NoiseMaker, optional name NoiseType)
{
    local bool IsMovementNoise;

    // End:0x1B
    if((AIManager == none) || Team == none)
    {
        return;
    }
    // End:0x30
    if(AIManager.bPlayerInvisibleToAI)
    {
        return;
    }
    super(Controller).HearNoise(Loudness, NoiseMaker, NoiseType);
    // End:0x5A
    if(NoiseType == 'ChangedWeapon')
    {
        return;
    }
    IsMovementNoise = NoiseType == 'PlayerMovementNoise';
    // End:0x1E0
    if(((((((NoiseMaker.Instigator != none) && NoiseMaker.Instigator.Controller != none) && (Enemy == none) || Enemy == NoiseMaker.Instigator) && IsEnemy(NoiseMaker.Instigator.Controller)) && NoiseMaker.Instigator.Health > 0) && !scriptingActivated) && !EnemyVisible)
    {
        // End:0x1C6
        if(Enemy == none)
        {
            // End:0x19A
            if(IsMovementNoise)
            {
                // End:0x197
                if(NoiseMaker.Instigator.Physics == 1)
                {
                    Team.ReportNoise(NoiseMaker.Instigator.Location);
                }
            }
            // End:0x1C3
            else
            {
                Team.HeardEnemy(self, TdPawn(NoiseMaker.Instigator));
            }
        }
        // End:0x1E0
        else
        {
            Team.NoticedEnemy(self, myEnemy);
        }
    }
    //return;    
}

function bool AskToPathfindToEnemy()
{
    local bool Result;
    local Vector pos;

    // End:0x2F
    if(ShouldUsePlayerNavigationPoint())
    {
        pos = AIManager.PlayerNavigationPoint.Location;
    }
    // End:0x44
    else
    {
        pos = AIManager.LastSeenLocation;
    }
    Result = (((Pawn.Anchor != none) && !IsEnemyOnDifferentNetwork()) && (PathLimits == none) || PathLimits.Contains(pos)) && (!bFailedLastPathToEnemy || HasEnemyMovedSinceLastFailedPath()) || WorldInfo.TimeSeconds > OkToTryAgainTimeStamp;
    // End:0xD7
    if(!Result)
    {
    }
    return Result;
    //return ReturnValue;    
}

final function SucceededPathToEnemy(Vector GoalPosition)
{
    LastReachableEnemyPos = GoalPosition;
    bFailedLastPathToEnemy = false;
    // End:0x46
    if(VSize(GoalPosition - Pawn.Location) > float(2000))
    {
        Say(7);
    }
    //return;    
}

final function SetFailedPathToEnemy()
{
    // End:0x91
    if(Enemy != none)
    {
        bFailedLastPathToEnemy = true;
        OkToTryAgainTimeStamp = WorldInfo.TimeSeconds + (1.0 + (FRand() * 2.0));
        LastFailedPathLocation = AIManager.LastSeenLocation;
        // End:0x8E
        if(VSize(Enemy.Location - Pawn.Location) > 5000.0)
        {
            Say(20, 0.50);
        }
    }
    // End:0x97
    else
    {
        ScriptTrace();
    }
    //return;    
}

final function bool HasEnemyMovedSinceLastFailedPath()
{
    return VSizeSq(LastFailedPathLocation - AIManager.LastSeenLocation) > float(300 * 300);
    //return ReturnValue;    
}

