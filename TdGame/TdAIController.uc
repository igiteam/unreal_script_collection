event ClearRouteCache()
{
    // End:0x2A
    if(RouteCache.Length > 0)
    {
        BackupPath();
        UnoccupyPath();
        RouteCache_Empty();
    }
    //return;    
}

function BackupPath()
{
    local int I;
    local ReachSpec rs;

    ClearOldPath();
    // End:0x71
    if((Pawn.Anchor != none) && RouteCache.Length > 0)
    {
        rs = Pawn.Anchor.GetReachSpecTo(RouteCache[0]);
        // End:0x71
        if(rs != none)
        {
            OldPath[OldPath.Length] = rs;
        }
    }
    I = 0;
    J0x78:
    // End:0xC6 [Loop If]
    if(I < (RouteCache.Length - 1))
    {
        OldPath[OldPath.Length] = RouteCache[I].GetReachSpecTo(RouteCache[I + 1]);
        ++ I;
        // [Loop Continue]
        goto J0x78;
    }
    OldAnchor = Pawn.Anchor;
    //return;    
}

event ClearOldPath()
{
    OldPath.Remove(0, OldPath.Length);
    //return;    
}

function StoreMovementVariables()
{
    local int I;

    StoredMovementVars.OldPath.Remove(0, StoredMovementVars.OldPath.Length);
    I = 0;
    J0x2A:
    // End:0x62 [Loop If]
    if(I < OldPath.Length)
    {
        StoredMovementVars.OldPath.AddItem(OldPath[I]);
        ++ I;
        // [Loop Continue]
        goto J0x2A;
    }
    StoredMovementVars.RouteCache.Remove(0, StoredMovementVars.RouteCache.Length);
    I = 0;
    J0x8C:
    // End:0xC4 [Loop If]
    if(I < RouteCache.Length)
    {
        StoredMovementVars.RouteCache.AddItem(RouteCache[I]);
        ++ I;
        // [Loop Continue]
        goto J0x8C;
    }
    StoredMovementVars.MoveGoalIsEnemy = MoveGoalIsEnemy;
    StoredMovementVars.OldAnchor = OldAnchor;
    StoredMovementVars.Anchor = Pawn.Anchor;
    StoredMovementVars.MoveGoal = MoveGoal;
    StoredMovementVars.MovePoint = MovePoint;
    StoredMovementVars.HaltAfterMoveToGoal = HaltAfterMoveToGoal;
    StoredMovementVars.fCurrentRouteDistance = fCurrentRouteDistance;
    StoredMovementVars.bCurrentRouteContainsMoves = bCurrentRouteContainsMoves;
    StoredMovementVars.bFirstDestination = bFirstDestination;
    StoredMovementVars.PathfindingGoalPos = PathfindingGoalPos;
    StoredMovementVars.OldMoveTarget = OldMoveTarget;
    StoredMovementVars.MoveTarget = MoveTarget;
    StoredMovementVars.bSkipPathFind = bSkipPathFind;
    //return;    
}

function RestoreMovementVariables()
{
    local int I;

    UnoccupyPath();
    OldPath.Remove(0, OldPath.Length);
    RouteCache_Empty();
    I = 0;
    J0x28:
    // End:0x6B [Loop If]
    if(I < StoredMovementVars.OldPath.Length)
    {
        OldPath.AddItem(StoredMovementVars.OldPath[I]);
        ++ I;
        // [Loop Continue]
        goto J0x28;
    }
    I = 0;
    J0x72:
    // End:0xB5 [Loop If]
    if(I < StoredMovementVars.RouteCache.Length)
    {
        RouteCache.AddItem(StoredMovementVars.RouteCache[I]);
        ++ I;
        // [Loop Continue]
        goto J0x72;
    }
    OccupyPath();
    MoveGoalIsEnemy = StoredMovementVars.MoveGoalIsEnemy;
    OldAnchor = StoredMovementVars.OldAnchor;
    Pawn.SetAnchor(StoredMovementVars.Anchor);
    MoveGoal = StoredMovementVars.MoveGoal;
    MovePoint = StoredMovementVars.MovePoint;
    HaltAfterMoveToGoal = StoredMovementVars.HaltAfterMoveToGoal;
    fCurrentRouteDistance = StoredMovementVars.fCurrentRouteDistance;
    bCurrentRouteContainsMoves = StoredMovementVars.bCurrentRouteContainsMoves;
    bFirstDestination = StoredMovementVars.bFirstDestination;
    PathfindingGoalPos = StoredMovementVars.PathfindingGoalPos;
    OldMoveTarget = StoredMovementVars.OldMoveTarget;
    MoveTarget = StoredMovementVars.MoveTarget;
    bSkipPathFind = StoredMovementVars.bSkipPathFind;
    //return;    
}

function ClearMovementVariables()
{
    StoredMovementVars.OldPath.Remove(0, StoredMovementVars.OldPath.Length);
    StoredMovementVars.RouteCache.Remove(0, StoredMovementVars.RouteCache.Length);
    StoredMovementVars.OldAnchor = none;
    StoredMovementVars.Anchor = none;
    StoredMovementVars.MoveGoal = none;
    StoredMovementVars.OldMoveTarget = none;
    StoredMovementVars.MoveTarget = none;
    ClearOldPath();
    RouteCache_Empty();
    OldAnchor = none;
    // End:0xDB
    if(Pawn != none)
    {
        Pawn.SetAnchor(none);
    }
    MoveGoal = none;
    OldMoveTarget = none;
    MoveTarget = none;
    PathLimits = none;
    ClearMovementFlags();
    bFailedLastPathToEnemy = false;
    MoveTimer = -1.0;
    //return;    
}

function OccupyPath()
{
    local NavigationPoint P;

    // End:0x21
    foreach RouteCache(P,)
    {
        P.Occupy(self);        
    }    
    //return;    
}

function UnoccupyPath()
{
    local NavigationPoint P;

    // End:0x21
    foreach RouteCache(P,)
    {
        P.Unoccupy(self);        
    }    
    //return;    
}

function RemoveFromOccupied(NavigationPoint P)
{
    local int I;

    I = 0;
    J0x07:
    // End:0x45 [Loop If]
    if(I < OccupiedNodes.Length)
    {
        // End:0x3B
        if(P == OccupiedNodes[I])
        {
            OccupiedNodes.Remove(I, 1);
            // [Explicit Break]
            goto J0x45;
        }
        ++ I;
        J0x45:
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

function ClearPathFor(Controller C)
{
    // End:0x43
    if(myPawn.VelocityMagnitude2D < (myPawn.AnimationWalkSpeed + 10.0))
    {
        AdjustAround(C.Pawn);
    }
    //return;    
}

function bool AdjustAround(Pawn Other)
{
    local Vector VelDir, OtherDir, SideDir, HitLocation, HitNormal, TestLoc,
	    MoveToPos;

    // End:0x11
    if(!IsInLatentMovement())
    {
        return false;
    }
    // End:0x37
    if(InLatentExecution(503))
    {
        MoveToPos = MoveTarget.Location;
    }
    // End:0x42
    else
    {
        MoveToPos = Destination;
    }
    VelDir = Normal(MoveToPos - Pawn.Location);
    VelDir.Z = 0.0;
    OtherDir = Other.Location - Pawn.Location;
    OtherDir.Z = 0.0;
    OtherDir = Normal(OtherDir);
    // End:0x2C2
    if((VelDir Dot OtherDir) > 0.50)
    {
        bAdjusting = true;
        SideDir.X = VelDir.Y;
        SideDir.Y = -VelDir.X;
        // End:0x143
        if((SideDir Dot OtherDir) > float(0))
        {
            SideDir *= float(-1);
        }
        AdjustLoc = Other.Location + (((Other.GetCollisionRadius() + Pawn.GetCollisionRadius()) * 1.20) * SideDir);
        TestLoc = AdjustLoc + (Pawn.GetCollisionRadius() * SideDir);
        // End:0x2BD
        if(Trace(HitLocation, HitNormal, TestLoc, Pawn.Location, false) != none)
        {
            SideDir *= float(-1);
            AdjustLoc = Other.Location + (((Other.GetCollisionRadius() + Pawn.GetCollisionRadius()) * 1.20) * SideDir);
            TestLoc = AdjustLoc + (Pawn.GetCollisionRadius() * SideDir);
            // End:0x2BD
            if(Trace(HitLocation, HitNormal, AdjustLoc, Pawn.Location, false) != none)
            {
                AdjustLoc = HitLocation - (Pawn.GetCollisionRadius() * SideDir);
            }
        }
        return true;
    }
    // End:0x2C4
    else
    {
        return false;
    }
    //return ReturnValue;    
}

