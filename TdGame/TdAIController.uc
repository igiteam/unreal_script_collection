function bool OkToMoveDirectlyToPoint()
{
    local bool Result;
    local float dotti;

    dotti = vector(Pawn.Rotation) Dot Normal(MovePoint - Pawn.Location);
    Result = ((!IsRunning() || (RouteCache.Length <= 1) && (dotti > 0.950) || dotti < -0.950) && PointReachable(MovePoint)) && (PathLimits == none) || PathLimits.Contains(MovePoint);
    return Result;
    //return ReturnValue;    
}

function bool OkToMoveDirectlyToActor()
{
    return ((RouteCache.Length <= 1) && ActorReachable(MoveGoal)) && (PathLimits == none) || PathLimits.Contains(MoveGoal.Location);
