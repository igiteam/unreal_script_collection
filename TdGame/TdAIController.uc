function bool CanSwitchDirection()
{
    return (((CoverDirection != 1) && CurrentCover.bLeanRight) || (CoverDirection != 2) && CurrentCover.bLeanLeft) || (CoverDirection != 3) && CurrentCover.bCanPopUp;
    //return ReturnValue;    
}

function SwitchDirection()
{
    // End:0x39
    if(CoverDirection == 1)
    {
        // End:0x2E
        if(CurrentCover.bLeanLeft)
        {
            CoverDirection = 2;
        }
        // End:0x36
        else
        {
            CoverDirection = 3;
        }
    }
    // End:0x98
    else
    {
        // End:0x72
        if(CoverDirection == 2)
        {
            // End:0x67
            if(CurrentCover.bCanPopUp)
            {
                CoverDirection = 3;
            }
            // End:0x6F
            else
            {
                CoverDirection = 1;
            }
        }
        // End:0x98
        else
        {
            // End:0x90
            if(CurrentCover.bLeanRight)
            {
                CoverDirection = 1;
            }
            // End:0x98
            else
            {
                CoverDirection = 2;
            }
        }
    }
    //return;    
}

