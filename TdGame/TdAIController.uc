function UpdatePawnFocus()
{
    // End:0x83
    if((IsWalkingToNode() && (myPawn.CurrentWalkingState != 4) || PawnFocus.CurrentFocus == 1) && RouteCache.Length > 1)
    {
        SetFocus(1);
        PawnFocus.SetFocalPoint(RouteCache[1].Location);
    }
    // End:0x1D8
    else
    {
        // End:0xFB
        if((FireWeapon && myPawn.IsInMove(41)) && TdMove_BotStop(myPawn.Moves[41]).GetStopAnimationStarted())
        {
            // End:0xF8
            if(PawnFocus.CurrentFocus != 2)
            {
                SetFocus(2);
            }
        }
        // End:0x1D8
        else
        {
            // End:0x178
            if(((myPawn.CurrentWalkingState == 4) || (IsInLatentMovement()) && !myPawn.GetIsWalkingFlagSet()) || myPawn.IsForcedToWalk() && myPawn.WantsToRun())
            {
                SetFocus(3);
            }
            // End:0x1D8
            else
            {
                // End:0x1BE
                if(myTemplate.CanUseSuppressionFire && OkToLaySuppressionFire())
                {
                    SetFocus(1);
                    PawnFocus.SetFocalPoint(LastActuallySeenLocation);
                }
                // End:0x1D8
                else
                {
                    // End:0x1D8
                    if(!IsInCover)
                    {
                        SetFocus(WantedFocus);
                    }
                }
            }
        }
    }
    //return;    
}

function SetWantedFocus(TdFocusHandler.FocusType F)
{
    WantedFocus = F;
    UpdatePawnFocus();
    //return;    
}

function SetFocus(TdFocusHandler.FocusType F)
{
    PawnFocus.SetFocus(F);
    //return;    
}

function UpdatePose()
{
    // End:0x38
    if((IsInLatentMovement()) && myPawn.CurrentWalkingState > 2)
    {
        SetPose(0);
    }
    // End:0x90
    else
    {
        // End:0x84
        if(WantedPose == 1)
        {
            // End:0x75
            if((IsInLatentMovement()) || EnemyDistance2d < CrouchRange)
            {
                SetWantedPose(0);
            }
            // End:0x81
            else
            {
                SetPose(1);
            }
        }
        // End:0x90
        else
        {
            SetPose(0);
        }
    }
    //return;    
}

function SetWantedPose(TdBotPawn.EPose P)
{
    WantedPose = P;
    UpdatePose();
    //return;    
}

