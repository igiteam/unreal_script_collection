    SetCoverAction(3);
    CurrentCover.bAlwaysValid = true;
    CurrentCover.PickClosestCover();
    DropCover(true, false);
    SetIsInCover(false);
    TdGotoState('DebugCoverState', 'Begin');
Random:

    SetCoverAction(3);
    CurrentCover.bAlwaysValid = true;
    CurrentCover.PickRandomCover();
    DropCover(true, false);
    SetIsInCover(false);
    TdGotoState('DebugCoverState', 'Random');
    stop;        
}

