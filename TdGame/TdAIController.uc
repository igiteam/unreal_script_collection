function ClaimCover(TdCover NewCover, optional bool CheckCover)
{
    CheckCover = false;
    DropCover(false, false);
    // End:0x2C
    if(CurrentCover != NewCover)
    {
        CurrentCover = NewCover;
    }
    CurrentCover.Claim();
    // End:0x5C
    if(CheckCover)
    {
        SetTimer(0.30, true, 'CheckCurrentCover');
    }
    //return;    
}

