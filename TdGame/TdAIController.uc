function bool IsLastActuallySeenLocationWithinDot(float dotValue)
{
    local Vector r1, r2;

    r1 = LastActuallySeenLocation - Pawn.Location;
    r1.Z = 0.0;
    r1 = Normal(r1);
    r2 = vector(Pawn.Rotation);
    return (r1 Dot r2) > dotValue;
    //return ReturnValue;    
}

function bool IsEnemyWithinDot(float dotValue)
{
    return EnemyDot > dotValue;
    //return ReturnValue;    
}

event Crouch(bool flag)
{
    // End:0x18
    if(flag)
    {
        SetWantedPose(1);
    }
    // End:0x24
    else
    {
        SetWantedPose(0);
    }
    //return;    
}

function bool UpdatePath()
{
    // End:0x19
    if(IsOkToUpdatePath())
    {
        AbortMovement();
        return true;
    }
    return false;
    //return ReturnValue;    
}

function AbortMoveTo()
{
    // End:0x13
    if(IsInLatentMovement())
    {
        StopLatentExecution();
    }
    //return;    
}

function AbortMovement()
{
    // End:0x1A
    if(IsInState('SubAction_MoveToGoal'))
    {
        PopState();
    }
    // End:0x24
    else
    {
        AbortMoveTo();
    }
    //return;    
}

function bool IsInLatentMovement()
{
    return InLatentExecution(503) || InLatentExecution(501);
    //return ReturnValue;    
}

