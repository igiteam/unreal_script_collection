function NotifyDamage(Controller InstigatedBy, class<DamageType> DamageType, int Damage)
{
    // End:0x3A
    if(((InstigatedBy == none) || InstigatedBy.Pawn == none) || !IsEnemy(InstigatedBy))
    {
        return;
    }
    AddSuppressionFactor(SuppressionFactorForDirectHit);
    // End:0x5C
    if(class<TdDmgType_Bullet>(DamageType) != none)
    {
    }
    // End:0x98
    else
    {
        // End:0x98
        if(class<TdDmgType_Melee>(DamageType) != none)
        {
            // End:0x89
            if(Damage == 0)
            {
                Say(11);
            }
            // End:0x98
            else
            {
                Say(10);
            }
        }
    }
    // End:0xC8
    if((EnemyVisible && !IsInCover) && !myPawn.bForceWaitForDamage)
    {
    }
    // End:0xF1
    else
    {
        Team.NotifyDamage(self, TdPawn(InstigatedBy.Pawn));
    }
    //return;    
}

function ReportNearMiss(float Distance)
{
    local float S, distFactor;

    // End:0x5C
    if(EnemyVisible)
    {
        distFactor = 1.0 - (Distance / SuppressionDistance);
        distFactor *= distFactor;
        S = distFactor * SuppressionFactorForDirectHit;
        // End:0x5C
        if(S > float(0))
        {
            AddSuppressionFactor(S);
        }
    }
    //return;    
}

function AddSuppressionFactor(float S)
{
    Say(27);
    // End:0x28
    if(Suppression >= float(0))
    {
        Suppression += S;
    }
    // End:0x4A
    if(Suppression >= float(1))
    {
        Suppression = -1.0;
        NotifySuppressed();
    }
    //return;    
}

