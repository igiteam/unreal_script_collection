function SetDifficultyLevel(int Difficulty)
{
    // End:0x0D
    if(myTemplate == none)
    {
        return;
    }
    DifficultyLevel = Difficulty;
    // End:0x1C6
    if(myPawn.bChaseAI)
    {
        switch(Difficulty)
        {
            // End:0xB8
            case 0:
                AimBot.ImprovementRate_Far = myTemplate.ImprovementRates_Far_CHASE.Easy;
                AimBot.ImprovementRate_Medium = myTemplate.ImprovementRates_Medium_CHASE.Easy;
                AimBot.ImprovementRate_Near = myTemplate.ImprovementRates_Near_CHASE.Easy;
                // End:0x1C3
                break;
            // End:0x13D
            case 1:
                AimBot.ImprovementRate_Far = myTemplate.ImprovementRates_Far_CHASE.Medium;
                AimBot.ImprovementRate_Medium = myTemplate.ImprovementRates_Medium_CHASE.Medium;
                AimBot.ImprovementRate_Near = myTemplate.ImprovementRates_Near_CHASE.Medium;
                // End:0x1C3
                break;
            // End:0x1C0
            case 2:
                AimBot.ImprovementRate_Far = myTemplate.ImprovementRates_Far_CHASE.Hard;
                AimBot.ImprovementRate_Medium = myTemplate.ImprovementRates_Medium_CHASE.Hard;
                AimBot.ImprovementRate_Near = myTemplate.ImprovementRates_Near_CHASE.Hard;
            // End:0xFFFF
            default:
                // End:0x35E
                break;
            }
    }
    switch(Difficulty)
    {
        // End:0x253
        case 0:
            AimBot.ImprovementRate_Far = myTemplate.ImprovementRates_Far.Easy;
            AimBot.ImprovementRate_Medium = myTemplate.ImprovementRates_Medium.Easy;
            AimBot.ImprovementRate_Near = myTemplate.ImprovementRates_Near.Easy;
            // End:0x35E
            break;
        // End:0x2D8
        case 1:
            AimBot.ImprovementRate_Far = myTemplate.ImprovementRates_Far.Medium;
            AimBot.ImprovementRate_Medium = myTemplate.ImprovementRates_Medium.Medium;
            AimBot.ImprovementRate_Near = myTemplate.ImprovementRates_Near.Medium;
            // End:0x35E
            break;
        // End:0x35B
        case 2:
            AimBot.ImprovementRate_Far = myTemplate.ImprovementRates_Far.Hard;
            AimBot.ImprovementRate_Medium = myTemplate.ImprovementRates_Medium.Hard;
            AimBot.ImprovementRate_Near = myTemplate.ImprovementRates_Near.Hard;
        // End:0xFFFF
        default:
            // End:0x382
            if(myPawn != none)
            {
                myPawn.SetDifficultyLevel(Difficulty);
            }
            //return;
    }    
}

final function int RetrieveDifficultyLevel()
{
    local TdPlayerController P;

    // End:0x35
    foreach LocalPlayerControllers(class'TdPlayerController', P)
    {
        // End:0x34
        if(P != none)
        {            
            return P.GetDifficultyLevel();
        }        
    }    
    return 1;
    //return ReturnValue;    
}

simulated event int SetupTemplate(AITemplate TheTemplate)
{
    switch(SetupTemplateCount)
    {
        // End:0x157
        case 0:
            myTemplate = TheTemplate;
            AimBot.MaxDispersion = TheTemplate.Dispersion_Max;
            AimBot.MinDispersion = TheTemplate.Dispersion_Min;
            AimBot.MinOffset = TheTemplate.HorizontalOffset_Min;
            AimBot.MaxYOffset = TheTemplate.VerticalOffset_Max;
            AimBot.MinYOffset = TheTemplate.VerticalOffset_Min;
            AimBot.MoveSidewaysMultiplier = TheTemplate.MoveSidewaysMultiplier;
            AimBot.MoveAwayMultiplier = TheTemplate.MoveAwayMultiplier;
            AimBot.MoveTowardMultiplier = TheTemplate.MoveTowardMultiplier;
            AimBot.MovementRateX = TheTemplate.MovementRate_Horizontal;
            AimBot.MovementRateY = TheTemplate.MovementRate_Vertical;
            ++ SetupTemplateCount;
            // End:0x389
            break;
        // End:0x222
        case 1:
            AimBot.SetWeapon(myPawn.Weapon);
            SuppressionRecoveryTime = TheTemplate.SuppressionRecoveryTime;
            SuppressionDeclineTime = TheTemplate.SuppressionDeclineTime;
            SuppressionDistance = TheTemplate.SuppressionDistance;
            SuppressionFactorForDirectHit = TheTemplate.SuppressionFactorForDirectHit;
            RotationSpeedCFG = TheTemplate.RotationSpeed;
            bMuted = TheTemplate.bMute;
            MeleePredictionTime = TheTemplate.GetRandomMeleePredictionTime();
            ++ SetupTemplateCount;
            // End:0x389
            break;
        // End:0x386
        case 2:
            myPawn.LegOffsetWalkFwd = TheTemplate.LegOffsetWalkFwd;
            myPawn.LegOffsetWalkLeft60 = TheTemplate.LegOffsetWalkLeft60;
            myPawn.LegOffsetWalkLeftBwd120 = TheTemplate.LegOffsetWalkLeftBwd120;
            myPawn.LegOffsetWalkRight60 = TheTemplate.LegOffsetWalkRight60;
            myPawn.LegOffsetWalkRightBwd120 = TheTemplate.LegOffsetWalkRightBwd120;
            myPawn.LegOffsetWalkBack = TheTemplate.LegOffsetWalkBack;
            myPawn.LegOffsetRunFwd = TheTemplate.LegOffsetRunFwd;
            myPawn.LegOffsetRunLeft90 = TheTemplate.LegOffsetRunLeft90;
            myPawn.LegOffsetRunLeft180 = TheTemplate.LegOffsetRunLeft180;
            myPawn.LegOffsetRunRight90 = TheTemplate.LegOffsetRunRight90;
            myPawn.LegOffsetRunRight180 = TheTemplate.LegOffsetRunRight180;
            ++ SetupTemplateCount;
            // End:0x389
            break;
        // End:0xFFFF
        default:
            return SetupTemplateCount - 2;
    }
    //return ReturnValue;    
}

