state TestingState_Test extends TdTestingState
{
    function RunTest()
    {
        local CoverSlotMarker From, To;

        // End:0x3B
        foreach WorldInfo.AllActors(class'CoverSlotMarker', From)
        {
            // End:0x3A
            if(From.Name == 'CoverSlotMarker')
            {
                // End:0x3B
                break;
            }            
        }        
        // End:0x77
        foreach WorldInfo.AllActors(class'CoverSlotMarker', To)
        {
            // End:0x76
            if(To.Name == 'CoverSlotMarker')
            {
                // End:0x77
                break;
            }            
        }        
        // End:0xD4
        if((From != none) && To != none)
        {
            Pawn.SetLocation(From.Location);
            Pawn.SetAnchor(From);
            TdFindPathToward(To);
        }
        //return;        
    }

Begin:
    RunTest();
    Sleep(0.10);
    goto 'Begin';
    stop;                
}

state TestingState_TestCovers extends TdTestingState
{
    function int TestCovers()
    {
        local CoverLink cLink;
        local int SlotIdx, corruptCount;

        cLink = WorldInfo.CoverList;
        J0x15:
        // End:0xF8 [Loop If]
        if(cLink != none)
        {
            SlotIdx = 0;
            J0x27:
            // End:0xE0 [Loop If]
            if(SlotIdx < cLink.Slots.Length)
            {
                // End:0x9A
                if((Pawn.Anchor.NetworkID & PathNetworkMask) != (cLink.Slots[SlotIdx].SlotMarker.NetworkID & PathNetworkMask))
                {
                    // [Explicit Continue]
                    goto J0xD6;
                }
                TdFindPathToward(cLink.Slots[SlotIdx].SlotMarker);
                // End:0xD6
                if(MoveTarget == none)
                {
                    ++ corruptCount;
                }
                J0xD6:
                ++ SlotIdx;
                // [Loop Continue]
                goto J0x27;
            }
            cLink = cLink.NextCoverLink;
            // [Loop Continue]
            goto J0x15;
        }
        return corruptCount;
        //return ReturnValue;        
    }

Begin:
    stop;                
}

state TestingState_Run extends TdTestingState
{
    function BeginState(name PreviousStateName)
    {
        super.BeginState(PreviousStateName);
        //return;        
    }

Begin:
    tempDest = none;
    Halt();
    Sleep(1.0);
    J0x19:
    // End:0x63 [Loop If]
    if((tempDest == none) || Abs(VSize2D(tempDest.Location - Pawn.Location)) < float(200))
    {
        tempDest = FindRandomDest();
        // [Loop Continue]
        goto J0x19;
    }
    // End:0x7E
    if(SetMoveGoal(tempDest))
    {
        MoveToTarget();
    }
    Sleep(0.030);
    goto 'loop';
    stop;                
}

state DebugCoverState
{
    function BeginState(name PreviousStateName)
    {
        super(Object).BeginState(PreviousStateName);
        SetInterruptable(false, 'Debug');
        HeadFocus.PushEnabled(false, 'DebugCoverState');
        //return;        
    }

    function EndState(name NextStateName)
    {
        super(Object).EndState(NextStateName);
        SetInterruptable(true, 'Debug');
        HeadFocus.PopEnabled('DebugCoverState');
        //return;        
    }

    function ContinuedState()
    {
        super(Object).ContinuedState();
        //return;        
    }

    event Tick(float DeltaTime)
    {
        // End:0x23
        if(WorldInfo.Game.IsTdPaused())
        {
            return;
        }
        UpdatePose();
        UpdatePawnFocus();
        HeadFocus.Tick(DeltaTime);
        //return;        
    }

    function UpdatePawnFocus()
    {
        SetFocus(2);
        //return;        
    }

Begin:
    CurrentCover.bAlwaysValid = true;
    CurrentCover.PickClosestCover();
    bForceValidCoverDirection = true;
    ForcedCoverDirection = 1;
    MoveToCover();
    goto 'End';
Random:

    CurrentCover.bAlwaysValid = true;
    CurrentCover.PickRandomCover();
    bForceValidCoverDirection = true;
    ForcedCoverDirection = 1;
    MoveToCover();
    goto 'End';
End:

    stop;        
}

