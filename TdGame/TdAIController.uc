    // End:0x2F
    if(AIManager.bPlayerInvisibleToAI)
    {
        return;
    }
    // End:0x46
    if(P.Health <= 0)
    {
        return;
    }
    LastActuallySeenLocation = TdPawn(P).GetViewpointLocation();
    // End:0x73
    if(Team == none)
    {
        return;
    }
    // End:0x9F
    if(!bPlayerSeenForReal)
    {
        bPlayerSeenForReal = true;
        AIManager.NotifyPlayerSpotted(P);
    }
    HandleEnemySeen(P);
    //return;    
}

