event Say(int VO, optional float probability, optional int answer, optional float answerprob)
{
    probability = 1.0;
    answer = 33;
    answerprob = 1.0;
    // End:0x30
    if(!bUseVoiceOver || bMuted)
    {
        return;
    }
    // End:0x97
    if(FRand() < probability)
    {
        // End:0x73
        if(FRand() < answerprob)
        {
            VoiceOverManager.TriggerVO(myPawn, VO, voice, answer);
        }
        // End:0x97
        else
        {
            VoiceOverManager.TriggerVO(myPawn, VO, voice);
        }
    }
    //return;    
}

