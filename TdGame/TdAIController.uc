function CoverGoToState(string iState)
{
    // End:0x22
    if(iState == "E")
    {
        CoverController.DebugCoverAction = 2;
    }
    // End:0xE9
    else
    {
        // End:0x44
        if(iState == "X")
        {
            CoverController.DebugCoverAction = 3;
        }
        // End:0xE9
        else
        {
            // End:0x66
            if(iState == "I")
            {
                CoverController.DebugCoverAction = 4;
            }
            // End:0xE9
            else
            {
                // End:0x91
                if(iState == "AL")
                {
                    CoverController.DebugCoverAction = 5;
                    CoverDirection = 2;
                }
                // End:0xE9
                else
                {
                    // End:0xBC
                    if(iState == "AR")
                    {
                        CoverController.DebugCoverAction = 6;
                        CoverDirection = 1;
                    }
                    // End:0xE9
                    else
                    {
                        // End:0xE7
                        if(iState == "AU")
                        {
                            CoverController.DebugCoverAction = 7;
                            CoverDirection = 3;
                        }
                        // End:0xE9
                        else
                        {
                            return;
                        }
                    }
                }
            }
        }
    }
    PushState('DebugCoverChangePositionState');
    //return;    
}

