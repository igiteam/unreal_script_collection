function StopHere()
{
    // End:0x103
    if(((myPawn.MovementState != 41) && myPawn.MovementState != 45) && ((VSizeSq(myPawn.Velocity) != float(0)) || VSizeSq(myPawn.Acceleration) != float(0)) || myPawn.MovementState != 1)
    {
        // End:0xC4
        if(myPawn.CanDoMove(41))
        {
            myPawn.SetMove(41);
        }
        // End:0x100
        else
        {
            // End:0xF6
            if(myPawn.MovementState != 1)
            {
                myPawn.SetMove(1);
            }
            Halt();
        }
        J0x103:
    }
    // End:0x103
    else
    {
    }
    //return;    
}

