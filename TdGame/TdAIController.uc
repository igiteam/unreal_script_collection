function bool IsInCombat()
{
    return IsTimerActive('TestCombatTransitions');
    //return ReturnValue;    
}

function UpdateCombatState()
{
    // End:0x18
    if(Enemy != none)
    {
        StartTestingCombatTransitions();
    }
    // End:0x5F
    else
    {
        ClearTimer('TestCombatTransitions');
        ClearTimer('TestLastKnownLocationVisible');
        TdGotoState('Idle',, "Exited combat state",, true);
    }
    //return;    
}

