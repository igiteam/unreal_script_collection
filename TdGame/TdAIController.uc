function SetAnimationProperties(name AnimationName, float PlayRate, float BlendInTime, float BlendOutTime, bool bUseRootMotion, bool bUseRootRotation, bool bLoopAnimation, int FinalAnimationState)
{
    local TdMove_AnimationPlayback AnimationPlaybackMove;

    AnimationPlaybackMove = TdMove_AnimationPlayback(myPawn.Moves[74]);
    AnimationPlaybackMove.SetAnimationName(AnimationName);
    AnimationPlaybackMove.SetPlayRate(PlayRate);
    AnimationPlaybackMove.SetBlendTime(BlendInTime, BlendOutTime);
    AnimationPlaybackMove.UseRootMotion(bUseRootMotion);
    AnimationPlaybackMove.UseRootRotation(bUseRootRotation);
    AnimationPlaybackMove.SetLoopAnimation(bLoopAnimation);
    AnimationPlaybackMove.ForceToIdle(FinalAnimationState == 1);
    //return;    
}

function OnAnimationPlaybackStart()
{
    Halt();
    HeadFocus.PushEnabled(false, 'AnimationPlayback');
    myPawn.myAnimationController.SetAimState(0, 0.20, false);
    myPawn.UseLegRotation(false);
    bAnimationPlaybackInterrupted = false;
    //return;    
}

function OnAnimationPlaybackExit()
{
    HeadFocus.PopEnabled('AnimationPlayback');
    myPawn.myAnimationController.SetAimState(1, 0.20, true);
    myPawn.UseLegRotation(true);
    StopAnimationPlayback();
    //return;    
}

