function ReportBotDied()
{
    // End:0x28
    if(bUseVoiceOver)
    {
        VoiceOverManager.RemoveSpeaker(self.Pawn);
    }
    AIManager.RemoveBot(self);
    // End:0x64
    if(Team != none)
    {
        Team.RemoveMember(self);
        Team = none;
    }
    // End:0xA8
    if(CurrentCover.HasClaimedCover())
    {
        CurrentCover.MarkAsTemporaryInvalid(20.0);
        CurrentCover.Drop();
    }
    ResetAI();
    TdGotoState('TdDead',, string(GetFuncName()));
    //return;    
}

