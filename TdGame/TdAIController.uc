function bool ShouldStopAfterMove()
{
    local Vector Dir, P1, P2, pathDir;
    local bool Result;

    // End:0x0F
    if(PointsLeftInPath() < 2)
    {
        return true;
    }
    // End:0x26
    if(Pawn.Anchor == none)
    {
        return false;
    }
    // End:0x32
    if(IsForcedToWalkToNextNode(1))
    {
        return true;
    }
    Dir = RouteCache[0].Location - Pawn.Anchor.Location;
    Dir.Z = 0.0;
    Dir = Normal(Dir);
    P1 = RouteCache[0].Location;
    // End:0xC4
    if(RouteCache.Length > 1)
    {
        P2 = RouteCache[1].Location;
    }
    // End:0xCF
    else
    {
        P2 = MovePoint;
    }
    pathDir = P2 - P1;
    pathDir.Z = 0.0;
    pathDir = Normal(pathDir);
    Result = (pathDir Dot Dir) < 0.70;
    // End:0x127
    if(Result)
    {
    }
    return Result;
    //return ReturnValue;    
}

function NotifyBossFightOver()
{
    local int I;
    local Sequence GameSequence;
    local array<SequenceObject> BossEvents;

    GameSequence = WorldInfo.GetGameSequence();
    GameSequence.FindSeqObjectsByClass(class'SeqEvt_TdBossfightOver', true, BossEvents);
    I = 0;
    J0x38:
    // End:0x72 [Loop If]
    if(I < BossEvents.Length)
    {
        SequenceEvent(BossEvents[I]).CheckActivate(self, self);
        ++ I;
        // [Loop Continue]
        goto J0x38;
    }
    //return;    
}

