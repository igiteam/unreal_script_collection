function ActivateStasis(bool flag, bool UpdateState)
{
    bStasis = flag;
    // End:0x5C
    if(flag)
    {
        TdGotoState('Stasis',, "Triggered Stasis",, true);
        AIManager.RemoveBot(self);
        Reset();
    }
    // End:0xD1
    else
    {
        // End:0x99
        if(UpdateState && IsInState('Stasis'))
        {
            TdGotoState('WhatToDo',, "Removed stasis",, true);
        }
        AIManager.Add(self);
        SetEnemy(Team.Enemy);
        UpdateCombatState();
    }
    CoverController.bStasis = flag;
    CoverController.LastRenderTime = -999.0;
    GrenadeController.bStasis = flag;
    GrenadeController.LastRenderTime = -999.0;
    //return;    
}

