function bool TdFindPathToward(Actor anActor)
{
    AIManager.RegisterPathfind(self);
    PathfindingGoalPos = anActor.Location;
    ClearRouteCache();
    // End:0x58
    if(myPawn.CurrentWalkingState == 0)
    {
        ClearOldPath();
    }
    SetMoveTarget(FindPathToward(anActor));
    UpdateCurrentRouteDist();
    // End:0x91
    if(MoveTarget == none)
    {
        // End:0x8F
        if(anActor == Enemy)
        {
            SetFailedPathToEnemy();
        }
        return false;
    }
    OccupyPath();
    // End:0xBF
    if(anActor == Enemy)
    {
        SucceededPathToEnemy(anActor.Location);
    }
    return true;
    //return ReturnValue;    
}

function TdFindPathTo(Vector aPoint)
{
    AIManager.RegisterPathfind(self);
    PathfindingGoalPos = aPoint;
    ClearRouteCache();
    // End:0x4E
    if(myPawn.CurrentWalkingState == 0)
    {
        ClearOldPath();
    }
    SetMoveTarget(FindPathTo(aPoint));
    UpdateCurrentRouteDist();
    // End:0x90
    if(MoveTarget == none)
    {
        // End:0x8E
        if(aPoint == AIManager.LastSeenLocation)
        {
            SetFailedPathToEnemy();
        }
        return;
    }
    OccupyPath();
    // End:0xBE
    if(aPoint == AIManager.LastSeenLocation)
    {
        SucceededPathToEnemy(aPoint);
    }
    //return;    
}

