// Export UTdAIController::execPreSuperTick(FFrame&, void* const)
native final function PreSuperTick(float DeltaTime);

// Export UTdAIController::execPostSuperTick(FFrame&, void* const)
native final function PostSuperTick(float DeltaTime);

event Tick(float DeltaTime)
{
    // End:0x0D
    if(Team == none)
    {
        return;
    }
    // End:0x2F
    if((Pawn == none) || myPawn.IsDead())
    {
        return;
    }
    PreSuperTick(DeltaTime);
    // End:0xAD
    if(!bIsImmobile)
    {
        // End:0x86
        if(myPawn.bHasStoppedAtFinalGoal && !IsInState('SubAction_MoveToGoal'))
        {
            myPawn.bHasStoppedAtFinalGoal = false;
            bStopMoveToGoal = false;
        }
        // End:0xAD
        if(UpdatePathInFrames > 0)
        {
            -- UpdatePathInFrames;
            // End:0xAD
            if(UpdatePathInFrames == 0)
            {
                ForceNewPath();
            }
        }
    }
    UpdatePawnFocus();
    UpdatePose();
    super(Actor).Tick(DeltaTime);
    PostSuperTick(DeltaTime);
    UpdateFiringMood();
    CurrentAimDispersion = AimBot.GetDispersionModifier();
    //return;    
}

// Export UTdAIController::execUpdateAnchor(FFrame&, void* const)
native function UpdateAnchor();

// Export UTdAIController::execSetBestAnchor(FFrame&, void* const)
native function SetBestAnchor();

event NoReachableAnchor()
{
    // End:0x6C
    if((!IsInState(MeleeState) && !IsInState('NoAnchor')) && !TryToTeleportToNearestAnchor())
    {
        TdGotoState('NoAnchor',, "Because we can't find a valid anchor!");
    }
    //return;    
}

function bool TryToTeleportToNearestAnchor()
{
    local NavigationPoint A;
    local Vector PlayerToAnchorDir, PlayerToBotDir, ViewLocation, ViewDirection;
    local Rotator ViewRotation;

    // End:0x1A
    if((Player == none) || PlayerController == none)
    {
        return false;
    }
    PlayerController.GetPlayerViewPoint(ViewLocation, ViewRotation);
    ViewDirection = vector(ViewRotation);
    PlayerToBotDir = Normal(Pawn.Location - ViewLocation);
    // End:0x7B
    if((PlayerToBotDir Dot ViewDirection) > 0.0)
    {
        return false;
    }
    A = GetNearestAnchor();
    // End:0x94
    if(A == none)
    {
        return false;
    }
    PlayerToAnchorDir = Normal(A.Location - ViewLocation);
    // End:0xCA
    if((PlayerToAnchorDir Dot ViewDirection) > 0.0)
    {
        return false;
    }
    // End:0x104
    if(Pawn.SetLocation(A.Location))
    {
        Pawn.SetAnchor(A);
        return true;
    }
    return false;
    //return ReturnValue;    
}

