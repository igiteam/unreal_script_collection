function TdAIController.EDisarmState QueryDisarmState(TdPawn Disarmer)
{
    local float RotationDot;

    RotationDot = vector(Disarmer.Rotation) Dot vector(myPawn.Rotation);
    // End:0x3C
    if(RotationDot > 0.80)
    {
        return 2;
    }
    // End:0xBC
    if(((myPawn.MovementState != 17) && RotationDot < 0.80) || myPawn.Moves[17].MoveActiveTime < (myTemplate.DisarmWindow * TdPlayerController(Disarmer.Controller).DisarmTimeMultiplier))
    {
        return 1;
    }
    return 2;
    //return ReturnValue;    
}

function bool StartCannedMove(int Move)
{
    TdGotoState('CannedMove',, string(GetFuncName()) @ string(Move),, true);
    // End:0x8F
    if(IsInState('CannedMove'))
    {
        switch(Move)
        {
            // End:0x6A
            case 36:
                myPawn.SetMove(36);
                Say(25);
                // End:0x8D
                break;
            // End:0x8A
            case 82:
                myPawn.SetMove(82);
                // End:0x8D
                break;
            // End:0xFFFF
            default:
                return true;
            }
    }
    return false;
    //return ReturnValue;    
}

function TriggerCannedAnim(int Move, name CannedAnimationName)
{
    // End:0x1D
    if(myPawn.MovementState != Move)
    {
        return;
    }
    switch(Move)
    {
        // End:0x5A
        case 36:
            TdMove_Disarmed(myPawn.Moves[36]).PlayDisarmStart(CannedAnimationName);
            // End:0x90
            break;
        // End:0x8D
        case 82:
            TdMove_MeleeAirAboveBot(myPawn.Moves[82]).PlayCannedAnim(CannedAnimationName);
            // End:0x90
            break;
        // End:0xFFFF
        default:
            //return;
    }    
}

