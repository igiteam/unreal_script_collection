    return false;
    //return ReturnValue;    
}

function bool IsOkToRun()
{
    return true;
    //return ReturnValue;    
}

function bool IsReadyToMove()
{
    return true;
    //return ReturnValue;    
}

function UpdateWalking()
{
    local float walkTestDistance;
    local bool bShouldRun;

    walkTestDistance = ((RouteCache.Length > 3) ? GetCurrentRouteDist() : EnemyDistance);
    bShouldRun = ((IsOkToRun()) && CurrentAdvanceAction == 0) && ((walkTestDistance > fMaxCombatDistance) || (walkTestDistance > fPreferredCombatDistance) && !EnemyVisible || !PlayerLookingTowardsMe) || (myPawn.bChaseAI && walkTestDistance > 500.0) && TimeSince(EnemySeenLastTime) > 1.0;
    // End:0xDE
    if(bShouldRun)
    {
        LastShouldRunTimeStamp = WorldInfo.TimeSeconds;
    }
    Pawn.SetWalking(!bShouldRun || (TimeSince(LastShouldRunTimeStamp) < 0.50) && walkTestDistance >= 500.0);
    //return;    
}

function TestAdvanceMovement()
{
    local bool shouldMoveCloser, shouldBackup, OutsidePathLimits;

    OutsidePathLimits = (PathLimits != none) && !PathLimits.Contains(Pawn.Location);
    UpdateWalking();
    shouldBackup = ShouldBackaway();
    shouldMoveCloser = !shouldBackup && ShouldMoveIn();
    // End:0x1AC
    if(((((CanFireFromHere()) && !shouldMoveCloser || ((GoodFiringPosition != none) && !IsForcedToKeepMoving()) && !AskToPathfindToEnemy()) && !shouldBackup) && !OutsidePathLimits) && (GoodFiringPosition == none) || bAtGoodFiringPosition || (Pawn.Location.Z - Enemy.Location.Z) < float(300))
    {
        // End:0x1A9
        if(CurrentAdvanceAction != 1)
        {
            UpdateAdvanceState('Fire', "Stop and fire");
            // End:0x1A9
            if((myPawn.VelocityMagnitude != float(0)) && myPawn.CanDoMove(41))
            {
                myPawn.SetMove(41);
            }
        }
    }
    // End:0x302
    else
    {
        // End:0x302
        if(IsReadyToMove())
        {
            // End:0x23C
            if(shouldMoveCloser || !EnemyVisible && AggressionLevel != 2)
            {
                // End:0x239
                if(CurrentAdvanceAction != 0)
                {
                    SetAdvanceAction(0);
                    UpdateWalking();
                    UpdateAdvanceState('Advance', "Should try to get closer to enemy");
                }
            }
            // End:0x302
            else
            {
                // End:0x2A4
                if(!bHasLineOfFire && AggressionLevel != 2)
                {
                    // End:0x2A1
                    if(CurrentAdvanceAction != 3)
                    {
                        UpdateAdvanceState('ClearLineOfSight', "Should try to get a clear line of sight");
                    }
                }
                // End:0x302
                else
                {
                    // End:0x302
                    if((bCanFireFromHere || AggressionLevel == 2) && shouldBackup)
                    {
                        // End:0x302
                        if(CurrentAdvanceAction != 2)
                        {
                            UpdateAdvanceState('Backup', "Too close so backing up");
                        }
                    }
                }
            }
        }
    }
    //return;    
}

private final function UpdateAdvanceState(name Label, string Reason)
{
    // End:0x17
    if(IsInState('SubAction_MoveToGoal'))
    {
        PopState();
    }
    TdGotoState('Advance', Label, Reason);
    //return;    
}

function bool IsEnemyBehindMe()
{
    local Vector MyRotation, EnemyDirection;
    local float CosFor90Degrees;

    CosFor90Degrees = 0.0;
    MyRotation = vector(myPawn.Rotation);
    EnemyDirection = myEnemy.Location - myPawn.Location;
    EnemyDirection = Normal(EnemyDirection);
    return (MyRotation Dot EnemyDirection) < CosFor90Degrees;
    //return ReturnValue;    
}

function bool ShouldBackaway()
{
    local bool bIsTooClose, bForcedToKeepMoving;

    bIsTooClose = (EnemyDistance < fMinCombatDistance) && AIManager.IsAnyoneEngagedInCloseCombat(self);
    bForcedToKeepMoving = ((IsForcedToKeepMoving()) || TimeSince(ForceKeepMovingEndedTimeStamp) <= 5.0) && !EnemyHarmless();
    return bIsTooClose && !bForcedToKeepMoving;
    //return ReturnValue;    
}

function bool ShouldMoveIn()
{
    local bool bIsTooFar, bForcedToKeepMoving;

    bIsTooFar = EnemyDistance > fPreferredCombatDistance;
    bForcedToKeepMoving = (IsForcedToKeepMoving()) && !EnemyHarmless();
    return bIsTooFar || bForcedToKeepMoving;
    //return ReturnValue;    
}

event NotifyNewPlayerNavigationPoint()
{
    // End:0xB9
    if(IsAdvancing)
    {
        // End:0x63
        if(!AskToPathfindToEnemy())
        {
            // End:0x60
            if(!bIsOkToFire)
            {
                TdGotoState('Advance', 'GotoGoodFiringPos', "Try to find a new good firing pos");
            }
        }
        // End:0xB9
        else
        {
            // End:0xB9
            if(CurrentAdvanceAction == 0)
            {
                TdGotoState('Advance', 'UpdatePath', "New player navigation point so update path");
            }
        }
    }
    //return;    
}

function bool IsEnemyOnDifferentNetwork()
{
    return ((Pawn.Anchor != none) && AIManager.PlayerNavigationPoint != none) && (Pawn.Anchor.NetworkID & PathNetworkMask) != (AIManager.PlayerNavigationPoint.NetworkID & PathNetworkMask);
    //return ReturnValue;    
}

function bool RandomCrouch()
{
    return FRand() < 0.50;
    //return ReturnValue;    
}

function bool AskToCrouch()
{
    local bool bCanCrouch;

    bCanCrouch = ((((((BlockingPawn == none) && IsInState('Advance', true)) && CurrentAdvanceAction == 1) && EnemyDistance2d > (CrouchRange + float(100))) && !IsEnemyOnDifferentNetwork()) && LineOfSightTo(Enemy, myPawn.ViewPointLocation_Crouching)) && AIManager.GetBlockingPawn(self, true) == none;
    // End:0xAB
    if(bCanCrouch)
    {
        Crouch(true);
    }
    return bCanCrouch;
    //return ReturnValue;    
}

function CheckCrouching()
{
    // End:0x17F
    if(!myPawn.IsBusyCrouching())
    {
        // End:0xBB
        if(myPawn.IsCrouching())
        {
            // End:0xB8
            if((((IsEnemyOnDifferentNetwork()) || Pawn.GetIsWalkingFlagSet() && CurrentAdvanceAction != 1) || EnemyDistance2d < CrouchRange) || !LineOfSightTo(Enemy, myPawn.ViewPointLocation))
            {
                Crouch(false);
                StandUpTimeStamp = WorldInfo.TimeSeconds;
            }
        }
        // End:0x17F
        else
        {
            // End:0x17F
            if((((((((TimeSince(StandUpTimeStamp) > 2.0) && BlockingPawn == none) && CurrentAdvanceAction == 1) && EnemyDistance2d > float(2000)) && bRandomCrouch) && !IsEnemyOnDifferentNetwork()) && LineOfSightTo(Enemy, myPawn.ViewPointLocation_Crouching)) && AIManager.GetBlockingPawn(self, true) == none)
            {
                bRandomCrouch = RandomCrouch();
                // End:0x17F
                if(bRandomCrouch)
                {
                    Crouch(true);
                }
            }
        }
    }
    //return;    
}

function BeginAdvance()
{
    IsAdvancing = true;
    SetTimer(0.10 + (0.10 * FRand()), true, 'TestAdvanceMovement');
    SetTimer(1.0 + float(Rand(int(0.30))), true, 'CheckCrouching');
    SetTimer(0.10, false, 'StartFiring');
    bRandomCrouch = true;
    SetWantedFocus(2);
    bUseSaferPaths = false;
    bAvoidPopulatedPaths = true;
    //return;    
}

function EndAdvance()
{
    IsAdvancing = false;
    ClearTimer('TestAdvanceMovement');
    ClearTimer('CheckCrouching');
    ClearTimer('StartFiring');
    GoodFiringPosition = none;
    bAtGoodFiringPosition = false;
    //return;    
}

function Vector GetAdvancePoint()
{
    local NavigationPoint SelectedPoint;

    // End:0x43
    if((PathLimits == none) || PathLimits.Contains(AIManager.LastSeenLocation))
    {
        return AIManager.LastSeenLocation;
    }
    SelectedPoint = SelectAdvancePoint(Pawn.Anchor.NetworkID);
    return ((SelectedPoint != none) ? SelectedPoint.Location : Pawn.Location);
    //return ReturnValue;    
}

function bool CheckBackupDirectionValid(Vector Dir)
{
    return (Dir Dot EnemyDir2D) < 0.10;
    //return ReturnValue;    
}

event bool NotifyHitWall(Vector HitNormal, Actor Wall)
{
    // End:0x5B
    if((CurrentAdvanceAction == 2) && IsInLatentMovement())
    {
        TdGotoState('Advance', 'BackupLoop', "Hit a wall while backing up");
        return true;
    }
    // End:0x6C
    else
    {
        return super(Controller).NotifyHitWall(HitNormal, Wall);
    }
    //return ReturnValue;    
}

event HitWall(Vector HitNormal, Actor Wall, PrimitiveComponent WallComp)
{
    super(Actor).HitWall(HitNormal, Wall, WallComp);
    //return;    
}

event bool NotifyBump(Actor Other, Vector HitNormal)
{
    local TdPawn P;

    // End:0x15
    if(myPawn.IsDead())
    {
        return true;
    }
    P = TdPawn(Other);
    // End:0x49
    if((P == none) || P.Controller == none)
    {
        return false;
    }
    // End:0x16C
    if(Other == Player)
    {
        // End:0x169
        if((Player.MovementState != 35) && myPawn.IsDoingSpecialMove() || myPawn.Physics == 2)
        {
            Disable('NotifyBump');
            SetTimer(0.010, false, 'EnableBumps');
            // End:0x131
            if(Player.Moves[35].CanDoMove())
            {
                Player.TakeDamage(15, self, Player.Location, vector(Pawn.Rotation) * 600.0, class'TdDmgType_MeleeLeft');
            }
            // End:0x167
            else
            {
                Player.SetLocation(Player.Location + (vector(myPawn.Rotation) * 10.0));
            }
            return true;
        }
    }
    // End:0x248
    else
    {
        // End:0x19F
        if(CurrentAdvanceAction == 2)
        {
            Disable('NotifyBump');
            SetTimer(0.30, false, 'EnableBumps');
            return true;
        }
        // End:0x248
        else
        {
            // End:0x20F
            if(myPawn.IsDoingSpecialMove())
            {
                P.SetLocation(P.Location + (vector(P.Rotation) * 10.0));
                Disable('NotifyBump');
                SetTimer(0.010, false, 'EnableBumps');
                return true;
            }
            // End:0x248
            else
            {
                Disable('NotifyBump');
                SetTimer(1.0, false, 'EnableBumps');
                ClearPathFor(P.Controller);
                return true;
            }
        }
    }
    return false;
    //return ReturnValue;    
}

function bool FindBackupDirFromHitNormal(Vector HitNormal)
{
    local Vector V, P;

    V = HitNormal Cross vect(0.0, 0.0, 1.0);
    V.Z = 0.0;
    V = Normal(V);
    // End:0x5E
    if((V Dot EnemyDir2D) >= float(0))
    {
        V = -V;
    }
    P = Pawn.Location + (V * 40.0);
    // End:0xC6
    if((CheckBackupDirectionValid(V)) && TdPointReachable(P, true, 0.60))
    {
        BackupDir = V;
        bUsingBackupDir = true;
        return true;
    }
    // End:0x138
    else
    {
        V = -V;
        P = Pawn.Location + (V * 40.0);
        // End:0x138
        if((CheckBackupDirectionValid(V)) && TdPointReachable(P, true, 0.60))
        {
            BackupDir = V;
            bUsingBackupDir = true;
            return true;
        }
    }
    return false;
    //return ReturnValue;    
}

function UpdateBackup()
{
    local Vector V;

    // End:0x7C
    if(bUsingBackupDir)
    {
        V = -EnemyDir2D;
        tempMovePos = Pawn.Location + (V * float(100));
        // End:0x7C
        if(TdPointReachable(tempMovePos, true, 0.60))
        {
            bUsingBackupDir = false;
            bHasBackupDir = true;
            TdGotoState('Advance', 'BackupLoop');
        }
    }
    //return;    
