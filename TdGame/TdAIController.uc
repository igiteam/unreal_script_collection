    {
        SetAnimationProperties(AnimationName, PlayRate, BlendInTime, BlendOutTime, bUseRootMotion, bUseRootRotation, bLoopAnimation, FinalAnimationState);
        TdGotoState('AnimationPlayback', 'StartAnimation', string(GetFuncName()),, true);
        // End:0x8F
        if(FinalAnimationState == 3)
        {
            bForceSniperCrouched = true;
            SetWantedPose(1);
