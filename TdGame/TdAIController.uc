function bool ShouldEnterMelee(float Range)
{
    local bool Result;

    Result = ((((((EnemyVisible && IsPredictedPositionWithinMeleeRange(Range)) && ShieldMaster == none) && (Abs(Pawn.Location.Z - Enemy.Location.Z) < float(50)) || myEnemy.MovementState == 11) && !IsEnemyBehindMe()) && !EnemyHarmless()) && ((PlayerLookingTowardsMeDot > 0.80) && BlockingPawn == none) || !AIManager.IsAnyoneEngagedInCloseCombat(self)) && FastTrace(Pawn.Location, Enemy.Location);
    return Result;
    //return ReturnValue;    
}

function bool IsPredictedPositionWithinMeleeRange(float Range)
{
    local Vector predictedPos;

    predictedPos = Enemy.Location + (Enemy.Velocity * MeleePredictionTime);
    return VSize2D(predictedPos - Pawn.Location) < Range;
    //return ReturnValue;    
}

