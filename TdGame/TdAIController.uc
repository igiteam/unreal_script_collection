function bool FindBackupDir()
{
    local Vector HitLocation, HitNormal;

    // End:0x1B4
    if(!bHasBackupDir)
    {
        bUsingBackupDir = false;
        BackupDir = -EnemyDir2D;
        tempMovePos = Pawn.Location + (BackupDir * float(100));
        // End:0x1A7
        if(!TdPointReachable(tempMovePos, true, 0.60))
        {
            bUsingBackupDir = true;
            BackupDir += (GetLeftEnemyDir());
            tempMovePos = Pawn.Location + (BackupDir * float(100));
            // End:0x1A7
            if(!TdPointReachable(tempMovePos, true, 0.60))
            {
                BackupDir = -EnemyDir - (GetLeftEnemyDir());
                tempMovePos = Pawn.Location + (BackupDir * float(100));
                // End:0x1A7
                if(!TdPointReachable(tempMovePos, true, 0.60))
                {
                    BackupDir = -GetLeftEnemyDir();
                    tempMovePos = Pawn.Location + (BackupDir * float(100));
                    // End:0x1A7
                    if(!TdPointReachable(tempMovePos, true, 0.60))
                    {
                        BackupDir = GetLeftEnemyDir();
                        tempMovePos = Pawn.Location + (BackupDir * float(100));
                        // End:0x1A7
                        if(!TdPointReachable(tempMovePos, true, 0.60))
                        {
                            return false;
                        }
                    }
                }
            }
        }
        bHasBackupDir = true;
        return true;
    }
    // End:0x229
    else
    {
        // End:0x216
        if(Trace(HitLocation, HitNormal, Pawn.Location + (BackupDir * float(140)), Pawn.Location, false,,, 16) != none)
        {
            // End:0x213
            if(FindBackupDirFromHitNormal(HitNormal))
            {
                bHasBackupDir = true;
                return true;
            }
            J0x216:
        }
        // End:0x216
        else
        {
        }
        bHasBackupDir = false;
        return FindBackupDir();
    }
    //return ReturnValue;    
}

