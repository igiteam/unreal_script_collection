state TdDead extends TdState
{
    ignores KilledBy, NotifyKilled, TestCombatTransitions;

    function BeginState(name PreviousStateName)
    {
        local TdAIController mate;

        super.BeginState(PreviousStateName);
        SetInterruptable(false, 'Dead');
        // End:0x81
        if(Team != none)
        {
            Team.RemoveMember(self);
            mate = ClosestFriend();
            // End:0x72
            if(mate != none)
            {
                mate.Say(14);
            }
            // End:0x81
            else
            {
                Say(2);
            }
        }
        //return;        
    }

    function bool IsDead()
    {
        return true;
        //return ReturnValue;        
    }
    stop;    
}

state EnemyDead extends TdState
{
    ignores TestCombatTransitions;

    function BeginState(name PreviousStateName)
    {
        super.BeginState(PreviousStateName);
        bEnemyDead = true;
        SetInterruptable(false, 'EnemyDead');
        StopFiring();
        //return;        
    }

    J0x00:    // End:0x26 [Loop If]
    if(!myPawn.IsInMove(1))
    {
        Sleep(0.050);
        // [Loop Continue]
        goto J0x00;
    }
    myPawn.SetWalking(true);
MoveBack:

    tempFloat = VSize2D(AIManager.LastSeenLocation - Pawn.Location);
    // End:0xEB
    if(tempFloat < float(300))
    {
        tempVector = Pawn.Location - (EnemyDir2D * float(100));
        // End:0xCF
        if(TdPointReachable(tempVector, true, 0.60))
        {
            SetMovePoint(tempVector,,, true, true);
            MoveToTarget();
        }
        // End:0xD9
        else
        {
            goto 'StopHere';
        }
        Sleep(0.10);
        goto 'MoveBack';
    }
StopHere:

    StopHere();
    stop;            
}

state ForceThrowGrenadeState
{
    ignores UpdatePawnFocus, StartFiring;

    function BeginState(name Previous)
    {
        super(Object).BeginState(Previous);
        SetInterruptable(false, 'ThrowGrenade');
        //return;        
    }

    function EndState(name Next)
    {
        super(Object).EndState(Next);
        SetInterruptable(true, 'ThrowGrenade');
        //return;        
    }

Begin:
    Halt();
    StopFiring();
    PawnFocus.SetFocus(1);
    PawnFocus.SetFocalPoint(GrenadeController.GetTargetArea().Location);
    myPawn.SetWalking(false);
    // End:0xDD
    if(VSize2D(GrenadeController.GetGrenadeNode().Location - myPawn.Location) > 100.0)
    {
        // End:0xDD
        if(SetMoveGoal(GrenadeController.GetGrenadeNode()))
        {
            MoveToTarget();
            J0xDD:
        }
        // End:0xDD
        else
        {
        }
    }
    Halt();
    StopFiring();
    PawnFocus.SetFocus(1);
    PawnFocus.SetFocalPoint(GrenadeController.GetTargetArea().Location);
    ThrowGrenade();
    AIManager.FinishedThrowingGrenade(none);
    StartFiring();
    PawnFocus.SetFocus(2);
    TdGotoState('WhatToDo',, "Throwing grenade has finished",, true);
    stop;            
}

state ThrowGrenadeState
{
    ignores UpdatePawnFocus;

    function BeginState(name Previous)
    {
        super(Object).BeginState(Previous);
        SetInterruptable(false, 'ThrowGrenade');
        //return;        
    }

    function EndState(name Next)
    {
        super(Object).EndState(Next);
        SetInterruptable(true, 'ThrowGrenade');
        //return;        
    }

Begin:
    StopFiring();
    Halt();
    bAvoidPopulatedPaths = false;
    PawnFocus.SetFocus(1);
    PawnFocus.SetFocalPoint(GrenadeController.GetTargetArea().Location);
    myPawn.SetWalking(false);
    // End:0xE5
    if(VSize2D(GrenadeController.GetGrenadeNode().Location - myPawn.Location) > 100.0)
    {
        // End:0xE5
        if(SetMoveGoal(GrenadeController.GetGrenadeNode()))
        {
            MoveToTarget();
            J0xE5:
        }
        // End:0xE5
        else
        {
        }
    }
    StopFiring();
    Halt();
    PawnFocus.SetFocus(1);
    PawnFocus.SetFocalPoint(GrenadeController.GetTargetArea().Location);
    // End:0x17F
    if((myEnemy != none) && GrenadeController.GetTargetArea().IsPawnInArea(myEnemy))
    {
        ThrowGrenade();
    }
    AIManager.FinishedThrowingGrenade(GrenadeController.GetGrenade());
    PawnFocus.SetFocus(2);
    TdGotoState('WhatToDo',, "Finished throwing grenade",, true);
    stop;        
}

