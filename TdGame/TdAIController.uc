function DropCover(bool ShouldNotify, bool bShouldMarkCoverInvalid, optional bool bRetreatFromCover)
{
    bRetreatFromCover = false;
    // End:0xAA
    if(CurrentCover.HasClaimedCover())
    {
        // End:0x39
        if(bShouldMarkCoverInvalid)
        {
            CurrentCover.MarkInvalid();
        }
        CurrentCover.Drop();
        // End:0x87
        if(IsInCover)
        {
            bRetreatFromCoverWhenExited = bRetreatFromCover;
            TdGotoState('SubAction_ExitingCover',, "Cover dropped...",, true);
        }
        ClearTimer('CheckCurrentCover');
        // End:0xAA
        if(ShouldNotify)
        {
            NotifyCoverDropped();
        }
    }
    //return;    
}

