function SetLocationXY(Vector PawnLocation)
{
    PawnLocation.Z = Pawn.Location.Z;
    Pawn.SetLocation(PawnLocation);
    //return;    
}

function bool IsAtEnd(Vector Start, Vector End)
{
    local Vector startToPawnDir;

    Start.Z = Pawn.Location.Z;
    End.Z = Pawn.Location.Z;
    startToPawnDir = Pawn.Location - Start;
    // End:0x8F
    if(((End - Start) Dot startToPawnDir) < float(0))
    {
        return false;
    }
    return (startToPawnDir Dot (Pawn.Location - End)) >= float(1);
    //return ReturnValue;    
}

function ClientMessage(coerce string S)
{
    local TdPlayerController P;

    // End:0x44
    foreach WorldInfo.AllControllers(class'TdPlayerController', P)
    {
        // End:0x43
        if(P != none)
        {
            P.ClientMessage(S);
        }        
    }    
    //return;    
}

function Vector vec3(float X, float Y, float Z)
{
    local Vector V;

    V.X = X;
    V.Y = Y;
    V.Z = Z;
    return V;
    //return ReturnValue;    
}

function Vector GetLeftEnemyDir()
{
    // End:0x1C
    if(Enemy == none)
    {
        return vect(1.0, 0.0, 0.0);
    }
    // End:0x4E
    else
    {
        return vec3(EnemyDir.Y, -EnemyDir.X, 0.0);
    }
    //return ReturnValue;    
}

function bool IsEnemyLookingAtMe2D(float dotLimit)
{
    local Vector Enemy2DRotation;

    // End:0x0D
    if(Enemy == none)
    {
        return false;
    }
    Enemy2DRotation = vector(Enemy.Rotation);
    Enemy2DRotation.Z = 0.0;
    Enemy2DRotation = Normal(Enemy2DRotation);
    return (-EnemyDir2D Dot Enemy2DRotation) > dotLimit;
    //return ReturnValue;    
}

function bool IsEnemyAimingAtMe(float Dist)
{
    local Vector botDir, aimingDir, pointOnLine;

    botDir = Pawn.Location - Enemy.Location;
    aimingDir = vector(Enemy.Rotation);
    pointOnLine = Enemy.Location + (aimingDir * (botDir Dot aimingDir));
    return VSizeSq(pointOnLine - Pawn.Location) < (Dist * Dist);
    //return ReturnValue;    
}

function bool IsPointAwayFromEnemy(Vector P)
{
    local Vector Dir;

    Dir = Normal(P - Pawn.Location);
    return (EnemyDir2D Dot Dir) < float(0);
    //return ReturnValue;    
}

function bool IsEnemy(Controller C)
{
    return TdAIController(C) == none;
    //return ReturnValue;    
}

