    //return ReturnValue;    
}

final function bool SetMoveLocationEnemy(optional Actor NewMoveFocus, optional float OffsetDist, optional bool HaltAfterMove)
{
    HaltAfterMove = true;
    // End:0x3D
    if(ShouldUsePlayerNavigationPoint())
    {
        return SetMoveGoal(AIManager.PlayerNavigationPoint, NewMoveFocus, OffsetDist, HaltAfterMove);
    }
    // End:0x64
    else
    {
        return SetMovePoint(AIManager.LastSeenLocation, NewMoveFocus, OffsetDist, HaltAfterMove);
    }
    //return ReturnValue;    
}

final event bool SetMoveGoal(Actor NewMoveGoal, optional Actor NewMoveFocus, optional float OffsetDist, optional bool HaltAfterMove)
{
    HaltAfterMove = true;
    MoveGoalIsEnemy = NewMoveGoal == Enemy;
    // End:0x44
    if(Controller(NewMoveGoal) != none)
    {
        NewMoveGoal = Controller(NewMoveGoal).Pawn;
    }
    bSkipPathFind = false;
    bReachedMoveGoal = false;
    MoveGoal = NewMoveGoal;
    MovePoint = vect(0.0, 0.0, 0.0);
    MoveOffset = OffsetDist;
    HaltAfterMoveToGoal = HaltAfterMove;
    // End:0xC7
    if(MoveGoal == none)
    {
        TdGotoState('Error',, "MoveGoal = none in SetMoveGoal");
    }
    // End:0xE7
    if((MoveGoal == Enemy) && IsEnemyOnDifferentNetwork())
    {
        return false;
    }
    // End:0x10F
    if(OkToMoveDirectlyToActor())
    {
        UpdateCurrentRouteDistDirect(MoveGoal.Location);
        return true;
    }
    TdFindPathToward(MoveGoal);
    // End:0x131
    if(MoveTarget != none)
    {
        bSkipPathFind = true;
    }
    return MoveTarget != none;
    //return ReturnValue;    
}

final event bool SetMovePoint(Vector NewMovePoint, optional Actor NewMoveFocus, optional float OffsetDist, optional bool HaltAfterMove, optional bool CanMoveDirectly)
{
    HaltAfterMove = true;
    CanMoveDirectly = false;
    bSkipPathFind = false;
    MoveGoalIsEnemy = NewMovePoint == AIManager.LastSeenLocation;
    // End:0x6C
    if((!MoveGoalIsEnemy && Enemy != none) && NewMovePoint == Enemy.Location)
    {
        MoveGoalIsEnemy = true;
    }
    bReachedMoveGoal = false;
    MoveGoal = none;
    MovePoint = NewMovePoint;
    MoveOffset = OffsetDist;
    HaltAfterMoveToGoal = HaltAfterMove;
    bSkipReachableTest = false;
    // End:0xC0
    if(MoveGoalIsEnemy && IsEnemyOnDifferentNetwork())
    {
        return false;
    }
    // End:0xF1
    if(CanMoveDirectly || OkToMoveDirectlyToPoint())
    {
        bSkipReachableTest = true;
        UpdateCurrentRouteDistDirect(MovePoint);
        return true;
    }
    TdFindPathTo(MovePoint);
    // End:0x113
    if(MoveTarget != none)
    {
        bSkipPathFind = true;
    }
    return MoveTarget != none;
    //return ReturnValue;    
}

