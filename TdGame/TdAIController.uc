final function DebugGotoState(name NewState, optional name Label, optional string Reason, optional bool bForceEvents, optional bool ForceStateChange)
{
    ForceStateChange = false;
    TdGotoState(NewState, Label, Reason, bForceEvents, ForceStateChange);
    //return;    
}

protected final function TdGotoState(name NewState, optional name Label, optional string Reason, optional bool bForceEvents, optional bool ForceStateChange)
{
    ForceStateChange = false;
    // End:0x5E
    if(((IsCurrentStateInterruptable()) || ForceStateChange) || NewState == 'Error')
    {
        bIsInMeleeState = NewState == MeleeState;
        GotoState(NewState, Label, bForceEvents);
        J0x5E:
    }
    // End:0x5E
    else
    {
    }
    //return;    
}

protected final function TdPushState(name NewState, optional name NewLabel, optional string Reason, optional bool ForceStateChange)
{
    ForceStateChange = false;
    PushState(NewState, NewLabel);
    //return;    
}

function TestCombatTransitions()
{
    local name NewState, Label;
    local string Reason;

    // End:0x29
    if((scriptingActivated || !IsCurrentStateInterruptable()) || Enemy == none)
    {
        return;
    }
    // End:0x51
    if((Pawn == none) || !myPawn.OkToChangeState())
    {
        return;
    }
    Label = 'None';
    Reason = "no particular reason";
    // End:0xD9
    if(ShouldEnterMelee(myTemplate.MeleeRange))
    {
        // End:0xB1
        if(myPawn.IsInMeleeMove())
        {
            goto J0x30D;
        }
        // End:0xD6
        else
        {
            NewState = MeleeState;
            Reason = "We should melee";
            goto J0x2F6;
        }
    }
    // End:0xEF
    else
    {
        // End:0xEF
        if(myPawn.IsInMeleeMove())
        {
        }
        // End:0x30D
        else
        {
        }
        // End:0x112
        if(IsInState('GetWithinPathLimits', true))
        {
            // End:0x10F
            if(ShouldGetWithinPathlimits())
            {
            }
            // End:0x30D
            else
            {
                goto J0x14C;
            }
            // End:0x14C
            if(ShouldGetWithinPathlimits())
            {
                NewState = 'GetWithinPathLimits';
                Reason = "Got new path limits";
                J0x14C:
            }
            // End:0x2F6
            else
            {
                // End:0x1E2
                if(!IAmShieldMaster)
                {
                    // End:0x188
                    if(ShieldMaster == none)
                    {
                        ShieldMaster = Team.GetShieldMaster(self);
                        // End:0x188
                        if(ShieldMaster != none)
                        {
                        }
                    }
                    // End:0x1C0
                    if(ShieldMaster != none)
                    {
                        // End:0x1BA
                        if(!IsInState('ShieldWall', true))
                        {
                            NewState = 'ShieldWall';
                            goto J0x2F6;
                        }
                        // End:0x1BD
                        else
                        {
                            goto J0x30D;
                        }
                    }
                    // End:0x1E2
                    else
                    {
                        // End:0x1E2
                        if(HasShield())
                        {
                            TdAI_Riot(self).SetShieldMaster();
                        }
                    }
                }
                // End:0x296
                if(!IsInState('Cover', true) && !bExitedCover)
                {
                    // End:0x293
                    if((((AggressionLevel == 1) || AggressionLevel == 2) && EnemyDistance > float(600)) && CurrentCover.HasClaimedCover() || FindNewCover())
                    {
                        Reason = "AggressionLevel =" @ string(AggressionLevel);
                        NewState = 'Cover';
                    }
                    // End:0x2F6
                    else
                    {
                        goto J0x299;
                    }
                    J0x299:
                    goto J0x30D;
                    // End:0x2F0
                    if(!IsInState('Advance', true))
                    {
                        Reason = "Falling through in TestCombatTransitions";
                        NewState = 'Advance';
                        goto J0x2F6;
                    }
                    // End:0x2F3
                    else
                    {
                        goto J0x30D;
                    }
                }
                // End:0x30D
                else
                {
                }
                TdGotoState(NewState, Label, Reason);
            }
        }
    }
    //return;    
}

