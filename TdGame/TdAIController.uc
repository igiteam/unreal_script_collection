        Sleep(0.10);
        // [Loop Continue]
        goto J0x16;
    }
    TestAdvanceMovement();
Fire:

    SetAdvanceAction(1);
    StopHere();
    J0x5C:
    // End:0x82 [Loop If]
    if(!myPawn.IsInMove(1))
    {
        Sleep(0.10);
        // [Loop Continue]
        goto J0x5C;
    }
    StartFiring();
