function Vector GetRetreatFromCoverDir()
{
    local Vector DirToEnemy, RetreatDir;
    local bool bRetreatToTheRight;

    DirToEnemy = Player.Location - myPawn.Location;
    DirToEnemy.Z = 0.0;
    DirToEnemy = Normal(DirToEnemy);
    // End:0x7D
    if(DirToEnemy Cross CurrentCover.Direction.Z > float(0))
    {
        bRetreatToTheRight = true;
    }
    // End:0x85
    else
    {
        bRetreatToTheRight = false;
    }
    // End:0xAB
    if(bRetreatToTheRight)
    {
        RetreatDir = vect(0.0, 0.0, 1.0) Cross DirToEnemy;
    }
    // End:0xC5
    else
    {
        RetreatDir = DirToEnemy Cross vect(0.0, 0.0, 1.0);
    }
    return RetreatDir;
    //return ReturnValue;    
}

