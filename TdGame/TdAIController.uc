{
    // End:0x7B
    if(Action.AccuracyImprovementRate != float(0))
    {
        AimBot = RealAimBot;
        // End:0x5F
        if(Action.ShouldEnable())
        {
            AimBot.OverrideImprovementRate(Action.AccuracyImprovementRate);
        }
        // End:0x78
        else
        {
            AimBot.OverrideImprovementRate(0.0);
        }
    }
    // End:0xBD
    else
    {
        AimBot.OverrideImprovementRate(0.0);
        AimBot = ((Action.ShouldEnable()) ? PerfectAimBot : RealAimBot);
    }
    //return;    
}

function OnAIMoveToActor(SeqAct_AIMoveToActor seqAct)
{
    local Actor destActor;
    local SeqVar_Object ObjVar;

    ClearLatentAction(class'SeqAct_AIMoveToActor', true, seqAct);
    // End:0x69
    foreach seqAct.LinkedVariables(class'SeqVar_Object', ObjVar, "Destination")
    {
        destActor = Actor(ObjVar.GetObjectValue());
        // End:0x68
        if(destActor != none)
        {
            // End:0x69
            break;
        }        
    }    
    ScriptedMoveTarget = destActor;
    // End:0x10D
    if(destActor != none)
    {
        ScriptedFocus = none;
        // End:0xDB
        foreach seqAct.LinkedVariables(class'SeqVar_Object', ObjVar, "Look At")
        {
            ScriptedFocus = Actor(ObjVar.GetObjectValue());
            // End:0xDA
            if(ScriptedFocus != none)
            {
                // End:0xDB
                break;
            }            
        }        
        TdGotoState('ScriptedMoveTo',, "Scripted to move somewhere",, true);
        J0x10D:
    }
    // End:0x10D
    else
    {
    }
    //return;    
}

