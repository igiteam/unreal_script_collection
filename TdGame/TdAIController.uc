function Halt()
{
    // End:0x0D
    if(Pawn == none)
    {
        return;
    }
    // End:0x66
    if(((myPawn.VelocityMagnitude == 0.0) && VSizeSq(Pawn.Acceleration) == 0.0) && float(myPawn.CurrentRotationSpeed) == 0.0)
    {
        return;
    }
    // End:0x7F
    if(bDebugHalt)
    {
        ScriptTrace();
        Pause();
    }
    Pawn.Acceleration = vect(0.0, 0.0, 0.0);
    myPawn.CurrentRotationSpeed = 0;
    //return;    
}

function Freeze()
{
    // End:0x0D
    if(Pawn == none)
    {
        return;
    }
    Halt();
    Pawn.Velocity = vect(0.0, 0.0, 0.0);
    //return;    
}

function ForceKeepMoving(bool flag)
{
    // End:0x3E
    if(flag != bForceKeepMoving)
    {
        bForceKeepMoving = flag;
        // End:0x3E
        if(!bForceKeepMoving)
        {
            ForceKeepMovingEndedTimeStamp = WorldInfo.TimeSeconds;
        }
    }
    //return;    
