state GetWithinPathLimits extends TdState
{
    function BeginState(name PreviousStateName)
    {
        super.BeginState(PreviousStateName);
        StartFiring();
        SetWantedFocus(2);
        myPawn.SetWalking(false);
        bAvoidPopulatedPaths = true;
        PopulatedPathsCost = 0.50;
        //return;        
    }

    function EndState(name NextStateName)
    {
        super.EndState(NextStateName);
        PopulatedPathsCost = 0.0;
        //return;        
    }

GetMoving:
    ReachablePlayerNavigationPoint = SelectAdvancePoint(Pawn.Anchor.NetworkID,,, class'PathNode', false);
    // End:0xFF
    if(ReachablePlayerNavigationPoint != none)
    {
        J0x38:
        // End:0x5D [Loop If]
        if(!AIManager.AllowPathfinding(self))
        {
            Sleep(0.010);
            // [Loop Continue]
            goto J0x38;
        }
        // End:0xD1
        if(SetMoveGoal(ReachablePlayerNavigationPoint, Enemy, 0.0))
        {
            AIManager.SetLastSeenLocation(myEnemy);
            Crouch(false);
            // End:0xC7
            if(myPawn.IsBusyCrouching())
            {
                FinishAnim(myPawn.GetCustomAnimation(2));
            }
            MoveToTarget();
        }
        // End:0xE9
        if(!bReachedMoveGoal)
        {
            goto 'NoWayOut';
        }
        // End:0xFC
        else
        {
            TdGotoState('WhatToDo');
        }
    }
    // End:0x109
    else
    {
        goto 'NoWayOut';
    }
    StopHere();
    Sleep(1.0);
    goto 'GetMoving';
    stop;            
}

state Cover extends TdState
{
    function BeginState(name PreviousStateName)
    {
        super.BeginState(PreviousStateName);
        StartFiring();
        SetWantedFocus(2);
        bUseSaferPaths = true;
        bAvoidPopulatedPaths = false;
        //return;        
    }

    function EndState(name NextStateName)
    {
        super.EndState(NextStateName);
        DropCover(true, false);
        Crouch(false);
        ClearTimer('AdvanceTimerCallback');
        bUseSaferPaths = default.bUseSaferPaths;
        bAvoidPopulatedPaths = default.bAvoidPopulatedPaths;
        // End:0x8F
        if((NextStateName != 'SubAction_ExitingCover') && !CoverController.VerifyExitedCoverValid())
        {
            CoverController.ForceExitCover();
        }
        //return;        
    }

    function ContinuedState()
    {
        super(Object).ContinuedState();
        // End:0x2C
        if(!CurrentCover.HasClaimedCover())
        {
            CoverWasDropped();
        }
        // End:0x69
        else
        {
            // End:0x69
            if(bAdvance)
            {
                TdGotoState('Cover', 'MoveToCover', "New cover position found");
            }
        }
        bAdvance = false;
        StartFiring();
        SetWantedFocus(2);
        //return;        
    }

    function AdvanceTimerCallback()
    {
        // End:0x41
        if(ShouldWeAdvance())
        {
            TdGotoState('Cover', 'MoveToCover', "New cover position found");
        }
        //return;        
    }

    function NotifyCoverDropped()
    {
        CoverWasDropped();
        //return;        
    }

    function CoverWasDropped()
    {
        TdGotoState('Cover', 'CoverDropped', string(GetFuncName()));
        StartFiring();
        SetWantedFocus(2);
        //return;        
    }

    function bool ShouldEnterMelee(float Range)
    {
        return false;
        //return ReturnValue;        
    }

Begin:
    // End:0x36
    if(!CurrentCover.HasClaimedCover())
    {
        // End:0x33
        if(!FindNewCover())
        {
            goto 'NoCover';
        }
    }
    // End:0x49
    else
    {
        // End:0x49
        if(IsInCover)
        {
            goto 'InCover';
        }
    }
    // End:0x92
    if(VSizeSq(CurrentCover.Location - AIManager.LastSeenLocation) < EnemyDistanceSq)
    {
        ReportAdvancing(CurrentCover.Location);
    }
    MoveToCover();
    // End:0xB2
    if(!IsInCover)
    {
        goto 'CoverDropped';
    }
InCover:

    AdvanceTimer = WorldInfo.TimeSeconds;
    SetTimer(1.0, true, 'AdvanceTimerCallback');
FireFromCover:

    Say(5, 0.50);
    FireFromCover();
    goto 'Begin';
CoverDropped:

    // End:0x119
    if(FindNewCover())
    {
        goto 'MoveToCover';
    }
NoCover:

    TdGotoState('WhatToDo',, "Can't find a valid cover so leave the cover state");
    stop;        
}

state Melee extends TdState
{
    function BeginState(name PreviousStateName)
    {
        super.BeginState(PreviousStateName);
        StopFiring();
        SetWantedFocus(2);
        //return;        
    }

    function EndState(name NextStateName)
    {
        super.EndState(NextStateName);
        MeleePredictionTime = myTemplate.GetRandomMeleePredictionTime();
        //return;        
    }

Begin:
    // End:0x73
    if(((myPawn.bChaseAI && myEnemy != none) && myEnemy.MovementState != 16) && myEnemy.MovementState != 48)
    {
        myPawn.SetMove(84);
    }
    // End:0x8B
    else
    {
        myPawn.SetMove(17);
    }
    // End:0xB0 [Loop If]
    if(myPawn.MovementState != 1)
    {
        Sleep(0.010);
        // [Loop Continue]
        goto J0x8B;
    }
    TestCombatTransitions();
    stop;        
}

state ShieldWall extends TdState
{
    function BeginState(name PreviousStateName)
    {
        super.BeginState(PreviousStateName);
        Pawn.SetWalking(true);
        StartFiring();
        bIsInPosition = false;
        ShieldWallLocation = vect(0.0, 0.0, 0.0);
        bAvoidPopulatedPaths = false;
        SetWantedFocus(2);
        myPawn.AnimationWalkSpeed = 200.0;
        bUseMomentum = false;
        //return;        
    }

    function EndState(name NextStateName)
    {
        super.EndState(NextStateName);
        LeaveFormation();
        myPawn.SetIsSlowWalking(false);
        bAvoidPopulatedPaths = default.bAvoidPopulatedPaths;
        myPawn.AnimationWalkSpeed = myPawn.default.AnimationWalkSpeed;
        bUseMomentum = default.bUseMomentum;
        //return;        
    }

    J0x00:    // End:0x22 [Loop If]
    if(ShieldWallLocation == vect(0.0, 0.0, 0.0))
    {
        Sleep(0.10);
        J0x22:
        // [Loop Continue]
        goto J0x00;
    }
    // End:0xB3 [Loop If]
    if(!Pawn.ReachedPoint(ShieldWallLocation, none))
    {
        // End:0x75
        if(TdPointReachable(ShieldWallLocation))
        {
            UpdateCurrentRouteDistDirect(ShieldWallLocation);
            TdMoveTo(ShieldWallLocation);
        }
        // End:0xB0
        else
        {
            // End:0x94
            if(SetMovePoint(ShieldWallLocation))
            {
                MoveToTarget();
            }
            // End:0xB0
            else
            {
                Halt();
                Sleep(0.50);
                goto 'Begin';
            }
        }
HoldFormation:

        // [Loop Continue]
        goto J0x22;
    }
    bIsInPosition = true;
    J0xBB:
    // End:0x269 [Loop If]
    if(!Pawn.ReachedPoint(ShieldWallLocation, none) || ShieldMaster.myPawn.VelocityMagnitude > float(0))
    {
        tempFloat = VSize(ShieldWallLocation - Pawn.Location);
        bTrailingBehindAlot = tempFloat > float(100);
        bTrailingBehind = tempFloat > float(30);
        // End:0x17D
        if(tempFloat > float(500))
        {
            myPawn.SetWalking(false);
            myPawn.SetIsSlowWalking(false);
        }
        // End:0x1D4
        else
        {
            myPawn.SetWalking(true);
            myPawn.SetIsSlowWalking((tempFloat < float(10)) && ShieldMaster.myPawn.GetIsSlowWalking());
        }
        // End:0x201
        if(tempFloat < float(200))
        {
            UpdateCurrentRouteDistDirect(ShieldWallLocation);
            TdMoveTo(ShieldWallLocation);
        }
        // End:0x266
        else
        {
            // End:0x235
            if(TdPointReachable(ShieldWallLocation))
            {
                UpdateCurrentRouteDistDirect(ShieldWallLocation);
                TdMoveTo(ShieldWallLocation);
            }
            // End:0x266
            else
            {
                // End:0x254
                if(SetMovePoint(ShieldWallLocation))
                {
                    MoveToTarget();
                }
                // End:0x266
                else
                {
                    Halt();
                    Sleep(0.50);
                }
            }
        }
        // [Loop Continue]
        goto J0xBB;
    }
    Halt();
    Sleep(0.50);
    goto 'HoldFormation';
    stop;            
}

state AnimationPlayback extends TdState
{
    ignores Say;

    function BeginState(name PreviousStateName)
    {
        super.BeginState(PreviousStateName);
        ScriptActivated(true);
        OnAnimationPlaybackStart();
        bAllowFocus = false;
        bAllowFocusRotation = false;
        Pawn.Mesh.bUpdateSkelWhenNotRendered = true;
        //return;        
    }

    function EndState(name NextStateName)
    {
        super.EndState(NextStateName);
        ScriptActivated(false);
        SetBestAnchor();
        OnAnimationPlaybackExit();
        bAllowFocusRotation = true;
        bAllowFocusRotation = true;
        Pawn.Mesh.bUpdateSkelWhenNotRendered = false;
        //return;        
    }

    function bool IsOkToFire()
    {
        return false;
        //return ReturnValue;        
    }

    event SeePlayer(Pawn iPawn)
    {
        super(TdAIController).SeePlayer(iPawn);
        HeadFocus.PushEnabled(false, 'AnimationPlayback');
        //return;        
    }

    event Tick(float DeltaTime)
    {
        super(TdAIController).Tick(DeltaTime);
        //return;        
    }

    function bool NotifyPrepareForMeleeAttack(class<DamageType> MeleeDamageType)
    {
        // End:0x11
        if(EnemyDistance2d > 200.0)
        {
            return false;
        }
        // End:0x26
        if(!bAnimationPlaybackInterrupted)
        {
            AnimationPlaybackInterrupted();
        }
        return false;
        //return ReturnValue;        
    }

    function NotifyDamage(Controller InstigatedBy, class<DamageType> DamageType, int Damage)
    {
        // End:0x15
        if(!bAnimationPlaybackInterrupted)
        {
            AnimationPlaybackInterrupted();
        }
        //return;        
    }

StartAnimation:
    StartAnimationPlayback();
    J0x0A:
    // End:0x2E [Loop If]
    if(myPawn.IsInMove(74))
    {
        Sleep(0.10);
        // [Loop Continue]
        goto J0x0A;
    }
    goto 'End';
StopAnimation:

    StopAnimationPlayback();
    goto 'End';
InterruptAnimation:

    StopAnimationPlayback();
    goto 'End';
FailedToFindAnimation:

    goto 'End';
End:

    TdGotoState('WhatToDo',,,, true);
    stop;            
}

state CannedMove extends TdState
{
    ignores StartFiring, UpdatePawnFocus, HandleEnemySeen;

    function BeginState(name Previous)
    {
        super.BeginState(Previous);
        StartCannedMoveState();
        bAllowFocus = false;
        //return;        
    }

    function EndState(name Next)
    {
        StopCannedMoveState();
        super.EndState(Next);
        //return;        
    }

    function PushedState()
    {
        super(Object).PushedState();
        StartCannedMoveState();
        //return;        
    }

    function PoppedState()
    {
        StopCannedMoveState();
        super(Object).PoppedState();
        //return;        
    }

    function bool StopCannedMove()
    {
        PopState();
        return true;
        //return ReturnValue;        
    }

    protected function StartCannedMoveState()
    {
        Halt();
        StopFiring();
        HeadFocus.PushEnabled(false, 'CannedMove');
        myPawn.bForceWaitForDamage = true;
        myPawn.MyWeapon.AbortBurst();
        Crouch(false);
        ScriptActivated(true);
        SetInterruptable(false, 'CannedMove');
        //return;        
    }

    protected function StopCannedMoveState()
    {
        myPawn.SetForceWaitForDamageTimer(0.50);
        ResetFocus();
        SetInterruptable(true, 'CannedMove');
        HeadFocus.PopEnabled('CannedMove');
        ScriptActivated(false);
        //return;        
    }

Begin:
    Sleep(99.0);
    stop;                
}

state Stumble extends TdState
{
    ignores StartFiring;

    function BeginState(name Previous)
    {
        super.BeginState(Previous);
        Halt();
        StopFiring();
        myPawn.bForceWaitForDamage = true;
        // End:0x64
        if(myPawn.Weapon != none)
        {
            myPawn.MyWeapon.AbortBurst();
        }
        SetInterruptable(false, 'Stumble');
        bAllowFocus = true;
        bAllowFocusRotation = bAllowStumbleRotation;
        //return;        
    }

    function EndState(name Next)
    {
        super.EndState(Next);
        myPawn.SetForceWaitForDamageTimer(0.750);
        SetInterruptable(true, 'Stumble');
        SetWantedFocus(2);
        bAllowFocusRotation = true;
        ClearTimer('TestExitStumble');
        //return;        
    }

    function UpdatePose()
    {
        SetPose(WantedPose);
        //return;        
    }

    function UpdatePawnFocus()
    {
        SetFocus(2);
        //return;        
    }

    function NotifyStumbleComplete()
    {
        TestExitStumble();
        SetTimer(0.040, false, 'TestExitStumble');
        //return;        
    }

    function TestExitStumble()
    {
        // End:0x40
        if(ShouldEnterMelee(myTemplate.MeleeRange))
        {
            TdGotoState(MeleeState,, "End Stumble in Melee",, true);
        }
        //return;        
    }

    function UpdateStumbleRotation(bool bAllowRotation)
    {
        bAllowFocusRotation = bAllowRotation;
        //return;        
    }

    J0x00:    // End:0x3F [Loop If]
    if(!myPawn.IsInMove(1) || myPawn.TaserDamageLevel > float(0))
    {
        Sleep(0.10);
        // [Loop Continue]
        goto J0x00;
    }
    TdGotoState('WhatToDo',, "Stumble finished",, true);
    stop;                    
}

state Blocking extends TdState
{
    ignores StartFiring;

    function BeginState(name PreviousState)
    {
        super.BeginState(PreviousState);
        SetInterruptable(false, 'Blocking');
        bAllowFocus = true;
        bAllowFocusRotation = true;
        //return;        
    }

    function EndState(name NextState)
    {
        super.EndState(NextState);
        myPawn.SetForceWaitForDamageTimer(0.50);
        SetInterruptable(true, 'Blocking');
        SetWantedFocus(2);
        //return;        
    }

    function UpdatePawnFocus()
    {
        SetFocus(2);
        //return;        
    }

    function NotifyStumbleComplete()
    {
        SetInterruptable(true, 'Blocking');
        TestCombatTransitions();
        //return;        
    }
    stop;    
}

