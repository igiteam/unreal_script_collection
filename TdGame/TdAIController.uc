        //return;        
    }

    function NotifyDamage(Controller InstigatedBy, class<DamageType> DamageType, int Damage)
    {
        // End:0x2C
        if(Rand(3) == 0)
        {
            TdGotoState('SubAction_FireFromCover', 'TakeCover', string(GetFuncName()));
        }
        //return;        
    }

    function NotifySuppressed()
    {
        Say(26);
        TdGotoState('SubAction_FireFromCover', 'TakeCover', string(GetFuncName()));
        //return;        
    }

    function AdvanceTimerCallback()
    {
        // End:0x2F
        if(ShouldWeAdvance())
        {
            TdGotoState('SubAction_FireFromCover', 'ExitState', string(GetFuncName()));
        }
        //return;        
    }

    function CheckCurrentCover()
    {
        // End:0x39
        if(!CurrentCover.IsValid(AIManager.LastSeenHeadLocation, true))
        {
            DropCover(true, false);
        }
        // End:0xA1
        else
        {
            // End:0x65
            if(bCoverDirectionValid)
            {
                bCoverDirectionValid = (IsCoverDirectionValid()) || ShouldHoldPosition();
            }
            // End:0xA1
            else
            {
                // End:0x99
                if(!IsCoverDirectionValid())
                {
                    TdGotoState('SubAction_FireFromCover', 'SwitchCoverDirection', string(GetFuncName()));
                }
                // End:0xA1
                else
                {
                    bCoverDirectionValid = true;
                }
            }
        }
        //return;        
    }

    function bool IsCoverDirectionValid()
    {
        // End:0x12
        if(CoverDirection == 3)
        {
            return true;
        }
        // End:0x65
        if(((AIManager.LastSeenLocation - CurrentCover.GetFireLocation(CoverDirection)) Dot vector(CurrentCover.GetFireRotation(CoverDirection))) < 0.0)
        {
            return false;
        }
        return true;
        //return ReturnValue;        
    }

    function bool ShouldHoldPosition()
    {
        // End:0x12
        if(CoverDirection == 3)
        {
            return true;
        }
        // End:0x5B
        if(((Enemy.Location - CurrentCover.Location) Dot vector(CurrentCover.GetFireRotation(CoverDirection))) < 0.0)
        {
            return false;
        }
        return true;
        //return ReturnValue;        
    }

Begin:
    Sleep(0.010);
    goto 'Idle';
Idle:

    StopFiring();
    CoverController.PrePerformCoverAction();
    SetCoverAction(4);
    // End:0x53
    if(WeAreSuppressed())
    {
        Sleep(0.10);
        goto 'Idle';
    }
CoverFire:

    StopFiring();
    CoverController.PrePerformCoverAction();
    // End:0x8C
    if(CoverDirection == 2)
    {
        SetCoverAction(5);
    }
    // End:0xBF
    else
    {
        // End:0xA7
        if(CoverDirection == 1)
        {
            SetCoverAction(6);
        }
        // End:0xBF
        else
        {
            // End:0xBF
            if(CoverDirection == 3)
            {
                SetCoverAction(7);
            }
        }
    }
    Sleep(0.20);
    StartFiring();
    J0xD1:
    // End:0xF4 [Loop If]
    if((ShouldHoldPosition()) && bIsWithinFiringDistance)
    {
        Sleep(0.50);
        // [Loop Continue]
        goto J0xD1;
    }
    // End:0x167
    if(!bIsWithinFiringDistance || !CurrentCover.HaveOppositeCoverDir(CoverDirection))
    {
        CurrentCover.MarkAsTemporaryInvalid(10.0);
        // End:0x167
        if(CurrentCover.HasClaimedCover() && IsInCover)
        {
            DropCover(false, false, true);
        }
    }
    goto 'Idle';
TakeCover:

    CoverController.PrePerformCoverAction();
    SetCoverAction(4);
    // End:0x1E4
    if(Rand(3) == 0)
    {
        Sleep(FRand());
        CurrentCover.MarkAsTemporaryInvalid(10.0);
        // End:0x1E4
        if(CurrentCover.HasClaimedCover() && IsInCover)
        {
            DropCover(false, false, true);
        }
    }
    Sleep(0.50 + FRand());
    goto 'Begin';
SwitchCoverDirection:

    bCoverDirectionValid = CurrentCover.SelectCoverDirection(CoverDirection);
    // End:0x22F
    if(!bCoverDirectionValid)
    {
        goto 'ExitState';
    }
    goto 'Idle';
ExitState:

    StopFiring();
    PopState();
    stop;        
}

state SubAction_MoveToCover extends TdState
{
    function PushedState()
    {
        super(Object).PushedState();
        IsMovingToCover = true;
        // End:0x88
        if((VSize2D(CurrentCover.Location - Pawn.Location) < 500.0) || VSize2D(Pawn.Location - Enemy.Location) < 1000.0)
        {
            Pawn.SetWalking(true);
        }
        // End:0x9D
        else
        {
            Pawn.SetWalking(false);
        }
        //return;        
    }

    function PoppedState()
    {
        super(Object).PoppedState();
        IsMovingToCover = false;
        Pawn.SetWalking(true);
        //return;        
    }

    function NotifyCoverDropped()
    {
        //return;        
    }

Begin:
    Sleep(0.010);
    SetIsInCover(false);
    bCoverDirectionValid = CurrentCover.SelectCoverDirection(CoverDirection);
    // End:0x58
    if(!bCoverDirectionValid && !bForceValidCoverDirection)
    {
        goto 'FailSelectCover';
    }
    // End:0x79
    else
    {
        // End:0x79
        if(bForceValidCoverDirection)
        {
            bCoverDirectionValid = bForceValidCoverDirection;
            CoverDirection = ForcedCoverDirection;
        }
    }
    // End:0x9E [Loop If]
    if(!AIManager.AllowPathfinding(self))
    {
        Sleep(0.010);
        // [Loop Continue]
        goto J0x79;
    }
    // End:0xC8
    if(SetMoveGoal(CurrentCover.GetSlotMarker()))
    {
        MoveToTarget();
    }
    // End:0x172
    if(bReachedMoveGoal && CurrentCover.HasClaimedCover())
    {
        Pawn.SetAnchor(CurrentCover.GetSlotMarker());
        CoverController.OnEnterCover(myPawn, CurrentCover);
        CoverController.PrePerformCoverAction();
        SetCoverAction(2);
        // End:0x16F
        if(!CurrentCover.HasClaimedCover())
        {
            goto 'FailClaimCover';
        }
    }
    // End:0x17C
    else
    {
        goto 'FailReachMoveGoal';
    }
    PopState();
FailSelectCover:

    goto 'Fail';
FailClaimCover:

    // End:0x1DE
    if(myPawn.myAnimationController.IsPlayingCoverAnimation())
    {
        Sleep(myPawn.myAnimationController.GetCoverAnimation().GetTimeLeft());
    }
    // End:0x210
    if(CurrentCover.HasClaimedCover() && IsInCover)
    {
        DropCover(true, false);
    }
    // End:0x23C
    else
    {
        TdGotoState('SubAction_ExitingCover', 'ExitClaimFailed', "Cover dropped...",, true);
    }
    PopState();
FailReachMoveGoal:

    goto 'Fail';
Fail:

    DropCover(true, false);
    SetIsInCover(false);
    PopState();
    stop;                
}

state SubAction_ExitingCover extends TdState
{
    function BeginState(name PreviousStateName)
    {
        super.BeginState(PreviousStateName);
        SetInterruptable(false, 'ExitCover');
        //return;        
    }

    function EndState(name NextStateName)
    {
        super.EndState(NextStateName);
        SetInterruptable(true, 'ExitCover');
        SetIsInCover(false);
        //return;        
    }

    event Tick(float DeltaTime)
    {
        // End:0x23
        if(WorldInfo.Game.IsTdPaused())
        {
            return;
        }
        UpdatePawnFocus();
        UpdatePose();
        HeadFocus.Tick(DeltaTime);
        SetRotation(Pawn.Rotation);
        // End:0xA7
        if(Enemy != none)
        {
            // End:0x91
            if(EnemyVisible)
            {
                LastActuallySeenLocation = myEnemy.GetViewpointLocation();
            }
            AIManager.SetLastSeenLocation(myEnemy);
        }
        //return;        
    }

Begin:
    Sleep(0.010);
    CoverController.PrePerformCoverAction();
    SetCoverAction(3);
    bExitedCover = true;
    SetTimer(0.50, false, 'ClearExitedCover');
    TdGotoState('WhatToDo',,,, true);
ExitClaimFailed:

    Sleep(0.010);
    CoverController.PrePerformCoverAction();
    SetCoverAction(3);
    bExitedCover = true;
    SetTimer(0.50, false, 'ClearExitedCover');
    TdGotoState('WhatToDo',,,, true);
    stop;                
}

state SubAction_MoveToGoal extends TdState
{
    function PushedState()
    {
        super(Object).PushedState();
        bMovingToGoal = true;
        bFirstSearch = true;
        bFirstMoveTowards = true;
        bReachedMoveGoal = false;
        bAtGoodFiringPosition = false;
        ClearMovementFlags();
        // End:0x54
        if(IsMovingToCover)
        {
            SetTimer(0.050, true, 'CheckIntoCover');
        }
        CheckForceWalk();
        //return;        
    }

    function PoppedState()
    {
        super(Object).PoppedState();
        ClearTimer('CheckIntoCover');
        ClearLatentAction(class'SeqAct_AIMoveToActor', !bReachedMoveGoal);
        ClearMovementFlags();
        Pawn.bForceKeepAnchor = false;
        ClearMovementFlags();
        SetMoveTarget(none);
        bMovingToGoal = false;
        ScriptActivated(false);
        //return;        
    }

    function CheckForceWalk()
    {
        local TdBotPawn blocker;
        local NavigationPoint np;

        np = NavigationPoint(MoveTarget);
        // End:0xA2
        if((np != none) && !np.bNeedsVelocityToTrigger)
        {
            blocker = IsAIBlockingPath(MoveTarget.Location, 1.0);
            // End:0xA2
            if(myPawn.VelocityMagnitude2D < (myPawn.AnimationWalkSpeed + 10.0))
            {
                myPawn.ForceWalking(blocker != none, 'SubAction_MoveToGoal');
            }
        }
        SetTimer(0.20, false, 'CheckForceWalk');
        //return;        
    }

    function CheckIntoCover()
    {
        local Vector PlayerToCoverDirection;

        PlayerToCoverDirection = CurrentCover.Location - Pawn.Location;
        PlayerToCoverDirection.Z = 0.0;
        // End:0x8D
        if((PlayerToCoverDirection Dot CurrentCover.Direction) > 0.0)
        {
            // End:0x8D
            if(VSize2D(PlayerToCoverDirection) < 30.0)
            {
                TdGotoState(GetStateName(), 'ReachedGoal', string(GetFuncName()));
            }
        }
        //return;        
    }

    function bool IsAtMoveGoal()
    {
        local bool Result;

        // End:0x31
        if((MoveGoal != none) && Pawn.Anchor == MoveGoal)
        {
            Result = true;
        }
        // End:0xBC
        else
        {
            // End:0x56
            if(DynamicAnchor(Pawn.Anchor) != none)
            {
                Result = false;
            }
            // End:0xBC
            else
            {
                // End:0x84
                if(MoveGoal != none)
                {
                    Result = Pawn.ReachedDestination(MoveGoal);
                }
                // End:0xBC
                else
                {
                    // End:0xBC
                    if(MovePoint != vect(0.0, 0.0, 0.0))
                    {
                        Result = Pawn.ReachedPoint(MovePoint, none);
                    }
                }
            }
        }
        return Result;
        //return ReturnValue;        
    }

    function NotifyCoverDropped()
    {
        PopState();
        //return;        
    }

    function StopMoving()
    {
        PopState();
        //return;        
    }

Begin:
    // End:0x21
    if(WorldInfo.TimeSeconds == MoveToGoalTimeStamp)
    {
        Sleep(0.010);
    }
    MoveToGoalTimeStamp = WorldInfo.TimeSeconds;
    bStopMoveToGoal = false;
    myPawn.bHasStoppedAtFinalGoal = false;
    StartingLocation = Pawn.Location;
CheckMove:

    // End:0x7C
    if(IsAtMoveGoal())
    {
        goto 'ReachedGoal';
    }
loop:

    // End:0x9B
    if(Pawn.Anchor == none)
    {
        SetBestAnchor();
    }
    SetMoveTarget(none);
    // End:0x176
    if(MoveGoal != none)
    {
        // End:0x107
        if(OkToMoveDirectlyToActor())
        {
            SetMoveTarget(MoveGoal);
            ClearRouteCache();
            MoveToward(MoveTarget,, MoveOffset);
            bFirstDestination = false;
            // End:0xFA
            if(bStopMoveToGoal)
            {
                goto 'ReachedGoal';
            }
            goto 'CheckMove';
        }
        // End:0x173
        else
        {
            // End:0x156
            if(!bSkipPathFind || RouteCache.Length == 0)
            {
                Pawn.bForceKeepAnchor = false;
                TdFindPathToward(MoveGoal);
                // End:0x153
                if(MoveTarget == none)
                {
                    PopState();
                }
            }
            // End:0x16B
            else
            {
                SetMoveTarget(RouteCache[0]);
                bSkipPathFind = false;
            }
            bFirstSearch = false;
        }
    }
    // End:0x25C
    else
    {
        // End:0x25C
        if(MovePoint != vect(0.0, 0.0, 0.0))
        {
            // End:0x1F0
            if(bSkipReachableTest || OkToMoveDirectlyToPoint())
            {
                bSkipReachableTest = false;
                SetMoveTarget(none);
                ClearRouteCache();
                MoveTo(MovePoint);
                bFirstDestination = false;
                // End:0x1E3
                if(bStopMoveToGoal)
                {
                    goto 'ReachedGoal';
                }
                goto 'CheckMove';
            }
            // End:0x25C
            else
            {
                // End:0x23F
                if(!bSkipPathFind || RouteCache.Length == 0)
                {
                    Pawn.bForceKeepAnchor = false;
                    TdFindPathTo(MovePoint);
                    // End:0x23C
                    if(MoveTarget == none)
                    {
                        PopState();
                    }
                }
                // End:0x254
                else
                {
                    SetMoveTarget(RouteCache[0]);
                    bSkipPathFind = false;
                }
                bFirstSearch = false;
            }
        }
    }
    // End:0x2F2
    if(MoveTarget != none)
    {
        MoveToward(MoveTarget,, ((MoveTarget == MoveGoal) ? MoveOffset : 0.0));
        // End:0x2AC
        if(MoveTimer < float(0))
        {
            bSkipPathFind = false;
            goto 'loop';
        }
        bFirstDestination = false;
        // End:0x2C7
        if(bStopMoveToGoal)
        {
            goto 'ReachedGoal';
        }
        // End:0x2EF
        if((MoveTarget == MoveGoal) && IsAtMoveGoal())
        {
            goto 'ReachedGoal';
        }
    }
    // End:0x310
    else
    {
        // End:0x310
        if(!IsAtMoveGoal())
        {
            Sleep(1.0);
            PopState();
        }
    }
    goto 'loop';
ReachedGoal:

    bReachedMoveGoal = true;
    bStopMoveToGoal = false;
    PopState();
    stop;            
}

state ScriptedMoveTo extends TdState
{
    function BeginState(name PreviousStateName)
    {
        super.BeginState(PreviousStateName);
        ScriptActivated(true);
        bUseSaferPaths = false;
        bAvoidPopulatedPaths = false;
        StartFiring();
        //return;        
    }

    function EndState(name NextStateName)
    {
        super.EndState(NextStateName);
        ScriptActivated(false);
        ClearLatentAction(class'SeqAct_AIMoveToActor', true);
        bUseSaferPaths = default.bUseSaferPaths;
        bAvoidPopulatedPaths = default.bAvoidPopulatedPaths;
        //return;        
    }

Begin:
    Pawn.SetWalking(false);
    // End:0x3C
    if(SetMoveGoal(ScriptedMoveTarget, ScriptedFocus,, false))
    {
        HaltAfterMoveToGoal = true;
        MoveToTarget();
    }
    TdGotoState('WhatToDo',, "ScriptedMoveTo finished!");
    stop;                
}

