function ReportAdvancing(Vector Dest)
{
    local TdAIController myFriend;
    local float dotDir;
    local Vector EnemyDirection, destDir;

    EnemyDirection = Normal(myEnemy.Location - myPawn.Location);
    destDir = Normal(Dest - myPawn.Location);
    dotDir = destDir Dot EnemyDirection;
    // End:0xEB
    if(dotDir > 0.60)
    {
        myFriend = ClosestFriend();
        // End:0xDD
        if((myFriend != none) && VSizeSq(myFriend.Pawn.Location - Pawn.Location) < 1000000.0)
        {
            myFriend.Say(0, 1.0, 1, 1.0);
        }
        // End:0xEB
        else
        {
            Say(0);
        }
    }
    //return;    
}

function ReportMoveBack(int VO)
{
    local TdAIController myFriend;

    // End:0x0B
    if(bEnemyDead)
    {
        return;
    }
    // End:0x91
    if(FRand() > 0.50)
    {
        myFriend = ClosestFriend();
        // End:0x91
        if((myFriend != none) && VSizeSq(myFriend.Pawn.Location - Pawn.Location) < 1000000.0)
        {
            myFriend.Say(15, 1.0, VO, 1.0);
            return;
        }
    }
    Say(VO);
    //return;    
}

