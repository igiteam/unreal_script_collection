class TdMove_Melee_PatrolCop extends TdMove_BotMelee
    config(AIMeleeAttacks);

simulated function TriggerMiss()
{
    // End:0x5B
    if(BotOwner.myController.UseFullBodyMelee())
    {
        PawnOwner.UseRootMotion(true);
        PlayMoveAnim(0, 'MeleeMiss', 1.0, 0.0, 0.10, true, false);
    }
    // End:0x92
    else
    {
        PawnOwner.UseRootMotion(false);
        PlayMoveAnim(1, 'MeleeMiss', 1.0, 0.0, 0.10);
    }
    //return;    
}

defaultproperties
{
    GenericAttackProperties=(HitRange=110.0,Damage=40.0)
}