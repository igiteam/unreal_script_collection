private native final function bool HasValidCoverDirection(CoverLink ActiveCoverLink, int ActiveSlotId);

function bool SelectCoverDirection(out TdAIAnimationController.ECoverDirectionState iCoverDirection)
{
    iCoverDirection = SelectCoverDirectionInternal(Link, SlotIdx);
    // End:0x28
    if(iCoverDirection != 0)
    {
        return true;
    }
    return false;
    //return ReturnValue;    
}

// Export UTdCover::execSelectCoverDirectionInternal(FFrame&, void* const)
private native final function TdAIAnimationController.ECoverDirectionState SelectCoverDirectionInternal(CoverLink ActiveCoverLink, int ActiveSlotId);

// Export UTdCover::execFindClosestUsableCover(FFrame&, void* const)
private native final function FindClosestUsableCover(out CoverLink out_Link, out int out_SlotId);

function CoverSlotMarker GetSlotMarker()
{
    return Link.super(TdCover).GetSlotMarker(SlotIdx);
    //return ReturnValue;    
}

function bool FindNewCover()
{
    local int ClosestSlotId;
    local CoverLink ClosestCoverLink;
    local bool bPassedPathTest;

    FindClosestUsableCover(ClosestCoverLink, ClosestSlotId);
    // End:0x1D
    if(ClosestCoverLink == none)
    {
        return false;
    }
    // End:0x10A
    if(Owner.bUseCoverPathRestrictions)
    {
        bPassedPathTest = false;
        Owner.StoreMovementVariables();
        Owner.StorePathfindingParams();
        Owner.SetPathfindingParams(true, false);
        // End:0xBC
        if(Owner.SetMoveGoal(ClosestCoverLink.GetSlotMarker(ClosestSlotId)))
        {
            bPassedPathTest = Owner.HaveAValidCoverPath();
        }
        Owner.RestorePathfindingParams();
        // End:0x10A
        if(!bPassedPathTest)
        {
            Owner.RestoreMovementVariables();
            AddToIgnoreList(ClosestCoverLink, ClosestSlotId, 5.0);
            return false;
        }
    }
    // End:0x14C
    if(bClaimed)
    {
        // End:0x142
        if(Owner.CurrentCover == self)
        {
            Owner.DropCover(false, false);
        }
        // End:0x14C
        else
        {
            Drop();
        }
    }
    Link = ClosestCoverLink;
    SlotIdx = ClosestSlotId;
    Owner.ClaimCover(self, true);
    return true;
    //return ReturnValue;    
}

function bool PickClosestCover()
{
    local int ActiveSlotId, ClosestSlotId;
    local float ShortestDistanceSq;
    local CoverLink ActiveCoverLink, ClosestCoverLink;
    local float tempDistanceSq;
    local Vector CoverLocation;

    ClosestSlotId = -1;
    ActiveCoverLink = Owner.WorldInfo.CoverList;
    J0x2A:
    // End:0x124 [Loop If]
    if(ActiveCoverLink != none)
    {
        ActiveSlotId = 0;
        J0x3C:
        // End:0x10C [Loop If]
        if(ActiveSlotId < ActiveCoverLink.Slots.Length)
        {
            // End:0x79
            if((ActiveCoverLink == Link) && ActiveSlotId == SlotIdx)
            {
                // [Explicit Continue]
                goto J0x102;
            }
            CoverLocation = ActiveCoverLink.GetSlotLocation(ActiveSlotId);
            tempDistanceSq = VSizeSq2D(Owner.Pawn.Location - CoverLocation);
            // End:0x102
            if((ClosestSlotId == -1) || tempDistanceSq < ShortestDistanceSq)
            {
                ClosestSlotId = ActiveSlotId;
                ClosestCoverLink = ActiveCoverLink;
                ShortestDistanceSq = tempDistanceSq;
            }
            J0x102:
            ++ ActiveSlotId;
            // [Loop Continue]
            goto J0x3C;
        }
        ActiveCoverLink = ActiveCoverLink.NextCoverLink;
        // [Loop Continue]
        goto J0x2A;
    }
    // End:0x1A0
    if(ClosestCoverLink != none)
    {
        // End:0x171
        if(bClaimed)
        {
            // End:0x167
            if(Owner.CurrentCover == self)
            {
                Owner.DropCover(false, false);
            }
            // End:0x171
            else
            {
                Drop();
            }
        }
        Link = ClosestCoverLink;
        SlotIdx = ClosestSlotId;
        Owner.ClaimCover(self, true);
        J0x1A0:
    }
    // End:0x1A0
    else
    {
    }
    return ClosestCoverLink != none;
    //return ReturnValue;    
}

function PickRandomCover()
{
    local int Index, ActiveSlotId, RandomCoverLink, NumberOfCoverLinks;
    local CoverLink ActiveCoverLink;

    bAlwaysValid = true;
    ActiveCoverLink = Owner.WorldInfo.CoverList;
    J0x27:
    // End:0x51 [Loop If]
    if(ActiveCoverLink != none)
    {
        ++ NumberOfCoverLinks;
        ActiveCoverLink = ActiveCoverLink.NextCoverLink;
        // [Loop Continue]
        goto J0x27;
    }
    RandomCoverLink = Rand(NumberOfCoverLinks);
    ActiveCoverLink = Owner.WorldInfo.CoverList;
    J0x7D:
    // End:0xB4 [Loop If]
    if(ActiveCoverLink != none)
    {
        // End:0x9C
        if(++ Index == RandomCoverLink)
        {
            // [Explicit Break]
            goto J0xB4;
        }
        ActiveCoverLink = ActiveCoverLink.NextCoverLink;
        J0xB4:
        // [Loop Continue]
        goto J0x7D;
    }
    ActiveSlotId = Rand(ActiveCoverLink.Slots.Length);
    // End:0x10E
    if(bClaimed)
    {
        // End:0x104
        if(Owner.CurrentCover == self)
        {
            Owner.DropCover(false, false);
        }
        // End:0x10E
        else
        {
            Drop();
        }
    }
    Link = ActiveCoverLink;
    SlotIdx = ActiveSlotId;
    Owner.ClaimCover(self, true);
    //return;    
}

function CoverDrawDebug()
{
    local Vector LineLocation;

    LineLocation = Location;
    LineLocation.Z = 150.0;
    Owner.myPawn.DrawDebugLine(LineLocation, LineLocation + (100.0 * Direction), 128, 255, 128, false);
    LineLocation = CoverLeftLocation;
    LineLocation.Z = 150.0;
    // End:0xF9
    if(bLeanLeft)
    {
        Owner.myPawn.DrawDebugLine(LineLocation, LineLocation + (100.0 * Direction), 128, 255, 128, false);
        Owner.myPawn.DrawDebugLine(LineLocation, LineLocation + (140.0 * CoverLeftDirection), 128, 255, 128, false);
    }
    // End:0x16B
    else
    {
        Owner.myPawn.DrawDebugLine(LineLocation, LineLocation + (100.0 * Direction), 128, 128, 128, false);
        Owner.myPawn.DrawDebugLine(LineLocation, LineLocation + (140.0 * CoverLeftDirection), 128, 128, 128, false);
    }
    LineLocation = CoverRightLocation;
    LineLocation.Z = 150.0;
    // End:0x20A
    if(bLeanRight)
    {
        Owner.myPawn.DrawDebugLine(LineLocation, LineLocation + (100.0 * Direction), 128, 255, 128, false);
        Owner.myPawn.DrawDebugLine(LineLocation, LineLocation + (140.0 * CoverRightDirection), 128, 255, 128, false);
    }
    // End:0x27C
    else
    {
        Owner.myPawn.DrawDebugLine(LineLocation, LineLocation + (100.0 * Direction), 128, 128, 128, false);
        Owner.myPawn.DrawDebugLine(LineLocation, LineLocation + (140.0 * CoverRightDirection), 128, 128, 128, false);
    }
    //return;    
}

function AddToIgnoreList(CoverLink L, int S, float Time)
{
    local IgnoreStruct C;

    C.Link = L;
    C.Slot = S;
    C.IgnoreTime = Time;
    C.StartTimeStamp = Owner.WorldInfo.TimeSeconds;
    IgnoreList[IgnoreList.Length] = C;
    //return;    
}

