class TdCover extends Object
    native;

enum ECoverQuality
{
    ECQ_Invalid,
    ECQ_Poor,
    ECQ_Good,
    ECQ_Perfect,
    ECQ_MAX
};

struct native IgnoreStruct
{
    var CoverLink Link;
    var int Slot;
    var float IgnoreTime;
    var float StartTimeStamp;

    structdefaultproperties
    {
        Link=none
        Slot=0
        IgnoreTime=0.0
        StartTimeStamp=0.0
    }
};

var TdAIController Owner;
var int SlotIdx;
var CoverLink Link;
var int PreviousSlotIdx;
var CoverLink PreviousCoverLink;
var array<IgnoreStruct> IgnoreList;
var Vector Direction;
var Rotator Rotation;
var Vector Location;
var Vector CoverLeftLocation;
var Vector CoverRightLocation;
var Vector CoverLeftDirection;
var Vector CoverRightDirection;
var Vector FireLeftLocation;
var Vector FireRightLocation;
var Engine.CoverLink.ECoverType CoverType;
var bool bLeanLeft;
var bool bLeanRight;
var bool bCanPopUp;
var bool bClaimed;
var bool bAlwaysValid;
var float LastCoverTime;

function Initialize(TdAIController Drone)
{
    Owner = Drone;
    //return;    
}

function SetupCover()
{
    Location = Link.GetSlotLocation(SlotIdx);
    Rotation = Link.GetSlotRotation(SlotIdx);
    Direction = vector(Rotation);
    FireRightLocation = Link.GetSlotFireLocation(SlotIdx, 4);
    FireLeftLocation = Link.GetSlotFireLocation(SlotIdx, 3);
    bLeanLeft = Link.Slots[SlotIdx].bLeanLeft;
    bLeanRight = Link.Slots[SlotIdx].bLeanRight;
    CoverType = Link.Slots[SlotIdx].CoverType;
    bCanPopUp = Link.Slots[SlotIdx].bCanPopUp && CoverType != 1;
    CoverLeftLocation = FireLeftLocation + (40.0 * Normal(vector(GetFireRotation(2))));
    CoverRightLocation = FireRightLocation + (40.0 * Normal(vector(GetFireRotation(1))));
    CoverLeftDirection = Normal(vector((GetFireRotation(2)) + rot(0, 8192, 0)));
    CoverRightDirection = Normal(vector((GetFireRotation(1)) - rot(0, 8192, 0)));
    //return;    
}

function Vector GetFireLocation(TdAIAnimationController.ECoverDirectionState Dir)
{
    // End:0x19
    if(Dir == 1)
    {
        return FireRightLocation;
    }
    // End:0x38
    else
    {
        // End:0x32
        if(Dir == 2)
        {
            return FireLeftLocation;
        }
        // End:0x38
        else
        {
            return Location;
        }
    }
    //return ReturnValue;    
}

function Rotator GetFireRotation(TdAIAnimationController.ECoverDirectionState Dir)
{
    local Rotator R;

    // End:0x3F
    if(Dir == 1)
    {
        R.Yaw = Rotation.Yaw + (65535 / 4);
    }
    // End:0x6B
    else
    {
        R.Yaw = Rotation.Yaw - (65535 / 4);
    }
    return R;
    //return ReturnValue;    
}

function Claim()
{
    SetupCover();
    bClaimed = Link.super(TdCover).Claim(Owner, SlotIdx);
    //return;    
}

function bool HasClaimedCover()
{
    return bClaimed;
    //return ReturnValue;    
}

function Drop()
{
    // End:0x68
    if(bClaimed)
    {
        PreviousCoverLink = Link;
        PreviousSlotIdx = SlotIdx;
        Link.UnClaim(Owner, SlotIdx, true);
        Link = none;
        bClaimed = false;
        LastCoverTime = Owner.WorldInfo.TimeSeconds;
    }
    //return;    
}

function MarkInvalid()
{
    // End:0x0D
    if(Link == none)
    {
        return;
    }
    Link.bInvalidCover = true;
    //return;    
}

function MarkAsTemporaryInvalid(float InvalidTime)
{
    // End:0x0D
    if(Link == none)
    {
        return;
    }
    Link.IvalidUntilThisTime = Owner.WorldInfo.TimeSeconds + InvalidTime;
    //return;    
}

