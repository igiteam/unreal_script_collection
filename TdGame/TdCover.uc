function bool HaveOppositeCoverDir(TdAIAnimationController.ECoverDirectionState Dir)
{
    // End:0x1A
    if(Dir == 2)
    {
        return bLeanRight;
    }
    // End:0x31
    else
    {
        // End:0x31
        if(Dir == 1)
        {
            return bLeanLeft;
        }
    }
    return false;
    //return ReturnValue;    
}
