native final function TdCover.ECoverQuality GetCoverQuality(CoverLink ActiveCoverLink, int ActiveSlotId);

function bool IsValid(Vector EnemyPosition, bool bFireCover)
{
    return IsCoverValid(EnemyPosition, Link, SlotIdx, bFireCover);
    //return ReturnValue;    
}

// Export UTdCover::execIsCoverValid(FFrame&, void* const)
native final function bool IsCoverValid(Vector EnemyPosition, CoverLink ActiveCoverLink, int ActiveSlotId, bool bFireCover);

