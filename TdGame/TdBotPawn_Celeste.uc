class TdBotPawn_Celeste extends TdBotPawn_PursuitCop
    config(AI)
    hidecategories(Navigation);

function bool LoseWeaponAfterDisarm()
{
    return false;
    //return ReturnValue;    
}

function TakeDamage(int Damage, Controller InstigatedBy, Vector HitLocation, Vector damageMomentum, class<DamageType> DamageType, optional TraceHitInfo HitInfo, optional Actor DamageCauser)
{
    local float HealthBefore;
    local int NrOfHitsToTake;

    // End:0x24
    if((DamageType == class'TdDmgType_Flashbang') || DamageType == class'TdDmgType_HeavyFlashbang')
    {
        return;
    }
    HealthBefore = float(Health);
    Damage = Min(int(HealthBefore - float(1)), Damage);
    super.TakeDamage(Damage, InstigatedBy, HitLocation, damageMomentum, DamageType, HitInfo, DamageCauser);
    // End:0x1A1
    if(float(Health) < HealthBefore)
    {
        switch(myController.GetDifficultyLevel())
        {
            // End:0xCD
            case 0:
                NrOfHitsToTake = AITemplate_Celeste(myController.myTemplate).NrOfHitsToTake.Easy;
                // End:0x13D
                break;
            // End:0x103
            case 1:
                NrOfHitsToTake = AITemplate_Celeste(myController.myTemplate).NrOfHitsToTake.Medium;
                // End:0x13D
                break;
            // End:0x13A
            case 2:
                NrOfHitsToTake = AITemplate_Celeste(myController.myTemplate).NrOfHitsToTake.Hard;
                // End:0x13D
                break;
            // End:0xFFFF
            default:
                TdAi_Celeste(myController).bMeleeHitCount = Min(NrOfHitsToTake, TdAi_Celeste(myController).bMeleeHitCount + 1);
                TdAi_Celeste(myController).bIsVulnerableToDisarm = TdAi_Celeste(myController).bMeleeHitCount == NrOfHitsToTake;
            }
            Health = 100;
            //return;            
}

