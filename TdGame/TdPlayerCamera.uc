                case 'FreeCam':
                    Loc = TargetLocation;
                    Rot = OutVT.Target.Rotation;
                    // End:0x5BD
                    if(CameraStyle == 'FreeCam')
                    {
                        Rot = PCOwner.Rotation;
                    }
                    // End:0x608
                    else
                    {
                        // End:0x601
                        if(CameraStyle == 'ThirdPerson360')
                        {
                            ThirdPerson360Yaw += int(float(32000) * DeltaTime);
                            Rot.Yaw += ThirdPerson360Yaw;
                        }
                        // End:0x608
                        else
                        {
                            ThirdPerson360Yaw = 0;
                        }
                    }
                    Loc += (FreeCamOffset >> Rot);
                    pos = Loc - (vector(Rot) * FreeCamDistance);
                    HitActor = Trace(HitLocation, HitNormal, pos, Loc, false, vect(0.0, 0.0, 0.0));
                    // End:0x68A
                    if(HitActor != none)
                    {
                        Loc = HitLocation + (HitNormal * float(2));
                    }
                    // End:0x695
                    else
