                    OutVT.POV.Location = Loc;
                    OutVT.POV.Rotation = Rot;
                    // End:0x73E
                    break;
                // End:0x6E6
                case 'FirstPerson':
                // End:0xFFFF
                default:
                    OutVT.Target.GetActorEyesViewPoint(OutVT.POV.Location, OutVT.POV.Rotation);
