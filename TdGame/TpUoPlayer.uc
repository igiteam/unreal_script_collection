function bool WriteProfileSettings(byte LocalUserNum, OnlineProfileSettings ProfileSettings)
{
    local TsSystem SaveSystem;

    // End:0x14
    if(ProfileSettings == none)
    {
        OnWriteProfileSettingsComplete_Invoke(false);
        return false;
    }
    // End:0x37
    if(ProfileSettings.AsyncState == 2)
    {
        OnWriteProfileSettingsComplete_Invoke(false);
        return false;
    }
    SaveSystem = class'TsSystem'.static.GetTsSystem();
    // End:0x5A
    if(SaveSystem == none)
    {
        return false;
    }
    SaveSystem.RegisterWriteProfileSettingsDelegate(SaveSystemWriteProfileComplete);
    return SaveSystem.WriteProfileSettings(LocalUserNum, ProfileSettings);
    //return ReturnValue;    
}

