function bool ReadProfileSettings(byte LocalUserNum, OnlineProfileSettings ProfileSettings)
{
    local TsSystem SaveSystem;

    SaveSystem = class'TsSystem'.static.GetTsSystem();
    // End:0x2A
    if(SaveSystem == none)
    {
        OnReadProfileSettingsComplete_Invoke(false);
        return false;
    }
    SaveSystem.Initialize();
    SaveSystem.RegisterReadProfileSettingsDelegate(SaveSystemReadProfileComplete);
    return SaveSystem.ReadProfileSettings(LocalUserNum, ProfileSettings);
    //return ReturnValue;    
}

function SaveSystemReadProfileComplete(Ts.TsSystem.ETsResult Result)
{
    local TsSystem SaveSystem;

    OnReadProfileSettingsComplete_Invoke(Result == 0);
    SaveSystem = class'TsSystem'.static.GetTsSystem();
    // End:0x36
    if(SaveSystem == none)
    {
        return;
    }
    SaveSystem.UnRegisterReadProfileSettingsDelegate(SaveSystemReadProfileComplete);
    //return;    
}

