function SendMessageByUsername(byte LocalUserNum, string UserName, string Message)
{
    local TpUserManager UserManager;

    StoredMessage = Message;
    UserManager = SystemBase.GetUserManager();
    UserManager.__OnGetPlayerId__Delegate = SendMessageByUsernameStepTwo;
    UserManager.LookupPlayerId(UserName);
    //return;    
}

function SendMessageByUsernameStepTwo(UniqueNetId PlayerId, bool bInOk)
{
    local TpMessageService MessageService;

    MessageService = SystemBase.GetMessageService();
    MessageService.__OnSendMessage__Delegate = OnSendMessageByUsernameDone;
    MessageService.SendMessageAsync(PlayerId, StoredMessage);
    StoredMessage = "";
    //return;    
}

function OnSendMessageByUsernameDone(bool bInOk)
{
    OnSendMessageByUsername_Invoke(bInOk);
    //return;    
}

