function OnlineProfileSettings GetProfileSettings(byte LocalUserNum)
{
    local LocalPlayer LP;
    local GameUISceneClient SceneClient;

    SceneClient = class'UIRoot'.static.GetSceneClient();
    // End:0x23
    if(SceneClient == none)
    {
        return none;
    }
    // End:0xBC
    foreach SceneClient.Outer.Outer.Outer.GamePlayers(LP,)
    {
        // End:0xBB
        if((LP.ControllerId == LocalUserNum) && LP.Actor != none)
        {            
            return LP.Actor.OnlinePlayerData.ProfileProvider.Profile;
        }        
    }    
    return none;
    //return ReturnValue;    
}

