function SetOnlineStatus(byte LocalUserNum, int StatusId, const out array<LocalizedStringSetting> LocalizedStringSettings, const out array<SettingsProperty> Properties)
{
    local TpPresenceManager PresenceManager;
    local int ContextId, ContextValue;

    // End:0x3C
    if(LocalizedStringSettings.Length > 0)
    {
        ContextId = LocalizedStringSettings[0].Id;
        ContextValue = LocalizedStringSettings[0].ValueIndex;
    }
    PresenceManager = SystemBase.GetPresenceManager();
    PresenceManager.SetPresence(LocalUserNum, StatusId, ContextId, ContextValue);
    //return;    
}

