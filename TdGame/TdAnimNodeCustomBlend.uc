class TdAnimNodeCustomBlend extends TdAnimNodeBlendList
    native
    hidecategories(Object,Object,Object);

var float Duration;
var float BlendOutTime;

simulated function Activate(float Amount, float _Duration, float BlendIn, float BlendOut)
{
    TargetWeight[0] = 1.0 - Amount;
    TargetWeight[1] = Amount;
    BlendTimeToGo = BlendIn;
    ActiveChildIndex = 1;
    BlendOutTime = BlendOut;
    Duration = _Duration;
    //return;    
}

event OnBecomeRelevant()
{
    // End:0x1F
    if(Duration <= 0.0)
    {
        SetActiveChild(0, 0.0);
    }
    super(AnimNode).OnBecomeRelevant();
    //return;    
}

defaultproperties
{
    BlendWeight(0)=1.0
    BlendWeight(1)=0.0
    Children=/* Array type was not detected. */
    bFixNumChildren=true
}