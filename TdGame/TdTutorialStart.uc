class TdTutorialStart extends TdPlayerStart
    hidecategories(Navigation,Lighting,LightColor,Force);

var() array<TdSPTutorialGame.EMovementChallenge> BelongToChallenge;

function bool IsStartSpotInTrack(int TrackIndex)
{
    local int Idx;

    Idx = 0;
    J0x07:
    // End:0x3A [Loop If]
    if(Idx < BelongToChallenge.Length)
    {
        // End:0x30
        if(BelongToChallenge[Idx] == TrackIndex)
        {
            return true;
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    return false;
    //return ReturnValue;    
}

