                // End:0x15A
                break;
            // End:0x157
            case 1:
                return SlideAttackPropertiesH;
                // End:0x15A
                break;
            // End:0xFFFF
            default:
            }
            //return ReturnValue;            
}

simulated function TriggerHit()
{
    bAttackDidHit = true;
    switch(AttackType)
    {
        // End:0x3D
        case 0:
            AnimationName = 'MeleeJumpEnd';
            BlendInTime = 0.10;
            BlendOutTime = 0.30;
            // End:0xF4
            break;
        // End:0x6A
        case 3:
            AnimationName = 'MeleeRunHit';
            BlendInTime = 0.10;
            BlendOutTime = 0.30;
            // End:0xF4
            break;
        // End:0x97
        case 2:
            AnimationName = 'MeleeKickHit';
            BlendInTime = 0.10;
            BlendOutTime = 0.30;
            // End:0xF4
            break;
        // End:0xC4
        case 1:
            AnimationName = 'MeleeSlideHit';
            BlendInTime = 0.10;
            BlendOutTime = 0.30;
            // End:0xF4
            break;
        // End:0xF1
        case 4:
            AnimationName = 'MeleeShoveEnd';
            BlendInTime = 0.10;
            BlendOutTime = 0.30;
            // End:0xF4
            break;
        // End:0xFFFF
        default:
            PlayMoveAnim(2, AnimationName, 1.0, BlendInTime, BlendOutTime, true);
            BotOwner.SetOverrideWalkingState(0, BlendInTime);
            BotOwner.UseRootMotion(true);
            BotOwner.UseRootRotation(true);
            //return;
    }    
}

simulated function TriggerMiss()
{
    local float AnimationSpeedFactor;

    TdAI_Pursuit(TdBotPawn(PawnOwner).myController).NotifyAttackMiss(AttackType);
    bAttackDidHit = false;
    switch(AttackType)
    {
        // End:0x6A
        case 0:
            AnimationName = 'MeleeJumpEnd';
            BlendInTime = 0.10;
            BlendOutTime = 0.30;
            // End:0x121
            break;
        // End:0x97
        case 3:
            AnimationName = 'MeleeRunMiss';
            BlendInTime = 0.10;
            BlendOutTime = 0.30;
            // End:0x121
            break;
        // End:0xC4
        case 2:
            AnimationName = 'MeleeKickMiss';
            BlendInTime = 0.10;
            BlendOutTime = 0.30;
            // End:0x121
            break;
        // End:0xF1
        case 1:
            AnimationName = 'MeleeSlideMiss';
            BlendInTime = 0.10;
            BlendOutTime = 0.30;
            // End:0x121
            break;
        // End:0x11E
        case 4:
            AnimationName = 'MeleeShoveEnd';
            BlendInTime = 0.10;
            BlendOutTime = 0.30;
            // End:0x121
            break;
        // End:0xFFFF
        default:
            // End:0x174
            if(BotOwner.myController.GetDifficultyLevel() == 2)
            {
                SetMoveTimer(AttackProperties.MissedAttackPenelty, false, 'StopMissAnimation');
                AnimationSpeedFactor = 1.20;
            }
            // End:0x17F
            else
            {
                AnimationSpeedFactor = 1.0;
            }
            PlayMoveAnim(2, AnimationName, AnimationSpeedFactor, BlendInTime, BlendOutTime, true);
            BotOwner.SetOverrideWalkingState(0, BlendInTime);
            BotOwner.UseRootMotion(true);
            BotOwner.UseRootRotation(true);
            //return;
    }    
}

simulated function OnCustomAnimEnd(AnimNodeSequence SeqNode, float PlayedTime, float ExcessTime)
{
    // End:0x28
    if(MeleeStage == 0)
    {
        super.OnCustomAnimEnd(SeqNode, PlayedTime, ExcessTime);
    }
    // End:0x40
    else
    {
        PawnOwner.SetMove(1);
    }
    //return;    
}

simulated function StopMissAnimation()
{
    PawnOwner.SetMove(1);
    //return;    
}

