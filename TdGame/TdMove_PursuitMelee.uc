                // End:0xE5
                break;
            // End:0xD4
            case 4:
                return ShoveAttackPropertiesN;
                // End:0xE5
                break;
            // End:0xE2
            case 1:
                return SlideAttackPropertiesN;
                // End:0xE5
                break;
            // End:0xFFFF
            default:
                // End:0x15A
                break;
            }
    }
    // End:0x15A
    if(BotOwner.myController.GetDifficultyLevel() == 2)
    {
        switch(Attack)
        {
            // End:0x11F
            case 0:
                return JumpKickAttackPropertiesH;
                // End:0x15A
                break;
            // End:0x12D
            case 3:
                return RunAttackPropertiesH;
                // End:0x15A
                break;
            // End:0x13B
            case 2:
                return StandAttackPropertiesH;
                // End:0x15A
                break;
            // End:0x149
