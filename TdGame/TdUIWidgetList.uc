                            {
                                SelectItem(CurrentIndex + MaxVisibleItems);
                            }
                        }
                    }
                }
            }
        }
    }
    // End:0x1AA
    else
    {
        // End:0x1AA
        if(EventParms.EventType == 1)
        {
            // End:0x1AA
            if(EventParms.InputAliasName == 'AcceptOptions')
            {
                PlayUISound('ListSubmit');
                OnAcceptOptions(self, EventParms.PlayerIndex);
            }
