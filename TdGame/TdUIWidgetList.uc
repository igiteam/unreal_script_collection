        {
            SelectPreviousItem(true);
        }
        // End:0x13E
        else
        {
            // End:0x73
            if(EventParms.InputAliasName == 'SelectionDown')
            {
                SelectNextItem(true);
            }
            // End:0x13E
            else
            {
                // End:0x9F
                if(EventParms.InputAliasName == 'SelectionHome')
