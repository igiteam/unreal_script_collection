}

function HandleEnemySeen(TdAIController Drone, TdPawn aPawn)
{
    // End:0x0B
    if(scriptingActivated)
    {
        return;
    }
    NoticedEnemy(Drone, aPawn);
    //return;    
}

function HandleEnemyExposed(TdPawn aPawn)
{
    // End:0x0B
    if(scriptingActivated)
    {
        return;
    }
    ExposedEnemy(aPawn);
    //return;    
}

