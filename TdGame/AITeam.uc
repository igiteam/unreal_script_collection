{
    //return;    
}

function AskForClosestIdleTask(TdAIController C, out Route R, out NavigationPoint G)
{
    local int I, closestRoute, closestSpot;
    local float Dist, tempDist;

    closestRoute = -1;
    closestSpot = -1;
    Dist = 100000000.0;
    I = 0;
    J0x28:
    // End:0xCB [Loop If]
    if(I < PatrolRoutesPicked.Length)
    {
        // End:0xC1
        if(PatrolRoutesPicked[I] == false)
        {
            tempDist = VSizeSq(C.Pawn.Location - PatrolRoutes[I].NavList[0].Nav.Location);
            // End:0xC1
            if(tempDist < Dist)
            {
                Dist = tempDist;
                closestRoute = I;
            }
        }
        ++ I;
        // [Loop Continue]
        goto J0x28;
    }
    I = 0;
    J0xD2:
    // End:0x15E [Loop If]
    if(I < GuardSpotsPicked.Length)
    {
        // End:0x154
        if(GuardSpotsPicked[I] == false)
        {
            tempDist = VSizeSq(C.Pawn.Location - GuardSpots[I].Location);
            // End:0x154
            if(tempDist < Dist)
            {
                Dist = tempDist;
                closestSpot = I;
            }
        }
        ++ I;
        // [Loop Continue]
        goto J0xD2;
    }
    // End:0x18E
    if(closestSpot != -1)
    {
        GuardSpotsPicked[closestSpot] = true;
        G = GuardSpots[closestSpot];
    }
    // End:0x1BB
    else
    {
        // End:0x1BB
        if(closestRoute != -1)
        {
            PatrolRoutesPicked[closestRoute] = true;
            R = PatrolRoutes[closestRoute];
        }
    }
    //return;    
}

event PostBeginPlay()
{
    super.PostBeginPlay();
    AIManager = TdSPGame(WorldInfo.Game).AIManager;
    AIManager.AddTeam(self);
    //return;    
}

event Destroyed()
{
    AIManager.RemoveTeam(self);
    //return;    
}

function TdAI_Riot GetShieldMaster(TdAIController C)
{
    local int I;
    local TdAI_Riot riot;

    // End:0x20
    if(TdAI_Riot(C) == none)
    {
        return GetShieldMasterAll(C);
    }
    I = 0;
    J0x27:
    // End:0x9B [Loop If]
    if(I < Members.Length)
    {
        riot = TdAI_Riot(Members[I]);
        // End:0x91
        if(((riot != none) && riot.IAmShieldMaster) && riot.ApplyForFormationPosition(C))
        {
            return riot;
        }
        ++ I;
        // [Loop Continue]
        goto J0x27;
    }
    return none;
    //return ReturnValue;    
}

function TdAI_Riot GetShieldMasterAll(TdAIController C)
{
    local TdAI_Riot P;

    // End:0xB0
    foreach WorldInfo.AllControllers(class'TdAI_Riot', P)
    {
        // End:0xAF
        if((P.IAmShieldMaster && VSizeSq(C.Pawn.Location - P.Pawn.Location) < C.myPawn.CMaxPathDistSq) && P.ApplyForFormationPosition(C))
        {            
            return P;
        }        
    }    
    return none;
    //return ReturnValue;    
}

