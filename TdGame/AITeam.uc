function NotifyCombatStarted()
{
    local int I;
    local Sequence GameSequence;
    local array<SequenceObject> CombatEvents;

    GameSequence = WorldInfo.GetGameSequence();
    GameSequence.FindSeqObjectsByClass(class'SeqEvt_TdCombatStarted', true, CombatEvents);
    I = 0;
    J0x38:
    // End:0x7A [Loop If]
    if(I < CombatEvents.Length)
    {
        SequenceEvent(CombatEvents[I]).CheckActivate(Enemy, Enemy, false);
        ++ I;
        // [Loop Continue]
        goto J0x38;
    }
    //return;    
}

