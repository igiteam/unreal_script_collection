{
    // End:0x0B
    if(scriptingActivated)
    {
        return;
    }
    NoticedEnemy(Drone, InstigatedBy);
    //return;    
}

function NoticedEnemy(TdAIController Drone, TdPawn aPawn)
{
    // End:0x71
    if((Enemy == none) || EnemyNotSeenTime > float(10))
    {
        // End:0x71
        if(Enemy == none)
        {
            // End:0x53
            if(FRand() > 0.50)
            {
                Drone.Say(3, 1.0, 4);
            }
            // End:0x71
            else
            {
                Drone.Say(3, 1.0, 6);
            }
        }
    }
    // End:0x8B
    if(Enemy == none)
    {
        SetEnemy(aPawn);
    }
    AIManager.SetLastSeenLocation(aPawn);
    EnemyNotSeenTime = 0.0;
    //return;    
}

function ExposedEnemy(TdPawn aPawn)
{
    // End:0x1A
    if(Enemy == none)
    {
        SetEnemy(aPawn);
    }
    AIManager.SetLastSeenLocation(aPawn);
    EnemyNotSeenTime = 0.0;
    //return;    
}

function HeardEnemy(TdAIController Drone, TdPawn aPawn)
{
    // End:0x44
    if((Enemy == none) || EnemyNotSeenTime > float(10))
    {
        // End:0x44
        if(Enemy == none)
        {
            Drone.Say(3, 1.0, 4);
        }
    }
    AIManager.SetLastSeenLocation(aPawn);
    // End:0x74
    if(Enemy == none)
    {
        SetEnemy(aPawn);
    }
    EnemyNotSeenTime = 0.0;
    //return;    
}

