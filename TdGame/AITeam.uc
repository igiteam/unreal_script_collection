function SetShieldFormationMaster(TdAI_Riot Master)
{
    // End:0x4A
    if(ShieldFormationMaster != Master)
    {
        ShieldFormationMaster = Master;
        // End:0x39
        if(ShieldFormationMaster != none)
        {
            ++ AIManager.ShieldFormations;
        }
        // End:0x4A
        else
        {
            -- AIManager.ShieldFormations;
        }
    }
    //return;    
}

function TdAIController GetClosestMember(Vector P)
{
    local float MinDist, Dist;
    local TdAIController closest;
    local int I;

    MinDist = 1000000000.0;
    I = 0;
    J0x12:
    // End:0x93 [Loop If]
    if(I < Members.Length)
    {
        Dist = VSizeSq(Members[I].Pawn.Location - AIManager.LastSeenLocation);
        // End:0x89
        if(Dist < MinDist)
        {
            MinDist = Dist;
            closest = Members[I];
        }
        ++ I;
        // [Loop Continue]
        goto J0x12;
    }
    return closest;
    //return ReturnValue;    
}

function ClientMessage(coerce string S)
{
    local TdPlayerController P;

    // End:0x44
    foreach WorldInfo.AllControllers(class'TdPlayerController', P)
    {
        // End:0x43
        if(P != none)
        {
            P.ClientMessage(S);
        }        
    }    
    //return;    
}

