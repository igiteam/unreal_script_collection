function SetEnemy(TdPawn aPawn)
{
    local int I;

    // End:0x5A
    if(Enemy != aPawn)
    {
        Enemy = aPawn;
        I = 0;
        J0x21:
        // End:0x5A [Loop If]
        if(I < Members.Length)
        {
            Members[I].SetEnemy(aPawn);
            ++ I;
            // [Loop Continue]
            goto J0x21;
        }
    }
    //return;    
}

event Tick(float DeltaTime)
{
    // End:0x0E
    if(Members.Length == 0)
    {
        return;
    }
    super.Tick(DeltaTime);
    EnemyNotSeenTime += DeltaTime;
    // End:0x56
    if((EnemyNotSeenTime < float(2)) && Enemy != none)
    {
        AIManager.SetLastSeenLocation(Enemy);
    }
    bHaveDrawnDebug = false;
    //return;    
}

