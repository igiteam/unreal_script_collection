function UpdateFocusLabelState(UIScreenObject Sender, int PlayerIndex, UIState NewlyActiveState, optional UIState PreviouslyActiveState)
{
    local TdUIFocusLabel FocusLabel;
    local int I;

    // End:0xC1
    if(Sender.Children.Length > 0)
    {
        I = 0;
        J0x1E:
