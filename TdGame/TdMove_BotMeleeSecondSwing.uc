class TdMove_BotMeleeSecondSwing extends TdMove_BotMelee
    config(AIMeleeAttacks);

function bool CanDoMove()
{
    return super.CanDoMove() && BotOwner.myController.ShouldDoSecondSwing();
    //return ReturnValue;    
}

simulated function TriggerMove()
{
    TriggerStartAnimation();
    //return;    
}

simulated function TriggerMiss()
{
    TriggerEndAnimation();
    //return;    
}

event TriggerHit()
{
    TriggerEndAnimation();
    //return;    
}

simulated function StartMove()
{
    super.StartMove();
    ClearTimer();
    //return;    
}

private final function TriggerStartAnimation()
{
    // End:0x87
    if(BotOwner.myController.UseFullBodyMelee())
    {
        PawnOwner.UseRootMotion(true);
        BlendInTime = 0.0;
        BlendOutTime = 0.0;
        AnimationName = 'MeleeFollowUpStart';
        PlayMoveAnim(0, AnimationName, AttackProperties.AttackSpeed, BlendInTime, BlendOutTime, true, false);
    }
    // End:0xEA
    else
    {
        PawnOwner.UseRootMotion(false);
        BlendInTime = 1.0;
        BlendOutTime = 0.0;
        AnimationName = 'MeleeFollowUpStart';
        PlayMoveAnim(1, AnimationName, AttackProperties.AttackSpeed, BlendInTime, BlendOutTime);
    }
    //return;    
}

private final function TriggerEndAnimation()
{
    // End:0x7C
    if(BotOwner.myController.UseFullBodyMelee())
    {
        PawnOwner.UseRootMotion(true);
        BlendInTime = 0.0;
        BlendOutTime = 0.10;
        AnimationName = 'MeleeFollowUpEnd';
        PlayMoveAnim(0, AnimationName, 1.0, BlendInTime, BlendOutTime, true, false);
    }
    // End:0xD4
    else
    {
        PawnOwner.UseRootMotion(false);
        BlendInTime = 0.0;
        BlendOutTime = 0.10;
        AnimationName = 'MeleeFollowUpEnd';
        PlayMoveAnim(1, AnimationName, 1.0, BlendInTime, BlendOutTime);
    }
    //return;    
}

simulated function class<DamageType> GetDamageType()
{
    return class'TdDmgType_MeleeSecondSwing';
    //return ReturnValue;    
}
