simulated function bool StartOnlineGame()
{
    local TpGameManager Manager;

    Manager = SystemBase.GetGameManager();
    // End:0x7F
    if(Manager != none)
    {
        // End:0x7C
        if((GameState == 0) || GameState == 4)
        {
            GameState = 1;
            Manager.__OnStartGame__Delegate = OnStartOnlineGame;
            Manager.StartGameAsync();
        }
    }
    // End:0x88
    else
    {
        OnStartOnlineGame(false);
        return false;
    }
    return true;
    //return ReturnValue;    
}

