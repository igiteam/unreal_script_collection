function AddSpecialOutput(out string Text)
{
    // End:0x185
    if(IsInState('Pursuit', true))
    {
        Text $= "\\nPursuit:\\n";
        Text $= ("    UpdatePath in:" @ ((IsTimerActive('UpdatePath')) ? string(GetTimerRate('UpdatePath') - GetTimerCount('UpdatePath')) : "-1" $ "\\n"));
        Text $= (("    IsOkToUpdatePath:" @ string(IsOkToUpdatePath())) $ "\\n");
        Text $= (("        " $ "") $ "\\n");
        Text $= (("        " $ "") $ "\\n");
        Text $= (("        " $ "") $ "\\n");
        Text $= (("        " $ "") $ "\\n");
        Text $= (("        " $ "") $ "\\n");
        Text $= (("        " $ "") $ "\\n");
    }
    //return;    
}

