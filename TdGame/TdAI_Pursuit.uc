event Possess(Pawn inPawn, bool bVehicleTransition)
{
    super.Possess(inPawn, bVehicleTransition);
    PursuitMeleeMove = TdMove_PursuitMelee(myPawn.Moves[17]);
    // End:0x4B
    if(HasSpawned())
    {
        PlayerController.InitializeNavigation();
    }
    //return;    
}

