class TdHudEffect_Saturation extends TdHudEffect
    native
    config(HudEffects);

function SpecialActivatePP()
{
    PPFadeInTimer = PPStrength.FadeInDuration;
    PPFadeInStart = PPCurrentStrength;
    PPFadeOutTimer = 0.0;
    PPPeakDurationTimer = PPStrength.Duration;
    PPTargetStrength = 1.0;
    bIsActive = true;
    //return;    
}

function SpecialDeActivatePP()
{
    PPFadeInTimer = 0.0;
    PPFadeOutTimer = PPStrength.FadeOutDuration;
    PPPeakDurationTimer = PPStrength.Duration;
    PPTargetStrength = 0.0;
    //return;    
}

defaultproperties
{
    PPStrength=(ParameterName=SaturationAmount,FadeInDuration=0.50,Duration=-1.0,FadeOutDuration=0.50)
}