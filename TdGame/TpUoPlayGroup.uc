    __OnPlayGroupGameLeave__Multicaster.RemoveItem(D);
    //return;    
}

function AddPlayGroupGameLeaveDelegate(delegate<OnPlayGroupGameLeave> OnPlayGroupGameLeaveDelegate)
{
    local TpPlayGroupManager PlayGroupManager;

    PlayGroupManager = SystemBase.GetPlayGroupManager();
    PlayGroupManager.__OnPlayGroupGameLeave__Delegate = Del_OnPlayGroupGameLeave;
    OnPlayGroupGameLeave_Add(OnPlayGroupGameLeaveDelegate);
    //return;    
}

function ClearPlayGroupGameLeaveDelegate(delegate<OnPlayGroupGameLeave> OnPlayGroupGameLeaveDelegate)
{
    OnPlayGroupGameLeave_Remove(OnPlayGroupGameLeaveDelegate);
    //return;    
}

private final simulated function Del_OnPlayGroupGameLeave()
{
    OnPlayGroupGameLeave_Invoke();
    //return;    
}

function LeaveGroupGame()
{
    local TpGameManager GameManager;

    GameManager = SystemBase.GetGameManager();
    GameManager.LeaveGameAsync();
    //return;    
}
