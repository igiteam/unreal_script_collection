class SeqAct_TdInitiateStashing extends SequenceAction
    hidecategories(Object);

var TdStashpoint Stashpoint;
var() int StashDuration;
var() int FirstStashDuration;
var() bool bFirstStashpoint;

event Activated()
{
    // End:0x70
    if(Stashpoint != none)
    {
        // End:0x45
        if(bFirstStashpoint && Stashpoint.InitiatedTriggerCount == 0)
        {
            Stashpoint.StashDuration = float(FirstStashDuration);
        }
        // End:0x5C
        else
        {
            Stashpoint.StashDuration = float(StashDuration);
        }
        Stashpoint.InitiateStashing();
    }
    //return;    
}

