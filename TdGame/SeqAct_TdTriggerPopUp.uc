class SeqAct_TdTriggerPopUp extends SequenceAction
    hidecategories(Object);

var() TdSPHUD.EPopUpType PopUpType;
var() float Duration;

event Activated()
{
    local WorldInfo WI;
    local TdPlayerController PC;

    WI = GetWorldInfo();
    // End:0x48
    foreach WI.AllControllers(class'TdPlayerController', PC)
    {
        PC.CallPopUp(PopUpType, Duration);        
    }    
    //return;    
}

defaultproperties
{
    OutputLinks=none
    VariableLinks=none
    ObjName="Pop Up"
    ObjCategory="Takedown"
}