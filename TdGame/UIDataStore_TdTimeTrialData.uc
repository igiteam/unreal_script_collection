function InitCaches()
{
    local TdProfileSettings Profile;
    local int Idx;
    local OnlineSubsystem OnlineS;

    // End:0xCD
    if(ProviderData.PlayerBest.Length != StretchIdMapping.Length)
    {
        ProviderData.PlayerBest.Remove(0, ProviderData.PlayerBest.Length);
        ProviderData.PlayerBest.Insert(0, StretchIdMapping.Length);
        ProviderData.FriendsBest.Remove(0, ProviderData.FriendsBest.Length);
        ProviderData.FriendsBest.Insert(0, StretchIdMapping.Length);
        ProviderData.WorldsBest.Remove(0, ProviderData.WorldsBest.Length);
        ProviderData.WorldsBest.Insert(0, StretchIdMapping.Length);
    }
    ProviderData.AllPersonalBestTimes.Remove(0, ProviderData.AllPersonalBestTimes.Length);
    OnlineS = class'GameEngine'.static.GetOnlineSubsystem();
    // End:0x1C5
    if(OnlineS != none)
    {
        Profile = TdProfileSettings(OnlineS.PlayerInterface.GetProfileSettings(byte(CurrentControllerId)));
        // End:0x1C5
        if(Profile != none)
        {
            Idx = 0;
            J0x154:
            // End:0x1C5 [Loop If]
            if(Idx < StretchIdMapping.Length)
            {
                // End:0x19F
                if(Profile.IsTTStretchUnlocked(Idx))
                {
                    ProviderData.AllPersonalBestTimes[Idx] = 3599.990;
                    // [Explicit Continue]
                    goto J0x1BB;
                }
                ProviderData.AllPersonalBestTimes[Idx] = -1.0;
                J0x1BB:
                ++ Idx;
                // [Loop Continue]
                goto J0x154;
            }
        }
    }
    ProviderData.AllPersonalBestTimes[ProviderData.AllPersonalBestTimes.Length] = -1.0;
    //return;    
}

