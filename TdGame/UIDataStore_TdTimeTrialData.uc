function bool ReadDataForStretch(bool bInReadOnline, delegate<OnTimeDataReadCompleted> OnReadCompleted)
{
    bOnlineMode = bInReadOnline;
    ReadRequests.Remove(0, ReadRequests.Length);
    ReadRequests.AddItem(RequestForMeAndFriendsForUI);
    ReadRequests.AddItem(RequestWorldsBestForUI);
    ReadRequests.AddItem(RequestPlayerTimeAllStretches);
    return StartReadDataForStretch(OnReadCompleted);
    //return ReturnValue;    
}

function bool ReadFullDataForStretch(bool bInReadOnline, delegate<OnTimeDataReadCompleted> OnReadCompleted)
{
    bOnlineMode = bInReadOnline;
    ReadRequests.Remove(0, ReadRequests.Length);
    ReadRequests.AddItem(RequestForMeAndFriends);
    ReadRequests.AddItem(RequestWorldsBest);
    ReadRequests.AddItem(RequestMyMonthly);
    ReadRequests.AddItem(RequestMyWeekly);
    ReadRequests.AddItem(RequestWorldsMonthly);
    ReadRequests.AddItem(RequestWorldsWeekly);
    ReadRequests.AddItem(RequestMonthlyGhostCutoff);
    ReadRequests.AddItem(RequestWeeklyGhostCutoff);
    // End:0xBC
    if(bReadLeaderboardEntry)
    {
        ReadRequests.AddItem(RequestLeaderboardEntry);
    }
    return StartReadDataForStretch(OnReadCompleted);
    //return ReturnValue;    
}

private final function bool StartReadDataForStretch(delegate<OnTimeDataReadCompleted> OnReadCompleted)
{
    OnlineSub.PlayerInterface.GetUniquePlayerId(byte(CurrentControllerId), PlayerId);
    __OnTimeDataReadCompleted__Delegate = OnReadCompleted;
    SetStartReadState();
    RefreshSubscribers();
    // End:0xD7
    if(bOnlineMode)
    {
        TTOnlineInput = new class'TdTTInput';
        TTOnlineInput.bIsOnlineInfo = true;
        OnlineSub.StatsInterface.ClearReadOnlineStatsCompleteDelegate(RunReadRequests);
        OnlineSub.StatsInterface.AddReadOnlineStatsCompleteDelegate(RunReadRequests);
        RunReadRequests(true);
        ReadOfflineDataForStretch();
        return true;
    }
    // End:0x1C3
    else
    {
        TTOnlineInput = none;
        // End:0x1C3
        if(ReadOfflineDataForStretch())
        {
            // End:0x1B6
            if(ProviderData.PlayerBest.Length > CurrentStretchId)
            {
                ProviderData.PlayerBest[CurrentStretchId].PlayerName = TTOfflineInput.PlayerBest.PlayerName;
                ProviderData.PlayerBest[CurrentStretchId].TotalTime = TTOfflineInput.PlayerBest.TotalTime;
                ProviderData.PlayerBest[CurrentStretchId].TotalRating = TTOfflineInput.PlayerBest.TotalRating;
            }
            FinishTimeDataRead(true);
            return true;
        }
    }
    NextReadRequestIndex = -1;
    __OnTimeDataReadCompleted__Delegate = None;
    return false;
    //return ReturnValue;    
}

function ReadOfflinePlayerBestForAllStretchs()
{
    local TdProfileSettings Profile;
    local float TempTime;
    local int Idx;

    Profile = TdProfileSettings(OnlineSub.PlayerInterface.GetProfileSettings(byte(CurrentControllerId)));
    // End:0xF4
    if(Profile != none)
    {
        Idx = 0;
        J0x43:
        // End:0xF4 [Loop If]
        if(Idx < StretchIdMapping.Length)
        {
            // End:0xCE
            if(Profile.IsTTStretchUnlocked(Idx))
            {
                // End:0xAF
                if(Profile.GetTotalTimeOnlyForStretch(Idx, TempTime))
                {
                    ProviderData.AllPersonalBestTimes[Idx] = TempTime;
                }
                // End:0xCB
                else
                {
                    ProviderData.AllPersonalBestTimes[Idx] = 3599.990;
                }
                // [Explicit Continue]
                goto J0xEA;
            }
            ProviderData.AllPersonalBestTimes[Idx] = -1.0;
            J0xEA:
            ++ Idx;
            // [Loop Continue]
            goto J0x43;
        }
    }
    //return;    
}

private final function bool ReadOfflineDataForStretch()
{
    local TdProfileSettings Profile;

    TTOfflineInput = new class'TdTTInput';
    Profile = TdProfileSettings(OnlineSub.PlayerInterface.GetProfileSettings(byte(CurrentControllerId)));
    // End:0x1AC
    if(Profile != none)
    {
        // End:0x1A9
        if(Profile.GetTTTimeForStretch(CurrentPlasmaStretchId, TTOfflineInput.PlayerBest.TotalTime, TTOfflineInput.PlayerBest.IntermediateTimes, TTOfflineInput.PlayerBest.AverageSpeed, TTOfflineInput.PlayerBest.DistanceRun))
        {
            TTOfflineInput.PlayerBest.TotalRating = Profile.GetTimeTrialRating();
            TTOfflineInput.PlayerBest.PlayerName = OnlineSub.PlayerInterface.GetPlayerNickname(byte(CurrentControllerId));
            // End:0x1A4
            if(TTOfflineInput.PlayerBest.TotalTime != 3599.990)
            {
                OnlineSub.PlayerInterface.GetUniquePlayerId(byte(CurrentControllerId), TTOfflineInput.PlayerBest.PlayerId);
            }
            return true;
            J0x1A9:
        }
        // End:0x1A9
        else
        {
        }
        J0x1AC:
    }
    // End:0x1AC
    else
    {
    }
    return false;
    //return ReturnValue;    
}

