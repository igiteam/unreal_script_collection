private final function PrepareReadRequest(TdOnlineStatsRead StatsRead, delegate<ReadResultParser> ResultParser, bool bIndefinite, bool bMonthly, bool bWeekly)
{
    CurrentStatsRead = StatsRead;
    __ReadResultParser__Delegate = ResultParser;
    OnlineSub.StatsInterface.FreeStats(CurrentStatsRead);
    StatsRead.SetStretchId(CurrentPlasmaStretchId);
    StatsRead.PeriodFlags.bIndefinite = bIndefinite;
    StatsRead.PeriodFlags.bMonthly = bMonthly;
    StatsRead.PeriodFlags.bWeekly = bWeekly;
    //return;    
}

private final function RunReadRequests(bool bSuccess)
{
    // End:0x11
    if(NextReadRequestIndex == -1)
    {
        return;
    }
    // End:0x88
    if(bSuccess)
    {
        // End:0x46
        if((NextReadRequestIndex != 0) && __ReadResultParser__Delegate != none)
        {
            ReadResultParser(CurrentStatsRead);
        }
        // End:0x88
        if(NextReadRequestIndex < ReadRequests.Length)
        {
            __ReadRequest__Delegate = ReadRequests[++ NextReadRequestIndex];
            // End:0x80
            if(ReadRequest())
            {
                return;
            }
            // End:0x88
            else
            {
                bSuccess = false;
            }
        }
    }
    FinishTimeDataRead(bSuccess);
    //return;    
}

function BreakStatsRead()
{
    NextReadRequestIndex = -1;
    __ReadRequest__Delegate = None;
    __ReadResultParser__Delegate = None;
    ReadRequests.Remove(0, ReadRequests.Length);
    OnlineSub.StatsInterface.ClearReadOnlineStatsCompleteDelegate(RunReadRequests);
    __OnTimeDataReadCompleted__Delegate = None;
    //return;    
}

function FinishTimeDataRead(bool bWasSuccessful)
{
    OnlineSub.StatsInterface.ClearReadOnlineStatsCompleteDelegate(RunReadRequests);
    // End:0x62
    if(bOnlineMode)
    {
        switch(CurrentRaceModeId)
        {
            // End:0x5F
            case 0:
                TTOnlineInput.TargetTime = TTOnlineInput.PlayerBest;
                // End:0x62
                break;
            // End:0xFFFF
            default:
            }
            TTOfflineInput.TargetTime = TTOfflineInput.PlayerBest;
            NextReadRequestIndex = -1;
            ReadRequests.Remove(0, ReadRequests.Length);
            OnTimeDataReadCompleted(bWasSuccessful);
            __OnTimeDataReadCompleted__Delegate = None;
            CurrentStatsRead = none;
            __ReadRequest__Delegate = None;
            __ReadResultParser__Delegate = None;
            // End:0xF9
            if(bWasSuccessful)
            {
                RefreshSubscribers();
            }
            bReadParamsSet = false;
            //return;            
}

