private final function ParseLeaderboardEntryData(TdOnlineStatsRead StatResult)
{
    local int Idx;

    TTOnlineInput.TargetTime.PlayerName = LeaderboardEntryPlayerName;
    TTOnlineInput.TargetTime.PlayerId = LeaderboardEntryNetId;
    TTOnlineInput.TargetTime.TotalTime = StatResult.GetFloatStat(TTOnlineInput.TargetTime.PlayerId, 20);
    TTOnlineInput.TargetTime.IntermediateTimes.Insert(0, 8);
    Idx = 0;
    J0xB0:
    // End:0x11E [Loop If]
    if(Idx < 8)
    {
        TTOnlineInput.TargetTime.IntermediateTimes[Idx] = StatResult.GetFloatStat(TTOnlineInput.TargetTime.PlayerId, 21 + Idx);
        ++ Idx;
        // [Loop Continue]
        goto J0xB0;
    }
    TTOnlineInput.TargetTime.TotalRating = StatResult.GetIntStatFromRow(0, 19);
    TTOnlineInput.TargetTime.AverageSpeed = StatResult.GetFloatStatFromRow(0, 43);
    TTOnlineInput.TargetTime.DistanceRun = float(StatResult.GetIntStatFromRow(0, 44));
    TTOnlineInput.TargetTime.GhostTag = StatResult.GetIntStat(TTOnlineInput.TargetTime.PlayerId, 41);
    TTOnlineInput.TargetTime.HasGhost = TTOnlineInput.TargetTime.GhostTag != 0;
    //return;    
}

private final function ParsePlayerTimeAllStretches(TdOnlineStatsRead StatResult)
{
    local int StretchId, Idx;
    local TdProfileSettings Profile;

    ProviderData.AllPersonalBestTimes.Remove(0, ProviderData.AllPersonalBestTimes.Length);
    ProviderData.AllPersonalBestTimes.Insert(0, StretchIdMapping.Length);
    // End:0x86
    foreach StatResult.ColumnIds(StretchId,)
    {
        ProviderData.AllPersonalBestTimes[StretchId] = StatResult.GetFloatStatFromRow(0, StretchId);        
    }    
    Profile = TdProfileSettings(OnlineSub.PlayerInterface.GetProfileSettings(byte(CurrentControllerId)));
    // End:0x11E
    if(Profile != none)
    {
        Idx = 0;
        J0xCA:
        // End:0x11E [Loop If]
        if(Idx < StretchIdMapping.Length)
        {
            // End:0x114
            if(!Profile.IsTTStretchUnlocked(Idx))
            {
                ProviderData.AllPersonalBestTimes[Idx] = -1.0;
            }
            ++ Idx;
            // [Loop Continue]
            goto J0xCA;
        }
    }
    //return;    
}

private final function ClearTimeData()
{
    // End:0x1F
    if(TTOfflineInput != none)
    {
        TTOfflineInput.ClearTimeData();
    }
    // End:0x3E
    if(TTOnlineInput != none)
    {
        TTOnlineInput.ClearTimeData();
    }
    //return;    
}

function TTData GetTargetRaceData()
{
    // End:0x1C
    if(bOnlineMode)
    {
        return TTOnlineInput.TargetTime;
    }
    // End:0x2C
    else
    {
        return TTOfflineInput.TargetTime;
    }
    //return ReturnValue;    
}

function TdTTResult GetTimeTrialResult()
{
    // End:0x14
    if(TTOnlineResult != none)
    {
        return TTOnlineResult;
    }
    // End:0x1A
    else
    {
        return TTOfflineResult;
    }
    //return ReturnValue;    
}

function int CalculateRating(float TotalTime)
{
    local string RatingTimeString;
    local int Result;

    Result = 0;
    GetStringValueFromProviderSet('TdTimeTrialStretches', 'Rating1Time', GetCurrentWorkingStretchProviderIndex(), RatingTimeString);
    // End:0xD2
    if(TotalTime < float(RatingTimeString))
    {
        Result = 1;
        GetStringValueFromProviderSet('TdTimeTrialStretches', 'Rating2Time', GetCurrentWorkingStretchProviderIndex(), RatingTimeString);
        // End:0xD2
        if(TotalTime < float(RatingTimeString))
        {
            Result = 2;
            GetStringValueFromProviderSet('TdTimeTrialStretches', 'Rating3Time', GetCurrentWorkingStretchProviderIndex(), RatingTimeString);
            // End:0xD2
            if(TotalTime < float(RatingTimeString))
            {
                Result = 3;
            }
        }
    }
    return Result;
    //return ReturnValue;    
}

delegate OnOpenGhostComplete(TdGhostStorageManager.EGhostStorageResult Result)
{
    //return;    
}

function OpenGhost(delegate<OnOpenGhostComplete> OpenComplete)
{
    local TTData RaceData;
    local TdGhostInfo GhostInfo;

    __OnOpenGhostComplete__Delegate = OpenComplete;
    RaceData = GetTargetRaceData();
    GhostInfo.StretchId = CurrentPlasmaStretchId;
    GhostInfo.GhostTag = RaceData.GhostTag;
    GhostInfo.TotalTime = RaceData.TotalTime;
    CurrentGhost = none;
    // End:0x117
    if(bOnlineMode)
    {
        GhostStorageManager = new class'TdOnlineGhostStorageManager';
        // End:0xED
        if(RaceData.HasGhost)
        {
            GhostInfo.PlayerName = RaceData.PlayerName;
            GhostStorageManager.ReadGhost(GhostInfo, OpenGhostComplete);
        }
        // End:0x114
        else
        {
            OnOpenGhostComplete(1);
            __OnOpenGhostComplete__Delegate = None;
            GhostStorageManager = none;
        }
    }
    // End:0x149
    else
    {
        GhostStorageManager = new class'TdOfflineGhostStorageManager';
        GhostStorageManager.ReadGhost(GhostInfo, OpenGhostComplete);
    }
    //return;    
}

function SaveGhost(int StretchId, string PlayerName, float TotalTime, bool bStoreOnline, TdGhostManager InGhostManager, delegate<OnSaveGhostComplete> SaveComplete)
{
    local TdGhost Ghost;

    __OnSaveGhostComplete__Delegate = SaveComplete;
    Ghost = new class'TdGhost';
    Ghost.Info.StretchId = StretchId;
    Ghost.Info.PlayerName = PlayerName;
    Ghost.Info.TotalTime = TotalTime;
    Ghost.RawBytes = InGhostManager.RecordData;
    // End:0xB6
    if(bStoreOnline)
    {
        GhostStorageManager = new class'TdOnlineGhostStorageManager';
    }
    // End:0xC6
    else
    {
        GhostStorageManager = new class'TdOfflineGhostStorageManager';
    }
    GhostStorageManager.WriteGhost(Ghost, PlayerId, SaveGhostComplete);
    //return;    
}

private final function SaveGhostComplete(TdGhostStorageManager.EGhostStorageResult Result, int GhostTag)
{
    OnSaveGhostComplete(Result, GhostTag);
    GhostStorageManager = none;
    __OnSaveGhostComplete__Delegate = None;
    //return;    
}

private final function OpenGhostComplete(TdGhostStorageManager.EGhostStorageResult Result, TdGhost Ghost)
{
    // End:0x1E
    if(Result == 0)
    {
        CurrentGhost = Ghost;
        J0x1E:
    }
    // End:0x1E
    else
    {
    }
    OnOpenGhostComplete(Result);
    GhostStorageManager = none;
    __OnOpenGhostComplete__Delegate = None;
    //return;    
}

