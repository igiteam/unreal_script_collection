private final function bool RequestPlayerTimeAllStretches()
{
    local array<UniqueNetId> Players;

    // End:0x34
    if(ProviderData.AllPersonalBestTimes.Length == StretchIdMapping.Length)
    {
        __ReadResultParser__Delegate = None;
        RunReadRequests(true);
        return true;
    }
    // End:0xE7
    if(bOnlineMode)
    {
        Players[0] = PlayerId;
        AllStretchesStatsRead.SetStatId(20, 5);
        CurrentStatsRead = AllStretchesStatsRead;
        __ReadResultParser__Delegate = ParsePlayerTimeAllStretches;
        OnlineSub.StatsInterface.FreeStats(CurrentStatsRead);
        CurrentStatsRead.PeriodFlags.bIndefinite = true;
        return OnlineSub.StatsInterface.ReadOnlineStats(Players, CurrentStatsRead);
    }
    return false;
    //return ReturnValue;    
}

private final function ParseMeAndFriendsDataForUI(TdOnlineStatsRead StatResult)
{
    ProviderData.PlayerBest[CurrentPlasmaStretchId].bFilledIn = true;
    ProviderData.PlayerBest[CurrentPlasmaStretchId].PlayerName = OnlineSub.PlayerInterface.GetPlayerNickname(byte(CurrentControllerId));
    ProviderData.PlayerBest[CurrentPlasmaStretchId].TotalTime = StatResult.GetFloatStat(PlayerId, 20);
    ProviderData.PlayerBest[CurrentPlasmaStretchId].TotalRating = StatResult.GetIntStat(PlayerId, 19);
    ProviderData.FriendsBest[CurrentPlasmaStretchId].bFilledIn = true;
    ProviderData.FriendsBest[CurrentPlasmaStretchId].PlayerName = StatResult.Rows[0].NickName;
    ProviderData.FriendsBest[CurrentPlasmaStretchId].TotalTime = StatResult.GetFloatStatFromRow(0, 20);
    ProviderData.FriendsBest[CurrentPlasmaStretchId].TotalRating = StatResult.GetIntStatFromRow(0, 19);
    //return;    
}

private final function ParseWorldsBestDataForUI(TdOnlineStatsRead StatResult)
{
    ProviderData.WorldsBest[CurrentPlasmaStretchId].bFilledIn = true;
    // End:0x88
    if(StatResult.Rows.Length == 0)
    {
        ProviderData.WorldsBest[CurrentPlasmaStretchId].PlayerName = "";
        ProviderData.WorldsBest[CurrentPlasmaStretchId].TotalTime = 3599.990;
    }
    // End:0xFF
    else
    {
        ProviderData.WorldsBest[CurrentPlasmaStretchId].PlayerName = StatResult.Rows[0].NickName;
        ProviderData.WorldsBest[CurrentPlasmaStretchId].TotalTime = StatResult.GetFloatStatFromRow(0, 20);
    }
    //return;    
}

private final function ParseMeAndFriendsData(TdOnlineStatsRead StatResult)
{
    local int Idx;

    TTOnlineInput.FriendsBest.TotalTime = StatResult.GetFloatStatFromRow(0, 20);
    TTOnlineInput.FriendsBest.IntermediateTimes.Insert(0, 8);
    Idx = 0;
    J0x57:
    // End:0xAC [Loop If]
    if(Idx < 8)
    {
        TTOnlineInput.FriendsBest.IntermediateTimes[Idx] = StatResult.GetFloatStatFromRow(0, 21 + Idx);
        ++ Idx;
        // [Loop Continue]
        goto J0x57;
    }
    TTOnlineInput.FriendsBest.GhostTag = StatResult.GetIntStatFromRow(0, 41);
    TTOnlineInput.FriendsBest.HasGhost = TTOnlineInput.FriendsBest.GhostTag != 0;
    TTOnlineInput.FriendsBest.TotalRating = StatResult.GetIntStatFromRow(0, 19);
    TTOnlineInput.FriendsBest.AverageSpeed = StatResult.GetFloatStatFromRow(0, 43);
    TTOnlineInput.FriendsBest.DistanceRun = float(StatResult.GetIntStatFromRow(0, 44));
    TTOnlineInput.FriendsBest.PlayerName = StatResult.Rows[0].NickName;
    TTOnlineInput.FriendsBest.PlayerId = StatResult.Rows[0].PlayerId;
    TTOnlineInput.PlayerBest.TotalTime = StatResult.GetFloatStat(PlayerId, 20);
    TTOnlineInput.PlayerBest.IntermediateTimes.Insert(0, 8);
    Idx = 0;
    J0x278:
    // End:0x2D1 [Loop If]
    if(Idx < 8)
    {
        TTOnlineInput.PlayerBest.IntermediateTimes[Idx] = StatResult.GetFloatStat(PlayerId, 21 + Idx);
        ++ Idx;
        // [Loop Continue]
        goto J0x278;
    }
    TTOnlineInput.PlayerBest.GhostTag = StatResult.GetIntStat(PlayerId, 41);
    TTOnlineInput.PlayerBest.HasGhost = TTOnlineInput.PlayerBest.GhostTag != 0;
    TTOnlineInput.PlayerBest.TotalRating = StatResult.GetIntStat(PlayerId, 19);
    TTOnlineInput.PlayerBest.AverageSpeed = StatResult.GetFloatStat(PlayerId, 43);
    TTOnlineInput.PlayerBest.DistanceRun = float(StatResult.GetIntStat(PlayerId, 44));
    TTOnlineInput.PlayerBest.PlayerName = OnlineSub.PlayerInterface.GetPlayerNickname(byte(CurrentControllerId));
    // End:0x489
    if(TTOnlineInput.PlayerBest.TotalTime != 3599.990)
    {
        OnlineSub.PlayerInterface.GetUniquePlayerId(byte(CurrentControllerId), TTOnlineInput.PlayerBest.PlayerId);
    }
    //return;    
}

private final function ParseWorldsBestData(TdOnlineStatsRead StatResult)
{
    local int Idx;

    // End:0x150
    if(StatResult.Rows.Length == 0)
    {
        TTOnlineInput.WorldsBest.TotalTime = 3599.990;
        TTOnlineInput.WorldsBest.IntermediateTimes.Insert(0, 8);
        Idx = 0;
        J0x5B:
        // End:0x97 [Loop If]
        if(Idx < 8)
        {
            TTOnlineInput.WorldsBest.IntermediateTimes[Idx] = 0.0;
            ++ Idx;
            // [Loop Continue]
            goto J0x5B;
        }
        TTOnlineInput.WorldsBest.HasGhost = false;
        TTOnlineInput.WorldsBest.GhostTag = -1;
        TTOnlineInput.WorldsBest.TotalRating = 0;
        TTOnlineInput.WorldsBest.AverageSpeed = 0.0;
        TTOnlineInput.WorldsBest.DistanceRun = 0.0;
        TTOnlineInput.WorldsBest.PlayerName = "";
    }
    // End:0x36D
    else
    {
        TTOnlineInput.WorldsBest.TotalTime = StatResult.GetFloatStatFromRow(0, 20);
        TTOnlineInput.WorldsBest.IntermediateTimes.Insert(0, 8);
        Idx = 0;
        J0x1A7:
        // End:0x1FC [Loop If]
        if(Idx < 8)
        {
            TTOnlineInput.WorldsBest.IntermediateTimes[Idx] = StatResult.GetFloatStatFromRow(0, 21 + Idx);
            ++ Idx;
            // [Loop Continue]
            goto J0x1A7;
        }
        TTOnlineInput.WorldsBest.GhostTag = StatResult.GetIntStatFromRow(0, 41);
        TTOnlineInput.WorldsBest.HasGhost = TTOnlineInput.WorldsBest.GhostTag != 0;
        TTOnlineInput.WorldsBest.TotalRating = StatResult.GetIntStatFromRow(0, 19);
        TTOnlineInput.WorldsBest.AverageSpeed = StatResult.GetFloatStatFromRow(0, 43);
        TTOnlineInput.WorldsBest.DistanceRun = float(StatResult.GetIntStatFromRow(0, 44));
        TTOnlineInput.WorldsBest.PlayerName = StatResult.Rows[0].NickName;
        TTOnlineInput.WorldsBest.PlayerId = StatResult.Rows[0].PlayerId;
    }
    //return;    
}

