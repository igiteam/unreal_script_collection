class TdMove_BotTurnStandingCeleste extends TdMove_BotTurnStanding
    config(PawnMovement);

function float GetBlendOutTime()
{
    // End:0x53
    if(BotOwner.myController.IsInState('Taser', true) || BotOwner.myController.IsInState('Immobile', true))
    {
        return 0.50;
    }
    // End:0x59
    else
    {
        return 0.0;
    }
    //return ReturnValue;    
}

function float GetBlendInTime()
{
    // End:0x53
    if(BotOwner.myController.IsInState('Taser', true) || BotOwner.myController.IsInState('Immobile', true))
    {
        return 0.30;
    }
    // End:0x59
    else
    {
        return 0.050;
    }
    //return ReturnValue;    
}
