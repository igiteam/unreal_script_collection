    if((((VarName == 'Team') || VarName == 'UniqueId') || VarName == 'RoleIndexInTeam') || VarName == 'bPlayerIsReady')
    {
        UpdateLobbyBackend();
    }
    super.ReplicatedEvent(VarName);
    //return;    
}

