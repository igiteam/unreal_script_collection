            TrailRightFootPSC = new (Outer) class'TdParticleSystemComponent';
            TrailRightFootPSC.SetTemplate(TrailParticleSystem_Normal);
        }
        Mesh3p.AttachComponentToSocket(TrailRightFootPSC, TrailRightFootSocket);
        TrailRightFootPSC.ActivateSystem();
        // End:0x21A
        if(TrailLeftFootPSC == none)
        {
            TrailLeftFootPSC = new (Outer) class'TdParticleSystemComponent';
            TrailLeftFootPSC.SetTemplate(TrailParticleSystem_Normal);
        }
        Mesh3p.AttachComponentToSocket(TrailLeftFootPSC, TrailLeftFootSocket);
        TrailLeftFootPSC.ActivateSystem();
    }
    // End:0x30E
    if(TrailParticleSystem_Wide != none)
    {
        // End:0x284
        if(TrailSpinePSC == none)
        {
            TrailSpinePSC = new (Outer) class'TdParticleSystemComponent';
