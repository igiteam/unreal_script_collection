}

simulated function Tick(float DeltaTime)
{
    local Color VertexColor;

    RotateSmooth(DeltaTime);
    VertexColor = MakeColor(255, 255, 255, byte(float(255) * FMin((1.50 * VelocityMagnitude) / GroundSpeed, 1.0)));
    TrailHeadPSC.SetColorParameter('GhostColor', VertexColor);
    TrailNeckPSC.SetColorParameter('GhostColor', VertexColor);
    TrailSpinePSC.SetColorParameter('GhostColor', VertexColor);
    TrailSpine2PSC.SetColorParameter('GhostColor', VertexColor);
    TrailRightHandPSC.SetColorParameter('GhostColor', VertexColor);
    TrailLeftHandPSC.SetColorParameter('GhostColor', VertexColor);
    TrailRightFootPSC.SetColorParameter('GhostColor', VertexColor);
    TrailLeftFootPSC.SetColorParameter('GhostColor', VertexColor);
    // End:0x1DA
    if(AmbientSound == none)
    {
        AmbientSound = self.CreateAudioComponent(AmbientSoundSC, false, true);
        // End:0x1DA
        if(AmbientSound != none)
        {
            AttachComponent(AmbientSound);
            AmbientSound.bShouldRemainActiveIfDropped = true;
            AmbientSound.bUseOwnerLocation = true;
            AmbientSound.bAllowSpatialization = true;
            AmbientSound.bAutoDestroy = true;
            AmbientSound.bStopWhenOwnerDestroyed = true;
            AmbientSound.Play();
        }
    }
    super.Tick(DeltaTime);
    //return;    
}

simulated function RotateSmooth(float DeltaTime)
{
    local int Diff;
    local Rotator NewRotation;

    // End:0x30
    if(Rotation.Yaw != SmoothYaw)
    {
        TargetYaw = Rotation.Yaw;
    }
    NewRotation = Rotation;
    Diff = NormalizeRotAxis(TargetYaw - SmoothYaw);
    SmoothYaw = NormalizeRotAxis(SmoothYaw + int(float(Diff) * FMin(1.0, DeltaTime / 0.070)));
    NewRotation.Yaw = SmoothYaw;
    SetRotation(NewRotation);
    //return;    
}

simulated event PostBeginPlay()
{
    local UIDataStore_TdGameData GameData;
    local DataStoreClient DSC;

    super.PostBeginPlay();
    ActivateGhostEffects();
    SmoothYaw = Rotation.Yaw;
    TargetYaw = Rotation.Yaw;
    DSC = class'UIInteraction'.static.GetDataStoreClient();
    // End:0xA7
    if(DSC != none)
    {
        GameData = UIDataStore_TdGameData(DSC.FindDataStore('TdGameData'));
        // End:0xA7
        if(GameData != none)
        {
            SetShowGhost(GameData.bViewGhost);
        }
    }
    //return;    
}

simulated function SetShowGhost(bool bShow)
{
    SetHidden(!bShow);
    TrailHeadPSC.SetHidden(!bShow);
    TrailNeckPSC.SetHidden(!bShow);
    TrailSpinePSC.SetHidden(!bShow);
    TrailSpine2PSC.SetHidden(!bShow);
    TrailRightHandPSC.SetHidden(!bShow);
    TrailLeftHandPSC.SetHidden(!bShow);
    TrailRightFootPSC.SetHidden(!bShow);
    TrailLeftFootPSC.SetHidden(!bShow);
    // End:0x100
    if(bShow)
    {
        AmbientSoundSC = soundcue'Ghost_Proxy';
        // End:0xFD
        if(AmbientSound != none)
        {
            AmbientSound.Play();
        }
    }
    // End:0x122
    else
    {
        AmbientSoundSC = none;
        // End:0x122
        if(AmbientSound != none)
        {
            AmbientSound.Stop();
        }
    }
    //return;    
}

simulated function ActuallyPlayFootParticleEffect(int FootDown, TraceHitInfo HitInfo, optional Vector HitLoc, optional Vector HitNormal)
{
    local Vector Upward, HitBinormal, HitTangent, PawnRotVector;
    local float UsedRotation;

    // End:0x0D
    if(bHidden)
    {
        return;
    }
    // End:0x1BA
    if(FootDecalMaterial != none)
    {
        PawnRotVector = vector(Rotation);
        PawnRotVector.Z -= 0.50;
        PawnRotVector = Normal(PawnRotVector);
        HitBinormal = Normal(PawnRotVector Cross HitNormal);
        HitTangent = HitNormal Cross HitBinormal;
        Upward = vect(0.0, 0.0, 1.0);
        // End:0xB9
        if(Abs(HitNormal Dot Upward) < 0.99990)
        {
            Upward = Normal(Upward - ProjectOnTo(Upward, HitNormal));
        }
        // End:0xE6
        else
        {
            // End:0xE6
            if(HitNormal.Z > 0.0)
            {
                Upward = vect(1.0, 0.0, 0.0);
            }
        }
        UsedRotation = (57.295780 * Acos(Upward Dot HitTangent)) + float(90);
        // End:0x131
        if((HitBinormal Dot Upward) > float(0))
        {
            UsedRotation = 360.0 - UsedRotation;
        }
        WorldInfo.MyDecalManager.SpawnDecal(FootDecalMaterial, HitLoc, rotator(-HitNormal), 64.0, 32.0, 32.0, true, UsedRotation, HitInfo.HitComponent, false, false, HitInfo.BoneName, HitInfo.Item, HitInfo.LevelIndex);
    }
    //return;    
}

simulated event Destroyed()
{
    // End:0x1B
    if(TrailHeadPSC != none)
    {
        TrailHeadPSC.KillParticlesForced();
    }
    // End:0x36
    if(TrailNeckPSC != none)
    {
        TrailNeckPSC.KillParticlesForced();
    }
    // End:0x51
    if(TrailSpinePSC != none)
