simulated function ActivateGhostEffects()
{
    // End:0x245
    if(TrailParticleSystem_Normal != none)
    {
        // End:0x3F
        if(TrailHeadPSC == none)
        {
            TrailHeadPSC = new (Outer) class'TdParticleSystemComponent';
