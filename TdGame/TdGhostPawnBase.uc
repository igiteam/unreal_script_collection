    }
    // End:0x87
    if(TrailRightHandPSC != none)
    {
        TrailRightHandPSC.KillParticlesForced();
    }
    // End:0xA2
    if(TrailLeftHandPSC != none)
    {
        TrailLeftHandPSC.KillParticlesForced();
    }
    // End:0xBD
    if(TrailRightFootPSC != none)
    {
        TrailRightFootPSC.KillParticlesForced();
    }
    // End:0xD8
    if(TrailLeftFootPSC != none)
    {
        TrailLeftFootPSC.KillParticlesForced();
    }
    super(Pawn).Destroyed();
    //return;    
}

