class SeqAct_TdActivateRopeburnDisarm extends SequenceAction
    hidecategories(Object);

event Activated()
{
    local int Index;
    local TdPlayerPawn PlayerPawn;
    local array<Object> ObjectVariables;

    GetObjectVars(ObjectVariables, "PlayerPawn");
    Index = 0;
    J0x1E:
    // End:0x4E [Loop If]
    if(Index < ObjectVariables.Length)
    {
        PlayerPawn = TdPlayerPawn(ObjectVariables[Index]);
        ++ Index;
        // [Loop Continue]
        goto J0x1E;
    }
    // End:0x5B
    if(PlayerPawn == none)
    {
        return;
    }
    // End:0x96
    if(InputLinks[0].bHasImpulse)
    {
        PlayerPawn.Controller.GotoState('Ropeburn');
    }
    // End:0xCE
    else
    {
        // End:0xCE
        if(InputLinks[1].bHasImpulse)
        {
            PlayerPawn.Controller.GotoState('PlayerWalking');
        }
    }
    //return;    
}

