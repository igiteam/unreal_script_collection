class TdMove_StepUp extends TdPhysicsMove
    config(PawnMovement);

enum EStepUpType
{
    ESUT_Low,
    ESUT_Medium,
    ESUT_High,
    ESUT_Long,
    ESUT_MAX
};

var(StepUp) config float StepUpDistanceLimit;
var(StepUp) config float StepUpSpeedLimit;
var(StepUp) config float StepUpLowMinHeight;
var(StepUp) config float StepUpMediumMinHeight;
var(StepUp) config float StepUpHighMinHeight;
var(StepUp) config float StepUpHighMaxHeight;
var(StepUp) config float StepUpOptimalLowHeight;
var(StepUp) config float StepUpOptimalMediumHeight;
var(StepUp) config float StepUpOptimalHighHeight;
var Vector EndPosition;
var TdMove_StepUp.EStepUpType StepUpType;
var float StartDistance;
var Vector SavedVelocity;

function bool CanDoMove()
{
    local float HandplantHeight, DistanceToLedge, TimeToLedge, EndPositionOffset;
    local Vector TraceStart, TraceEnd, ToLedge2D, CollisionExtent;

    // End:0x24
    if(!super(TdMove).CanDoMove() || !PawnOwner.bFoundLedge)
    {
        return false;
    }
    // End:0x6F
    if(PawnOwner.bFoundLedgeExcludesFootMoves || (PawnOwner.MovementActor != none) && PawnOwner.MovementActor.bExludeFootMoves)
    {
        return false;
    }
    // End:0xA5
    if((PawnOwner.MovementExclusionVolume != none) && PawnOwner.MovementExclusionVolume.bExcludeFootMoves)
    {
        return false;
    }
    ToLedge2D = PawnOwner.MoveLedgeLocation - PawnOwner.Location;
    ToLedge2D.Z = 0.0;
    DistanceToLedge = VSize2D(ToLedge2D);
    TimeToLedge = DistanceToLedge / float(Max(150, int(VSize2D(PawnOwner.Velocity))));
    // End:0x12D
    if(TimeToLedge > 0.450)
    {
        return false;
    }
    // End:0x153
    if(PawnOwner.MoveLedgeNormal.Z < 0.710)
    {
        return false;
    }
    HandplantHeight = (PawnOwner.MoveLedgeLocation.Z - PawnOwner.Location.Z) + PawnOwner.CylinderComponent.CollisionHeight;
    // End:0x1CC
    if((HandplantHeight > StepUpHighMaxHeight) || HandplantHeight < StepUpLowMinHeight)
    {
        return false;
    }
    StartDistance = FMin(120.0, VSize2D(PawnOwner.MoveLedgeLocation - PawnOwner.Location));
    EndPositionOffset = 80.0;
    StepUpType = 3;
    // End:0x241
    if((PawnOwner.GetWeaponType() == 1) && StepUpType >= 2)
    {
        return false;
    }
    // End:0x264
    if((StepUpType <= 1) && TimeToLedge > 0.30)
    {
        return false;
    }
    SavedVelocity = PawnOwner.Velocity;
    EndPosition = PawnOwner.MoveLedgeLocation;
    EndPosition += (vector(PawnOwner.Rotation) * EndPositionOffset);
    EndPosition.Z += (PawnOwner.CylinderComponent.CollisionHeight + 2.0);
    CollisionExtent = PawnOwner.GetCollisionExtent();
    CollisionExtent.Z = 64.0 - 2.0;
    TraceEnd = EndPosition;
    TraceEnd.Z = (PawnOwner.MoveLedgeLocation.Z + CollisionExtent.Z) + 2.0;
    TraceStart = PawnOwner.Location;
    TraceStart.Z = TraceEnd.Z;
    // End:0x3B1
    if(MovementTraceForBlocking(TraceEnd, TraceStart, CollisionExtent))
    {
        return false;
    }
    // End:0x3CB
    if(MovementTraceForBlocking(EndPosition, TraceEnd, CollisionExtent))
    {
        return false;
    }
    return true;
    //return ReturnValue;    
}

simulated function StartMove()
{
    local Vector TargetLocation, ToLegde2D;

    super.StartMove();
    ToLegde2D = PawnOwner.MoveLedgeLocation - PawnOwner.Location;
    ToLegde2D.Z = 0.0;
    TargetLocation = PawnOwner.MoveLedgeLocation - (Normal(ToLegde2D) * StartDistance);
    TargetLocation.Z = PawnOwner.Location.Z;
    // End:0xEB
    if(StepUpType == 3)
    {
        PlayMoveAnim(2, name("vaultonto"), 1.0, 0.150, 0.250, false);
        SetPreciseLocation(EndPosition, 2, float(Max(200, int(VSize2D(SavedVelocity)))));
    }
    // End:0x10B
    else
    {
        SetPreciseLocation(TargetLocation, 1, float(Max(200, int(VSize2D(SavedVelocity)))));
    }
    //return;    
}

simulated event ReachedPreciseLocation()
{
    // End:0x2A
    if(StepUpType == 3)
    {
        PawnOwner.SetMove(1);
        return;
    }
    PawnOwner.UseRootMotion(true);
    PawnOwner.Velocity = vect(0.0, 0.0, 0.0);
    // End:0x126
    if(StepUpType == 0)
    {
        RootMotionScale.Z = (EndPosition.Z - PawnOwner.Location.Z) / StepUpOptimalLowHeight;
        // End:0xF6
        if(PawnOwner.IsLeftLegForward())
        {
            PlayMoveAnim(2, name("stepupleftleg48"), 1.0, 0.150, 0.10, true);
        }
        // End:0x123
        else
        {
            PlayMoveAnim(2, name("stepuprightleg48"), 1.0, 0.150, 0.10, true);
        }
    }
    // End:0x275
    else
    {
        // End:0x1F0
        if(StepUpType == 1)
        {
            RootMotionScale.Z = (EndPosition.Z - PawnOwner.Location.Z) / StepUpOptimalMediumHeight;
            // End:0x1C0
            if(PawnOwner.IsLeftLegForward())
            {
                PlayMoveAnim(2, name("stepupleftleg88"), 1.20, 0.150, 0.10, true);
            }
            // End:0x1ED
            else
            {
                PlayMoveAnim(2, name("stepuprightleg88"), 1.20, 0.150, 0.10, true);
            }
        }
        // End:0x275
        else
        {
            // End:0x275
            if(StepUpType == 2)
            {
                RootMotionScale.Z = (EndPosition.Z - PawnOwner.Location.Z) / StepUpOptimalHighHeight;
                ResetCameraLook(0.150);
                PlayMoveAnim(2, name("stepup144"), 1.0, 0.150, 0.10, true);
            }
        }
    }
    //return;    
}

simulated function OnCeaseRelevantRootMotion(AnimNodeSequence SeqNode)
{
    PawnOwner.UseRootMotion(false);
    PawnOwner.SetMove(1);
    //return;    
}

simulated function StopMove()
{
    super.StopMove();
    // End:0x45
    if(StepUpType == 3)
    {
        PawnOwner.Velocity = SavedVelocity;
        PawnOwner.Acceleration = Normal(SavedVelocity);
    }
    // End:0x62
    else
    {
        PawnOwner.Velocity = vect(0.0, 0.0, 0.0);
    }
    PawnOwner.FaceRotationTimeLeft = 0.30;
    TdPlayerController(PawnOwner.Controller).AccelerationTime = 0.20;
    //return;    
}

defaultproperties
{
    StepUpDistanceLimit=60.0
    StepUpSpeedLimit=300.0
    StepUpLowMinHeight=33.0
    StepUpMediumMinHeight=68.0
    StepUpHighMinHeight=112.0
    StepUpHighMaxHeight=148.0
    StepUpOptimalLowHeight=48.0
    StepUpOptimalMediumHeight=88.0
    StepUpOptimalHighHeight=144.0
    PawnPhysics=PHYS_Flying
    bDisableCollision=true
    bConstrainLook=true
    bDisableFaceRotation=true
    bAvoidLedges=false
    DisableMovementTime=-1.0
    MinLookConstraint=(Pitch=-3000,Yaw=-8000,Roll=-32768)
    MaxLookConstraint=(Pitch=6000,Yaw=8000,Roll=32768)
}