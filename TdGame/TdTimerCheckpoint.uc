{
    local int Idx;

    Idx = 0;
    J0x07:
    // End:0x5E [Loop If]
    if(Idx < BelongToTracks.Length)
    {
        // End:0x54
        if(BelongToTracks[Idx].TrackIndex == TrackIndex)
        {
            BelongToTracks[Idx].bLastCheckpoint = true;
            return;
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

function bool IsLastcheckpointInTrack(int Track)
{
    local int Idx;

    Idx = 0;
    J0x07:
    // End:0x5B [Loop If]
    if(Idx < BelongToTracks.Length)
    {
        // End:0x51
        if(BelongToTracks[Idx].TrackIndex == Track)
        {
            return BelongToTracks[Idx].bLastCheckpoint;
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    return false;
    //return ReturnValue;    
}

function bool HasIntermediateTimeInTrack(int Track)
{
    local int Idx;

    Idx = 0;
    J0x07:
    // End:0x5D [Loop If]
    if(Idx < BelongToTracks.Length)
    {
        // End:0x53
        if(BelongToTracks[Idx].TrackIndex == Track)
        {
            return !BelongToTracks[Idx].bNoIntermediateTime;
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    return false;
    //return ReturnValue;    
}

function SetDirectionHint(Rotator NextCheckpointHint)
{
    SetRotation(rot(0, 0, 0));
    EffectPSComponent.SetRotation(NextCheckpointHint);
    //return;    
}

function Show(bool bShow, optional int Track, optional bool bNoFade)
{
    local bool bIsLastCheckpoint;

    EffectPSComponent.SetHidden(!bShow);
    EffectPSComponent.KillParticlesForced();
    bIsLastCheckpoint = IsLastcheckpointInTrack(Track);
    // End:0x57
    if(bIsLastCheckpoint)
    {
        CurrentMesh = CheckpointFinishlineMesh;
    }
    // End:0x82
    else
    {
        // End:0x77
        if(HasIntermediateTimeInTrack(Track))
        {
            CurrentMesh = CheckpointTimeMesh;
        }
        // End:0x82
        else
        {
            CurrentMesh = CheckpointMesh;
        }
    }
    CheckpointFinishlineMesh.SetHidden(true);
    CheckpointTimeMesh.SetHidden(true);
    CheckpointMesh.SetHidden(true);
    // End:0x121
    if(((CheckpointMaterials[0] == none) || CurrentMesh.Materials.Length <= 0) || CheckpointMaterials[0].GetMaterial() != CurrentMesh.Materials[0])
    {
        CheckpointMaterials[0] = CurrentMesh.CreateAndSetMaterialInstanceConstant(0);
    }
    // End:0x18D
    if(((CheckpointMaterials[1] == none) || CurrentMesh.Materials.Length <= 1) || CheckpointMaterials[1].GetMaterial() != CurrentMesh.Materials[1])
    {
        CheckpointMaterials[1] = CurrentMesh.CreateAndSetMaterialInstanceConstant(1);
    }
    // End:0x289
    if(bShow)
    {
        SetUpCheckpoint(bIsLastCheckpoint);
        FadeTarget = 1.0;
        // End:0x215
        if(!bNoFade)
        {
            CheckpointMaterials[0].SetScalarParameterValue('FadeParam', 0.0);
            CheckpointMaterials[1].SetScalarParameterValue('FadeParam', 0.0);
            GotoState('Fading');
        }
        // End:0x25D
        else
        {
            CheckpointMaterials[0].SetScalarParameterValue('FadeParam', 1.0);
            CheckpointMaterials[1].SetScalarParameterValue('FadeParam', 1.0);
        }
        EffectPSComponent.ActivateSystem();
        CurrentMesh.SetHidden(!bShow);
    }
    // End:0x350
    else
    {
        FadeTarget = 0.0;
        EffectPSComponent.DeactivateSystem();
        // End:0x308
        if(!bNoFade)
        {
            CheckpointMaterials[0].SetScalarParameterValue('FadeParam', 1.0);
            CheckpointMaterials[1].SetScalarParameterValue('FadeParam', 1.0);
            GotoState('Fading');
        }
        // End:0x350
        else
        {
            CheckpointMaterials[0].SetScalarParameterValue('FadeParam', 0.0);
            CheckpointMaterials[1].SetScalarParameterValue('FadeParam', 0.0);
        }
    }
    //return;    
}

state Fading
{
    function Tick(float DeltaTime)
    {
        local float Dir;

        Dir = ((FadeTarget > FadeParam) ? 1.0 : -1.0);
        FadeParam += ((Dir * DeltaTime) / FadeTime);
        // End:0xB6
        if(((Dir > 0.0) && FadeParam >= FadeTarget) || (Dir < 0.0) && FadeParam <= FadeTarget)
        {
            FadeParam = FadeTarget;
            GotoState('None');
            // End:0xB6
            if(FadeTarget <= 0.0)
            {
                CurrentMesh.SetHidden(true);
            }
        }
        CheckpointMaterials[0].SetScalarParameterValue('FadeParam', FadeParam);
        CheckpointMaterials[1].SetScalarParameterValue('FadeParam', FadeParam);
        //return;        
    }
    stop;    
}

