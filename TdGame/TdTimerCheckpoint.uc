    if(Idx < BelongToTracks.Length)
    {
        // End:0x50
        if(BelongToTracks[Idx].TrackIndex == TrackIndex)
        {
            return BelongToTracks[Idx].OrderIndex;
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    return -1;
    //return ReturnValue;    
}

