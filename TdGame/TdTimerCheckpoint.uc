class TdTimerCheckpoint extends TdPlaceableCheckpoint
    config(Game)
    hidecategories(Navigation,Lighting,LightColor,Force);

struct CheckPointTrackIndex
{
    var() TdSPTimeTrialGame.ETTStretch TrackIndex;
    var() int OrderIndex;
    var() bool bNoIntermediateTime;
    var bool bLastCheckpoint;

    structdefaultproperties
    {
        TrackIndex=ETTS_None
        OrderIndex=0
        bNoIntermediateTime=false
        bLastCheckpoint=false
    }
};

var(CheckpointSettings) array<CheckPointTrackIndex> BelongToTracks;
var(CheckpointSettings) float CustomHeight;
var(CheckpointSettings) float CustomWidthScale;
var(CheckpointSettings) bool bNoRespawn;
var transient float InitialHeight;
var transient float InitialRadius;
var export editinline ParticleSystemComponent EffectPSComponent;
var ParticleSystem ArrowEffect;
var transient MaterialInstanceConstant CheckpointMaterials[2];
var transient float FadeParam;
var transient float FadeTarget;
var config float FadeTime;
var const export editinline StaticMeshComponent CheckpointTimeMesh;
var const export editinline StaticMeshComponent CheckpointFinishlineMesh;
var export editinline transient StaticMeshComponent CurrentMesh;

private final function AlignToGround(bool bIsLastCheckpoint)
{
    local Vector TraceStart, TraceEnd, HitLocation, HitNormal, NewTranslation, NewArrowTranslation;

    local Actor HitActor;

    TraceStart = Location;
    TraceEnd = TraceStart;
    TraceEnd.Z -= 1000.0;
    HitActor = Trace(HitLocation, HitNormal, TraceEnd, TraceStart, false,,, 8 & 1);
    NewTranslation = vect(0.0, 0.0, 0.0);
    // End:0xA6
    if(HitActor != none)
    {
        NewTranslation.Z = HitLocation.Z - Location.Z;
    }
    // End:0xC8
    else
    {
        NewTranslation.Z = -CylinderComponent.CollisionHeight;
    }
    CurrentMesh.SetTranslation(NewTranslation);
    NewArrowTranslation = CurrentMesh.Translation;
    NewArrowTranslation.Z += ((bIsLastCheckpoint) ? 150.0 : 200.0);
    EffectPSComponent.SetTranslation(NewArrowTranslation);
    //return;    
}

function ScaleHeight()
{
    local Vector TraceStart, TraceEnd, HitLocation, HitNormal, NewCheckpointScale, NewCylinderTranslation;

    local float AllowedHeight, AllowedRadius;
    local Actor HitActor;

    // End:0x41
    if(InitialHeight < 0.0)
    {
        InitialHeight = CurrentMesh.Bounds.BoxExtent.Z * 2.0;
    }
    // End:0x7B
    if(InitialRadius < 0.0)
    {
        InitialRadius = CurrentMesh.Bounds.BoxExtent.X;
    }
    NewCheckpointScale = vect(1.0, 1.0, 1.0);
    AllowedHeight = InitialHeight;
    // End:0xB6
    if(CustomHeight > 0.0)
    {
        AllowedHeight = CustomHeight;
    }
    // End:0x161
    else
    {
        TraceStart = Location;
        TraceEnd = TraceStart;
        TraceEnd.Z += InitialHeight;
        HitActor = WorldInfo.Trace(HitLocation, HitNormal, TraceEnd, TraceStart, false,,, 8 & 1);
        // End:0x161
        if(HitActor != none)
        {
            AllowedHeight = HitLocation.Z - (Location.Z + CurrentMesh.Translation.Z);
        }
    }
    AllowedRadius = InitialRadius;
    // End:0x1B9
    if(CustomWidthScale > 0.0)
    {
        AllowedRadius = InitialRadius * CustomWidthScale;
        NewCheckpointScale.X = CustomWidthScale;
        NewCheckpointScale.Y = CustomWidthScale;
    }
    NewCheckpointScale.Z = AllowedHeight / InitialHeight;
    CurrentMesh.SetScale3D(NewCheckpointScale);
    NewCylinderTranslation = vect(0.0, 0.0, 0.0);
    NewCylinderTranslation.Z = (AllowedHeight * 0.50) + CurrentMesh.Translation.Z;
    CylinderComponent.SetCylinderSize(AllowedRadius * 0.250, AllowedHeight * 0.50);
    CylinderComponent.SetTranslation(NewCylinderTranslation);
    //return;    
}

function SetUpCheckpoint(bool bIsLastCheckpoint)
{
    // End:0x15
    if(bShouldBeBased)
    {
        AlignToGround(bIsLastCheckpoint);
    }
    ScaleHeight();
    //return;    
}

function int GetNumTracks()
{
    return BelongToTracks.Length;
    //return ReturnValue;    
}

function bool ShouldGenerateTrackData(int TrackIndex)
{
    local int Idx;

    Idx = 0;
    J0x07:
    // End:0x5D [Loop If]
    if(Idx < BelongToTracks.Length)
    {
        // End:0x53
        if(BelongToTracks[Idx].TrackIndex == TrackIndex)
        {
            return !BelongToTracks[Idx].bNoIntermediateTime;
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    return false;
    //return ReturnValue;    
}

