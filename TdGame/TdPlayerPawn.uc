simulated function bool CalcCamera(float DeltaTime, out Vector out_Location, out Rotator out_Rotation, out float out_FOV)
{
    local Vector CameraAnimLocation;
    local Rotator CameraAnimRotation, SwanNeckRotationRef;

    super.CalcCamera(DeltaTime, out_Location, out_Rotation, out_FOV);
    // End:0x2B
    if(Mesh == Mesh3p)
    {
        return false;
    }
    out_Location = Mesh1p.GetBoneLocation('EyeJoint', 0);
    out_Rotation = GetViewRotation();
    GetCameraAnimation(CameraAnimLocation, CameraAnimRotation);
    out_Rotation.Pitch += -CameraAnimRotation.Roll;
    out_Rotation.Yaw += CameraAnimRotation.Pitch;
    out_Rotation.Roll += -CameraAnimRotation.Yaw;
    // End:0x135
    if(SwanNeck1p != none)
    {
        SwanNeckRotationRef = out_Rotation;
        SwanNeckRotationRef.Pitch = 0;
        SwanNeckRotationRef.Roll = 0;
        out_Location += SwanNeck1p.GetSwanNeckPos(Normalize(SwanNeckRotationRef));
    }
    // End:0x192
    if(Moves[MovementState].bUseCameraCollision && !PlayerController(Controller).bCinematicMode)
    {
        Moves[MovementState].CheckForCameraCollision(out_Location, out_Rotation);
    }
    PlayerCameraLocation = out_Location;
    PlayerCameraRotation = out_Rotation;
    // End:0x1CD
    if(Controller != none)
    {
        out_FOV = TdPlayerController(Controller).FOVAngle;
    }
    return IsFirstPerson();
    //return ReturnValue;    
}

event SetFOV(float NewFOV, float Rate)
{
    // End:0x33
    if(Controller != none)
    {
        TdPlayerController(Controller).StartZoom(NewFOV, Rate, 0.0);
    }
    //return;    
}

event SetDefaultFov()
{
    // End:0x24
    if(Controller != none)
    {
        TdPlayerController(Controller).UnZoom();
    }
    //return;    
}

function UpdateFocusLocation(float DeltaTime)
{
    local Vector MoveFocusLocation;

    MoveFocusLocation = Moves[MovementState].GetFocusLocation();
    FocusLocation.X = FInterpTo(FocusLocation.X, MoveFocusLocation.X, DeltaTime, FocusLocationInterpolationSpeed);
    FocusLocation.Y = FInterpTo(FocusLocation.Y, MoveFocusLocation.Y, DeltaTime, FocusLocationInterpolationSpeed);
    FocusLocation.Z = FInterpTo(FocusLocation.Z, MoveFocusLocation.Z, DeltaTime, FocusLocationInterpolationSpeed);
    //return;    
}

function Vector GetFocusLocation()
{
    return FocusLocation;
    //return ReturnValue;    
}

function SetFocusLocation(Vector iFocusLocation)
{
    FocusLocation = iFocusLocation;
    //return;    
}

