}

simulated function EnableFootPlacement(optional float BlendTime)
{
    BlendTime = 0.20;
    // End:0x55
    if((LeftLegControl3p != none) && RightLegControl3p != none)
    {
        LeftLegControl3p.SetSkelControlStrength(1.0, BlendTime);
        RightLegControl3p.SetSkelControlStrength(1.0, BlendTime);
    }
    // End:0xA1
    if((LeftLegControl1p != none) && RightLegControl1p != none)
    {
        LeftLegControl1p.SetSkelControlStrength(1.0, BlendTime);
        RightLegControl1p.SetSkelControlStrength(1.0, BlendTime);
    }
    bEnableFootPlacement = true;
    //return;    
}

simulated function DisableFootPlacement()
{
    // End:0x4C
    if((LeftLegControl3p != none) && RightLegControl3p != none)
    {
        LeftLegControl3p.SetSkelControlStrength(0.0, 0.20);
        RightLegControl3p.SetSkelControlStrength(0.0, 0.20);
    }
    // End:0x98
    if((LeftLegControl1p != none) && RightLegControl1p != none)
    {
        LeftLegControl1p.SetSkelControlStrength(0.0, 0.20);
        RightLegControl1p.SetSkelControlStrength(0.0, 0.20);
    }
    bEnableFootPlacement = false;
    //return;    
}

