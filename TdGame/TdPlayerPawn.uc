function SetAmbientShadowDirection(Vector Direction, bool isShadowAlteringMove)
{
    local editinline DynamicLightEnvironmentComponent Mesh3pLightEnv;

    // End:0x18
    if(bIsInShadowAlteringMoveState && !isShadowAlteringMove)
    {
        return;
    }
    Mesh3pLightEnv = DynamicLightEnvironmentComponent(Mesh3p.LightEnvironment);
    Mesh3pLightEnv.AmbientShadowSourceDirection = Direction;
    bIsInShadowAlteringMoveState = isShadowAlteringMove;
    //return;    
}

function ResetAmbientShadowDirection(bool isShadowAlteringMove)
{
    local editinline DynamicLightEnvironmentComponent Mesh3pLightEnv;
    local Vector defaultDir;

    // End:0x18
    if(bIsInShadowAlteringMoveState && !isShadowAlteringMove)
    {
        return;
    }
    defaultDir = Normal(vect(0.0, 0.0, 10.0) - vector(Rotation));
    Mesh3pLightEnv = DynamicLightEnvironmentComponent(Mesh3p.LightEnvironment);
    Mesh3pLightEnv.AmbientShadowSourceDirection = defaultDir;
    // End:0x76
    if(isShadowAlteringMove)
    {
        bIsInShadowAlteringMoveState = false;
    }
    //return;    
}

function SetFirstPersonDPG(Engine.Scene.ESceneDepthPriorityGroup DPG)
{
    // End:0x0D
    if(Mesh1p == none)
    {
        return;
    }
    // End:0x9E
    if(FirstPersonDPG != DPG)
    {
        FirstPersonDPG = DPG;
        Mesh1p.SetDepthPriorityGroup(FirstPersonDPG);
        // End:0x9E
        if(MyWeapon != none)
        {
            Weapon.Mesh.SetDepthPriorityGroup(FirstPersonDPG);
            // End:0x9E
            if(MyWeapon.MuzzleFlashPSC != none)
            {
                MyWeapon.MuzzleFlashPSC.SetDepthPriorityGroup(FirstPersonDPG);
            }
        }
    }
    //return;    
}

function SetFirstPersonLowerBodyDPG(Engine.Scene.ESceneDepthPriorityGroup DPG)
{
    // End:0x0D
    if(Mesh1pLowerBody == none)
    {
        return;
    }
    // End:0x40
    if(FirstPersonLowerBodyDPG != DPG)
    {
        FirstPersonLowerBodyDPG = DPG;
        Mesh1pLowerBody.SetDepthPriorityGroup(FirstPersonLowerBodyDPG);
    }
    //return;    
}

