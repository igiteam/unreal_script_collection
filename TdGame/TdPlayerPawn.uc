simulated function Init1P()
{
    local bool bIsFirstPerson, bIsServer;

    bIsFirstPerson = IsLocallyControlled();
    bIsServer = (WorldInfo.NetMode == NM_DedicatedServer) || WorldInfo.NetMode == NM_ListenServer;
    // End:0x68
    if(bIsFirstPerson || bIsServer)
    {
        Enable1P();
    }
    // End:0x76
    else
    {
        Mesh1p = none;
        Mesh1pLowerBody = none;
    }
    //return;    
}

simulated function Enable1P()
{
    AttachComponent(Mesh1p);
    AttachComponent(Mesh1pLowerBody);
    CacheAnimNodes1P();
    Init1pArms();
    InitSwanNeck();
    SetFirstPerson(true);
    //return;    
}

simulated function CacheAnimNodes1P()
{
    local AnimNode Node;

    RootControl1p = SkelControlSingleBone(Mesh1p.FindSkelControl('RootControl'));
    HipsControl1p = SkelControlSingleBone(Mesh1p.FindSkelControl('HipsControl'));
    HipsControl3p = SkelControlSingleBone(Mesh3p.FindSkelControl('HipsControl'));
    SwingControl1p = SkelControlSingleBone(Mesh1p.FindSkelControl('SwingControl'));
    CameraControl1p = TdSkelControlSimpleSpring(Mesh1p.FindSkelControl('CameraSpring'));
    RecoilControl1p = TdSkelControlRecoil(Mesh1p.FindSkelControl('RightHandRecoil'));
    CameraNoiseControlRoll1p = TdSkelControlRandom(Mesh1p.FindSkelControl('CameraNoiseControlRoll'));
    CameraNoiseControlPitch1p = TdSkelControlRandom(Mesh1p.FindSkelControl('CameraNoiseControlPitch'));
    LeftLegControl1p = TdSkelControlFootPlacement(Mesh1p.FindSkelControl('LeftFootPlacementControl'));
    RightLegControl1p = TdSkelControlFootPlacement(Mesh1p.FindSkelControl('RightFootPlacementControl'));
    OneHandedRightShoulderOffset1p = SkelControlSingleBone(Mesh1p.FindSkelControl('OneHandedRightShoulderOffset'));
    BlinkControl = SkelControlSingleBone(Mesh3p.FindSkelControl('BlinkControl'));
    RecoilControl1p.SetSkelControlStrength(0.0, 0.0);
    OneHandedRightShoulderOffset1p.SetSkelControlStrength(0.0, 0.0);
    LeftHandWorldIKController = TdSkelControlLimb(Mesh1p.FindSkelControl('LeftHandWorldIKController'));
    RightHandWorldIKController = TdSkelControlLimb(Mesh1p.FindSkelControl('RightHandWorldIKController'));
    LeftHandLocalIKController = SkelControlLimb(Mesh1p.FindSkelControl('LeftHandLocalIKController'));
    RightHandLocalIKController = SkelControlLimb(Mesh1p.FindSkelControl('RightHandLocalIKController'));
    LeftHandRotationController = SkelControlSingleBone(Mesh1p.FindSkelControl('LeftHandRotation'));
    RightHandRotationController = SkelControlSingleBone(Mesh1p.FindSkelControl('RightHandRotation'));
    HeavyWeaponSpringController = TdSkelControlSpring(Mesh1p.FindSkelControl('HeavyWeaponSpringController'));
    LeftForeArmRollRotationController = SkelControlSingleBone(Mesh1p.FindSkelControl('LeftForeArmRollRotation'));
    RightForeArmRollRotationController = SkelControlSingleBone(Mesh1p.FindSkelControl('RightForeArmRollRotation'));
    LeftHandWorldIKController.SetSkelControlStrength(0.0, 0.0);
    RightHandWorldIKController.SetSkelControlStrength(0.0, 0.0);
    LeftLegControl1p.SetSkelControlStrength(0.0, 0.0);
    RightLegControl1p.SetSkelControlStrength(0.0, 0.0);
    RootControl1p.SetSkelControlStrength(0.0, 0.0);
    // End:0x66F
    foreach Mesh1p.AllAnimNodes(class'AnimNode', Node)
    {
        // End:0x3EB
        if(Node.NodeName == 'None')
        {
            continue;            
            // End:0x66E
            continue;
        }
        // End:0x41B
        if(Node.NodeName == 'MasterSync')
        {
            MasterSync1p = AnimNodeSynch(Node);
            // End:0x66E
            continue;
        }
        // End:0x44B
        if(Node.NodeName == 'WeaponPoseOffset')
        {
            WeaponPoseOffset1p = TdAnimNodePoseOffset(Node);
            // End:0x66E
            continue;
        }
        // End:0x47B
        if(Node.NodeName == 'Custom_Canned')
        {
            CustomCannedNode1p = TdAnimNodeSlot(Node);
            // End:0x66E
            continue;
        }
        // End:0x4AB
        if(Node.NodeName == 'Custom_CannedUpperBody')
        {
            CustomCannedUpperBodyNode1p = TdAnimNodeSlot(Node);
            // End:0x66E
            continue;
        }
        // End:0x4DB
        if(Node.NodeName == 'Custom_FullBody')
        {
            CustomFullBodyNode1p = TdAnimNodeSlot(Node);
            // End:0x66E
            continue;
        }
        // End:0x50B
        if(Node.NodeName == 'Custom_FullBody_Dir')
        {
            CustomFullBodyDirNode1p = TdAnimNodeSlot(Node);
            // End:0x66E
            continue;
        }
        // End:0x53B
        if(Node.NodeName == 'Custom_UpperBody')
        {
            CustomUpperBodyNode1p = TdAnimNodeSlot(Node);
            // End:0x66E
            continue;
        }
        // End:0x56B
        if(Node.NodeName == 'Custom_LowerBody')
        {
            CustomLowerBodyNode1p = TdAnimNodeSlot(Node);
            // End:0x66E
            continue;
        }
        // End:0x59B
        if(Node.NodeName == 'Custom_Camera')
        {
            CustomCameraNode = TdAnimNodeSlot(Node);
            // End:0x66E
            continue;
        }
        // End:0x5CB
        if(Node.NodeName == 'Custom_Weapon')
        {
            CustomWeaponNode1p = TdAnimNodeSlot(Node);
            // End:0x66E
            continue;
        }
        // End:0x5FB
        if(Node.NodeName == 'LandNode')
        {
            LandNode1p = TdAnimNodeLandOffset(Node);
            // End:0x66E
            continue;
        }
        // End:0x62B
        if(Node.NodeName == 'GrabNode')
        {
            GrabAnimNode1p = TdAnimNodeGrabbing(Node);
            // End:0x66E
            continue;
        }
        // End:0x66E
        if(Node.NodeName == 'ZipLine')
        {
            TdMove_IntoZipLine(Moves[27]).SetIdleAnimationReference1p(TdAnimNodeSequence(Node));
        }        
    }    
    //return;    
}

simulated function Init1pArms()
{
    local int Idx;

    // End:0x0D
    if(Mesh1p == none)
    {
        return;
    }
    BoneNames1p[0] = 'RightForeArm';
    BoneNames1p[1] = 'RightForeArmRoll';
    BoneNames1p[2] = 'RightHandIndex0';
    BoneNames1p[3] = 'RightHandIndex1';
    BoneNames1p[4] = 'RightHandMiddle0';
    BoneNames1p[5] = 'RightHandMiddle1';
    BoneNames1p[6] = 'LeftForeArm';
    BoneNames1p[7] = 'LeftForeArmRoll';
    BoneNames1p[8] = 'LeftHandIndex0';
    BoneNames1p[9] = 'LeftHandIndex1';
    BoneNames1p[10] = 'LeftHandMiddle0';
    BoneNames1p[11] = 'LeftHandMiddle1';
    HandNormalMapNames1p[0] = 'Right';
    HandNormalMapNames1p[1] = 'Right';
    HandNormalMapNames1p[2] = 'Right';
    HandNormalMapNames1p[3] = 'Right';
    HandNormalMapNames1p[4] = 'Right';
    HandNormalMapNames1p[5] = 'Left';
    HandNormalMapNames1p[6] = 'Left';
    HandNormalMapNames1p[7] = 'Left';
    HandNormalMapNames1p[8] = 'Left';
    HandNormalMapNames1p[9] = 'Left';
    MorphNodeWeight1p[0] = MorphNodeWeight(Mesh1p.FindMorphNode('RightForeArmRollBlend90'));
    MorphNodeWeight1p[1] = MorphNodeWeight(Mesh1p.FindMorphNode('RightForeArmRollBlend90m'));
    MorphNodeWeight1p[2] = MorphNodeWeight(Mesh1p.FindMorphNode('LeftForeArmRollBlend90'));
    MorphNodeWeight1p[3] = MorphNodeWeight(Mesh1p.FindMorphNode('LeftForeArmRollBlend90m'));
    bHasMorphNodes = true;
    Idx = 0;
    J0x23E:
    // End:0x270 [Loop If]
    if(Idx < 4)
    {
        // End:0x266
        if(MorphNodeWeight1p[Idx] == none)
        {
            bHasMorphNodes = false;
            // [Explicit Break]
            goto J0x270;
        }
        ++ Idx;
        J0x270:
        // [Loop Continue]
        goto J0x23E;
    }
    //return;    
}

simulated event EnableHairRagdoll()
{
    local int I, J;

    // End:0xED
    if(bEnableHairPhysics)
    {
        Mesh3p.PhysicsAssetInstance.SetNamedBodiesFixed(false, HairBones, Mesh3p, false);
        I = 0;
        J0x36:
        // End:0xED [Loop If]
        if(I < Mesh3p.PhysicsAsset.BodySetup.Length)
        {
            J = 0;
            J0x61:
            // End:0xE3 [Loop If]
            if(J < HairBones.Length)
            {
                // End:0xD9
                if(Mesh3p.PhysicsAsset.BodySetup[I].BoneName == HairBones[J])
                {
                    Mesh3p.PhysicsAsset.BodySetup[I].bAlwaysFullAnimWeight = true;
                    // [Explicit Break]
                    goto J0xE3;
                }
                ++ J;
                J0xE3:
                // [Loop Continue]
                goto J0x61;
            }
            ++ I;
            // [Loop Continue]
            goto J0x36;
        }
    }
    //return;    
}

simulated event DisableHairRagdoll()
{
    Mesh3p.PhysicsAssetInstance.SetNamedBodiesFixed(true, HairBones, Mesh3p, false);
    //return;    
}

simulated function PlayDying(class<DamageType> DamageType, Vector HitLoc)
{
    SetIgnoreMoveInput();
    SetIgnoreLookInput();
    UpdateAnimSets(none);
    // End:0x7B
    if((MovementState == 72) || MovementState == 25)
    {
        TdPlayerController(Controller).SetSoundMode(8,,, 1.50);
        SetTimer(0.010, false, 'PlayDeathAnim');
    }
    // End:0xB0
    else
    {
        TdPlayerController(Controller).SetSoundMode(9,,, 1.0);
        SetTimer(0.50, false, 'PlayDeathAnim');
    }
    bCollideWorld = true;
    SetCollision(bCollideActors, true);
    Controller.GotoState('PlayerDying');
    super.PlayDying(DamageType, HitLoc);
    //return;    
}

function PlayDeathAnim()
{
    local TdPawn.EMovement DeathMove;
    local bool bUseRootMotion;

    bUseRootMotion = false;
    DeathMove = MovementState;
    // End:0x31
    if(MovementState != 26)
    {
        SetMove(1);
    }
    Moves[MovementState].ResetCameraLook(0.20);
    switch(DeathMove)
    {
        // End:0x8B
        case 25:
            PlayCustomAnim(0, 'FallingLandDieBwd', 1.0, 0.30, -1.0, false, true, false);
            SetPhysics(2);
            // End:0x19F
            break;
        // End:0xC0
        case 72:
            PlayCustomAnim(0, 'FallingLandDie', 1.0, 0.30, -1.0, false, true, false);
            SetPhysics(2);
            // End:0x19F
            break;
        // End:0xC5
        case 15:
        // End:0xFD
        case 16:
            PlayCustomAnim(0, 'diecrouch', 1.0, 0.30, -1.0, false, true, true);
            bUseRootMotion = true;
            // End:0x19F
            break;
        // End:0x13A
        case 26:
            PlayCustomAnim(0, 'DiePursuitFinish', 1.0, 0.30, -1.0, false, true, false);
            SetPhysics(4);
            bUseRootMotion = true;
            // End:0x19F
            break;
        // End:0x14F
        case 2:
            SetAnimationMovementState(72);
            // End:0x19F
            break;
        // End:0x16C
        case 30:
            // End:0x16C
            if(AgainstWallState != 0)
            {
                SetPhysics(4);
            }
            // End:0x19F
            else
            {
        // End:0xFFFF
        default:
        PlayCustomAnim(0, 'die', 1.0, 0.30, -1.0, false, true, true);
        bUseRootMotion = true;
    }
    // End:0x1DE
    if(bUseRootMotion)
    {
        Velocity = vect(0.0, 0.0, 0.0);
        SetPhysics(4);
        UseRootMotion(true);
        SetTimer(2.0, false, 'TurnOffRootMotion');
    }
    //return;    
}

function TurnOffRootMotion()
{
    Velocity = vect(0.0, 0.0, 0.0);
    CustomCannedNode1p.SetRootBoneAxisOption(0, 0, 0);
    CustomCannedNode3p.SetRootBoneAxisOption(0, 0, 0);
    //return;    
}

