function bool CarryObject(TdCarriable InCarriable)
{
    // End:0x42
    if((Role == ROLE_Authority) && CarriedObject == none)
    {
        // End:0x42
        if(InCarriable.OnCarried(self))
        {
            CarriedObject = InCarriable;
            return true;
        }
    }
    return false;
    //return ReturnValue;    
}

function bool DropCarriedObject(Vector StartLocation, Rotator StartRotation, Vector WithForce)
{
    // End:0x4D
    if((Role == ROLE_Authority) && CarriedObject != none)
    {
        // End:0x4D
        if(CarriedObject.OnDropped(self, StartLocation, StartRotation, WithForce))
        {
            CarriedObject = none;
            return true;
        }
    }
    return false;
    //return ReturnValue;    
}

simulated function ForceDropBag(optional Vector Force)
{
    local Vector WeaponLocation;
    local Rotator WeaponRotation;
    local Inventory Bag;
    local class<TdWeapon> BagClass;

    // End:0x13
    if(Role < ROLE_Authority)
    {
        return;
    }
    BagClass = class<TdWeapon>(DynamicLoadObject("TdMpContent.TdWeapon_Bag", class'Class'));
    // End:0xA2
    foreach InvManager.InventoryActors(BagClass, Bag)
    {
        GetWeaponJointPosition(WeaponLocation, WeaponRotation);
        Bag.DropFrom(WeaponLocation, (Velocity * 0.50) + Force);        
    }    
    //return;    
}

