native function MAT_SetAnimPosition(name SlotName, int ChannelIndex, name InAnimSeqName, float InPosition, bool bFireNotifies, bool bLooping);

// Export UTdPlayerPawn::execMAT_SetAnimWeights(FFrame&, void* const)
native function MAT_SetAnimWeights(array<AnimSlotInfo> SlotInfos);

// Export UTdPlayerPawn::execMAT_FinishAnimControl(FFrame&, void* const)
native function MAT_FinishAnimControl();

event BeginAnimControl(array<AnimSet> InAnimSets)
{
    SetMove(1);
    Velocity = vect(0.0, 0.0, 0.0);
    Acceleration = vect(0.0, 0.0, 0.0);
    SetPhysics(0);
    SetCollision(bCollideActors, false);
    bCollideWorld = false;
    // End:0x72
    if(InAnimSets.Length > 0)
    {
        Mesh1p.AnimSets[4] = InAnimSets[0];
    }
    // End:0x98
    if(InAnimSets.Length > 1)
    {
        Mesh3p.AnimSets[4] = InAnimSets[1];
    }
    SetFirstPersonDPG(2);
    MAT_BeginAnimControl(InAnimSets);
    SetTimer(0.50, false, 'CheckForSkippableCutscene');
    //return;    
}

simulated function CheckForSkippableCutscene()
{
    bCutsceneIsSkippable = TdPlayerController(Controller).CheckCutsceneSkippable();
    //return;    
}

simulated event SetAnimPosition(name SlotName, int ChannelIndex, name InAnimSeqName, float InPosition, bool bFireNotifies, bool bLooping)
{
    // End:0x1C
    if(!PlayerController(Controller).bCinematicMode)
    {
        return;
    }
    MAT_SetAnimPosition(SlotName, ChannelIndex, InAnimSeqName, InPosition, bFireNotifies, bLooping);
    //return;    
}

simulated event SetAnimWeights(array<AnimSlotInfo> SlotInfos)
{
    // End:0x1C
    if(!PlayerController(Controller).bCinematicMode)
    {
        return;
    }
    MAT_SetAnimWeights(SlotInfos);
    //return;    
}

event FinishAnimControl()
{
    MAT_FinishAnimControl();
    SetMove(1);
    SetCollision(bCollideActors, true);
    bCollideWorld = true;
    UseRootMotion(false);
    UseRootRotation(false);
    SetPhysics(1);
    // End:0x6F
    if(TdPlayerController(Controller) != none)
    {
        TdPlayerController(Controller).UnZoom();
    }
    Mesh1p.AnimSets[4] = none;
    Mesh3p.AnimSets[4] = none;
    SetFirstPersonDPG(Moves[MovementState].FirstPersonDPG);
    UpdateAnimSets(TdWeapon(Weapon));
    bCutsceneIsSkippable = false;
    //return;    
}

simulated function UpdateDPG(MeshComponent MeshComp)
{
    MeshComp.SetDepthPriorityGroup(FirstPersonDPG);
    //return;    
}

simulated function DisplayDebug(HUD HUD, out float out_YL, out float out_YPos)
{
    local Canvas Canvas;

    Canvas = HUD.Canvas;
    Canvas.SetDrawColor(0, 255, 0);
    // End:0xF5
    if(HUD.ShouldDisplayDebug('Health'))
    {
        out_YPos += out_YL;
        Canvas.SetPos(4.0, out_YPos);
        Canvas.DrawText("timeSinceLastDamage: " $ string(TimeSinceLastDamage));
        out_YPos += out_YL;
        Canvas.SetPos(4.0, out_YPos);
        Canvas.DrawText("healthFrac: " $ string(HealthFrac));
    }
    super.DisplayDebug(HUD, out_YL, out_YPos);
    //return;    
}

simulated function PlayWeaponSwitch(Weapon OldWeapon, Weapon NewWeapon)
{
    super.PlayWeaponSwitch(OldWeapon, NewWeapon);
    NotifyPlayerSwitchedWeapon(NewWeapon);
    //return;    
}

function NotifyPlayerSwitchedWeapon(Weapon PlayerWeapon)
{
    local int Index;
    local Sequence GameSequence;
    local array<SequenceObject> SequenceEvents;
    local SeqEvt_TdPlayerSwitchedWeapon PlayerSwitchedWeaponEvent;

    GameSequence = WorldInfo.GetGameSequence();
    GameSequence.FindSeqObjectsByClass(class'SeqEvt_TdPlayerSwitchedWeapon', true, SequenceEvents);
    Index = 0;
    J0x38:
    // End:0xE2 [Loop If]
    if(Index < SequenceEvents.Length)
    {
        PlayerSwitchedWeaponEvent = SeqEvt_TdPlayerSwitchedWeapon(SequenceEvents[Index]);
        // End:0x87
        if(!ClassIsChildOf(PlayerWeapon.Class, PlayerSwitchedWeaponEvent.ConditionalWeaponClass))
        {
            // [Explicit Continue]
            goto J0xD8;
        }
        // End:0xBF
        if((PlayerSwitchedWeaponEvent.ConditionalVolume != none) && !IsTouchingVolume(PlayerSwitchedWeaponEvent.ConditionalVolume))
        {
            // [Explicit Continue]
            goto J0xD8;
        }
        PlayerSwitchedWeaponEvent.CheckActivate(self, PlayerWeapon);
        J0xD8:
        ++ Index;
        // [Loop Continue]
        goto J0x38;
    }
    //return;    
}

function SetShadowType(SkeletalMeshComponent MyMesh, Engine.LightComponent.ELightShadowMode ShadowMode)
{
    local editinline DynamicLightEnvironmentComponent Env;

    Env = DynamicLightEnvironmentComponent(MyMesh.LightEnvironment);
    // End:0x3A
    if(Env != none)
    {
        Env.LightShadowMode = ShadowMode;
    }
    //return;    
}

simulated state Dying
{
    event BeginState(name PreviousStateName)
    {
        // End:0x29
        if(PreviousStateName == 'UncontrolledFall')
        {
            SetTimer(0.40, false, 'DestroyPawn');
        }
        // End:0x46
        else
        {
            PlayDeathEffect();
            SetTimer(2.50, false, 'DestroyPawn');
        }
        //return;        
    }

    simulated function PlayDeathEffect()
    {
        local TdPlayerController PC;

        // End:0x68
        if((Controller != none) && Controller.IsA('TdPlayerController'))
        {
            PC = TdPlayerController(Controller);
            // End:0x68
            if(PC.myHUD != none)
            {
                PC.myHUD.PlayerOwnerDied();
            }
        }
        //return;        
    }

    event Landed(Vector aNormal, Actor anActor)
    {
        super.Landed(aNormal, anActor);
        SetPhysics(4);
        UseRootMotion(true);
        Velocity = vect(0.0, 0.0, 0.0);
        SetTimer(2.0, false, 'TurnOffRootMotion');
        // End:0x93
        if((OldMovementState == 3) || OldMovementState == 21)
        {
            PlayCustomAnim(0, 'die', 1.0, 0.30, -1.0, false, true, true);
        }
        // End:0x143
        else
        {
            // End:0xE0
            if((MovementState == 2) || MovementState == 72)
            {
                PlayCustomAnim(0, 'FallingLandDie', 1.0, 0.30, -1.0, false, true, true);
            }
            // End:0x143
            else
            {
                // End:0x11B
                if(MovementState == 25)
                {
                    PlayCustomAnim(0, 'FallingLandDieBwd', 1.0, 0.30, -1.0, false, true, true);
                }
                // End:0x143
                else
                {
                    PlayCustomAnim(0, 'die', 1.0, 0.30, -1.0, false, true, true);
                }
            }
        }
        //return;        
    }
    stop;    
}

simulated state UncontrolledFall
{
    ignores HandleMoveAction;

    simulated event bool SetMove(TdPawn.EMovement NewMove, optional bool bViaReplication, optional bool bCheckCanDo)
    {
        bViaReplication = false;
        bCheckCanDo = false;
        // End:0x2E
        if((NewMove != 20) && NewMove != 78)
        {
            return false;
        }
        return super(TdPawn).SetMove(NewMove, bViaReplication, bCheckCanDo);
        //return ReturnValue;        
    }

    function BeginState(name PreviousStateName)
    {
        SetIgnoreMoveInput(-1.0);
        SetIgnoreLookInput(-1.0);
        FallingSound = CreateAudioComponent(soundcue'Death_Fall', true, true);
        //return;        
    }

    function EndState(name NextStateName)
    {
        FallingSound.FadeOut(0.10, 0.0);
        //return;        
    }

    event Landed(Vector aNormal, Actor anActor)
    {
        // End:0x25
        if(bTakeFallDamage || MovementState != 78)
        {
            TakeFallingDamage();
        }
        // End:0x4D
        if(Moves[20].CanDoMove())
        {
            SetMove(20);
        }
        // End:0x69
        if(Health > 0)
        {
            GotoState('None');
        }
        // End:0x7A
        else
        {
            PlaySound(soundcue'Death_Impact', true, false, false);
        }
        //return;        
    }

    simulated function bool CanSkillRoll()
    {
        return false;
        //return ReturnValue;        
    }
    stop;    
}

