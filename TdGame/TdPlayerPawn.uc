    // End:0x2C
    if((IsFirstPerson()) || Mesh == Mesh1p)
    {
        CamLoc = PlayerCameraLocation;
    }
    // End:0x7F
    else
    {
        // End:0x5E
        if(Mesh == Mesh3p)
        {
            CamLoc = Mesh3p.GetBoneLocation('EyeJoint', 0);
        }
        // End:0x7F
        else
        {
            CamLoc = Location + (BaseEyeHeight * vect(0.0, 0.0, 1.0));
        }
    }
    return CamLoc;
    //return ReturnValue;    
}

