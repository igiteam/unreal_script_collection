event TakeDamage(int Damage, Controller InstigatedBy, Vector HitLocation, Vector damageMomentum, class<DamageType> DamageType, optional TraceHitInfo HitInfo, optional Actor DamageCauser)
{
    // End:0x47
    if(TdAIController(InstigatedBy) != none)
    {
        // End:0x47
        if(!TdAIController(InstigatedBy).IsHitRelevant(DamageType, HitInfo.BoneName))
        {
            return;
        }
    }
    // End:0x6B
    if(DamageType.IsA('TdDmgType_Bullet'))
    {
        Damage *= PlayerBulletDamageMultiplier;
    }
    // End:0x9A
    if(!DamageType.IsA('TdDmgType_Fell'))
    {
        PlaySound(soundcue'Hard', false, true, false, Location);
    }
    super.TakeDamage(Damage, InstigatedBy, HitLocation, damageMomentum, DamageType, HitInfo, DamageCauser);
    // End:0xF5
    if((Health < 40) && Weapon != none)
    {
        TdPlayerController(Controller).UnZoom();
    }
    //return;    
}

