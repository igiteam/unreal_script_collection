function OnTdInElevator(SeqAct_TdInElevator Action)
{
    local array<Object> ObjectVariables;

    Action.GetObjectVars(ObjectVariables, "Elevator");
    // End:0x86
    if(Action.InputLinks[0].bHasImpulse)
    {
        // End:0x53
        if(Actor(ObjectVariables[0]) == none)
        {
            return;
        }
        SetMove(1);
        SetBase(Actor(ObjectVariables[0]));
        bLockBase = true;
        bAllowMoveChange = false;
    }
    // End:0x96
    else
    {
        bLockBase = false;
        bAllowMoveChange = true;
    }
    //return;    
}

