        MorphNodeWeight1p[0].SetNodeWeight(0.0);
        MorphNodeWeight1p[1].SetNodeWeight(0.0);
        MorphNodeWeight1p[2].SetNodeWeight(0.0);
        MorphNodeWeight1p[3].SetNodeWeight(0.0);
    }
    //return;    
}

simulated event PostBeginPlay()
{
    super.PostBeginPlay();
    // End:0x56
    if(WorldInfo.Game.IsA('TdSPGame'))
    {
        TdSPGame(WorldInfo.Game).AIManager.SetPlayer(self);
    }
    SetAimOffsetNodesProfile('OneHanded');
    // End:0x7C
    if(bEnableHairPhysics)
    {
        EnableHairRagdoll();
    }
    SetMove(1);
    LastEnemyHitTimeOut = WorldInfo.TimeSeconds;
    DisableFootPlacement();
    //return;    
}

