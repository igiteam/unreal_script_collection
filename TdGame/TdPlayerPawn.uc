    NotifyPlayerDeath();
    return super.Died(Killer, DamageType, HitLocation);
    //return ReturnValue;    
}

function NotifyPlayerDeath()
{
    local int Index;
    local Sequence GameSequence;
    local array<SequenceObject> SequenceEvents;
    local SeqEvt_TdPlayerDeath DeathEvent;

    GameSequence = WorldInfo.GetGameSequence();
    GameSequence.FindSeqObjectsByClass(class'SeqEvt_TdPlayerDeath', true, SequenceEvents);
    Index = 0;
    J0x38:
    // End:0x7D [Loop If]
    if(Index < SequenceEvents.Length)
    {
        DeathEvent = SeqEvt_TdPlayerDeath(SequenceEvents[Index]);
        DeathEvent.CheckActivate(self, self, false);
        ++ Index;
        // [Loop Continue]
        goto J0x38;
    }
    //return;    
}

event Landed(Vector aNormal, Actor anActor)
{
    // End:0x13
    if(bTakeFallDamage)
    {
        TakeFallingDamage();
    }
    Moves[MovementState].Landed(aNormal, anActor);
    EnterFallingHeight = Location.Z;
    //return;    
}

function TakeFallingDamage()
{
    local float Damage, FallHeight;
    local bool bLandedOnSoftSurface, bDeathFall;

    FallHeight = EnterFallingHeight - Location.Z;
    bLandedOnSoftSurface = TdMove_Landing(Moves[20]).IsLandingOnSoftObject();
    bDeathFall = ((MovementState == 72) && IsInState('UncontrolledFall')) || FallHeight >= FallingUncontrolledHeight;
    // End:0xD3
    if(bLandedOnSoftSurface || (!bDeathFall && FallHeight < TdMove_Landing(Moves[20]).HardLandingHeight) || CanSkillRoll())
    {
        MakeNoise(0.50, 'PlayerMovementNoise');
    }
    // End:0x132
    else
    {
        // End:0xEA
        if(bDeathFall)
        {
            Damage = 100.0;
        }
        // End:0x107
        else
        {
            Damage = TdMove_Landing(Moves[20]).HardLandingDamage;
        }
        TakeDamage(int(Damage), none, Location, vect(0.0, 0.0, 0.0), class'DmgType_Fell');
    }
    //return;    
}

