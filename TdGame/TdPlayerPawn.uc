        TdPlayerController(Controller).SetSoundMode(6,,, 0.50);
        GotoState('UncontrolledFall');
    }
    //return;    
}

simulated function Tick(float DeltaTime)
{
    local TdPlayerController PlayerController;
    local bool bAllowAgainstWall;

    // End:0x36
    if(BlinkControl.ControlStrength >= 1.0)
    {
        BlinkControl.SetSkelControlStrength(0.0, 0.250);
    }
    // End:0xA4
    else
    {
        // End:0xA4
        if(BlinkControl.BlendInTime < WorldInfo.TimeSeconds)
        {
            BlinkControl.SetSkelControlStrength(1.0, 0.030);
            BlinkControl.BlendInTime = (WorldInfo.TimeSeconds + 1.0) + (FRand() * 5.0);
        }
    }
    bAllowAgainstWall = ((Moves[MovementState].bEnableAgainstWall && !IsInState('UncontrolledFall')) && !IsInState('Dying')) && WeaponAnimState != 4;
    // End:0x12C
    if((Physics == 2) && VSize2D(Velocity) > 400.0)
    {
        bAllowAgainstWall = false;
    }
    // End:0x13E
    if(bAllowAgainstWall)
    {
        UpdateAgainstWall();
    }
    // End:0x146
    else
    {
        AgainstWallState = 0;
    }
    // End:0x159
    if(IsLocallyControlled())
    {
        SyncLegMovement();
    }
    // End:0x1EE
    if(WindSound == none)
    {
        WindSound = self.CreateAudioComponent(WindSoundSC, false, true);
        // End:0x1EE
        if(WindSound != none)
        {
            AttachComponent(WindSound);
            WindSound.bShouldRemainActiveIfDropped = true;
            WindSound.bUseOwnerLocation = true;
            WindSound.bAllowSpatialization = true;
            WindSound.bAutoDestroy = true;
            WindSound.Play();
        }
    }
    UpdateWeaponAnimState(DeltaTime);
    // End:0x28D
    if(IsLocallyControlled())
    {
        // End:0x229
        if(AgainstWallState == 1)
        {
            SetAmbientShadowDirection(AgainstWallNormal, false);
        }
        // End:0x234
        else
        {
            ResetAmbientShadowDirection(false);
        }
        // End:0x24A
        if(Mesh1p != none)
        {
            Update1pArms(DeltaTime);
        }
        // End:0x28D
        if(SwanNeck1p != none)
        {
            SwanNeck1p.UpdateSwanNeck(WorldInfo.SavedDeltaSeconds, GetViewRotation().Pitch);
        }
    }
    PlayerController = TdPlayerController(Controller);
    // End:0x357
    if((PlayerController != none) && !IsInState('UncontrolledFall') || IsInState('Dying'))
    {
        // End:0x335
        if(!RollTriggerPressed && PlayerController.bDuck == 1)
        {
            // End:0x32A
            if((RollTriggerTime + 0.60) < WorldInfo.TimeSeconds)
            {
                RollTriggerTime = WorldInfo.TimeSeconds;
            }
            RollTriggerPressed = true;
        }
        // End:0x357
        else
        {
            // End:0x357
            if(PlayerController.bDuck == 0)
            {
                RollTriggerPressed = false;
            }
        }
    }
    UpdateMovementString(DeltaTime);
    UpdateFocusLocation(DeltaTime);
    super.Tick(DeltaTime);
    //return;    
}

function ReleaseCameraConstraintsAgainstWall()
{
    MinLookConstraint = default.MinLookConstraint;
    MaxLookConstraint = default.MaxLookConstraint;
    bConstrainLook = false;
    //return;    
}

function StopAgainstWall()
{
    local TdPawn.EAgainstWallState WallState;

    WallState = CheckAgainstWall();
    // End:0x31
    if(WallState == 0)
    {
        AgainstWallState = 0;
        ReleaseCameraConstraintsAgainstWall();
    }
    // End:0x44
    else
    {
        SetTimer(0.150, false, 'StopAgainstWall');
    }
    //return;    
}

function UpdateMovementString(float DeltaTime)
{
    // End:0x50
    if(MovementStringGapTimer > 0.0)
    {
        MovementStringGapTimer -= DeltaTime;
        // End:0x50
        if((MovementStringHistory.Length > 0) && MovementStringGapTimer <= 0.0)
        {
            MovementStringGapTimer = 0.0;
            MovementStringHistory.Remove(0, MovementStringHistory.Length);
        }
    }
    //return;    
}

function StartStringableMove(Class CL)
{
    local int StringLength;
    local bool Reset;

    Reset = false;
    MovementStringHistory.AddItem(CL);
    MovementStringGapTimer = -1.0;
    StringLength = MovementStringHistory.Length;
    // End:0xA3
    if((StringLength >= 3) && CL == class'TdMove_VaultOver')
    {
        // End:0xA0
        if((MovementStringHistory[StringLength - 2] == class'TdMove_WallrunJump') && MovementStringHistory[StringLength - 3] == class'TdMove_WallRun')
        {
            TdPlayerController(Controller).UnlockAchievement(39);
            Reset = true;
        }
    }
    // End:0x271
    else
    {
        // End:0x11A
        if((StringLength >= 3) && CL == class'TdMove_Slide')
        {
            // End:0x117
            if((MovementStringHistory[StringLength - 2] == class'TdMove_Coil') && MovementStringHistory[StringLength - 3] == class'TdMove_Jump')
            {
                TdPlayerController(Controller).UnlockAchievement(38);
                Reset = true;
            }
        }
        // End:0x271
        else
        {
            // End:0x1E2
            if((StringLength >= 5) && CL == class'TdMove_WallClimb180TurnJump')
            {
                // End:0x1DF
                if(((((MovementStringHistory[StringLength - 2] == class'TdMove_WallClimb180TurnJump') && MovementStringHistory[StringLength - 3] == class'TdMove_WallClimb') && MovementStringHistory[StringLength - 4] == class'TdMove_WallrunJump') && MovementStringHistory[StringLength - 5] == class'TdMove_WallRun') && MovementStringHistory[StringLength - 6] == class'TdMove_WallRun')
                {
                    TdPlayerController(Controller).UnlockAchievement(40);
                    Reset = true;
                }
            }
            // End:0x271
            else
            {
                // End:0x271
                if((StringLength >= 4) && CL == class'TdMove_SkillRoll')
                {
                    // End:0x271
                    if(((MovementStringHistory[StringLength - 2] == class'TdMove_Coil') && MovementStringHistory[StringLength - 3] == class'TdMove_WallrunJump') && MovementStringHistory[StringLength - 4] == class'TdMove_WallRun')
                    {
                        TdPlayerController(Controller).UnlockAchievement(41);
                        Reset = true;
                    }
                }
            }
        }
    }
    // End:0x292
    if(Reset)
    {
        MovementStringGapTimer = 0.0;
        MovementStringHistory.Remove(0, MovementStringHistory.Length);
    }
    //return;    
}

function StartUnStringableMove()
{
    // End:0x21
    if(MovementStringGapTimer < 0.0)
    {
        MovementStringGapTimer = FMax(MovementStringAllowedGap, 0.010);
    }
    //return;    
}

simulated function SetHipsOffset(Vector Offset, optional float BlendTime, optional bool bFirstPersonMeshOnly)
{
    BlendTime = 0.30;
    bFirstPersonMeshOnly = false;
    // End:0xA3
    if(VSize(Offset) > 0.10)
    {
        // End:0x59
        if(HipsControl1p != none)
        {
            HipsControl1p.BoneTranslation = Offset;
            HipsControl1p.SetSkelControlStrength(1.0, BlendTime);
        }
        // End:0xA0
        if((HipsControl3p != none) && !bFirstPersonMeshOnly)
        {
            HipsControl3p.BoneTranslation = Offset;
            HipsControl3p.SetSkelControlStrength(1.0, BlendTime);
        }
    }
    // End:0xFA
    else
    {
        // End:0xC8
        if(HipsControl1p != none)
        {
            HipsControl1p.SetSkelControlStrength(0.0, BlendTime);
        }
        // End:0xFA
        if((HipsControl3p != none) && !bFirstPersonMeshOnly)
        {
            HipsControl3p.SetSkelControlStrength(0.0, BlendTime);
        }
    }
    //return;    
}

