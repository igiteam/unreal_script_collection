class TdMove_StumbleBase extends TdPhysicsMove
    config(PawnMovement);

enum EStumbleState
{
    ESS_HitNone,
    ESS_HitMeleeBack,
    ESS_HitMeleeBackHead,
    ESS_HitMeleeFrontLeft,
    ESS_HitMeleeFrontRight,
    ESS_HitMeleeBargeFront,
    ESS_HitMeleeCrouchFront,
    ESS_HitMeleeSlideFront,
    ESS_HitMeleeWallrunRight,
    ESS_HitMeleeWallrunLeft,
    ESS_HitMeleeAirHeadFront,
    ESS_HitMeleeAirBodyFront,
    ESS_HitMeleeVaultKick,
    ESS_HitMeleeSoccerKick,
    ESS_HitBulletFront,
    ESS_HitBulletFrontHead,
    ESS_HitBulletBack,
    ESS_HitSpecialBulletFront,
    ESS_HitSpecialBulletHead,
    ESS_HitSpecialBulletBack,
    ESS_HitBarbedWireFront,
    ESS_MAX
};

var Vector DamageLocation;
var Vector damageMomentum;
var Vector InstigatorLocation;
var TdPawn Instigator;
var class<DamageType> HitDamageType;
var float DirectionalBias;
var TdMove_StumbleBase.EStumbleState StumbleState;

simulated function StartMove()
{
    super.StartMove();
    StumbleState = GetStumbleState();
    //return;    
}

function TdMove_StumbleBase.EStumbleState GetStumbleState()
{
    local Vector HitHeight, Hit2D;
    local float HitSide;
    local TdMove_StumbleBase.EStumbleState ResultStumbleState;

    HitHeight = DamageLocation - (PawnOwner.Location - (vect(0.0, 0.0, 1.0) * PawnOwner.CylinderComponent.CollisionHeight));
    Hit2D = InstigatorLocation - PawnOwner.Location;
    Hit2D.Z = 0.0;
    Hit2D = Normal(Hit2D);
    HitSide = Hit2D Dot vector(PawnOwner.Rotation);
    switch(HitDamageType)
    {
        // End:0xD8
        case class'TdDmgType_Barge':
            // End:0xCD
            if(HitSide > 0.0)
            {
                ResultStumbleState = 5;
            }
            // End:0xD5
            else
            {
                ResultStumbleState = 1;
            }
            // End:0x3CA
            break;
        // End:0xFE
        case class'TdDmgType_BarbedWire':
            ResultStumbleState = ((HitSide > 0.0) ? 1 : 20);
            // End:0x3CA
            break;
        // End:0x106
        case class'TdDmgType_Melee':
        // End:0x10E
        case class'TdDmgType_MeleeLeft':
        // End:0x116
        case class'TdDmgType_MeleeRight':
        // End:0x11E
        case class'TdDmgType_Sniper_Bullet':
        // End:0x17C
        case class'TdDmgType_Shove':
            // End:0x153
            if(HitSide > 0.0)
            {
                ResultStumbleState = ((HitDamageType == class'TdDmgType_MeleeRight') ? 4 : 3);
            }
            // End:0x179
            else
            {
                ResultStumbleState = ((HitHeight.Z > 145.0) ? 2 : 1);
            }
            // End:0x3CA
            break;
        // End:0x18F
        case class'TdDmgType_MeleeVaultKick':
            ResultStumbleState = 12;
            // End:0x3CA
            break;
        // End:0x1F8
        case class'TdDmgType_MeleeAir':
            // End:0x1CF
            if(HitSide > 0.0)
            {
                ResultStumbleState = ((HitHeight.Z < 100.0) ? 11 : 10);
            }
            // End:0x1F5
            else
            {
                ResultStumbleState = ((HitHeight.Z > 100.0) ? 2 : 1);
            }
            // End:0x3CA
            break;
        // End:0x243
        case class'TdDmgType_MeleeCrouch':
            // End:0x21A
            if(HitSide > 0.0)
            {
                ResultStumbleState = 6;
            }
            // End:0x240
            else
            {
                ResultStumbleState = ((HitHeight.Z > 145.0) ? 2 : 1);
            }
            // End:0x3CA
            break;
        // End:0x28E
        case class'TdDmgType_MeleeSlide':
            // End:0x265
            if(HitSide > 0.0)
            {
                ResultStumbleState = 7;
            }
            // End:0x28B
            else
            {
                ResultStumbleState = ((HitHeight.Z > 145.0) ? 2 : 1);
            }
            // End:0x3CA
            break;
        // End:0x325
        case class'TdDmgType_MeleeWallRun':
            // End:0x2FC
            if(HitSide > 0.0)
            {
                ResultStumbleState = ((vector(PawnOwner.Rotation) Cross (Instigator.Location - PawnOwner.Location).Z > 0.0) ? 9 : 8);
            }
            // End:0x322
            else
            {
                ResultStumbleState = ((HitHeight.Z > 145.0) ? 2 : 1);
            }
            // End:0x3CA
            break;
        // End:0x338
        case class'TdDmgType_MeleeSoccerKick':
            ResultStumbleState = 13;
            // End:0x3CA
            break;
        // End:0x340
        case class'TdDmgType_Shotgun':
        // End:0x392
        case class'TdDmgType_Taser':
            // End:0x362
            if(HitSide < 0.0)
            {
                ResultStumbleState = 19;
            }
            // End:0x38F
            else
            {
                // End:0x387
                if(HitHeight.Z > 145.0)
                {
                    ResultStumbleState = 18;
                }
                // End:0x38F
                else
                {
                    ResultStumbleState = 17;
                }
            }
            // End:0x3CA
            break;
        // End:0x39A
        case class'TdDmgType_LowCaliber_Bullet':
        // End:0x3C7
        case class'TdDmgType_HighCaliber_Bullet':
            // End:0x3BC
            if(HitSide < 0.0)
            {
                ResultStumbleState = 16;
            }
            // End:0x3C4
            else
            {
                ResultStumbleState = 14;
            }
            // End:0x3CA
            break;
        // End:0xFFFF
        default:
            // End:0x465
            if(bDebugMove)
            {
                class'TdDebugOutput'.static.DrawVector(PawnOwner.Location, vector(PawnOwner.Rotation), 30.0, 0, 100, 0, true);
                class'TdDebugOutput'.static.DrawVector(PawnOwner.Location, Hit2D, 30.0, 0, 0, 255, true);
                class'TdDebugOutput'.static.DrawVector(DamageLocation, damageMomentum, 30.0, 255, 0, 0, true);
            }
            return ResultStumbleState;
    }
    //return ReturnValue;    
}

defaultproperties
{
    DirectionalBias=0.50
    MovementGroup=MG_TwoHandsBusy
    DisableMovementTime=-1.0
    DisableLookTime=-1.0
}