function SpawnBindStompWarningMessage()
{
    OwnerScene.OpenMessageBox(OnSpawnBindStompWarningMessage_Init);
    //return;    
}

function OnSpawnBindStompWarningMessage_Init(UIScene OpenedScene, bool bInitialActivation)
{
    TdUIScene_MessageBox(OpenedScene).DisplayAcceptCancelBox("<Strings:TdGameUI.TdMessageBox.StompBindKey_Message>", "<Strings:TdGameUI.TdMessageBox.StompBindKey_Title>", OnMessageBox_BindOverwriteConfirm);
    //return;    
}

function OnMessageBox_BindOverwriteConfirm(TdUIScene_MessageBox MessageBox, int SelectedItem, int PlayerIndex)
{
    // End:0x18
    if(SelectedItem == 1)
    {
        BindKey();
    }
    // End:0x22
    else
    {
        CancelKeyBind();
    }
    //return;    
}

function CancelKeyBind()
{
    FinishBinding();
    //return;    
}

function AttemptKeyBind()
{
    // End:0x33
    if(CurrKeyBindData.KeyName == CurrKeyBindData.PreviousBinding)
    {
        FinishKeyBinding(false);
    }
    // End:0x73
    else
    {
        // End:0x5E
        if(IsAlreadyBound(CurrKeyBindData.KeyName))
        {
            FinishKeyBinding(true);
        }
        // End:0x73
        else
        {
            BindKey();
            FinishKeyBinding(false);
        }
    }
    //return;    
}

function BindKey()
{
    local int StartIdx;
    local KeyBind NewKeyBind;

    UnbindKey(CurrKeyBindData.PreviousBinding);
    UnbindKey(CurrKeyBindData.KeyName);
    NewKeyBind.Name = CurrKeyBindData.KeyName;
    NewKeyBind.Command = CurrKeyBindData.Command;
    // End:0x9F
    if(CurrKeyBindData.bBindIsPrimary)
    {
        CurrentBindingsMap[CurrentBindingsMap.Length] = NewKeyBind;
    }
    // End:0x108
    else
    {
        StartIdx = CurrentBindingsMap.Length - 1;
        GetBindKeyFromCommand(CurrKeyBindData.Command, StartIdx);
        // End:0xF6
        if(StartIdx > -1)
        {
            CurrentBindingsMap.InsertItem(StartIdx, NewKeyBind);
        }
        // End:0x108
        else
        {
            CurrentBindingsMap[CurrentBindingsMap.Length] = NewKeyBind;
        }
    }
    FinishBinding();
    bSettingsWasChanged = true;
    OnSettingsChangedDelegate();
    //return;    
}

function UnbindKey(name BindName)
{
    local int BindingIdx;

    BindingIdx = 0;
    J0x07:
    // End:0x50 [Loop If]
    if(BindingIdx < CurrentBindingsMap.Length)
    {
        // End:0x46
        if(CurrentBindingsMap[BindingIdx].Name == BindName)
        {
            CurrentBindingsMap.Remove(BindingIdx, 1);
            // [Explicit Break]
            goto J0x50;
        }
        ++ BindingIdx;
        J0x50:
        // [Loop Continue]
        goto J0x07;
