function ResetToDefaults()
{
    CurrentBindingsMap = class'PlayerInput'.default.Bindings;
    bSettingsWasChanged = true;
    RefreshBindingButtons();
    //return;    
}

function bool OnBindButton_InputKey(const out InputEventParameters EventParms)
{
    local bool bResult;
    local int CurrentBindingWidgetIndex, CurrentBindingButtonIndex;

    // End:0x114
    if((EventParms.EventType == 1) && (EventParms.InputKeyName == 'LeftMouseButton') || EventParms.InputKeyName == 'SpaceBar')
    {
        // End:0x114
        if((CurrentBindingObject == none) && BindKeyMessageBox == none)
        {
            bCurrentlyBindingKey = true;
            CurrentBindingObject = UILabelButton(OwnerScene.GetFocusedControl(true));
            // End:0x10C
            if(CurrentBindingObject != none)
            {
                // End:0x10C
                if(GetKeyBindIndicesFromObject(CurrentBindingObject, CurrentBindingWidgetIndex, CurrentBindingButtonIndex))
                {
                    CurrKeyBindData.PreviousBinding = name(CurrentBindings[CurrentBindingWidgetIndex].BoundButtonKeys[CurrentBindingButtonIndex]);
                    OwnerScene.OpenTinyMessageBox(OnKeyBindButton_Clicked_MsgBoxInit);
                }
            }
            bResult = true;
        }
    }
    return bResult;
    //return ReturnValue;    
}

function OnKeyBindButton_Clicked_MsgBoxInit(UIScene OpenedScene, bool bInitialAcivation)
{
    BindKeyMessageBox = TdUIScene_MessageBox(OpenedScene);
    BindKeyMessageBox.__OnMBInputKey__Delegate = OnBindKeyMessageBox_HandleInputKey;
    BindKeyMessageBox.DisplayModalBox("<Strings:TdGameUI.TdSettings.PressKeyToBind>");
    BindKeyMessageBox.SetScale(0.70, 0.60);
    //return;    
}

function bool OnBindKeyMessageBox_HandleInputKey(const out InputEventParameters EventParms)
{
    return HandleInputKey(EventParms);
    //return ReturnValue;    
}

