    //return;    
}

function FinishKeyBinding(bool bInPromptForBindStomp)
{
    bPromptForBindStomp = bInPromptForBindStomp;
    BindKeyMessageBox.__OnMBInputKey__Delegate = None;
    BindKeyMessageBox.__OnClosed__Delegate = OnFinisKeyBinding_MsgBoxClosed;
    BindKeyMessageBox.Close(true);
