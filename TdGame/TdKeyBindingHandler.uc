        SpawnBindStompWarningMessage();
    }
    // End:0x27
    else
    {
        FinishBinding();
    }
    //return;    
}

function FinishBinding()
{
    bCurrentlyBindingKey = false;
    CurrentBindingObject = none;
    CurrKeyBindData.Command = "";
    CurrKeyBindData.KeyName = 'None';
    CurrKeyBindData.PreviousBinding = 'None';
    RefreshBindingButtons();
    //return;    
}

function bool AllActionsHaveBind()
{
    local bool bResult, bBindingFound;
    local int WidgetDataIndex, BindingButtonIndex;

    bResult = true;
    WidgetDataIndex = 0;
    J0x0F:
    // End:0xA7 [Loop If]
    if(WidgetDataIndex < CurrentBindings.Length)
    {
        bBindingFound = false;
        BindingButtonIndex = 0;
        J0x2E:
        // End:0x87 [Loop If]
        if(BindingButtonIndex < CurrentBindings[WidgetDataIndex].BoundButtonKeys.Length)
        {
            // End:0x7D
            if(CurrentBindings[WidgetDataIndex].BoundButtonKeys[BindingButtonIndex] != "")
            {
                bBindingFound = true;
                // [Explicit Break]
                goto J0x87;
            }
            ++ BindingButtonIndex;
            J0x87:
            // [Loop Continue]
            goto J0x2E;
        }
        // End:0x9D
        if(!bBindingFound)
        {
            bResult = false;
            // [Explicit Break]
            goto J0xA7;
        }
        ++ WidgetDataIndex;
        J0xA7:
        // [Loop Continue]
        goto J0x0F;
    }
    return bResult;
    //return ReturnValue;    
}

function bool HandleInputKey(const out InputEventParameters EventParms)
{
    local bool bResult;
    local int CurrentBindingWidgetIndex, CurrentBindingButtonIndex;
    local UIDataProvider_TdKeyBinding KeyBindingProvider;

    // End:0x1B0
    if(bCurrentlyBindingKey)
    {
        // End:0x52
        if((EventParms.InputKeyName == 'Escape') && EventParms.EventType == 1)
        {
            FinishKeyBinding(false);
        }
        // End:0x1A8
        else
        {
            // End:0x1A8
            if(EventParms.EventType == 1)
            {
                // End:0x1A8
                if(!OwnerScene.IsConsole(2) && !OwnerScene.IsControllerInput(EventParms.InputKeyName))
                {
                    // End:0x1A8
                    if(GetKeyBindIndicesFromObject(CurrentBindingObject, CurrentBindingWidgetIndex, CurrentBindingButtonIndex))
                    {
                        KeyBindingProvider = UIDataProvider_TdKeyBinding(KeyBindWidgets[CurrentBindingWidgetIndex].KeyBindButtons[CurrentBindingButtonIndex].KeyProvider);
                        // End:0x1A8
                        if(KeyBindingProvider != none)
                        {
                            // End:0x13B
                            if(__IsAllowedBindingKey__Delegate != none && !IsAllowedBindingKey(EventParms.InputKeyName))
                            {
                                return false;
                            }
                            CurrKeyBindData.KeyName = EventParms.InputKeyName;
                            CurrKeyBindData.Command = KeyBindingProvider.Command;
                            CurrKeyBindData.bBindIsPrimary = Percent_IntInt(CurrentBindingButtonIndex, 2) == 0;
                            AttemptKeyBind();
                        }
                    }
                }
            }
        }
        bResult = true;
    }
    return bResult;
    //return ReturnValue;    
}
