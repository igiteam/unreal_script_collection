function OnTouchedVolume(TdPlayerPawn Pawn, TdPlayerController Controller)
{
    // End:0x4A
    if((NotEqual_InterfaceInterface(Listener, (none)) && bActive) && bEnabled)
    {
        Listener.OnCheckpointCompleted(self, Pawn, Controller);
    }
    //return;    
}

event Touch(Actor Other, PrimitiveComponent OtherComp, Vector HitLocation, Vector HitNormal)
{
    local TdPlayerPawn Player;
    local TdPlayerController PlayerController;

    // End:0x0D
    if(TouchVolume != none)
    {
        return;
    }
    Player = TdPlayerPawn(Other);
    // End:0x8C
    if(Player != none)
    {
        PlayerController = TdPlayerController(Player.Controller);
        // End:0x8C
        if((NotEqual_InterfaceInterface(Listener, (none)) && bActive) && bEnabled)
        {
            Listener.OnCheckpointCompleted(self, Player, PlayerController);
        }
    }
    //return;    
}

