function ResetIdsToDefault(array<int> ProfileIds)
{
    local int ProfileIdIndex;

    ProfileIdIndex = 0;
    J0x07:
    // End:0x36 [Loop If]
    if(ProfileIdIndex < ProfileIds.Length)
    {
        ResetIdToDefault(ProfileIds[ProfileIdIndex]);
        ++ ProfileIdIndex;
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

function ResetIdToDefault(int ProfileId)
{
    local int ProfileSettingIndex, DefaultSettingsIndex;
    local bool bIsFrench;

    ProfileSettingIndex = 0;
    J0x07:
    // End:0x11D [Loop If]
    if(ProfileSettingIndex < ProfileSettings.Length)
    {
        // End:0x113
        if(ProfileSettings[ProfileSettingIndex].ProfileSetting.PropertyId == ProfileId)
        {
            DefaultSettingsIndex = 0;
            J0x49:
            // End:0x110 [Loop If]
            if(DefaultSettingsIndex < DefaultSettings.Length)
            {
                // End:0x106
                if(DefaultSettings[DefaultSettingsIndex].ProfileSetting.PropertyId == ProfileId)
                {
                    ProfileSettings[ProfileSettingIndex] = DefaultSettings[DefaultSettingsIndex];
                    bIsFrench = class'TdGameEngine'.static.GetLanguage() == 'FRA';
                    // End:0x103
                    if(bIsFrench && ProfileSettings[ProfileSettingIndex].ProfileSetting.PropertyId == 1000)
                    {
                        SetProfileSettingValueId(1000, 1);
                    }
                    // [Explicit Break]
                    goto J0x110;
                }
                ++ DefaultSettingsIndex;
                J0x110:
                // [Loop Continue]
                goto J0x49;
            }
            // [Explicit Break]
            goto J0x11D;
        }
        ++ ProfileSettingIndex;
        J0x11D:
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

function SetHintShown(int HintId)
{
    local int ProfileId, Mask, Value;

    Mask = 1 << HintId;
    ProfileId = 1300;
    // End:0x59
    if(GetProfileSettingValueInt(ProfileId, Value))
    {
        Value = Value | Mask;
        SetProfileSettingValueInt(ProfileId, Value);
        J0x59:
    }
    // End:0x59
    else
    {
    }
    //return;    
}

event bool IsHintShown(int HintId)
{
    local bool bResult;
    local int ProfileId, Mask, Value;

    Mask = 1 << HintId;
    ProfileId = 1300;
    // End:0x49
    if(GetProfileSettingValueInt(ProfileId, Value))
    {
        bResult = (Value & Mask) != 0;
        J0x49:
    }
    // End:0x49
    else
    {
    }
    return bResult;
    //return ReturnValue;    
}

function SetUnlockViewed(int UnlockProfileId)
{
    local int ProfileId, Mask, Value, Mod;

    Mod = UnlockProfileId / 32;
    UnlockProfileId -= (Mod * 32);
    Mask = 1 << UnlockProfileId;
    ProfileId = 1260 + Mod;
    // End:0x7F
    if(GetProfileSettingValueInt(ProfileId, Value))
    {
        Value = Value | Mask;
        SetProfileSettingValueInt(ProfileId, Value);
        J0x7F:
    }
    // End:0x7F
    else
    {
    }
    //return;    
}

event bool IsUnlockViewed(int UnlockProfileId)
{
    local bool bResult;
    local int ProfileId, Mask, Value, Mod;

    Mod = UnlockProfileId / 32;
    UnlockProfileId -= (Mod * 32);
    Mask = 1 << UnlockProfileId;
    ProfileId = 1260 + Mod;
    // End:0x6F
    if(GetProfileSettingValueInt(ProfileId, Value))
    {
        bResult = (Value & Mask) != 0;
        J0x6F:
    }
    // End:0x6F
    else
    {
    }
    return bResult;
    //return ReturnValue;    
}

// Export UTdProfileSettings::execGetTTStretchTotalTimeOnly(FFrame&, void* const)
native function bool GetTTStretchTotalTimeOnly(int ProfileSettingId, out float TotalTime);

// Export UTdProfileSettings::execSetTTStretchTime(FFrame&, void* const)
private native final function bool SetTTStretchTime(int ProfileSettingId, float TotalTime, out array<float> IntermediateTimes, float AverageSpeed, float DistanceRun);

// Export UTdProfileSettings::execGetTTStretchTime(FFrame&, void* const)
private native final function bool GetTTStretchTime(int ProfileSettingId, out float TotalTime, out array<float> IntermediateTimes, out float AverageSpeed, out float DistanceRun);

function bool GetTotalTimeOnlyForStretch(int Stretch, out float TotalTime)
{
    local int StretchProfileID;

    // End:0x0D
    if(Stretch < 1)
    {
        return false;
    }
    StretchProfileID = (Stretch + 1200) - 1;
    return GetTTStretchTotalTimeOnly(StretchProfileID, TotalTime);
    //return ReturnValue;    
}

function bool GetTTTimeForStretch(int Stretch, out float TotalTime, out array<float> IntermediateTimes, out float AverageSpeed, out float DistanceRun)
{
    local int StretchProfileID;

    // End:0x0D
    if(Stretch < 1)
    {
        return false;
    }
    StretchProfileID = (Stretch + 1200) - 1;
    return GetTTStretchTime(StretchProfileID, TotalTime, IntermediateTimes, AverageSpeed, DistanceRun);
    //return ReturnValue;    
}

function bool SetTTTimeForStretch(int Stretch, float TotalTime, out array<float> IntermediateTimes, float AverageSpeed, float DistanceRun)
{
    local int StretchProfileID;

    // End:0x0D
    if(Stretch < 1)
    {
        return false;
    }
    StretchProfileID = (Stretch + 1200) - 1;
    return SetTTStretchTime(StretchProfileID, TotalTime, IntermediateTimes, AverageSpeed, DistanceRun);
    //return ReturnValue;    
}

function int GetTimeTrialRating()
{
    local int Value;

    GetProfileSettingValueInt(1152, Value);
    return Value;
    //return ReturnValue;    
}

function bool SetTimeTrialRating(int Value)
{
    return SetProfileSettingValueInt(1152, Value);
    //return ReturnValue;    
}

function bool IsAllLevelsUnlocked(optional bool bHardDifficulty)
{
    local int Mask, Value;
    local bool bOnHard;

    bOnHard = false;
    // End:0x58
    if(bHardDifficulty)
    {
        Mask = (1 << (10 + 1)) - 1;
        GetProfileSettingValueInt(1002, Value);
        bOnHard = (Value & Mask) == Mask;
        return bOnHard;
    }
    Mask = (1 << (10 + 1)) - 1;
    GetProfileSettingValueInt(1001, Value);
    return ((Value & Mask) == Mask) || bOnHard;
    //return ReturnValue;    
}

function bool IsLevelUnlocked(int LevelIndex, optional bool bHardDifficulty)
{
    local int Mask, Value;
    local bool bOnHard;

    bOnHard = false;
    // End:0x51
    if(bHardDifficulty)
    {
        Mask = 1 << LevelIndex;
        GetProfileSettingValueInt(1002, Value);
        bOnHard = (Value & Mask) != 0;
        return bOnHard;
    }
    Mask = 1 << LevelIndex;
    GetProfileSettingValueInt(1001, Value);
    return ((Value & Mask) != 0) || bOnHard;
    //return ReturnValue;    
}

function bool UnlockLevel(int LevelIndex, optional bool bHardDifficulty)
{
    local int Mask, Value;

    // End:0x79
    if(LevelIndex > -1)
    {
        Mask = 1 << LevelIndex;
        GetProfileSettingValueInt(((bHardDifficulty) ? 1002 : 1001), Value);
        Value = Value | Mask;
        return SetProfileSettingValueInt(((bHardDifficulty) ? 1002 : 1001), Value);
    }
    return false;
    //return ReturnValue;    
}

function bool LockLevel(int LevelIndex, optional bool bHardDifficulty)
{
    local int Mask, Value;

    // End:0x86
    if(LevelIndex > -1)
    {
        Mask = 1 << LevelIndex;
        Mask = ~Mask;
        GetProfileSettingValueInt(((bHardDifficulty) ? 1002 : 1001), Value);
        Value = Value & Mask;
        return SetProfileSettingValueInt(((bHardDifficulty) ? 1002 : 1001), Value);
    }
    return false;
    //return ReturnValue;    
}

function bool LockAllLevels()
{
    return SetProfileSettingValueInt(1001, 0);
    //return ReturnValue;    
}

function bool UnlockAllLevels()
{
    return SetProfileSettingValueInt(1001, -1);
    //return ReturnValue;    
}

function bool IsHiddenBagFound(int BagIndex)
{
    local int Mask, Value;

    // End:0x1B
    if((BagIndex > 30) || BagIndex < 0)
    {
        return false;
    }
    Mask = 1 << BagIndex;
    GetProfileSettingValueInt(1020, Value);
    return (Value & Mask) != 0;
    //return ReturnValue;    
}

function int NumBagsFoundTotal()
{
    local int Result, BagIndex;

    Result = 0;
    BagIndex = 0;
    J0x0E:
    // End:0x3D [Loop If]
    if(BagIndex < 30)
    {
        // End:0x33
        if(IsHiddenBagFound(BagIndex))
        {
            ++ Result;
        }
        ++ BagIndex;
        // [Loop Continue]
        goto J0x0E;
    }
    return Result;
    //return ReturnValue;    
}

function int NumBagsFoundForLevel(int LevelIndex)
{
    local int Result, BagBitValue, StartBagIndex, BagIndex, BagsPerLevel;

    // End:0x1B
    if((LevelIndex > 9) || LevelIndex < 0)
    {
        return 0;
    }
    Result = 0;
    BagsPerLevel = 3;
    GetProfileSettingValueInt(1020, BagBitValue);
    StartBagIndex = LevelIndex * BagsPerLevel;
    BagIndex = StartBagIndex;
    J0x5B:
    // End:0x97 [Loop If]
    if(BagIndex < (StartBagIndex + BagsPerLevel))
    {
        // End:0x8D
        if((BagBitValue & (1 << BagIndex)) != 0)
        {
            ++ Result;
        }
        ++ BagIndex;
        // [Loop Continue]
        goto J0x5B;
    }
    return Result;
    //return ReturnValue;    
}

function bool IsAllBagsFound()
{
    local int Mask, Value, BagIndex;

    BagIndex = 0;
    J0x07:
    // End:0x32 [Loop If]
    if(BagIndex < 30)
    {
        Mask = Mask | (1 << BagIndex);
        ++ BagIndex;
        // [Loop Continue]
        goto J0x07;
    }
    GetProfileSettingValueInt(1020, Value);
    return Value == Mask;
    //return ReturnValue;    
}

function bool IsXBagsFound(TdStatsManager StatsManager)
{
    local int BagCounter;

    BagCounter = NumBagsFoundTotal();
    return BagCounter >= StatsManager.NumberOfBagsToFindForFirstAchievement;
    //return ReturnValue;    
}

function bool SetTTStretchCompletedUnderQualifyerTime(int StretchIndex)
{
    local int Mask, Value;

    // End:0x0D
    if(StretchIndex < 1)
    {
        return false;
    }
    Mask = 1 << (StretchIndex - 1);
    GetProfileSettingValueInt(1151, Value);
    Value = Value | Mask;
    return SetProfileSettingValueInt(1151, Value);
    //return ReturnValue;    
}

function bool IsTTStretchCompletedUnderQualifyerTime(int StretchIndex)
{
    local int Mask, Value;

    // End:0x0D
    if(StretchIndex < 1)
    {
        return false;
    }
    Mask = 1 << (StretchIndex - 1);
    // End:0x37
    if(!GetProfileSettingValueInt(1151, Value))
    {
    }
    return (Value & Mask) != 0;
    //return ReturnValue;    
}

function bool IsTTStretchUnlocked(int StretchIndex)
{
    local int Mask, Value;

    // End:0x1B
    if((StretchIndex < 1) || StretchIndex > 32)
    {
        return false;
    }
    Mask = 1 << (StretchIndex - 1);
    // End:0x45
    if(!GetProfileSettingValueInt(1150, Value))
    {
    }
    return (Value & Mask) != 0;
    //return ReturnValue;    
}

