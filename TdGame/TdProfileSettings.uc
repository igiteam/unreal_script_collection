    SetTTStretchTime(1230, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1231, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1232, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1233, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetProfileSettingValue(700, DefaultStringValue);
