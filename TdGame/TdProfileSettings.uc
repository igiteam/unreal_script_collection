    SetTTStretchTime(1216, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1217, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1218, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1219, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1220, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1221, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1222, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1223, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1224, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1225, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1226, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1227, 3599.990, IntermediateTimes, 0.0, 0.0);
