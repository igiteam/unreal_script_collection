    //return;    
}

function UnLockAllTTStretches()
{
    // End:0x19
    if(!SetProfileSettingValueInt(1150, -1))
    {
    }
    //return;    
}

function bool UnlockTTStretch(int StretchIndex)
{
    local int Mask, Value;

    // End:0x0D
    if(StretchIndex < 1)
    {
        return false;
    }
    Mask = 1 << (StretchIndex - 1);
    // End:0x37
    if(!GetProfileSettingValueInt(1150, Value))
    {
    }
    Value = Value | Mask;
    return SetProfileSettingValueInt(1150, Value);
    //return ReturnValue;    
}

function bool LockTTStretch(int StretchIndex)
{
    local int Mask, Value;

    // End:0x0D
    if(StretchIndex < 1)
    {
        return false;
    }
    Mask = 1 << (StretchIndex - 1);
    Mask = ~Mask;
    // End:0x44
    if(!GetProfileSettingValueInt(1150, Value))
    {
    }
    Value = Value & Mask;
    return SetProfileSettingValueInt(1150, Value);
    //return ReturnValue;    
}

function bool IsAllTTStretchesUnlocked()
{
    local int Idx, Mask, Value;
    local array<name> StretchIdMapping;

    StretchIdMapping = class'UIDataStore_TdTimeTrialData'.default.StretchIdMapping;
    Mask = 0;
    Idx = 0;
    J0x23:
    // End:0x93 [Loop If]
    if(Idx < StretchIdMapping.Length)
    {
        // End:0x89
        if((StretchIdMapping[Idx] != GetEnum(enum'ETTStretch', 0)) && InStr(string(StretchIdMapping[Idx]), "ETTS") != -1)
        {
            Mask = Mask | (1 << (Idx - 1));
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x23;
    }
    GetProfileSettingValueInt(1150, Value);
    return (Mask & Value) == Mask;
    //return ReturnValue;    
}

function bool IsAllTTStretchesCompletedUnderQualifierTime(int Difficulty)
{
    local int Mask, Value, Idx;

    Idx = 0;
    J0x07:
    // End:0x7F [Loop If]
    if(Idx < TTUnlockTTCompletedMap.Length)
    {
        // End:0x75
        if((Difficulty == TTUnlockTTCompletedMap[Idx].Difficulty) || Difficulty == 4)
        {
            Mask = Mask | (1 << (TTUnlockTTCompletedMap[Idx].CompletedTT - 1));
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    GetProfileSettingValueInt(1151, Value);
    return (Mask & Value) == Mask;
    //return ReturnValue;    
}

function OnTTStretchCompleted(int TTStretch, float TotalTime, array<float> IntermediateTimes, float AverageSpeed, float DistanceRun, int UnlockIdx)
{
    local float OldTime;
    local array<float> OldIntemediateTimes;
    local float OldAverageSpeed, OldDistanceRun;

    // End:0x64
    if(GetTTTimeForStretch(TTStretch, OldTime, OldIntemediateTimes, OldAverageSpeed, OldDistanceRun))
    {
        // End:0x61
        if(TotalTime < OldTime)
        {
            // End:0x5E
            if(SetTTTimeForStretch(TTStretch, TotalTime, IntermediateTimes, AverageSpeed, DistanceRun))
            {
                J0x5E:
            }
            // End:0x5E
            else
            {
            }
            J0x61:
        }
        // End:0x61
        else
        {
        }
        J0x64:
    }
    // End:0x64
    else
    {
    }
    MarkCompletedUnderQualifyerTime(TTStretch, TotalTime);
    // End:0x9C
    if(UnlockIdx != -1)
    {
        // End:0x9C
        if(UnlockTTStretch(UnlockIdx))
        {
            J0x9C:
        }
        // End:0x9C
        else
        {
        }
    }
    //return;    
}

function MarkCompletedUnderQualifyerTime(int CompletedTTStretch, float TotalTime)
{
    local int Idx;

    Idx = 0;
    J0x07:
    // End:0x92 [Loop If]
    if(Idx < TTUnlockTTCompletedMap.Length)
    {
        // End:0x88
        if(TTUnlockTTCompletedMap[Idx].CompletedTT == CompletedTTStretch)
        {
            // End:0x86
            if(TotalTime < TTUnlockTTCompletedMap[Idx].QualifierTime)
            {
                // End:0x81
                if(SetTTStretchCompletedUnderQualifyerTime(TTUnlockTTCompletedMap[Idx].CompletedTT))
                {
                    J0x81:
                }
                // End:0x81
                else
                {
                }
                return;
                J0x86:
            }
            // End:0x86
            else
            {
            }
            return;
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

function name CanUnlockTTStretch(int CompletedTTStretch, float TotalTime)
{
    local int Idx;

    Idx = 0;
    J0x07:
    // End:0xB5 [Loop If]
    if(Idx < TTUnlockTTCompletedMap.Length)
    {
        // End:0xAB
        if(TTUnlockTTCompletedMap[Idx].CompletedTT == CompletedTTStretch)
        {
            // End:0xA1
            if(TotalTime < TTUnlockTTCompletedMap[Idx].QualifierTime)
            {
                // End:0x9E
                if(TTUnlockTTCompletedMap[Idx].UnlocksTT != 0)
                {
                    return GetEnum(enum'ETTStretch', TTUnlockTTCompletedMap[Idx].UnlocksTT);
                }
                J0xA1:
            }
            // End:0xA1
            else
            {
            }
            return 'None';
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    return 'None';
    //return ReturnValue;    
}

function OnLevelCompleted(int LevelIndex)
{
    // End:0x6D
    if((LevelIndex >= 0) && LevelIndex <= 10)
    {
        // End:0x3B
        if(LevelIndex <= 10)
        {
            // End:0x3B
            if(UnlockLevel(LevelIndex))
            {
                J0x3B:
            }
            // End:0x3B
            else
            {
            }
        }
        // End:0x6A
        if(TTUnlockLevelCompletedMap[LevelIndex] != 0)
        {
            // End:0x67
            if(UnlockTTStretch(TTUnlockLevelCompletedMap[LevelIndex]))
            {
                J0x67:
            }
            // End:0x67
            else
            {
            }
            J0x6A:
        }
        // End:0x6A
        else
        {
        }
        J0x6D:
    }
    // End:0x6D
    else
    {
    }
    //return;    
}

