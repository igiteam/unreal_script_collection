function StoreKeys(optional PlayerInput PInput)
{
    local array<KeyBind> Bindings;

    PInput = none;
    // End:0x28
    if(PInput == none)
    {
        Bindings = class'PlayerInput'.default.Bindings;
    }
    // End:0x3D
    else
    {
        Bindings = PInput.Bindings;
    }
    StoreKeyBindings(Bindings);
    //return;    
}

function StoreKeyBindings(array<KeyBind> Bindings)
{
    local int BindingIdx, CommandIdx, BindingKeyIdx, NumKeyBinds;
    local name KeyBinds[4];

    CommandIdx = 0;
    J0x07:
    // End:0xF6 [Loop If]
    if(CommandIdx < DigitalButtonActionsToCommandMapping.Length)
    {
        NumKeyBinds = 0;
        BindingKeyIdx = 0;
        J0x25:
        // End:0x50 [Loop If]
        if(BindingKeyIdx < 4)
        {
            KeyBinds[BindingKeyIdx] = 'None';
            ++ BindingKeyIdx;
            // [Loop Continue]
            goto J0x25;
        }
        BindingIdx = 0;
        J0x57:
        // End:0xD2 [Loop If]
        if(BindingIdx < Bindings.Length)
        {
            // End:0xB9
            if(InStr(Bindings[BindingIdx].Command, DigitalButtonActionsToCommandMapping[CommandIdx]) != -1)
            {
                KeyBinds[++ NumKeyBinds] = Bindings[BindingIdx].Name;
            }
            // End:0xC8
            if(NumKeyBinds >= 4)
            {
                // [Explicit Break]
                goto J0xD2;
            }
            ++ BindingIdx;
            J0xD2:
            // [Loop Continue]
            goto J0x57;
        }
        SetKeyBindingUsingCommand(DigitalButtonActionsToCommandMapping[CommandIdx], KeyBinds);
        ++ CommandIdx;
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

function int GetProfileIDForDBA(TdProfileSettings.EDigitalButtonActions KeyAction)
{
    local int ProfileId;

    ProfileId = 501 + KeyAction;
    // DebugMode:False
    assert(ProfileId <= 549);
    return ProfileId;
    //return ReturnValue;    
}

function int GetDBAFromCommand(string Command)
{
    local int Result, CommandIdx;

    Result = -1;
    CommandIdx = 0;
    J0x12:
    // End:0x4F [Loop If]
    if(CommandIdx < DigitalButtonActionsToCommandMapping.Length)
    {
        // End:0x45
        if(DigitalButtonActionsToCommandMapping[CommandIdx] == Command)
        {
            Result = CommandIdx;
            // [Explicit Break]
            goto J0x4F;
        }
        ++ CommandIdx;
        J0x4F:
        // [Loop Continue]
        goto J0x12;
    }
    return Result;
    //return ReturnValue;    
}

function GetKeyNamesFromDBA(TdProfileSettings.EDigitalButtonActions DBACommand, out array<name> KeyNames, PlayerInput PInput)
{
    local string GBACommand;
    local int BindingIdx;
    local array<KeyBind> Bindings;

    GBACommand = DigitalButtonActionsToCommandMapping[DBACommand];
    // End:0x36
    if(PInput != none)
    {
        Bindings = PInput.Bindings;
    }
    // End:0x4B
    else
    {
        Bindings = class'PlayerInput'.default.Bindings;
    }
    BindingIdx = 0;
    J0x52:
    // End:0xB7 [Loop If]
    if(BindingIdx < Bindings.Length)
    {
        // End:0xAD
        if(InStr(Bindings[BindingIdx].Command, GBACommand) != -1)
        {
            KeyNames[KeyNames.Length] = Bindings[BindingIdx].Name;
        }
        ++ BindingIdx;
        // [Loop Continue]
        goto J0x52;
    }
    //return;    
}

function SetKeyBindingUsingCommand(string KeyCommand, name KeyBinds[4])
{
    local int KeyAction;

    KeyAction = GetDBAFromCommand(KeyCommand);
    // End:0x3A
    if(KeyAction != -1)
    {
        SetKeyBinding(byte(KeyAction), KeyBinds);
    }
    //return;    
}

function name FindKeyName(TdProfileSettings.ETDBindableKeys KeyEnum)
{
    local name Result;

    // End:0x28
    if(KeyEnum < KeyMappingArray.Length)
    {
        Result = KeyMappingArray[KeyEnum];
    }
    // End:0x37
    else
    {
        Result = 'None';
    }
    return Result;
    //return ReturnValue;    
}

function int FindKeyEnum(name KeyName)
{
    local int KeyIdx, Result;

    Result = -1;
    KeyIdx = 0;
    J0x12:
    // End:0x4F [Loop If]
    if(KeyIdx < KeyMappingArray.Length)
    {
        // End:0x45
        if(KeyMappingArray[KeyIdx] == KeyName)
        {
            Result = KeyIdx;
            // [Explicit Break]
            goto J0x4F;
        }
        ++ KeyIdx;
        J0x4F:
        // [Loop Continue]
        goto J0x12;
    }
    return Result;
    //return ReturnValue;    
}

function SetKeyBinding(TdProfileSettings.EDigitalButtonActions KeyAction, name KeyBinds[4])
{
    local int KeyBindingValue, KeyEnumValue, KeyBindIdx;

    KeyBindIdx = 0;
    J0x07:
    // End:0x7D [Loop If]
    if(KeyBindIdx < 4)
    {
        // End:0x73
        if(KeyBinds[KeyBindIdx] != 'None')
        {
            KeyEnumValue = FindKeyEnum(KeyBinds[KeyBindIdx]);
            // End:0x73
            if(KeyEnumValue != -1)
            {
                KeyBindingValue = KeyBindingValue | (KeyEnumValue << (KeyBindIdx * 8));
            }
        }
        ++ KeyBindIdx;
        // [Loop Continue]
        goto J0x07;
    }
    SetProfileSettingValueInt(GetProfileIDForDBA(KeyAction), KeyBindingValue);
    //return;    
}

function UnbindKey(PlayerInput PInput, name BindName)
{
    local int BindingIdx;

    BindingIdx = 0;
    J0x07:
    // End:0x7B [Loop If]
    if(BindingIdx < PInput.Bindings.Length)
    {
        // End:0x71
        if(PInput.Bindings[BindingIdx].Name == BindName)
        {
            PInput.Bindings.Remove(BindingIdx, 1);
            PInput.SaveConfig();
            // [Explicit Break]
            goto J0x7B;
        }
        ++ BindingIdx;
        J0x7B:
        // [Loop Continue]
        goto J0x07;
    }
    //return;    
}

function ApplyAllKeyBindings(PlayerInput PInput)
{
    ApplyKeyBindings(PInput);
    ApplyGamepadBindings(PInput);
    //return;    
}

function ApplyKeyBindings(PlayerInput PInput)
{
    local int BindingIdx;

    RemoveDBABindings(PInput);
    BindingIdx = 0;
    J0x16:
    // End:0x42 [Loop If]
    if(BindingIdx < 25)
    {
        ApplyKeyBinding(PInput, byte(BindingIdx));
        ++ BindingIdx;
        // [Loop Continue]
        goto J0x16;
    }
    //return;    
}

function ApplyGamepadBindings(PlayerInput PInput, optional array<KeyBind> PresetMappings)
{
    local array<KeyBind> GamepadKeyMappings;
    local TdProfileSettings.EControllerConfigValues GamepadLayout;
    local int Value, BindIndex;

    // End:0x25
    if(GetProfileSettingValueId(401, Value))
    {
        GamepadLayout = byte(Value);
    }
    // End:0x3F
    if(PresetMappings.Length != 0)
    {
        GamepadKeyMappings = PresetMappings;
    }
    // End:0x69
    else
    {
        GamepadKeyMappings = GetGamepadBinds();
        GamepadKeyMappings = GetGamepadLayoutBinds(GamepadKeyMappings, GamepadLayout);
    }
    BindIndex = 0;
    J0x70:
    // End:0xCA [Loop If]
    if(BindIndex < GamepadKeyMappings.Length)
    {
        PInput.SetBind(GamepadKeyMappings[BindIndex].Name, GamepadKeyMappings[BindIndex].Command);
        ++ BindIndex;
        // [Loop Continue]
        goto J0x70;
    }
    TdPlayerInput(PInput).InvertGamepadYAxis((GamepadLayout == 1) || GamepadLayout == 3);
    //return;    
}

function array<KeyBind> GetGamepadBinds()
{
    local array<KeyBind> Bindings, GamepadBinds;
    local int BindIndex, GamepadBindIndex;
    local name KeyName;
    local string KeyCommand;
    local KeyBind CurrentKeyBind;

    Bindings = class'PlayerInput'.default.Bindings;
    BindIndex = 0;
    J0x1C:
    // End:0x100 [Loop If]
    if(BindIndex < Bindings.Length)
    {
        KeyName = Bindings[BindIndex].Name;
        KeyCommand = Bindings[BindIndex].Command;
        // End:0xF6
        if(InStr(string(KeyName), "XboxTypeS_") != -1)
        {
            GamepadBindIndex = 0;
            J0x8B:
            // End:0xF6 [Loop If]
            if(GamepadBindIndex < GamepadMappingArray.Length)
            {
                // End:0xEC
                if(KeyName == GamepadMappingArray[GamepadBindIndex])
                {
                    CurrentKeyBind.Name = KeyName;
                    CurrentKeyBind.Command = KeyCommand;
                    GamepadBinds.AddItem(CurrentKeyBind);
                    // [Explicit Break]
                    goto J0xF6;
                }
                ++ GamepadBindIndex;
                J0xF6:
                // [Loop Continue]
                goto J0x8B;
            }
        }
        ++ BindIndex;
        // [Loop Continue]
        goto J0x1C;
    }
    return GamepadBinds;
    //return ReturnValue;    
}

function array<KeyBind> GetGamepadLayoutBinds(array<KeyBind> GamepadBinds, TdProfileSettings.EControllerConfigValues Layout)
{
    local array<KeyBind> NewBinds;

    NewBinds = GamepadBinds;
    switch(Layout)
    {
        // End:0x2A
        case 1:
            InvertControllerConf_Sticks(NewBinds);
            // End:0x6A
            break;
        // End:0x41
        case 2:
            InvertControllerConf_Buttons(NewBinds);
            // End:0x6A
            break;
        // End:0x67
        case 3:
            InvertControllerConf_Sticks(NewBinds);
            InvertControllerConf_Buttons(NewBinds);
            // End:0x6A
            break;
        // End:0xFFFF
        default:
            return NewBinds;
    }
    //return ReturnValue;    
}

protected function InvertControllerConf_Sticks(out array<KeyBind> Binds)
{
    local string Keys[4];

    Keys[0] = "XboxTypeS_LeftX";
    Keys[1] = "XboxTypeS_LeftY";
    Keys[2] = "XboxTypeS_RightX";
    Keys[3] = "XboxTypeS_RightY";
    InvertGamepadBinds(Keys, Binds);
    //return;    
}

protected function InvertControllerConf_Buttons(out array<KeyBind> Binds)
{
    local string Keys[4];

    Keys[0] = "XboxTypeS_LeftShoulder";
    Keys[1] = "XboxTypeS_LeftTrigger";
    Keys[2] = "XboxTypeS_RightShoulder";
    Keys[3] = "XboxTypeS_RightTrigger";
    InvertGamepadBinds(Keys, Binds);
    //return;    
}

private final function InvertGamepadBinds(string KeysToInvert[4], out array<KeyBind> Binds)
{
    local int BindIndex, KeyIndex, BindingIndices;
    local string Commands[4];

    KeyIndex = 0;
    J0x07:
    // End:0x82 [Loop If]
    if(KeyIndex < 4)
    {
        BindIndex = 0;
        J0x1A:
        // End:0x78 [Loop If]
        if(BindIndex < Binds.Length)
        {
            // End:0x6E
            if(InStr(string(Binds[BindIndex].Name), KeysToInvert[KeyIndex]) != -1)
            {
                BindingIndices[KeyIndex] = BindIndex;
                // [Explicit Break]
                goto J0x78;
            }
            ++ BindIndex;
            J0x78:
            // [Loop Continue]
            goto J0x1A;
        }
        ++ KeyIndex;
        // [Loop Continue]
        goto J0x07;
    }
    Commands[2] = Binds[BindingIndices[0]].Command;
    Commands[3] = Binds[BindingIndices[1]].Command;
    Commands[0] = Binds[BindingIndices[2]].Command;
    Commands[1] = Binds[BindingIndices[3]].Command;
    KeyIndex = 0;
    J0x10D:
    // End:0x14B [Loop If]
    if(KeyIndex < 4)
    {
        Binds[BindingIndices[KeyIndex]].Command = Commands[KeyIndex];
        ++ KeyIndex;
        // [Loop Continue]
        goto J0x10D;
    }
    //return;    
}

function ApplyControllerBindings(PlayerInput PInput)
{
    local array<KeyBind> Bindings;
    local int BindingIdx, ControllerBindingIdx;
    local name KeyName, ControllerKeyName;
    local string KeyCommand;

    Bindings = class'PlayerInput'.default.Bindings;
    BindingIdx = 0;
    J0x1C:
    // End:0xF0 [Loop If]
    if(BindingIdx < Bindings.Length)
    {
        KeyName = Bindings[BindingIdx].Name;
        KeyCommand = Bindings[BindingIdx].Command;
        // End:0xE6
        if(InStr(string(KeyName), "XboxTypeS_") != -1)
        {
            ControllerBindingIdx = 0;
            J0x8B:
            // End:0xE6 [Loop If]
            if(ControllerBindingIdx < GamepadMappingArray.Length)
            {
                ControllerKeyName = GamepadMappingArray[ControllerBindingIdx];
                // End:0xDC
                if(KeyName == ControllerKeyName)
                {
                    PInput.SetBind(KeyName, KeyCommand);
                    // [Explicit Break]
                    goto J0xE6;
                }
                ++ ControllerBindingIdx;
                J0xE6:
                // [Loop Continue]
                goto J0x8B;
            }
        }
        ++ BindingIdx;
        // [Loop Continue]
        goto J0x1C;
    }
    //return;    
}

function ApplyKeyBinding(PlayerInput PInput, TdProfileSettings.EDigitalButtonActions Action)
{
    local int Value, KeyBindingValue, KeyBindIdx;
    local name KeyName;
    local string KeyCommand;

    // End:0xCF
    if(GetProfileSettingValueInt(GetProfileIDForDBA(Action), Value))
    {
        KeyBindIdx = 0;
        J0x28:
        // End:0xCF [Loop If]
        if(KeyBindIdx < 4)
        {
            KeyBindingValue = 255 & (Value >> (KeyBindIdx * 8));
            KeyName = FindKeyName(byte(KeyBindingValue));
            KeyCommand = DigitalButtonActionsToCommandMapping[Action];
            // End:0xC5
            if(((KeyBindingValue != 0) && KeyName != 'None') && Len(KeyCommand) > 0)
            {
                PInput.SetBind(KeyName, KeyCommand);
            }
            ++ KeyBindIdx;
            // [Loop Continue]
            goto J0x28;
        }
    }
    //return;    
}

function RemoveDBABindings(PlayerInput PInput)
{
    local int BindingIdx, DBAIdx;

    BindingIdx = PInput.Bindings.Length - 1;
    J0x19:
    // End:0xA0 [Loop If]
    if(BindingIdx >= 0)
    {
        DBAIdx = 0;
        J0x2B:
        // End:0x96 [Loop If]
        if(DBAIdx < DigitalButtonActionsToCommandMapping.Length)
        {
            // End:0x8C
            if(InStr(PInput.Bindings[BindingIdx].Command, DigitalButtonActionsToCommandMapping[DBAIdx]) != -1)
            {
                PInput.Bindings.Remove(BindingIdx, 1);
                // [Explicit Break]
                goto J0x96;
            }
            ++ DBAIdx;
            J0x96:
            // [Loop Continue]
            goto J0x2B;
        }
        -- BindingIdx;
        // [Loop Continue]
        goto J0x19;
    }
    //return;    
}

function bool IsKeyBoundToCommand(PlayerInput PInput, string Command, string Key)
{
    local bool bResult;
    local int BindingIdx;

    // End:0xA1
    if(PInput != none)
    {
        BindingIdx = 0;
        J0x12:
        // End:0xA1 [Loop If]
        if(BindingIdx < PInput.Bindings.Length)
        {
            // End:0x97
            if((string(PInput.Bindings[BindingIdx].Name) == Key) && InStr(PInput.Bindings[BindingIdx].Command, Command) != -1)
            {
                bResult = true;
                // [Explicit Break]
                goto J0xA1;
            }
            ++ BindingIdx;
            J0xA1:
            // [Loop Continue]
            goto J0x12;
        }
    }
    return bResult;
    //return ReturnValue;    
}

function bool SetLastSavedMap(string MapName)
{
    return SetProfileSettingValue(900, MapName);
    //return ReturnValue;    
}

function bool SetLastSavedCheckpoint(string CheckpointName)
{
    return SetProfileSettingValue(901, CheckpointName);
    //return ReturnValue;    
}

function bool GetLastSavedMap(out string MapName)
{
    return GetProfileSettingValue(900, MapName);
    //return ReturnValue;    
}

function bool GetLastSavedCheckpoint(out string CheckpointName)
{
    return GetProfileSettingValue(901, CheckpointName);
    //return ReturnValue;    
}

event bool IsProfileSettingEnabled(name FieldName, int Index)
{
    // End:0x40
    if((InStr(string(FieldName), "GameDifficulty") != -1) && Index == 2)
    {
        return IsLevelUnlocked(10);
    }
    return true;
    //return ReturnValue;    
}

