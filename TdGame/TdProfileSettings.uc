    SetTTStretchTime(1200, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1201, 3599.990, IntermediateTimes, 0.0, 0.0);
    SetTTStretchTime(1202, 3599.990, IntermediateTimes, 0.0, 0.0);
