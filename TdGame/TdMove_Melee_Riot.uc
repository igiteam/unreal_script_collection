class TdMove_Melee_Riot extends TdMove_BotMelee
    config(AIMeleeAttacks);

var private bool bHit;
var() config MeleeAttackProperties ShieldPushProperties;

simulated function TriggerMove()
{
    bHit = false;
    PawnOwner.UseRootMotion(true);
    PlayMoveAnim(0, 'MeleeStart', 1.0, 0.10, 0.0, true, false);
    AttackProperties = ShieldPushProperties;
    //return;    
}

simulated function TriggerHit()
{
    MeleeStage = 1;
    PawnOwner.UseRootMotion(true);
    PlayMoveAnim(0, 'MeleeEnd', 1.0, 0.20, 0.10, true, false);
    //return;    
}

simulated function TriggerMiss()
{
    PawnOwner.SetMove(1);
    //return;    
}

defaultproperties
