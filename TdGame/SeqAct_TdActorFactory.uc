native function EveryoneDied();

event OnSpawn(TdBotPawn NewBot)
{
    NewBot.SetDeathCallback(OnDeath);
    NewBot.myController.SetCoverGroup(InitialCoverGroup);
    //return;    
}

function Reset()
{
    DeathCount = 0;
    SpawnedCount = 0;
    RemainingDelay = 0.0;
    LastSpawnIdx = 0;
    bIsSpawning = false;
    bEnabled = true;
    super(SequenceOp).Reset();
    //return;    
}

function OnDeath(TdBotPawn Victim)
{
    ++ DeathCount;
    // End:0x31
    if((SpawnedCount >= SpawnCount) && DeathCount >= SpawnedCount)
    {
        EveryoneDied();
    }
    //return;    
}

