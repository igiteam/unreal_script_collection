class TdMove_FallingBot extends TdMove_AISpecialMove
    native
    config(PawnMovement);

var bool bPrepareLanding;

simulated function StartMove()
{
    bPrepareLanding = false;
    BotOwner.IgnoreMoveInput(true);
    super(TdPhysicsMove).StartMove();
    //return;    
}

simulated function StopMove()
{
    BotOwner.IgnoreMoveInput(false);
    super(TdPhysicsMove).StopMove();
    //return;    
}

simulated event CloseToGround()
{
    bPrepareLanding = true;
    PlayMoveAnim(2, 'JumpLandStart', 1.0, 0.10, -1.0);
    //return;    
}

defaultproperties
{
    bDisableCollision=false
}