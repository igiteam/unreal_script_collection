class TdMPTeamDMGame extends TdMPTeamGame
    config(Game)
    hidecategories(Navigation,Movement,Collision);

function EndGame(PlayerReplicationInfo Winner, string Reason)
{
    super(TdMPGame).EndGame(Winner, Reason);
    //return;    
}

function PlayerStart ChoosePlayerStart(Controller Player, optional byte InTeam)
{
    local PlayerStart BestStart;
    local float BestRating, NewRating;
    local int Idx;

    BestRating = -1.0;
    Idx = 0;
    J0x13:
    // End:0x7D [Loop If]
    if(Idx < StartPoints.Length)
    {
        NewRating = RatePlayerStart(StartPoints[Idx], InTeam, Player);
        // End:0x73
        if(NewRating > BestRating)
        {
            BestRating = NewRating;
            BestStart = StartPoints[Idx];
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x13;
    }
    return BestStart;
    //return ReturnValue;    
}

function float RatePlayerStart(PlayerStart P, byte Team, Controller Player)
{
    local float Score, Distance;
    local TdTeamPlayerStart Tps;
    local TdPlayerController PlayerController;

    Score = 0.0;
    // End:0x9D
    if(bInitialSpawn)
    {
        Tps = TdTeamPlayerStart(P);
        // End:0x9A
        if(Tps != none)
        {
            // End:0x9A
            if((Tps.RobberSpawn && Team == 0) || Tps.CopSpawn && Team == 1)
            {
                return float(((P.bPrimaryStart) ? 1000 : 20));
            }
        }
    }
    // End:0x168
    else
    {
        // End:0x167
        foreach WorldInfo.AllControllers(class'TdPlayerController', PlayerController)
        {
            // End:0x166
            if(PlayerController.Pawn != none)
            {
                Distance = FMax(1000.0, VSize(PlayerController.Pawn.Location - P.Location));
                // End:0x146
                if(PlayerController.PlayerReplicationInfo.Team.TeamIndex == Team)
                {
                    Score += Distance;
                    // End:0x166
                    continue;
                }
                Score -= (float(1) + ((float(1000) - Distance) * float(2)));
            }            
        }        
    }
    return Score;
    //return ReturnValue;    
}

function ScoreKill(Controller Killer, Controller Other)
{
    // End:0xB5
    if((Killer == Other) || Killer == none)
    {
        // End:0xB2
        if((Other != none) && Other.PlayerReplicationInfo != none)
        {
            Other.PlayerReplicationInfo.Score -= float(1);
            Other.PlayerReplicationInfo.Team.Score -= float(1);
            Other.PlayerReplicationInfo.SetNetUpdateTime(WorldInfo.TimeSeconds - float(1));
        }
    }
    // End:0x159
    else
    {
        // End:0x159
        if(Killer.PlayerReplicationInfo != none)
        {
            Killer.PlayerReplicationInfo.Score += float(1);
            Killer.PlayerReplicationInfo.SetNetUpdateTime(WorldInfo.TimeSeconds - float(1));
            Killer.PlayerReplicationInfo.Team.Score += float(1);
            ++ Killer.PlayerReplicationInfo.Kills;
        }
    }
    CheckScore(Killer.PlayerReplicationInfo);
    //return;    
}

function bool CheckScore(PlayerReplicationInfo Scorer)
{
    // End:0x57
    if(Scorer != none)
    {
        // End:0x57
        if((GoalScore > 0) && Scorer.Team.Score >= float(GoalScore))
        {
            EndGame(Scorer, "fraglimit");
        }
    }
    return true;
    //return ReturnValue;    
}

