event OnBecomeRelevant()
{
    // End:0x0D
    if(AnimSeq == none)
    {
        return;
    }
    // End:0x10D
    if(bResetOnBecomeRelevant)
    {
        // End:0xD4
        if(bSynchronize && SynchGroupName != 'None')
        {
            // End:0xB0
            if((SkelComponent.Owner != none) && TdPawn(SkelComponent.Owner).OverrideSynchPosOffset != -1.0)
            {
                SetPosition(TdPawn(SkelComponent.Owner).OverrideSynchPosOffset * AnimSeq.SequenceLength, false);
            }
            // End:0xD1
            else
            {
                SetPosition(SynchPosOffset * AnimSeq.SequenceLength, false);
            }
        }
        // End:0x10D
        else
        {
            SetPosition(((Rate > 0.0) ? NormalizedStartPosition * (GetAnimPlaybackLength()) : Abs(GetAnimPlaybackLength())), false);
        }
    }
    bPlaying = true;
    //return;    
}

simulated function ResetNodeStates()
{
    AnimationType = default.AnimationType;
    bDeltaCameraAnimation = default.bDeltaCameraAnimation;
    ScalePlayRateBySpeed = default.ScalePlayRateBySpeed;
    ScalePlayRateType = default.ScalePlayRateType;
    RateMin = default.RateMin;
    RateMax = default.RateMax;
    BaseSpeed = default.BaseSpeed;
    bResetOnBecomeRelevant = default.bResetOnBecomeRelevant;
    //return;    
}

event OnCeaseRelevant()
{
    // End:0x35
    if(bCauseActorCeaseRelevant)
    {
        TdPawn(SkelComponent.Owner).OnCeaseRelevantRootMotion(self);
        bCauseActorCeaseRelevant = false;
    }
    // End:0x69
    if(bHasLockedAnimation)
    {
        TdPawn(SkelComponent.Owner).PopAnimationLock();
        bHasLockedAnimation = false;
    }
    //return;    
}

defaultproperties
{
    bResetOnBecomeRelevant=true
    bUpdateSequenceOnAnimSetsUpdated=true
    BaseSpeed=350.0
    ScaleByValue=1.0
    RateMax=2.0
    NotifyWeightThreshold=0.010
}