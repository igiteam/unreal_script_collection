class TdAnimNodeAimOffset extends AnimNodeAimOffset
    native
    hidecategories(Object,Object,Object);

var() bool bInterpolateHorizontalAiming;
var() bool bAimSourceIsLegRotation;
var() bool bManualAim;
var() float HorizontalInterpolationSpeed;
var transient Vector2D WantedAiming;
var native float DeltaTime;
var native float InterpolationValue;

event OnBecameRelevant()
{
    // End:0x40
    if(bInterpolateHorizontalAiming)
    {
        Aim.X = 0.0;
        WantedAiming.X = 0.0;
        InterpolationValue = 0.0;
    }
    //return;    
}

event EditorProfileUpdated(name ProfileName)
{
    SetActiveProfileByName(ProfileName);
    //return;    
}

defaultproperties
{
    HorizontalInterpolationSpeed=0.30
}