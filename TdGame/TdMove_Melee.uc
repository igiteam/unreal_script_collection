    bUseCameraCollision=true
    AimMode=MAM_TwoHanded
    MinLookConstraint=(Pitch=-10000,Yaw=-32768,Roll=-32768)
    MaxLookConstraint=(Pitch=10000,Yaw=32768,Roll=32768)
}