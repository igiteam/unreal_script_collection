class TdMove_Melee extends TdMove_MeleeBase
    config(PawnMovement);

enum EMoveMeleeType
{
    MT_Normal,
    MT_AtBlockingEnemy,
    MT_AtBentOverEnemy,
    MT_AtComboFinisher,
    MT_MAX
};

var private bool bLeft;
var private bool bWindowOpen;
var private int ComboCounter;
var private float ComboTimer;
var private int ComboQueuedActions;
var private TdMove_Melee.EMoveMeleeType MeleeType;
var config float SoccerKickDamage;
var float PreventTime;
var config float BlendInMissed;
var config float BlendOutMissed;

function bool CanDoMove()
{
    // End:0x0D
    if(!super.CanDoMove())
    {
        return false;
    }
    // End:0x32
    if(PreventTime > PawnOwner.WorldInfo.TimeSeconds)
    {
        return false;
    }
    // End:0x4E
    if(PawnOwner.AgainstWallState != 0)
    {
        return false;
    }
    // End:0x81
    if((PawnOwner.Weapon != none) && TdWeapon_Heavy(PawnOwner.Weapon) != none)
    {
        return false;
    }
    return true;
    //return ReturnValue;    
}

simulated function StartMove()
{
    local float LegsBodyYawDelta;

    super.StartMove();
    Reset();
    LegsBodyYawDelta = float(NormalizeRotAxis(PawnOwner.LegRotation - PawnOwner.Rotation.Yaw));
    // End:0x82
    if((MeleeState == 1) && Abs(LegsBodyYawDelta) > float(4000))
    {
        bLeft = LegsBodyYawDelta > float(0);
    }
    // End:0x91
    else
    {
        bLeft = !bLeft;
    }
    // End:0xBC
    if(PawnOwner.Weapon != none)
    {
        PawnOwner.SetWeaponAnimState(1);
    }
    TriggerMove();
    //return;    
}

simulated function HandleMoveAction(TdPawn.EMovementAction Action)
{
    // End:0x1F
    if((Action != 3) || !bWindowOpen)
    {
        return;
    }
    // End:0x3B
    if(ComboCounter < 2)
    {
        ComboCounter += 1;
        ComboQueuedActions += 1;
    }
    //return;    
}

simulated function OpenWindow(float delay)
{
    SetTimer(delay);
    bWindowOpen = true;
    //return;    
}

simulated function CloseWindow()
{
    ClearTimer();
    bWindowOpen = false;
    //return;    
}

simulated function OnTimer()
{
    CloseWindow();
    //return;    
}

simulated function Reset()
{
    ComboCounter = 0;
    ComboQueuedActions = 0;
    CloseWindow();
    //return;    
}

simulated function StopMove()
{
    super.StopMove();
    Reset();
    PawnOwner.StopCustomAnim(4, 0.30);
    PawnOwner.StopCustomAnim(2, 0.30);
    //return;    
}

simulated function OnCustomAnimEnd(AnimNodeSequence SeqNode, float PlayedTime, float ExcessTime)
{
    switch(MeleeState)
    {
        // End:0x0D
        case 1:
        // End:0x4C
        case 2:
            // End:0x49
            if(PawnOwner.IsLocallyControlled())
            {
                // End:0x3F
                if(TestHit())
                {
                    TriggerHit();
                }
                // End:0x49
                else
                {
                    TriggerMiss();
                }
            }
            // End:0xB3
            break;
        // End:0x51
        case 3:
        // End:0x56
        case 4:
        // End:0x5B
        case 5:
        // End:0xB0
        case 6:
            // End:0x95
            if(ComboQueuedActions > 0)
            {
                StartMove();
                ComboQueuedActions -= 1;
                bLeft = !bLeft;
                TriggerMove();
            }
            // End:0xAD
            else
            {
                PawnOwner.SetMove(1);
            }
            // End:0xB3
            break;
        // End:0xFFFF
        default:
            //return;
    }    
}

simulated function TriggerMove()
{
    local TdMove_StumbleBase StumbleMove;

    super.TriggerMove();
    OpenWindow(0.330);
    bTargeting = true;
    PawnOwner.StopCustomAnim(6, 0.050);
    PawnOwner.StopCustomAnim(7, 0.10);
    PawnOwner.SetAnimationMovementState(1);
    // End:0x92
    if(TargetPawn != none)
    {
        StumbleMove = TdMove_StumbleBase(TargetPawn.Moves[35]);
    }
    // End:0x19B
    if((((TargetPawn != none) && TargetPawn.MovementState == 35) && TargetPawn.IsA('TdBotPawn_Assault') || TargetPawn.IsA('TdBotPawn_PatrolCop')) && (StumbleMove.StumbleState == 11) || StumbleMove.StumbleState == 7)
    {
        ResetCameraLook(0.40);
        PlayMoveAnim(2, 'MeleeBentOverStart', 1.0, 0.10, -1.0);
        HitDetectionBone = 'RightFoot';
        bLeft = false;
        MeleeType = 2;
        // End:0x198
        if(TdBotPawn(TargetPawn) != none)
        {
            TdBotPawn(TargetPawn).ActiveDeathAnimType = 8;
        }
    }
    // End:0x2B6
    else
    {
        // End:0x221
        if((ComboQueuedActions == 0) && ComboCounter == 2)
        {
            MeleeType = 3;
            PlayMoveAnim(4, 'MeleeStartShove', 1.0, 0.10, -1.0);
            PawnOwner.SetIgnoreMoveInput(1.0);
            // End:0x21E
            if(TdBotPawn(TargetPawn) != none)
            {
                TdBotPawn(TargetPawn).ActiveDeathAnimType = 1;
            }
        }
        // End:0x293
        else
        {
            MeleeType = 0;
            PlayMoveAnim(4, ((bLeft) ? 'MeleeStartLeft' : 'MeleeStartRight'), 1.50, 0.10, -1.0);
            // End:0x293
            if(TdBotPawn(TargetPawn) != none)
            {
                TdBotPawn(TargetPawn).ActiveDeathAnimType = ((bLeft) ? 8 : 6);
            }
        }
        HitDetectionBone = ((bLeft) ? 'LeftHand' : 'RightHand');
    }
    UpdateTargetPawn();
    //return;    
}

simulated function TriggerMiss()
{
    bTargeting = false;
    super.TriggerMiss();
    PawnOwner.SetAnimationMovementState(1);
    switch(MeleeType)
    {
        // End:0x7D
        case 0:
            PlayMoveAnim(4, ((bLeft) ? 'MeleeMissedLeft' : 'MeleeMissedRight'), 1.50, BlendInMissed, ((ComboQueuedActions > 0) ? 0.60 : BlendOutMissed));
            // End:0x12E
            break;
        // End:0xCD
        case 1:
            PlayMoveAnim(4, ((bLeft) ? 'MeleeMissed2Left' : 'MeleeMissed2Right'), 1.50, BlendInMissed, ((ComboQueuedActions > 0) ? 0.60 : BlendOutMissed));
            // End:0x12E
            break;
        // End:0xF7
        case 2:
            PlayMoveAnim(2, 'MeleeBentOverFinish', 1.0, 0.10, 0.10);
            // End:0x12E
            break;
        // End:0x12B
        case 3:
            PlayMoveAnim(4, 'MeleeHitShove', 1.0, 0.0, 0.10);
            Reset();
            // End:0x12E
            break;
        // End:0xFFFF
        default:
            MeleeState = ((MeleeState == 1) ? 5 : 6);
            //return;
    }    
}

simulated function TriggerHit()
{
    bTargeting = false;
    super.TriggerHit();
    PawnOwner.SetAnimationMovementState(1);
    switch(MeleeType)
    {
        // End:0x7D
        case 0:
            PlayMoveAnim(4, ((bLeft) ? 'MeleeHitLeft' : 'MeleeHitRight'), 1.50, 0.20, ((ComboQueuedActions > 0) ? 0.30 : 0.10));
            // End:0x12E
            break;
        // End:0xCD
        case 1:
            PlayMoveAnim(4, ((bLeft) ? 'MeleeHit2Left' : 'MeleeHit2Right'), 1.50, 0.20, ((ComboQueuedActions > 0) ? 0.30 : 0.10));
            // End:0x12E
            break;
        // End:0xF7
        case 2:
            PlayMoveAnim(2, 'MeleeBentOverFinish', 1.0, 0.10, 0.150);
            // End:0x12E
            break;
        // End:0x12B
        case 3:
            PlayMoveAnim(4, 'MeleeHitShove', 1.0, 0.0, 0.10);
            Reset();
            // End:0x12E
            break;
        // End:0xFFFF
        default:
            MeleeState = ((MeleeState == 1) ? 3 : 4);
            //return;
    }    
}

simulated function class<DamageType> GetDamageType()
{
    return ((MeleeType == 2) ? class'TdDmgType_MeleeSoccerKick' : ((bLeft) ? class'TdDmgType_MeleeLeft' : class'TdDmgType_MeleeRight'));
    //return ReturnValue;    
}

function bool TestHit()
{
    local TraceHitInfo Hit;
    local float Damage;
    local Vector ToTarget, ToTarget2d, HitLocation, ImpactMomentum;
    local class<TdDamageType> DamageType;

    // End:0x0D
    if(TargetPawn == none)
    {
        return false;
    }
    ToTarget = TargetPawn.Location - PawnOwner.Location;
    ToTarget2d = ToTarget;
    ToTarget2d.Z = 0.0;
    // End:0x26B
    if(((Normal(ToTarget2d) Dot vector(PawnOwner.Rotation)) > 0.80) && VSize(ToTarget) < 170.0)
    {
        ImpactMomentum = vector(PawnOwner.Rotation) * 150.0;
        DamageType = ((bLeft) ? class'TdDmgType_MeleeLeft' : class'TdDmgType_MeleeRight');
        Damage = MeleeDamage;
        HitLocation = PawnOwner.Mesh1p.GetBoneLocation(((bLeft) ? 'LeftHand' : 'RightHand'));
        Hit.Material = none;
        Hit.PhysMaterial = TargetPawn.Mesh3p.GetPhysicalMaterialFromBone('Neck');
        Hit.BoneName = 'Neck';
        Hit.HitComponent = TargetPawn.Mesh3p;
        switch(MeleeType)
        {
            // End:0x1EC
            case 2:
                ImpactMomentum = ((vector(PawnOwner.Rotation) + vect(0.0, 0.0, 0.50)) * 200.0) + (VRand() * 100.0);
                DamageType = class'TdDmgType_MeleeSoccerKick';
                Damage += 20.0;
                // End:0x246
                break;
            // End:0x243
            case 3:
                ImpactMomentum = ((vector(PawnOwner.Rotation) + vect(0.0, 0.0, 0.50)) * 200.0) + (VRand() * 100.0);
                DamageType = class'TdDmgType_MeleeSoccerKick';
                Damage += 10.0;
                // End:0x246
                break;
            // End:0xFFFF
            default:
                DeliverDamage(Damage, HitLocation, ImpactMomentum, DamageType, Hit);
                return true;
            }
    }
    return false;
    //return ReturnValue;    
}

defaultproperties
{
    BlendInMissed=0.080
    BlendOutMissed=0.10
    TraceExtent=(X=12.0,Y=12.0,Z=12.0)
    MeleeDamage=33.50
