simulated function PlayStumbleAnimation()
{
    // End:0x4A
    if(StumbleState == 12)
    {
        PawnOwner.UseRootMotion(true);
        PlayMoveAnim(0, 'HitMeleeInAir_High', 1.0, 0.10, 0.20, true);
    }
    // End:0x50
    else
    {
        super.PlayStumbleAnimation();
    }
    //return;    
}
