}

simulated function bool IsValidCrosshairTarget(TdHUD myHUD)
{
    return bStickyAim && StickyActor != none;
    //return ReturnValue;    
}

simulated function bool IsValidStickyActor(Actor PotentialStickyActor, Pawn myPawn)
{
    local TdPawn PotentialStickyPawn;

    PotentialStickyPawn = TdPawn(PotentialStickyActor);
    // End:0x38
    if(PotentialStickyPawn != none)
    {
        return PotentialStickyPawn.IsSameTeam(myPawn);
    }
    // End:0x3A
    else
    {
        return true;
    }
    //return ReturnValue;    
}

function DropFrom(Vector StartLocation, Vector StartVelocity)
{
    local TdPlayerPawn myPawn;

    super(TdWeapon).DropFrom(StartLocation, StartVelocity);
    // End:0x5B
    if(Role == ROLE_Authority)
    {
        myPawn = TdPlayerPawn(Instigator);
        myPawn.DropCarriedObject(StartLocation, rot(0, 0, 0), StartVelocity);
    }
    //return;    
}

simulated function CustomFire()
{
    local Rotator StartFireRot, PitchAssist;
    local float Distance2DToThrowBag, DistanceZToThrowBag, FinalThrowVelocity, AirTimeXY, NeededZVelocity, Gravity,
	    StickyAimVelocity, TargetRadius, TargetHeight;

    local Vector ThrowDir, StartFireLoc;
    local Rotator ThrowRotation;
    local Vector InitialProjLocation, InitialProjVelocity, TargetLocation, TargetVel;

    StartFireLoc = Instigator.GetWeaponStartTraceLocation();
    StartFireRot = GetAdjustedAim(StartFireLoc);
    // End:0x413
    if(bStickyAim && StickyActor != none)
    {
        // End:0x99
        if(Instigator.IsSameTeam(TdPawn(StickyActor)))
        {
            class'TdAnnouncerBase'.static.Play3DLocationalAnnouncement(Instigator, class'TdBagMessage', 6, true, true, Instigator.PlayerReplicationInfo);
        }
        StickyActor.GetBoundingCylinder(TargetRadius, TargetHeight);
        TargetLocation = StickyActor.Location;
        TargetLocation.Z += (TargetHeightBooster * TargetHeight);
        TargetVel = StickyActor.Velocity;
        TargetVel.Z = 0.0;
        TargetVel = (TargetVelocityMultiplier2D * Normal(TargetVel)) * VSize2D(StickyActor.Velocity);
        TargetVel.Z = TargetVelocityMultiplierZ * StickyActor.Velocity.Z;
        Distance2DToThrowBag = VSize2D(TargetLocation - StartFireLoc);
        DistanceZToThrowBag = TargetLocation.Z - StartFireLoc.Z;
        InitialProjLocation = StartFireLoc;
        InitialProjVelocity = vector(StartFireRot);
        InitialProjVelocity *= Lerp(StickyAimMinVelocity, StickyAimDefaultVelocity, FClamp(VSize(TargetLocation - StartFireLoc) / 1000.0, 0.0, 1.0));
        // End:0x23C
        if(DistanceZToThrowBag > (TargetHeight * 2.0))
        {
            InitialProjVelocity *= FMax(StickyAimMinVelocity / StickyAimDefaultVelocity, 2.0 * (TargetHeight / DistanceZToThrowBag));
        }
        // End:0x3F3
        if(!SolveParablaLineProblem(TargetLocation, TargetVel, InitialProjLocation, -Instigator.GetGravityZ(), VSize2D(InitialProjVelocity), InitialProjVelocity))
        {
            Gravity = Abs(Instigator.GetGravityZ());
            AirTimeXY = Distance2DToThrowBag / StickyAimDefaultVelocity;
            NeededZVelocity = (DistanceZToThrowBag / AirTimeXY) + ((AirTimeXY * Gravity) * 0.50);
            // End:0x321
            if(NeededZVelocity < 0.0)
            {
                NeededZVelocity = 0.0;
                ThrowDir.X = Distance2DToThrowBag / Sqrt((Abs(DistanceZToThrowBag) * 2.0) / Gravity);
            }
            // End:0x337
            else
            {
                ThrowDir.X = StickyAimDefaultVelocity;
            }
            ThrowDir.Z = NeededZVelocity;
            ThrowRotation = rotator(ThrowDir);
            ThrowRotation.Roll = 0;
            ThrowRotation.Yaw = StickyRotation.Yaw;
            StickyAimVelocity = Sqrt(Square(ThrowDir.X) + Square(ThrowDir.Z));
            StickyAimVelocity = FMax(StickyAimVelocity, 0.0);
            StickyAimVelocity = FMin(StickyAimVelocity, StickyAimMaxVelocity);
            InitialProjVelocity = vector(ThrowRotation) * StickyAimVelocity;
        }
        InitialProjVelocity = Normal(InitialProjVelocity) * FMin(VSize(InitialProjVelocity), StickyAimMaxVelocity);
    }
    // End:0x4F4
    else
    {
        InitialProjLocation = StartFireLoc;
        PitchAssist.Pitch = int(FMax(0.0, float(NormalizeRotAxis(StartFireRot.Pitch)) / float(16384)));
        FinalThrowVelocity = Lerp(MaxThrowVelocity, MinThrowVelocity, float(PitchAssist.Pitch));
        PitchAssist = RLerp(MaxPitchAssist, MinPitchAssist, float(PitchAssist.Pitch));
        StartFireRot.Pitch += PitchAssist.Pitch;
        InitialProjVelocity = (vector(StartFireRot) * FinalThrowVelocity) + (Instigator.Velocity * PlayerVelocityAddPct);
    }
    DropFrom(InitialProjLocation, InitialProjVelocity * AirResistanceBoost);
    //return;    
}

function bool SolveParablaLineProblem(Vector PL, Vector VL, Vector P0, float Gravity, float V02d, out Vector V0)
{
    local float Q, W, vx0, vx1, T0, T1;

    Q = (P0.Y - PL.Y) / (P0.X - PL.X);
    W = VL.Y - (Q * VL.X);
    // End:0x2AE
    if(SecondDegreeSolver((W * W) - (V02d * V02d), (2.0 * Q) * W, (Q * Q) + float(1), vx0, vx1))
    {
        T0 = -P0.X - PL.X / (vx0 - VL.X);
        T1 = -P0.X - PL.X / (vx1 - VL.X);
        // End:0x202
        if(T0 > 0.0)
        {
            V0.X = vx0;
            V0.Y = (vx0 * Q) + W;
            V0.Z = (((0.50 * Gravity) * T0) - ((P0.Z - PL.Z) / T0)) + VL.Z;
            return true;
        }
        // End:0x2AE
        if(T1 > 0.0)
        {
            V0.X = vx1;
            V0.Y = (vx1 * Q) + W;
            V0.Z = (((0.50 * Gravity) * T1) - ((P0.Z - PL.Z) / T1)) + VL.Z;
            return true;
        }
    }
    return false;
    //return ReturnValue;    
}

function bool SecondDegreeSolver(float A, float bx, float cx2, out float s0, out float s1)
{
    local float P, Q, R;

    // End:0xA9
    if(cx2 != 0.0)
    {
        P = bx / cx2;
        Q = A / cx2;
        R = ((0.250 * P) * P) - Q;
        // End:0x67
        if(R < 0.0)
        {
            return false;
        }
        // End:0x74
        else
        {
            R = Sqrt(R);
        }
        s0 = (-0.50 * P) + R;
        s1 = (-0.50 * P) - R;
    }
    // End:0xC8
    else
    {
        s0 = -A / bx;
        s1 = s0;
    }
    return true;
    //return ReturnValue;    
}

simulated function ForceNewStickyActor(Actor NewStickyActor, TdHUD HUD, Controller Controller, TdMove CurrentMove, float DeltaTime)
{
    bBagIsRequiested = true;
    SetTimer(BagRequestDuration, false, 'ClearBagRequest');
    super(TdWeapon).ForceNewStickyActor(NewStickyActor, HUD, Controller, CurrentMove, DeltaTime);
    //return;    
}

simulated function ClearBagRequest()
{
    bBagIsRequiested = false;
    //return;    
}

simulated function int GetFinalStickyAngle(TdMove CurrentMove, TdPawn StickyPawn)
{
    // End:0x0F
    if(bBagIsRequiested)
    {
        return 65000;
    }
    return 8000;
    //return ReturnValue;    
}

simulated function DrawWeaponCrosshair(HUD H)
{
    local TdHUD myHUD;
    local Vector ScreenLoc;
    local Vector2D ClipYBounds, ClipXBounds;
    local Vector BagDir;

    myHUD = TdHUD(H);
    // End:0x69A
    if(myHUD != none)
    {
        ScreenLoc.X = myHUD.Canvas.ClipX * 0.50;
        ScreenLoc.Y = myHUD.Canvas.ClipY * 0.50;
        myHUD.Canvas.Draw2DLine(ScreenLoc.X, ScreenLoc.Y - float(2), ScreenLoc.X, ScreenLoc.Y + float(2), MakeColor(255, 255, 255, 1));
        myHUD.Canvas.Draw2DLine(ScreenLoc.X - float(2), ScreenLoc.Y, ScreenLoc.X + float(2), ScreenLoc.Y, MakeColor(255, 255, 255, 1));
        // End:0x59B
        if(bStickyAim && StickyActor != none)
        {
            ClipYBounds.X = (myHUD.Canvas.ClipY * 0.050) + float(64);
            ClipYBounds.Y = (myHUD.Canvas.ClipY * 0.950) - float(64);
            ClipXBounds.X = (myHUD.Canvas.ClipX * 0.050) + float(64);
            ClipXBounds.Y = (myHUD.Canvas.ClipX * 0.950) - float(64);
            myHUD.ProjectOntoScreen(Instigator.GetWeaponStartTraceLocation() + (vector(StickyRotation) * VSize(StickyActor.Location - Instigator.Location)), vect(0.0, 0.0, 0.0), ClipXBounds, ClipYBounds, ScreenLoc);
            myHUD.Canvas.SetPos(ScreenLoc.X - float(16), ScreenLoc.Y - float(16));
            // End:0x372
            if(bBagIsRequiested)
            {
                H.Canvas.DrawColorizedTile(OnTargetCrossHair, 32.0, 32.0, 0.0, 0.0, 32.0, 32.0, MakeLinearColor(0.0, 1.0, 0.0, 1.0));
            }
            // End:0x3B4
            else
            {
                H.Canvas.DrawColorizedTile(OnTargetCrossHair, 32.0, 32.0, 0.0, 0.0, 32.0, 32.0, OnTargetCrossHairColor);
            }
            // End:0x598
            if((((ScreenLoc.X == ClipXBounds.Y) || ScreenLoc.X == ClipXBounds.X) || ScreenLoc.Y == ClipYBounds.Y) || ScreenLoc.Y == ClipYBounds.X)
            {
                BagDir.X = myHUD.Canvas.ClipX * 0.50;
                BagDir.Y = myHUD.Canvas.ClipY * 0.50;
                BagDir = Normal(ScreenLoc - BagDir);
                // End:0x4F9
                if(bBagIsRequiested)
                {
                    myHUD.Canvas.DrawColor = myHUD.GreenColor;
                }
                // End:0x522
                else
                {
                    myHUD.Canvas.DrawColor = myHUD.WhiteColor;
                }
                myHUD.Canvas.SetPos((ScreenLoc.X - float(8)) + (BagDir.X * float(32)), (ScreenLoc.Y - float(8)) + (BagDir.Y * float(32)));
            }
        }
        // End:0x69A
        else
        {
            ScreenLoc.X = myHUD.Canvas.ClipX * 0.50;
            ScreenLoc.Y = myHUD.Canvas.ClipY * 0.50;
            myHUD.Canvas.SetPos(ScreenLoc.X - float(16), ScreenLoc.Y - float(16));
            H.Canvas.DrawColorizedTile(NormalCrossHair, 32.0, 32.0, 0.0, 0.0, 32.0, 32.0, MakeLinearColor(1.0, 1.0, 1.0, 1.0));
        }
    }
    //return;    
}

simulated function UpdateStickyActor(TdHUD HUD, Controller Controller, TdMove CurrentMove, float DeltaTime)
{
    local Rotator DeltaRotation;
    local int FinalStickyAngle;
    local float DistanceToStickyActor;
    local Vector WeaponStartTraceLocation;
    local Rotator CollisionRotation;
    local Pawn StickyPawn;

    WeaponStartTraceLocation = Instigator.GetWeaponStartTraceLocation();
    // End:0xF0
    if(((HUD != none) && HUD.TargetingActor != none) && HUD.TargetingActor != StickyActor)
    {
        // End:0xF0
        if(IsValidStickyActor(HUD.TargetingActor, Controller.Pawn))
        {
            StickyActor = HUD.TargetingActor;
            StickyRotation = Instigator.GetAdjustedAimFor(self, WeaponStartTraceLocation);
            ClearBagRequest();
            // End:0xF0
            if((IsFiring()) && Role < ROLE_Authority)
            {
                ServerUpdateStickyActor(StickyActor);
            }
        }
    }
    // End:0x107
    if(StickyActor == none)
    {
        ClearBagRequest();
        return;
    }
    DistanceToStickyActor = VSize(StickyActor.Location - WeaponStartTraceLocation);
    DeltaRotation = rotator(StickyActor.Location - WeaponStartTraceLocation) - Controller.Rotation;
    DeltaRotation = Normalize(DeltaRotation);
    StickyPawn = Pawn(StickyActor);
    CollisionRotation = rot(0, 0, 0);
    // End:0x1EF
    if(StickyPawn != none)
    {
        CollisionRotation = rotator((StickyActor.Location + StickyPawn.GetCollisionExtent()) - WeaponStartTraceLocation) - Controller.Rotation;
        CollisionRotation = Normalize(CollisionRotation - DeltaRotation);
    }
    FinalStickyAngle = GetFinalStickyAngle(CurrentMove, TdPawn(StickyActor));
    // End:0x2C3
    if(((CurrentMove.bStickyAim && (Abs(float(DeltaRotation.Yaw)) - Abs(float(CollisionRotation.Yaw))) < float(FinalStickyAngle)) && (Abs(float(DeltaRotation.Pitch)) - Abs(float(CollisionRotation.Pitch))) < float(FinalStickyAngle)) && DistanceToStickyActor < StickyMaxDistance)
    {
        SetStickyAimOffset(DeltaTime, Controller.Rotation);
    }
    // End:0x2D4
    else
    {
        ClearBagRequest();
        StickyActor = none;
    }
    //return;    
}

