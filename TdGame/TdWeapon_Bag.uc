class TdWeapon_Bag extends TdWeapon_Light
    config(Weapons)
    hidecategories(Navigation);

const FireModeThrowBag = 0;

var const config float MaxThrowVelocity;
var const config float MinThrowVelocity;
var const config float PlayerVelocityAddPct;
var const config Rotator MaxPitchAssist;
var const config Rotator MinPitchAssist;
var const config float StickyAimMaxVelocity;
var const config float StickyAimDefaultVelocity;
var const config float StickyAimMinVelocity;
var const config float AirResistanceBoost;
var const config float TargetVelocityMultiplier2D;
var const config float TargetVelocityMultiplierZ;
var const config float TargetHeightBooster;
var const config float BagRequestDuration;
var bool bBagIsRequiested;

