event InitGame(string Options, out string ErrorMessage)
{
    local string StretchStr;
    local int ParsedRaceType;

    super.InitGame(Options, ErrorMessage);
    StretchStr = ParseOption(Options, "Stretch");
    ParsedRaceType = Max(0, GetIntOption(Options, "RaceType", ParsedRaceType));
    bOnlineMode = bool(ParseOption(Options, "OnlineMode"));
    ActiveTTStretch = GetStretchFromName(name(StretchStr));
    RaceType = GetRaceTypeFromInt(ParsedRaceType);
    SendKismetEvent(class'SeqEvt_TTRaceLoaded');
    //return;    
}

function TrackData GetTrackData(int Stretch)
{
    local TdSPTimeTrialGame.ETTStretch OldStretch;
    local TrackData TData;

    OldStretch = ActiveTTStretch;
    ActiveTTStretch = byte(Stretch);
    TData = CheckpointManager.GetTrackData(Stretch, ChoosePlayerStart(none));
    ActiveTTStretch = OldStretch;
    return TData;
    //return ReturnValue;    
}

static function TdSPTimeTrialGame.ETTStretch GetStretchFromName(name Stretch)
{
    local int Idx;

    Idx = 0;
    J0x07:
    // End:0x3F [Loop If]
    if(Idx < 25)
    {
        // End:0x35
        if(GetEnum(enum'ETTStretch', Idx) == Stretch)
        {
            return byte(Idx);
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x07;
    }
    return 0;
    //return ReturnValue;    
}

static function TdSPTimeTrialGame.ERaceType GetRaceTypeFromInt(int InRaceType)
{
    return byte(InRaceType);
    //return ReturnValue;    
}

