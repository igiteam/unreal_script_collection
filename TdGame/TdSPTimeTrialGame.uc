function SendKismetEvent(class<SequenceEvent> EventClass)
{
    local int Index;
    local Sequence GameSequence;
    local array<SequenceObject> TimeTrialEvents;

    GameSequence = WorldInfo.GetGameSequence();
    GameSequence.FindSeqObjectsByClass(EventClass, true, TimeTrialEvents);
    Index = 0;
    J0x38:
    // End:0x72 [Loop If]
    if(Index < TimeTrialEvents.Length)
    {
        SequenceEvent(TimeTrialEvents[Index]).CheckActivate(self, self);
        ++ Index;
        // [Loop Continue]
        goto J0x38;
    }
    //return;    
}

