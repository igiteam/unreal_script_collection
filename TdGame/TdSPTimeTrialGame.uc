function PlayerStart ChoosePlayerStart(Controller Player, optional byte InTeam)
{
    local PlayerStart CurrentStart;
    local TdTimeTrialStart BestTTStart;
    local int Idx;

    Idx = 0;
    J0x08:
    // End:0x9A [Loop If]
    if(Idx < StartPoints.Length)
    {
        CurrentStart = StartPoints[Idx];
        BestTTStart = TdTimeTrialStart(CurrentStart);
        // End:0x90
        if((BestTTStart != none) && BestTTStart.TrackIndex == ActiveTTStretch)
        {
            // End:0x77
            if(!bInitailRaceSpawn)
            {
                return BestTTStart;
                // [Explicit Continue]
                goto J0x90;
            }
            // End:0x90
            if(BestTTStart.bPrimaryStart)
            {
                return BestTTStart;
            }
        }
        J0x90:
        ++ Idx;
        // [Loop Continue]
        goto J0x08;
    }
    return CurrentStart;
    //return ReturnValue;    
}

function ResetPlayer(TdPlayerPawn PawnToReset, optional NavigationPoint StartSpot)
{
    local NavigationPoint PlayerStartPoint;
    local Rotator ControllerRotation;

    PawnToReset.LastResetTimeStamp = WorldInfo.TimeSeconds;
    // End:0x43
    if(StartSpot == none)
    {
        PlayerStartPoint = FindClosestStartSpot(LastValidPlayerLocation);
    }
    // End:0x4E
    else
    {
        PlayerStartPoint = StartSpot;
    }
    PawnToReset.SetLocation(PlayerStartPoint.Location);
    // End:0x133
    if((NextCheckPoint != none) && !IsInState('RaceCountDown'))
    {
        ControllerRotation = rotator(NextCheckPoint.Location - PawnToReset.Location);
        ControllerRotation.Pitch = Clamp(ControllerRotation.Pitch, -8192, 8192);
        ControllerRotation.Roll = 0;
        PawnToReset.Controller.SetRotation(ControllerRotation);
        ControllerRotation.Pitch = 0;
        PawnToReset.SetRotation(ControllerRotation);
    }
    // End:0x19A
    else
    {
        ControllerRotation = PlayerStartPoint.Rotation;
        ControllerRotation.Roll = 0;
        ControllerRotation.Pitch = 0;
        PawnToReset.SetRotation(ControllerRotation);
        PawnToReset.Controller.SetRotation(ControllerRotation);
    }
    PawnToReset.GotoState('None');
    PawnToReset.SetMove(1);
    PawnToReset.StopCustomAnim(2, 0.0);
    PawnToReset.Velocity = vect(0.0, 0.0, 0.0);
    PawnToReset.Acceleration = vect(0.0, 0.0, 0.0);
    PawnToReset.Health = 100;
    PawnToReset.EnterFallingHeight = PlayerStartPoint.Location.Z;
    PawnToReset.ResetMoves();
    LastPlayerResetTime = WorldInfo.TimeSeconds;
    //return;    
}

function StoreLastValidPlayerLocation()
{
    // End:0x90
    if(((RacingPawn != none) && RacingPawn.Physics == 1) && ((RacingPawn.MovementState == 1) || RacingPawn.MovementState == 16) || RacingPawn.MovementState == 15)
    {
        LastValidPlayerLocation = RacingPawn.Location;
    }
    //return;    
}

function bool PreventDeath(Pawn KilledPawn, Controller Killer, class<DamageType> DamageType, Vector HitLocation)
{
    local TdPlayerPawn KilledPlayerPawn;

    KilledPlayerPawn = TdPlayerPawn(KilledPawn);
    ResetPlayer(KilledPlayerPawn);
    TdHUD(RacingPlayer.myHUD).Reset();
    TdHUD(RacingPlayer.myHUD).TriggerCustomColorFadeIn(1.50, MakeLinearColor(0.0, 0.0, 0.0, 1.0),, None, true);
    return true;
    //return ReturnValue;    
}

function SetIgnoreInput(bool bIgnore)
{
    local TdPlayerController PC;

    // End:0x9F
    foreach WorldInfo.AllControllers(class'TdPlayerController', PC)
    {
        PC.IgnoreButtonInput(bIgnore);
        PC.IgnoreLookInput(bIgnore);
        PC.IgnoreMoveInput(bIgnore);
        // End:0x9E
        if(!bIgnore)
        {
            RacingPawn.StopIgnoreLookInput();
            RacingPawn.StopIgnoreMoveInput();
        }        
    }    
    //return;    
}

