event PreBeginPlay()
{
    local DataStoreClient DataStoreManager;

    super.PreBeginPlay();
    AccuireSpectatorPoints();
    CheckpointManager = Spawn(class'TdPlaceableCheckpointManager', self);
    CheckpointManager.Initialize(class'TdTimerCheckpoint', self);
    // End:0x93
    if(((ActiveTTStretch > 0) && ActiveTTStretch < 25) && CheckpointManager.CanFindTrack(ActiveTTStretch))
    {
        CheckpointManager.ShowTrack(ActiveTTStretch, true);
    }
    CheckpointLookAtHelper = Spawn(class'TdLookAtPointSpawnable', self);
    GhostManager = Spawn(class'TdGhostManager');
    TdTTMessageClass = class<TdLocalMessage>(DynamicLoadObject("TdTTContent.TdTimeTrialMessage", class'Class'));
    VictoryMessageClass = class<TdVictoryMessage>(DynamicLoadObject("TdTTContent.TdTTVictoryMessage", class'Class'));
    TimeMessageClass = class<TdLocalMessage>(DynamicLoadObject("TdTTContent.TdTimeMessage", class'Class'));
    TimeFinishMessageClass = class<TdLocalMessage>(DynamicLoadObject("TdTTContent.TdFinishlineTimeMessage", class'Class'));
    DataStoreManager = class'UIInteraction'.static.GetDataStoreClient();
    // End:0x1F0
    if((TimeTrialData == none) && DataStoreManager != none)
    {
        TimeTrialData = UIDataStore_TdTimeTrialData(DataStoreManager.FindDataStore('TdTimeTrialData'));
    }
    //return;    
}

