exec function PrepareRace()
{
    local string QualifierTimeString, StarTimeString;

    // End:0x42
    if(((ActiveTTStretch <= 0) || ActiveTTStretch >= 25) || !CheckpointManager.CanFindTrack(ActiveTTStretch))
    {
        return;
    }
    // End:0x6C
    if((RaceType >= 2) || RaceType < 0)
    {
        RaceType = 0;
    }
    GhostManager.StopGhostRecording(RacingPawn);
    GhostManager.StopGhostPlayback();
    WorldInfo.MyDecalManager.ResetPool();
    WorldInfo.MyEmitterPool.ResetPool();
    ResetLevel();
    bRestartLevel = false;
    StartMatch();
    bRestartLevel = default.bRestartLevel;
    TriggerEventsOnLevelReload(RacingPlayer);
    TimeTrialData.GetStringValueFromProviderSet('TdTimeTrialStretches', 'QualifyingTime', TimeTrialData.GetCurrentWorkingStretchProviderIndex(), QualifierTimeString);
    QualifyingTime = float(QualifierTimeString);
    TimeTrialData.GetStringValueFromProviderSet('TdTimeTrialStretches', 'Rating1Time', TimeTrialData.GetCurrentWorkingStretchProviderIndex(), StarTimeString);
    StarRatingTimes[2] = float(StarTimeString);
    TimeTrialData.GetStringValueFromProviderSet('TdTimeTrialStretches', 'Rating2Time', TimeTrialData.GetCurrentWorkingStretchProviderIndex(), StarTimeString);
    StarRatingTimes[1] = float(StarTimeString);
    TimeTrialData.GetStringValueFromProviderSet('TdTimeTrialStretches', 'Rating3Time', TimeTrialData.GetCurrentWorkingStretchProviderIndex(), StarTimeString);
    StarRatingTimes[0] = float(StarTimeString);
    // End:0x28A
    if(TimeTrialData.GetTargetRaceData().TotalTime == 3599.990)
    {
        TimeDataToBeat = CreateFakeTimeData(ActiveTTStretch, QualifyingTime);
    }
    // End:0x2A8
    else
    {
        TimeDataToBeat = ReadTimeData(ActiveTTStretch, RaceType);
    }
    // End:0x2EE
    if(TimeTrialData.CurrentGhost != none)
    {
        GhostManager.PlaybackData = TimeTrialData.CurrentGhost.RawBytes;
        HasGhost = true;
    }
    TdHUD(RacingPlayer.myHUD).ClearLocalMessages();
    //return;    
}

function TriggerEventsOnLevelReload(Controller NewPlayer)
{
    local Sequence GameSeq;
    local array<SequenceObject> Events;
    local int I;

    GameSeq = WorldInfo.GetGameSequence();
    // End:0x8E
    if(GameSeq != none)
    {
        Events.Remove(0, Events.Length);
        GameSeq.FindSeqObjectsByClass(class'SeqEvent_LevelLoaded', true, Events);
        I = 0;
        J0x50:
        // End:0x8E [Loop If]
        if(I < Events.Length)
        {
            SeqEvent_LevelLoaded(Events[I]).CheckActivate(WorldInfo, none);
            ++ I;
            // [Loop Continue]
            goto J0x50;
        }
    }
    //return;    
}

function TimeData CreateFakeTimeData(TdSPTimeTrialGame.ETTStretch Stretch, float TimeToBeat)
{
    local TimeData NewTimeData;
    local int Idx;
    local float IntMPct, AccumTime;
    local bool bOldInitailRaceSpawn;

    bOldInitailRaceSpawn = bOldInitailRaceSpawn;
    bInitailRaceSpawn = true;
    CurrentTackData = CheckpointManager.GetTrackData(Stretch, ChoosePlayerStart(none));
    bInitailRaceSpawn = bOldInitailRaceSpawn;
    NewTimeData.IntermediateTimes.Insert(0, CurrentTackData.IntermediateDistance.Length);
    NewTimeData.TotalTime = TimeToBeat;
    AccumTime = 0.0;
    Idx = 0;
    J0x9A:
    // End:0x13F [Loop If]
    if(Idx < CurrentTackData.IntermediateDistance.Length)
    {
        IntMPct = CurrentTackData.IntermediateDistance[Idx] / CurrentTackData.TotalDistance;
        AccumTime += (IntMPct * TimeToBeat);
        NewTimeData.IntermediateTimes[Idx] = IntMPct * TimeToBeat;
        NewTimeData.AccumulatedIntermediateTimes[Idx] = AccumTime;
        ++ Idx;
        // [Loop Continue]
        goto J0x9A;
    }
    Idx = 0;
    J0x146:
    // End:0x16B [Loop If]
    if(Idx < NewTimeData.IntermediateTimes.Length)
    {
        ++ Idx;
        // [Loop Continue]
        goto J0x146;
    }
    return NewTimeData;
    //return ReturnValue;    
}

function CreateTimeData(TrackData InTrackData, float InTotalTime, array<float> InTimes, out TimeData NewTimeData)
{
    local float AccumTime, IntMPct;
    local int NumIntermediateTimes, Idx, InLength;

    NewTimeData.IntermediateTimes.Remove(0, NewTimeData.IntermediateTimes.Length);
    NewTimeData.AccumulatedIntermediateTimes.Remove(0, NewTimeData.AccumulatedIntermediateTimes.Length);
    NumIntermediateTimes = InTrackData.IntermediateDistance.Length;
    NewTimeData.IntermediateTimes.Insert(0, NumIntermediateTimes);
    NewTimeData.AccumulatedIntermediateTimes.Insert(0, NumIntermediateTimes);
    NewTimeData.TotalTime = InTotalTime;
    InLength = 0;
    J0xA8:
    // End:0xDA [Loop If]
    if(InLength < InTimes.Length)
    {
        // End:0xD0
        if(InTimes[InLength] == 0.0)
        {
            // [Explicit Break]
            goto J0xDA;
        }
        ++ InLength;
        J0xDA:
        // [Loop Continue]
        goto J0xA8;
    }
    // End:0x197
    if(InLength != NumIntermediateTimes)
    {
        AccumTime = 0.0;
        Idx = 0;
        J0xFB:
        // End:0x194 [Loop If]
        if(Idx < NumIntermediateTimes)
        {
            IntMPct = InTrackData.IntermediateDistance[Idx] / InTrackData.TotalDistance;
            AccumTime += (IntMPct * InTotalTime);
            NewTimeData.IntermediateTimes[Idx] = IntMPct * InTotalTime;
            NewTimeData.AccumulatedIntermediateTimes[Idx] = AccumTime;
            ++ Idx;
            // [Loop Continue]
            goto J0xFB;
        }
    }
    // End:0x212
    else
    {
        AccumTime = 0.0;
        Idx = 0;
        J0x1A9:
        // End:0x212 [Loop If]
        if(Idx < NumIntermediateTimes)
        {
            AccumTime += InTimes[Idx];
            NewTimeData.IntermediateTimes[Idx] = InTimes[Idx];
            NewTimeData.AccumulatedIntermediateTimes[Idx] = AccumTime;
            ++ Idx;
            // [Loop Continue]
            goto J0x1A9;
        }
    }
    //return;    
}

function TimeData ReadTimeData(int Stretch, int InRaceType)
{
    local TimeData NewTimeData;
    local TTData TargetTTData;
    local int Idx;

    bInitailRaceSpawn = true;
    CurrentTackData = CheckpointManager.GetTrackData(Stretch, ChoosePlayerStart(none));
    bInitailRaceSpawn = false;
    TargetTTData = TimeTrialData.GetTargetRaceData();
    CreateTimeData(CurrentTackData, TargetTTData.TotalTime, TargetTTData.IntermediateTimes, NewTimeData);
    Idx = 0;
    J0x90:
    // End:0xB5 [Loop If]
    if(Idx < NewTimeData.IntermediateTimes.Length)
    {
        ++ Idx;
        // [Loop Continue]
        goto J0x90;
    }
    return NewTimeData;
    //return ReturnValue;    
}

