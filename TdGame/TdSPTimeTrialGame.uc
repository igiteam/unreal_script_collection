auto state PreRace
{
    ignores BeginState;
    stop;    
}

state RaceCountDown
{
    function BeginState(name PreviousState)
    {
        local TimeData ZeroTimeData;
        local PlayerStart StartSpot;

        bDelayPauseUntilRaceStarted = 0;
        // End:0x34
        if(!CheckpointManager.ActivateTrack(ActiveTTStretch))
        {
            GotoState('PreRace');
            return;
        }
        NumPassedCheckPoints = 0;
        NumPassedTimerCheckPoints = 0;
        NumCheckPoints = CheckpointManager.GetTrackSize();
        LastCheckPoint = none;
        NextCheckPoint = CheckpointManager.GetFirstCheckpoint();
        NextCheckPoint.Show(true, ActiveTTStretch);
        RaceStartTimeStamp = -1.0;
        RaceEndTimeStamp = -1.0;
        CurrentTimeData = ZeroTimeData;
        CurrentTimeData.IntermediateTimes.Insert(0, CurrentTackData.IntermediateDistance.Length);
        // End:0x116
        if((RacingPawn == none) && !IsSpectatingGhost())
        {
            bRestartLevel = false;
            RestartPlayer(RacingPlayer);
            bRestartLevel = default.bRestartLevel;
        }
        bInitailRaceSpawn = true;
        StartSpot = ChoosePlayerStart(none);
        // End:0x193
        if(!IsSpectatingGhost())
        {
            ResetPlayer(RacingPawn, StartSpot);
            SetIgnoreInput(true);
            RacingPlayer.SetCameraMode('FirstPerson');
            RacingPawn.SetFirstPerson(true);
        }
        // End:0x1B2
        else
        {
            RacingPlayer.SetViewTarget(GetFirstSpectatorPoint());
        }
        CurrentTackData = CheckpointManager.GetTrackData(ActiveTTStretch, StartSpot);
        bInitailRaceSpawn = false;
        SetTimer(1.0, true, 'CountDownTimer');
        RaceCountDownTimer = RaceCountDownTime + 1;
        SendKismetEvent(class'SeqEvt_TTRaceCountDownStarted');
        RacingPawn.UnCrouch();
        RacingPlayer.bDuck = 0;
        //return;        
    }

    function bool CanOpenPauseMenu()
    {
        return true;
        //return ReturnValue;        
    }

    exec function PrepareRace()
    {
        GotoState('PreRace');
        ClearTimer('CountDownTimer');
        global.PrepareRace();
        //return;        
    }

    function EndState(name NextStateName)
    {
        RacingPlayer.SetCinematicMode(false, false, false, true, true, true, true);
        ClearIgnoreInput();
        //return;        
    }

    private final function CountDownTimer()
    {
        Timer();
        -- RaceCountDownTimer;
        // End:0x25
        if(RaceCountDownTimer <= 0)
        {
            StartRace();
        }
        // End:0x6F
        else
        {
            // End:0x48
            if(RaceCountDownTimer == 2)
            {
                BroadcastLocalizedMessage(TdTTMessageClass, 26);
            }
            // End:0x6F
            else
            {
                // End:0x6F
                if(RaceCountDownTimer == 1)
                {
                    bDelayPauseUntilRaceStarted = 1;
                    BroadcastLocalizedMessage(TdTTMessageClass, 25);
                }
            }
        }
        //return;        
    }

    function StartRace()
    {
        ClearTimer('CountDownTimer');
        BroadcastLocalizedMessage(TdTTMessageClass, 24);
        SendKismetEvent(class'SeqEvt_TTRaceStarted');
        // End:0x74
        if(!IsSpectatingGhost())
        {
            GhostManager.StopGhostRecording(RacingPawn);
            GhostManager.RecordGhost(RacingPawn);
        }
        // End:0xA5
        if(HasGhost)
        {
            GhostManager.StopGhostPlayback();
            GhostManager.PlaybackGhost();
        }
        GotoState('RaceInProgress');
        //return;        
    }
    stop;    
}

state RaceInProgress
{
    function BeginState(name PreviousState)
    {
        RaceStartTimeStamp = WorldInfo.TimeSeconds;
        LastCheckpointTimeStamp = WorldInfo.TimeSeconds;
        PlayerDistance = 0.0;
        //return;        
    }

    function bool CanOpenPauseMenu()
    {
        return true;
        //return ReturnValue;        
    }

    function TdLookAtPoint GetLookAtPoint(TdPawn Player)
    {
        // End:0x37
        if(!Player.Moves[Player.MovementState].CanUseLookAtHint())
        {
            return none;
        }
        // End:0x5E
        if(NextCheckPoint != none)
        {
            CheckpointLookAtHelper.SetLocation(NextCheckPoint.Location);
        }
        return CheckpointLookAtHelper;
        //return ReturnValue;        
    }

    exec function ResetPlayerToLatestCheckpoint()
    {
        // End:0x102
        if((WorldInfo.TimeSeconds - LastPlayerResetTime) > 2.0)
        {
            WorldInfo.MyEmitterPool.ResetPool();
            RacingPawn.ResetMoves();
            RacingPlayer.bDuck = 0;
            ResetPlayer(RacingPawn);
            SetIgnoreInput(true);
            SetTimer(0.80, false, 'DisableIgnoreInputTimer');
            TdHUD(RacingPlayer.myHUD).Reset();
            TdHUD(RacingPlayer.myHUD).TriggerCustomColorFadeIn(1.50, MakeLinearColor(0.0, 0.0, 0.0, 1.0),, None, true);
        }
        //return;        
    }

    private final function DisableIgnoreInputTimer()
    {
        SetIgnoreInput(false);
        //return;        
    }

    function float GetPlayerTime()
    {
        return WorldInfo.TimeSeconds - RaceStartTimeStamp;
        //return ReturnValue;        
    }

    function EndState(name NextStateName)
    {
        bDelayPauseUntilRaceStarted = 0;
        // End:0x23
        if(!IsSpectatingGhost())
        {
            PlayerDistance *= 0.010;
        }
        //return;        
    }

    function Tick(float DeltaTime)
    {
        local float PlayerSpeed, RaceTimeStamp;

        // End:0x33
        if(bDelayPauseUntilRaceStarted > 1)
        {
            TdTimeTrialHUD(RacingPlayer.myHUD).DelayedPauseGame();
        }
        bDelayPauseUntilRaceStarted = 0;
        // End:0xCF
        if(!IsSpectatingGhost())
        {
            PlayerSpeed = VSize(RacingPawn.Velocity);
            PlayerDistance += (PlayerSpeed * DeltaTime);
            RaceTimeStamp = WorldInfo.TimeSeconds;
            // End:0xCF
            if(((RaceTimeStamp - RaceStartTimeStamp) > QualifyingTime) && GhostManager.GhostRecordDriver != none)
            {
                GhostManager.StopGhostRecording(RacingPawn);
            }
        }
        //return;        
    }

    function NavigationPoint FindClosestStartSpot(Vector ObjectLocation)
    {
        local int Index;
        local PlayerStart PlayerStartPoint;
        local TdTimeTrialStart TTStart;
        local TdPlaceableCheckpoint PlaceableCheckPoint;
        local TdTimerCheckpoint TimerCheckpoint;

        // End:0xD7
        if(LastCheckPoint != none)
        {
            TimerCheckpoint = TdTimerCheckpoint(LastCheckPoint);
            // End:0x4B
            if(LastCheckPoint.bShouldBeBased && !TimerCheckpoint.bNoRespawn)
            {
                return LastCheckPoint;
            }
            PlaceableCheckPoint = LastCheckPoint;
            J0x56:
            // End:0xCE [Loop If]
            if(!PlaceableCheckPoint.bShouldBeBased || TimerCheckpoint.bNoRespawn)
            {
                PlaceableCheckPoint = CheckpointManager.GetPreviousCheckpoint(PlaceableCheckPoint);
                TimerCheckpoint = TdTimerCheckpoint(PlaceableCheckPoint);
                // End:0xCB
                if(PlaceableCheckPoint == CheckpointManager.GetFirstCheckpoint())
                {
                    return PlaceableCheckPoint;
                }
                // [Loop Continue]
                goto J0x56;
            }
            return PlaceableCheckPoint;
        }
        // End:0x15F
        else
        {
            // End:0xE5
            if(StartPoints.Length == 0)
            {
                return none;
            }
            PlayerStartPoint = StartPoints[0];
            Index = 1;
            J0xF9:
            // End:0x159 [Loop If]
            if(Index < StartPoints.Length)
            {
                TTStart = TdTimeTrialStart(StartPoints[Index]);
                // End:0x14F
                if((TTStart != none) && TTStart.TrackIndex == ActiveTTStretch)
                {
                    return TTStart;
                }
                ++ Index;
                // [Loop Continue]
                goto J0xF9;
            }
            return PlayerStartPoint;
        }
        //return ReturnValue;        
    }

    function OnCheckpointCompleted(TdPlaceableCheckpoint Checkpoint, TdPlayerPawn Pawn, TdPlayerController Controller)
    {
        // End:0x2B
        if(!IsSpectatingGhost() && Pawn.IsA('TdGhostPawn'))
        {
            return;
        }
        // End:0x125
        if(NextCheckPoint == Checkpoint)
        {
            // End:0x9E
            if(!IsSpectatingGhost() && Checkpoint.ShouldGenerateTrackData(ActiveTTStretch) || CheckpointManager.GetFinalCheckpoint() == Checkpoint)
            {
                ProcessTimedata(Checkpoint);
                ++ NumPassedTimerCheckPoints;
            }
            // End:0xCF
            else
            {
                // End:0xCF
                if(CheckpointManager.GetFinalCheckpoint() != NextCheckPoint)
                {
                    BroadcastLocalizedMessage(TimeMessageClass, 2147483647);
                }
            }
            ++ NumPassedCheckPoints;
            // End:0x10C
            if(CheckpointManager.GetFinalCheckpoint() == Checkpoint)
            {
                ProcessLastCheckpointCompleted(Checkpoint, Pawn, Controller);
            }
            // End:0x125
            else
            {
                ProcessCheckpointCompleted(Checkpoint, Pawn, Controller);
            }
        }
        //return;        
    }

    function ProcessTimedata(TdPlaceableCheckpoint Checkpoint)
    {
        local float ImtermediateDiffTime;

        CurrentTimeData.IntermediateTimes[NumPassedTimerCheckPoints] = WorldInfo.TimeSeconds - LastCheckpointTimeStamp;
        CurrentTimeData.AccumulatedIntermediateTimes[NumPassedTimerCheckPoints] = WorldInfo.TimeSeconds - RaceStartTimeStamp;
        // End:0xB1
        if(TimeDataToBeat.AccumulatedIntermediateTimes[NumPassedTimerCheckPoints] > 0.0)
        {
            ImtermediateDiffTime = CurrentTimeData.AccumulatedIntermediateTimes[NumPassedTimerCheckPoints] - TimeDataToBeat.AccumulatedIntermediateTimes[NumPassedTimerCheckPoints];
        }
        // End:0xCF
        else
        {
            ImtermediateDiffTime = -CurrentTimeData.AccumulatedIntermediateTimes[NumPassedTimerCheckPoints];
        }
        LastCheckpointTimeStamp = WorldInfo.TimeSeconds;
        // End:0x11D
        if(CheckpointManager.GetFinalCheckpoint() != NextCheckPoint)
        {
            BroadcastLocalizedMessage(TimeMessageClass, Round(ImtermediateDiffTime * float(100)));
        }
        //return;        
    }

    function ProcessCheckpointCompleted(TdPlaceableCheckpoint Checkpoint, TdPlayerPawn Pawn, TdPlayerController Controller)
    {
        LastCheckPoint = NextCheckPoint;
        LastCheckPoint.Show(false, ActiveTTStretch);
        NextCheckPoint = CheckpointManager.GetNextCheckpoint(NextCheckPoint);
        NextCheckPoint.Show(true, ActiveTTStretch);
        TdTimeTrialHUD(Controller.myHUD).TriggerCheckPointEffect();
        //return;        
    }

    function ProcessLastCheckpointCompleted(TdPlaceableCheckpoint Checkpoint, TdPlayerPawn Pawn, TdPlayerController Controller)
    {
        Checkpoint.Show(false, ActiveTTStretch);
        // End:0x3B
        if(!IsSpectatingGhost())
        {
            RaceCompleted(Controller);
        }
        GotoState('RaceFinishLine');
        //return;        
    }

    function RaceCompleted(TdPlayerController Controller)
    {
        local float TimeDifference;

        RaceEndTimeStamp = WorldInfo.TimeSeconds;
        CurrentTimeData.TotalTime = RaceEndTimeStamp - RaceStartTimeStamp;
        TimeDifference = CurrentTimeData.TotalTime - TimeDataToBeat.TotalTime;
        // End:0x8A
        if(TimeDataToBeat.TotalTime == float(0))
        {
            TimeDifference = -CurrentTimeData.TotalTime;
        }
        // End:0xBB
        if(TimeDifference < 0.0)
        {
            BroadcastLocalizedMessage(VictoryMessageClass, 28);
            SendFinishlineKismet(true);
        }
        // End:0xDA
        else
        {
            BroadcastLocalizedMessage(VictoryMessageClass, 31);
            SendFinishlineKismet(false);
        }
        BroadcastLocalizedMessage(TimeFinishMessageClass, Round(TimeDifference * float(100)));
        //return;        
    }

    function SendFinishlineKismet(bool bNewRecord)
    {
        local int Index;
        local Sequence GameSequence;
        local array<SequenceObject> TimeTrialEvents;
        local array<int> OutputLinks;

        GameSequence = WorldInfo.GetGameSequence();
        GameSequence.FindSeqObjectsByClass(class'SeqEvt_TTFinishLine', true, TimeTrialEvents);
        Index = 0;
        J0x38:
        // End:0x94 [Loop If]
        if(Index < TimeTrialEvents.Length)
        {
            // End:0x5D
            if(bNewRecord)
            {
                OutputLinks[0] = 0;
            }
            // End:0x66
            else
            {
                OutputLinks[0] = 1;
            }
            SequenceEvent(TimeTrialEvents[Index]).CheckActivate(self, self,, OutputLinks);
            ++ Index;
            // [Loop Continue]
            goto J0x38;
        }
        //return;        
    }

    function Timer()
    {
        super(GameInfo).Timer();
        // End:0x1F
        if(!IsSpectatingGhost())
        {
            StoreLastValidPlayerLocation();
        }
        //return;        
    }
    stop;    
}

state RaceFinishLine
{
    ignores PrepareRace;

    function BeginState(name PreviousState)
    {
        RaceFinishLineTimer = 0.0;
        TdHUD(RacingPlayer.myHUD).ToggleReactionTime(true);
        SetIgnoreInput(true);
        RacingPlayer.SetSoundMode(3);
        //return;        
    }

    event Tick(float DeltaTime)
    {
        local float MinGameSpeed, GameSpeedToDrain, NewGameSpeed, GameSpeedFadeTimePct;

        super(Actor).Tick(DeltaTime);
        RaceFinishLineTimer += (DeltaTime / WorldInfo.TimeDilation);
        MinGameSpeed = 0.10;
        GameSpeedFadeTimePct = RaceFinishLineFadeTimePct;
        // End:0x8D
        if(RaceFinishLineTimer > float(RaceFinishLineTime))
        {
            GhostManager.StopGhostPlayback();
            GhostManager.StopGhostRecording(RacingPawn);
            GotoState('EndAnimation');
        }
        // End:0x113
        else
        {
            // End:0xAF
            if(RaceFinishLineTimer > (float(RaceFinishLineTime) * (1.0 - GameSpeedFadeTimePct)))
            {
            }
            // End:0x113
            else
            {
                GameSpeedToDrain = DeltaTime / (float(RaceFinishLineTime) * GameSpeedFadeTimePct);
                GameSpeedToDrain /= WorldInfo.TimeDilation;
                NewGameSpeed = GameSpeed - GameSpeedToDrain;
                NewGameSpeed = FMax(MinGameSpeed, NewGameSpeed);
                SetGameSpeed(NewGameSpeed);
            }
        }
        //return;        
    }
    stop;    
}

state EndAnimation
{
    ignores PrepareRace;

    function BeginState(name PreviousState)
    {
        SendKismetEvent(class'SeqEvt_TTRaceFinished');
        RaceOver();
        //return;        
    }

    function RaceOver()
    {
        TdTimeTrialHUD(RacingPlayer.myHUD).TriggerCustomColorBlink(0.060, 0.40, 1.0, 1.0, 1.0, true, OnMaxFaded);
        //return;        
    }

    function OnMaxFaded()
    {
        TdHUD(RacingPlayer.myHUD).ClearLocalMessages();
        TdHUD(RacingPlayer.myHUD).ToggleReactionTime(false);
        TdHUD(RacingPlayer.myHUD).EffectManager.ReactionTimeEffect.Hide();
        RacingPlayer.SetViewTarget(GetLastSpectatorPoint());
        SetGameSpeed(1.0);
        GotoState('RaceOver');
        RacingPlayer.SetSoundMode(0);
        //return;        
    }

    function EndState(name NextStateName)
    {
        SetIgnoreInput(false);
        //return;        
    }
    stop;    
}

state RaceOver
{
    function BeginState(name PreviousState)
    {
        RaceStartTimeStamp = -1.0;
        RaceEndTimeStamp = -1.0;
        NextCheckPoint = none;
        LastCheckPoint = none;
        EndGame(RacingPlayer.PlayerReplicationInfo, "RaceOver");
        KillRacingPawn();
        RacingPlayer.SetViewTarget(GetLastSpectatorPoint());
        // End:0xC6
        if(((ActiveTTStretch > 0) && ActiveTTStretch < 25) && CheckpointManager.CanFindTrack(ActiveTTStretch))
        {
            CheckpointManager.ShowTrack(ActiveTTStretch, true);
        }
        //return;        
    }

    function KillRacingPawn()
    {
        local Pawn OldPawn;

        // End:0x79
        if(RacingPlayer.Pawn != none)
        {
            OldPawn = RacingPlayer.Pawn;
            RacingPlayer.Pawn.StopFiring();
            RacingPlayer.UnPossess();
            // End:0x79
            if(TdPawn(OldPawn) != none)
            {
                OldPawn.Destroy();
            }
        }
        RacingPlayer.ClientReset();
        RacingPlayer.Reset();
        //return;        
    }
    stop;    
}

defaultproperties
{
    RaceFinishLineTime=4
    RaceFinishLineFadeTimePct=0.050
    RaceCountDownTime=3
    bAllowDifficultyChange=false
    bEnableLOI=false
    bDelayedStart=true
    HUDType=class'TdTimeTrialHUD'
    OnlineStatsWriteClass=class'TdLeaderboardWriteSPTT'
}