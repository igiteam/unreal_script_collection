{
    //return;    
}

// Export UTdPlayerInput::execGetTdBindNameFromCommand(FFrame&, void* const)
native function string GetTdBindNameFromCommand(string BindCommand, optional bool bForceUsingGamepad);

exec function SetBind(name BindName, string Command)
{
    local int Idx;
    local KeyBind NewBind;
    local bool bSpaceBarExist;

    // End:0x38
    if(BindName == 'SpaceBar')
    {
        super(Input).SetBind(BindName, Command @ "| SkipCutscene");
    }
    // End:0xF1
    else
    {
        super(Input).SetBind(BindName, Command);
        Idx = 0;
        J0x4F:
        // End:0x98 [Loop If]
        if(Idx < Bindings.Length)
        {
            // End:0x8E
            if(Bindings[Idx].Name == 'SpaceBar')
            {
                bSpaceBarExist = true;
                // [Explicit Break]
                goto J0x98;
            }
            ++ Idx;
            J0x98:
            // [Loop Continue]
            goto J0x4F;
        }
        // End:0xF1
        if(!bSpaceBarExist)
        {
            NewBind.Name = 'SpaceBar';
            NewBind.Command = "SkipCutscene";
            Bindings[Bindings.Length] = NewBind;
            SaveConfig();
        }
    }
    //return;    
}

defaultproperties
{
    bViewAccelEnabled=true
    YawAccelThreshold=0.90
    MaxSensitivityMultiplier=1.80
    MinSensitivityMultiplier=0.20
    SensitivityMultiplier=1.0
    WalkButtonMultiplier=0.30
}