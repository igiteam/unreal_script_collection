function bool UnlockAchievement(byte LocalUserNum, int AchievementId)
{
    local int Idx;
    local TpAchievementManager AchievementManager;
    local array<AchBind> AchBindings;

    AchBindings = class'TpAchievementManager'.default.AchievementBindings;
    Idx = 0;
    J0x1C:
    // End:0x8F [Loop If]
    if(Idx < AchBindings.Length)
    {
        // End:0x85
        if(AchBindings[Idx].Id == AchievementId)
        {
            AchievementManager = SystemBase.GetAchievementManager();
            AchievementManager.GrantAward(AchBindings[Idx]);
        }
        ++ Idx;
        // [Loop Continue]
        goto J0x1C;
    }
    return true;
    //return ReturnValue;    
}

