function bool CanDoMove()
{
    local Vector GripToPawn;

    // End:0x1D
    if(PawnOwner.GetWeaponType() == 1)
    {
        return false;
    }
    GripToPawn = PawnOwner.Location - Volume.Location;
    // End:0x69
    if((Normal(GripToPawn) Dot vector(PawnOwner.Rotation)) >= -0.30)
    {
        return false;
    }
    // End:0x8F
    if((Normal(GripToPawn) Dot Normal(PawnOwner.Velocity)) >= 0.0)
    {
        return false;
    }
    // End:0xB1
    if((Normal(GripToPawn) Dot vect(0.0, 0.0, -1.0)) < -0.50)
    {
        return false;
    }
    return super(TdMove).CanDoMove();
    //return ReturnValue;    
}

simulated function StartReplicatedMove()
{
    EnableSwingControl();
    PawnOwner.SetRootOffset(vect(0.0, -50.0, -32.0), AnimBlendTime, 4);
    //return;    
}

simulated function StartMove()
{
    local Vector VolumeX, VolumeY, VolumeZ, ToGrip;

    super.StartMove();
    PawnOwner.SetWeaponAnimState(0);
    PawnOwner.SetRootOffset(vect(0.0, -50.0, -32.0), AnimBlendTime, 4);
    Volume.GetAxes(Volume.Rotation, VolumeX, VolumeY, VolumeZ);
    PointDistToLine(PawnOwner.Location, VolumeY, Volume.Location, SwingLocation);
    ToGrip = Normal(Volume.Location - PawnOwner.Location);
    // End:0xFF
    if((ToGrip Dot vector(Volume.Rotation)) >= 0.0)
    {
        BarDirection = VolumeY;
        SwingDirection = VolumeX;
    }
    // End:0x119
    else
    {
        BarDirection = -VolumeY;
        SwingDirection = -VolumeX;
    }
    SwingAngle = GetPawnAngle(PawnOwner.Location);
    SwingAngle = float(Clamp(int(SwingAngle), int(-1.20), int(-0.70)));
    SwingVelocity = MaxSwingVelocity * FMin(1.0, VSize2D(PawnOwner.Velocity) / 500.0);
    SetPreciseRotation(rotator(SwingDirection), AnimBlendTime);
    bIsInterpolatingInto = true;
    SetPawnRotation(SwingAngle);
    EnableSwingControl();
    ResetCameraLook(AnimBlendTime);
    PawnOwner.Velocity = vect(0.0, 0.0, 0.0);
    PawnOwner.Acceleration = vect(0.0, 0.0, 0.0);
    PawnOwner.StopCustomAnim(2, AnimBlendTime);
    PawnOwner.StopCustomAnim(3, AnimBlendTime);
    InitSwingSound();
    PlayMoveAnim(2, ((Volume.bThickGrip) ? name("SwingHardStartWide") : name("SwingHardStart")), 1.0, AnimBlendTime, 0.20);
    SetMoveTimer(AnimBlendTime, false, 'StopInterpolating');
    //return;    
}

simulated function StopReplicatedMove()
{
    DisableSwingControl();
    PawnOwner.SetRootOffset(vect(0.0, 0.0, 0.0), 0.10);
    //return;    
}

simulated function StopMove()
{
    super.StopMove();
    DisableSwingControl();
    StopSwingSound();
    PawnOwner.SetRootOffset(vect(0.0, 0.0, 0.0), 0.10);
    bIsShimmying = false;
    bIsTurning = false;
    //return;    
}

simulated function InitSwingSound()
{
    // End:0x2B
    if(SwingSoundComponent == none)
    {
        SwingSoundComponent = PawnOwner.CreateAudioComponent(SwingSound, false, true);
    }
    // End:0x9B
    if(SwingSoundComponent != none)
    {
        SwingSoundComponent.bUseOwnerLocation = true;
        SwingSoundComponent.bAllowSpatialization = true;
        SwingSoundComponent.bAutoDestroy = true;
        PawnOwner.AttachComponent(SwingSoundComponent);
        SwingSoundComponent.FadeIn(0.20, 1.0);
    }
    //return;    
}

simulated function StopSwingSound()
{
    // End:0x25
    if(SwingSoundComponent != none)
    {
        SwingSoundComponent.FadeOut(0.70, 0.0);
    }
    //return;    
}

simulated function EnableSwingControl()
{
    // End:0x39
    if(PawnOwner.SwingControl1p != none)
    {
        PawnOwner.SwingControl1p.SetSkelControlStrength(1.0, AnimBlendTime);
    }
    PawnOwner.SwingControl3p.SetSkelControlStrength(1.0, AnimBlendTime);
    //return;    
}

simulated function DisableSwingControl()
{
    // End:0x39
    if(PawnOwner.SwingControl1p != none)
    {
        PawnOwner.SwingControl1p.SetSkelControlStrength(0.0, 0.250);
    }
    PawnOwner.SwingControl3p.SetSkelControlStrength(0.0, 0.40);
    //return;    
}

simulated function HandleMoveAction(TdPawn.EMovementAction Action)
{
    local bool MoveLeft, MoveRight;
    local float JumpAngle;

    MoveLeft = (Action == 12) || Action == 13;
    MoveRight = (Action == 14) || Action == 15;
    // End:0xA6
    if(Action == 1)
    {
        JumpAngle = FMin(3.1415930 / 2.0, SwingAngle - SwingAngleTimingOffset);
        // End:0xA3
        if(JumpAngle > -3.1415930 / 4.0)
        {
            JumpOff(JumpAngle);
        }
    }
    // End:0x2A5
    else
    {
        // End:0xD0
        if(!bIsInterpolatingInto && Action == 5)
        {
            LetGo();
        }
        // End:0x2A5
        else
        {
            // End:0x112
            if(((!bIsInterpolatingInto && !bIsTurning) && !bIsShimmying) && Action == 16)
            {
                bIsTurning = true;
            }
            // End:0x2A5
            else
            {
                // End:0x175
                if(Action == 3)
                {
                    JumpAngle = FMin(3.1415930 / 2.0, SwingAngle - SwingAngleTimingOffset);
                    // End:0x172
                    if(JumpAngle > -3.1415930 / 4.0)
                    {
                        PawnOwner.SetMove(32, false, true);
                    }
                }
                // End:0x2A5
                else
                {
                    // End:0x2A5
                    if(((!bIsTurning && !bIsShimmying) && MoveLeft || MoveRight) && !Volume.bSnapToCenter)
                    {
                        // End:0x2A5
                        if((Abs(SwingVelocity) < 1.0) && Abs(SwingAngle) < (3.1415930 / float(8)))
                        {
                            // End:0x2A5
                            if(CanShimmy(((MoveRight) ? 1.0 : -1.0)))
                            {
                                bIsShimmying = true;
                                ShimmyVelocity = 35.0 * ((MoveRight) ? 1.0 : -1.0);
                                PlayMoveAnim(2, name("SwingStrafe"), ((MoveRight) ? 1.0 : -1.0), 0.20, 0.20, false);
                                CustomAnimNode = TdAnimNodeSequence(PawnOwner.GetCustomAnimation(2));
                                ShimmyTime = Abs(CustomAnimNode.GetAnimPlaybackLength());
                            }
                        }
                    }
                }
            }
        }
    }
    //return;    
}

simulated function StopInterpolating()
{
    bIsInterpolatingInto = false;
    //return;    
}

simulated function OnTimer()
{
    PawnOwner.UseRootRotation(true);
    PlayMoveAnim(2, name("Swing180"), 1.0, 0.20, 0.30,, true);
    PawnOwner.SetRotation(rotator(SwingDirection));
    SwingVelocity = 0.0;
    SwingAngle = 0.0;
    SetPawnRotation(SwingAngle);
    //return;    
}

simulated function OnCeaseRelevantRootMotion(AnimNodeSequence SeqNode)
{
    // End:0x7D
    if(bIsTurning)
    {
        bIsTurning = false;
        PawnOwner.UseRootRotation(false);
        SwingDirection = -SwingDirection;
        BarDirection = -BarDirection;
        PawnOwner.SetRotation(rotator(SwingDirection));
        PawnOwner.Controller.SetRotation(rotator(SwingDirection));
        SwingVelocity = 0.250;
    }
    //return;    
}

simulated function JumpOff(float JumpAngle)
{
    local Vector VelocityDirection;

    TdMove_SwingJump(PawnOwner.Moves[73]).TargetVolume = CheckForTargetVolume(vect(0.0, 0.0, 0.0));
    // End:0x12E
    if(TdMove_SwingJump(PawnOwner.Moves[73]).TargetVolume == none)
    {
        VelocityDirection = BarDirection Cross Normal(SwingLocation - PawnOwner.Location);
        PawnOwner.Velocity = (VelocityDirection * Cos(JumpAngle)) * ExitVelocityModifier;
        PawnOwner.Acceleration = PawnOwner.Velocity;
        PawnOwner.GravityModifier = SwingExitGravityModifier;
        PawnOwner.GravityModifierTimer = SwingExitGravityModifierTime;
        PawnOwner.AIAimOldMovementState = 1;
        PlayMoveAnim(2, name("SwingJumpOff"), 1.0, 0.20, 0.20, false);
    }
    PawnOwner.SetMove(73);
    //return;    
}

simulated function LetGo()
{
    PlayMoveAnim(2, name("SwingEnd"), 1.0, 0.20, 0.20, false);
    PawnOwner.SetMove(2);
    //return;    
}

simulated event SetPawnRotation(float RadAngle)
{
    local int UnAngle;
    local Vector Offset;

    PawnOwner.CustomSoundInput = 500.0 * Abs(SwingVelocity);
    UnAngle = int((2.0 * (RadAngle / 3.1415930)) * 16384.0);
    Offset.X = Sin(RadAngle) * 94.0;
    Offset.Z = (1.0 - Cos(RadAngle)) * 94.0;
    // End:0xE9
    if(PawnOwner.SwingControl1p != none)
    {
        PawnOwner.SwingControl1p.BoneRotation.Roll = int(-float(UnAngle));
        PawnOwner.SwingControl1p.BoneTranslation = Offset;
    }
    PawnOwner.SwingControl3p.BoneRotation.Roll = -UnAngle;
    PawnOwner.SwingControl3p.BoneTranslation = Offset;
    //return;    
}

simulated event AbortShimmy()
{
    bIsShimmying = false;
    PawnOwner.StopCustomAnim(2, 0.250);
    //return;    
}

simulated function TakeTaserDamage(Vector ImpactMomentum)
{
    // End:0x3C
    if(PawnOwner.Moves[2].CanDoMove())
    {
        PawnOwner.SetMove(2);
    }
    //return;    
}

simulated function bool CanUseLookAtHint()
{
    return false;
