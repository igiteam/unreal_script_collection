    // Reference: ArrowComponent'Default__TdTrigger.TriggerDir'
    Components(2)=TriggerDir
    begin object name=ArcObject class=TdDrawArcComponent
        Rotation=(Pitch=0,Yaw=16384,Roll=0)
    object end
    // Reference: TdDrawArcComponent'Default__TdTrigger.ArcObject'
    Components(3)=ArcObject
    CollisionComponent=CylinderComponent'Default__TdTrigger.CollisionCylinder'
