class PKPawn_Skeleton_Base extends PKPawn
    config(Pawn)
    hidecategories(Navigation);

var SpawnMethod SpawnMethodArchetype;

simulated function bool ShouldGib(class<EvilDmgType_Base> EvilDamageType)
{
    return true;
    //return ReturnValue;    
}

protected function bool CanBePartialGib(class<EvilDmgType_Base> EvilDamageType)
{
    return false;
    //return ReturnValue;    
}

simulated function class<EvilBloodGlob> GetBloodGlobClass(class<EvilDmgType_Base> dmgType)
{
    return none;
    //return ReturnValue;    
}

simulated function SpawnedBy(PKPawn Spawner)
{
    // End:0x2F
    if(SpawnMethodArchetype != none)
    {
        SpawnMethodArchetype.PostCreateActor(self);
    }
    Health *= 3.0000000;
    bNotCountable = true;
    //return;    
}

