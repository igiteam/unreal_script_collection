class PKPawn_BagBaby_Base extends PKPawn
    config(Pawn)
    hidecategories(Navigation);

simulated function bool ShouldGib(class<EvilDmgType_Base> EvilDamageType)
{
    return true;
    //return ReturnValue;    
}

protected function bool CanBePartialGib(class<EvilDmgType_Base> EvilDamageType)
{
    return false;
    //return ReturnValue;    
}

simulated event PostInitAnimTree(SkeletalMeshComponent SkelComp)
{
    super.PostInitAnimTree(SkelComp);
    // End:0x86
    if(!WorldInfo.GRI.ShouldShowGore() && NoGoreSkeletalMesh == Mesh.SkeletalMesh)
    {
        ShowMaterialSectionOnAllLods(1, false);
    }
    //return;    
}

