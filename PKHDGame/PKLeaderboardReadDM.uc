function int GetKills(UniqueNetId PlayerID)
{
    local int ReturnVal;

    GetIntStatValueForPlayer(PlayerID, 0, ReturnVal);
    return ReturnVal;
    //return ReturnValue;    
}

function int GetDeaths(UniqueNetId PlayerID)
{
    local int ReturnVal;

    GetIntStatValueForPlayer(PlayerID, 1, ReturnVal);
    return ReturnVal;
    //return ReturnValue;    
}

function int GetMatchesWon(UniqueNetId PlayerID)
{
    local int ReturnVal;

    GetIntStatValueForPlayer(PlayerID, 2, ReturnVal);
    return ReturnVal;
    //return ReturnValue;    
}

static function string DebugInfo()
{
    local string ret;

    ret = "\nPKLeaderboardReadDM\n";
    ret = ((ret @ "LEADERBOARDS_DM_KILLS:") $ ToHex(0)) $ "\n";
    ret = ((ret @ "LEADERBOARDS_DM_DEATHS:") $ ToHex(1)) $ "\n";
    ret = ((ret @ "LEADERBOARDS_DM_MATCHESWON:") $ ToHex(2)) $ "\n";
    return ret;
    //return ReturnValue;    
}

defaultproperties
{
    ViewId=36
    ColumnIds=/* Array type was not detected. */
    ColumnMappings=/* Array type was not detected. */
    ViewName="Deathmatch"
}