class EvilGibSkeletalMeshComponent extends SkeletalMeshComponent
    config(Engine)
    editinlinenew
    hidecategories(Object);

defaultproperties
{
    PhysicsWeight=1.0000000
    bUpdateSkelWhenNotRendered=false
    ReplacementPrimitive=none
    MaxDrawDistance=8000.0000000
    RBChannel=ERBCollisionChannel.RBCC_Untitled3
    CastShadow=false
    bCastDynamicShadow=false
    BlockRigidBody=true
    bNotifyRigidBodyCollision=true
    RBCollideWithChannels=(Default=true,BlockingVolume=true)
    ScriptRigidBodyCollisionThreshold=5.0000000
}