class TPAnimNodeBlendByCoverTransitionAction extends TPAnimNodeBlendByCoverBase
		native;



enum CoverTransitionAction
{
	CoverTransitionAction_NotTransitioning,
	CoverTransitionAction_HidingToFiring,
	CoverTransitionAction_FiringToHiding,
	CoverTransitionAction_HidingToBlindFiring,
	CoverTransitionAction_BlidFiringToHiding,
	CoverTransitionAction_HidingToStepOut,
	CoverTransitionAction_StepOutToHiding,
	CoverTransitionAction_HidingToLooking,
	CoverTransitionAction_LookingToHiding,
	CoverTransitionAction_LeftToRight,
	CoverTransitionAction_RightToLeft,
	CoverTransitionAction_LeftToTop,
	CoverTransitionAction_TopToLeft,
	CoverTransitionAction_RightToTop,
	CoverTransitionAction_TopToRight,
	CoverTransitionAction_HideFromFire,
	
	//CoverTransitionAction_HidingToReloading, // SHOULD NOT BE USED AT THIS TIME
	//CoverTransitionAction_ReloadingToHiding, // SHOULD NOT BE USED AT THIS TIME
};



