/**
 * This class is responsible for exposing warfare related dataproviders to the UI system.
 */
class UIDataStore_TurningPoint extends UIDataStore
	native
	implements(UIListElementProvider)
	config(Engine)
	transient;

/** Provides access to the player's save games */
var UIDataProvider_TurningPointSaves SaveGamesProvider;

/** Holds the player that owns this paticular datastore */
var LocalPlayer Player;

// The currently selected chapter (/act)
var int CurrentAct;

