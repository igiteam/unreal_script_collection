class ProxyActor extends Actor;

//A dummy actor class for use when you need an actor but don't want it to do anything (i.e. when you need it to source a sound)


// Decompiled with UE Explorer.
defaultproperties
{
    bHidden=true
    bSkipActorPropertyReplication=true
    bOnlyDirtyReplication=true
    RemoteRole=0
    NetUpdateFrequency=10.0000000
}