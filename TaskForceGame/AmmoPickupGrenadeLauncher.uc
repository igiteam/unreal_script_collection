class AmmoPickupGrenadeLauncher extends AmmoPickup
	placeable;


//=============================================================================

// Decompiled with UE Explorer.
defaultproperties
{
    AmmunitionClass=Class'GrenadeLauncherAmmo'
    bPickupOnlyIfAlreadyHaveWeapon=false
